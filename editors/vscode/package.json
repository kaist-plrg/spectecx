{
  "name": "spectecx-syntax",
  "displayName": "SpecTecX",
  "description": "Syntax highlighting, diagnostics and debugging for SpecTecX specification files (.spectec).",
  "categories": [
    "Programming Languages"
  ],
  "version": "0.2.0",
  "publisher": "kaist-plrg",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaist-plrg/spectecx.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "spectec",
        "aliases": [
          "SpecTecX"
        ],
        "extensions": [
          ".spectec"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spectec",
        "scopeName": "source.spectec",
        "path": "./syntaxes/spectec.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "spectec"
      }
    ],
    "debuggers": [
      {
        "type": "spectec",
        "label": "SpecTecX",
        "languages": [
          "spectec"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "target",
              "task"
            ],
            "properties": {
              "target": {
                "type": "string",
                "description": "The language whose spec runs, as in `spectecx <target> debug <task>`, e.g. `miniml`."
              },
              "task": {
                "type": "string",
                "description": "The task to run under the debugger, e.g. `eval`."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "The task's own arguments, and spec options such as `--spec` or `--spec-dir`. Without them, the spec comes from `spectecx.config` or the target's default."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "The directory the run starts in. Defaults to the workspace folder."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "spectec",
            "request": "launch",
            "name": "Debug a SpecTecX run",
            "target": "<target, e.g. miniml>",
            "task": "<task, e.g. eval>",
            "args": [
              "-p",
              "${workspaceFolder}/<program>"
            ]
          }
        ],
        "configurationSnippets": [
          {
            "label": "SpecTecX: Launch",
            "description": "Run a task under the debugger",
            "body": {
              "type": "spectec",
              "request": "launch",
              "name": "Debug ${1:task}",
              "target": "${2:target}",
              "task": "${1:task}",
              "args": []
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "SpecTecX",
      "properties": {
        "spectec.languageServer.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the SpecTecX language server. Turn off to keep syntax highlighting only."
        },
        "spectec.languageServer.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `spectecx-lsp` binary. Leave empty to look for it at the root of an open workspace folder (where `make lsp` puts it), then on `PATH`. Supports `~` and `${workspaceFolder}`."
        },
        "spectec.languageServer.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command-line arguments passed to spectecx-lsp."
        },
        "spectec.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between VS Code and spectecx-lsp in the SpecTecX output channel."
        },
        "spectec.debugger.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `spectecx` executable that debugging runs. Leave empty to look for it at the root of an open workspace folder (where `make exe` puts it), then on `PATH`. Supports `~` and `${workspaceFolder}`."
        }
      }
    },
    "commands": [
      {
        "command": "spectec.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "SpecTecX"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The language server is a locally configured executable."
    }
  },
  "scripts": {
    "format": "prettier --write \"*.js\" \"test/*.js\" package.json .prettierrc.json",
    "format:check": "prettier --check \"*.js\" \"test/*.js\" package.json .prettierrc.json",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test test/*.test.js",
    "test:host": "node test/run-host.js",
    "package": "vsce package -o spectecx.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9"
  }
}
