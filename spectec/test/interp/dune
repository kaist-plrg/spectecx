; Interpreter test executable (unified AL/SL with --sl flag)

(executable
 (name main)
 (preprocess
  (pps ppx_let))
 (libraries
  test_lib
  spectec.cli
  targets_p4
  targets_impty
  targets_miniml
  core
  core_unix
  core_unix.command_unix))

;; ============================================================
;; p4 target tests
;; ============================================================

;; AL Positive tests (expect success, default AL mode)

(rule
 (target p4-al-pos.actual)
 (deps
  (source_tree ../../specs/p4)
  (source_tree ../../testdata/interp/p4/p4c/includes)
  (source_tree ../../testdata/interp/p4/excludes)
  (source_tree ../../testdata/interp/p4/p4c/p4_16_samples))
 (action
  (with-stdout-to
   %{target}
   (with-stderr-to
    p4-al-pos.err
    (run
     ./main.exe
     p4
     typecheck
     -i
     ../../../../../spectec/testdata/interp/p4/p4c/includes
     -e
     ../../../../../spectec/testdata/interp/p4/excludes
     -d
     ../../../../../spectec/testdata/interp/p4/p4c/p4_16_samples)))))

(rule
 (alias p4-al-pos)
 (deps p4-al-pos.err p4-al-pos.actual)
 (action
  (diff p4-al-pos.expected p4-al-pos.actual)))

;; AL Negative tests (expect failure, default AL mode)

(rule
 (target p4-al-neg.actual)
 (deps
  (source_tree ../../specs/p4)
  (source_tree ../../testdata/interp/p4/p4c/includes)
  (source_tree ../../testdata/interp/p4/excludes)
  (source_tree ../../testdata/interp/p4/p4c/p4_16_errors))
 (action
  (with-stdout-to
   %{target}
   (with-stderr-to
    p4-al-neg.err
    (run
     ./main.exe
     p4
     typecheck
     -neg
     -i
     ../../../../../spectec/testdata/interp/p4/p4c/includes
     -e
     ../../../../../spectec/testdata/interp/p4/excludes
     -d
     ../../../../../spectec/testdata/interp/p4/p4c/p4_16_errors)))))

(rule
 (alias p4-al-neg)
 (deps p4-al-neg.err p4-al-neg.actual)
 (action
  (diff p4-al-neg.expected p4-al-neg.actual)))

