     ../../../../../spectec/testdata/interp/impty/closure
     -d
     ../../../../../spectec/testdata/interp/impty/recursion)))))

(rule
 (alias impty-recursion-sl-neg)
 (deps impty-recursion-sl-neg.err impty-recursion-sl-neg.actual)
 (action
  (diff impty-recursion-sl-neg.expected impty-recursion-sl-neg.actual)))

