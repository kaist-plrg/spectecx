(executable
 (name transport)
 (modules transport)
 (libraries spectec.debugger yojson))

(rule
 (target transport.actual)
 (action
  (with-stdout-to
   %{target}
   (run ./transport.exe))))

(rule
 (alias runtest)
 (action
  (diff transport.expected transport.actual)))

