;; === 2-static-runtime/2.3.1-type-callable.spectec ===
syntax typedExpressionIR

syntax initializerIR =
  | '=' typedExpressionIR

syntax constantInitializerIR =
  | '=' _VALUE value

syntax parameterInitializerIR =
  | initializerIR
  | constantInitializerIR

syntax parameterInitializerOptIR = parameterInitializerIR?

syntax parameterIR =
  | annotationList direction typeIR id parameterInitializerOptIR
  hint(prose_fields "annotations"
                    "direction"
                    "type"
                    "name"
                    "default initializer")

syntax actionTypeIR =
  | annotationList ACTION nameIR `(parameterIR*`)

syntax definedFunctionTypeIR =
  | FUNCTION nameIR `(parameterIR*`) ':' typeIR

syntax externFunctionTypeIR =
  | EXTERN_FUNCTION nameIR `(parameterIR*`) ':' typeIR

syntax functionTypeIR =
  | definedFunctionTypeIR
  | externFunctionTypeIR

syntax builtinIsValidMethodTypeIR =
  | BUILTIN_IS_VALID

syntax builtinSetValidMethodTypeIR =
  | BUILTIN_SET_VALID

syntax builtinSetInvalidMethodTypeIR =
  | BUILTIN_SET_INVALID

syntax builtinPushFrontMethodTypeIR =
  | BUILTIN_PUSH_FRONT

syntax builtinPopFrontMethodTypeIR =
  | BUILTIN_POP_FRONT

syntax builtinSizeMethodTypeIR =
  | BUILTIN_SIZE_OF

syntax builtinMethodTypeIR =
  | builtinIsValidMethodTypeIR
  | builtinSetValidMethodTypeIR
  | builtinSetInvalidMethodTypeIR
  | builtinPushFrontMethodTypeIR
  | builtinPopFrontMethodTypeIR
  | builtinSizeMethodTypeIR

dec $signature_of_builtinMethodTypeIR(builtinMethodTypeIR)
  : (parameterIR*, typeIR)

def $signature_of_builtinMethodTypeIR(BUILTIN_IS_VALID) = (eps, BOOL)

def $signature_of_builtinMethodTypeIR(BUILTIN_SET_VALID) = (eps, VOID)

def $signature_of_builtinMethodTypeIR(BUILTIN_SET_INVALID) = (eps, VOID)

def $signature_of_builtinMethodTypeIR(BUILTIN_PUSH_FRONT)
  = ([_EMPTY _EMPTY INT "count" eps], VOID)

def $signature_of_builtinMethodTypeIR(BUILTIN_POP_FRONT)
  = ([_EMPTY _EMPTY INT "count" eps], VOID)

def $signature_of_builtinMethodTypeIR(BUILTIN_SIZE_OF) = (eps, INT)

syntax externMethodTypeIR =
  | EXTERN_METHOD nameIR `(parameterIR*`) ':' typeIR
  | EXTERN_METHOD ABSTRACT nameIR `(parameterIR*`) ':' typeIR

syntax parserApplyMethodTypeIR =
  | PARSER_APPLY `(parameterIR*`)

syntax controlApplyMethodTypeIR =
  | CONTROL_APPLY `(parameterIR*`)

syntax tableApplyMethodTypeIR =
  | TABLE_APPLY ':' tableMetadataStructTypeIR

syntax methodTypeIR =
  | builtinMethodTypeIR
  | externMethodTypeIR
  | parserApplyMethodTypeIR
  | controlApplyMethodTypeIR
  | tableApplyMethodTypeIR

syntax callableTypeIR =
  | actionTypeIR
  | functionTypeIR
  | methodTypeIR
;; === 2-static-runtime/2.3.2-type-callable-aux.spectec ===
dec $id_of_parameterIR(parameterIR) : id
  hint(prose_in "the identifier of" %0)

def $id_of_parameterIR(_ _ _ id _) = id

dec $is_default_parameterIR(parameterIR) : bool
  hint(prose_true %0 "is a parameter with a default value")
  hint(prose_false %0 "is a parameter without a default value")

def $is_default_parameterIR(_ _ _ _ eps) = false

def $is_default_parameterIR(_ _ _ _ _) = true
  -- otherwise

dec $annotationList_of_parameterIR(parameterIR) : annotationList
  hint(prose_in "the annotations of" %0)

def $annotationList_of_parameterIR(annotationList _ _ _ _) = annotationList

dec $optional_annotation_of_parameterIR(parameterIR) : bool
  hint(prose_true %0 "is optional")
  hint(prose_false %0 "is not optional")

dec $optional_annotation_of_parameterIR'(annotationList) : bool
  hint(prose_true %0 "contains an optional annotation")
  hint(prose_false %0 "does not contain an optional annotation")

dec $optional_annotation_of_parameterIR''(annotation) : bool
  hint(prose_true %0 "is an optional annotation")
  hint(prose_false %0 "is not an optional annotation")

def $optional_annotation_of_parameterIR(parameterIR)
  = $optional_annotation_of_parameterIR'(annotationList)
  -- if annotationList = $annotationList_of_parameterIR(parameterIR)

def $optional_annotation_of_parameterIR'(annotationList) = $exists_(b*)
  -- if annotation* = $flatten_annotationList(annotationList)
  -- (if (b = $optional_annotation_of_parameterIR''(annotation)))*

def $optional_annotation_of_parameterIR''('@' name) = true
  -- if "optional" = $name(name)

def $optional_annotation_of_parameterIR''(annotation) = false
  -- otherwise

dec $is_optional_parameterIR(parameterIR) : bool
  hint(prose_true %0 "is an optional parameter")
  hint(prose_false %0 "is not an optional parameter")

def $is_optional_parameterIR(parameterIR)
  = $optional_annotation_of_parameterIR(parameterIR)
;; === 2-static-runtime/2.3.3-type-callable-def.spectec ===
syntax actionTypeDefIR = actionTypeIR

syntax definedFunctionTypeDefIR =
  | FUNCTION
    nameIR
    `<typeParameterIR* ',' typeParameterIR*`>
    `(parameterIR*`)
    ':'
    typeIR

syntax externFunctionTypeDefIR =
  | EXTERN_FUNCTION
    nameIR
    `<typeParameterIR* ',' typeParameterIR*`>
    `(parameterIR*`)
    ':'
    typeIR

syntax functionTypeDefIR =
  | definedFunctionTypeDefIR
  | externFunctionTypeDefIR

syntax externMethodTypeDefIR =
  | EXTERN_METHOD
    nameIR
    `<typeParameterIR* ',' typeParameterIR*`>
    `(parameterIR*`)
    ':'
    typeIR
  | EXTERN_METHOD
    ABSTRACT
    nameIR
    `<typeParameterIR* ',' typeParameterIR*`>
    `(parameterIR*`)
    ':'
    typeIR

syntax parserApplyMethodTypeDefIR = parserApplyMethodTypeIR

syntax controlApplyMethodTypeDefIR = controlApplyMethodTypeIR

syntax tableApplyMethodTypeDefIR = tableApplyMethodTypeIR

syntax methodTypeDefIR =
  | externMethodTypeDefIR
  | parserApplyMethodTypeDefIR
  | controlApplyMethodTypeDefIR
  | tableApplyMethodTypeDefIR

syntax callableTypeDefIR =
  | actionTypeDefIR
  | functionTypeDefIR
  | methodTypeDefIR
