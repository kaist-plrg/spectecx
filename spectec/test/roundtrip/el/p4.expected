  = $compat_concat(typeIR_l, typeIR_r)
  -- if ~(typeIR_l <: typedefTypeIR)

def $compat_concat(_, _) = false
  -- otherwise

dec $result_concat(typeIR, typeIR) : typeIR

def $result_concat(STRING, STRING) = STRING

def $result_concat(INT `<w_a`>, INT `<w_b`>) = INT `<$(w_a + w_b)`>

def $result_concat(INT `<w_a`>, BIT `<w_b`>) = INT `<$(w_a + w_b)`>

def $result_concat(BIT `<w_a`>, INT `<w_b`>) = BIT `<$(w_a + w_b)`>

def $result_concat(BIT `<w_a`>, BIT `<w_b`>) = BIT `<$(w_a + w_b)`>

