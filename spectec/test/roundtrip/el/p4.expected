;; === 2-static-runtime/2.5.1-type-free.spectec ===
syntax bound = set<typeId>

var B : bound

dec $free_typeIR(typeIR) : bound
  hint(prose_in "free type identifiers in" %0)

dec $free_typeDefIR(typeDefIR) : bound
  hint(prose_in "free type identifiers in" %0)

dec $free_parameterIR(parameterIR) : bound
  hint(prose_in "free type identifiers in" %0)

dec $free_parameterIRs(parameterIR*) : bound
  hint(prose_in "free type identifiers in" %0)

dec $free_callableTypeIR(callableTypeIR) : bound
  hint(prose_in "free type identifiers in" %0)

dec $free_callableTypeDefIR(callableTypeDefIR) : bound
  hint(prose_in "free type identifiers in" %0)

def $free_typeIR(baseTypeIR) = `{eps`}

def $free_typeIR(_NAME typeId) = `{typeId`}

def $free_typeIR(TYPEDEF _ typeIR) = $free_typeIR(typeIR)

def $free_typeIR(TYPE _ typeIR) = $free_typeIR(typeIR)

def $free_typeIR(LIST `<typeIR`>) = $free_typeIR(typeIR)

def $free_typeIR(TUPLE `<typeIR*`>) = $unions_set<typeId>($free_typeIR(typeIR)*)

def $free_typeIR(ARRAY typeIR `[_`]) = $free_typeIR(typeIR)

def $free_typeIR(HEADER_STACK typeIR `[_`]) = $free_typeIR(typeIR)

def $free_typeIR(STRUCT _ `<typeArgumentIR*`> `{(_ typeIR_field _ ';')*`})
  = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*),
                       $unions_set<typeId>($free_typeIR(typeIR_field)*))

def $free_typeIR(HEADER _ `<typeArgumentIR*`> `{(_ typeIR_field _ ';')*`})
  = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*),
                       $unions_set<typeId>($free_typeIR(typeIR_field)*))

def $free_typeIR(HEADER_UNION _ `<typeArgumentIR*`> `{(_ typeIR_field _ ';')*`})
  = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*),
                       $unions_set<typeId>($free_typeIR(typeIR_field)*))

def $free_typeIR(ENUM _ `{_`}) = `{eps`}

def $free_typeIR(ENUM _ `<typeIR`> `{_`}) = $free_typeIR(typeIR)

def $free_typeIR(EXTERN _ `<typeArgumentIR*`> `{(_ ':' externMethodTypeDefIR)*`})
  = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*),
                       $unions_set<typeId>($free_callableTypeDefIR(externMethodTypeDefIR)*))

def $free_typeIR(PARSER _ `<typeArgumentIR*`> `(parameterIR*`))
  = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*),
                       $unions_set<typeId>($free_parameterIR(parameterIR)*))

def $free_typeIR(CONTROL _ `<typeArgumentIR*`> `(parameterIR*`))
  = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*),
                       $unions_set<typeId>($free_parameterIR(parameterIR)*))

def $free_typeIR(PACKAGE _ `<typeArgumentIR*`> `{typeIR*`})
  = $union_set<typeId>($unions_set<typeId>($free_typeIR(typeArgumentIR)*),
                       $unions_set<typeId>($free_typeIR(typeIR)*))

def $free_typeIR(TABLE _ `{_`}) = `{eps`}

def $free_typeIR(DEFAULT) = `{eps`}

def $free_typeIR(HEADER_INVALID) = `{eps`}

def $free_typeIR(SEQ `<typeIR*`>) = $unions_set<typeId>($free_typeIR(typeIR)*)

def $free_typeIR(SEQ `<typeIR* ',' '...'`>)
  = $unions_set<typeId>($free_typeIR(typeIR)*)

def $free_typeIR(RECORD `{(_ typeIR _ ';')*`})
  = $unions_set<typeId>($free_typeIR(typeIR)*)

def $free_typeIR(RECORD `{(_ typeIR _ ';')* ',' '...'`})
  = $unions_set<typeId>($free_typeIR(typeIR)*)

def $free_typeIR(SET `<typeIR`>) = $free_typeIR(typeIR)

def $free_typeIR(tableMetadataTypeIR) = `{eps`}

def $free_typeDefIR(typeDefIR) = $diff_set<typeId>(B_base, B_tparams)
  -- if (typeParameterIR_expl*, typeParameterIR_impl*)
        = $typeParameterListIR_of_typeDefIR(typeDefIR)
  -- if B_tparams = `{typeParameterIR_expl* ++ typeParameterIR_impl*`}
  -- if typeIR = $typeIR_of_typeDefIR(typeDefIR)
  -- if B_base = $free_typeIR(typeIR)

def $free_parameterIR(_ _ typeIR _ _) = $free_typeIR(typeIR)

def $free_parameterIRs(parameterIR*)
  = $unions_set<typeId>($free_parameterIR(parameterIR)*)

def $free_callableTypeIR(_ ACTION _ `(parameterIR*`)) = B_params
  -- if B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*)

def $free_callableTypeIR(FUNCTION _ `(parameterIR*`) ':' typeIR)
  = $union_set<typeId>(B_params, B_ret)
  -- if B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*)
  -- if B_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(EXTERN_FUNCTION _ `(parameterIR*`) ':' typeIR)
  = $union_set<typeId>(B_params, B_ret)
  -- if B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*)
  -- if B_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(builtinMethodTypeIR) = `{eps`}

def $free_callableTypeIR(EXTERN_METHOD _ `(parameterIR*`) ':' typeIR)
  = $union_set<typeId>(B_params, B_ret)
  -- if B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*)
  -- if B_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(EXTERN_METHOD ABSTRACT _ `(parameterIR*`) ':' typeIR)
  = $union_set<typeId>(B_params, B_ret)
  -- if B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*)
  -- if B_ret = $free_typeIR(typeIR)

def $free_callableTypeIR(PARSER_APPLY `(parameterIR*`)) = B_params
  -- if B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*)

def $free_callableTypeIR(CONTROL_APPLY `(parameterIR*`)) = B_params
  -- if B_params = $unions_set<typeId>($free_parameterIR(parameterIR)*)

def $free_callableTypeIR(TABLE_APPLY ':' _) = `{eps`}

def $free_callableTypeDefIR(callableTypeDefIR)
  = $diff_set<typeId>(B_base, B_tparams)
  -- if (typeId_tparam_expl*, typeId_tparam_impl*)
        = $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR)
  -- if B_tparams = `{typeId_tparam_expl* ++ typeId_tparam_impl*`}
  -- if callableTypeIR = $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR)
  -- if B_base = $free_callableTypeIR(callableTypeIR)
;; === 2-static-runtime/2.5.2-type-subst.spectec ===
syntax theta = map<typeId, typeIR>

dec $empty_theta : theta

def $empty_theta = $empty_map<typeId, typeIR>

dec $capture_avoiding_(theta, typeParameterIR*, bound)
  : (theta, typeParameterIR*)

dec $capture_avoiding(theta, typeId*, typeId*, bound)
  : (theta, typeId*, typeId*)

dec $subst_typeIR(theta, typeIR) : typeIR
  hint(prose_in %1 "substituted by" %0)

dec $subst_typeIR'(theta, typeIR) : typeIR
  hint(prose_in %1 "substituted by a non-empty" %0)

dec $subst_parameterIR(theta, parameterIR) : parameterIR
  hint(prose_in %1 "substituted by" %0)

dec $subst_parameterIR'(theta, parameterIR) : parameterIR
  hint(prose_in %1 "substituted by a non-empty" %0)

dec $subst_callableTypeIR(theta, callableTypeIR) : callableTypeIR
  hint(prose_in %1 "substituted by" %0)

dec $subst_callableTypeIR'(theta, callableTypeIR) : callableTypeIR
  hint(prose_in %1 "substituted by a non-empty" %0)

dec $subst_callableTypeDefIR(theta, callableTypeDefIR) : callableTypeDefIR
  hint(prose_in %1 "substituted by" %0)

dec $subst_callableTypeDefIR'(theta, callableTypeDefIR) : callableTypeDefIR
  hint(prose_in %1 "substituted by a non-empty" %0)

dec $subst_constructorTypeIR(theta, constructorTypeIR) : constructorTypeIR
  hint(prose_in %1 "substituted by" %0)

dec $subst_constructorTypeIR'(theta, constructorTypeIR) : constructorTypeIR
  hint(prose_in %1 "substituted by a non-empty" %0)

def $capture_avoiding_(theta, typeParameterIR*, B)
  = (theta_fresh, typeParameterIR_fresh*)
  -- if `{typeId_free*`} = $diff_set<typeId>(B, `{typeParameterIR*`})
  -- (if (typeIR_free = $find_map<typeId, typeIR>(theta, typeId_free)))*
  -- if B_capture = $unions_set<typeId>($free_typeIR(typeIR_free)*)
  -- if typeParameterIR_fresh* = $fresh_typeIds(|typeParameterIR*|)
  -- (if (~$in_set<typeId>(typeParameterIR_fresh, B_capture)))*
  -- if theta_fresh
        = $adds_map<typeId, typeIR>(theta,
                                    typeParameterIR*,
                                    (_NAME typeParameterIR_fresh)*)

def $capture_avoiding(theta, typeParameterIR_expl*, typeParameterIR_impl*, B)
  = (theta_fresh, typeParameterIR_expl_fresh*, typeParameterIR_impl_fresh*)
  -- if `{typeId_free*`}
        = $diff_set<typeId>(B,
                            `{typeParameterIR_expl* ++ typeParameterIR_impl*`})
  -- (if (typeIR_free = $find_map<typeId, typeIR>(theta, typeId_free)))*
  -- if B_capture = $unions_set<typeId>($free_typeIR(typeIR_free)*)
  -- if typeId_fresh*
        = $fresh_typeIds(|typeParameterIR_expl* ++ typeParameterIR_impl*|)
  -- (if (~$in_set<typeId>(typeId_fresh, B_capture)))*
  -- if typeParameterIR_expl_fresh* = typeId_fresh*[0 : |typeParameterIR_expl*|]
  -- if typeParameterIR_impl_fresh*
        = typeId_fresh*[|typeParameterIR_expl*| : |typeParameterIR_impl*|]
  -- if theta_fresh
        = $adds_map<typeId, typeIR>(theta,
                                    typeParameterIR_expl* ++ typeParameterIR_impl*,
                                    (_NAME typeParameterIR_expl_fresh)* ++ (_NAME
                                                                            typeParameterIR_impl_fresh)*)

def $subst_typeIR(`{eps`}, typeIR) = typeIR

def $subst_typeIR(theta, typeIR) = $subst_typeIR'(theta, typeIR)
  -- if theta =/= `{eps`}

def $subst_typeIR'(theta, baseTypeIR) = baseTypeIR

def $subst_typeIR'(theta, _NAME typeId) = typeIR
  -- if typeIR = $find_map<typeId, typeIR>(theta, typeId)

def $subst_typeIR'(theta, _NAME typeId) = _NAME typeId
  -- if eps = $find_map<typeId, typeIR>(theta, typeId)

def $subst_typeIR'(theta, TYPEDEF typeId typeIR) = TYPEDEF typeId typeIR_subst
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, TYPE typeId typeIR) = TYPE typeId typeIR_subst
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, LIST `<typeIR`>) = LIST `<typeIR_subst`>
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, TUPLE `<typeIR*`>) = TUPLE `<typeIR_subst*`>
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*

def $subst_typeIR'(theta, ARRAY typeIR `[n_size`])
  = ARRAY typeIR_subst `[n_size`]
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, HEADER_STACK typeIR `[n_size`])
  = HEADER_STACK typeIR_subst `[n_size`]
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, structTypeIR) = structTypeIR_subst
  -- if STRUCT
        typeId
        `<typeArgumentIR*`>
        `{(annotationList typeIR_field nameIR_field ';')*`}
        = structTypeIR
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*
  -- if structTypeIR_subst
        = STRUCT
          typeId
          `<typeArgumentIR_subst*`>
          `{(annotationList typeIR_field_subst nameIR_field ';')*`}

def $subst_typeIR'(theta, headerTypeIR) = headerTypeIR_subst
  -- if HEADER
        typeId
        `<typeArgumentIR*`>
        `{(annotationList typeIR_field nameIR_field ';')*`}
        = headerTypeIR
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*
  -- if headerTypeIR_subst
        = HEADER
          typeId
          `<typeArgumentIR_subst*`>
          `{(annotationList typeIR_field_subst nameIR_field ';')*`}

def $subst_typeIR'(theta, headerUnionTypeIR) = headerUnionTypeIR_subst
  -- if HEADER_UNION
        typeId
        `<typeArgumentIR*`>
        `{(annotationList typeIR_field nameIR_field ';')*`}
        = headerUnionTypeIR
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*
  -- if headerUnionTypeIR_subst
        = HEADER_UNION
          typeId
          `<typeArgumentIR_subst*`>
          `{(annotationList typeIR_field_subst nameIR_field ';')*`}

def $subst_typeIR'(theta, ENUM typeId `{id_field*`}) = ENUM typeId `{id_field*`}

def $subst_typeIR'(theta, ENUM typeId `<typeIR`> `{valueFieldIR*`})
  = ENUM typeId `<typeIR_subst`> `{valueFieldIR*`}
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, externObjectTypeIR) = externObjectTypeIR_subst
  -- if EXTERN
        typeId
        `<typeArgumentIR*`>
        `{(callableId ':' externMethodTypeDefIR)*`}
        = externObjectTypeIR
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*
  -- (if (externMethodTypeDefIR_subst
         = $subst_callableTypeDefIR(theta, externMethodTypeDefIR)))*
  -- if externObjectTypeIR_subst
        = EXTERN
          typeId
          `<typeArgumentIR_subst*`>
          `{(callableId ':' externMethodTypeDefIR_subst)*`}

def $subst_typeIR'(theta, parserObjectTypeIR) = parserObjectTypeIR_subst
  -- if PARSER typeId `<typeArgumentIR*`> `(parameterIR*`) = parserObjectTypeIR
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*
  -- if parserObjectTypeIR_subst
        = PARSER typeId `<typeArgumentIR_subst*`> `(parameterIR_subst*`)

def $subst_typeIR'(theta, controlObjectTypeIR) = controlObjectTypeIR_subst
  -- if CONTROL typeId `<typeArgumentIR*`> `(parameterIR*`)
        = controlObjectTypeIR
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*
  -- if controlObjectTypeIR_subst
        = CONTROL typeId `<typeArgumentIR_subst*`> `(parameterIR_subst*`)

def $subst_typeIR'(theta, packageObjectTypeIR) = packageObjectTypeIR_subst
  -- if PACKAGE typeId `<typeArgumentIR*`> `{typeIR*`} = packageObjectTypeIR
  -- (if (typeArgumentIR_subst = $subst_typeIR'(theta, typeArgumentIR)))*
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*
  -- if packageObjectTypeIR_subst
        = PACKAGE typeId `<typeArgumentIR_subst*`> `{typeIR_subst*`}

def $subst_typeIR'(theta, tableObjectTypeIR) = tableObjectTypeIR

def $subst_typeIR'(theta, DEFAULT) = DEFAULT

def $subst_typeIR'(theta, HEADER_INVALID) = HEADER_INVALID

def $subst_typeIR'(theta, SEQ `<typeIR*`>) = SEQ `<typeIR_subst*`>
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*

def $subst_typeIR'(theta, SEQ `<typeIR* ',' '...'`>)
  = SEQ `<typeIR_subst* ',' '...'`>
  -- (if (typeIR_subst = $subst_typeIR'(theta, typeIR)))*

def $subst_typeIR'(theta, RECORD `{(annotationList typeIR_field id_field ';')*`})
  = RECORD `{(annotationList typeIR_field_subst id_field ';')*`}
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*

def $subst_typeIR'(theta,
                   RECORD
                   `{(annotationList typeIR_field id_field ';')* ',' '...'`})
  = RECORD `{(annotationList typeIR_field_subst id_field ';')* ',' '...'`}
  -- (if (typeIR_field_subst = $subst_typeIR'(theta, typeIR_field)))*

def $subst_typeIR'(theta, SET `<typeIR`>) = SET `<typeIR_subst`>
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_typeIR'(theta, tableMetadataTypeIR) = tableMetadataTypeIR

def $subst_parameterIR(`{eps`}, parameterIR) = parameterIR

def $subst_parameterIR(theta, parameterIR)
  = $subst_parameterIR'(theta, parameterIR)
  -- if theta =/= `{eps`}

def $subst_parameterIR'(theta,
                        annotationList
                        direction
                        typeIR
                        id
                        parameterInitializerOptIR)
  = annotationList direction typeIR_subst id parameterInitializerOptIR
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_callableTypeIR(`{eps`}, callableTypeIR) = callableTypeIR

def $subst_callableTypeIR(theta, callableTypeIR)
  = $subst_callableTypeIR'(theta, callableTypeIR)
  -- if theta =/= `{eps`}

def $subst_callableTypeIR'(theta, annotationList ACTION nameIR `(parameterIR*`))
  = annotationList ACTION nameIR `(parameterIR_subst*`)
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*

def $subst_callableTypeIR'(theta, FUNCTION nameIR `(parameterIR*`) ':' typeIR)
  = FUNCTION nameIR `(parameterIR_subst*`) ':' typeIR_subst
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_callableTypeIR'(theta,
                           EXTERN_FUNCTION nameIR `(parameterIR*`) ':' typeIR)
  = EXTERN_FUNCTION nameIR `(parameterIR_subst*`) ':' typeIR_subst
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_callableTypeIR'(theta, builtinMethodTypeIR) = builtinMethodTypeIR

def $subst_callableTypeIR'(theta,
                           EXTERN_METHOD nameIR `(parameterIR*`) ':' typeIR)
  = EXTERN_METHOD nameIR `(parameterIR_subst*`) ':' typeIR_subst
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_callableTypeIR'(theta,
                           EXTERN_METHOD
                           ABSTRACT
                           nameIR
                           `(parameterIR*`)
                           ':'
                           typeIR)
  = EXTERN_METHOD ABSTRACT nameIR `(parameterIR_subst*`) ':' typeIR_subst
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)

def $subst_callableTypeIR'(theta, PARSER_APPLY `(parameterIR*`))
  = PARSER_APPLY `(parameterIR_subst*`)
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*

def $subst_callableTypeIR'(theta, CONTROL_APPLY `(parameterIR*`))
  = CONTROL_APPLY `(parameterIR_subst*`)
  -- (if (parameterIR_subst = $subst_parameterIR'(theta, parameterIR)))*

def $subst_callableTypeIR'(theta, tableApplyMethodTypeIR)
  = tableApplyMethodTypeIR

def $subst_callableTypeDefIR(`{eps`}, callableTypeDefIR) = callableTypeDefIR

def $subst_callableTypeDefIR(theta, callableTypeDefIR)
  = $subst_callableTypeDefIR'(theta, callableTypeDefIR)
  -- if theta =/= `{eps`}

def $subst_callableTypeDefIR'(theta, actionTypeDefIR) = actionTypeDefIR_subst
  -- if actionTypeDefIR_subst = $subst_callableTypeIR'(theta, actionTypeDefIR)

def $subst_callableTypeDefIR'(theta,
                              FUNCTION
                              nameIR
                              `<typeParameterIR_expl* ',' typeParameterIR_impl*`>
                              `(parameterIR*`)
                              ':'
                              typeIR)
  = FUNCTION
    nameIR
    `<typeParameterIR_expl_fresh* ',' typeParameterIR_impl_fresh*`>
    `(parameterIR_subst*`)
    ':'
    typeIR_subst
  -- if B = $free_callableTypeIR(FUNCTION nameIR `(parameterIR*`) ':' typeIR)
  -- if (theta_fresh, typeParameterIR_expl_fresh*, typeParameterIR_impl_fresh*)
        = $capture_avoiding(theta,
                            typeParameterIR_expl*,
                            typeParameterIR_impl*,
                            B)
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR(theta_fresh, typeIR)

def $subst_callableTypeDefIR'(theta,
                              EXTERN_FUNCTION
                              nameIR
                              `<typeParameterIR_expl* ',' typeParameterIR_impl*`>
                              `(parameterIR*`)
                              ':'
                              typeIR)
  = EXTERN_FUNCTION
    nameIR
    `<typeParameterIR_expl_fresh* ',' typeParameterIR_impl_fresh*`>
    `(parameterIR_subst*`)
    ':'
    typeIR_subst
  -- if B
        = $free_callableTypeIR(EXTERN_FUNCTION
                               nameIR
                               `(parameterIR*`)
                               ':'
                               typeIR)
  -- if (theta_fresh, typeParameterIR_expl_fresh*, typeParameterIR_impl_fresh*)
        = $capture_avoiding(theta,
                            typeParameterIR_expl*,
                            typeParameterIR_impl*,
                            B)
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR(theta_fresh, typeIR)

def $subst_callableTypeDefIR'(theta,
                              EXTERN_METHOD
                              nameIR
                              `<typeParameterIR_expl* ',' typeParameterIR_impl*`>
                              `(parameterIR*`)
                              ':'
                              typeIR)
  = EXTERN_METHOD
    nameIR
    `<typeParameterIR_expl_fresh* ',' typeParameterIR_impl_fresh*`>
    `(parameterIR_subst*`)
    ':'
    typeIR_subst
  -- if B
        = $free_callableTypeIR(EXTERN_METHOD nameIR `(parameterIR*`) ':' typeIR)
  -- if (theta_fresh, typeParameterIR_expl_fresh*, typeParameterIR_impl_fresh*)
        = $capture_avoiding(theta,
                            typeParameterIR_expl*,
                            typeParameterIR_impl*,
                            B)
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR(theta_fresh, typeIR)

def $subst_callableTypeDefIR'(theta,
                              EXTERN_METHOD
                              ABSTRACT
                              nameIR
                              `<typeParameterIR_expl* ',' typeParameterIR_impl*`>
                              `(parameterIR*`)
                              ':'
                              typeIR)
  = EXTERN_METHOD
    ABSTRACT
    nameIR
    `<typeParameterIR_expl_fresh* ',' typeParameterIR_impl_fresh*`>
    `(parameterIR_subst*`)
    ':'
    typeIR_subst
  -- if B
        = $free_callableTypeIR(EXTERN_METHOD
                               ABSTRACT
                               nameIR
                               `(parameterIR*`)
                               ':'
                               typeIR)
  -- if (theta_fresh, typeParameterIR_expl_fresh*, typeParameterIR_impl_fresh*)
        = $capture_avoiding(theta,
                            typeParameterIR_expl*,
                            typeParameterIR_impl*,
                            B)
  -- (if (parameterIR_subst = $subst_parameterIR(theta_fresh, parameterIR)))*
  -- if typeIR_subst = $subst_typeIR(theta_fresh, typeIR)

def $subst_callableTypeDefIR'(theta, parserApplyMethodTypeDefIR)
  = parserApplyMethodTypeDefIR_subst
  -- if parserApplyMethodTypeDefIR_subst
        = $subst_callableTypeIR'(theta, parserApplyMethodTypeDefIR)

def $subst_callableTypeDefIR'(theta, controlApplyMethodTypeDefIR)
  = controlApplyMethodTypeDefIR_subst
  -- if controlApplyMethodTypeDefIR_subst
        = $subst_callableTypeIR'(theta, controlApplyMethodTypeDefIR)

def $subst_constructorTypeIR(`{eps`}, constructorTypeIR) = constructorTypeIR

def $subst_constructorTypeIR(theta, constructorTypeIR)
  = $subst_constructorTypeIR'(theta, constructorTypeIR)
  -- if theta =/= `{eps`}

def $subst_constructorTypeIR'(theta,
                              CONSTRUCTOR `(constructorParameterIR*`) ':' typeIR)
  = CONSTRUCTOR `(constructorParameterIR_subst*`) ':' typeIR_subst
  -- (if (constructorParameterIR_subst
         = $subst_parameterIR'(theta, constructorParameterIR)))*
  -- if typeIR_subst = $subst_typeIR'(theta, typeIR)
;; === 2-static-runtime/2.5.3-type-specialization.spectec ===
dec $specialize_typeDefIR(typeDefIR, typeIR*) : typeIR
  hint(prose_in %0 "specialized by" %1)

def $specialize_typeDefIR(typeDefIR_base, typeArgumentIR*) = typeIR_spec
  -- if (typeParameterIR_expl*, typeParameterIR_impl*)
        = $typeParameterListIR_of_typeDefIR(typeDefIR_base)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if |typeParameterIR*| = |typeArgumentIR*|
  -- if theta = `{(typeParameterIR ':' typeArgumentIR)*`}
  -- if typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base)
  -- if typeIR_spec = $subst_typeIR(theta, typeIR_base)

dec $specialize_callableTypeDefIR(callableTypeDefIR, typeIR*)
  : (callableTypeIR, typeId*)
  hint(prose_in %0 "specialized by" %1)

def $specialize_callableTypeDefIR(callableTypeDefIR_base, typeArgumentIR*)
  = (callableTypeIR_spec, typeId_fresh*)
  -- if (typeParameterIR_expl*, typeParameterIR_impl*)
        = $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR_base)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if |typeParameterIR_expl*| = |typeArgumentIR*|
  -- if typeId_fresh* = $fresh_typeIds(|typeParameterIR_impl*|)
  -- (if (typeArgumentIR_impl = _NAME typeId_fresh))*
  -- if theta
        = `{(typeParameterIR_expl ':' typeArgumentIR)* ++ (typeParameterIR_impl
                                                           ':'
                                                           typeArgumentIR_impl)*`}
  -- if callableTypeIR_base
        = $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR_base)
  -- if callableTypeIR_spec = $subst_callableTypeIR(theta, callableTypeIR_base)

def $specialize_callableTypeDefIR(callableTypeDefIR_base, typeArgumentIR*)
  = (callableTypeIR_spec, typeId_fresh*)
  -- if (typeParameterIR_expl*, typeParameterIR_impl*)
        = $typeParameterListIR_of_callableTypeDefIR(callableTypeDefIR_base)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if $(|typeParameterIR_expl*| > 0) /\ |typeArgumentIR*| = 0
  -- if typeId_fresh* = $fresh_typeIds(|typeParameterIR*|)
  -- (if (typeArgumentIR_fresh = _NAME typeId_fresh))*
  -- if theta = `{(typeParameterIR ':' typeArgumentIR_fresh)*`}
  -- if callableTypeIR_base
        = $callableTypeIR_of_callableTypeDefIR(callableTypeDefIR_base)
  -- if callableTypeIR_spec = $subst_callableTypeIR(theta, callableTypeIR_base)

dec $specialize_constructorTypeDefIR(constructorTypeDefIR, typeIR*)
  : (constructorTypeIR, typeId*)
  hint(prose_in %0 "specialized by" %1)

def $specialize_constructorTypeDefIR(CONSTRUCTOR
                                     `<typeParameterIR_expl*
                                       ','
                                       typeParameterIR_impl*`>
                                     `(constructorParameterIR*`)
                                     ':'
                                     typeIR,
                                     typeArgumentIR*)
  = (constructorTypeIR_spec, typeId_fresh*)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if |typeParameterIR_expl*| = |typeArgumentIR*|
  -- if typeId_fresh* = $fresh_typeIds(|typeParameterIR_impl*|)
  -- (if (typeArgumentIR_impl = _NAME typeId_fresh))*
  -- if theta
        = `{(typeParameterIR_expl ':' typeArgumentIR)* ++ (typeParameterIR_impl
                                                           ':'
                                                           typeArgumentIR_impl)*`}
  -- if constructorTypeIR_spec
        = $subst_constructorTypeIR(theta,
                                   CONSTRUCTOR
                                   `(constructorParameterIR*`)
                                   ':'
                                   typeIR)

def $specialize_constructorTypeDefIR(CONSTRUCTOR
                                     `<typeParameterIR_expl*
                                       ','
                                       typeParameterIR_impl*`>
                                     `(constructorParameterIR*`)
                                     ':'
                                     typeIR,
                                     typeArgumentIR*)
  = (constructorTypeIR_spec, typeId_fresh*)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if $(|typeParameterIR_expl*| > 0) /\ |typeArgumentIR*| = 0
  -- if typeId_fresh* = $fresh_typeIds(|typeParameterIR*|)
  -- (if (typeArgumentIR_fresh = _NAME typeId_fresh))*
  -- if theta = `{(typeParameterIR ':' typeArgumentIR_fresh)*`}
  -- if constructorTypeIR_spec
        = $subst_constructorTypeIR(theta,
                                   CONSTRUCTOR
                                   `(constructorParameterIR*`)
                                   ':'
                                   typeIR)
;; === 2-static-runtime/2.6-type-alpha.spectec ===
relation Type_alpha: typeIR ~~ typeIR
  hint(input %0 %1)
  hint(prose_true %0 "and" %1 "are the same type")
  hint(prose_false %0 "and" %1 "are not the same type")

relation ParameterType_alpha: parameterIR ~~ parameterIR
  hint(input %0 %1)
  hint(prose_true %0 "and" %1 "are the same type")
  hint(prose_false %0 "and" %1 "are not the same type")

relation ExternMethodType_alpha: externMethodTypeIR ~~ externMethodTypeIR
  hint(input %0 %1)
  hint(prose_true %0 "and" %1 "are the same type")
  hint(prose_false %0 "and" %1 "are not the same type")

relation ExternMethodTypeDef_alpha:
  externMethodTypeDefIR ~~ externMethodTypeDefIR
  hint(input %0 %1)
  hint(prose_true %0 "and" %1 "are the same type")
  hint(prose_false %0 "and" %1 "are not the same type")

rule Type_alpha/baseTypeIR:
  baseTypeIR ~~ baseTypeIR

rule Type_alpha/nameTypeIR:
  (_NAME typeId) ~~ (_NAME typeId)

rule Type_alpha/left:
  (TYPEDEF _ typeIR_a) ~~ typeIR_b
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/right:
  typeIR_a ~~ (TYPEDEF _ typeIR_b)
  -- if ~(typeIR_a <: typedefTypeIR)
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/newTypeIR:
  (TYPE typeId typeIR_a) ~~ (TYPE typeId typeIR_b)
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/listTypeIR:
  (LIST `<typeIR_a`>) ~~ (LIST `<typeIR_b`>)
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/tupleTypeIR:
  (TUPLE `<typeIR_a*`>) ~~ (TUPLE `<typeIR_b*`>)
  -- (Type_alpha: typeIR_a ~~ typeIR_b)*

rule Type_alpha/arrayTypeIR:
  (ARRAY typeIR_a `[n_size`]) ~~ (ARRAY typeIR_b `[n_size`])
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/headerStackTypeIR:
  (HEADER_STACK typeIR_a `[n_size`]) ~~ (HEADER_STACK typeIR_b `[n_size`])
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/structTypeIR:
  (STRUCT typeId `<typeArgumentIR_a*`> `{_`})
    ~~ (STRUCT typeId `<typeArgumentIR_b*`> `{_`})
  -- (Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b)*

rule Type_alpha/headerTypeIR:
  (HEADER typeId `<typeArgumentIR_a*`> `{_`})
    ~~ (HEADER typeId `<typeArgumentIR_b*`> `{_`})
  -- (Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b)*

rule Type_alpha/headerUnionTypeIR:
  (HEADER_UNION typeId `<typeArgumentIR_a*`> `{_`})
    ~~ (HEADER_UNION typeId `<typeArgumentIR_b*`> `{_`})
  -- (Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b)*

rule Type_alpha/non-serializable:
  (ENUM typeId `{nameIR_field*`}) ~~ (ENUM typeId `{nameIR_field*`})

rule Type_alpha/serializable:
  (ENUM typeId `<typeIR_a`> `{(nameIR_field '=' value_field ';')*`})
    ~~ (ENUM typeId `<typeIR_b`> `{(nameIR_field '=' value_field ';')*`})
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/externObjectTypeIR:
  (EXTERN typeId `<typeArgumentIR_a*`> _)
    ~~ (EXTERN typeId `<typeArgumentIR_b*`> _)
  -- (Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b)*

rule Type_alpha/parserObjectTypeIR:
  (PARSER _ `<_`> `(parameterIR_a*`)) ~~ (PARSER _ `<_`> `(parameterIR_b*`))
  -- (ParameterType_alpha: parameterIR_a ~~ parameterIR_b)*

rule Type_alpha/controlObjectTypeIR:
  (CONTROL _ `<_`> `(parameterIR_a*`)) ~~ (CONTROL _ `<_`> `(parameterIR_b*`))
  -- (ParameterType_alpha: parameterIR_a ~~ parameterIR_b)*

rule Type_alpha/packageObjectTypeIR:
  (PACKAGE _ `<_`> `{typeIR_a*`}) ~~ (PACKAGE _ `<_`> `{typeIR_b*`})
  -- (Type_alpha: typeIR_a ~~ typeIR_b)*

rule Type_alpha/tableObjectTypeIR:
  tableObjectTypeIR ~~ tableObjectTypeIR

rule Type_alpha/defaultTypeIR:
  DEFAULT ~~ DEFAULT

rule Type_alpha/invalidHeaderTypeIR:
  HEADER_INVALID ~~ HEADER_INVALID

rule Type_alpha/non-default:
  (SEQ `<typeIR_a*`>) ~~ (SEQ `<typeIR_b*`>)
  -- (Type_alpha: typeIR_a ~~ typeIR_b)*

rule Type_alpha/default:
  (SEQ `<typeIR_a* ',' '...'`>) ~~ (SEQ `<typeIR_b* ',' '...'`>)
  -- (Type_alpha: typeIR_a ~~ typeIR_b)*

rule Type_alpha/non-default:
  (RECORD `{(annotationList typeIR_field_a nameIR_field ';')*`})
    ~~ (RECORD `{(annotationList typeIR_field_b nameIR_field ';')*`})
  -- (Type_alpha: typeIR_field_a ~~ typeIR_field_b)*

rule Type_alpha/default:
  (RECORD `{(annotationList typeIR_field_a nameIR_field ';')* ',' '...'`})
    ~~ (RECORD `{(annotationList typeIR_field_b nameIR_field ';')* ',' '...'`})
  -- (Type_alpha: typeIR_field_a ~~ typeIR_field_b)*

rule Type_alpha/setTypeIR:
  (SET `<typeIR_a`>) ~~ (SET `<typeIR_b`>)
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule Type_alpha/tableMetadataTypeIR:
  tableMetadataTypeIR ~~ tableMetadataTypeIR

rule ParameterType_alpha:
  (_ direction typeIR_a _ _) ~~ (_ direction typeIR_b _ _)
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule ExternMethodType_alpha/non-abstract:
  (EXTERN_METHOD nameIR `(parameterIR_a*`) ':' typeIR_a)
    ~~ (EXTERN_METHOD nameIR `(parameterIR_b*`) ':' typeIR_b)
  -- (ParameterType_alpha: parameterIR_a ~~ parameterIR_b)*
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule ExternMethodType_alpha/abstract:
  (EXTERN_METHOD ABSTRACT nameIR `(parameterIR_a*`) ':' typeIR_a)
    ~~ (EXTERN_METHOD ABSTRACT nameIR `(parameterIR_b*`) ':' typeIR_b)
  -- (ParameterType_alpha: parameterIR_a ~~ parameterIR_b)*
  -- Type_alpha: typeIR_a ~~ typeIR_b

rule ExternMethodTypeDef_alpha:
  externMethodTypeDefIR_a ~~ externMethodTypeDefIR_b
  -- if (typeParameterIR_expl_a*, typeParameterIR_impl_a*)
        = $typeParameterListIR_of_callableTypeDefIR(externMethodTypeDefIR_a)
  -- if (typeParameterIR_expl_b*, typeParameterIR_impl_b*)
        = $typeParameterListIR_of_callableTypeDefIR(externMethodTypeDefIR_b)
  -- if |typeParameterIR_expl_a*| = |typeParameterIR_expl_b*|
  -- if |typeParameterIR_impl_a*| = |typeParameterIR_impl_b*|
  -- if typeParameterIR_fresh*
        = $fresh_typeIds(|typeParameterIR_expl_a* ++ typeParameterIR_impl_a*|)
  -- if typeParameterIR_a* = typeParameterIR_expl_a* ++ typeParameterIR_impl_a*
  -- if theta_a = `{(typeParameterIR_a ':' (_NAME typeParameterIR_fresh))*`}
  -- if externMethodTypeIR_a
        = $callableTypeIR_of_callableTypeDefIR(externMethodTypeDefIR_a)
  -- if externMethodTypeIR_a_subst
        = $subst_callableTypeIR(theta_a, externMethodTypeIR_a)
  -- if typeParameterIR_b* = typeParameterIR_expl_b* ++ typeParameterIR_impl_b*
  -- if theta_b = `{(typeParameterIR_b ':' (_NAME typeParameterIR_fresh))*`}
  -- if externMethodTypeIR_b
        = $callableTypeIR_of_callableTypeDefIR(externMethodTypeDefIR_b)
  -- if externMethodTypeIR_b_subst
        = $subst_callableTypeIR(theta_b, externMethodTypeIR_b)
  -- ExternMethodType_alpha:
       externMethodTypeIR_a_subst ~~ externMethodTypeIR_b_subst
;; === 2-static-runtime/2.7-compile-time-known.spectec ===
syntax ctk =
  | LCTK
  | CTK
  | DYN

dec $join_ctk(ctk, ctk) : ctk
  hint(prose_in "the join of" %0 "and" %1)

def $join_ctk(LCTK, LCTK) = LCTK

def $join_ctk(LCTK, CTK) = CTK

def $join_ctk(CTK, LCTK) = CTK

def $join_ctk(CTK, CTK) = CTK

def $join_ctk(ctk_a, ctk_b) = DYN
  -- otherwise

dec $joins_ctk(ctk*) : ctk
  hint(prose_in "the join of" %0)

def $joins_ctk(eps) = LCTK

def $joins_ctk(ctk) = ctk

def $joins_ctk(ctk_a :: ctk_b) = $join_ctk(ctk_a, ctk_b)

def $joins_ctk(ctk_a :: ctk_b :: ctk_c*) = $joins_ctk(ctk_d :: ctk_c*)
  -- if ctk_c* =/= eps
  -- if ctk_d = $join_ctk(ctk_a, ctk_b)
;; === 3-operations/3-operations.spectec ===
builtin dec $pow2(nat) : int
  hint(prose_in "2 to the power of" %0)

builtin dec $shl(int, int) : int
  hint(prose_in "the left shift of" %0 "by" %1)

builtin dec $shr(int, int) : int
  hint(prose_in "the logical right shift of" %0 "by" %1)

builtin dec $shr_arith(int, int, int) : int
  hint(prose_in "the arithmetic right shift of"
                %0
                "by"
                %1
                "with sign extension"
                %2)

builtin dec $bneg(int) : int
  hint(prose_in "the two's complement negation of" %0)

builtin dec $band(int, int) : int
  hint(prose_in "the bitwise and of" %0 "and" %1)

builtin dec $bxor(int, int) : int
  hint(prose_in "the bitwise xor of" %0 "and" %1)

builtin dec $bor(int, int) : int
  hint(prose_in "the bitwise or of" %0 "and" %1)

builtin dec $bitacc(int, int, int) : int
  hint(prose_in "the bitslice of" %0 "from" %1 "to" %2)

builtin dec $bitacc_replace(int, int, int, int) : int
  hint(prose_in "the bitslice of" %0 "from" %1 "to" %2 "replaced with" %3)

dec $un_op(unop, value) : value
  hint(prose_in %0 %1)
  hint(testgen_ignore)

dec $un_bnot(value) : value
  hint(prose_in '~' %0)
  hint(testgen_ignore)

def $un_bnot(w W i) = w W i''
  -- if i' = $bneg(i)
  -- if i'' = $ite<int>($(i' >= 0), i', $($pow2(w) + i'))

def $un_bnot(w S i) = w S i''
  -- if i' = $bneg(i)
  -- if i'' = $ite<int>($(i' >= 0), i', $($pow2(w) + i'))

def $un_op('~', value) = $un_bnot(value)

dec $un_lnot(value) : value
  hint(prose_in '!' %0)
  hint(testgen_ignore)

def $un_lnot(_B b) = _B (~b)

def $un_op('!', value) = $un_lnot(value)

dec $un_plus(value) : value
  hint(prose_in '+' %0)
  hint(testgen_ignore)

def $un_plus(D i) = D i

def $un_plus(w W i) = w W i

def $un_plus(w S i) = w S i

def $un_op('+', value) = $un_plus(value)

dec $un_minus(value) : value
  hint(prose_in '-' %0)
  hint(testgen_ignore)

def $un_minus(D i) = D $(-i)

def $un_minus(w W i) = w W i'
  -- if i' = $int_to_bitstr(w, $($pow2(w) - i))

def $un_minus(w S i) = w S i'
  -- if i' = $int_to_bitstr(w, $bitstr_to_int(w, -i))

def $un_op('-', value) = $un_minus(value)

dec $bin_op(binop, value, value) : value
  hint(prose_in %1 %0 %2)
  hint(testgen_ignore)

dec $bin_plus(value, value) : value
  hint(prose_in %0 '+' %1)
  hint(testgen_ignore)

def $bin_plus(D i_l, D i_r) = D $(i_l + i_r)

def $bin_plus(w W i_l, w W i_r) = w W i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' + i_r'))

def $bin_plus(w S i_l, w S i_r) = w S i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' + i_r'))

def $bin_op('+', value_l, value_r) = $bin_plus(value_l, value_r)

dec $bin_satplus(value, value) : value
  hint(prose_in %0 '|+|' %1)
  hint(testgen_ignore)

def $bin_satplus(w W i_l, w W i_r) = w W i'
  -- if i = $(i_l + i_r)
  -- if i_max = $pow2(w)
  -- if i' = $ite<int>($(i < i_max), i, $(i_max - 1))

def $bin_satplus(w S i_l, w S i_r) = w S i'''
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $(i_l' + i_r')
  -- if $(i' > 0)
  -- if w' = $(w - 1)
  -- if i_max = $pow2(w')
  -- if i'' = $ite<int>($(i' < i_max), i', $(i_max - 1))
  -- if i''' = $int_to_bitstr(w, i'')

def $bin_satplus(w S i_l, w S i_r) = w S i'''
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $(i_l' + i_r')
  -- if $(i' <= 0)
  -- if w' = $(w - 1)
  -- if i_min = -$pow2(w')
  -- if i'' = $ite<int>($(i' >= i_min), i', i_min)
  -- if i''' = $int_to_bitstr(w, i'')

def $bin_op('|+|', value_l, value_r) = $bin_satplus(value_l, value_r)

dec $bin_minus(value, value) : value
  hint(prose_in %0 '-' %1)
  hint(testgen_ignore)

def $bin_minus(D i_l, D i_r) = D $(i_l - i_r)

def $bin_minus(w W i_l, w W i_r) = w W i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' - i_r'))

def $bin_minus(w S i_l, w S i_r) = w S i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' - i_r'))

def $bin_op('-', value_l, value_r) = $bin_minus(value_l, value_r)

dec $bin_satminus(value, value) : value
  hint(prose_in %0 '|-|' %1)
  hint(testgen_ignore)

def $bin_satminus(w W i_l, w W i_r) = w W i'
  -- if i = $(i_l - i_r)
  -- if i' = $ite<int>($(i >= 0), i, 0)

def $bin_satminus(w S i_l, w S i_r) = w S i'''
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $(i_l' - i_r')
  -- if $(i' > 0)
  -- if w' = $(w - 1)
  -- if i_max = $pow2(w')
  -- if i'' = $ite<int>($(i' < i_max), i', $(i_max - 1))
  -- if i''' = $int_to_bitstr(w, i'')

def $bin_satminus(w S i_l, w S i_r) = w S i'''
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $(i_l' - i_r')
  -- if $(i' <= 0)
  -- if w' = $(w - 1)
  -- if i_min = -$pow2(w')
  -- if i'' = $ite<int>($(i' >= i_min), i', i_min)
  -- if i''' = $int_to_bitstr(w, i'')

def $bin_op('|-|', value_l, value_r) = $bin_satminus(value_l, value_r)

dec $bin_mul(value, value) : value
  hint(prose_in %0 '*' %1)
  hint(testgen_ignore)

def $bin_mul(D i_l, D i_r) = D $(i_l * i_r)

def $bin_mul(w W i_l, w W i_r) = w W i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' * i_r'))

def $bin_mul(w S i_l, w S i_r) = w S i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' * i_r'))

def $bin_op('*', value_l, value_r) = $bin_mul(value_l, value_r)

dec $bin_div(value, value) : value
  hint(prose_in %0 '/' %1)
  hint(testgen_ignore)

def $bin_div(D i_l, D i_r) = D $(i_l / i_r)

def $bin_div(w W i_l, w W i_r) = w W i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' / i_r'))

def $bin_op('/', value_l, value_r) = $bin_div(value_l, value_r)

dec $bin_mod(value, value) : value
  hint(prose_in %0 '%' %1)
  hint(testgen_ignore)

def $bin_mod(D i_l, D i_r) = D $(i_l \ i_r)

def $bin_mod(w W i_l, w W i_r) = w W i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $(i_l' \ i_r'))

def $bin_op('%', value_l, value_r) = $bin_mod(value_l, value_r)

dec $bin_shl(value, value) : value
  hint(prose_in %0 '<<' %1)
  hint(testgen_ignore)

def $bin_shl(D i_l, D i_r) = D $shl(i_l, i_r)

def $bin_shl(D i_l, w_r W i_r) = D $shl(i_l, i_r)

def $bin_shl(D i_l, w_r S i_r) = D $shl(i_l, i_r')
  -- if i_r' = $bitstr_to_int(w_r, i_r)

def $bin_shl(w_l W i_l, D i_r)
  = $bin_shl(w_l W i_l, w_l W $bitstr_to_int(w_l, i_r))

def $bin_shl(w_l W i_l, w_r W i_r) = w_l W i'
  -- if i' = $int_to_bitstr(w_l, $shl(i_l, i_r))

def $bin_shl(w_l W i_l, w_r S i_r) = w_l W i'
  -- if i_r' = $bitstr_to_int(w_r, i_r)
  -- if i' = $int_to_bitstr(w_l, $shl(i_l, i_r'))

def $bin_shl(w_l S i_l, D i_r)
  = $bin_shl(w_l S i_l, w_l S $bitstr_to_int(w_l, i_r))

def $bin_shl(w_l S i_l, w_r W i_r) = w_l S i'
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if i' = $int_to_bitstr(w_l, $shl(i_l', i_r))

def $bin_shl(w_l S i_l, w_r S i_r) = w_l S i'
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if i_r' = $bitstr_to_int(w_r, i_r)
  -- if i' = $int_to_bitstr(w_l, $shl(i_l', i_r'))

def $bin_op('<<', value_l, value_r) = $bin_shl(value_l, value_r)

dec $bin_shr(value, value) : value
  hint(prose_in %0 '>>' %1)
  hint(testgen_ignore)

def $bin_shr(D i_l, D i_r) = D $shr(i_l, i_r)

def $bin_shr(D i_l, w_r W i_r) = D $shr(i_l, i_r)

def $bin_shr(D i_l, w_r S i_r) = D $shr(i_l, i_r')
  -- if i_r' = $bitstr_to_int(w_r, i_r)

def $bin_shr(w_l W i_l, D i_r)
  = $bin_shr(w_l W i_l, w_l W $bitstr_to_int(w_l, i_r))

def $bin_shr(w_l W i_l, w_r W i_r) = w_l W i'
  -- if i' = $int_to_bitstr(w_l, $shr(i_l, i_r))

def $bin_shr(w_l W i_l, w_r S i_r) = w_l W i'
  -- if i_r' = $bitstr_to_int(w_r, i_r)
  -- if i' = $int_to_bitstr(w_l, $shr(i_l, i_r'))

def $bin_shr(w_l S i_l, D i_r) = w_l S i''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if $(i_l' < 0)
  -- if w_l' = $(w_l - 1)
  -- if i' = $shr_arith(i_l, i_r, $pow2(w_l'))
  -- if i'' = $int_to_bitstr(w_l, i')

def $bin_shr(w_l S i_l, D i_r) = w_l S i''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if $(i_l' >= 0)
  -- if i' = $shr(i_l, i_r)
  -- if i'' = $int_to_bitstr(w_l, i')

def $bin_shr(w_l S i_l, w_r W i_r) = w_l S i''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if $(i_l' < 0)
  -- if w_l' = $(w_l - 1)
  -- if i' = $shr_arith(i_l, i_r, $pow2(w_l'))
  -- if i'' = $int_to_bitstr(w_l, i')

def $bin_shr(w_l S i_l, w_r W i_r) = w_l S i''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if $(i_l' >= 0)
  -- if i' = $shr(i_l, i_r)
  -- if i'' = $int_to_bitstr(w_l, i')

def $bin_shr(w_l S i_l, w_r S i_r) = w_l S i''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if i_r' = $bitstr_to_int(w_r, i_r)
  -- if $(i_l' < 0)
  -- if w_l' = $(w_l - 1)
  -- if i' = $shr_arith(i_l, i_r, $pow2(w_l'))
  -- if i'' = $int_to_bitstr(w_l, i')

def $bin_shr(w_l S i_l, w_r S i_r) = w_l S i''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if i_r' = $bitstr_to_int(w_r, i_r)
  -- if $(i_l' >= 0)
  -- if i' = $shr(i_l, i_r)
  -- if i'' = $int_to_bitstr(w_l, i')

def $bin_op('>>', value_l, value_r) = $bin_shr(value_l, value_r)

dec $bin_le(value, value) : bool
  hint(prose_true %0 '<=' %1)
  hint(prose_false "not" %0 '<=' %1)
  hint(testgen_ignore)

def $bin_le(D i_l, D i_r) = $(i_l <= i_r)

def $bin_le(w W i_l, w W i_r) = $(i_l <= i_r)

def $bin_le(w S i_l, w S i_r) = $(i_l' <= i_r')
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)

def $bin_op('<=', value_l, value_r) = _B $bin_le(value_l, value_r)

dec $bin_ge(value, value) : bool
  hint(prose_true %0 '>=' %1)
  hint(prose_false "not" %0 '>=' %1)
  hint(testgen_ignore)

def $bin_ge(D i_l, D i_r) = $(i_l >= i_r)

def $bin_ge(w W i_l, w W i_r) = $(i_l >= i_r)

def $bin_ge(w S i_l, w S i_r) = $(i_l' >= i_r')
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)

def $bin_op('>=', value_l, value_r) = _B $bin_ge(value_l, value_r)

dec $bin_lt(value, value) : bool
  hint(prose_true %0 '<' %1)
  hint(prose_false "not" %0 '<' %1)
  hint(testgen_ignore)

def $bin_lt(D i_l, D i_r) = $(i_l < i_r)

def $bin_lt(w W i_l, w W i_r) = $(i_l < i_r)

def $bin_lt(w S i_l, w S i_r) = $(i_l' < i_r')
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)

def $bin_op('<', value_l, value_r) = _B $bin_lt(value_l, value_r)

dec $bin_gt(value, value) : bool
  hint(prose_true %0 '>' %1)
  hint(prose_false "not" %0 '>' %1)
  hint(testgen_ignore)

def $bin_gt(D i_l, D i_r) = $(i_l > i_r)

def $bin_gt(w W i_l, w W i_r) = $(i_l > i_r)

def $bin_gt(w S i_l, w S i_r) = $(i_l' > i_r')
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)

def $bin_op('>', value_l, value_r) = _B $bin_gt(value_l, value_r)

dec $bin_eq(value, value) : bool
  hint(prose_true %0 '==' %1)
  hint(prose_false "not" %0 '==' %1)
  hint(testgen_ignore)

def $bin_eq(_B b_a, _B b_b) = (b_a = b_b)

def $bin_eq(ERROR '.' id_a, ERROR '.' id_b) = (id_a = id_b)

def $bin_eq(MATCH_KIND '.' id_a, MATCH_KIND '.' id_b) = (id_a = id_b)

def $bin_eq(stringValue_a, stringValue_b) = (stringValue_a = stringValue_b)

def $bin_eq(D i_a, D i_b) = (i_a = i_b)

def $bin_eq(w_a W i_a, w_b W i_b) = (w_a = w_b) /\ (i_a = i_b)

def $bin_eq(w_a S i_a, w_b S i_b) = (w_a = w_b) /\ (i_a = i_b)

def $bin_eq(w_max_a '.' _ V i_a, w_max_b '.' _ V i_b)
  = (w_max_a = w_max_b) /\ (i_a = i_b)

def $bin_eq(LIST `[value_a*`], LIST `[value_b*`]) = false
  -- if |value_a*| =/= |value_b*|

def $bin_eq(LIST `[value_a*`], LIST `[value_b*`])
  = $forall_($bin_eq(value_a, value_b)*)
  -- if |value_a*| = |value_b*|

def $bin_eq(TUPLE `(value_a*`), TUPLE `(value_b*`))
  = |value_a*| = |value_b*| /\ $forall_($bin_eq(value_a, value_b)*)

def $bin_eq(SEQ `(value_a*`), SEQ `(value_b*`)) = false
  -- if |value_a*| =/= |value_b*|

def $bin_eq(SEQ `(value_a*`), SEQ `(value_b*`))
  = $forall_($bin_eq(value_a, value_b)*)
  -- if |value_a*| = |value_b*|

def $bin_eq(ARRAY `[value_a*`], ARRAY `[value_b*`]) = false
  -- if |value_a*| =/= |value_b*|

def $bin_eq(ARRAY `[value_a*`], ARRAY `[value_b*`])
  = $forall_($bin_eq(value_a, value_b)*)
  -- if |value_a*| = |value_b*|

def $bin_eq(HEADER_STACK `[value_a* `(_`)`], HEADER_STACK `[value_b* `(_`)`])
  = false
  -- if |value_a*| =/= |value_b*|

def $bin_eq(HEADER_STACK `[value_a* `(_`)`], HEADER_STACK `[value_b* `(_`)`])
  = $forall_($bin_eq(value_a, value_b)*)
  -- if |value_a*| = |value_b*|

def $bin_eq(STRUCT typeId_a `{fieldValue_a*`}, STRUCT typeId_b `{fieldValue_b*`})
  = (typeId_a = typeId_b) /\ |fieldValue_a*| = |fieldValue_b*|
  /\ $forall_($bin_eq(value_field_a, value_field_b)*)
  /\ $forall_((nameIR_field_a = nameIR_field_b)*)
  -- (if (value_field_a nameIR_field_a ';' = fieldValue_a))*
  -- (if (value_field_b nameIR_field_b ';' = fieldValue_b))*

def $bin_eq(HEADER typeId_a `{_ ';' fieldValue_a*`},
            HEADER typeId_b `{_ ';' fieldValue_b*`})
  = (typeId_a = typeId_b) /\ |fieldValue_a*| = |fieldValue_b*|
  /\ $forall_($bin_eq(value_field_a, value_field_b)*)
  /\ $forall_((nameIR_field_a = nameIR_field_b)*)
  -- (if (value_field_a nameIR_field_a ';' = fieldValue_a))*
  -- (if (value_field_b nameIR_field_b ';' = fieldValue_b))*

def $bin_eq(HEADER_UNION typeId_a `{fieldValue_a*`},
            HEADER_UNION typeId_b `{fieldValue_b*`})
  = (typeId_a = typeId_b) /\ |fieldValue_a*| = |fieldValue_b*|
  /\ $forall_($bin_eq(value_field_a, value_field_b)*)
  /\ $forall_((nameIR_field_a = nameIR_field_b)*)
  -- (if (value_field_a nameIR_field_a ';' = fieldValue_a))*
  -- (if (value_field_b nameIR_field_b ';' = fieldValue_b))*

def $bin_eq(typeId_a '.' nameIR_field_a, typeId_b '.' nameIR_field_b)
  = (typeId_a = typeId_b) /\ (nameIR_field_a = nameIR_field_b)

def $bin_eq(typeId_a '.' _ '.' value_field_a, typeId_b '.' _ '.' value_field_b)
  = (typeId_a = typeId_b) /\ $bin_eq(value_field_a, value_field_b)

def $bin_eq('{#}', '{#}') = true

def $bin_op('==', value_l, value_r) = _B $bin_eq(value_l, value_r)

dec $bin_ne(value, value) : bool
  hint(prose_true %0 '!=' %1)
  hint(prose_false "not" %0 '!=' %1)
  hint(testgen_ignore)

def $bin_ne(value_l, value_r) = ~$bin_eq(value_l, value_r)

def $bin_op('!=', value_l, value_r) = _B $bin_ne(value_l, value_r)

dec $bin_band(value, value) : value
  hint(prose_in %0 '&' %1)
  hint(testgen_ignore)

def $bin_band(w W i_l, w W i_r) = w W i'
  -- if i' = $int_to_bitstr(w, $band(i_l, i_r))

def $bin_band(w S i_l, w S i_r) = w S i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $band(i_l', i_r'))

def $bin_op('&', value_l, value_r) = $bin_band(value_l, value_r)

dec $bin_bxor(value, value) : value
  hint(prose_in %0 '^' %1)
  hint(testgen_ignore)

def $bin_bxor(w W i_l, w W i_r) = w W i'
  -- if i' = $int_to_bitstr(w, $bxor(i_l, i_r))

def $bin_bxor(w S i_l, w S i_r) = w S i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $bxor(i_l', i_r'))

def $bin_op('^', value_l, value_r) = $bin_bxor(value_l, value_r)

dec $bin_bor(value, value) : value
  hint(prose_in %0 '|' %1)
  hint(testgen_ignore)

def $bin_bor(w W i_l, w W i_r) = w W i'
  -- if i' = $int_to_bitstr(w, $bor(i_l, i_r))

def $bin_bor(w S i_l, w S i_r) = w S i'
  -- if i_l' = $bitstr_to_int(w, i_l)
  -- if i_r' = $bitstr_to_int(w, i_r)
  -- if i' = $int_to_bitstr(w, $bor(i_l', i_r'))

def $bin_op('|', value_l, value_r) = $bin_bor(value_l, value_r)

dec $bin_concat(value, value) : value
  hint(prose_in %0 '++' %1)
  hint(testgen_ignore)

def $bin_concat('"' t_l '"', '"' t_r '"') = '"' (t_l ++ t_r) '"'

def $bin_concat(w_l W i_l, w_r W i_r) = w W i''
  -- if i_l' = $shl(i_l, w_r)
  -- if i_l'' = $(i_l' + i_r)
  -- if w = $(w_l + w_r)
  -- if i'' = $int_to_bitstr(w, i_l'')

def $bin_concat(w_l W i_l, w_r S i_r) = w W i''
  -- if i_l' = $shl(i_l, w_r)
  -- if i_l'' = $(i_l' + i_r)
  -- if w = $(w_l + w_r)
  -- if i'' = $int_to_bitstr(w, i_l'')

def $bin_concat(w_l S i_l, w_r W i_r) = w S i'''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if i_l'' = $shl(i_l', w_r)
  -- if i_l''' = $(i_l'' + i_r)
  -- if w = $(w_l + w_r)
  -- if i''' = $int_to_bitstr(w, i_l''')

def $bin_concat(w_l S i_l, w_r S i_r) = w S i'''
  -- if i_l' = $bitstr_to_int(w_l, i_l)
  -- if i_l'' = $shl(i_l', w_r)
  -- if i_l''' = $(i_l'' + i_r)
  -- if w = $(w_l + w_r)
  -- if i''' = $int_to_bitstr(w, i_l''')

def $bin_op('++', value_l, value_r) = $bin_concat(value_l, value_r)

dec $cast_op(typeIR, value) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

dec $default(typeIR) : value
  hint(prose_in "the default value for type" %0)

dec $cast_to_enum(enumTypeIR, value) : value
  hint(prose_in %1 "casted to enum type" %0)

dec $cast_to_enum'(typeId, typeIR, valueFieldIR*, value) : value

def $cast_to_enum'(typeId, typeIR, eps, value_target)
  = typeId '.' id_unnamed '.' value_idx
  -- if value_idx = $cast_op(typeIR, value_target)
  -- if id_unnamed = "__UNSPECIFIED"

def $cast_to_enum'(typeId,
                   typeIR,
                   valueFieldIR_h :: valueFieldIR_t*,
                   value_target)
  = typeId '.' nameIR '.' value
  -- if nameIR '=' value ';' = valueFieldIR_h
  -- if $bin_eq(value, value_target)

def $cast_to_enum'(typeId,
                   typeIR,
                   valueFieldIR_h :: valueFieldIR_t*,
                   value_target)
  = $cast_to_enum'(typeId, typeIR, valueFieldIR_t*, value_target)
  -- if nameIR '=' value ';' = valueFieldIR_h
  -- if ~$bin_eq(value, value_target)

def $cast_to_enum(ENUM typeId `<typeIR`> `{valueFieldIR*`}, value)
  = $cast_to_enum'(typeId, typeIR, valueFieldIR*, value)

dec $cast_bool(typeIR, boolValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_bool(BOOL, _B b) = _B b

def $cast_bool(BIT `<w`>, _B true) = w W 1

def $cast_bool(BIT `<w`>, _B false) = w W 0

def $cast_bool(TYPE _ typeIR, boolValue) = $cast_op(typeIR, boolValue)

def $cast_bool(SET `<typeIR`>, boolValue) = SET `{$cast_op(typeIR, boolValue)`}

def $cast_op(typeIR, boolValue) = $cast_bool(typeIR_unroll, boolValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_int(typeIR, integerValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_int(BOOL, D i) = _B (i =/= 0)

def $cast_int(BOOL, w W i) = _B (i =/= 0)

def $cast_int(INT, D i) = D i

def $cast_int(INT, _ W i) = D i

def $cast_int(INT, w S i) = D $bitstr_to_int(w, i)

def $cast_int(BIT `<w_to`>, D i) = w_to W i_cast
  -- if i_cast = $int_to_bitstr(w_to, i)

def $cast_int(BIT `<w_to`>, _ W i) = w_to W i_cast
  -- if i_cast = $int_to_bitstr(w_to, i)

def $cast_int(BIT `<w_to`>, w_from S i) = w_to W i_cast
  -- if i_from = $bitstr_to_int(w_from, i)
  -- if i_cast = $int_to_bitstr(w_to, i_from)

def $cast_int(INT `<w_to`>, D i) = w_to S i_cast
  -- if i_cast = $int_to_bitstr(w_to, i)

def $cast_int(INT `<w_to`>, _ W i) = w_to S i_cast
  -- if i_cast = $int_to_bitstr(w_to, i)

def $cast_int(INT `<w_to`>, w_from S i) = w_to S i_cast
  -- if i_from = $bitstr_to_int(w_from, i)
  -- if i_cast = $int_to_bitstr(w_to, i_from)

def $cast_int(VARBIT `<w_max`>, w_max '.' w V i) = w_max '.' w V i

def $cast_int(TYPE _ typeIR, D i) = $cast_op(typeIR, D i)

def $cast_int(TYPE _ typeIR, w W i) = $cast_op(typeIR, w W i)

def $cast_int(TYPE _ typeIR, w S i) = $cast_op(typeIR, w S i)

def $cast_int(enumTypeIR, w W i) = $cast_to_enum(enumTypeIR, w W i)

def $cast_int(enumTypeIR, w S i) = $cast_to_enum(enumTypeIR, w S i)

def $cast_int(SET `<typeIR`>, D i) = SET `{$cast_op(typeIR, D i)`}

def $cast_int(SET `<typeIR`>, w W i) = SET `{$cast_op(typeIR, w W i)`}

def $cast_int(SET `<typeIR`>, w S i) = SET `{$cast_op(typeIR, w S i)`}

def $cast_op(typeIR, integerValue) = $cast_int(typeIR_unroll, integerValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_error(typeIR, errorValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_error(ERROR, ERROR '.' nameIR) = ERROR '.' nameIR

def $cast_error(SET `<typeIR`>, errorValue)
  = SET `{$cast_op(typeIR, errorValue)`}

def $cast_op(typeIR, errorValue) = $cast_error(typeIR_unroll, errorValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

def $cast_op(typeIR, MATCH_KIND '.' nameIR) = MATCH_KIND '.' nameIR
  -- if MATCH_KIND = $unroll_typeIR(typeIR)

dec $cast_string(typeIR, stringValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_string(STRING, stringValue) = stringValue

def $cast_op(typeIR, stringValue) = $cast_string(typeIR_unroll, stringValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_list(typeIR, listValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_list(LIST `<typeIR`>, LIST `[value*`])
  = LIST `[$cast_op(typeIR, value)*`]

def $cast_op(typeIR, listValue) = $cast_list(typeIR_unroll, listValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

