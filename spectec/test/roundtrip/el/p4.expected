    tableEntryPriorityOptIR
    keysetExpressionIR
    ':'
    tableActionReferenceIR
    annotationList
    ';'

dec $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)
  : tableEntryPriorityOptIR
  hint(prose_in "the priority of" %0)

def $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)
  = tableEntryPriorityOptIR
  -- if _ tableEntryPriorityOptIR _ ':' _ _ ';' = tableEntryIR

syntax tableEntryListIR = tableEntryIR*

syntax tableCustomPropertyIR

syntax tableKeysPropertyIR =
  | KEY '=' `{tableKeyListIR`}

syntax tableActionsPropertyIR =
  | ACTIONS '=' `{tableActionListIR`}

syntax tableDefaultActionPropertyIR =
  | annotationList constOptIR DEFAULT_ACTION '=' tableActionReferenceIR ';'

syntax tableEntriesPropertyIR =
  | annotationList constOptIR ENTRIES '=' `{tableEntryListIR`}

syntax tableCustomPropertyIR =
  | annotationList constOptIR CUSTOM nameIR initializerIR ';'
  | annotationList constOptIR CUSTOM_CONST nameIR constantInitializerIR ';'

syntax tablePropertyIR =
  | tableKeysPropertyIR
  | tableActionsPropertyIR
