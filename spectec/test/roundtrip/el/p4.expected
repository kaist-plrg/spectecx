dec $compat_concat(typeIR, typeIR) : bool

def $compat_concat(STRING, STRING) = true

def $compat_concat(INT `<_`>, INT `<_`>) = true

def $compat_concat(INT `<_`>, BIT `<_`>) = true

def $compat_concat(BIT `<_`>, INT `<_`>) = true

