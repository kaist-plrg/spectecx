       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT (_B true))
  -- Stmt_eval: LOCAL EC_1 ARCH_1 |- statementIR : EC_2 ARCH_2 returnResult

rule ForThreeClauseStmt_eval/cond-true-loop-break:
