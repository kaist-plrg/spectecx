    : EC_1 ARCH_1 expressionResult
  -- Exprs_eval:
       p EC_0 ARCH_0
         |- [typedExpressionIR_base, typedExpressionIR_l, typedExpressionIR_w]
         : EC_1 ARCH_1 (_CONT ([value_base, value_l, value_w]))
  -- if expressionResult = _CONT $bitacc_offset_op(value_base, value_l, value_w)

rule Expr_eval/callee-abort:
  p EC_0 ARCH_0
    |- (callableTargetIR `<typeArgumentIR*`> `(argumentIR*`)) '#' _
    : EC_1 ARCH_1 abortResult
  -- Callee_eval:
       p EC_0 ARCH_0
         |- callableTargetIR `<'_'`> `(argumentIR*`)
         : EC_1 ARCH_1 abortResult

rule Expr_eval/callee-cont-call-abort:
  p EC_0 ARCH_0
    |- (callableTargetIR `<typeArgumentIR*`> `(argumentIR*`)) '#' _
    : EC_2 ARCH_2 abortResult
  -- Callee_eval:
       p EC_0 ARCH_0
         |- callableTargetIR `<'_'`> `(argumentIR*`)
         : EC_1 ARCH_1 (_CONT callee)
  -- Call_eval:
       p EC_1 ARCH_1
         |- callee '@' `<typeArgumentIR*`> `(argumentIR*`)
         : EC_2 ARCH_2 abortResult

rule Expr_eval/callee-cont-call-return:
  p EC_0 ARCH_0
    |- (callableTargetIR `<typeArgumentIR*`> `(argumentIR*`)) '#' _
    : EC_2 ARCH_2 (_CONT value)
  -- Callee_eval:
       p EC_0 ARCH_0
         |- callableTargetIR `<'_'`> `(argumentIR*`)
         : EC_1 ARCH_1 (_CONT callee)
  -- Call_eval:
       p EC_1 ARCH_1
         |- callee '@' `<typeArgumentIR*`> `(argumentIR*`)
         : EC_2 ARCH_2 (RETURN value)

rule Expr_eval/parenthesizedExpressionIR:
  p EC_0 ARCH_0 |- (`(typedExpressionIR`)) '#' _ : EC_1 ARCH_1 expressionResult
  -- Expr_eval:
       p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult

rule Exprs_eval/nil:
  p EC ARCH |- eps : EC ARCH (_CONT eps)

rule Exprs_eval/cons-head-abort:
  p EC_0 ARCH_0
    |- typedExpressionIR_h :: typedExpressionIR_t*
    : EC_1 ARCH_1 abortResult
  -- Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_h : EC_1 ARCH_1 abortResult

rule Exprs_eval/cons-head-cont-tail-abort:
  p EC_0 ARCH_0
    |- typedExpressionIR_h :: typedExpressionIR_t*
    : EC_2 ARCH_2 abortResult
  -- Expr_eval:
       p EC_0 ARCH_0 |- typedExpressionIR_h : EC_1 ARCH_1 (_CONT value_h)
  -- Exprs_eval: p EC_1 ARCH_1 |- typedExpressionIR_t* : EC_2 ARCH_2 abortResult

rule Exprs_eval/cons-head-cont-tail-cont:
  p EC_0 ARCH_0
    |- typedExpressionIR_h :: typedExpressionIR_t*
    : EC_2 ARCH_2 (_CONT (value_h :: value_t*))
  -- Expr_eval:
       p EC_0 ARCH_0 |- typedExpressionIR_h : EC_1 ARCH_1 (_CONT value_h)
  -- Exprs_eval:
       p EC_1 ARCH_1 |- typedExpressionIR_t* : EC_2 ARCH_2 (_CONT value_t*)
;; === 8-dynamic/8.03.2-eval-keyset-expression.spectec ===
dec $match_keysets(setValue*, value*) : bool
  hint(prose_true %1 "matches" %0)
  hint(prose_false %1 "does not match" %0)

dec $match_keyset(setValue, value) : bool

def $match_keysets(eps, eps) = true

def $match_keysets(SET `{'...'`}, value_key*) = true

def $match_keysets(setValue, value_key) = $match_keyset(setValue, value_key)
  -- if setValue =/= SET `{'...'`}

def $match_keysets(setValue_h :: setValue_t*, value_key_h :: value_key_t*)
  = $match_keysets(setValue_t*, value_key_t*)
  -- if setValue_t* =/= eps
  -- if value_key_t* =/= eps
  -- if $match_keyset(setValue_h, value_key_h)

def $match_keysets(setValue_h :: setValue_t*, value_key_h :: value_key_t*)
  = false
  -- if setValue_t* =/= eps
  -- if value_key_t* =/= eps
  -- if ~$match_keyset(setValue_h, value_key_h)

def $match_keyset(SET `{'...'`}, value_key) = true

def $match_keyset(SET `{value`}, value_key) = $bin_eq(value, value_key)

def $match_keyset(SET `{value* `(_`)`}, value_key)
  = $exists_($bin_eq(value, value_key)*)

def $match_keyset(SET `{value_base '&&&' value_mask`}, value_key)
  = $bin_eq($bin_band(value_base, value_mask), $bin_band(value_key, value_mask))

def $match_keyset(SET `{value_base '..' value_limit`}, value_key)
  = $bin_le(value_base, value_key) /\ $bin_le(value_key, value_limit)

syntax simpleKeysetExpressionResult =
  | continueResult<setValue>
  | abortResult

relation Eval_keyset_simple:
  evalContext arch
    |- simpleKeysetExpressionIR
    : evalContext arch simpleKeysetExpressionResult
  hint(input %0 %1 %2)
  hint(prose_in "evaluating" %2#", under context" %0 "and state" %1)
  hint(prose_out "context" %3#", state" %4#", and result" %5)

rule Eval_keyset_simple/abort:
  EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult
  -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult

rule Eval_keyset_simple/cont-setValue:
  EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT setValue)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT setValue)

rule Eval_keyset_simple/cont-objectReferenceValue:
  EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT setValue)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0
         |- typedExpressionIR
         : EC_1 ARCH_1 (_CONT (REF objectId))
  -- if VALUE_SET `{value* `(n_size`)`} = $find_object_e(ARCH_1, objectId)
  -- if setValue = SET `{value* `(n_size`)`}

rule Eval_keyset_simple/left-abort:
  EC_0 ARCH_0
    |- typedExpressionIR_l '&&&' typedExpressionIR_r
    : EC_1 ARCH_1 abortResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult

rule Eval_keyset_simple/left-cont-right-abort:
  EC_0 ARCH_0
    |- typedExpressionIR_l '&&&' typedExpressionIR_r
    : EC_2 ARCH_2 abortResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT value_l)
  -- Expr_eval:
       LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult

rule Eval_keyset_simple/left-cont-right-cont:
  EC_0 ARCH_0
    |- typedExpressionIR_l '&&&' typedExpressionIR_r
    : EC_2 ARCH_2 (_CONT setValue)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT value_l)
  -- Expr_eval:
       LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 (_CONT value_r)
  -- if setValue = SET `{value_l '&&&' value_r`}

rule Eval_keyset_simple/left-abort:
  EC_0 ARCH_0
    |- typedExpressionIR_l '..' typedExpressionIR_r
    : EC_1 ARCH_1 abortResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult

rule Eval_keyset_simple/left-cont-right-abort:
  EC_0 ARCH_0
    |- typedExpressionIR_l '..' typedExpressionIR_r
    : EC_2 ARCH_2 abortResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT value_l)
  -- Expr_eval:
       LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult

rule Eval_keyset_simple/left-cont-right-cont:
  EC_0 ARCH_0
    |- typedExpressionIR_l '..' typedExpressionIR_r
    : EC_2 ARCH_2 (_CONT setValue)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT value_l)
  -- Expr_eval:
       LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 (_CONT value_r)
  -- if setValue = SET `{value_l '..' value_r`}

rule Eval_keyset_simple/default-any:
  EC ARCH |- simpleKeysetExpressionIR : EC ARCH (_CONT setValue)
  -- if simpleKeysetExpressionIR = DEFAULT \/ simpleKeysetExpressionIR = '_'
  -- if setValue = SET `{'...'`}

relation Eval_keysets_simple:
  evalContext arch
    |- simpleKeysetExpressionListIR
    : evalContext arch keysetExpressionResult
  hint(input %0 %1 %2)

rule Eval_keysets_simple/nil:
  EC ARCH |- eps : EC ARCH (_CONT eps)

rule Eval_keysets_simple/cons-head-abort:
  EC_0 ARCH_0
    |- simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*
    : EC_1 ARCH_1 abortResult
  -- Eval_keyset_simple:
       EC_0 ARCH_0 |- simpleKeysetExpressionIR_h : EC_1 ARCH_1 abortResult

rule Eval_keysets_simple/cons-head-cont-tail-abort:
  EC_0 ARCH_0
    |- simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*
    : EC_2 ARCH_2 abortResult
  -- Eval_keyset_simple:
       EC_0 ARCH_0
         |- simpleKeysetExpressionIR_h
         : EC_1 ARCH_1 (_CONT setValue_h)
  -- Eval_keysets_simple:
       EC_1 ARCH_1 |- simpleKeysetExpressionIR_t* : EC_2 ARCH_2 abortResult

rule Eval_keysets_simple/cons-head-cont-tail-cont:
  EC_0 ARCH_0
    |- simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*
    : EC_2 ARCH_2 keysetExpressionResult
  -- Eval_keyset_simple:
       EC_0 ARCH_0
         |- simpleKeysetExpressionIR_h
         : EC_1 ARCH_1 (_CONT setValue_h)
  -- Eval_keysets_simple:
       EC_1 ARCH_1
         |- simpleKeysetExpressionIR_t*
         : EC_2 ARCH_2 (_CONT setValue_t*)
  -- if keysetExpressionResult = _CONT (setValue_h :: setValue_t*)

rule Eval_keyset:
  EC_0 ARCH_0 |- keysetExpressionIR : EC_1 ARCH_1 keysetExpressionResult
  -- if simpleKeysetExpressionListIR
        = $flatten_keysetExpressionIR(keysetExpressionIR)
  -- Eval_keysets_simple:
       EC_0 ARCH_0
         |- simpleKeysetExpressionListIR
         : EC_1 ARCH_1 keysetExpressionResult
;; === 8-dynamic/8.04-eval-argument.spectec ===
