rule ParserState_eval/reject:
  EC_0 ARCH_0 |- parserStateIR : EC_3 ARCH_1 rejectTransitionResult
  -- if annotationList
        STATE
        nameIR
        `{parserBlockElementStatementListIR transitionStatementIR`}
        = parserStateIR
  -- if EC_1 = $enter_e(EC_0)
  -- ParserBlockElementStmtList_eval:
       EC_1 ARCH_0
         |- parserBlockElementStatementListIR
         : EC_2 ARCH_1 rejectTransitionResult
  -- if EC_3 = $exit_e(EC_2)

rule ParserState_eval/cont:
  EC_0 ARCH_0 |- parserStateIR : EC_4 ARCH_2 transitionResult
  -- if annotationList
        STATE
        nameIR
        `{parserBlockElementStatementListIR transitionStatementIR`}
        = parserStateIR
  -- if EC_1 = $enter_e(EC_0)
  -- ParserBlockElementStmtList_eval:
       EC_1 ARCH_0 |- parserBlockElementStatementListIR : EC_2 ARCH_1 _EMPTY
  -- ParserTransition_eval:
       EC_2 ARCH_1 |- transitionStatementIR : EC_3 ARCH_2 transitionResult
  -- if EC_4 = $exit_e(EC_3)

rule ParserState_trans/accept:
  EC_0 ARCH_0 |- TRANSITION nameIR : EC_1 ARCH_1 ACCEPT
