                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- if inference
        = $infer(typeId_infer*,
                 parameterIR_aligned*,
                 parameterIR_optional*,
                 argumentIR*)
  -- (if (typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
  -- (if (parameterIR_aligned_inferred
         = $subst_parameterIR(inference, parameterIR_aligned)))*
  -- if typeIR_ret_inferred = $subst_typeIR(inference, typeIR_ret)
  -- if externMethodTypeIR_inferred
        = EXTERN_METHOD
          nameIR
          `(parameterIR_aligned_inferred*`)
          ':'
          typeIR_ret_inferred
  -- if B = $bound(p, TC)
  -- CallableType_wf: B |- externMethodTypeIR_inferred
  -- if $callable_externMethod(p, TC)
  -- Call_convention_ok:
       p TC NOACTION
         |- parameterIR_aligned_inferred* '@' argumentIR*
         : argumentIR_cast*

rule Call_ok/abstract:
  p TC
    |- externMethodTypeIR
       `<typeArgumentIR* '#' typeId_infer*`>
       `(argumentIR* '#' id_default* '#' id_optional*`)
    : typeIR_ret_inferred `<typeArgumentIR_inferred*`> `(argumentIR_cast*`)
  -- if EXTERN_METHOD ABSTRACT nameIR `(parameterIR*`) ':' typeIR_ret
        = externMethodTypeIR
  -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL parameterIR_optional*
        = $align_parameterListIR(parameterIR*,
                                 argumentIR*,
                                 id_default*,
                                 id_optional*)
  -- if inference
        = $infer(typeId_infer*,
                 parameterIR_aligned*,
                 parameterIR_optional*,
                 argumentIR*)
  -- (if (typeArgumentIR_inferred = $subst_typeIR(inference, typeArgumentIR)))*
  -- (if (parameterIR_aligned_inferred
         = $subst_parameterIR(inference, parameterIR_aligned)))*
  -- if typeIR_ret_inferred = $subst_typeIR(inference, typeIR_ret)
  -- if externMethodTypeIR_inferred
        = EXTERN_METHOD
          ABSTRACT
          nameIR
          `(parameterIR_aligned_inferred*`)
          ':'
          typeIR_ret_inferred
  -- if B = $bound(p, TC)
  -- CallableType_wf: B |- externMethodTypeIR_inferred
  -- if $callable_externMethod(p, TC)
  -- Call_convention_ok:
       p TC NOACTION
         |- parameterIR_aligned_inferred* '@' argumentIR*
         : argumentIR_cast*

dec $callable_parserApplyMethod(cursor, typingContext) : bool

def $callable_parserApplyMethod(GLOBAL, TC) = false

def $callable_parserApplyMethod(BLOCK, TC) = false

