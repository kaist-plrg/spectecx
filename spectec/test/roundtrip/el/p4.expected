;; === 5-typing/5.04-typing-relation.spectec ===
relation ExternFunctionCall_eval_lctk:
  typingContext |- nameIR `(nameIR*`) ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "calling an extern function" %1#"("#%2#")" "under context" %0)
  hint(prose_out %3)

relation Expr_eval_lctk: cursor typingContext |- typedExpressionIR ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "local compile-time evaluation of" %2#", under context"
                %1
                "at"
                %0)
  hint(prose_out %3)

relation Argument_eval_lctk: cursor typingContext |- argumentIR ~> value
  hint(input %0 %1 %2)
  hint(testgen_ignore)
  hint(prose_in "local compile-time evaluation of" %2#", under context"
                %1
                "at"
                %0)
  hint(prose_out %3)

relation Type_ok: cursor typingContext |- typeOrVoid : typeIR '#' typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3 "and fresh type variables" %4)

relation TypeParameterListOpt_ok:
  cursor typingContext |- typeParameterListOpt : typingContext typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out "context" %3 "and type parameters" %4)

relation TypeArgument_ok:
  cursor typingContext |- typeArgument : typeArgumentIR '#' typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3 "and fresh type variables" %4)

relation TypeArguments_ok:
  cursor typingContext |- typeArgument* : typeArgumentListIR '#' typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3 "and fresh type variables" %4)

relation TypeArgumentList_ok:
  cursor typingContext |- typeArgumentList : typeArgumentListIR '#' typeId*
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3 "and fresh type variables" %4)

syntax castResult =
  | OK typeIR*
  | FAIL

relation Cast_expl: typeIR -> typeIR : castResult
  hint(input %0 %1)
  hint(prose_in "checking if" %0 "can be explicitly cast to" %1)
  hint(prose_out "casts" %2)

relation Cast_expl_neq: typeIR -> typeIR : castResult
  hint(input %0 %1)
  hint(prose_in "checking if" %0 "can be explicitly cast to" %1 "(when unequal)")
  hint(prose_out "casts" %2)

relation Cast_impl: typeIR -> typeIR : castResult
  hint(input %0 %1)
  hint(prose_in "checking if" %0 "can be implicitly cast to" %1)
  hint(prose_out "casts" %2)

relation Cast_impl_neq: typeIR -> typeIR : castResult
  hint(input %0 %1)
  hint(prose_in "checking if" %0 "can be implicitly cast to" %1 "(when unequal)")
  hint(prose_out "casts" %2)

relation Expr_ok: cursor typingContext |- expression : typedExpressionIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3)

relation Argument_ok: cursor typingContext |- argument : argumentIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3)

relation ArgumentList_ok: cursor typingContext |- argumentList : argumentListIR
  hint(input %0 %1 %2)
  hint(prose_in "typing" %2#", under context" %1 "at" %0)
  hint(prose_out %3)

relation Lvalue_ok: cursor typingContext |- lvalue : typedLvalueIR
