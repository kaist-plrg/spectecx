  -- ForInitStmts_eval:
       EC_1 ARCH_0 |- forInitStatementListIR : EC_2 ARCH_1 abortResult
  -- if EC_3 = $exit_e(EC_2)

rule Stmt_eval/init-cont:
  LOCAL EC_0 ARCH_0
    |- annotationList
       FOR
       `(forInitStatementListIR
         ';'
         typedExpressionIR
         ';'
