def $flatten_realTypeArgumentList(realTypeArgument) = realTypeArgument

def $flatten_realTypeArgumentList(realTypeArgumentList ',' realTypeArgument)
  = $flatten_realTypeArgumentList(realTypeArgumentList) ++ [realTypeArgument]

syntax typeArgument =
  | realTypeArgument
  | nonTypeName

syntax typeArgumentList =
  | _EMPTY
  | typeArgument
  | typeArgumentList ',' typeArgument

dec $flatten_typeArgumentList(typeArgumentList) : typeArgument*
  hint(prose_in %0 "flattened")

def $flatten_typeArgumentList(_EMPTY) = eps

def $flatten_typeArgumentList(typeArgument) = typeArgument

def $flatten_typeArgumentList(typeArgumentList ',' typeArgument)
  = $flatten_typeArgumentList(typeArgumentList) ++ [typeArgument]

syntax argument =
  | expression
  | name '=' expression
  | name '=' '_'
  | '_'

syntax argumentListNonEmpty =
  | argument
  | argumentListNonEmpty ',' argument

syntax argumentList =
  | _EMPTY
  | argumentListNonEmpty

dec $flatten_argumentList(argumentList) : argument*
  hint(prose_in %0 "flattened")

def $flatten_argumentList(_EMPTY) = eps

def $flatten_argumentList(argument) = argument

def $flatten_argumentList(argumentListNonEmpty ',' argument)
  = $flatten_argumentList(argumentListNonEmpty) ++ [argument]

syntax lvalue =
  | referenceExpression
  | lvalue '.' member
  | lvalue `[expression`]
  | lvalue `[expression sliceop expression`]
  | `(lvalue`)

dec $lvalue_as_expression(lvalue) : expression
  hint(prose_in "the expression corresponding to" %0)

def $lvalue_as_expression(referenceExpression) = referenceExpression

def $lvalue_as_expression(lvalue_base '.' member) = expression_base '.' member
  -- if expression_base = $lvalue_as_expression(lvalue_base)

def $lvalue_as_expression(lvalue_base `[expression_index`])
  = expression_base `[expression_index`]
  -- if expression_base = $lvalue_as_expression(lvalue_base)

def $lvalue_as_expression(lvalue_base `[expression_hi ':' expression_lo`])
  = expression_base `[expression_hi ':' expression_lo`]
  -- if expression_base = $lvalue_as_expression(lvalue_base)

def $lvalue_as_expression(lvalue_base `[expression_hi '+:' expression_lo`])
  = expression_base `[expression_hi '+:' expression_lo`]
  -- if expression_base = $lvalue_as_expression(lvalue_base)

def $lvalue_as_expression(`(lvalue`)) = `(expression`)
  -- if expression = $lvalue_as_expression(lvalue)

dec $expression_as_lvalue(expression) : lvalue?
  hint(prose_in "the l-value corresponding to" %0)

def $expression_as_lvalue(referenceExpression) = referenceExpression

def $expression_as_lvalue(expression '.' member) = lvalue '.' member
  -- if lvalue = $expression_as_lvalue(expression)

def $expression_as_lvalue(expression_base `[expression_index`])
  = lvalue_base `[expression_index`]
  -- if lvalue_base = $expression_as_lvalue(expression_base)

def $expression_as_lvalue(expression_base `[expression_hi ':' expression_lo`])
  = lvalue_base `[expression_hi ':' expression_lo`]
  -- if lvalue_base = $expression_as_lvalue(expression_base)

def $expression_as_lvalue(expression_base `[expression_hi '+:' expression_lo`])
  = lvalue_base `[expression_hi '+:' expression_lo`]
  -- if lvalue_base = $expression_as_lvalue(expression_base)

def $expression_as_lvalue(`(expression`)) = `(lvalue`)
  -- if lvalue = $expression_as_lvalue(expression)

syntax emptyStatement =
  | ';'

syntax assignop =
  | '='
  | '+='
  | '-='
  | '|+|='
  | '|-|='
  | '*='
  | '/='
  | '%='
  | '<<='
  | '>>='
  | '&='
  | '^='
  | '|='

syntax assignmentStatement =
  | lvalue assignop expression ';'

dec $assignop_as_binop(assignop) : binop?
  hint(prose_in "the binary operator corresponding to" %0)

def $assignop_as_binop('+=') = '+'

def $assignop_as_binop('-=') = '-'

def $assignop_as_binop('|+|=') = '|+|'

def $assignop_as_binop('|-|=') = '|-|'

def $assignop_as_binop('*=') = '*'

def $assignop_as_binop('/=') = '/'

def $assignop_as_binop('%=') = '%'

def $assignop_as_binop('<<=') = '<<'

def $assignop_as_binop('>>=') = '>>'

def $assignop_as_binop('&=') = '&'

def $assignop_as_binop('^=') = '^'

def $assignop_as_binop('|=') = '|'

def $assignop_as_binop(assignop) = eps
  -- otherwise

syntax callStatement =
  | lvalue `(argumentList`) ';'
  | lvalue `<typeArgumentList`> `(argumentList`) ';'

syntax directApplicationStatement =
  | namedType '.' APPLY `(argumentList`) ';'

syntax returnStatement =
  | RETURN ';'
  | RETURN expression ';'

syntax exitStatement =
  | EXIT ';'

syntax blockElementStatementList

syntax blockStatement =
  | annotationList `{blockElementStatementList`}

syntax statement

syntax conditionalStatement =
  | IF `(expression`) statement
  | IF `(expression`) statement ELSE statement

syntax annotationListNonEmpty

syntax forUpdateStatement =
  | lvalue `(argumentList`)
  | lvalue `<typeArgumentList`> `(argumentList`)
  | lvalue assignop expression

syntax forUpdateStatementListNonEmpty =
  | forUpdateStatement
  | forUpdateStatementListNonEmpty ',' forUpdateStatement

syntax forUpdateStatementList =
  | _EMPTY
  | forUpdateStatementListNonEmpty

dec $flatten_forUpdateStatementList(forUpdateStatementList)
  : forUpdateStatement*

def $flatten_forUpdateStatementList(_EMPTY) = eps

def $flatten_forUpdateStatementList(forUpdateStatement) = forUpdateStatement

def $flatten_forUpdateStatementList(forUpdateStatementListNonEmpty
                                    ','
                                    forUpdateStatement)
  = $flatten_forUpdateStatementList(forUpdateStatementListNonEmpty) ++ [forUpdateStatement]

syntax forInitStatement =
  | annotationList type name initializerOpt
  | forUpdateStatement

syntax forInitStatementListNonEmpty =
  | forInitStatement
  | forInitStatementListNonEmpty ',' forInitStatement

syntax forInitStatementList =
  | _EMPTY
  | forInitStatementListNonEmpty

dec $flatten_forInitStatementList(forInitStatementList) : forInitStatement*

def $flatten_forInitStatementList(_EMPTY) = eps

def $flatten_forInitStatementList(forInitStatement) = forInitStatement

def $flatten_forInitStatementList(forInitStatementListNonEmpty
                                  ','
                                  forInitStatement)
  = $flatten_forInitStatementList(forInitStatementListNonEmpty) ++ [forInitStatement]

syntax forCollectionExpression =
  | expression
  | expression '..' expression

syntax forStatement =
  | annotationList
    FOR
    `(forInitStatementList ';' expression ';' forUpdateStatementList`)
    statement
  | annotationList FOR `(type name IN forCollectionExpression`) statement
  | annotationList
    FOR
    `(annotationListNonEmpty type name IN forCollectionExpression`)
    statement

syntax switchLabel =
  | DEFAULT
  | expressionNonBrace

syntax switchCase =
  | switchLabel ':' blockStatement
  | switchLabel ':'

syntax switchCaseList =
