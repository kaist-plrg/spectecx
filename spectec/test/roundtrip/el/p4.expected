def $lift_instantiationIR(annotationList
                          typeIR
                          constructorTargetIR
                          `(argumentIR*`)
                          nameIR
                          eps
                          ';')
  = annotationList type `(argumentList`) nonTypeName ';'
  -- if prefixedNameIR `<eps`> = constructorTargetIR
  -- if prefixedTypeName
        = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if type = prefixedTypeName
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_instantiationIR(annotationList
                          typeIR
                          constructorTargetIR
                          `(argumentIR*`)
                          nameIR
                          eps
                          ';')
  = annotationList type `(argumentList`) nonTypeName ';'
  -- if prefixedNameIR `<typeArgumentIR*`> = constructorTargetIR
  -- if $(|typeArgumentIR*| > 0)
  -- if prefixedTypeName
        = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*)
  -- if type = prefixedTypeName `<typeArgumentList`>
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_instantiationIR(annotationList
                          typeIR
                          constructorTargetIR
                          `(argumentIR*`)
                          nameIR
                          ('=' `{objectDeclarationIR*`})
                          ';')
  = annotationList
    type
    `(argumentList`)
    nonTypeName
    ('=' `{objectDeclarationList`})
    ';'
  -- if prefixedNameIR `<eps`> = constructorTargetIR
  -- if prefixedTypeName
        = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if type = prefixedTypeName
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if objectDeclarationList
        = $lift_objectDeclarationListIR(objectDeclarationIR*)

def $lift_instantiationIR(annotationList
                          typeIR
                          constructorTargetIR
                          `(argumentIR*`)
                          nameIR
                          ('=' `{objectDeclarationIR*`})
                          ';')
  = annotationList
    type
    `(argumentList`)
    nonTypeName
    ('=' `{objectDeclarationList`})
    ';'
  -- if prefixedNameIR `<typeArgumentIR*`> = constructorTargetIR
  -- if $(|typeArgumentIR*| > 0)
  -- if prefixedTypeName
        = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if typeArgumentIR* =/= eps
  -- if typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*)
  -- if type = prefixedTypeName `<typeArgumentList`>
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if objectDeclarationList
        = $lift_objectDeclarationListIR(objectDeclarationIR*)

