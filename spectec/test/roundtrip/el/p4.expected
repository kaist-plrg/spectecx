dec $lift_p4programIR(p4programIR) : p4program?
  hint(testgen_ignore)

dec $unflatten_p4program(declaration*) : p4program
  hint(testgen_ignore)

dec $unflatten_p4program'(p4program, declaration*) : p4program
  hint(testgen_ignore)

def $unflatten_p4program(declaration*)
  = $unflatten_p4program'(_EMPTY, declaration*)

def $unflatten_p4program'(p4program, eps) = p4program

def $unflatten_p4program'(p4program, declaration_h :: declaration_t*)
  = $unflatten_p4program'(p4program declaration_h, declaration_t*)

def $lift_p4programIR(declarationIR* ';') = $unflatten_p4program(declaration*)
