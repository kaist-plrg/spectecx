syntax annotation =
  | '@' name hint(print "@"#%0)
  | '@' name `(annotationBody`) hint(print "@"#%0#"("#%1#")")
  | '@' name `[structuredAnnotationBody`] hint(print "@"#%0#"["#%1#"]")
