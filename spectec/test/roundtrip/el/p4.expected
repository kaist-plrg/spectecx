dec $cast_enum(typeIR, enumValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_enum(ENUM typeId `{_`}, typeId '.' nameIR) = typeId '.' nameIR

def $cast_enum(ENUM typeId `<_`> `{_`}, typeId '.' nameIR '.' value)
  = typeId '.' nameIR '.' value

def $cast_enum(SET `<typeIR`>, enumValue) = SET `{$cast_op(typeIR, enumValue)`}

def $cast_enum(typeIR, _ '.' _ '.' value) = $cast_op(typeIR, value)
  -- if ~(typeIR <: serializableEnumTypeIR) /\ ~(typeIR <: setTypeIR)

def $cast_op(typeIR, enumValue) = $cast_enum(typeIR_unroll, enumValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_sequence(typeIR, sequenceValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_sequence(SET `<typeIR`>, sequenceValue)
  = SET `{$cast_op(typeIR, sequenceValue)`}

def $cast_sequence(LIST `<typeIR`>, SEQ `(value*`))
  = LIST `[$cast_op(typeIR, value)*`]

def $cast_sequence(TUPLE `<typeIR*`>, SEQ `(value*`))
  = TUPLE `($cast_op(typeIR, value)*`)

def $cast_sequence(SEQ `<typeIR*`>, SEQ `(value*`))
  = SEQ `($cast_op(typeIR, value)*`)

def $cast_sequence(ARRAY typeIR `[n_size`], SEQ `(value*`))
  = ARRAY `[value_cast*`]
  -- (if (value_cast = $cast_op(typeIR, value)))*

def $cast_sequence(HEADER_STACK typeIR `[n_size`], SEQ `(value*`))
  = HEADER_STACK `[value_cast* `(n_idx`)`]
  -- (if (value_cast = $cast_op(typeIR, value)))*
  -- if n_idx = |value*|

def $cast_sequence(STRUCT typeId `<_`> `{(_ typeIR_field nameIR_field ';')*`},
                   SEQ `(value*`))
  = STRUCT typeId `{(value_cast nameIR_field ';')*`}
  -- (if (value_cast = $cast_op(typeIR_field, value)))*

def $cast_sequence(HEADER typeId `<_`> `{(_ typeIR_field nameIR_field ';')*`},
                   SEQ `(value*`))
  = HEADER typeId `{true ';' (value_cast nameIR_field ';')*`}
  -- (if (value_cast = $cast_op(typeIR_field, value)))*

def $cast_sequence(SEQ `<typeIR* ',' '...'`>, SEQ `(value* ',' '...'`))
  = SEQ `(value_cast* ',' '...'`)
  -- (if (value_cast = $cast_op(typeIR, value)))*

def $cast_sequence(TUPLE `<typeIR*`>, SEQ `(value* ',' '...'`))
  = TUPLE `(value_cast*`)
  -- if (typeIR_given*, typeIR_rest*) = $partition_<typeIR>(typeIR*, |value*|)
  -- (if (value_given = $cast_op(typeIR_given, value)))*
  -- (if (value_rest = $default(typeIR_rest)))*
  -- if value_cast* = value_given* ++ value_rest*

def $cast_sequence(ARRAY typeIR `[n_size`], SEQ `(value* ',' '...'`))
  = ARRAY `[value_cast*`]
  -- (if (value_given = $cast_op(typeIR, value)))*
  -- if n_rest = $(n_size - |value*|)
  -- if value_rest* = $repeat_<value>($default(typeIR), n_rest)
  -- if value_cast* = value_given* ++ value_rest*

def $cast_sequence(HEADER_STACK typeIR `[n_size`], SEQ `(value* ',' '...'`))
  = HEADER_STACK `[value_cast* `(n_idx`)`]
  -- (if (value_given = $cast_op(typeIR, value)))*
  -- if n_rest = $(n_size - |value*|)
  -- if value_rest* = $repeat_<value>($default(typeIR), n_rest)
  -- if value_cast* = value_given* ++ value_rest*
  -- if n_idx = |value*|

def $cast_sequence(STRUCT typeId `<_`> `{(_ typeIR_field nameIR_field ';')*`},
                   SEQ `(value* ',' '...'`))
  = STRUCT typeId `{(value_cast nameIR_field ';')*`}
  -- if (typeIR_field_given*, typeIR_field_rest*)
        = $partition_<typeIR>(typeIR_field*, |value*|)
  -- (if (value_given = $cast_op(typeIR_field_given, value)))*
  -- (if (value_rest = $default(typeIR_field_rest)))*
  -- if value_cast* = value_given* ++ value_rest*

def $cast_sequence(HEADER typeId `<_`> `{(_ typeIR_field nameIR_field ';')*`},
                   SEQ `(value* ',' '...'`))
  = HEADER typeId `{true ';' (value_cast nameIR_field ';')*`}
  -- if (typeIR_field_given*, typeIR_field_rest*)
        = $partition_<typeIR>(typeIR_field*, |value*|)
  -- (if (value_given = $cast_op(typeIR_field_given, value)))*
  -- (if (value_rest = $default(typeIR_field_rest)))*
  -- if value_cast* = value_given* ++ value_rest*

def $cast_op(typeIR, sequenceValue)
  = $cast_sequence(typeIR_unroll, sequenceValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_record(typeIR, recordValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_record(STRUCT typeId `<_`> `{(_ typeIR_t_field id_t_field ';')*`},
                 RECORD `{(value_field nameIR_field ';')*`})
  = STRUCT typeId `{(value_field_cast id_t_field ';')*`}
  -- (if (value_field'
         = $find_map<id, value>(`{(nameIR_field ':' value_field)*`}, id_t_field)))*
  -- (if (value_field_cast = $cast_op(typeIR_t_field, value_field')))*

def $cast_record(HEADER typeId `<_`> `{(_ typeIR_t_field id_t_field ';')*`},
                 RECORD `{(value_field nameIR_field ';')*`})
  = HEADER typeId `{true ';' (value_field_cast id_t_field ';')*`}
  -- (if (value_field'
         = $find_map<id, value>(`{(nameIR_field ':' value_field)*`}, id_t_field)))*
  -- (if (value_field_cast = $cast_op(typeIR_t_field, value_field')))*

def $cast_record(RECORD `{(_ typeIR_t_field id_t_field ';')*`},
                 RECORD `{(value_field nameIR_field ';')*`})
  = RECORD `{(value_field_cast id_t_field ';')*`}
  -- (if (value_field'
         = $find_map<id, value>(`{(nameIR_field ':' value_field)*`}, id_t_field)))*
  -- (if (value_field_cast = $cast_op(typeIR_t_field, value_field')))*

def $cast_record(RECORD `{(_ typeIR_t_field id_t_field ';')* ',' '...'`},
                 RECORD `{(value_field nameIR_field ';')* ',' '...'`})
  = RECORD `{(value_field_cast id_t_field ';')* ',' '...'`}
  -- (if (value_field'
         = $find_map<id, value>(`{(nameIR_field ':' value_field)*`}, id_t_field)))*
  -- (if (value_field_cast = $cast_op(typeIR_t_field, value_field')))*

dec $cast_record_field(typeIR, id, map<id, value>) : value
  hint(testgen_ignore)

def $cast_record_field(typeIR, id, `{(id_field ':' value_field)*`})
  = $cast_op(typeIR, value_found)
  -- if value_found = $find_map<id, value>(`{(id_field ':' value_field)*`}, id)

def $cast_record_field(typeIR, id, `{(id_field ':' value_field)*`})
  = $default(typeIR)
  -- if eps = $find_map<id, value>(`{(id_field ':' value_field)*`}, id)

def $cast_record(STRUCT typeId `<_`> `{(_ typeIR_t_field id_t_field ';')*`},
                 RECORD `{(value_field nameIR_field ';')* ',' '...'`})
  = STRUCT typeId `{(value_field_cast id_t_field ';')*`}
  -- (if (value_field_cast
         = $cast_record_field(typeIR_t_field,
                              id_t_field,
                              `{(nameIR_field ':' value_field)*`})))*

def $cast_record(HEADER typeId `<_`> `{(_ typeIR_t_field id_t_field ';')*`},
                 RECORD `{(value_field nameIR_field ';')* ',' '...'`})
  = HEADER typeId `{true ';' (value_field_cast id_t_field ';')*`}
  -- (if (value_field_cast
         = $cast_record_field(typeIR_t_field,
                              id_t_field,
                              `{(nameIR_field ':' value_field)*`})))*

def $cast_op(typeIR, recordValue) = $cast_record(typeIR_unroll, recordValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_default(typeIR, defaultValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_default(typeIR, defaultValue) = $default(typeIR)

def $cast_op(typeIR, DEFAULT) = $cast_default(typeIR_unroll, DEFAULT)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_invalid_header(typeIR) : value
  hint(prose_in '{#}' "casted to type" %0)
  hint(testgen_ignore)

def $cast_invalid_header(HEADER_INVALID) = '{#}'

def $cast_invalid_header(headerTypeIR) = $default(headerTypeIR)

def $cast_invalid_header(headerUnionTypeIR) = $default(headerUnionTypeIR)

def $cast_op(typeIR, invalidHeaderValue) = $cast_invalid_header(typeIR_unroll)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_set(typeIR, setValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_set(SET `<typeIR`>, SET `{value`}) = SET `{$cast_op(typeIR, value)`}

def $cast_set(SET `<typeIR`>, SET `{value_b '&&&' value_m`})
  = SET `{value_b_cast '&&&' value_m_cast`}
  -- if value_b_cast = $cast_op(typeIR, value_b)
  -- if value_m_cast = $cast_op(typeIR, value_m)

def $cast_set(SET `<typeIR`>, SET `{value_l '..' value_u`})
  = SET `{value_l_cast '..' value_u_cast`}
  -- if value_l_cast = $cast_op(typeIR, value_l)
  -- if value_u_cast = $cast_op(typeIR, value_u)

def $cast_op(typeIR, setValue) = $cast_set(typeIR_unroll, setValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

def $default(BOOL) = _B false

def $default(ERROR) = ERROR '.' "NoError"

def $default(STRING) = '"' text_empty '"'
  -- if text_empty = ""

def $default(INT) = D 0

def $default(BIT `<w`>) = w W 0

def $default(INT `<w`>) = w S 0

def $default(VARBIT `<w`>) = w '.' 0 V 0

def $default(TYPEDEF _ typeIR) = $default(typeIR)

def $default(TYPE _ typeIR) = $default(typeIR)

def $default(TUPLE `<typeIR*`>) = TUPLE `($default(typeIR)*`)

def $default(ARRAY typeIR `[n_s`]) = ARRAY `[value*`]
  -- if value* = $repeat_<value>($default(typeIR), n_s)

def $default(HEADER_STACK typeIR `[n_s`]) = HEADER_STACK `[value* `(0`)`]
  -- if value* = $repeat_<value>($default(typeIR), n_s)

def $default(STRUCT typeId `<_`> `{(_ typeIR_f id_f ';')*`})
  = STRUCT typeId `{($default(typeIR_f) id_f ';')*`}

def $default(HEADER typeId `<_`> `{(_ typeIR_f id_f ';')*`})
  = HEADER typeId `{false ';' ($default(typeIR_f) id_f ';')*`}

def $default(HEADER_UNION typeId `<_`> `{(_ typeIR_f id_f ';')*`})
  = HEADER_UNION typeId `{($default(typeIR_f) id_f ';')*`}

def $default(ENUM typeId `{id_f_h :: _`}) = typeId '.' id_f_h

def $default(ENUM typeId `<typeIR`> `{(nameIR_field '=' value_field ';')*`})
  = typeId '.' id_zero '.' value_zero
  -- if value_zero = $cast_int(typeIR, D 0)
  -- if id_zero = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*)

def $default(ENUM typeId `<typeIR`> `{(nameIR_field '=' value_field ';')*`})
  = typeId '.' id_zero '.' value_zero
  -- if value_zero = $cast_int(typeIR, D 0)
  -- if eps = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*)
  -- if id_zero = "__UNSPECIFIED"

dec $bitacc_range_op(value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 ':' %2`])

def $bitacc_range_op(integerValue_b, integerValue_h, integerValue_l) = w W i
  -- if i_b = $int_of_integerValue(integerValue_b)
  -- if i_h = $int_of_integerValue(integerValue_h)
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if w = $(i_h + 1 - i_l)
  -- if i = $bitacc(i_b, i_h, i_l)

dec $bitacc_offset_op(value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 '+:' %2`])

def $bitacc_offset_op(integerValue_b, integerValue_l, integerValue_w) = w W i
  -- if i_b = $int_of_integerValue(integerValue_b)
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if w = $nat_of_integerValue(integerValue_w)
  -- if i_h = $(i_l + w - 1)
  -- if i = $bitacc(i_b, i_h, i_l)

dec $bitacc_range_replace_op(value, value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 ':' %2`] "replaced with" %3)

def $bitacc_range_replace_op(integerValue_b,
                             integerValue_h,
                             integerValue_l,
                             integerValue_r)
  = w W i
  -- if w W i_b = integerValue_b
  -- if i_h = $int_of_integerValue(integerValue_h)
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if _ W i_r = integerValue_r
  -- if i = $bitacc_replace(i_b, i_h, i_l, i_r)

def $bitacc_range_replace_op(integerValue_b,
                             integerValue_h,
                             integerValue_l,
                             integerValue_r)
  = w S i
  -- if w S i_b = integerValue_b
  -- if i_h = $int_of_integerValue(integerValue_h)
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if _ W i_r = integerValue_r
  -- if i = $bitacc_replace(i_b, i_h, i_l, i_r)

dec $bitacc_offset_replace_op(value, value, value, value) : value
  hint(testgen_ignore)
  hint(prose_in %0 `[%1 '+:' %2`] "replaced with" %3)

def $bitacc_offset_replace_op(integerValue_b,
                              integerValue_l,
                              integerValue_w,
                              integerValue_r)
  = w W i
  -- if w W i_b = integerValue_b
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if n_w = $nat_of_integerValue(integerValue_w)
  -- if i_h = $(i_l + n_w - 1)
  -- if _ W i_r = integerValue_r
  -- if i = $bitacc_replace(i_b, i_h, i_l, i_r)

def $bitacc_offset_replace_op(integerValue_b,
                              integerValue_l,
                              integerValue_w,
                              integerValue_r)
  = w S i
  -- if w S i_b = integerValue_b
  -- if i_l = $int_of_integerValue(integerValue_l)
  -- if n_w = $nat_of_integerValue(integerValue_w)
  -- if i_h = $(i_l + n_w - 1)
  -- if _ W i_r = integerValue_r
  -- if i = $bitacc_replace(i_b, i_h, i_l, i_r)

dec $sizeof(typeIR, id) : value
  hint(testgen_ignore)

dec $sizeof_minSizeInBits(typeIR) : value
  hint(testgen_ignore)

dec $sizeof_minSizeInBits'(typeIR) : nat
  hint(testgen_ignore)

dec $sizeof_minSizeInBytes(typeIR) : value
  hint(testgen_ignore)

dec $sizeof_maxSizeInBits(typeIR) : value
  hint(testgen_ignore)

dec $sizeof_maxSizeInBits'(typeIR) : nat
  hint(testgen_ignore)

dec $sizeof_maxSizeInBytes(typeIR) : value
  hint(testgen_ignore)

def $sizeof_minSizeInBits(typeIR) = D $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(BOOL) = 1

def $sizeof_minSizeInBits'(INT `<w`>) = w

def $sizeof_minSizeInBits'(BIT `<w`>) = w

def $sizeof_minSizeInBits'(VARBIT `<_`>) = 0

def $sizeof_minSizeInBits'(TYPEDEF _ typeIR) = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(TYPE _ typeIR) = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(ENUM _ `<typeIR`> `{_`})
  = $sizeof_minSizeInBits'(typeIR)

def $sizeof_minSizeInBits'(TUPLE `<typeIR*`>)
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(ARRAY typeIR `[n_size`])
  = $($sizeof_minSizeInBits'(typeIR) * n_size)

def $sizeof_minSizeInBits'(HEADER_STACK typeIR `[n_size`])
  = $($sizeof_minSizeInBits'(typeIR) * n_size)

def $sizeof_minSizeInBits'(STRUCT _ `<_`> `{(_ typeIR _ ';')*`})
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(HEADER _ `<_`> `{(_ typeIR _ ';')*`})
  = $sum_nat($sizeof_minSizeInBits'(typeIR)*)

def $sizeof_minSizeInBits'(HEADER_UNION _ `<_`> `{eps`}) = 0

def $sizeof_minSizeInBits'(HEADER_UNION _ `<_`> `{(_ typeIR _ ';')*`})
  = $max_nat($sizeof_minSizeInBits'(typeIR)*)
  -- if typeIR* =/= eps

def $sizeof(typeIR, "minSizeInBits") = $sizeof_minSizeInBits(typeIR)

def $sizeof_minSizeInBytes(typeIR) = D $(n_size / 8)
  -- if n_size = $sizeof_minSizeInBits'(typeIR)

def $sizeof(typeIR, "minSizeInBytes") = $sizeof_minSizeInBytes(typeIR)

def $sizeof_maxSizeInBits(typeIR) = D $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(BOOL) = 1

def $sizeof_maxSizeInBits'(INT `<w`>) = w

def $sizeof_maxSizeInBits'(BIT `<w`>) = w

def $sizeof_maxSizeInBits'(VARBIT `<w`>) = w

def $sizeof_maxSizeInBits'(TYPEDEF _ typeIR) = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(TYPE _ typeIR) = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(ENUM _ `<typeIR`> `{_`})
  = $sizeof_maxSizeInBits'(typeIR)

def $sizeof_maxSizeInBits'(TUPLE `<typeIR*`>)
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(ARRAY typeIR `[n_size`])
  = $($sizeof_maxSizeInBits'(typeIR) * n_size)

def $sizeof_maxSizeInBits'(HEADER_STACK typeIR `[n_size`])
  = $($sizeof_maxSizeInBits'(typeIR) * n_size)

def $sizeof_maxSizeInBits'(STRUCT _ `<_`> `{(_ typeIR _ ';')*`})
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(HEADER _ `<_`> `{(_ typeIR _ ';')*`})
  = $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

def $sizeof_maxSizeInBits'(HEADER_UNION _ `<_`> `{eps`}) = 0

def $sizeof_maxSizeInBits'(HEADER_UNION _ `<_`> `{(_ typeIR _ ';')*`})
  = $max_nat($sizeof_maxSizeInBits'(typeIR)*)
  -- if typeIR* =/= eps

def $sizeof(typeIR, "maxSizeInBits") = $sizeof_maxSizeInBits(typeIR)

def $sizeof_maxSizeInBytes(typeIR) = D $(n_size / 8)
  -- if n_size = $sizeof_maxSizeInBits'(typeIR)

def $sizeof(typeIR, "maxSizeInBytes") = $sizeof_maxSizeInBytes(typeIR)
;; === 4-p4-ir/4.0-ir-syntax.spectec ===
syntax prefixedNameIR =
  | _BARE nameIR hint(print %0)
  | '.' nameIR

dec $prefixedNonTypeName(prefixedNonTypeName) : prefixedNameIR
  hint(prose_in "the prefixed name of " %0)

def $prefixedNonTypeName(nonTypeName) = _BARE $name(nonTypeName)

def $prefixedNonTypeName(_ID '.' nonTypeName) = '.' $name(nonTypeName)

dec $prefixedTypeName(prefixedTypeName) : prefixedNameIR
  hint(prose_in "the prefixed name of " %0)

def $prefixedTypeName(typeName) = _BARE $name(typeName)

def $prefixedTypeName(_TID '.' typeName) = '.' $name(typeName)

dec $flatten_prefixedNameIR(prefixedNameIR) : nameIR
  hint(prose_in "the string form of " %0)

def $flatten_prefixedNameIR(_BARE nameIR) = nameIR

def $flatten_prefixedNameIR('.' nameIR) = "." ++ nameIR

syntax nameListIR = nameIR*

syntax typeParameterListIR = typeParameterIR*

syntax parameterListIR = parameterIR*

syntax constructorParameterListIR = parameterIR*

syntax namedValueIR =
  | nameIR '=' value

syntax namedValueListIR = namedValueIR*

syntax namedExpressionIR =
  | nameIR '=' typedExpressionIR

syntax namedExpressionListIR = namedExpressionIR*

syntax literalExpressionIR = literalExpression

syntax referenceExpressionIR = prefixedNameIR

syntax defaultExpressionIR = defaultExpression

syntax unaryExpressionIR =
  | unop typedExpressionIR

syntax binaryExpressionIR =
  | typedExpressionIR binop typedExpressionIR

syntax ternaryExpressionIR =
  | typedExpressionIR '?' typedExpressionIR ':' typedExpressionIR

syntax castExpressionIR =
  | `(typeIR`) typedExpressionIR

syntax typedExpressionListIR

syntax invalidHeaderExpressionIR = invalidHeaderExpression

syntax sequenceExpressionIR =
  | SEQ `{typedExpressionListIR`}
  | SEQ `{typedExpressionListIR ',' '...'`}

syntax recordExpressionIR =
  | RECORD `{namedExpressionListIR`}
  | RECORD `{namedExpressionListIR ',' '...'`}

syntax dataExpressionIR =
  | invalidHeaderExpressionIR
  | sequenceExpressionIR
  | recordExpressionIR

syntax memberAccessBaseIR

syntax errorAccessExpressionIR =
  | ERROR '.' nameIR

syntax memberAccessExpressionIR =
  | memberAccessBaseIR '.' nameIR

syntax indexAccessExpressionIR =
  | typedExpressionIR `[typedExpressionIR`]

syntax sliceAccessExpressionIR =
  | typedExpressionIR `[typedExpressionIR sliceop typedExpressionIR`]

syntax accessExpressionIR =
  | errorAccessExpressionIR
  | memberAccessExpressionIR
  | indexAccessExpressionIR
  | sliceAccessExpressionIR

syntax typedLvalueIR

syntax typeArgumentListIR

syntax argumentListIR

syntax callableTargetIR =
  | referenceExpressionIR
  | typedExpressionIR '.' nameIR
  | TYPE prefixedNameIR '.' nameIR
  | `(callableTargetIR`)

syntax constructorTargetIR =
  | prefixedNameIR `<typeArgumentListIR`>

syntax callExpressionIR =
  | constructorTargetIR `(argumentListIR`)
  | callableTargetIR `<typeArgumentListIR`> `(argumentListIR`)

syntax parenthesizedExpressionIR =
  | `(typedExpressionIR`)

syntax expressionIR =
  | literalExpressionIR
  | referenceExpressionIR
  | defaultExpressionIR
  | unaryExpressionIR
  | binaryExpressionIR
  | ternaryExpressionIR
  | castExpressionIR
  | dataExpressionIR
  | accessExpressionIR
  | callExpressionIR
  | parenthesizedExpressionIR

syntax expressionNoteIR =
  | `(typeIR ctk`)
  hint(prose "a pair of type" %0 "and compile-time known-ness" %1)
  hint(prose_fields "type" "compile-time known-ness")

syntax typedExpressionIR =
  | expressionIR '#' expressionNoteIR
  hint(print %0)
  hint(prose %0 "annotated with" %1)
  hint(prose_fields "expression" "note")

syntax typedExpressionListIR = typedExpressionIR*

syntax memberAccessBaseIR =
  | TYPE prefixedNameIR
  | typedExpressionIR

dec $type_of_typedExpressionIR(typedExpressionIR) : typeIR
  hint(prose_in "the type of" %0)

def $type_of_typedExpressionIR(typedExpressionIR) = typeIR
  -- if _ '#' `(typeIR _`) = typedExpressionIR

dec $ctk_of_typedExpressionIR(typedExpressionIR) : ctk
  hint(prose_in "the compile-time known-ness of" %0)

def $ctk_of_typedExpressionIR(typedExpressionIR) = ctk
  -- if _ '#' `(_ ctk`) = typedExpressionIR

syntax simpleKeysetExpressionIR =
  | typedExpressionIR
  | typedExpressionIR '&&&' typedExpressionIR
  | typedExpressionIR '..' typedExpressionIR
  | DEFAULT
  | '_'

syntax simpleKeysetExpressionListIR = simpleKeysetExpressionIR*

syntax tupleKeysetExpressionIR =
  | `(simpleKeysetExpressionListIR`)

syntax keysetExpressionIR =
  | simpleKeysetExpressionIR
  | tupleKeysetExpressionIR

dec $flatten_keysetExpressionIR(keysetExpressionIR)
  : simpleKeysetExpressionListIR
  hint(prose_in "the flattened keyset expression list of " %0)

def $flatten_keysetExpressionIR(simpleKeysetExpressionIR)
  = [simpleKeysetExpressionIR]

def $flatten_keysetExpressionIR(`(simpleKeysetExpressionListIR`))
  = simpleKeysetExpressionListIR

syntax typeArgumentListIR = typeArgumentIR*

syntax argumentIR =
  | typedExpressionIR
  | nameIR '=' typedExpressionIR
  | nameIR '=' '_'
  | '_'

syntax argumentListIR = argumentIR*

syntax lvalueIR =
  | referenceExpressionIR
  | typedLvalueIR '.' nameIR
  | typedLvalueIR `[typedExpressionIR`]
  | typedLvalueIR `[typedExpressionIR sliceop typedExpressionIR`]
  | `(typedLvalueIR`)

syntax lvalueNoteIR =
  | `(typeIR`)

syntax typedLvalueIR =
  | lvalueIR '#' lvalueNoteIR
  hint(print %0)
  hint(prose %0 "with note" %1)
  hint(prose_fields "lvalue" "note")

dec $type_of_typedLvalueIR(typedLvalueIR) : typeIR
  hint(prose_in "the type of lvalue" %0)

def $type_of_typedLvalueIR(typedLvalueIR) = typeIR
  -- if _ '#' `(typeIR`) = typedLvalueIR

dec $typedLvalueIR_as_typedExpressionIR(typedLvalueIR) : typedExpressionIR?
  hint(prose_in "the expression form of" %0)

def $typedLvalueIR_as_typedExpressionIR(referenceExpressionIR '#' `(typeIR`))
  = referenceExpressionIR '#' `(typeIR DYN`)

def $typedLvalueIR_as_typedExpressionIR((typedLvalueIR '.' nameIR)
                                        '#'
                                        `(typeIR`))
  = (typedExpressionIR '.' nameIR) '#' `(typeIR DYN`)
  -- if typedExpressionIR = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR)

def $typedLvalueIR_as_typedExpressionIR((typedLvalueIR_base
                                         `[typedExpressionIR_index`])
                                        '#'
                                        `(typeIR`))
  = (typedExpressionIR_base `[typedExpressionIR_index`]) '#' `(typeIR DYN`)
  -- if typedExpressionIR_base
        = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)

def $typedLvalueIR_as_typedExpressionIR((typedLvalueIR_base
                                         `[typedExpressionIR_hi
                                           ':'
                                           typedExpressionIR_lo`])
                                        '#'
                                        `(typeIR`))
  = (typedExpressionIR_base `[typedExpressionIR_hi ':' typedExpressionIR_lo`])
    '#'
    `(typeIR DYN`)
  -- if typedExpressionIR_base
        = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)

def $typedLvalueIR_as_typedExpressionIR((typedLvalueIR_base
                                         `[typedExpressionIR_l
                                           '+:'
                                           typedExpressionIR_w`])
                                        '#'
                                        `(typeIR`))
  = (typedExpressionIR_base `[typedExpressionIR_l '+:' typedExpressionIR_w`])
    '#'
    `(typeIR DYN`)
  -- if typedExpressionIR_base
        = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base)

dec $typedExpressionIR_as_typedLvalueIR(typedExpressionIR) : typedLvalueIR?
  hint(prose_in "the l-value form of" %0)

def $typedExpressionIR_as_typedLvalueIR(referenceExpressionIR '#' `(typeIR _`))
  = referenceExpressionIR '#' `(typeIR`)

def $typedExpressionIR_as_typedLvalueIR((typedExpressionIR '.' nameIR)
                                        '#'
                                        `(typeIR _`))
  = (typedLvalueIR '.' nameIR) '#' `(typeIR`)
  -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)

def $typedExpressionIR_as_typedLvalueIR((typedExpressionIR_base
                                         `[typedExpressionIR_index`])
                                        '#'
                                        `(typeIR _`))
  = (typedLvalueIR_base `[typedExpressionIR_index`]) '#' `(typeIR`)
  -- if typedLvalueIR_base
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)

def $typedExpressionIR_as_typedLvalueIR((typedExpressionIR_base
                                         `[typedExpressionIR_hi
                                           ':'
                                           typedExpressionIR_lo`])
                                        '#'
                                        `(typeIR _`))
  = (typedLvalueIR_base `[typedExpressionIR_hi ':' typedExpressionIR_lo`])
    '#'
    `(typeIR`)
  -- if typedLvalueIR_base
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)

def $typedExpressionIR_as_typedLvalueIR((typedExpressionIR_base
                                         `[typedExpressionIR_l
                                           '+:'
                                           typedExpressionIR_w`])
                                        '#'
                                        `(typeIR _`))
  = (typedLvalueIR_base `[typedExpressionIR_l '+:' typedExpressionIR_w`])
    '#'
    `(typeIR`)
  -- if typedLvalueIR_base
        = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)

def $typedExpressionIR_as_typedLvalueIR((`(typedExpressionIR`)) '#' `(typeIR _`))
  = (`(typedLvalueIR`)) '#' `(typeIR`)
  -- if typedLvalueIR = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)

syntax emptyStatementIR = emptyStatement

syntax assignmentStatementIR =
  | typedLvalueIR assignop typedExpressionIR ';'

syntax callStatementIR =
  | callableTargetIR `<typeArgumentListIR`> `(argumentListIR`) ';'

syntax directApplicationStatementIR =
  | constructorTargetIR '.' APPLY `(argumentListIR`) ';'

syntax returnStatementIR =
  | RETURN ';'
  | RETURN typedExpressionIR ';'

syntax exitStatementIR = exitStatement

syntax blockElementStatementListIR

syntax blockStatementIR =
  | annotationList `{blockElementStatementListIR`}

syntax statementIR

syntax conditionalStatementIR =
  | IF `(typedExpressionIR`) statementIR
  | IF `(typedExpressionIR`) statementIR ELSE statementIR

syntax initializerOptIR

syntax forUpdateStatementIR =
  | callableTargetIR `<typeArgumentListIR`> `(argumentListIR`)
  | typedLvalueIR assignop typedExpressionIR

syntax forUpdateStatementListIR = forUpdateStatementIR*

syntax forInitStatementIR =
  | annotationList typeIR nameIR initializerOptIR
  | forUpdateStatementIR

syntax forInitStatementListIR = forInitStatementIR*

syntax forCollectionExpressionIR =
  | typedExpressionIR
  | typedExpressionIR '..' typedExpressionIR

syntax forStatementIR =
  | annotationList
    FOR
    `(forInitStatementListIR ';' typedExpressionIR ';' forUpdateStatementListIR`)
    statementIR
  | annotationList
    FOR
    `(typeIR nameIR IN forCollectionExpressionIR`)
    statementIR
  | annotationList
    FOR
    `(annotationList typeIR nameIR IN forCollectionExpressionIR`)
    statementIR

syntax switchLabelIR =
  | DEFAULT
  | typedExpressionIR

syntax switchCaseIR =
  | switchLabelIR ':' blockStatementIR
  | switchLabelIR ':'

dec $switchLabelIR_of_switchCaseIR(switchCaseIR) : switchLabelIR
  hint(prose_in "the label of" %0)

def $switchLabelIR_of_switchCaseIR(switchLabelIR ':' _) = switchLabelIR

def $switchLabelIR_of_switchCaseIR(switchLabelIR ':') = switchLabelIR

syntax switchCaseListIR = switchCaseIR*

syntax switchStatementIR =
  | SWITCH `(typedExpressionIR`) `{switchCaseListIR`}

syntax breakStatementIR = breakStatement

syntax continueStatementIR = continueStatement

syntax statementIR =
  | emptyStatementIR
  | assignmentStatementIR
  | callStatementIR
  | directApplicationStatementIR
  | returnStatementIR
  | exitStatementIR
  | blockStatementIR
  | conditionalStatementIR
  | forStatementIR
  | breakStatementIR
  | continueStatementIR
  | switchStatementIR

syntax constantDeclarationIR =
  | annotationList CONST typeIR nameIR constantInitializerIR ';'

syntax initializerOptIR = initializerIR?

syntax variableDeclarationIR =
  | annotationList typeIR nameIR initializerOptIR ';'

syntax blockElementStatementIR =
  | constantDeclarationIR
  | variableDeclarationIR
  | statementIR

syntax blockElementStatementListIR = blockElementStatementIR*

syntax functionPrototypeIR =
  | typeIR
    nameIR
    `<typeParameterListIR ',' typeParameterListIR`>
    `(parameterListIR`)

syntax functionDeclarationIR =
  | annotationList functionPrototypeIR blockStatementIR

syntax actionDeclarationIR =
  | annotationList ACTION nameIR `(parameterListIR`) blockStatementIR

syntax objectDeclarationListIR

syntax objectInitializerIR =
  | '=' `{objectDeclarationListIR`}

syntax objectInitializerOptIR = objectInitializerIR?

syntax instantiationIR =
  | annotationList
    typeIR
    constructorTargetIR
    `(argumentListIR`)
    nameIR
    objectInitializerOptIR
    ';'
  hint(prose_fields "annotations"
                    "type"
                    "constructor target"
                    "arguments"
                    "name"
                    "object initializer")

syntax objectDeclarationIR =
  | functionDeclarationIR
  | instantiationIR

syntax objectDeclarationListIR = objectDeclarationIR*

dec $flatten_objectInitializerOptIR(objectInitializerOptIR)
  : objectDeclarationListIR
  hint(prose_in "the list of object declarations in" %0)

def $flatten_objectInitializerOptIR(eps) = eps

def $flatten_objectInitializerOptIR('=' `{objectDeclarationListIR`})
  = objectDeclarationListIR

syntax errorDeclarationIR =
  | ERROR `{nameListIR`}

syntax matchKindDeclarationIR =
  | MATCH_KIND `{nameListIR`}

syntax enumTypeDeclarationIR =
  | annotationList ENUM nameIR `{nameListIR`}
  | annotationList ENUM typeIR nameIR `{namedValueListIR`}

syntax typeFieldIR =
  | annotationList typeIR nameIR ';'

syntax typeFieldListIR = typeFieldIR*

syntax structTypeDeclarationIR =
  | annotationList STRUCT nameIR `<typeParameterListIR`> `{typeFieldListIR`}

syntax headerTypeDeclarationIR =
  | annotationList HEADER nameIR `<typeParameterListIR`> `{typeFieldListIR`}

syntax headerUnionTypeDeclarationIR =
