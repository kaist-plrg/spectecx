;; === 8-dynamic/8.11-eval-extern.spectec ===
builtin dec $eval_extern_function_call(evalContext, arch, nameIR, nameIR*)
  : (evalContext, arch, callResult)
  hint(prose_in "the result of calling the extern function"
                %2
                `(%3`)
                "under context"
                %0
                "and state"
                %1)

rule ExternFunctionCall_eval:
  EC_0 ARCH_0 |- nameIR `(nameIR_param*`) : EC_1 ARCH_1 callResult
  -- if (EC_1, ARCH_1, callResult)
        = $eval_extern_function_call(EC_0, ARCH_0, nameIR, nameIR_param*)

builtin dec $eval_extern_method_call(evalContext,
                                     arch,
                                     objectId,
                                     nameIR,
                                     nameIR*)
  : (evalContext, arch, callResult)
  hint(prose_in "the result of calling the extern method"
                %3
                `(%4`)
                "on object"
                %2
                "under context"
                %0
                "and state"
                %1)

rule ExternMethodCall_eval:
  EC_0 ARCH_0 |- objectId '.' nameIR `(nameIR_param*`) : EC_1 ARCH_1 callResult
  -- if (EC_1, ARCH_1, callResult)
        = $eval_extern_method_call(EC_0, ARCH_0, objectId, nameIR, nameIR_param*)
;; === 9-arch/9.0-eval-arch.spectec ===
relation Var_init: evalContext |- typeIR nameIR : evalContext
  hint(input %0 %1 %2)
  hint(prose_in "instantiating global variable"
                %2
                "of type"
                %1
                "in the evaluation context"
                %0)
  hint(prose_out "the resulting evaluation context" %3)

rule Var_init:
  EC_0 |- typeIR nameIR : EC_1
  -- if value = $default(typeIR)
  -- if EC_1 = $add_var_e(GLOBAL, EC_0, _BARE nameIR, value)

relation Extern_init: evalContext arch |- nameIR nameIR : arch
  hint(input %0 %1 %2 %3)
  hint(prose_in "instantiating extern"
                %2
                "with name"
                %3
                "in the evaluation context"
                %0
                "and state"
                %1)
  hint(prose_out "the resulting state" %4)

rule Extern_init:
  EC ARCH_0 |- nameIR_extern nameIR : ARCH_2
  -- if IC = {PATH ([]), GLOBAL EC.GLOBAL, BLOCK EC.BLOCK, LOCAL EC.LOCAL}
  -- Constructor_inst:
       GLOBAL IC
         |- (_BARE nameIR_extern) `<eps`> `(eps`)
         : constructorDef `<eps`> `('#' eps '#' eps`)
  -- if STO = ARCH_0.STORE
  -- Constructor_call:
       GLOBAL IC STO
         |- constructorDef `<eps`> `(eps '#' eps '#' eps`)
         : STO_1 object
  -- if ARCH_1 = ARCH_0[.STORE = STO_1]
  -- if objectId_object = [nameIR]
  -- if ARCH_2 = $add_object_e(ARCH_1, objectId_object, object)

relation Program_init: |- p4program : evalContext store
  hint(input %0)
  hint(prose_in "initializing the evaluation context and store for" %0)
  hint(prose_out "the resulting evaluation context" %1#" and store" %2)

rule Program_init:
  |- p4program : EC STO
  -- Program_inst: |- p4program : globalEvalLayer STO
  -- if blockEvalLayer
        = {TYPE $empty_theta,
           CALLABLE $empty_callableDefEnv,
           STATE $empty_stateEnv,
           FRAME $empty_frame}
  -- if localEvalLayer = {TYPE $empty_theta, FRAMES ([$empty_frame])}
  -- if EC
        = {GLOBAL globalEvalLayer, BLOCK blockEvalLayer, LOCAL localEvalLayer}
;; === 9-arch/9.B-ebpf.spectec ===
relation EBPF_init: |- p4program : evalContext arch
  hint(input %0)
  hint(prose_in "initializing the evaluation context and state for"
                %0
                "in the eBPF architecture")
  hint(prose_out "the resulting evaluation context" %1#" and state" %2)

rule EBPF_init:
  |- p4program : EC ARCH
  -- Program_init: |- p4program : EC STO
  -- if ARCH = {STATE $init_archState, STORE STO}

relation EBPF_init_packet_in: evalContext arch |- objectState : evalContext arch
  hint(input %0 %1 %2)

rule EBPF_init_packet_in:
  EC_0 ARCH_0 |- objectState_packet_in : EC_1 ARCH_2
  -- Extern_init: EC_0 ARCH_0 |- "packet_in" "packet_in" : ARCH_1
  -- if EC_1 = $add_var_e(GLOBAL, EC_0, _BARE "packet_in", REF "packet_in")
  -- if externObject_packet_in = $find_object_e(ARCH_1, ["packet_in"])
  -- if EXTERN typeId `<theta`> `{_ frame externMethodDefEnv`}
        = externObject_packet_in
  -- if externObject_packet_in_init
        = EXTERN
          typeId
          `<theta`>
          `{objectState_packet_in frame externMethodDefEnv`}
  -- if ARCH_2
        = $add_object_e(ARCH_1, ["packet_in"], externObject_packet_in_init)

relation EBPF_init_globals: evalContext arch |- evalContext
  hint(input %0 %1)

rule EBPF_init_globals:
  EC_0 ARCH |- EC_2
  -- if PACKAGE `<theta`> `{_`} = $find_object_e(ARCH, ["main"])
  -- if typeIR_headers = $find_map<typeId, typeIR>(theta, "H")
  -- Var_init: EC_0 |- typeIR_headers "headers" : EC_1
  -- Var_init: EC_1 |- BOOL "accept" : EC_2

dec $eBPF_setup_packet_in_argument(evalContext) : argumentIR

def $eBPF_setup_packet_in_argument(EC) = argumentIR_packet_in
  -- if typeDefIR_packet_in = $find_typeDef_e(GLOBAL, EC, _BARE "packet_in")
  -- if typeIR_packet_in = $specialize_typeDefIR(typeDefIR_packet_in, eps)
  -- if argumentIR_packet_in = ('.' "packet_in") '#' `(typeIR_packet_in CTK`)

dec $eBPF_setup_headers_argument(arch) : argumentIR

def $eBPF_setup_headers_argument(ARCH) = argumentIR_headers
  -- if PACKAGE `<theta`> `{_`} = $find_object_e(ARCH, ["main"])
  -- if typeIR_headers = $find_map<typeId, typeIR>(theta, "H")
  -- if argumentIR_headers = ('.' "headers") '#' `(typeIR_headers DYN`)

dec $eBPF_setup_main_callee(evalContext, arch) : typedExpressionIR

def $eBPF_setup_main_callee(EC, ARCH) = typedExpressionIR_main
  -- if typeDefIR_package = $find_typeDef_e(GLOBAL, EC, _BARE "ebpfFilter")
  -- if PACKAGE `<theta`> `{_`} = $find_object_e(ARCH, ["main"])
  -- if typeIR_headers = $find_map<typeId, typeIR>(theta, "H")
  -- if typeIR_package
        = $specialize_typeDefIR(typeDefIR_package, typeIR_headers)
  -- if typedExpressionIR_main = (_BARE "main") '#' `(typeIR_package CTK`)

dec $eBPF_setup_parse_callee(evalContext, arch, typedExpressionIR)
  : typedExpressionIR

def $eBPF_setup_parse_callee(EC, ARCH, typedExpressionIR_main)
  = typedExpressionIR_parse
  -- if typeDefIR_parse = $find_typeDef_e(GLOBAL, EC, _BARE "parse")
  -- if PACKAGE `<theta`> `{_`} = $find_object_e(ARCH, ["main"])
  -- if typeIR_headers = $find_map<typeId, typeIR>(theta, "H")
  -- if typeIR_parse = $specialize_typeDefIR(typeDefIR_parse, typeIR_headers)
  -- if typedExpressionIR_parse
        = (typedExpressionIR_main '.' "prs") '#' `(typeIR_parse CTK`)

dec $eBPF_setup_filter_callee(evalContext, arch, typedExpressionIR)
  : typedExpressionIR

def $eBPF_setup_filter_callee(EC, ARCH, typedExpressionIR_main)
  = typedExpressionIR_filter
  -- if typeDefIR_filter = $find_typeDef_e(GLOBAL, EC, _BARE "filter")
  -- if PACKAGE `<theta`> `{_`} = $find_object_e(ARCH, ["main"])
  -- if typeIR_headers = $find_map<typeId, typeIR>(theta, "H")
  -- if typeIR_filter = $specialize_typeDefIR(typeDefIR_filter, typeIR_headers)
  -- if typedExpressionIR_filter
        = (typedExpressionIR_main '.' "filt") '#' `(typeIR_filter CTK`)

relation EBPF_parse: evalContext arch |- evalContext arch transitionResult
  hint(input %0 %1)

rule EBPF_parse/cont:
  EC_0 ARCH_0 |- EC_1 ARCH_1 ACCEPT
  -- if argumentIR_packet_in = $eBPF_setup_packet_in_argument(EC_0)
  -- if argumentIR_headers = $eBPF_setup_headers_argument(ARCH_0)
  -- if argumentIR* = [argumentIR_packet_in, argumentIR_headers]
  -- if typedExpressionIR_main = $eBPF_setup_main_callee(EC_0, ARCH_0)
  -- if typedExpressionIR_prs
        = $eBPF_setup_parse_callee(EC_0, ARCH_0, typedExpressionIR_main)
  -- if callableTargetIR = typedExpressionIR_prs '.' "apply"
  -- Stmt_eval:
       GLOBAL EC_0 ARCH_0
         |- callableTargetIR `<eps`> `(argumentIR*`) ';'
         : EC_1 ARCH_1 _EMPTY

rule EBPF_parse/reject:
  EC_0 ARCH_0 |- EC_1 ARCH_1 rejectTransitionResult
  -- if argumentIR_packet_in = $eBPF_setup_packet_in_argument(EC_0)
  -- if argumentIR_headers = $eBPF_setup_headers_argument(ARCH_0)
  -- if argumentIR* = [argumentIR_packet_in, argumentIR_headers]
  -- if typedExpressionIR_main = $eBPF_setup_main_callee(EC_0, ARCH_0)
  -- if typedExpressionIR_prs
        = $eBPF_setup_parse_callee(EC_0, ARCH_0, typedExpressionIR_main)
  -- if callableTargetIR = typedExpressionIR_prs '.' "apply"
  -- Stmt_eval:
       GLOBAL EC_0 ARCH_0
         |- callableTargetIR `<eps`> `(argumentIR*`) ';'
         : EC_1 ARCH_1 rejectTransitionResult

relation EBPF_filter: evalContext arch |- evalContext arch callResult
  hint(input %0 %1)

rule EBPF_filter/continueEmptyResult:
  EC_0 ARCH_0 |- EC_1 ARCH_1 (RETURN eps)
  -- if argumentIR_headers = $eBPF_setup_headers_argument(ARCH_0)
  -- if argumentIR_accept = ('.' "accept") '#' `(BOOL DYN`)
  -- if argumentIR* = [argumentIR_headers, argumentIR_accept]
  -- if typedExpressionIR_main = $eBPF_setup_main_callee(EC_0, ARCH_0)
  -- if typedExpressionIR_filt
        = $eBPF_setup_filter_callee(EC_0, ARCH_0, typedExpressionIR_main)
  -- if callableTargetIR = typedExpressionIR_filt '.' "apply"
  -- Stmt_eval:
       GLOBAL EC_0 ARCH_0
         |- callableTargetIR `<eps`> `(argumentIR*`) ';'
         : EC_1 ARCH_1 _EMPTY

rule EBPF_filter/exit:
  EC_0 ARCH_0 |- EC_1 ARCH_1 EXIT
  -- if argumentIR_headers = $eBPF_setup_headers_argument(ARCH_0)
  -- if argumentIR_accept = ('.' "accept") '#' `(BOOL DYN`)
  -- if argumentIR* = [argumentIR_headers, argumentIR_accept]
  -- if typedExpressionIR_main = $eBPF_setup_main_callee(EC_0, ARCH_0)
  -- if typedExpressionIR_filt
        = $eBPF_setup_filter_callee(EC_0, ARCH_0, typedExpressionIR_main)
  -- if callableTargetIR = typedExpressionIR_filt '.' "apply"
  -- Stmt_eval:
       GLOBAL EC_0 ARCH_0
         |- callableTargetIR `<eps`> `(argumentIR*`) ';'
         : EC_1 ARCH_1 EXIT
