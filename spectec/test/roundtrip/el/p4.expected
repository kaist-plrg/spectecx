;; === 7-instantiation/7.03-inst-relation.spectec ===
relation Expr_inst: cursor instContext store |- typedExpressionIR : store value
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

relation Exprs_inst:
  cursor instContext store |- typedExpressionIR* : store value*
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

relation Argument_inst: cursor instContext store |- argumentIR : store value
  hint(input %0 %1 %2 %3)
  hint(prose_in "compile-time evaluation of" %3#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %4 "and" %5)

