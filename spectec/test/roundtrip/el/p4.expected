  -- ForThreeClauseStmt_eval:
       EC_3 ARCH_3
         |- typedExpressionIR statementIR forUpdateStatementListIR
         : EC_4 ARCH_4 statementResult

rule Stmt_eval/init-abort:
  LOCAL EC_0 ARCH_0
    |- annotationList
       FOR
       `(forInitStatementListIR
         ';'
         typedExpressionIR
         ';'
         forUpdateStatementListIR`)
       statementIR
    : EC_3 ARCH_1 abortResult
