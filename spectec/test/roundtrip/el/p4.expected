dec $compat_switch(typeIR) : bool
  hint(prose_true %0 "is a valid switch key type")
  hint(prose_false %0 "is an invalid switch key type")

def $compat_switch(ERROR) = true

def $compat_switch(INT `<_`>) = true

def $compat_switch(BIT `<_`>) = true

def $compat_switch(TYPEDEF _ typeIR) = $compat_switch(typeIR)

def $compat_switch(enumTypeIR) = true

def $compat_switch(_) = false
  -- otherwise

