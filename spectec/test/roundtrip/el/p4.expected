  = $lift_packageTypeDeclarationIR(packageTypeDeclarationIR)

dec $lift_declarationIR(declarationIR) : declaration?
  hint(testgen_ignore)

def $lift_declarationIR(constantDeclarationIR)
  = $lift_constantDeclarationIR(constantDeclarationIR)

def $lift_declarationIR(instantiationIR)
  = $lift_instantiationIR(instantiationIR)

def $lift_declarationIR(functionDeclarationIR)
  = $lift_functionDeclarationIR(functionDeclarationIR)

def $lift_declarationIR(actionDeclarationIR)
  = $lift_actionDeclarationIR(actionDeclarationIR)

def $lift_declarationIR(errorDeclarationIR)
  = $lift_errorDeclarationIR(errorDeclarationIR)

