rule Expr_eval/lor-false:
  p EC_0 ARCH_0
    |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
    : EC_2 ARCH_2 expressionResult_r
  -- Expr_eval:
       p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT (_B false))
  -- Expr_eval:
