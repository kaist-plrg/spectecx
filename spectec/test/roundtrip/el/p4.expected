def $cast_tuple(TUPLE `<typeIR*`>, TUPLE `(value*`))
  = TUPLE `($cast_op(typeIR, value)*`)

def $cast_tuple(SET `<typeIR`>, tupleValue)
  = SET `{$cast_op(typeIR, tupleValue)`}

def $cast_op(typeIR, tupleValue) = $cast_tuple(typeIR_unroll, tupleValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_array(typeIR, arrayValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_array(ARRAY typeIR `[n_size`], ARRAY `[value*`]) = ARRAY `[value*`]

def $cast_op(typeIR, arrayValue) = $cast_array(typeIR_unroll, arrayValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_header_stack(typeIR, headerStackValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_header_stack(HEADER_STACK typeIR `[n_size`],
                       HEADER_STACK `[value* `(n_idx`)`])
  = HEADER_STACK `[value* `(n_idx`)`]

def $cast_op(typeIR, headerStackValue)
  = $cast_header_stack(typeIR_unroll, headerStackValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_struct(typeIR, structValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_struct(STRUCT typeId `<_`> `{_`},
                 STRUCT typeId `{(value_field nameIR_field ';')*`})
  = STRUCT typeId `{(value_field nameIR_field ';')*`}

def $cast_op(typeIR, structValue) = $cast_struct(typeIR_unroll, structValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_header(typeIR, headerValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_header(HEADER typeId `<_`> `{_`},
                 HEADER typeId `{b ';' (value_field nameIR_field ';')*`})
  = HEADER typeId `{b ';' (value_field nameIR_field ';')*`}

def $cast_op(typeIR, headerValue) = $cast_header(typeIR_unroll, headerValue)
  -- if typeIR_unroll = $unroll_typeIR(typeIR)

dec $cast_header_union(typeIR, headerUnionValue) : value
  hint(prose_in %1 "casted to type" %0)
  hint(testgen_ignore)

def $cast_header_union(HEADER_UNION typeId `<_`> `{_`},
                       HEADER_UNION typeId `{(value_field nameIR_field ';')*`})
  = HEADER_UNION typeId `{(value_field nameIR_field ';')*`}

def $cast_op(typeIR, headerUnionValue)
