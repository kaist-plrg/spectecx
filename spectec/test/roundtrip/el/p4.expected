  -- if eps = $find_non_overloaded<callableTypeDefIR>(TC.BLOCK.CALLABLE, nameIR)

def $find_callableDef_non_overloaded_t(LOCAL, TC, _BARE nameIR)
  = $find_callableDef_non_overloaded_t(BLOCK, TC, _BARE nameIR)

dec $find_constructorDef_overloaded_t(typingContext, prefixedNameIR, argumentIR*)
  : callResolution<constructorTypeDefIR>?
  hint(prose_in "the overloaded constructor definition of" %1 `(%2`) "in" %0)

def $find_constructorDef_overloaded_t(TC, '.' nameIR, argumentIR*)
  = $find_overloaded<constructorTypeDefIR>(TC.GLOBAL.CONSTRUCTOR,
                                           callTargetKey,
                                           def $parameterListIR_of_constructorTypeDefIR)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)

def $find_constructorDef_overloaded_t(TC, _BARE nameIR, argumentIR*)
  = $find_overloaded<constructorTypeDefIR>(TC.GLOBAL.CONSTRUCTOR,
                                           callTargetKey,
                                           def $parameterListIR_of_constructorTypeDefIR)
  -- if callTargetKey = $callTargetKey(nameIR, argumentIR*)

dec $find_local_return_type_t(typingContext) : typeIR?
  hint(prose_in "the expected return type in" %0)

def $find_local_return_type_t(TC) = typeIR_ret
  -- if FUNCTION ':' typeIR_ret = TC.LOCAL.KIND

def $find_local_return_type_t(TC) = typeIR_ret
  -- if EXTERN_FUNCTION ':' typeIR_ret = TC.LOCAL.KIND

def $find_local_return_type_t(TC) = VOID
  -- if ACTION = TC.LOCAL.KIND

def $find_local_return_type_t(TC) = typeIR_ret
  -- if EXTERN_METHOD ':' typeIR_ret = TC.LOCAL.KIND

def $find_local_return_type_t(TC) = typeIR_ret
  -- if EXTERN_METHOD ABSTRACT ':' typeIR_ret = TC.LOCAL.KIND

def $find_local_return_type_t(TC) = VOID
  -- if CONTROL_APPLY_METHOD = TC.LOCAL.KIND

def $find_local_return_type_t(TC) = eps
  -- otherwise
;; === 5-typing/5.02.2-typing-table-context.spectec ===
syntax matchKey =
  | typeIR ':' nameIR

syntax matchAction =
  | prefixedNameIR `(parameterIR* '@' argumentListIR`)

syntax matchPriority = {DELTA nat, LARGEST_WINS bool}

syntax matchEntries = {SIZE nat, CONST bool}

syntax matchMode =
  | NONE
  | LPM nat
  | PRI

syntax tableContext =
  {KEYS matchKey*,
   ACTIONS matchAction*,
   PRIORITIES matchPriority,
   ENTRIES matchEntries,
   MODE matchMode}

var TBLC : tableContext

syntax tableEntryState =
  | LPM nat
  | NON_LPM

var TBLS : tableEntryState

dec $empty_tableContext : tableContext

def $empty_tableContext
  = {KEYS eps,
     ACTIONS eps,
     PRIORITIES matchPriority,
     ENTRIES matchEntries,
     MODE NONE}
  -- if matchPriority = {DELTA 1, LARGEST_WINS true}
  -- if matchEntries = {SIZE 0, CONST true}

dec $add_key_tbl(tableContext, id, typeIR) : tableContext
  hint(prose_in %0 "with match key" %1 "of type" %2 "added")

def $add_key_tbl(TBLC, id, typeIR) = TBLC[.KEYS = TBLC.KEYS ++ [matchKey]]
  -- if matchKey = typeIR ':' id

dec $add_action_tbl(tableContext, prefixedNameIR, parameterIR*, argumentListIR)
  : tableContext
  hint(prose_in %0 "with match action" %1 `(%2`) "applied using" %3 "added")

def $add_action_tbl(TBLC, prefixedNameIR, parameterIR*, argumentListIR)
  = TBLC[.ACTIONS = TBLC.ACTIONS ++ [matchAction]]
  -- if matchAction = prefixedNameIR `(parameterIR* '@' argumentListIR`)

dec $is_lpm_key(tableKeyIR) : bool
  hint(prose_true "match kind of table key" %0 "is lpm")
  hint(prose_false "match kind of table key" %0 "is not lpm")

dec $is_lpm_key'(nameIR) : bool

def $is_lpm_key(_ '#' _ ':' nameIR _ ';') = $is_lpm_key'(nameIR)

def $is_lpm_key'("lpm") = true

def $is_lpm_key'(nameIR) = false
  -- otherwise

dec $requires_priority(tableKeyIR) : bool
  hint(prose_true "match kind of table key" %0 "requires a priority")
  hint(prose_false "match kind of table key" %0 "does not require a priority")

dec $requires_priority'(nameIR) : bool

def $requires_priority(_ '#' _ ':' nameIR _ ';') = $requires_priority'(nameIR)

def $requires_priority'("range") = true

def $requires_priority'("ternary") = true

def $requires_priority'("optional") = true

def $requires_priority'(nameIR) = false
  -- otherwise

dec $update_mode_tbl(tableContext, tableKeyIR*) : tableContext
  hint(prose_in %0 "with match mode updated based on keys" %1)

def $update_mode_tbl(TBLC, tableKeyIR*) = TBLC[.MODE = PRI]
  -- (if b_pri = $requires_priority(tableKeyIR))*
  -- if $exists_(b_pri*)

def $update_mode_tbl(TBLC, tableKeyIR*) = TBLC[.MODE = LPM n]
  -- (if b_pri = $requires_priority(tableKeyIR))*
  -- if ~$exists_(b_pri*)
  -- (if b_lpm = $is_lpm_key(tableKeyIR))*
  -- if tableKeyIR_lpm = $filter_<tableKeyIR>(tableKeyIR*, b_lpm*)
  -- if typedExpressionIR '#' _ ':' "lpm" _ ';' = tableKeyIR_lpm
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR)
  -- if integerTypeIR = $unroll_aliasTypeIR(typeIR)
  -- if n = $width_of_integerTypeIR(integerTypeIR)

def $update_mode_tbl(TBLC, tableKeyIR*) = TBLC[.MODE = NONE]
  -- (if b_pri = $requires_priority(tableKeyIR))*
  -- if ~$exists_(b_pri*)
  -- (if b_lpm = $is_lpm_key(tableKeyIR))*
  -- if ~$exists_(b_lpm*)

dec $find_action(tableContext, prefixedNameIR) : (parameterIR*, argumentListIR)?

dec $find_action'(matchAction*, prefixedNameIR)
  : (parameterIR*, argumentListIR)?

def $find_action(TBLC, prefixedNameIR)
  = $find_action'(TBLC.ACTIONS, prefixedNameIR)

def $find_action'(eps, prefixedNameIR) = eps

def $find_action'(matchAction_h :: matchAction_t*, prefixedNameIR)
  = (parameterIR*, argumentListIR)
  -- if prefixedNameIR `(parameterIR* '@' argumentListIR`) = matchAction_h

def $find_action'(matchAction_h :: matchAction_t*, prefixedNameIR)
  = $find_action'(matchAction_t*, prefixedNameIR)
  -- if prefixedNameIR_h `(_ '@' _`) = matchAction_h
  -- if prefixedNameIR_h =/= prefixedNameIR

dec $set_priorities_of_tableEntryListIR(tableContext,
                                        tableEntryState*,
                                        tableEntryListIR)
  : tableEntryListIR
  hint(prose_in %2
                "with priorities set based on table context"
                %0
                "and entry states"
                %1)

dec $set_priorities_of_tableEntryListIR'(tableContext, nat, tableEntryIR*)
  : tableEntryIR*

dec $set_priority_of_tableEntryIR(tableEntryIR, nat) : tableEntryIR

def $set_priorities_of_tableEntryListIR(TBLC, TBLS*, tableEntryIR*)
  = tableEntryIR*
  -- if TBLC.MODE = NONE
  -- (if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR))*

def $set_priorities_of_tableEntryListIR(TBLC, TBLS*, tableEntryIR*)
  = tableEntryIR_updated*
  -- if TBLC.MODE = LPM n
  -- (if LPM n_prefix = TBLS)*
  -- (if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR))*
  -- (if tableEntryIR_updated
         = $set_priority_of_tableEntryIR(tableEntryIR, n_prefix))*

def $set_priorities_of_tableEntryListIR(TBLC, TBLS*, eps) = eps
  -- if TBLC.MODE = PRI

def $set_priorities_of_tableEntryListIR(TBLC,
                                        TBLS*,
                                        tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if TBLC.MODE = PRI
  -- if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- (if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_t))*
  -- if b_lw = TBLC.PRIORITIES.LARGEST_WINS
  -- if n_size = TBLC.ENTRIES.SIZE
  -- if n_delta = TBLC.PRIORITIES.DELTA
  -- if n = $ite<int>(b_lw, $((n_size - 1) * n_delta + 1), 1)
  -- if tableEntryIR_h_updated
        = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
        = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priorities_of_tableEntryListIR(TBLC,
                                        TBLS*,
                                        tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if TBLC.MODE = PRI
  -- if ~TBLC.ENTRIES.CONST
  -- if PRIORITY '=' integerLiteral ':'
        = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- if n = $nat_of_integerValue(integerLiteral)
  -- if tableEntryIR_h_updated
        = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
        = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priorities_of_tableEntryListIR'(TBLC, n_last, eps) = eps

def $set_priorities_of_tableEntryListIR'(TBLC,
                                         n_last,
                                         tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if eps = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- if b_lw = TBLC.PRIORITIES.LARGEST_WINS
  -- if n_delta = TBLC.PRIORITIES.DELTA
  -- if n = $ite<int>(b_lw, $(n_last - n_delta), $(n_last + n_delta))
  -- if tableEntryIR_h_updated
        = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
        = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priorities_of_tableEntryListIR'(TBLC,
                                         n_last,
                                         tableEntryIR_h :: tableEntryIR_t*)
  = tableEntryIR_h_updated :: tableEntryIR_t_updated*
  -- if PRIORITY '=' integerLiteral ':'
        = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h)
  -- if n = $nat_of_integerValue(integerLiteral)
  -- if tableEntryIR_h_updated
        = $set_priority_of_tableEntryIR(tableEntryIR_h, n)
  -- if tableEntryIR_t_updated*
        = $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*)

def $set_priority_of_tableEntryIR(tableEntryIR, n) = tableEntryIR_updated
  -- if constOptIR
        _
        keysetExpressionIR
        ':'
        tableActionReferenceIR
        annotationList
        ';'
        = tableEntryIR
  -- if tableEntryPriorityIR = PRIORITY '=' (D n) ':'
  -- if tableEntryIR_updated
        = constOptIR
          tableEntryPriorityIR
          keysetExpressionIR
          ':'
          tableActionReferenceIR
          annotationList
          ';'

dec $join_tableEntryState(tableEntryState, tableEntryState) : tableEntryState

def $join_tableEntryState(NON_LPM, LPM n) = LPM n

def $join_tableEntryState(LPM n, NON_LPM) = LPM n

def $join_tableEntryState(NON_LPM, NON_LPM) = NON_LPM

dec $tableEntry_lpm_prefix(value) : nat

dec $tableEntry_lpm_prefix'(value, nat) : nat

def $tableEntry_lpm_prefix(value) = $tableEntry_lpm_prefix'(value, 0)

def $tableEntry_lpm_prefix'(0 W _, n_prefix) = n_prefix

def $tableEntry_lpm_prefix'(w W n, n_prefix)
  = $tableEntry_lpm_prefix'(value', $(n_prefix + 1))
  -- if $(w > 0)
  -- if w' = $(w - 1)
  -- if $(n \ 2) =/= 0
  -- if n' = $((n - 1) / 2)
  -- if value' = w' W n'

def $tableEntry_lpm_prefix'(w W n, 0) = $tableEntry_lpm_prefix'(value', 0)
  -- if $(w > 0)
  -- if w' = $(w - 1)
  -- if $(n \ 2) = 0
  -- if value' = w' W $(n / 2)
;; === 5-typing/5.03-typing-wellformed.spectec ===
relation Type_wf: bound |- typeIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed type, with bound type variables" %0)
  hint(prose_false %1 "is not a well-formed type, with bound type variables" %0)

relation TypeDef_wf: bound |- typeDefIR
  hint(input %0 %1)
  hint(prose_true %1
                  "is a well-formed type definition, with bound type variables"
                  %0)
  hint(prose_false %1
                   "is not a well-formed type definition, with bound type variables"
                   %0)

relation ParameterType_wf: bound |- parameterIR
  hint(input %0 %1)
  hint(prose_true %1 "is a well-formed parameter, with bound type variables" %0)
  hint(prose_false %1
                   "is not a well-formed parameter, with bound type variables"
                   %0)

relation ReturnType_wf: bound |- typeIR
  hint(input %0 %1)
  hint(prose_true %1
                  "is a well-formed return type, with bound type variables"
                  %0)
  hint(prose_false %1
                   "is not a well-formed return type, with bound type variables"
                   %0)

relation CallableType_wf: bound |- callableTypeIR
  hint(input %0 %1)
  hint(prose_true %1
                  "is a well-formed callable type, with bound type variables"
                  %0)
  hint(prose_false %1
                   "is not a well-formed callable type, with bound type variables"
                   %0)

relation CallableTypeDef_wf: bound |- callableTypeDefIR
  hint(input %0 %1)
  hint(prose_true %1
                  "is a well-formed callable type definition, with bound type variables"
                  %0)
  hint(prose_false %1
                   "is not a well-formed callable type definition, with bound type variables"
                   %0)

relation ConstructorParameterType_wf: bound |- parameterIR
  hint(input %0 %1)
  hint(prose_true %1
                  "is a well-formed constructor parameter, with bound type variables"
                  %0)
  hint(prose_false %1
                   "is not a well-formed constructor parameter, with bound type variables"
                   %0)

relation ConstructorType_wf: bound |- constructorTypeIR
  hint(input %0 %1)
  hint(prose_true %1
                  "is a well-formed constructor type, with bound type variables"
                  %0)
  hint(prose_false %1
                   "is not a well-formed constructor type, with bound type variables"
                   %0)

relation ConstructorTypeDef_wf: bound |- constructorTypeDefIR
  hint(input %0 %1)
  hint(prose_true %1
                  "is a well-formed constructor type definition, with bound type variables"
                  %0)
  hint(prose_false %1
                   "is not a well-formed constructor type definition, with bound type variables"
                   %0)

