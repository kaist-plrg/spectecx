                %1)
  hint(prose_out "store" %3 "and" %4)

relation ControlLocalDecl_inst:
  instContext store
    |- controlLocalDeclarationIR
    : instContext store controlLocalDeclarationIR?
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation ControlLocalDecls_inst:
  instContext store
    |- controlLocalDeclarationIR*
    : instContext store controlLocalDeclarationIR*
  hint(input %0 %1 %2)
  hint(prose_in "compile-time evaluation of" %2#", under context" %0#"and store"
                %1)
  hint(prose_out "context" %3#", store" %4#", and" %5)

relation ConstDecl_inst:
  cursor instContext |- constantDeclarationIR : instContext
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %1 "at" %0)
  hint(prose_out "context" %3)

relation InstDecl_inst:
  cursor instContext store
    |- instantiationIR
    : instContext store constantDeclarationIR
  hint(input %0 %1 %2 %3)
  hint(prose_in "loading" %3#", under context" %1 "and store" %2 "at" %0)
  hint(prose_out "context" %4#", store" %5#"," "and reference to object" %6)

relation FuncDecl_inst:
  cursor instContext |- functionDeclarationIR : instContext
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %1 "at" %0)
  hint(prose_out "context" %3)

relation ActionDecl_inst:
  cursor instContext |- actionDeclarationIR : instContext
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %1 "at" %0)
  hint(prose_out "context" %3)

relation Decl_inst: instContext store |- declarationIR : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %0#", and store" %1)
  hint(prose_out "context" %4 "and store" %5)

relation Decls_inst: instContext store |- declarationIR* : instContext store
  hint(input %0 %1 %2)
  hint(prose_in "loading" %2#", under context" %0#", and store" %1)
  hint(prose_out "context" %4 "and store" %5)

relation Program_inst: |- p4program : globalInstLayer store
  hint(input %0)
  hint(prose_in "loading" %0)
  hint(prose_out "global instantiation layer" %1 "and store" %2)

relation Copy_in_arg_inst:
  store cursor instContext argumentIR '@' cursor instContext id
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5 %6)
  hint(prose_in "copy-in from" %2 "at" %1 "with" %3 "to" %5 "at" %4 "with" %6#", under store"
                %0)
  hint(prose_out "store" %7 "and context" %8)

relation Copy_in_inst:
  store cursor instContext argumentIR* '@' cursor instContext id*
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5 %6)
  hint(prose_in "copy-in from" %2 "at" %1 "with" %3 "to" %5 "at" %4 "with" %6#", under store"
                %0)
  hint(prose_out "store" %7 "and context" %8)

relation Copy_in_arg_inst_default:
  store cursor instContext '@' cursor instContext parameterIR
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5)
  hint(prose_in "copying default" %5 "from" %1 "at" %2 "to" %4 "at" %3#", under store"
                %0)
  hint(prose_out "store" %6 "and context" %7)

relation Copy_in_inst_default:
  store cursor instContext '@' cursor instContext parameterIR*
    ~> store instContext
  hint(input %0 %1 %2 %3 %4 %5)
  hint(prose_in "copying defaults" %5 "from" %1 "at" %2 "to" %4 "at" %3#", under store"
                %0)
  hint(prose_out "store" %6 "and context" %7)

relation Constructor_inst:
  cursor instContext
    |- prefixedNameIR `<typeArgumentListIR`> `(argumentListIR`)
    : constructorDef `<typeArgumentListIR`> `('#' id* '#' id*`)
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "finding constructor for"
                %2
                `<%3`>
                `(%4`)
                "under context"
                %1
                "at"
                %0)
  hint(prose_out "constructor" %5 `<%6`> "with defaults" %7 "and optionals" %8)

relation Constructor_call:
  cursor instContext store
    |- constructorDef `<typeArgumentListIR`> `(argumentListIR '#' id* '#' id*`)
    : store object
  hint(input %0 %1 %2 %3 %4 %5 %6 %7)
  hint(prose_in "instantiating"
                %3
                `<%4`>
                `(%5`)
                "with defaults"
                %6
                "and optionals"
                %7#", under context"
                %1
                "and store"
                %2
                "at"
                %0)
  hint(prose_out "store" %8 "and instantiated" %9)
;; === 7-instantiation/7.04-inst-expression.spectec ===
rule Expr_inst/booleanLiteral:
  p IC STO |- booleanLiteral '#' _ : STO boolValue
  -- if boolValue = $ite<boolValue>(booleanLiteral = TRUE, _B true, _B false)

rule Expr_inst/integerLiteral:
  p IC STO |- integerLiteral '#' _ : STO integerLiteral

rule Expr_inst/stringLiteral:
  p IC STO |- stringLiteral '#' _ : STO stringLiteral

rule Expr_inst/referenceExpressionIR:
  p IC STO |- prefixedNameIR '#' _ : STO value
  -- if value = $find_var_i(prefixedNameIR, p, IC)

rule Expr_inst/defaultExpressionIR:
  p IC STO |- '...' '#' _ : STO DEFAULT

rule Expr_inst/unaryExpressionIR:
  p IC STO_0 |- (unop typedExpressionIR) '#' _ : STO_1 $un_op(unop, value)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

rule Expr_inst/non-short-circuit:
  p IC STO_0
    |- (typedExpressionIR_l binop typedExpressionIR_r) '#' _
    : STO_2 $bin_op(binop, value_l, value_r)
  -- if ~(binop <- ['&&', '||'])
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value_l
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

rule Expr_inst/land-false:
  p IC STO_0
    |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
    : STO_1 (_B false)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B false)

rule Expr_inst/land-true:
  p IC STO_0
    |- (typedExpressionIR_l '&&' typedExpressionIR_r) '#' _
    : STO_2 value_r
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B true)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

rule Expr_inst/lor-true:
  p IC STO_0
    |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
    : STO_1 (_B true)
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B true)

rule Expr_inst/lor-false:
  p IC STO_0
    |- (typedExpressionIR_l '||' typedExpressionIR_r) '#' _
    : STO_2 value_r
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 (_B false)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

rule Expr_inst/true:
  p IC STO_0
    |- (typedExpressionIR_cond
        '?'
        typedExpressionIR_true
        ':'
        typedExpressionIR_false)
       '#'
       _
    : STO_2 value_true
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 (_B true)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true

rule Expr_inst/false:
  p IC STO_0
    |- (typedExpressionIR_cond
        '?'
        typedExpressionIR_true
        ':'
        typedExpressionIR_false)
       '#'
       _
    : STO_2 value_false
  -- Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 (_B false)
  -- Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false

rule Expr_inst/castExpressionIR:
  p IC STO_0 |- (`(typeIR`) typedExpressionIR) '#' _ : STO_1 value_cast
  -- Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
  -- if value_cast = $cast_op(typeIR, value)

rule Expr_inst/invalidHeaderExpressionIR:
  p IC STO |- '{#}' '#' _ : STO '{#}'

rule Expr_inst/non-default:
  p IC STO_0 |- (SEQ `{typedExpressionListIR`}) '#' _ : STO_1 (SEQ `(value*`))
  -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*

rule Expr_inst/default:
  p IC STO_0
    |- (SEQ `{typedExpressionListIR ',' '...'`}) '#' _
    : STO_1 (SEQ `(value* ',' '...'`))
  -- Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*

rule Expr_inst/non-default:
  p IC STO_0
    |- (RECORD `{(nameIR '=' typedExpressionIR)*`}) '#' _
    : STO_1 (RECORD `{(value nameIR ';')*`})
  -- Exprs_inst: p IC STO_0 |- typedExpressionIR* : STO_1 value*

rule Expr_inst/default:
  p IC STO_0
    |- (RECORD `{(nameIR '=' typedExpressionIR)* ',' '...'`}) '#' _
    : STO_1 (RECORD `{(value nameIR ';')* ',' '...'`})
  -- Exprs_inst: p IC STO_0 |- typedExpressionIR* : STO_1 value*

rule Expr_inst/errorAccessExpressionIR:
  p IC STO |- (ERROR '.' nameIR) '#' _ : STO value_error
  -- if nameIR_error = "error." ++ nameIR
