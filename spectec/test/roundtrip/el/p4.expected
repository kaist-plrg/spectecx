rule ForInitStmt_eval/variableDeclarationIR-initializer-cont:
  EC_0 ARCH_0
    |- annotationList typeIR nameIR ('=' typedExpressionIR_init)
    : EC_2 ARCH_1 _EMPTY
  -- Expr_eval:
       LOCAL EC_0 ARCH_0
         |- typedExpressionIR_init
         : EC_1 ARCH_1 (_CONT value_init)
