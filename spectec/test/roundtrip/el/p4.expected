def $is_serializable_typeIR(HEADER_STACK typeIR `[_`])
  = $is_serializable_typeIR(typeIR)

def $is_serializable_typeIR(STRUCT _ `<_`> `{(_ typeIR _ ';')*`})
  = $forall_($is_serializable_typeIR(typeIR)*)

def $is_serializable_typeIR(HEADER _ `<_`> `{(_ typeIR _ ';')*`})
  = $forall_($is_serializable_typeIR(typeIR)*)

def $is_serializable_typeIR(HEADER_UNION _ `<_`> `{(_ typeIR _ ';')*`})
  = $forall_($is_serializable_typeIR(typeIR)*)

def $is_serializable_typeIR(_) = false
  -- otherwise
