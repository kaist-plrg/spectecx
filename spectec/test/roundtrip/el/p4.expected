relation ForThreeClauseStmt_eval:
  evalContext arch
    |- typedExpressionIR statementIR forUpdateStatementListIR
    : evalContext arch statementResult
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "looping" %3 "with condition" %2 "and updates" %4#", under evaluation context"
                %0
                "and state"
                %1)
  hint(prose_out "\nthe updated evaluation context" %5#", state" %6#", and" %7)

rule ForThreeClauseStmt_eval/cond-abort:
  EC_0 ARCH_0
    |- typedExpressionIR statementIR forUpdateStatementListIR
    : EC_1 ARCH_1 abortResult
  -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult

rule ForThreeClauseStmt_eval/cond-false:
  EC_0 ARCH_0
    |- typedExpressionIR statementIR forUpdateStatementListIR
    : EC_1 ARCH_1 _EMPTY
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT (_B false))

