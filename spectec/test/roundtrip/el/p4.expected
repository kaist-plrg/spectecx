relation ForCollectionExpr_eval:
  evalContext arch
    |- forCollectionExpressionIR
    : evalContext arch expressionListResult
  hint(input %0 %1 %2)
  hint(prose_in "runtime evaluation of" %2#", under evaluation context"
                %0
                "and state"
                %1)
  hint(prose_out "\nthe updated evaluation context" %3#", state" %4#", and" %5)

rule ForCollectionExpr_eval/abort:
  EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult
  -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult

rule ForCollectionExpr_eval/list:
  EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT value*)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT listValue)
  -- if LIST `[value*`] = listValue

rule ForCollectionExpr_eval/array:
  EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT value*)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT arrayValue)
  -- if ARRAY `[value*`] = arrayValue

rule ForCollectionExpr_eval/header-stack:
  EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT value*)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0
         |- typedExpressionIR
         : EC_1 ARCH_1 (_CONT headerStackValue)
  -- if HEADER_STACK `[value* `(_`)`] = headerStackValue

dec $values_of_setValue(setTypeIR, setValue) : value*
  hint(prose_in "the values in" %1 "of type" %0)

def $values_of_setValue(SET `<typeIR`>, SET `{value_l '..' value_r`})
  = value_l :: $values_of_setValue(SET `<typeIR`>,
                                   SET `{value_l_inc '..' value_r`})
  -- if $bin_lt(value_l, value_r)
  -- if value_one = $cast_op(typeIR, D 1)
  -- if value_l_inc = $bin_plus(value_l, value_one)

def $values_of_setValue(SET `<typeIR`>, SET `{value_l '..' value_r`}) = value_l
  -- if $bin_eq(value_l, value_r)

def $values_of_setValue(SET `<typeIR`>, SET `{value_l '..' value_r`}) = eps
  -- if $bin_gt(value_l, value_r)

rule ForCollectionExpr_eval/left-abort:
  EC_0 ARCH_0
    |- typedExpressionIR_l '..' typedExpressionIR_r
    : EC_1 ARCH_1 abortResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult

rule ForCollectionExpr_eval/left-cont-right-abort:
  EC_0 ARCH_0
    |- typedExpressionIR_l '..' typedExpressionIR_r
    : EC_2 ARCH_2 abortResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT value_l)
  -- Expr_eval:
       LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult

rule ForCollectionExpr_eval/left-cont-right-cont:
  EC_0 ARCH_0
    |- typedExpressionIR_l '..' typedExpressionIR_r
    : EC_2 ARCH_2 (_CONT value*)
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 (_CONT value_l)
  -- Expr_eval:
       LOCAL EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 (_CONT value_r)
  -- if typeIR = $type_of_typedExpressionIR(typedExpressionIR_l)
  -- if value*
        = $values_of_setValue(SET `<typeIR`>, SET `{value_l '..' value_r`})

relation ForInStmt_eval:
  evalContext arch
    |- nameIR value* statementIR
    : evalContext arch statementResult
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "looping over" %3 "with loop variable" %2 "and body" %4#", under evaluation context"
                %0
                "and state"
                %1)
  hint(prose_out "\nthe updated evaluation context" %5#", state" %6#", and" %7)

rule ForInStmt_eval/nil:
  EC ARCH |- nameIR eps statementIR : EC ARCH _EMPTY

rule ForInStmt_eval/cons-loop-abort:
  EC_0 ARCH_0
    |- nameIR (value_h :: value_t*) statementIR
    : EC_2 ARCH_1 abortResult
  -- if EC_1 = $update_var_e(LOCAL, EC_0, _BARE nameIR, value_h)
  -- Stmt_eval: LOCAL EC_1 ARCH_0 |- statementIR : EC_2 ARCH_1 abortResult

rule ForInStmt_eval/cons-loop-return:
  EC_0 ARCH_0
    |- nameIR (value_h :: value_t*) statementIR
    : EC_2 ARCH_1 returnResult
  -- if EC_1 = $update_var_e(LOCAL, EC_0, _BARE nameIR, value_h)
  -- Stmt_eval: LOCAL EC_1 ARCH_0 |- statementIR : EC_2 ARCH_1 returnResult

rule ForInStmt_eval/cons-loop-break:
  EC_0 ARCH_0 |- nameIR (value_h :: value_t*) statementIR : EC_2 ARCH_1 _EMPTY
  -- if EC_1 = $update_var_e(LOCAL, EC_0, _BARE nameIR, value_h)
  -- Stmt_eval: LOCAL EC_1 ARCH_0 |- statementIR : EC_2 ARCH_1 BREAK

rule ForInStmt_eval/cons-loop-cont:
  EC_0 ARCH_0
    |- nameIR (value_h :: value_t*) statementIR
    : EC_3 ARCH_2 statementResult
  -- if EC_1 = $update_var_e(LOCAL, EC_0, _BARE nameIR, value_h)
  -- Stmt_eval:
       LOCAL EC_1 ARCH_0 |- statementIR : EC_2 ARCH_1 statementResult_loop
  -- if statementResult_loop = _EMPTY \/ statementResult_loop = CONTINUE
  -- ForInStmt_eval:
       EC_2 ARCH_1 |- nameIR value_t* statementIR : EC_3 ARCH_2 statementResult

rule Stmt_eval/no-annotations-collection-abort:
  LOCAL EC_0 ARCH_0
    |- annotationList
       FOR
       `(typeIR nameIR IN forCollectionExpressionIR`)
       statementIR
    : EC_3 ARCH_1 abortResult
  -- if EC_1 = $enter_e(EC_0)
  -- ForCollectionExpr_eval:
       EC_1 ARCH_0 |- forCollectionExpressionIR : EC_2 ARCH_1 abortResult
  -- if EC_3 = $exit_e(EC_2)

rule Stmt_eval/no-annotations-collection-loop:
  LOCAL EC_0 ARCH_0
    |- annotationList
       FOR
       `(typeIR nameIR IN forCollectionExpressionIR`)
       statementIR
    : EC_5 ARCH_2 statementResult
  -- if EC_1 = $enter_e(EC_0)
  -- ForCollectionExpr_eval:
       EC_1 ARCH_0 |- forCollectionExpressionIR : EC_2 ARCH_1 (_CONT value*)
  -- if typeIR_subst = $subst_type_e(LOCAL, EC_0, typeIR)
  -- if value_init = $default(typeIR_subst)
  -- if EC_3 = $add_var_e(LOCAL, EC_2, _BARE nameIR, value_init)
  -- ForInStmt_eval:
       EC_3 ARCH_1 |- nameIR value* statementIR : EC_4 ARCH_2 statementResult
  -- if EC_5 = $exit_e(EC_4)

rule Stmt_eval/annotations:
  LOCAL EC_0 ARCH_0
    |- annotationList
       FOR
       `(annotationList_in typeIR nameIR IN forCollectionExpressionIR`)
       statementIR
    : EC_1 ARCH_1 statementResult
  -- Stmt_eval:
       LOCAL EC_0 ARCH_0
         |- annotationList
            FOR
            `(typeIR nameIR IN forCollectionExpressionIR`)
            statementIR
         : EC_1 ARCH_1 statementResult

rule Stmt_eval/breakStatementIR:
  LOCAL EC ARCH |- BREAK ';' : EC ARCH BREAK

rule Stmt_eval/continueStatementIR:
  LOCAL EC ARCH |- CONTINUE ';' : EC ARCH CONTINUE

relation Switch_table_eval:
  evalContext arch
    |- SWITCH `(id`) `{switchCaseIR*`}
    : evalContext arch statementResult
  hint(input %0 %1 %2 %3)

dec $match_switchLabelIR_table(id, switchLabelIR) : bool
  hint(prose_true %0 "matches" %1)
  hint(prose_false %0 "does not match" %1)

def $match_switchLabelIR_table(id, DEFAULT) = true

def $match_switchLabelIR_table(id, (_BARE id) '#' _) = true

def $match_switchLabelIR_table(id, _) = false
  -- otherwise

relation SwitchCases_table_eval: id |- switchCaseListIR : blockStatementIR?
  hint(input %0 %1)
  hint(prose_in "runtime evaluation of" %1 "for invocation of table" %0)
  hint(prose_out "the matched block" %2)

dec $is_non_fallthrough_switchCaseIR(switchCaseIR) : bool
  hint(prose_true %0 "is not a fall-through case")
  hint(prose_false %0 "is a fall-through case")

def $is_non_fallthrough_switchCaseIR(switchLabelIR ':' blockStatementIR) = true

def $is_non_fallthrough_switchCaseIR(switchLabelIR ':') = false

rule SwitchCases_table_eval/nil:
  id |- eps : eps

rule SwitchCases_table_eval/cons-non-fallthrough-match:
  id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR_h
  -- if switchLabelIR_h ':' blockStatementIR_h = switchCaseIR_h
  -- if $match_switchLabelIR_table(id, switchLabelIR_h)

rule SwitchCases_table_eval/cons-non-fallthrough-no-match:
  id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR?
  -- if switchLabelIR_h ':' blockStatementIR_h = switchCaseIR_h
  -- if ~$match_switchLabelIR_table(id, switchLabelIR_h)
  -- SwitchCases_table_eval: id |- switchCaseIR_t* : blockStatementIR?

rule SwitchCases_table_eval/cons-fallthrough-match:
  id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR
  -- if switchLabelIR_h ':' = switchCaseIR_h
  -- if $match_switchLabelIR_table(id, switchLabelIR_h)
  -- if (_ ':' blockStatementIR) :: _
        = $filter_<switchCaseIR>(switchCaseIR_t*,
                                 $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*)

rule SwitchCases_table_eval/cons-fallthrough-match-no-block:
  id |- switchCaseIR_h :: switchCaseIR_t* : eps
  -- if switchLabelIR_h ':' = switchCaseIR_h
  -- if $match_switchLabelIR_table(id, switchLabelIR_h)
  -- if eps
        = $filter_<switchCaseIR>(switchCaseIR_t*,
                                 $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*)

rule SwitchCases_table_eval/cons-fallthrough-no-match:
  id |- switchCaseIR_h :: switchCaseIR_t* : blockStatementIR?
  -- if switchLabelIR_h ':' = switchCaseIR_h
  -- if ~$match_switchLabelIR_table(id, switchLabelIR_h)
  -- SwitchCases_table_eval: id |- switchCaseIR_t* : blockStatementIR?

rule Switch_table_eval/no-match:
  EC_0 ARCH_0 |- SWITCH `(id_enum`) `{switchCaseIR*`} : EC_0 ARCH_0 _EMPTY
  -- SwitchCases_table_eval: id_enum |- switchCaseIR* : eps

rule Switch_table_eval/match:
  EC_0 ARCH_0
    |- SWITCH `(id_enum`) `{switchCaseIR*`}
    : EC_1 ARCH_1 statementResult
  -- SwitchCases_table_eval: id_enum |- switchCaseIR* : blockStatementIR
  -- Stmt_eval:
       LOCAL EC_0 ARCH_0 |- blockStatementIR : EC_1 ARCH_1 statementResult

relation Switch_general_eval:
  evalContext arch
    |- SWITCH `(value`) `{switchCaseIR*`}
    : evalContext arch statementResult
  hint(input %0 %1 %2 %3)

relation SwitchLabel_general_eval:
  cursor evalContext arch |- switchLabelIR : evalContext arch expressionResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "runtime evaluation of" %2#", under evaluation context"
                %0
                "and state"
                %1)
  hint(prose_out "\nthe updated evaluation context" %4#", state" %5#", and" %6)

rule SwitchLabel_general_eval/default:
  LOCAL EC_0 ARCH_0 |- DEFAULT : EC_0 ARCH_0 (_CONT DEFAULT)

rule SwitchLabel_general_eval/typedExpressionIR:
  LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult

dec $match_switchLabelIR_general(value, value) : bool
  hint(prose_true %0 "matches" %1)
  hint(prose_false %0 "does not match" %1)

def $match_switchLabelIR_general(value, DEFAULT) = true

def $match_switchLabelIR_general(value_a, value_b) = $bin_eq(value_a, value_b)
  -- if value_b =/= DEFAULT

relation SwitchCases_general_eval:
  cursor evalContext arch value
    |- switchCaseListIR
    : evalContext arch blockStatementIR?
  hint(input %0 %1 %2 %3 %4)
  hint(prose_in "runtime evaluation of" %4#", under evaluation context"
                %0
                "and state"
                %1
                "with switch key"
                %3)
  hint(prose_out "\nthe updated evaluation context" %5#", state" %6#", and" %7)

rule SwitchCases_general_eval/nil:
  LOCAL EC_0 ARCH_0 value |- eps : EC_0 ARCH_0 eps

rule SwitchCases_general_eval/cons-non-fallthrough-match:
  LOCAL EC_0 ARCH_0 value
    |- (switchCaseIR_h :: switchCaseIR_t*)
    : EC_1 ARCH_1 blockStatementIR_h
  -- if switchLabelIR_h ':' blockStatementIR_h = switchCaseIR_h
  -- SwitchLabel_general_eval:
       LOCAL EC_0 ARCH_0 |- switchLabelIR_h : EC_1 ARCH_1 (_CONT value_label)
  -- if $match_switchLabelIR_general(value, value_label)

rule SwitchCases_general_eval/cons-non-fallthrough-no-match:
  LOCAL EC_0 ARCH_0 value
    |- (switchCaseIR_h :: switchCaseIR_t*)
    : EC_2 ARCH_2 blockStatementIR?
  -- if switchLabelIR_h ':' blockStatementIR_h = switchCaseIR_h
  -- SwitchLabel_general_eval:
       LOCAL EC_0 ARCH_0 |- switchLabelIR_h : EC_1 ARCH_1 (_CONT value_label)
  -- if ~$match_switchLabelIR_general(value, value_label)
  -- SwitchCases_general_eval:
       LOCAL EC_1 ARCH_1 value
         |- switchCaseIR_t*
         : EC_2 ARCH_2 blockStatementIR?

rule SwitchCases_general_eval/cons-fallthrough-match:
  LOCAL EC_0 ARCH_0 value
    |- (switchCaseIR_h :: switchCaseIR_t*)
    : EC_1 ARCH_1 blockStatementIR
  -- if switchLabelIR_h ':' = switchCaseIR_h
  -- SwitchLabel_general_eval:
       LOCAL EC_0 ARCH_0 |- switchLabelIR_h : EC_1 ARCH_1 (_CONT value_label)
  -- if $match_switchLabelIR_general(value, value_label)
  -- if (_ ':' blockStatementIR) :: _
        = $filter_<switchCaseIR>(switchCaseIR_t*,
                                 $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*)

rule SwitchCases_general_eval/cons-fallthrough-match-no-block:
  LOCAL EC_0 ARCH_0 value
    |- (switchCaseIR_h :: switchCaseIR_t*)
    : EC_1 ARCH_1 eps
  -- if switchLabelIR_h ':' = switchCaseIR_h
  -- SwitchLabel_general_eval:
       LOCAL EC_0 ARCH_0 |- switchLabelIR_h : EC_1 ARCH_1 (_CONT value_label)
  -- if $match_switchLabelIR_general(value, value_label)
  -- if eps
        = $filter_<switchCaseIR>(switchCaseIR_t*,
                                 $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*)

rule SwitchCases_general_eval/cons-fallthrough-no-match:
  LOCAL EC_0 ARCH_0 value
    |- (switchCaseIR_h :: switchCaseIR_t*)
    : EC_2 ARCH_2 blockStatementIR?
  -- if switchLabelIR_h ':' = switchCaseIR_h
  -- SwitchLabel_general_eval:
       LOCAL EC_0 ARCH_0 |- switchLabelIR_h : EC_1 ARCH_1 (_CONT value_label)
  -- if ~$match_switchLabelIR_general(value, value_label)
  -- SwitchCases_general_eval:
       LOCAL EC_1 ARCH_1 value
         |- switchCaseIR_t*
         : EC_2 ARCH_2 blockStatementIR?

rule Switch_general_eval/no-match:
  EC_0 ARCH_0 |- SWITCH `(value`) `{switchCaseIR*`} : EC_1 ARCH_1 _EMPTY
  -- SwitchCases_general_eval:
       LOCAL EC_0 ARCH_0 value |- switchCaseIR* : EC_1 ARCH_1 eps

rule Switch_general_eval/match:
  EC_0 ARCH_0
    |- SWITCH `(value`) `{switchCaseIR*`}
    : EC_2 ARCH_2 statementResult
  -- SwitchCases_general_eval:
       LOCAL EC_0 ARCH_0 value |- switchCaseIR* : EC_1 ARCH_1 blockStatementIR
  -- Stmt_eval:
       LOCAL EC_1 ARCH_1 |- blockStatementIR : EC_2 ARCH_2 statementResult

rule Stmt_eval/target-abort:
  LOCAL EC_0 ARCH_0
    |- SWITCH `(typedExpressionIR`) `{switchCaseIR*`}
    : EC_1 ARCH_1 abortResult
  -- Expr_eval: LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult

rule Stmt_eval/target-cont-table:
  LOCAL EC_0 ARCH_0
    |- SWITCH `(typedExpressionIR`) `{switchCaseIR*`}
    : EC_2 ARCH_2 statementResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT value)
  -- if TABLE_ENUM _ '.' id_enum = value
  -- Switch_table_eval:
       EC_1 ARCH_1
         |- SWITCH `(id_enum`) `{switchCaseIR*`}
         : EC_2 ARCH_2 statementResult

rule Stmt_eval/target-cont-general:
  LOCAL EC_0 ARCH_0
    |- SWITCH `(typedExpressionIR`) `{switchCaseIR*`}
    : EC_2 ARCH_2 statementResult
  -- Expr_eval:
       LOCAL EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 (_CONT value)
  -- if ~(value <: tableMetadataEnumValue)
  -- Switch_general_eval:
       EC_1 ARCH_1
         |- SWITCH `(value`) `{switchCaseIR*`}
         : EC_2 ARCH_2 statementResult

rule BlockElementStmt_eval/constantDeclarationIR:
  EC_0 ARCH |- constantDeclarationIR : EC_1 ARCH _EMPTY
  -- ConstDecl_eval: LOCAL EC_0 |- constantDeclarationIR : EC_1

rule BlockElementStmt_eval/variableDeclarationIR:
  EC_0 ARCH_0 |- variableDeclarationIR : EC_1 ARCH_1 declarationResult
  -- VarDecl_eval:
       LOCAL EC_0 ARCH_0
         |- variableDeclarationIR
         : EC_1 ARCH_1 declarationResult

rule BlockElementStmt_eval/statementIR:
  EC_0 ARCH_0 |- statementIR : EC_1 ARCH_1 statementResult
  -- Stmt_eval: LOCAL EC_0 ARCH_0 |- statementIR : EC_1 ARCH_1 statementResult

rule BlockElementStmtList_eval/nil:
  EC ARCH |- eps : EC ARCH _EMPTY

rule BlockElementStmtList_eval/cons-head-non-cont:
  EC_0 ARCH_0
    |- blockElementStatementIR_h :: blockElementStatementIR_t*
    : EC_1 ARCH_1 statementResult
  -- BlockElementStmt_eval:
       EC_0 ARCH_0 |- blockElementStatementIR_h : EC_1 ARCH_1 statementResult
  -- if statementResult =/= _EMPTY

rule BlockElementStmtList_eval/cons-head-cont:
  EC_0 ARCH_0
    |- blockElementStatementIR_h :: blockElementStatementIR_t*
    : EC_2 ARCH_2 statementResult
  -- BlockElementStmt_eval:
       EC_0 ARCH_0 |- blockElementStatementIR_h : EC_1 ARCH_1 _EMPTY
  -- BlockElementStmtList_eval:
       EC_1 ARCH_1 |- blockElementStatementIR_t* : EC_2 ARCH_2 statementResult

rule Block_eval:
  EC_0 ARCH_0
    |- annotationList `{blockElementStatementListIR`}
    : EC_1 ARCH_1 statementResult
  -- BlockElementStmtList_eval:
       EC_0 ARCH_0 |- blockElementStatementListIR : EC_1 ARCH_1 statementResult
;; === 8-dynamic/8.07-eval-declaration.spectec ===
rule VarDecl_eval/non-initializer:
  p EC_0 ARCH |- annotationList typeIR nameIR eps ';' : EC_1 ARCH _EMPTY
  -- if typeIR_subst = $subst_type_e(LOCAL, EC_0, typeIR)
  -- if value_init = $default(typeIR_subst)
  -- if EC_1 = $add_var_e(p, EC_0, _BARE nameIR, value_init)

rule VarDecl_eval/initializer-abort:
  p EC_0 ARCH_0
    |- annotationList typeIR nameIR ('=' typedExpressionIR_init) ';'
    : EC_1 ARCH_1 abortResult
  -- Expr_eval:
       p EC_0 ARCH_0 |- typedExpressionIR_init : EC_1 ARCH_1 abortResult

rule VarDecl_eval/initializer-cont:
  p EC_0 ARCH_0
    |- annotationList typeIR nameIR ('=' typedExpressionIR_init) ';'
    : EC_2 ARCH_1 _EMPTY
  -- Expr_eval:
       p EC_0 ARCH_0 |- typedExpressionIR_init : EC_1 ARCH_1 (_CONT value_init)
  -- if EC_2 = $add_var_e(p, EC_1, _BARE nameIR, value_init)

rule ConstDecl_eval:
  p EC_0 |- annotationList CONST typeIR nameIR ('=' _VALUE value) ';' : EC_1
  -- if EC_1 = $add_var_e(p, EC_0, _BARE nameIR, value)
;; === 8-dynamic/8.08.1-eval-parser-statement.spectec ===
syntax selectCaseMatchResult =
  | continueResult<nameIR?>
  | rejectTransitionResult

relation SelectCase_match:
  evalContext arch value*
    |- selectCaseIR
    : evalContext arch selectCaseMatchResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "matching" %2 "against" %3 "under context" %0 "and state" %1)
  hint(prose_out "the updated context" %4#", state" %5#", and" %6)

rule SelectCase_match/reject:
  EC_0 ARCH_0 value_key*
    |- keysetExpressionIR ':' nameIR ';'
    : EC_1 ARCH_1 rejectTransitionResult
  -- Eval_keyset:
       EC_0 ARCH_0 |- keysetExpressionIR : EC_1 ARCH_1 rejectTransitionResult

rule SelectCase_match/no-match:
  EC_0 ARCH_0 value_key*
    |- keysetExpressionIR ':' nameIR ';'
    : EC_1 ARCH_1 (_CONT eps)
  -- Eval_keyset:
       EC_0 ARCH_0 |- keysetExpressionIR : EC_1 ARCH_1 (_CONT setValue*)
  -- if ~$match_keysets(setValue*, value_key*)

rule SelectCase_match/match:
  EC_0 ARCH_0 value_key*
    |- keysetExpressionIR ':' nameIR ';'
    : EC_1 ARCH_1 (_CONT nameIR)
  -- Eval_keyset:
       EC_0 ARCH_0 |- keysetExpressionIR : EC_1 ARCH_1 (_CONT setValue*)
  -- if $match_keysets(setValue*, value_key*)

relation SelectCases_match:
  evalContext arch value*
    |- selectCaseListIR
    : evalContext arch selectCaseMatchResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "matching" %2 "against" %3 "under context" %0 "and state" %1)
  hint(prose_out "the updated context" %4#", state" %5#", and" %6)

rule SelectCases_match/nil:
  EC ARCH value_key* |- eps : EC ARCH (_CONT eps)

rule SelectCases_match/cons-head-match:
  EC_0 ARCH_0 value_key*
    |- selectCaseIR_h :: selectCaseIR_t*
    : EC_1 ARCH_1 rejectTransitionResult
  -- SelectCase_match:
       EC_0 ARCH_0 value_key*
         |- selectCaseIR_h
         : EC_1 ARCH_1 rejectTransitionResult

rule SelectCases_match/cons-head-match:
  EC_0 ARCH_0 value_key*
    |- selectCaseIR_h :: selectCaseIR_t*
    : EC_1 ARCH_1 (_CONT nameIR_state)
  -- SelectCase_match:
       EC_0 ARCH_0 value_key*
         |- selectCaseIR_h
         : EC_1 ARCH_1 (_CONT nameIR_state)

rule SelectCases_match/cons-head-no-match:
  EC_0 ARCH_0 value_key*
    |- selectCaseIR_h :: selectCaseIR_t*
    : EC_2 ARCH_2 selectCaseMatchResult
  -- SelectCase_match:
       EC_0 ARCH_0 value_key* |- selectCaseIR_h : EC_1 ARCH_1 (_CONT eps)
  -- SelectCases_match:
       EC_1 ARCH_1 value_key*
         |- selectCaseIR_t*
         : EC_2 ARCH_2 selectCaseMatchResult

rule ParserSelect_eval/reject:
  EC_0 ARCH_0 |- selectExpressionIR : EC_1 ARCH_1 rejectTransitionResult
  -- if SELECT `(typedExpressionIR_key*`) `{selectCaseListIR`}
        = selectExpressionIR
  -- Exprs_eval:
       LOCAL EC_0 ARCH_0
         |- typedExpressionIR_key*
         : EC_1 ARCH_1 rejectTransitionResult

rule ParserSelect_eval/cont-selectCaseListIR-reject:
  EC_0 ARCH_0 |- selectExpressionIR : EC_2 ARCH_2 rejectTransitionResult
  -- if SELECT `(typedExpressionIR_key*`) `{selectCaseListIR`}
        = selectExpressionIR
  -- Exprs_eval:
       LOCAL EC_0 ARCH_0
         |- typedExpressionIR_key*
         : EC_1 ARCH_1 (_CONT value_key*)
  -- SelectCases_match:
       EC_1 ARCH_1 value_key*
         |- selectCaseListIR
         : EC_2 ARCH_2 rejectTransitionResult

rule ParserSelect_eval/no-match:
  EC_0 ARCH_0 |- selectExpressionIR : EC_2 ARCH_2 rejectTransitionResult
  -- if SELECT `(typedExpressionIR_key*`) `{selectCaseListIR`}
        = selectExpressionIR
  -- Exprs_eval:
       LOCAL EC_0 ARCH_0
         |- typedExpressionIR_key*
         : EC_1 ARCH_1 (_CONT value_key*)
  -- SelectCases_match:
       EC_1 ARCH_1 value_key*
         |- selectCaseListIR
         : EC_2 ARCH_2 (_CONT nameIR_state?)
  -- if eps = nameIR_state?
  -- if rejectTransitionResult = REJECT (ERROR '.' "NoMatch")

rule ParserSelect_eval/match:
  EC_0 ARCH_0 |- selectExpressionIR : EC_3 ARCH_3 transitionResult
  -- if SELECT `(typedExpressionIR_key*`) `{selectCaseListIR`}
        = selectExpressionIR
  -- Exprs_eval:
       LOCAL EC_0 ARCH_0
         |- typedExpressionIR_key*
         : EC_1 ARCH_1 (_CONT value_key*)
  -- SelectCases_match:
       EC_1 ARCH_1 value_key*
         |- selectCaseListIR
         : EC_2 ARCH_2 (_CONT nameIR_state)
  -- ParserTransition_eval:
       EC_2 ARCH_2
         |- TRANSITION (nameIR_state ';')
         : EC_3 ARCH_3 transitionResult

rule ParserTransition_eval/nameIR-accept:
  EC ARCH |- TRANSITION (nameIR ';') : EC ARCH ACCEPT
  -- if nameIR = "accept"

rule ParserTransition_eval/nameIR-reject:
  EC ARCH |- TRANSITION (nameIR ';') : EC ARCH (REJECT errorValue)
  -- if nameIR = "reject"
  -- if errorValue = ERROR '.' "NoError"

rule ParserTransition_eval/nameIR-state:
  EC ARCH |- TRANSITION (nameIR ';') : EC ARCH (STATE nameIR)
  -- if nameIR =/= "accept" /\ nameIR =/= "reject"

rule ParserTransition_eval/selectExpressionIR:
  EC_0 ARCH_0 |- TRANSITION selectExpressionIR : EC_1 ARCH_1 transitionResult
  -- ParserSelect_eval:
       EC_0 ARCH_0 |- selectExpressionIR : EC_1 ARCH_1 transitionResult

rule ParserStmt_eval/emptyStatementIR:
  EC_0 ARCH_0 |- emptyStatementIR : EC_1 ARCH_1 _EMPTY
  -- Stmt_eval: LOCAL EC_0 ARCH_0 |- emptyStatementIR : EC_1 ARCH_1 _EMPTY

rule ParserStmt_eval/reject:
  EC_0 ARCH_0 |- assignmentStatementIR : EC_1 ARCH_1 rejectTransitionResult
  -- Stmt_eval:
       LOCAL EC_0 ARCH_0
         |- assignmentStatementIR
         : EC_1 ARCH_1 rejectTransitionResult

rule ParserStmt_eval/cont:
  EC_0 ARCH_0 |- assignmentStatementIR : EC_1 ARCH_1 _EMPTY
  -- Stmt_eval: LOCAL EC_0 ARCH_0 |- assignmentStatementIR : EC_1 ARCH_1 _EMPTY

rule ParserStmt_eval/reject:
  EC_0 ARCH_0 |- callStatementIR : EC_1 ARCH_1 rejectTransitionResult
  -- Stmt_eval:
       LOCAL EC_0 ARCH_0 |- callStatementIR : EC_1 ARCH_1 rejectTransitionResult

rule ParserStmt_eval/cont:
  EC_0 ARCH_0 |- callStatementIR : EC_1 ARCH_1 _EMPTY
  -- Stmt_eval: LOCAL EC_0 ARCH_0 |- callStatementIR : EC_1 ARCH_1 _EMPTY

rule ParserStmt_eval/parserBlockStatementIR:
  EC_0 ARCH_0 |- parserBlockStatementIR : EC_3 ARCH_1 parserStatementResult
  -- if EC_1 = $enter_e(EC_0)
  -- ParserBlock_eval:
       EC_1 ARCH_0 |- parserBlockStatementIR : EC_2 ARCH_1 parserStatementResult
  -- if EC_3 = $exit_e(EC_2)

rule ParserStmt_eval/non-else-reject:
  EC ARCH
    |- IF `(typedExpressionIR_cond`) parserStatementIR_then
    : EC_cond ARCH_cond rejectTransitionResult
  -- Expr_eval:
       LOCAL EC ARCH
         |- typedExpressionIR_cond
         : EC_cond ARCH_cond rejectTransitionResult

rule ParserStmt_eval/non-else-cont-true:
  EC ARCH
    |- IF `(typedExpressionIR_cond`) parserStatementIR_then
    : EC_then ARCH_then parserStatementResult
  -- Expr_eval:
       LOCAL EC ARCH
         |- typedExpressionIR_cond
         : EC_cond ARCH_cond (_CONT (_B true))
  -- ParserStmt_eval:
       EC_cond ARCH_cond
         |- parserStatementIR_then
         : EC_then ARCH_then parserStatementResult

rule ParserStmt_eval/non-else-cont-false:
  EC ARCH
    |- IF `(typedExpressionIR_cond`) parserStatementIR_then
    : EC_cond ARCH_cond _EMPTY
  -- Expr_eval:
       LOCAL EC ARCH
         |- typedExpressionIR_cond
         : EC_cond ARCH_cond (_CONT (_B false))

rule ParserStmt_eval/else-reject:
  EC ARCH
    |- IF
       `(typedExpressionIR_cond`)
       parserStatementIR_then
       ELSE
       parserStatementIR_else
    : EC_cond ARCH_cond rejectTransitionResult
  -- Expr_eval:
       LOCAL EC ARCH
         |- typedExpressionIR_cond
         : EC_cond ARCH_cond rejectTransitionResult

rule ParserStmt_eval/else-cont-true:
  EC ARCH
    |- IF
       `(typedExpressionIR_cond`)
       parserStatementIR_then
       ELSE
       parserStatementIR_else
    : EC_then ARCH_then parserStatementResult
  -- Expr_eval:
       LOCAL EC ARCH
         |- typedExpressionIR_cond
         : EC_cond ARCH_cond (_CONT (_B true))
  -- ParserStmt_eval:
       EC_cond ARCH_cond
         |- parserStatementIR_then
         : EC_then ARCH_then parserStatementResult

rule ParserStmt_eval/else-cont-false:
  EC ARCH
    |- IF
       `(typedExpressionIR_cond`)
       parserStatementIR_then
       ELSE
       parserStatementIR_else
    : EC_else ARCH_else parserStatementResult
  -- Expr_eval:
       LOCAL EC ARCH
         |- typedExpressionIR_cond
         : EC_cond ARCH_cond (_CONT (_B false))
  -- ParserStmt_eval:
       EC_cond ARCH_cond
         |- parserStatementIR_else
         : EC_else ARCH_else parserStatementResult

rule ParserBlockElementStmt_eval/constantDeclarationIR:
