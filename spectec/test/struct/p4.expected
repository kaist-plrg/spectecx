    3. Else Phantom#574

;; ../../../../../spectec/specs/p4/4-p4-ir/4.5-ir-to-surface.spectec:81:1-81:63:
dec $lift_nameIR_as_tableCustomName(text')

1. Case analysis on text'

  1. Case (% = "apply")

    1. Return ?((apply))

  2. Case (% = "state")

    1. Return ?((state))

  3. Case (% = "type")

    1. Return ?((type))

  4. Case (% = "priority")

    1. Return ?((priority))

2. Otherwise

  1. Return ?(((text') as tableCustomName))

;; ../../../../../spectec/specs/p4/4-p4-ir/4.5-ir-to-surface.spectec:96:1-98:23:
dec $lift_nameListIR_as_nonTypeNameList(nameIR*)

1. (Let nonTypeName'? be $lift_nameIR_as_nonTypeName(nameIR))*

2. If ((nonTypeName'? matches pattern (_)))*, then

  1. (Let ?(nonTypeName) be nonTypeName'?)*

  2. (Let nameList be $unflatten_nameList((nonTypeName* as name*)))

  3. Return ?(nameList)

2. Else Phantom#575

;; ../../../../../spectec/specs/p4/4-p4-ir/4.5-ir-to-surface.spectec:100:1-101:23:
dec $unflatten_nameList(name*)

1. If ((name* matches pattern _ :: _)), then

  1. (Let name_h :: name_t* be name*)

  2. Return $unflatten_nameList'((name_h as nameList), name_t*)

1. Else Phantom#576

;; ../../../../../spectec/specs/p4/4-p4-ir/4.5-ir-to-surface.spectec:102:1-103:23:
dec $unflatten_nameList'(nameList, name*)

1. Case analysis on name*

  1. Case (% matches pattern [])

    1. Return nameList

  2. Case (% matches pattern _ :: _)

    1. (Let name_h :: name_t* be name*)

    2. Return $unflatten_nameList'((nameList , name_h), name_t*)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.5-ir-to-surface.spectec:119:1-120:23:
