   | block (from cursor)
   | local (from cursor)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:13:17-13:21:
syntax nameIR = text

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:15:1-16:34:
dec $name(name)

1. Case analysis on name

  1. Case (% has type identifier)

    1. (Let (text) be (name as identifier))

    2. Return text

  2. Case (% has type typeIdentifier)

    1. (Let (text) be (name as typeIdentifier))

    2. Return text

1. Else Phantom#64

2. If ((name has type nonTypeName)), then

  1. (Let nonTypeName be (name as nonTypeName))

  2. Case analysis on nonTypeName

    1. Case (% matches pattern `APPLY`)

      1. Return "apply"

    2. Case (% matches pattern `KEY`)

      1. Return "key"

    3. Case (% matches pattern `ACTIONS`)

      1. Return "actions"

    4. Case (% matches pattern `STATE`)

      1. Return "state"

    5. Case (% matches pattern `ENTRIES`)

      1. Return "entries"

    6. Case (% matches pattern `TYPE`)

      1. Return "type"

    7. Case (% matches pattern `PRIORITY`)

      1. Return "priority"

  2. Else Phantom#65

2. Else Phantom#66

3. If ((name matches pattern `LIST`)), then

  1. Return "list"

3. Else Phantom#67

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:28:1-29:34:
dec $tableCustomName(tableCustomName)

1. Case analysis on tableCustomName

  1. Case (% has type identifier)

    1. (Let (text) be (tableCustomName as identifier))

    2. Return text

  2. Case (% has type typeIdentifier)

    1. (Let (text) be (tableCustomName as typeIdentifier))

    2. Return text

1. Else Phantom#68

2. Case analysis on tableCustomName

  1. Case (% matches pattern `APPLY`)

    1. Return "apply"

  2. Case (% matches pattern `STATE`)

    1. Return "state"

  3. Case (% matches pattern `TYPE`)

    1. Return "type"

  4. Case (% matches pattern `PRIORITY`)

    1. Return "priority"

2. Else Phantom#69

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:41:13-41:19:
syntax id = nameIR

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:47:17-47:23:
