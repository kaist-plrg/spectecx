;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:683:1-684:54:
dec $lvalue_as_expression(lvalue'')

1. If ((lvalue'' has type referenceExpression)), then

  1. (Let referenceExpression be (lvalue'' as referenceExpression))

  2. Return (referenceExpression as expression)

1. Else Phantom#39

2. Case analysis on lvalue''

  1. Case (% matches pattern `% . %`)

    1. (Let (lvalue_base . member) be lvalue'')

    2. (Let expression_base be $lvalue_as_expression(lvalue_base))

    3. Return (((expression_base as memberAccessBase) . member) as expression)

  2. Case (% matches pattern `% [%]`)

    1. (Let (lvalue_base [ expression_index ]) be lvalue'')

    2. (Let expression_base be $lvalue_as_expression(lvalue_base))

    3. Return ((expression_base [ expression_index ]) as expression)

  3. Case (% matches pattern `% [% % %]`)

    1. (Let (lvalue_base [ expression_hi sliceop expression_lo ]) be lvalue'')

    2. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Let expression_base be $lvalue_as_expression(lvalue_base))

        2. Return ((expression_base [ expression_hi (:) expression_lo ]) as expression)

      2. Case (% matches pattern `+:`)

        1. (Let expression_base be $lvalue_as_expression(lvalue_base))

        2. Return ((expression_base [ expression_hi (+:) expression_lo ]) as expression)

  4. Case (% matches pattern `(%)`)

    1. (Let (( lvalue )) be lvalue'')

    2. (Let expression be $lvalue_as_expression(lvalue))

    3. Return ((( expression )) as expression)

2. Else Phantom#40

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:701:1-702:51:
dec $expression_as_lvalue(expression'')

1. Case analysis on expression''

  1. Case (% has type referenceExpression)

    1. (Let referenceExpression be (expression'' as referenceExpression))

    2. Return ?((referenceExpression as lvalue))

  2. Case (% has type memberAccessExpression)

    1. (Let (memberAccessBase . member) be (expression'' as memberAccessExpression))

    2. If ((memberAccessBase has type expression)), then

      1. (Let expression be (memberAccessBase as expression))

      2. (Let lvalue'? be $expression_as_lvalue(expression))

      3. If ((lvalue'? matches pattern (_))), then

        1. (Let ?(lvalue) be lvalue'?)

        2. Return ?((lvalue . member))

      3. Else Phantom#41

    2. Else Phantom#42

  3. Case (% has type indexAccessExpression)

    1. (Let (expression_base [ expression_index ]) be (expression'' as indexAccessExpression))

    2. (Let lvalue? be $expression_as_lvalue(expression_base))

    3. If ((lvalue? matches pattern (_))), then

      1. (Let ?(lvalue_base) be lvalue?)

      2. Return ?((lvalue_base [ expression_index ]))

    3. Else Phantom#43

  4. Case (% has type sliceAccessExpression)

    1. (Let (expression_base [ expression_hi sliceop expression_lo ]) be (expression'' as sliceAccessExpression))

    2. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Let lvalue? be $expression_as_lvalue(expression_base))

        2. If ((lvalue? matches pattern (_))), then

          1. (Let ?(lvalue_base) be lvalue?)

          2. Return ?((lvalue_base [ expression_hi (:) expression_lo ]))

        2. Else Phantom#44

      2. Case (% matches pattern `+:`)

        1. (Let lvalue? be $expression_as_lvalue(expression_base))

        2. If ((lvalue? matches pattern (_))), then

          1. (Let ?(lvalue_base) be lvalue?)

          2. Return ?((lvalue_base [ expression_hi (+:) expression_lo ]))

        2. Else Phantom#45

  5. Case (% has type parenthesizedExpression)

    1. (Let (( expression )) be (expression'' as parenthesizedExpression))

    2. (Let lvalue'? be $expression_as_lvalue(expression))

    3. If ((lvalue'? matches pattern (_))), then

      1. (Let ?(lvalue) be lvalue'?)

      2. Return ?((( lvalue )))

    3. Else Phantom#46

1. Else Phantom#47

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:726:25-726:28:
syntax emptyStatement = 
   | ; (from emptyStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:733:1-735:39:
syntax assignop = 
   | = (from assignop)
   | += (from assignop)
   | -= (from assignop)
   | |+|= (from assignop)
   | |-|= (from assignop)
   | *= (from assignop)
   | /= (from assignop)
   | %= (from assignop)
   | <<= (from assignop)
   | >>= (from assignop)
   | &= (from assignop)
   | ^= (from assignop)
   | |= (from assignop)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:737:30-737:60:
syntax assignmentStatement = 
   | lvalue assignop expression ; (from assignmentStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:739:1-740:59:
dec $assignop_as_binop(assignop)

1. Case analysis on assignop

  1. Case (% matches pattern `+=`)

    1. Return ?((+))

  2. Case (% matches pattern `-=`)

    1. Return ?((-))

  3. Case (% matches pattern `|+|=`)

    1. Return ?((|+|))

  4. Case (% matches pattern `|-|=`)

    1. Return ?((|-|))

  5. Case (% matches pattern `*=`)

    1. Return ?((*))

  6. Case (% matches pattern `/=`)

    1. Return ?((/))

  7. Case (% matches pattern `%=`)

    1. Return ?((%))

  8. Case (% matches pattern `<<=`)

    1. Return ?((<<))

  9. Case (% matches pattern `>>=`)

    1. Return ?((>>))

  10. Case (% matches pattern `&=`)

    1. Return ?((&))

  11. Case (% matches pattern `^=`)

    1. Return ?((^))

  12. Case (% matches pattern `|=`)

    1. Return ?((|))

2. Otherwise

  1. Return ?()

