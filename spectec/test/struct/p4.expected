;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:569:1-571:23:
dec $cast_op(typeIR, value)

1. Case analysis on value

  1. Case (% has type boolValue)

    1. (Let boolValue be (value as boolValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_bool(typeIR_unroll, boolValue)

  2. Case (% has type integerValue)

    1. (Let integerValue be (value as integerValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_int(typeIR_unroll, integerValue)

  3. Case (% has type errorValue)

    1. (Let errorValue be (value as errorValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_error(typeIR_unroll, errorValue)

  4. Case (% has type matchKindValue)

    1. (Let (match_kind . nameIR) be (value as matchKindValue))

    2. If ((((match_kind) as typeIR) = $unroll_typeIR(typeIR))), then

      1. Return ((match_kind . nameIR) as value)

    2. Else Phantom#410

  5. Case (% has type stringValue)

    1. (Let stringValue be (value as stringValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_string(typeIR_unroll, stringValue)

  6. Case (% has type listValue)

    1. (Let listValue be (value as listValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_list(typeIR_unroll, listValue)

  7. Case (% has type tupleValue)

    1. (Let tupleValue be (value as tupleValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_tuple(typeIR_unroll, tupleValue)

  8. Case (% has type arrayValue)

    1. (Let arrayValue be (value as arrayValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_array(typeIR_unroll, arrayValue)

  9. Case (% has type headerStackValue)

    1. (Let headerStackValue be (value as headerStackValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_header_stack(typeIR_unroll, headerStackValue)

  10. Case (% has type structValue)

    1. (Let structValue be (value as structValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_struct(typeIR_unroll, structValue)

  11. Case (% has type headerValue)

    1. (Let headerValue be (value as headerValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_header(typeIR_unroll, headerValue)

  12. Case (% has type headerUnionValue)

    1. (Let headerUnionValue be (value as headerUnionValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_header_union(typeIR_unroll, headerUnionValue)

  13. Case (% has type enumValue)

    1. (Let enumValue be (value as enumValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_enum(typeIR_unroll, enumValue)

  14. Case (% has type sequenceValue)

    1. (Let sequenceValue be (value as sequenceValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_sequence(typeIR_unroll, sequenceValue)

  15. Case (% has type recordValue)

    1. (Let recordValue be (value as recordValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_record(typeIR_unroll, recordValue)

  16. Case (% has type defaultValue)

    1. (Let defaultValue be (value as defaultValue))

    2. If ((defaultValue matches pattern `DEFAULT`)), then

      1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

      2. Return $cast_default(typeIR_unroll, (default))

    2. Else Phantom#411

  17. Case (% has type invalidHeaderValue)

    1. (Let invalidHeaderValue be (value as invalidHeaderValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_invalid_header(typeIR_unroll)

  18. Case (% has type setValue)

    1. (Let setValue be (value as setValue))

    2. (Let typeIR_unroll be $unroll_typeIR(typeIR))

    3. Return $cast_set(typeIR_unroll, setValue)

1. Else Phantom#412

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:573:1-574:49:
dec $default(typeIR'')

1. Case analysis on typeIR''

  1. Case (% has type boolTypeIR)

    1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

    2. If ((boolTypeIR matches pattern `BOOL`)), then

      1. Return ((false) as value)

    2. Else Phantom#413

  2. Case (% has type errorTypeIR)

    1. (Let errorTypeIR be (typeIR'' as errorTypeIR))

    2. If ((errorTypeIR matches pattern `ERROR`)), then

      1. Return ((error . "NoError") as value)

    2. Else Phantom#414

  3. Case (% has type stringTypeIR)

    1. (Let stringTypeIR be (typeIR'' as stringTypeIR))

    2. If ((stringTypeIR matches pattern `STRING`)), then

      1. (Let text_empty be "")

      2. Return ((" text_empty ") as value)

    2. Else Phantom#415

  4. Case (% has type intTypeIR)

    1. (Let intTypeIR be (typeIR'' as intTypeIR))

    2. If ((intTypeIR matches pattern `INT`)), then

      1. Return ((d (0 as int)) as value)

    2. Else Phantom#416

  5. Case (% has type fixedBitTypeIR)

    1. (Let (bit < w >) be (typeIR'' as fixedBitTypeIR))

    2. Return ((w w (0 as int)) as value)

  6. Case (% has type fixedIntTypeIR)

    1. (Let (int < w >) be (typeIR'' as fixedIntTypeIR))

    2. Return ((w s (0 as int)) as value)

  7. Case (% has type varBitTypeIR)

    1. (Let (varbit < w >) be (typeIR'' as varBitTypeIR))

    2. Return ((w . 0 v (0 as int)) as value)

  8. Case (% has type typedefTypeIR)

    1. (Let (typedef _typeId typeIR) be (typeIR'' as typedefTypeIR))

    2. Return $default(typeIR)

  9. Case (% has type newTypeIR)

    1. (Let (type _typeId typeIR) be (typeIR'' as newTypeIR))

    2. Return $default(typeIR)

  10. Case (% has type tupleTypeIR)

    1. (Let (tuple < typeIR* >) be (typeIR'' as tupleTypeIR))

    2. Return ((tuple ( $default(typeIR)* )) as value)

  11. Case (% has type arrayTypeIR)

    1. (Let (array typeIR [ n_s ]) be (typeIR'' as arrayTypeIR))

    2. (Let value* be $repeat_<value>($default(typeIR), n_s))

    3. Return ((array [ value* ]) as value)

  12. Case (% has type headerStackTypeIR)

    1. (Let (header_stack typeIR [ n_s ]) be (typeIR'' as headerStackTypeIR))

    2. (Let value* be $repeat_<value>($default(typeIR), n_s))

    3. Return ((header_stack [ value* ( 0 ) ]) as value)

  13. Case (% has type structTypeIR)

    1. (Let (struct typeId < _typeArgumentIR* > { (_annotationList typeIR_f id_f ;)* }) be (typeIR'' as structTypeIR))

    2. Return ((struct typeId { ($default(typeIR_f) id_f ;)* }) as value)

  14. Case (% has type headerTypeIR)

    1. (Let (header typeId < _typeArgumentIR* > { (_annotationList typeIR_f id_f ;)* }) be (typeIR'' as headerTypeIR))

    2. Return ((header typeId { false ; ($default(typeIR_f) id_f ;)* }) as value)

  15. Case (% has type headerUnionTypeIR)

    1. (Let (header_union typeId < _typeArgumentIR* > { (_annotationList typeIR_f id_f ;)* }) be (typeIR'' as headerUnionTypeIR))

    2. Return ((header_union typeId { ($default(typeIR_f) id_f ;)* }) as value)

  16. Case (% has type simpleEnumTypeIR)

    1. (Let (enum typeId { id* }) be (typeIR'' as simpleEnumTypeIR))

    2. If ((id* matches pattern _ :: _)), then

      1. (Let id_f_h :: _id* be id*)

      2. Return ((typeId . id_f_h) as value)

    2. Else Phantom#417

  17. Case (% has type serializableEnumTypeIR)

    1. (Let (enum typeId < typeIR > { (nameIR_field = value_field ;)* }) be (typeIR'' as serializableEnumTypeIR))

    2. (Let value_zero be $cast_int(typeIR, ((d (0 as int)) as integerValue)))

    3. (Let id? be $assoc_<value, id>(value_zero, (value_field, nameIR_field)*))

    4. If ((id? matches pattern (_))), then

      1. (Let ?(id_zero) be id?)

      2. Return ((typeId . id_zero . value_zero) as value)

    4. Else Phantom#418

    5. If ((?() = $assoc_<value, id>(value_zero, (value_field, nameIR_field)*))), then

      1. (Let id_zero be "__UNSPECIFIED")

      2. Return ((typeId . id_zero . value_zero) as value)

    5. Else Phantom#419

1. Else Phantom#420

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:578:1-579:45:
dec $cast_to_enum(enumTypeIR, value)

1. If ((enumTypeIR has type serializableEnumTypeIR)), then

  1. (Let (enum typeId < typeIR > { valueFieldIR* }) be (enumTypeIR as serializableEnumTypeIR))

  2. Return $cast_to_enum'(typeId, typeIR, valueFieldIR*, value)

1. Else Phantom#421

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:580:1-580:65:
dec $cast_to_enum'(typeId, typeIR, valueFieldIR*, value_target)

1. Case analysis on valueFieldIR*

  1. Case (% matches pattern [])

    1. (Let value_idx be $cast_op(typeIR, value_target))

    2. (Let id_unnamed be "__UNSPECIFIED")

    3. Return ((typeId . id_unnamed . value_idx) as value)

  2. Case (% matches pattern _ :: _)

    1. (Let valueFieldIR_h :: valueFieldIR_t* be valueFieldIR*)

    2. (Let (nameIR = value ;) be valueFieldIR_h)

    3. Case analysis on $bin_eq(value, value_target)

      1. Case true

        1. Return ((typeId . nameIR . value) as value)

      2. Case false

        1. Return $cast_to_enum'(typeId, typeIR, valueFieldIR_t*, value_target)

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:602:1-604:23:
dec $cast_bool(typeIR'', boolValue')

1. (Let (b) be boolValue')

2. If ((typeIR'' has type boolTypeIR)), then

  1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

  2. If ((boolTypeIR matches pattern `BOOL`)), then

    1. Return ((b) as value)

  2. Else Phantom#422

2. Else Phantom#423

3. Case analysis on typeIR''

  1. Case (% has type fixedBitTypeIR)

    1. (Let (bit < w >) be (typeIR'' as fixedBitTypeIR))

    2. If ((boolValue' = (true))), then

      1. Return ((w w (1 as int)) as value)

    2. Else Phantom#424

    3. If ((boolValue' = (false))), then

      1. Return ((w w (0 as int)) as value)

    3. Else Phantom#425

  2. Case (% has type newTypeIR)

    1. (Let (type _typeId typeIR) be (typeIR'' as newTypeIR))

    2. Return $cast_op(typeIR, (boolValue' as value))

  3. Case (% has type setTypeIR)

    1. (Let (set < typeIR >) be (typeIR'' as setTypeIR))

    2. Return ((set { $cast_op(typeIR, (boolValue' as value)) }) as value)

3. Else Phantom#426

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:617:1-619:23:
dec $cast_int(typeIR'', integerValue)

1. Case analysis on typeIR''

  1. Case (% has type boolTypeIR)

    1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

    2. If ((boolTypeIR matches pattern `BOOL`)), then

      1. If ((integerValue has type integerLiteral)), then

        1. (Let integerLiteral be (integerValue as integerLiteral))

        2. Case analysis on integerLiteral

          1. Case (% matches pattern `D %`)

            1. (Let (d i) be integerLiteral)

            2. Return (((i =/= (0 as int))) as value)

          2. Case (% matches pattern `% W %`)

            1. (Let (w w i) be integerLiteral)

            2. Return (((i =/= (0 as int))) as value)

        2. Else Phantom#427

