;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:287:1-291:21:
relation ParserState_ok: TC_0, nameIR_state*, parserState

1. (Let (annotationList state name { parserBlockElementStatementList transitionStatement }) be parserState)

2. (Let nameIR be $name(name))

3. (Let TC_1 be $enter_t(TC_0))

4. (ParserBlockElementStmtList_ok: TC_1 |- parserBlockElementStatementList : TC_2 parserBlockElementStatementIR*)

5. (ParserTransition_ok: TC_2 nameIR_state* |- transitionStatement : transitionStatementIR)

6. (Let TC_3 be $exit_t(TC_2))

7. (Let parserStateIR be (annotationList state nameIR { parserBlockElementStatementIR* transitionStatementIR }))

8. Result in parserStateIR

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:293:1-297:21:
relation ParserStateList_ok: TC, parserStateList

1. (Let parserState* be $flatten_parserStateList(parserStateList))

2. (Let (_annotationList state name_state { _parserBlockElementStatementList _transitionStatement }) be parserState)*

3. (Let nameIR_state be $name(name_state))*

4. If ($distinct_<nameIR>(nameIR_state*)), then

  1. If ("start" is in nameIR_state*), then

    1. If ((~"accept" is in nameIR_state* /\ ~"reject" is in nameIR_state*)), then

      1. (Let nameIR_state_impl* be "accept" :: "reject" :: nameIR_state*)

      2. (ParserState_ok: TC nameIR_state_impl* |- parserState : parserStateIR)*

      3. Result in parserStateIR*

    1. Else Phantom#1451

  1. Else Phantom#1452

4. Else Phantom#1453

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:299:1-304:40:
relation ParserLocalDecl_ok: TC_0, parserLocalDeclaration

1. Case analysis on parserLocalDeclaration

  1. Case (% has type constantDeclaration)

    1. (Let constantDeclaration be (parserLocalDeclaration as constantDeclaration))

    2. (ConstDecl_ok: (block) TC_0 |- constantDeclaration : TC_1 constantDeclarationIR)

    3. Result in TC_1, (constantDeclarationIR as parserLocalDeclarationIR)

  2. Case (% has type instantiation)

    1. (Let instantiation be (parserLocalDeclaration as instantiation))

    2. (InstDecl_ok: (block) TC_0 |- instantiation : TC_1 instantiationIR)

    3. Result in TC_1, (instantiationIR as parserLocalDeclarationIR)

  3. Case (% has type variableDeclaration)

    1. (Let variableDeclaration be (parserLocalDeclaration as variableDeclaration))

    2. (VarDecl_ok: (block) TC_0 |- variableDeclaration : TC_1 variableDeclarationIR)

    3. Result in TC_1, (variableDeclarationIR as parserLocalDeclarationIR)

  4. Case (% has type valueSetDeclaration)

    1. (Let (annotationList value_set < valueSetType > ( expression ) name ;) be (parserLocalDeclaration as valueSetDeclaration))

    2. (Type_ok: (block) TC_0 |- (valueSetType as typeOrVoid) : typeIR # typeId*)

    3. If ((typeId* matches pattern [])), then

      1. If (Type_wf: $bound((block), TC_0) |- ((set < typeIR >) as typeIR) holds), then

        1. (Expr_ok: (block) TC_0 |- expression : typedExpressionIR)

        2. If (((dyn) =/= $ctk_of_typedExpressionIR(typedExpressionIR))), then

          1. (Let nameIR be $name(name))

          2. (Let varTypeIR be (() ((set < typeIR >) as typeIR) (ctk) ?()))

          3. (Let TC_1 be $add_var_t((block), TC_0, nameIR, varTypeIR))

          4. (Let valueSetDeclarationIR be (annotationList value_set < typeIR > ( typedExpressionIR ) nameIR ;))

          5. Result in TC_1, (valueSetDeclarationIR as parserLocalDeclarationIR)

        2. Else Phantom#1454

      1. Else Phantom#1455

    3. Else Phantom#1456

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:306:1-311:40:
relation ParserLocalDeclList_ok: TC_0, parserLocalDeclarationList

1. (Let parserLocalDeclaration* be $flatten_parserLocalDeclarationList(parserLocalDeclarationList))

2. (ParserLocalDecls_ok: TC_0 |- parserLocalDeclaration* : TC_1 parserLocalDeclarationIR*)

3. Result in TC_1, parserLocalDeclarationIR*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:317:1-321:46:
relation TableKey_ok: TC, TBLC_0, (expression : name_matchkind annotationList ;)

1. (Expr_ok: (local) TC |- expression : typedExpressionIR)

2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

3. If (Type_wf: $bound((local), TC) |- ((set < typeIR >) as typeIR) holds), then

  1. (Let nameIR_default be $strip_all_whitespace($name_expression(expression)))

  2. (Let nameIR_key be $name_annotation_default(annotationList, nameIR_default))

  3. (Let nameIR_matchkind be $name(name_matchkind))

  4. If ((((match_kind . nameIR_matchkind) as value) = $find_var_value_t((nameIR_matchkind), (local), TC))), then

    1. If ($compat_table_key(nameIR_matchkind, typeIR)), then

      1. (Let TBLC_1 be $add_key_tbl(TBLC_0, nameIR_matchkind, typeIR))

      2. (Let tableKeyIR be (typedExpressionIR # nameIR_key : nameIR_matchkind annotationList ;))

      3. Result in TBLC_1, tableKeyIR

    1. Else Phantom#1457

  4. Else Phantom#1458

3. Else Phantom#1459

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:323:1-327:46:
relation TableKeys_ok: TC, TBLC', tableKey*

1. Case analysis on tableKey*

  1. Case (% matches pattern [])

    1. Result in TBLC', []

  2. Case (% matches pattern _ :: _)

    1. (Let tableKey_h :: tableKey_t* be tableKey*)

    2. (TableKey_ok: TC TBLC' |- tableKey_h : TBLC_1 tableKeyIR_h)

    3. (TableKeys_ok: TC TBLC_1 |- tableKey_t* : TBLC_2 tableKeyIR_t*)

    4. Result in TBLC_2, tableKeyIR_h :: tableKeyIR_t*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:329:1-335:34:
relation Call_action_partial_ok: TC, parameterIR*, argumentIR*

1. (Let (parameterIR_data*, parameterIR_control*) be $split_dataplane_parameters(parameterIR*))

2. If ((|parameterIR_data*| = |argumentIR*|)), then

  1. (Let typedExpressionIR_sub* be $subexpressions_of_argumentListIR(argumentIR*))

  2. If ($forall_(~$is_table_application(typedExpressionIR_sub)*)), then

    1. (Call_convention_ok: (local) TC (action) |- parameterIR_data* @ argumentIR* : argumentIR_cast*)

    2. Result in parameterIR_data*, parameterIR_control*, argumentIR_cast*

  2. Else Phantom#1460

2. Else Phantom#1461

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:337:1-341:46:
relation TableAction_ok: TC, TBLC_0, (annotationList tableActionReference ;)

1. If ((tableActionReference has type prefixedNonTypeName)), then

  1. (Let prefixedNonTypeName be (tableActionReference as prefixedNonTypeName))

  2. (Let prefixedNameIR be $prefixedNonTypeName(prefixedNonTypeName))

  3. (Let (callableId, callableTypeDefIR)? be $find_callableDef_non_overloaded_t((local), TC, prefixedNameIR))

  4. If (((callableId, callableTypeDefIR)? matches pattern (_))), then

    1. (Let ?((_callableId, callableTypeDefIR)) be (callableId, callableTypeDefIR)?)

    2. If ((callableTypeDefIR has type actionTypeIR)), then

      1. (Let (annotationList_action action _nameIR ( parameterIR* )) be (callableTypeDefIR as actionTypeIR))

      2. (Let annotation_name? be $find_name_annotation_opt(annotationList_action))

      3. (Let annotationList_update be $add_annotationList(annotationList, annotation_name?))

      4. (Call_action_partial_ok: TC |- parameterIR* @ [] : parameterIR_data* , parameterIR_control* @ argumentIR*)

      5. If ((argumentIR* matches pattern [])), then

        1. (Let TBLC_1 be $add_action_tbl(TBLC_0, prefixedNameIR, parameterIR*, []))

        2. (Let tableActionIR be (annotationList_update (prefixedNameIR ?() ( [] )) # ( parameterIR_data* , parameterIR_control* ) ;))

        3. Result in TBLC_1, tableActionIR

      5. Else Phantom#1462

    2. Else Phantom#1463

  4. Else Phantom#1464

1. Else Phantom#1465

2. If ((tableActionReference matches pattern `% (%)`)), then

  1. (Let (prefixedNonTypeName ( argumentList )) be tableActionReference)

  2. (Let prefixedNameIR be $prefixedNonTypeName(prefixedNonTypeName))

  3. (Let (callableId, callableTypeDefIR)? be $find_callableDef_non_overloaded_t((local), TC, prefixedNameIR))

  4. If (((callableId, callableTypeDefIR)? matches pattern (_))), then

    1. (Let ?((_callableId, callableTypeDefIR)) be (callableId, callableTypeDefIR)?)

    2. If ((callableTypeDefIR has type actionTypeIR)), then

      1. (Let (annotationList_action action _nameIR ( parameterIR* )) be (callableTypeDefIR as actionTypeIR))

      2. (Let annotation_name? be $find_name_annotation_opt(annotationList_action))

      3. (Let annotationList_update be $add_annotationList(annotationList, annotation_name?))

      4. (ArgumentList_ok: (local) TC |- argumentList : argumentIR*)

      5. (Call_action_partial_ok: TC |- parameterIR* @ argumentIR* : parameterIR_data* , parameterIR_control* @ argumentIR_cast*)

      6. (Let TBLC_1 be $add_action_tbl(TBLC_0, prefixedNameIR, parameterIR*, argumentIR_cast*))

      7. (Let tableActionIR be (annotationList_update (prefixedNameIR ?() ( argumentIR_cast* )) # ( parameterIR_data* , parameterIR_control* ) ;))

      8. Result in TBLC_1, tableActionIR

    2. Else Phantom#1466

  4. Else Phantom#1467

2. Else Phantom#1468

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:343:1-347:46:
relation TableActions_ok: TC, TBLC', tableAction*

