    1. Return true

2. Otherwise

  1. Return false

;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:975:1-978:37:
dec $insert_NoAction_tablePropertyIR(TBLC', tablePropertyIR*)

