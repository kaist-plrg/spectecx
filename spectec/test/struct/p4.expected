;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:375:1-379:21:
relation TableEntry_priority_ok: TC, tableEntryPriority

1. Case analysis on tableEntryPriority

  1. Case (% matches pattern `PRIORITY = % :`)

    1. (Let (priority = integerLiteral :) be tableEntryPriority)

    2. Result in (priority = integerLiteral :)

  2. Case (% matches pattern `PRIORITY = (%) :`)

    1. (Let (priority = ( expression ) :) be tableEntryPriority)

    2. (Expr_ok: (local) TC |- expression : typedExpressionIR)

    3. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR))), then

      1. (Expr_eval_lctk: (local) TC |- typedExpressionIR ~> value)

      2. If ((value has type integerValue)), then

        1. (Let integerValue be (value as integerValue))

        2. (Let nat? be $nat_of_integerValue(integerValue))

        3. If ((nat? matches pattern (_))), then

          1. (Let ?(n) be nat?)

          2. Result in (priority = (d (n as int)) :)

        3. Else Phantom#1503

      2. Else Phantom#1504

    3. Else Phantom#1505

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:381:1-385:50:
relation TableEntry_ok: TC, TBLC, tableEntry

1. Case analysis on tableEntry

  1. Case (% matches pattern `% % % : % % ;`)

    1. (Let (constOpt tableEntryPriority keysetExpression : tableActionReference annotationList ;) be tableEntry)

    2. (TableEntry_keyset_ok: TC TBLC |- keysetExpression : TBLS keysetExpressionIR)

    3. (TableEntry_action_ok: TC TBLC |- tableActionReference : tableActionReferenceIR)

    4. (TableEntry_priority_ok: TC |- tableEntryPriority : tableEntryPriorityIR)

    5. (Let constOptIR be $flatten_constOpt(constOpt))

    6. (Let tableEntryIR be (constOptIR ?(tableEntryPriorityIR) keysetExpressionIR : tableActionReferenceIR annotationList ;))

    7. Result in TBLS, tableEntryIR

  2. Case (% matches pattern `% % : % % ;`)

    1. (Let (constOpt keysetExpression : tableActionReference annotationList ;) be tableEntry)

    2. (TableEntry_keyset_ok: TC TBLC |- keysetExpression : TBLS keysetExpressionIR)

    3. (TableEntry_action_ok: TC TBLC |- tableActionReference : tableActionReferenceIR)

    4. (Let constOptIR be $flatten_constOpt(constOpt))

    5. (Let tableEntryPriorityOptIR be ?())

    6. (Let tableEntryIR be (constOptIR tableEntryPriorityOptIR keysetExpressionIR : tableActionReferenceIR annotationList ;))

    7. Result in TBLS, tableEntryIR

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:387:1-391:46:
relation TableProperty_ok: TC, TBLC_0', tableProperty

1. Case analysis on tableProperty

  1. Case (% matches pattern `KEY = {%}`)

    1. (Let (key = { tableKeyList }) be tableProperty)

    2. (Let tableKey* be $flatten_tableKeyList(tableKeyList))

    3. (TableKeys_ok: TC TBLC_0' |- tableKey* : TBLC_1 tableKeyIR*)

    4. (Let TBLC_2 be $update_mode_tbl(TBLC_1, tableKeyIR*))

    5. Result in TBLC_2, ((key = { tableKeyIR* }) as tablePropertyIR)

  2. Case (% matches pattern `ACTIONS = {%}`)

    1. (Let (actions = { tableActionList }) be tableProperty)

    2. (Let tableAction* be $flatten_tableActionList(tableActionList))

    3. (TableActions_ok: TC TBLC_0' |- tableAction* : TBLC_1 tableActionIR*)

    4. Result in TBLC_1, ((actions = { tableActionIR* }) as tablePropertyIR)

  3. Case (% matches pattern `% % ENTRIES = {%}`)

    1. (Let (annotationList constOpt entries = { tableEntryList }) be tableProperty)

    2. (Let tableEntry* be $flatten_tableEntryList(tableEntryList))

    3. If (((|TBLC_0'.keys| = 0) => (|tableEntry*| = 0))), then

      1. (Let TBLC_1 be TBLC_0'[entries.size = |tableEntry*|])

      2. (Let constOptIR be $flatten_constOpt(constOpt))

      3. (Let TBLC_2 be TBLC_1[entries.const = (constOptIR = ?((const)))])

      4. (TableEntry_ok: TC TBLC_2 |- tableEntry : TBLS tableEntryIR)*

      5. (Let tableEntryIR_pri* be $set_priorities_of_tableEntryListIR(TBLC_2, TBLS*, tableEntryIR*))

      6. Result in TBLC_2, ((annotationList constOptIR entries = { tableEntryIR_pri* }) as tablePropertyIR)

    3. Else Phantom#1506

  4. Case (% matches pattern `% % % % ;`)

    1. (Let (annotationList constOpt tableCustomName initializer ;) be tableProperty)

    2. If (("default_action" = $tableCustomName(tableCustomName))), then

      1. (TableDefaultAction_ok: TC TBLC_0' |- initializer : tableActionReferenceIR)

      2. (Let constOptIR be $flatten_constOpt(constOpt))

      3. (Let tablePropertyIR be ((annotationList constOptIR default_action = tableActionReferenceIR ;) as tablePropertyIR))

      4. Result in TBLC_0', tablePropertyIR

    2. Else Phantom#1507

    3. (Let (annotationList constOpt tableCustomName (= expression) ;) be tableProperty)

    4. If (("largest_priority_wins" = $tableCustomName(tableCustomName))), then

      1. (Expr_ok: (local) TC |- expression : typedExpressionIR)

      2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

      3. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR))), then

        1. If ((((bool) as typeIR) = $unroll_typeIR(typeIR))), then

          1. (Expr_eval_lctk: (local) TC |- typedExpressionIR ~> value)

          2. If ((value has type boolValue)), then

            1. (Let (b_lw) be (value as boolValue))

            2. (Let TBLC_1 be TBLC_0'[priorities.largest_wins = b_lw])

            3. (Let constOptIR be $flatten_constOpt(constOpt))

            4. (Let tablePropertyIR be ((annotationList constOptIR custom_const "largest_priority_wins" (= ((b_lw) as value)) ;) as tablePropertyIR))

            5. Result in TBLC_1, tablePropertyIR

          2. Else Phantom#1508

        1. Else Phantom#1509

      3. Else Phantom#1510

    4. Else Phantom#1511

    5. If (("priority_delta" = $tableCustomName(tableCustomName))), then

      1. (Expr_ok: (local) TC |- expression : typedExpressionIR)

      2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

      3. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR))), then

        1. (Let typeIR_unroll be $unroll_typeIR(typeIR))

        2. If (((typeIR_unroll has type integerTypeIR) /\ ~(typeIR_unroll has type varBitTypeIR))), then

          1. (Expr_eval_lctk: (local) TC |- typedExpressionIR ~> value)

          2. If ((value has type integerValue)), then

            1. (Let integerValue be (value as integerValue))

            2. (Let nat? be $nat_of_integerValue(integerValue))

            3. If ((nat? matches pattern (_))), then

              1. (Let ?(n_delta) be nat?)

              2. If ((n_delta > 0)), then

                1. (Let TBLC_1 be TBLC_0'[priorities.delta = n_delta])

                2. (Let constOptIR be $flatten_constOpt(constOpt))

                3. (Let tablePropertyIR be ((annotationList constOptIR custom_const "priority_delta" (= ((d (n_delta as int)) as value)) ;) as tablePropertyIR))

                4. Result in TBLC_1, tablePropertyIR

              2. Else Phantom#1512

            3. Else Phantom#1513

          2. Else Phantom#1514

        2. Else Phantom#1515

      3. Else Phantom#1516

    5. Else Phantom#1517

    6. If (("size" = $tableCustomName(tableCustomName))), then

      1. (Expr_ok: (local) TC |- expression : typedExpressionIR)

      2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

      3. (Let typeIR_unroll be $unroll_typeIR(typeIR))

      4. If (((typeIR_unroll has type integerTypeIR) /\ ~(typeIR_unroll has type varBitTypeIR))), then

        1. If (((dyn) =/= $ctk_of_typedExpressionIR(typedExpressionIR))), then

          1. (Let constOptIR be $flatten_constOpt(constOpt))

          2. (Let tablePropertyIR be ((annotationList constOptIR custom "size" (= typedExpressionIR) ;) as tablePropertyIR))

          3. Result in TBLC_0', tablePropertyIR

        1. Else Phantom#1518

      4. Else Phantom#1519

    6. Else Phantom#1520

    7. (Let nameIR be $tableCustomName(tableCustomName))

    8. If (((((nameIR =/= "default_action") /\ (nameIR =/= "size")) /\ (nameIR =/= "largest_priority_wins")) /\ (nameIR =/= "priority_delta"))), then

      1. (Expr_ok: (local) TC |- expression : typedExpressionIR)

      2. (Let constOptIR be $flatten_constOpt(constOpt))

      3. (Let tablePropertyIR be ((annotationList constOptIR custom nameIR (= typedExpressionIR) ;) as tablePropertyIR))

      4. Result in TBLC_0', tablePropertyIR

    8. Else Phantom#1521

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:393:1-397:46:
relation TableProperties_ok: TC, TBLC', tableProperty*

1. Case analysis on tableProperty*

  1. Case (% matches pattern [])

    1. Result in TBLC', []

  2. Case (% matches pattern _ :: _)

    1. (Let tableProperty_h :: tableProperty_t* be tableProperty*)

    2. (TableProperty_ok: TC TBLC' |- tableProperty_h : TBLC_1 tablePropertyIR_h)

    3. (TableProperties_ok: TC TBLC_1 |- tableProperty_t* : TBLC_2 tablePropertyIR_t*)

    4. Result in TBLC_2, tablePropertyIR_h :: tablePropertyIR_t*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:399:1-403:40:
relation Table_ok: TC, tableProperty*

1. If ((|$filter_<tableProperty>(tableProperty*, $is_tableKeysProperty(tableProperty)*)| <= 1)), then

  1. If ((|$filter_<tableProperty>(tableProperty*, $is_tableActionsProperty(tableProperty)*)| = 1)), then

    1. Case analysis on |$filter_<tableProperty>(tableProperty*, $is_tableDefaultActionProperty(tableProperty)*)|

      1. Case (% = 0)

        1. If ((|$filter_<tableProperty>(tableProperty*, $is_tableLargestPriorityWinsProperty(tableProperty)*)| <= 1)), then

          1. (Let TBLC_0 be $empty_tableContext)

          2. (TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*)

          3. (Let (callableId, callableTypeDefIR)? be $find_callableDef_non_overloaded_t((local), TC, (. "NoAction")))

          4. If (((callableId, callableTypeDefIR)? matches pattern (_))), then

            1. (Let ?((_callableId, callableTypeDefIR)) be (callableId, callableTypeDefIR)?)

            2. If ((callableTypeDefIR has type actionTypeIR)), then

              1. (Let (_annotationList action _nameIR ( parameterIR* )) be (callableTypeDefIR as actionTypeIR))

              2. If ((parameterIR* matches pattern [])), then

                1. (Let tablePropertyIR_default_action be ((() ?() default_action = (("NoAction") ?() ( [] )) ;) as tablePropertyIR))

                2. (Let (TBLC_2, tablePropertyIR_updated*) be $insert_NoAction_tablePropertyIR(TBLC_1, tablePropertyIR*))

                3. Result in TBLC_2, tablePropertyIR_updated* ++ [tablePropertyIR_default_action]

              2. Else Phantom#1522

            2. Else Phantom#1523

          4. Else Phantom#1524

        1. Else Phantom#1525

      2. Case (% = 1)

        1. If ((|$filter_<tableProperty>(tableProperty*, $is_tableLargestPriorityWinsProperty(tableProperty)*)| <= 1)), then

          1. (Let TBLC_0 be $empty_tableContext)

          2. (TableProperties_ok: TC TBLC_0 |- tableProperty* : TBLC_1 tablePropertyIR*)

          3. Result in TBLC_1, tablePropertyIR*

        1. Else Phantom#1526

    1. Else Phantom#1527

  1. Else Phantom#1528

1. Else Phantom#1529

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:405:1-409:54:
relation TableType_ok: TC_0, TBLC, name

1. (Let nameIR be $name(name))

2. (Let typeId_enum be "action_list(" ++ nameIR ++ ")")

3. (Let (prefixedNameIR_action ( _parameterIR* @ _argumentListIR ))* be TBLC.actions)

4. (Let nameIR_enum_field be $flatten_prefixedNameIR(prefixedNameIR_action))*

5. (Let tableMetadataEnumTypeIR be (table_enum typeId_enum { nameIR_enum_field* }))

6. (Let value_enum_field be ((table_enum typeId_enum . nameIR_enum_field) as value))*

7. (Let varTypeIR_enum_field be (() (tableMetadataEnumTypeIR as typeIR) (lctk) ?(value_enum_field)))*

8. (Let TC_1 be $add_vars_t((block), TC_0, typeId_enum ++ "." ++ nameIR_enum_field*, varTypeIR_enum_field*))

9. (Let typeId_struct be "apply_result(" ++ nameIR ++ ")")

10. (Let tableMetadataStructTypeIR be (table_struct typeId_struct { hit (bool) ; miss (bool) ; action_run tableMetadataEnumTypeIR ; }))

11. (Let typeIR_table be ((table nameIR { tableMetadataStructTypeIR }) as typeIR))

12. Result in TC_1, typeIR_table

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:411:1-416:40:
relation ControlLocalDecl_ok: TC_0, controlLocalDeclaration

1. Case analysis on controlLocalDeclaration

  1. Case (% has type constantDeclaration)

    1. (Let constantDeclaration be (controlLocalDeclaration as constantDeclaration))

    2. (ConstDecl_ok: (block) TC_0 |- constantDeclaration : TC_1 constantDeclarationIR)

    3. Result in TC_1, (constantDeclarationIR as controlLocalDeclarationIR)

  2. Case (% has type instantiation)

    1. (Let instantiation be (controlLocalDeclaration as instantiation))

    2. (InstDecl_ok: (block) TC_0 |- instantiation : TC_1 instantiationIR)

    3. Result in TC_1, (instantiationIR as controlLocalDeclarationIR)

  3. Case (% has type variableDeclaration)

    1. (Let variableDeclaration be (controlLocalDeclaration as variableDeclaration))

    2. (VarDecl_ok: (block) TC_0 |- variableDeclaration : TC_1 variableDeclarationIR)

    3. Result in TC_1, (variableDeclarationIR as controlLocalDeclarationIR)

  4. Case (% has type actionDeclaration)

    1. (Let actionDeclaration be (controlLocalDeclaration as actionDeclaration))

    2. (ActionDecl_ok: (block) TC_0 |- actionDeclaration : TC_1 actionDeclarationIR)

    3. Result in TC_1, (actionDeclarationIR as controlLocalDeclarationIR)

  5. Case (% has type tableDeclaration)

    1. (Let (annotationList table name { tablePropertyList }) be (controlLocalDeclaration as tableDeclaration))

    2. If ($has_at_most_one_name_annotation(annotationList)), then

      1. (Let TC_1 be TC_0[local.kind = ((table_apply_method) as localKind)])

      2. (Let tableProperty* be $flatten_tablePropertyList(tablePropertyList))

      3. (Table_ok: TC_1 |- tableProperty* : TBLC tablePropertyIR*)

      4. (Let nameIR be $name(name))

      5. (TableType_ok: TC_1 TBLC |- name : TC_2 typeIR_table)

      6. (Let varTypeIR be (() typeIR_table (dyn) ?()))

      7. (Let TC_3 be $add_var_t((block), TC_2, nameIR, varTypeIR))

      8. (Let tableDeclarationIR be (annotationList table typeIR_table nameIR { tablePropertyIR* }))

      9. Result in TC_3, (tableDeclarationIR as controlLocalDeclarationIR)

    2. Else Phantom#1530

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:418:1-423:40:
relation ControlLocalDeclList_ok: TC_0, controlLocalDeclarationList

1. (Let controlLocalDeclaration* be $flatten_controlLocalDeclarationList(controlLocalDeclarationList))

2. (ControlLocalDecls_ok: TC_0 |- controlLocalDeclaration* : TC_1 controlLocalDeclarationIR*)

3. Result in TC_1, controlLocalDeclarationIR*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:429:1-434:40:
relation VarDecl_ok: p, TC_0, (annotationList type name initializerOpt ;)

1. If ((initializerOpt matches pattern `_EMPTY`)), then

  1. (Type_ok: p TC_0 |- (type as typeOrVoid) : typeIR # typeId*)

  2. If ((typeId* matches pattern [])), then

    1. If (Type_wf: $bound(p, TC_0) |- typeIR holds), then

      1. If ($is_assignable_typeIR(typeIR)), then

        1. (Let nameIR be $name(name))

        2. (Let TC_1 be $add_var_t(p, TC_0, nameIR, ((inout) typeIR (dyn) ?())))

        3. (Let variableDeclarationIR be (annotationList typeIR nameIR ?() ;))

        4. Result in TC_1, variableDeclarationIR

      1. Else Phantom#1531

    1. Else Phantom#1532

  2. Else Phantom#1533

1. Else Phantom#1534

2. If ((initializerOpt has type initializer)), then

  1. (Let (= expression_init) be (initializerOpt as initializer))

  2. (Type_ok: p TC_0 |- (type as typeOrVoid) : typeIR # typeId*)

  3. If ((typeId* matches pattern [])), then

    1. If (Type_wf: $bound(p, TC_0) |- typeIR holds), then

      1. If ($is_assignable_typeIR(typeIR)), then

        1. (Expr_ok: p TC_0 |- expression_init : typedExpressionIR_init)

        2. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_init, typeIR))

        3. If ((typedExpressionIR? matches pattern (_))), then

          1. (Let ?(typedExpressionIR_init_cast) be typedExpressionIR?)

          2. (Let nameIR be $name(name))

          3. (Let TC_1 be $add_var_t(p, TC_0, nameIR, ((inout) typeIR (dyn) ?())))

          4. (Let variableDeclarationIR be (annotationList typeIR nameIR ?((= typedExpressionIR_init_cast)) ;))

          5. Result in TC_1, variableDeclarationIR

        3. Else Phantom#1535

      1. Else Phantom#1536

    1. Else Phantom#1537

  3. Else Phantom#1538

2. Else Phantom#1539

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:436:1-441:40:
relation ConstDecl_ok: p, TC_0, (annotationList const type name (= expression_value) ;)

1. (Type_ok: p TC_0 |- (type as typeOrVoid) : typeIR # typeId*)

2. If ((typeId* matches pattern [])), then

  1. If (Type_wf: $bound(p, TC_0) |- typeIR holds), then

    1. (Expr_ok: p TC_0 |- expression_value : typedExpressionIR_value)

    2. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR_value))), then

      1. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_value, typeIR))

      2. If ((typedExpressionIR? matches pattern (_))), then

        1. (Let ?(typedExpressionIR_value_cast) be typedExpressionIR?)

        2. (Expr_eval_lctk: p TC_0 |- typedExpressionIR_value_cast ~> value)

        3. (Let nameIR be $name(name))

        4. (Let TC_1 be $add_var_t(p, TC_0, nameIR, (() typeIR (lctk) ?(value))))

        5. (Let constantDeclarationIR be (annotationList const typeIR nameIR (= value) ;))

        6. Result in TC_1, constantDeclarationIR

      2. Else Phantom#1540

    2. Else Phantom#1541

  1. Else Phantom#1542

2. Else Phantom#1543

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:443:1-448:40:
relation InstDecl_ok: p, TC_0, instantiation

1. Case analysis on instantiation

  1. Case (% matches pattern `% % (%) % ;`)

    1. (Let (annotationList type ( argumentList ) name ;) be instantiation)

    2. Case analysis on type

      1. Case (% has type prefixedTypeName)

        1. (Let prefixedTypeName be (type as prefixedTypeName))

        2. (InstDecl_non_objectInitializer_ok: p TC_0 |- annotationList prefixedTypeName < () > ( argumentList ) name ; : TC_1 instantiationIR)

        3. Result in TC_1, instantiationIR

      2. Case (% has type specializedType)

        1. (Let (prefixedTypeName < typeArgumentList >) be (type as specializedType))

        2. (InstDecl_non_objectInitializer_ok: p TC_0 |- annotationList prefixedTypeName < typeArgumentList > ( argumentList ) name ; : TC_1 instantiationIR)

        3. Result in TC_1, instantiationIR

    2. Else Phantom#1544

  2. Case (% matches pattern `% % (%) % % ;`)

    1. (Let (annotationList type ( argumentList ) name (= { objectDeclarationList }) ;) be instantiation)

    2. Case analysis on type

      1. Case (% has type prefixedTypeName)

        1. (Let prefixedTypeName be (type as prefixedTypeName))

        2. (InstDecl_objectInitializer_ok: p TC_0 |- annotationList prefixedTypeName < () > ( argumentList ) name = { objectDeclarationList } ; : TC_1 instantiationIR)

        3. Result in TC_1, instantiationIR

      2. Case (% has type specializedType)

        1. (Let (prefixedTypeName < typeArgumentList >) be (type as specializedType))

        2. (InstDecl_objectInitializer_ok: p TC_0 |- annotationList prefixedTypeName < typeArgumentList > ( argumentList ) name = { objectDeclarationList } ; : TC_1 instantiationIR)

        3. Result in TC_1, instantiationIR

    2. Else Phantom#1545

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:450:1-455:40:
relation FuncDecl_ok: p, TC_0, (annotationList (typeOrVoid name typeParameterListOpt ( parameterList )) blockStatement)

1. (TypeParameterListOpt_ok: (local) TC_0 |- typeParameterListOpt : TC_1 typeId_expl*)

2. (Type_ok: (local) TC_1 |- typeOrVoid : typeIR_ret # typeId*)

3. If ((typeId* matches pattern [])), then

  1. (ParameterList_ok: (local) TC_1 |- parameterList : TC_2 parameterIR* # typeId_impl*)

  2. (Let TC_3 be TC_2[local.kind = ((function : typeIR_ret) as localKind)])

  3. (Let TC_4 be TC_3[control = (cont)][loop = (out)])

  4. (Block_ok: TC_4 |- blockStatement : TC_5 blockStatementIR)

  5. If (((TC_5.control = (ret)) \/ (typeIR_ret = ((void) as typeIR)))), then

    1. (Let callableId be $callableId(name, parameterList))

    2. (Let nameIR be $name(name))

    3. (Let definedFunctionTypeDefIR be (function nameIR < typeId_expl* , typeId_impl* > ( parameterIR* ) : typeIR_ret))

    4. If (CallableTypeDef_wf: $bound(p, TC_0) |- (definedFunctionTypeDefIR as callableTypeDefIR) holds), then

      1. (Let TC_6 be $add_callableDef_overload_t(p, TC_0, callableId, (definedFunctionTypeDefIR as callableTypeDefIR)))

      2. (Let functionDeclarationIR be (annotationList (typeIR_ret nameIR < typeId_expl* , typeId_impl* > ( parameterIR* )) blockStatementIR))

      3. Result in TC_6, functionDeclarationIR

    4. Else Phantom#1546

  5. Else Phantom#1547

3. Else Phantom#1548

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:457:1-462:40:
relation ActionDecl_ok: p, TC_0, (annotationList action name ( parameterList ) blockStatement)

1. If ($has_at_most_one_name_annotation(annotationList)), then

  1. (Let TC_1 be TC_0[local.kind = ((action) as localKind)])

  2. (Let TC_2 be TC_1[control = (cont)][loop = (out)])

  3. (ParameterList_ok: (local) TC_2 |- parameterList : TC_3 parameterIR* # typeId*)

  4. If ((typeId* matches pattern [])), then

    1. (Block_ok: TC_3 |- blockStatement : _typingContext blockStatementIR)

    2. (Let callableId be $callableId(name, parameterList))

    3. (Let nameIR be $name(name))

    4. (Let actionTypeDefIR be (annotationList action nameIR ( parameterIR* )))

    5. If (CallableTypeDef_wf: $bound(p, TC_0) |- (actionTypeDefIR as callableTypeDefIR) holds), then

      1. (Let TC_4 be $add_callableDef_non_overload_t(p, TC_0, callableId, (actionTypeDefIR as callableTypeDefIR)))

      2. (Let actionDeclarationIR be (annotationList action nameIR ( parameterIR* ) blockStatementIR))

      3. Result in TC_4, actionDeclarationIR

    5. Else Phantom#1549

  4. Else Phantom#1550

1. Else Phantom#1551

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:464:1-468:40:
relation Decl_ok: TC_0, declaration

1. Case analysis on declaration

  1. Case (% has type constantDeclaration)

    1. (Let constantDeclaration be (declaration as constantDeclaration))

    2. (ConstDecl_ok: (global) TC_0 |- constantDeclaration : TC_1 constantDeclarationIR)

    3. Result in TC_1, (constantDeclarationIR as declarationIR)

  2. Case (% has type instantiation)

    1. (Let instantiation be (declaration as instantiation))

    2. (InstDecl_ok: (global) TC_0 |- instantiation : TC_1 instantiationIR)

    3. Result in TC_1, (instantiationIR as declarationIR)

  3. Case (% has type functionDeclaration)

    1. (Let functionDeclaration be (declaration as functionDeclaration))

    2. (FuncDecl_ok: (global) TC_0 |- functionDeclaration : TC_1 functionDeclarationIR)

    3. Result in TC_1, (functionDeclarationIR as declarationIR)

  4. Case (% has type actionDeclaration)

    1. (Let actionDeclaration be (declaration as actionDeclaration))

    2. (ActionDecl_ok: (global) TC_0 |- actionDeclaration : TC_1 actionDeclarationIR)

    3. Result in TC_1, (actionDeclarationIR as declarationIR)

  5. Case (% has type errorDeclaration)

    1. (Let (error { nameList }) be (declaration as errorDeclaration))

    2. (Let name* be $flatten_nameList(nameList))

    3. (Let nameIR be $name(name))*

    4. If ($distinct_<nameIR>(nameIR*)), then

      1. (Let nameIR_error be "error." ++ nameIR)*

      2. (Let value_error be ((error . nameIR) as value))*

      3. (Let varTypeIR be (() ((error) as typeIR) (lctk) ?(value_error)))*

      4. (Let TC_1 be $add_vars_t((global), TC_0, nameIR_error*, varTypeIR*))

      5. Result in TC_1, ((error { nameIR* }) as declarationIR)

    4. Else Phantom#1552

  6. Case (% has type matchKindDeclaration)

    1. (Let (match_kind { nameList _trailingCommaOpt }) be (declaration as matchKindDeclaration))

    2. (Let name* be $flatten_nameList(nameList))

    3. (Let nameIR be $name(name))*

    4. If ($distinct_<nameIR>(nameIR*)), then

      1. (Let value_match_kind be ((match_kind . nameIR) as value))*

      2. (Let varTypeIR be (() ((match_kind) as typeIR) (lctk) ?(value_match_kind)))*

      3. (Let TC_1 be $add_vars_t((global), TC_0, nameIR*, varTypeIR*))

      4. Result in TC_1, ((match_kind { nameIR* }) as declarationIR)

    4. Else Phantom#1553

  7. Case (% has type externFunctionDeclaration)

    1. (Let (annotationList extern (typeOrVoid name typeParameterListOpt ( parameterList )) ;) be (declaration as externFunctionDeclaration))

    2. (TypeParameterListOpt_ok: (local) TC_0 |- typeParameterListOpt : TC_1 typeId_expl*)

    3. (ParameterList_ok: (local) TC_1 |- parameterList : TC_2 parameterIR* # typeId_impl*)

    4. (Type_ok: (local) TC_1 |- typeOrVoid : typeIR_ret # typeId*)

    5. If ((typeId* matches pattern [])), then

      1. (Let TC_3 be TC_2[local.kind = ((extern_function : typeIR_ret) as localKind)])

      2. (Let callableId be $callableId(name, parameterList))

      3. (Let nameIR be $name(name))

      4. (Let externFunctionTypeDefIR be (extern_function nameIR < typeId_expl* , typeId_impl* > ( parameterIR* ) : typeIR_ret))

      5. If (CallableTypeDef_wf: $bound((global), TC_0) |- (externFunctionTypeDefIR as callableTypeDefIR) holds), then

        1. (Let TC_4 be $add_callableDef_overload_t((global), TC_0, callableId, (externFunctionTypeDefIR as callableTypeDefIR)))

        2. (Let externFunctionDeclarationIR be (annotationList extern (typeIR_ret nameIR < typeId_expl* , typeId_impl* > ( parameterIR* )) ;))

        3. Result in TC_4, (externFunctionDeclarationIR as declarationIR)

      5. Else Phantom#1554

    5. Else Phantom#1555

  8. Case (% has type externObjectDeclaration)

    1. (Let (annotationList extern nonTypeName typeParameterListOpt { externConstructorOrMethodPrototypeList }) be (declaration as externObjectDeclaration))

    2. (Let (externConstructorPrototype*, externMethodPrototype*) be $split_externConstructorOrMethodPrototypeList(externConstructorOrMethodPrototypeList))

    3. (Let TC_1 be TC_0[block.kind = (extern)])

    4. (TypeParameterListOpt_ok: (block) TC_1 |- typeParameterListOpt : TC_2 typeId_expl*)

    5. (Let nameIR be $name((nonTypeName as name)))

    6. (ExternMethod_ok: TC_2 nameIR |- externMethodPrototype : externMethodPrototypeIR)*

    7. (Let callableId_method be $callableId_of_externMethodPrototype(externMethodPrototype))*

    8. If ($distinct_<callableId>(callableId_method*)), then

      1. (Let externMethodTypeDefIR be $type_of_externMethodPrototypeIR(externMethodPrototypeIR))*

      2. (Let externMethodTypeDefEnv be ({ (callableId_method : externMethodTypeDefIR)* }))

      3. (Let typeDefIR_extern be ((extern nameIR < typeId_expl* , [] > externMethodTypeDefEnv) as typeDefIR))

      4. (Let TC_3 be $add_typeDef_t((global), TC_0, nameIR, typeDefIR_extern))

      5. (Let TC_4 be TC_3[block.kind = (extern)])

      6. (Let TC_5 be $add_typeParameters_t((block), TC_4, typeId_expl*))

      7. (ExternConstructor_ok: TC_5 nameIR |- externConstructorPrototype : externConstructorPrototypeIR)*

      8. (Let constructorId be $constructorId_of_externConstructorPrototype(externConstructorPrototype))*

      9. (Let typeIR_extern be $typeIR_of_typeDefIR(typeDefIR_extern))

      10. (Let constructorTypeDefIR be $constructorTypeDef_of_externConstructorPrototypeIR(typeId_expl*, typeIR_extern, externConstructorPrototypeIR))*

      11. (Let TC_6 be $add_constructorDefs_t(TC_3, constructorId*, constructorTypeDefIR*))

      12. (Let externObjectDeclarationIR be (annotationList extern nameIR < typeId_expl* , > { externConstructorPrototypeIR* externMethodPrototypeIR* }))

      13. Result in TC_6, (externObjectDeclarationIR as declarationIR)

    8. Else Phantom#1556

  9. Case (% has type parserDeclaration)

    1. (Let (annotationList parser name typeParameterListOpt ( parameterList ) constructorParameterListOpt { parserLocalDeclarationList parserStateList }) be (declaration as parserDeclaration))

    2. (Let TC_1 be TC_0[block.kind = (parser)])

    3. If ((typeParameterListOpt matches pattern `_EMPTY`)), then

      1. (ConstructorParameterListOpt_ok: TC_1 |- constructorParameterListOpt : TC_2 constructorParameterIR* # typeId*)

      2. If ((typeId* matches pattern [])), then

