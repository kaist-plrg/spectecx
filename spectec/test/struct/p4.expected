;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:283:1-285:45:
dec $typedLvalueIR_as_typedExpressionIR((lvalueIR # (( typeIR ))))

1. If ((lvalueIR has type referenceExpressionIR)), then

  1. (Let referenceExpressionIR be (lvalueIR as referenceExpressionIR))

  2. Return ?(((referenceExpressionIR as expressionIR) # (( typeIR (dyn) ))))

1. Else Phantom#524

2. Case analysis on lvalueIR

  1. Case (% matches pattern `% . %`)

    1. (Let (typedLvalueIR . nameIR) be lvalueIR)

    2. (Let typedExpressionIR'? be $typedLvalueIR_as_typedExpressionIR(typedLvalueIR))

    3. If ((typedExpressionIR'? matches pattern (_))), then

      1. (Let ?(typedExpressionIR) be typedExpressionIR'?)

      2. Return ?(((((typedExpressionIR as memberAccessBaseIR) . nameIR) as expressionIR) # (( typeIR (dyn) ))))

    3. Else Phantom#525

  2. Case (% matches pattern `% [%]`)

    1. (Let (typedLvalueIR_base [ typedExpressionIR_index ]) be lvalueIR)

    2. (Let typedExpressionIR? be $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

    3. If ((typedExpressionIR? matches pattern (_))), then

      1. (Let ?(typedExpressionIR_base) be typedExpressionIR?)

      2. Return ?((((typedExpressionIR_base [ typedExpressionIR_index ]) as expressionIR) # (( typeIR (dyn) ))))

    3. Else Phantom#526

  3. Case (% matches pattern `% [% % %]`)

    1. (Let (typedLvalueIR_base [ typedExpressionIR_hi sliceop typedExpressionIR_lo ]) be lvalueIR)

    2. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Let typedExpressionIR? be $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

        2. If ((typedExpressionIR? matches pattern (_))), then

          1. (Let ?(typedExpressionIR_base) be typedExpressionIR?)

          2. Return ?((((typedExpressionIR_base [ typedExpressionIR_hi (:) typedExpressionIR_lo ]) as expressionIR) # (( typeIR (dyn) ))))

        2. Else Phantom#527

      2. Case (% matches pattern `+:`)

        1. (Let typedExpressionIR? be $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

        2. If ((typedExpressionIR? matches pattern (_))), then

          1. (Let ?(typedExpressionIR_base) be typedExpressionIR?)

          2. Return ?((((typedExpressionIR_base [ typedExpressionIR_hi (+:) typedExpressionIR_lo ]) as expressionIR) # (( typeIR (dyn) ))))

        2. Else Phantom#528

2. Else Phantom#529

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:310:1-312:42:
dec $typedExpressionIR_as_typedLvalueIR((expressionIR # (( typeIR _ctk ))))

1. Case analysis on expressionIR

  1. Case (% has type referenceExpressionIR)

    1. (Let referenceExpressionIR be (expressionIR as referenceExpressionIR))

    2. Return ?(((referenceExpressionIR as lvalueIR) # (( typeIR ))))

  2. Case (% has type memberAccessExpressionIR)

    1. (Let (memberAccessBaseIR . nameIR) be (expressionIR as memberAccessExpressionIR))

    2. If ((memberAccessBaseIR has type typedExpressionIR)), then

      1. (Let typedExpressionIR be (memberAccessBaseIR as typedExpressionIR))

      2. (Let typedLvalueIR'? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

      3. If ((typedLvalueIR'? matches pattern (_))), then

        1. (Let ?(typedLvalueIR) be typedLvalueIR'?)

        2. Return ?(((typedLvalueIR . nameIR) # (( typeIR ))))

      3. Else Phantom#530

    2. Else Phantom#531

  3. Case (% has type indexAccessExpressionIR)

    1. (Let (typedExpressionIR_base [ typedExpressionIR_index ]) be (expressionIR as indexAccessExpressionIR))

    2. (Let typedLvalueIR? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

    3. If ((typedLvalueIR? matches pattern (_))), then

      1. (Let ?(typedLvalueIR_base) be typedLvalueIR?)

      2. Return ?(((typedLvalueIR_base [ typedExpressionIR_index ]) # (( typeIR ))))

    3. Else Phantom#532

  4. Case (% has type sliceAccessExpressionIR)

    1. (Let (typedExpressionIR_base [ typedExpressionIR_hi sliceop typedExpressionIR_lo ]) be (expressionIR as sliceAccessExpressionIR))

    2. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Let typedLvalueIR? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

        2. If ((typedLvalueIR? matches pattern (_))), then

          1. (Let ?(typedLvalueIR_base) be typedLvalueIR?)

          2. Return ?(((typedLvalueIR_base [ typedExpressionIR_hi (:) typedExpressionIR_lo ]) # (( typeIR ))))

        2. Else Phantom#533

      2. Case (% matches pattern `+:`)

        1. (Let typedLvalueIR? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

        2. If ((typedLvalueIR? matches pattern (_))), then

          1. (Let ?(typedLvalueIR_base) be typedLvalueIR?)

          2. Return ?(((typedLvalueIR_base [ typedExpressionIR_hi (+:) typedExpressionIR_lo ]) # (( typeIR ))))

        2. Else Phantom#534

  5. Case (% has type parenthesizedExpressionIR)

    1. (Let (( typedExpressionIR )) be (expressionIR as parenthesizedExpressionIR))

    2. (Let typedLvalueIR'? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

    3. If ((typedLvalueIR'? matches pattern (_))), then

      1. (Let ?(typedLvalueIR) be typedLvalueIR'?)

      2. Return ?(((( typedLvalueIR )) # (( typeIR ))))

    3. Else Phantom#535

1. Else Phantom#536

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:350:27-350:41:
syntax emptyStatementIR = emptyStatement

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:357:3-357:47:
