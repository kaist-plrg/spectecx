    8. Else Phantom#2347

  2. Case (% has type controlApplyMethodCallee)

    1. (Let controlApplyMethodCallee be (callee as controlApplyMethodCallee))

    2. (Let (control _objectId . apply ( parameterListIR # id_default* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR }) be controlApplyMethodCallee)

    3. (Let EC_callee_0 be $inherit_e((global), EC_0'))

    4. (Let ({ (callableId : actionDef)* }) be actionDefEnv)

