1. Return $is_lpm_key'(nameIR)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:95:1-95:32:
dec $is_lpm_key'(text')

1. If ((text' = "lpm")), then

  1. Return true

2. Otherwise

  1. Return false

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:105:1-107:79:
dec $requires_priority((_typedExpressionIR # _nameIR : nameIR _annotationList ;))

1. Return $requires_priority'(nameIR)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:108:1-108:39:
dec $requires_priority'(text')

1. Case analysis on text'

  1. Case (% = "range")

    1. Return true

  2. Case (% = "ternary")

    1. Return true

  3. Case (% = "optional")

    1. Return true

2. Otherwise

  1. Return false

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:124:1-125:63:
dec $update_mode_tbl(TBLC, tableKeyIR*)

1. (Let b_pri be $requires_priority(tableKeyIR))*

2. Case analysis on $exists_(b_pri*)

  1. Case true

    1. Return TBLC[mode = (pri)]

  2. Case false

    1. (Let b_lpm be $is_lpm_key(tableKeyIR))*

    2. (Let tableKeyIR'* be $filter_<tableKeyIR>(tableKeyIR*, b_lpm*))

    3. If ((tableKeyIR'* matches pattern [ _/1 ])), then

      1. (Let [tableKeyIR_lpm] be tableKeyIR'*)

      2. (Let (typedExpressionIR # _nameIR : text _annotationList ;) be tableKeyIR_lpm)

      3. If ((text = "lpm")), then

        1. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

        2. (Let typeIR' be $unroll_aliasTypeIR(typeIR))

        3. If ((typeIR' has type integerTypeIR)), then

          1. (Let integerTypeIR be (typeIR' as integerTypeIR))

          2. (Let nat? be $width_of_integerTypeIR(integerTypeIR))

          3. If ((nat? matches pattern (_))), then

            1. (Let ?(n) be nat?)

            2. Return TBLC[mode = (lpm n)]

          3. Else Phantom#992

        3. Else Phantom#993

      3. Else Phantom#994

    3. Else Phantom#995

    4. If (~$exists_(b_lpm*)), then

      1. Return TBLC[mode = (none)]

    4. Else Phantom#996

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:156:1-156:81:
dec $find_action(TBLC, prefixedNameIR)

1. Return $find_action'(TBLC.actions, prefixedNameIR)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:157:1-157:82:
dec $find_action'(matchAction*, prefixedNameIR)

1. Case analysis on matchAction*

  1. Case (% matches pattern [])

    1. Return ?()

  2. Case (% matches pattern _ :: _)

    1. (Let matchAction_h :: matchAction_t* be matchAction*)

    2. (Let (prefixedNameIR' ( parameterIR* @ argumentListIR )) be matchAction_h)

    3. Case analysis on prefixedNameIR'

      1. Case (% = prefixedNameIR)

        1. Return ?((parameterIR*, argumentListIR))

      2. Case (% =/= prefixedNameIR)

        1. Return $find_action'(matchAction_t*, prefixedNameIR)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:176:1-181:90:
dec $set_priorities_of_tableEntryListIR(TBLC, TBLS*, tableEntryIR*)

1. If ((TBLC.mode matches pattern `NONE`)), then

  1. If ((?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)))*, then

    1. Return tableEntryIR*

  1. Else Phantom#997

1. Else Phantom#998

2. (Let matchMode be TBLC.mode)

3. If ((matchMode matches pattern `LPM %`)), then

  1. (Let (lpm n) be matchMode)

  2. If ((TBLS matches pattern `LPM %`))*, then

    1. (Let (lpm n_prefix) be TBLS)*

    2. If ((?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR)))*, then

      1. (Let tableEntryIR_updated be $set_priority_of_tableEntryIR(tableEntryIR, n_prefix))*

      2. Return tableEntryIR_updated*

    2. Else Phantom#999

  2. Else Phantom#1000

3. Else Phantom#1001

4. Case analysis on tableEntryIR*

  1. Case (% matches pattern [])

    1. If ((TBLC.mode matches pattern `PRI`)), then

      1. Return []

    1. Else Phantom#1002

  2. Case (% matches pattern _ :: _)

    1. (Let tableEntryIR_h :: tableEntryIR_t* be tableEntryIR*)

    2. If ((TBLC.mode matches pattern `PRI`)), then

      1. If ((?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))), then

        1. If ((?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_t)))*, then

          1. (Let b_lw be TBLC.priorities.largest_wins)

          2. (Let n_size be TBLC.entries.size)

          3. (Let n_delta be TBLC.priorities.delta)

          4. (Let int be $ite<int>(b_lw, ((((n_size - 1) * n_delta) + 1) as int), (1 as int)))

          5. If ((int has type nat)), then

            1. (Let n be (int as nat))

            2. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

            3. (Let tableEntryIR_t_updated* be $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*))

            4. Return tableEntryIR_h_updated :: tableEntryIR_t_updated*

          5. Else Phantom#1003

        1. Else Phantom#1004

      1. Else Phantom#1005

      2. If (~TBLC.entries.const), then

        1. (Let tableEntryPriorityOptIR be $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))

        2. If ((tableEntryPriorityOptIR matches pattern (_))), then

          1. (Let ?((priority = integerLiteral :)) be tableEntryPriorityOptIR)

          2. (Let nat? be $nat_of_integerValue((integerLiteral as integerValue)))

          3. If ((nat? matches pattern (_))), then

            1. (Let ?(n) be nat?)

            2. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

            3. (Let tableEntryIR_t_updated* be $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*))

            4. Return tableEntryIR_h_updated :: tableEntryIR_t_updated*

          3. Else Phantom#1006

        2. Else Phantom#1007

      2. Else Phantom#1008

    2. Else Phantom#1009

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:182:1-186:18:
dec $set_priorities_of_tableEntryListIR'(TBLC, n_last, tableEntryIR*)

1. Case analysis on tableEntryIR*

  1. Case (% matches pattern [])

    1. Return []

  2. Case (% matches pattern _ :: _)

    1. (Let tableEntryIR_h :: tableEntryIR_t* be tableEntryIR*)

    2. If ((?() = $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))), then

      1. (Let b_lw be TBLC.priorities.largest_wins)

      2. (Let n_delta be TBLC.priorities.delta)

      3. (Let int be $ite<int>(b_lw, ((n_last - n_delta) as int), ((n_last + n_delta) as int)))

      4. If ((int has type nat)), then

        1. (Let n be (int as nat))

        2. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

        3. (Let tableEntryIR_t_updated* be $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*))

        4. Return tableEntryIR_h_updated :: tableEntryIR_t_updated*

      4. Else Phantom#1010

    2. Else Phantom#1011

    3. (Let tableEntryPriorityOptIR be $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR_h))

    4. If ((tableEntryPriorityOptIR matches pattern (_))), then

      1. (Let ?((priority = integerLiteral :)) be tableEntryPriorityOptIR)

      2. (Let nat? be $nat_of_integerValue((integerLiteral as integerValue)))

      3. If ((nat? matches pattern (_))), then

        1. (Let ?(n) be nat?)

        2. (Let tableEntryIR_h_updated be $set_priority_of_tableEntryIR(tableEntryIR_h, n))

        3. (Let tableEntryIR_t_updated* be $set_priorities_of_tableEntryListIR'(TBLC, n, tableEntryIR_t*))

        4. Return tableEntryIR_h_updated :: tableEntryIR_t_updated*

      3. Else Phantom#1012

    4. Else Phantom#1013

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:187:1-187:68:
dec $set_priority_of_tableEntryIR(tableEntryIR, n)

1. (Let (constOptIR _tableEntryPriorityOptIR keysetExpressionIR : tableActionReferenceIR annotationList ;) be tableEntryIR)

2. (Let tableEntryPriorityIR be (priority = (d (n as int)) :))

3. (Let tableEntryIR_updated be (constOptIR ?(tableEntryPriorityIR) keysetExpressionIR : tableActionReferenceIR annotationList ;))

4. Return tableEntryIR_updated

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:289:1-289:78:
dec $join_tableEntryState(tableEntryState, tableEntryState')

1. Case analysis on tableEntryState

  1. Case (% matches pattern `NON_LPM`)

    1. Case analysis on tableEntryState'

      1. Case (% matches pattern `LPM %`)

        1. (Let (lpm n) be tableEntryState')

        2. Return (lpm n)

      2. Case (% matches pattern `NON_LPM`)

        1. Return (non_lpm)

  2. Case (% matches pattern `LPM %`)

    1. (Let (lpm n) be tableEntryState)

    2. If ((tableEntryState' matches pattern `NON_LPM`)), then

      1. Return (lpm n)

    2. Else Phantom#1014

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:295:1-295:40:
dec $tableEntry_lpm_prefix(value)

1. Return $tableEntry_lpm_prefix'(value, 0)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:296:1-296:46:
dec $tableEntry_lpm_prefix'(value, n_prefix')

1. If ((value has type integerLiteral)), then

  1. (Let integerLiteral be (value as integerLiteral))

  2. If ((integerLiteral matches pattern `% W %`)), then

    1. (Let (nat w _int) be integerLiteral)

    2. If ((nat = 0)), then

      1. Return n_prefix'

    2. Else Phantom#1015

    3. If ((_int has type nat)), then

      1. (Let n be (_int as nat))

      2. If ((nat > 0)), then

        1. (Let w' be (nat - 1))

        2. If (((n \ 2) =/= 0)), then

          1. (Let n' be ((n - 1) / 2))

          2. (Let value' be ((w' w (n' as int)) as value))

          3. Return $tableEntry_lpm_prefix'(value', (n_prefix' + 1))

        2. Else Phantom#1016

      2. Else Phantom#1017

      3. If ((n_prefix' = 0)), then

        1. If ((nat > 0)), then

          1. (Let w' be (nat - 1))

          2. If (((n \ 2) = 0)), then

            1. (Let value' be ((w' w ((n / 2) as int)) as value))

            2. Return $tableEntry_lpm_prefix'(value', 0)

          2. Else Phantom#1018

        1. Else Phantom#1019

      3. Else Phantom#1020

    3. Else Phantom#1021

  2. Else Phantom#1022

1. Else Phantom#1023

