            2. Case (% has type continueResult<storageReference?*>)

              1. (Let (storageReference_t?*) be (copyInResult as continueResult<storageReference?*>))

              2. (Let storageReference?* be storageReference_h? :: storageReference_t?*)

              3. Result in ARCH_2, EC_caller_2, EC_callee_2, ((storageReference?*) as copyInResult)

    2. Else Phantom#2296

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:387:1-393:21:
relation Copy_in_default: parameterIR*, p_callee, EC_callee_0

1. (Let (_annotationList _direction _typeIR nameIR parameterInitializerOptIR) be parameterIR)*

2. If ((parameterInitializerOptIR matches pattern (_)))*, then

  1. (Let ?(parameterInitializerIR) be parameterInitializerOptIR)*

  2. If ((parameterInitializerIR has type constantInitializerIR))*, then

    1. (Let (= value) be (parameterInitializerIR as constantInitializerIR))*

    2. (Let EC_callee_1 be $add_vars_e(p_callee, EC_callee_0, (nameIR)*, value*))

    3. Result in EC_callee_1

  2. Else Phantom#2297

2. Else Phantom#2298

