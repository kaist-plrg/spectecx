;; ../../../../../spectec/specs/p4/5-typing/5.13.1-typing-parser-statement.spectec:9:1-13:21:
relation SelectCase_keyset_simple_ok: TC, typeIR_key, simpleKeysetExpression

1. If ((simpleKeysetExpression has type expression)), then

  1. (Let expression be (simpleKeysetExpression as expression))

  2. (Expr_ok: (local) TC |- expression : typedExpressionIR)

  3. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

  4. (Let typeIR' be $unroll_typeIR(typeIR))

  5. Case analysis on (typeIR' has type setTypeIR)

    1. Case true

      1. (Let (set < typeIR_base >) be (typeIR' as setTypeIR))

      2. If (Type_alpha: typeIR_base ~~ typeIR_key holds), then

        1. Result in (typedExpressionIR as simpleKeysetExpressionIR)

      2. Else Phantom#1762

      3. If (Type_alpha: typeIR_base ~~ typeIR_key does not hold), then

        1. (Cast_impl: typeIR_base -> typeIR_key : castResult)

        2. If ((castResult matches pattern `OK %`)), then

          1. (Let (ok _typeIR*) be castResult)

          2. (Let typeIR_cast be ((set < typeIR_key >) as typeIR))

          3. (Let typedExpressionIR_cast be (((( typeIR_cast ) typedExpressionIR) as expressionIR) # (( typeIR_cast (dyn) ))))

          4. Result in (typedExpressionIR_cast as simpleKeysetExpressionIR)

        2. Else Phantom#1763

      3. Else Phantom#1764

    2. Case false

      1. (Cast_impl: typeIR -> typeIR_key : castResult)

      2. If ((castResult matches pattern `OK %`)), then

        1. (Let (ok _typeIR*) be castResult)

        2. (Let typeIR_cast be ((set < typeIR_key >) as typeIR))

        3. (Let typedExpressionIR_cast be (((( typeIR_cast ) typedExpressionIR) as expressionIR) # (( typeIR_cast (dyn) ))))

        4. Result in (typedExpressionIR_cast as simpleKeysetExpressionIR)

      2. Else Phantom#1765

1. Else Phantom#1766

2. Case analysis on simpleKeysetExpression

  1. Case (% matches pattern `% &&& %`)

    1. (Let (expression_l &&& expression_r) be simpleKeysetExpression)

    2. (Expr_ok: (local) TC |- expression_l : typedExpressionIR_l)

    3. (Expr_ok: (local) TC |- expression_r : typedExpressionIR_r)

    4. (Let (typedExpressionIR, typedExpressionIR)? be $cast_binary(typedExpressionIR_l, typedExpressionIR_r))

    5. If (((typedExpressionIR, typedExpressionIR)? matches pattern (_))), then

      1. (Let ?((typedExpressionIR_l_cast, typedExpressionIR_r_cast)) be (typedExpressionIR, typedExpressionIR)?)

      2. (Let (typedExpressionIR, typedExpressionIR)'? be $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_mask))

      3. If (((typedExpressionIR, typedExpressionIR)'? matches pattern (_))), then

        1. (Let ?((typedExpressionIR_l_reduced, typedExpressionIR_r_reduced)) be (typedExpressionIR, typedExpressionIR)'?)

        2. (Let typeIR_reduced be $type_of_typedExpressionIR(typedExpressionIR_l_reduced))

        3. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_l_reduced, typeIR_key))

        4. If ((typedExpressionIR? matches pattern (_))), then

          1. (Let ?(typedExpressionIR_l_casted) be typedExpressionIR?)

          2. (Let typedExpressionIR'? be $cast_unary(typedExpressionIR_r_reduced, typeIR_key))

          3. If ((typedExpressionIR'? matches pattern (_))), then

            1. (Let ?(typedExpressionIR_r_casted) be typedExpressionIR'?)

            2. Result in (typedExpressionIR_l_casted &&& typedExpressionIR_r_casted)

          3. Else Phantom#1767

        4. Else Phantom#1768

      3. Else Phantom#1769

    5. Else Phantom#1770

  2. Case (% matches pattern `% .. %`)

    1. (Let (expression_l .. expression_r) be simpleKeysetExpression)

    2. (Expr_ok: (local) TC |- expression_l : typedExpressionIR_l)

    3. (Expr_ok: (local) TC |- expression_r : typedExpressionIR_r)

    4. (Let (typedExpressionIR, typedExpressionIR)? be $cast_binary(typedExpressionIR_l, typedExpressionIR_r))

    5. If (((typedExpressionIR, typedExpressionIR)? matches pattern (_))), then

      1. (Let ?((typedExpressionIR_l_cast, typedExpressionIR_r_cast)) be (typedExpressionIR, typedExpressionIR)?)

      2. (Let (typedExpressionIR, typedExpressionIR)'? be $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r_cast, $compat_range))

      3. If (((typedExpressionIR, typedExpressionIR)'? matches pattern (_))), then

        1. (Let ?((typedExpressionIR_l_reduced, typedExpressionIR_r_reduced)) be (typedExpressionIR, typedExpressionIR)'?)

        2. (Let typeIR_reduced be $type_of_typedExpressionIR(typedExpressionIR_l_reduced))

        3. If ((typeIR_reduced = $type_of_typedExpressionIR(typedExpressionIR_r_reduced))), then

          1. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_l_reduced, typeIR_key))

          2. If ((typedExpressionIR? matches pattern (_))), then

            1. (Let ?(typedExpressionIR_l_casted) be typedExpressionIR?)

            2. (Let typedExpressionIR'? be $cast_unary(typedExpressionIR_r_reduced, typeIR_key))

            3. If ((typedExpressionIR'? matches pattern (_))), then

              1. (Let ?(typedExpressionIR_r_casted) be typedExpressionIR'?)

