   | annotationListNonEmpty annotation (from annotationListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1479:1-1480:27:
syntax annotationList = 
   |  (from annotationList)
   | @ name (from annotation) hint(print "@"#%0)
   | @ name ( annotationBody ) (from annotation) hint(print "@"#%0#"("#%1#")")
   | @ name [ structuredAnnotationBody ] (from annotation) hint(print "@"#%0#"["#%1#"]")
   | @ pragma name annotationBody (from annotation) hint(print "@pragma" %0 %1)
   | annotationListNonEmpty annotation (from annotationListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1482:1-1483:32:
dec $flatten_annotationList(annotationList)

1. If ((annotationList matches pattern `_EMPTY`)), then

  1. Return []

1. Else Phantom#60

2. If ((annotationList has type annotation)), then

  1. (Let annotation be (annotationList as annotation))

  2. Return [annotation]

2. Else Phantom#61

3. If ((annotationList has type annotationListNonEmpty)), then

  1. (Let annotationListNonEmpty' be (annotationList as annotationListNonEmpty))

  2. If ((annotationListNonEmpty' matches pattern `% %`)), then

    1. (Let (annotationListNonEmpty annotation) be annotationListNonEmpty')

    2. Return $flatten_annotationList((annotationListNonEmpty as annotationList)) ++ [annotation]

  2. Else Phantom#62

3. Else Phantom#63

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1494:1-1496:18:
syntax p4program = 
   |  (from p4program)
   | p4program declaration (from p4program)
   | p4program ; (from p4program)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1498:1-1499:50:
dec $flatten_p4program(p4program'')

1. Case analysis on p4program''

  1. Case (% matches pattern `_EMPTY`)

    1. Return []

  2. Case (% matches pattern `% %`)

    1. (Let (p4program declaration) be p4program'')

    2. Return $flatten_p4program(p4program) ++ [declaration]

  3. Case (% matches pattern `% ;`)

    1. (Let (p4program ;) be p4program'')

    2. Return $flatten_p4program(p4program)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:5:17-5:39:
