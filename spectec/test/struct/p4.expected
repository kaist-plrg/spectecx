          2. Case true

            1. Return (TBLC', tablePropertyIR_h :: tablePropertyIR_t*)

      2. Case false

        1. (Let (TBLC_1, tablePropertyIR_t_updated*) be $insert_NoAction_tablePropertyIR(TBLC', tablePropertyIR_t*))

