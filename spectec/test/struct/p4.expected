;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:566:1-574:71:
relation Call_ok: p, TC, callableTypeIR, typeArgumentIR*, typeId'*, argumentIR*, id_default'*, id_optional'*

1. Case analysis on callableTypeIR

  1. Case (% has type actionTypeIR)

    1. (Let actionTypeIR be (callableTypeIR as actionTypeIR))

    2. If ((typeArgumentIR* matches pattern [])), then

      1. If ((typeId'* matches pattern [])), then

        1. (Let (_annotationList action _nameIR ( parameterIR* )) be actionTypeIR)

        2. (Let (given parameterIR_aligned* default _parameterIR* optional _parameterIR'*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

        3. If ($callable_action(p, TC)), then

          1. (Call_convention_ok: p TC (action) |- parameterIR_aligned* @ argumentIR* : argumentIR_cast*)

          2. Result in ((void) as typeIR), [], argumentIR_cast*

        3. Else Phantom#1664

      1. Else Phantom#1665

    2. Else Phantom#1666

  2. Case (% has type definedFunctionTypeIR)

    1. (Let definedFunctionTypeIR be (callableTypeIR as definedFunctionTypeIR))

    2. (Let (function nameIR ( parameterIR* ) : typeIR_ret) be definedFunctionTypeIR)

    3. (Let (given parameterIR_aligned* default _parameterIR* optional parameterIR_optional*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

    4. (Let inference be $infer(typeId'*, parameterIR_aligned*, parameterIR_optional*, argumentIR*))

    5. (Let typeArgumentIR_inferred be $subst_typeIR(inference, typeArgumentIR))*

    6. (Let parameterIR_aligned_inferred be $subst_parameterIR(inference, parameterIR_aligned))*

    7. (Let typeIR_ret_inferred be $subst_typeIR(inference, typeIR_ret))

    8. (Let functionTypeIR_inferred be ((function nameIR ( parameterIR_aligned_inferred* ) : typeIR_ret_inferred) as functionTypeIR))

    9. (Let B be $bound(p, TC))

    10. If (CallableType_wf: B |- (functionTypeIR_inferred as callableTypeIR) holds), then

      1. If ($callable_definedFunction(p, TC)), then

        1. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned_inferred* @ argumentIR* : argumentIR_cast*)

        2. Result in typeIR_ret_inferred, typeArgumentIR_inferred*, argumentIR_cast*

      1. Else Phantom#1667

    10. Else Phantom#1668

  3. Case (% has type externFunctionTypeIR)

    1. (Let externFunctionTypeIR be (callableTypeIR as externFunctionTypeIR))

    2. (Let (extern_function nameIR ( parameterIR* ) : typeIR_ret) be externFunctionTypeIR)

    3. (Let (given parameterIR_aligned* default _parameterIR* optional parameterIR_optional*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

    4. (Let inference be $infer(typeId'*, parameterIR_aligned*, parameterIR_optional*, argumentIR*))

    5. (Let typeArgumentIR_inferred be $subst_typeIR(inference, typeArgumentIR))*

    6. (Let parameterIR_aligned_inferred be $subst_parameterIR(inference, parameterIR_aligned))*

    7. (Let typeIR_ret_inferred be $subst_typeIR(inference, typeIR_ret))

    8. (Let externFunctionTypeIR_inferred be (extern_function nameIR ( parameterIR_aligned_inferred* ) : typeIR_ret_inferred))

    9. (Let B be $bound(p, TC))

    10. If (CallableType_wf: B |- (externFunctionTypeIR_inferred as callableTypeIR) holds), then

      1. If ($callable_externFunction(p, TC, nameIR)), then

        1. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned_inferred* @ argumentIR* : argumentIR_cast*)

        2. Result in typeIR_ret_inferred, typeArgumentIR_inferred*, argumentIR_cast*

      1. Else Phantom#1669

    10. Else Phantom#1670

  4. Case (% has type builtinMethodTypeIR)

    1. (Let builtinMethodTypeIR be (callableTypeIR as builtinMethodTypeIR))

    2. If ((typeId'* matches pattern [])), then

      1. (Let (parameterIR*, typeIR_ret) be $signature_of_builtinMethodTypeIR(builtinMethodTypeIR))

      2. (Let (given parameterIR_aligned* default _parameterIR* optional _parameterIR'*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

      3. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned* @ argumentIR* : argumentIR_cast*)

      4. Result in typeIR_ret, typeArgumentIR*, argumentIR_cast*

    2. Else Phantom#1671

  5. Case (% has type externMethodTypeIR)

    1. (Let externMethodTypeIR be (callableTypeIR as externMethodTypeIR))

    2. Case analysis on externMethodTypeIR

      1. Case (% matches pattern `EXTERN_METHOD % (%) : %`)

        1. (Let (extern_method nameIR ( parameterIR* ) : typeIR_ret) be externMethodTypeIR)

        2. (Let (given parameterIR_aligned* default _parameterIR* optional parameterIR_optional*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

        3. (Let inference be $infer(typeId'*, parameterIR_aligned*, parameterIR_optional*, argumentIR*))

        4. (Let typeArgumentIR_inferred be $subst_typeIR(inference, typeArgumentIR))*

        5. (Let parameterIR_aligned_inferred be $subst_parameterIR(inference, parameterIR_aligned))*

        6. (Let typeIR_ret_inferred be $subst_typeIR(inference, typeIR_ret))

        7. (Let externMethodTypeIR_inferred be (extern_method nameIR ( parameterIR_aligned_inferred* ) : typeIR_ret_inferred))

        8. (Let B be $bound(p, TC))

        9. If (CallableType_wf: B |- (externMethodTypeIR_inferred as callableTypeIR) holds), then

          1. If ($callable_externMethod(p, TC)), then

            1. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned_inferred* @ argumentIR* : argumentIR_cast*)

            2. Result in typeIR_ret_inferred, typeArgumentIR_inferred*, argumentIR_cast*

          1. Else Phantom#1672

        9. Else Phantom#1673

      2. Case (% matches pattern `EXTERN_METHOD ABSTRACT % (%) : %`)

        1. (Let (extern_method abstract nameIR ( parameterIR* ) : typeIR_ret) be externMethodTypeIR)

        2. (Let (given parameterIR_aligned* default _parameterIR* optional parameterIR_optional*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

        3. (Let inference be $infer(typeId'*, parameterIR_aligned*, parameterIR_optional*, argumentIR*))

        4. (Let typeArgumentIR_inferred be $subst_typeIR(inference, typeArgumentIR))*

        5. (Let parameterIR_aligned_inferred be $subst_parameterIR(inference, parameterIR_aligned))*

        6. (Let typeIR_ret_inferred be $subst_typeIR(inference, typeIR_ret))

        7. (Let externMethodTypeIR_inferred be (extern_method abstract nameIR ( parameterIR_aligned_inferred* ) : typeIR_ret_inferred))

        8. (Let B be $bound(p, TC))

        9. If (CallableType_wf: B |- (externMethodTypeIR_inferred as callableTypeIR) holds), then

          1. If ($callable_externMethod(p, TC)), then

            1. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned_inferred* @ argumentIR* : argumentIR_cast*)

            2. Result in typeIR_ret_inferred, typeArgumentIR_inferred*, argumentIR_cast*

          1. Else Phantom#1674

        9. Else Phantom#1675

  6. Case (% has type parserApplyMethodTypeIR)

    1. (Let parserApplyMethodTypeIR be (callableTypeIR as parserApplyMethodTypeIR))

    2. If ((typeArgumentIR* matches pattern [])), then

      1. If ((typeId'* matches pattern [])), then

        1. (Let (parser_apply ( parameterIR* )) be parserApplyMethodTypeIR)

        2. (Let (given parameterIR_aligned* default _parameterIR* optional _parameterIR'*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

        3. If ($callable_parserApplyMethod(p, TC)), then

          1. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned* @ argumentIR* : argumentIR_cast*)

          2. Result in ((void) as typeIR), [], argumentIR_cast*

        3. Else Phantom#1676

      1. Else Phantom#1677

    2. Else Phantom#1678

  7. Case (% has type controlApplyMethodTypeIR)

    1. (Let controlApplyMethodTypeIR be (callableTypeIR as controlApplyMethodTypeIR))

    2. If ((typeArgumentIR* matches pattern [])), then

      1. If ((typeId'* matches pattern [])), then

        1. (Let (control_apply ( parameterIR* )) be controlApplyMethodTypeIR)

        2. (Let (given parameterIR_aligned* default _parameterIR* optional _parameterIR'*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default'*, id_optional'*))

        3. If ($callable_controlApplyMethod(p, TC)), then

          1. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned* @ argumentIR* : argumentIR_cast*)

          2. Result in ((void) as typeIR), [], argumentIR_cast*

        3. Else Phantom#1679

      1. Else Phantom#1680

    2. Else Phantom#1681

  8. Case (% has type tableApplyMethodTypeIR)

    1. (Let tableApplyMethodTypeIR be (callableTypeIR as tableApplyMethodTypeIR))

    2. If ((typeArgumentIR* matches pattern [])), then

      1. If ((typeId'* matches pattern [])), then

        1. If ((argumentIR* matches pattern [])), then

          1. If ((id_default'* matches pattern [])), then

            1. If ((id_optional'* matches pattern [])), then

              1. (Let (table_apply : tableMetadataStructTypeIR) be tableApplyMethodTypeIR)

              2. If ($callable_tableApplyMethod(p, TC)), then

                1. Result in (tableMetadataStructTypeIR as typeIR), [], []

              2. Else Phantom#1682

            1. Else Phantom#1683

          1. Else Phantom#1684

        1. Else Phantom#1685

      1. Else Phantom#1686

    2. Else Phantom#1687

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:584:1-591:53:
relation ConstructorType_ok: p, TC, (prefixedNameIR < typeArgumentIR''* >), argumentIR*

1. If ((?() = $find_typeDef_t(p, TC, prefixedNameIR))), then

  1. (Let callResolution<constructorTypeDefIR>? be $find_constructorDef_overloaded_t(TC, prefixedNameIR, argumentIR*))

  2. If ((callResolution<constructorTypeDefIR>? matches pattern (_))), then

    1. (Let ?((callableId : constructorTypeDefIR # id_default* # id_optional*)) be callResolution<constructorTypeDefIR>?)

    2. (Let (constructorTypeIR, typeId_impl*) be $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR''*))

    3. Result in constructorTypeIR, typeId_impl*, id_default*, id_optional*

  2. Else Phantom#1688

1. Else Phantom#1689

2. (Let typeDefIR'? be $find_typeDef_t(p, TC, prefixedNameIR))

3. If ((typeDefIR'? matches pattern (_))), then

  1. (Let ?(typeDefIR) be typeDefIR'?)

  2. If (~(typeDefIR has type typedefTypeIR)), then

    1. (Let callResolution<constructorTypeDefIR>? be $find_constructorDef_overloaded_t(TC, prefixedNameIR, argumentIR*))

    2. If ((callResolution<constructorTypeDefIR>? matches pattern (_))), then

      1. (Let ?((callableId : constructorTypeDefIR # id_default* # id_optional*)) be callResolution<constructorTypeDefIR>?)

      2. (Let (constructorTypeIR, typeId_impl*) be $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR''*))

      3. Result in constructorTypeIR, typeId_impl*, id_default*, id_optional*

    2. Else Phantom#1690

  2. Else Phantom#1691

3. Else Phantom#1692

4. If ((typeArgumentIR''* matches pattern [])), then

  1. (Let typeDefIR'? be $find_typeDef_t(p, TC, prefixedNameIR))

  2. If ((typeDefIR'? matches pattern (_))), then

    1. (Let ?(typeDefIR) be typeDefIR'?)

    2. If ((typeDefIR has type typedefTypeIR)), then

      1. (Let (typedef nameIR_alias typeIR_alias) be (typeDefIR as typedefTypeIR))

      2. (Let (nameIR, typeArgumentIR*) be $resolve_type_alias(typeIR_alias))

      3. (Let callResolution<constructorTypeDefIR>? be $find_constructorDef_overloaded_t(TC, (nameIR), argumentIR*))

      4. If ((callResolution<constructorTypeDefIR>? matches pattern (_))), then

        1. (Let ?((callableId : constructorTypeDefIR # id_default* # id_optional*)) be callResolution<constructorTypeDefIR>?)

        2. (Let (constructorTypeIR, typeId_impl*) be $specialize_constructorTypeDefIR(constructorTypeDefIR, typeArgumentIR*))

        3. Result in constructorTypeIR, typeId_impl*, id_default*, id_optional*

      4. Else Phantom#1693

    2. Else Phantom#1694

  2. Else Phantom#1695

4. Else Phantom#1696

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:598:19-598:31:
syntax instctxt = 
   | named (from instctxt)
   | anon (from instctxt)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:600:1-610:77:
relation Inst_ok: p, TC, instctxt, constructorTypeIR, typeArgumentIR*, typeId_infer*, argumentIR*, id_default*, id_optional*

1. (Let (constructor ( parameterIR* ) : typeIR_object) be constructorTypeIR)

2. (Let (given parameterIR_aligned* default _parameterIR* optional parameterIR_optional*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default*, id_optional*))

3. (Let inference be $infer(typeId_infer*, parameterIR_aligned*, parameterIR_optional*, argumentIR*))

4. (Let typeArgumentIR_inferred be $subst_typeIR(inference, typeArgumentIR))*

5. (Let parameterIR_aligned_inferred be $subst_parameterIR(inference, parameterIR_aligned))*

6. (Let typeIR_object_inferred be $subst_typeIR(inference, typeIR_object))

7. (Let constructorTypeIR_inferred be (constructor ( parameterIR_aligned_inferred* ) : typeIR_object_inferred))

8. If (ConstructorType_wf: $bound(p, TC) |- constructorTypeIR_inferred holds), then

  1. If ($instantiable(p, TC, instctxt, typeIR_object_inferred)), then

    1. (Let typeIR_object_unroll be $unroll_typeIR(typeIR_object))

    2. Case analysis on (typeIR_object_unroll has type packageObjectTypeIR)

      1. Case true

        1. If ((p matches pattern `GLOBAL`)), then

          1. (Call_convention_ok: (block) TC (noaction) |- parameterIR_aligned_inferred* @ argumentIR* : argumentIR_cast*)

          2. Result in typeIR_object_inferred, typeArgumentIR_inferred*, argumentIR_cast*

        1. Else Phantom#1697

      2. Case false

        1. (Call_convention_ok: p TC (noaction) |- parameterIR_aligned_inferred* @ argumentIR* : argumentIR_cast*)

        2. Result in typeIR_object_inferred, typeArgumentIR_inferred*, argumentIR_cast*

  1. Else Phantom#1698

8. Else Phantom#1699

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:5:1-5:51:
dec $chain_casts(typeIR_cur*, typeIR_chain**)

1. Case analysis on []

  1. Case (% = $concat_<typeIR>(typeIR_chain**))

    1. Return []

  2. Case (% =/= $concat_<typeIR>(typeIR_chain**))

    1. (Let (typeIR_next, typeIR_chain_rest*) be $chain_casts'(typeIR_cur, typeIR_chain*))*

    2. Return typeIR_next* :: $chain_casts(typeIR_next*, typeIR_chain_rest**)

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:6:1-6:55:
dec $chain_casts'(typeIR_cur, typeIR*)

1. Case analysis on typeIR*

  1. Case (% matches pattern [])

    1. Return (typeIR_cur, [])

  2. Case (% matches pattern _ :: _)

    1. (Let typeIR_h :: typeIR_t* be typeIR*)

    2. Return (typeIR_h, typeIR_t*)

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:17:1-17:69:
dec $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast_elem**, typeIR_b)

1. (Let typeIR_cast_step** be $chain_casts(typeIR_a*, typeIR_cast_elem**))

2. (Let typeIR_cast_agg be ((seq < typeIR_cast_step* >) as typeIR))*

3. Return typeIR_cast_agg* ++ [typeIR_b]

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:24:1-24:77:
dec $chain_casts_sequenceTypeIR_default(typeIR_a*, typeIR_cast_elem**, typeIR_b)

1. (Let typeIR_cast_step** be $chain_casts(typeIR_a*, typeIR_cast_elem**))

2. (Let typeIR_cast_agg be ((seq < typeIR_cast_step* , ... >) as typeIR))*

3. Return typeIR_cast_agg* ++ [typeIR_b]

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:31:1-31:72:
dec $chain_casts_recordTypeIR((annotationList_a typeIR_a id_a ;)*, typeIR_cast_elem**, typeIR_b)

1. (Let typeIR_cast_step** be $chain_casts(typeIR_a*, typeIR_cast_elem**))

2. (Let typeIR_cast_agg be ((record { (annotationList_a typeIR_cast_step id_a ;)* }) as typeIR))*

3. Return typeIR_cast_agg* ++ [typeIR_b]

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:40:1-40:80:
dec $chain_casts_recordTypeIR_default((annotationList_a typeIR_a id_a ;)*, typeIR_cast_elem**, typeIR_b)

1. (Let typeIR_cast_step** be $chain_casts(typeIR_a*, typeIR_cast_elem**))

2. (Let typeIR_cast_agg be ((record { (annotationList_a typeIR_cast_step id_a ;)* , ... }) as typeIR))*

3. Return typeIR_cast_agg* ++ [typeIR_b]

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:572:1-573:66:
dec $reduce_serenum(typedExpressionIR)

1. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR))

2. (Let ctk be $ctk_of_typedExpressionIR(typedExpressionIR))

3. (Let typeIR' be $unroll_typeIR(typeIR))

4. If ((typeIR' has type serializableEnumTypeIR)), then

  1. (Let (enum _typeId < typeIR_underlying > { _valueFieldIR* }) be (typeIR' as serializableEnumTypeIR))

  2. (Let typedExpressionIR_reduced be (((( typeIR_underlying ) typedExpressionIR) as expressionIR) # (( typeIR_underlying ctk ))))

  3. Return typedExpressionIR_reduced

2. Otherwise

  1. Return typedExpressionIR

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:586:1-590:93:
dec $reduce_serenum_unary(typedExpressionIR, $check)

1. (Let (_expressionIR # (( typeIR _ctk ))) be typedExpressionIR)

2. Case analysis on $check(typeIR)

  1. Case true

    1. Return ?(typedExpressionIR)

  2. Case false

    1. (Let typeIR' be $unroll_typeIR(typeIR))

    2. If ((typeIR' has type serializableEnumTypeIR)), then

      1. (Let (enum _typeId < typeIR_underlying > { _valueFieldIR* }) be (typeIR' as serializableEnumTypeIR))

      2. (Let typedExpressionIR_cast be (((( typeIR_underlying ) typedExpressionIR) as expressionIR) # (( typeIR_underlying _ctk ))))

      3. Return $reduce_serenum_unary(typedExpressionIR_cast, $check)

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:610:1-615:102:
dec $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r, $check)

1. (Let (_expressionIR # (( typeIR_l _ctk ))) be typedExpressionIR_l)

2. (Let (_expressionIR' # (( typeIR_r _ctk' ))) be typedExpressionIR_r)

3. Case analysis on $check(typeIR_l, typeIR_r)

  1. Case true

    1. Return ?((typedExpressionIR_l, typedExpressionIR_r))

  2. Case false

    1. (Let typeIR be $unroll_typeIR(typeIR_l))

    2. If ((typeIR has type serializableEnumTypeIR)), then

      1. (Let (enum _typeId < typeIR_l_underlying > { _valueFieldIR* }) be (typeIR as serializableEnumTypeIR))

      2. (Let typedExpressionIR_l_cast be (((( typeIR_l_underlying ) typedExpressionIR_l) as expressionIR) # (( typeIR_l_underlying _ctk' ))))

      3. Return $reduce_serenum_binary(typedExpressionIR_l_cast, typedExpressionIR_r, $check)

    3. If (~($unroll_typeIR(typeIR_l) has type serializableEnumTypeIR)), then

      1. (Let typeIR be $unroll_typeIR(typeIR_r))

      2. If ((typeIR has type serializableEnumTypeIR)), then

        1. (Let (enum _typeId < typeIR_r_underlying > { _valueFieldIR* }) be (typeIR as serializableEnumTypeIR))

        2. (Let typedExpressionIR_r_cast be (((( typeIR_r_underlying ) typedExpressionIR_r) as expressionIR) # (( typeIR_r_underlying _ctk' ))))

        3. Return $reduce_serenum_binary(typedExpressionIR_l, typedExpressionIR_r_cast, $check)

2. Otherwise

  1. Return ?()

