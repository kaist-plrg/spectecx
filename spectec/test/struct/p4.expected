builtin dec $fresh_typeId

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:52:1-53:43:
dec $fresh_typeIds(nat')

1. Case analysis on nat'

  1. Case (% = 0)

    1. Return []

  2. Case (% =/= 0)

    1. (Let n' be (nat' - 1))

    2. Return $fresh_typeId :: $fresh_typeIds(n')

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:65:23-65:39:
syntax callTargetId = 
   | nameIR ( id* ) (from callTargetId)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:66:21-66:33:
syntax callableId = callTargetId

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:67:24-67:36:
syntax constructorId = callTargetId

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:69:1-70:59:
dec $callableId(name, parameterList)

1. Return ($name(name) ( $callableId'(parameterList) ))

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:71:1-71:38:
dec $callableId'(parameterList)

1. If ((parameterList matches pattern `_EMPTY`)), then

  1. Return []

1. Else Phantom#70

2. If ((parameterList has type parameter)), then

  1. (Let (_annotationList _direction _type name _initializerOpt) be (parameterList as parameter))

  2. Return [$name(name)]

2. Else Phantom#71

3. If ((parameterList has type nonEmptyParameterList)), then

  1. (Let nonEmptyParameterList' be (parameterList as nonEmptyParameterList))

  2. If ((nonEmptyParameterList' matches pattern `% , %`)), then

    1. (Let (nonEmptyParameterList , (_annotationList _direction _type name _initializerOpt)) be nonEmptyParameterList')

    2. Return $callableId'((nonEmptyParameterList as parameterList)) ++ [$name(name)]

  2. Else Phantom#72

3. Else Phantom#73

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:73:1-74:56:
dec $constructorId(name, constructorParameterListOpt)

1. Case analysis on constructorParameterListOpt

  1. Case (% matches pattern `_EMPTY`)

    1. Return ($name(name) ( [] ))

  2. Case (% matches pattern `(%)`)

    1. (Let (( parameterList )) be constructorParameterListOpt)

    2. Return $callableId(name, parameterList)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:91:19-91:26:
syntax objectId = nameIR*

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:93:1-95:69:
dec $objectId_ends_with(objectId, nameIR)

1. (Let nameIR''* be $rev_<id>(objectId))

2. If ((nameIR''* matches pattern _ :: _)), then

  1. (Let nameIR' :: _nameIR* be nameIR''*)

  2. If ((nameIR' = nameIR)), then

    1. Return true

2. Otherwise

  1. Return false

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:9:20-9:27:
