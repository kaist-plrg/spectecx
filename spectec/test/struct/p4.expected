;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:500:1-501:50:
dec $find_local_return_type_t(TC)

1. (Let localKind be TC.local.kind)

2. Case analysis on localKind

  1. Case (% has type definedFunctionLocalKind)

    1. (Let (function : typeIR_ret) be (localKind as definedFunctionLocalKind))

    2. Return ?(typeIR_ret)

  2. Case (% has type externFunctionLocalKind)

    1. (Let (extern_function : typeIR_ret) be (localKind as externFunctionLocalKind))

    2. Return ?(typeIR_ret)

3. If ((((action) as localKind) = TC.local.kind)), then

  1. Return ?(((void) as typeIR))

4. (Let localKind be TC.local.kind)

5. If ((localKind has type externMethodLocalKind)), then

  1. (Let externMethodLocalKind be (localKind as externMethodLocalKind))

  2. Case analysis on externMethodLocalKind

    1. Case (% matches pattern `EXTERN_METHOD : %`)

      1. (Let (extern_method : typeIR_ret) be externMethodLocalKind)

      2. Return ?(typeIR_ret)

    2. Case (% matches pattern `EXTERN_METHOD ABSTRACT : %`)

      1. (Let (extern_method abstract : typeIR_ret) be externMethodLocalKind)

      2. Return ?(typeIR_ret)

6. If ((((control_apply_method) as localKind) = TC.local.kind)), then

  1. Return ?(((void) as typeIR))

5. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:5:19-5:36:
syntax matchKey = 
   | typeIR : nameIR (from matchKey)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:7:22-7:74:
syntax matchAction = 
   | prefixedNameIR ( parameterIR* @ argumentListIR ) (from matchAction)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:10:3-11:24:
syntax matchPriority = {delta nat, largest_wins bool}

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:14:3-15:17:
syntax matchEntries = {size nat, const bool}

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:19:1-23:8:
