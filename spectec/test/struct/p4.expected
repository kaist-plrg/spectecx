    2. If ((typeIR_arg' has type headerTypeIR)), then

      1. (Let (header typeId' < typeIR_arg_b* > { _fieldTypeIR'* }) be (typeIR_arg' as headerTypeIR))

      2. If ((typeId = typeId')), then

        1. Return $gen_constraint(constraint, typeIR_arg_a*, typeIR_arg_b*)

  10. Case (% has type headerUnionTypeIR)

    1. (Let (header_union typeId < typeIR_arg_a* > { _fieldTypeIR* }) be (typeIR'' as headerUnionTypeIR))

    2. If ((typeIR_arg' has type headerUnionTypeIR)), then

      1. (Let (header_union typeId' < typeIR_arg_b* > { _fieldTypeIR'* }) be (typeIR_arg' as headerUnionTypeIR))

      2. If ((typeId = typeId')), then

        1. Return $gen_constraint(constraint, typeIR_arg_a*, typeIR_arg_b*)

  11. Case (% has type externObjectTypeIR)

    1. (Let (extern typeId < typeIR_arg_a* > ({ _pair<callableId, externMethodTypeDefIR>* })) be (typeIR'' as externObjectTypeIR))

    2. If ((typeIR_arg' has type externObjectTypeIR)), then

      1. (Let (extern typeId' < typeIR_arg_b* > ({ _pair<callableId, externMethodTypeDefIR>'* })) be (typeIR_arg' as externObjectTypeIR))

      2. If ((typeId = typeId')), then

        1. Return $gen_constraint(constraint, typeIR_arg_a*, typeIR_arg_b*)

  12. Case (% has type parserObjectTypeIR)

    1. (Let (parser _typeId < _typeArgumentIR* > ( parameterIR_param* )) be (typeIR'' as parserObjectTypeIR))

    2. If ((typeIR_arg' has type parserObjectTypeIR)), then

      1. (Let (parser _typeId' < _typeArgumentIR'* > ( parameterIR_arg* )) be (typeIR_arg' as parserObjectTypeIR))

      2. (Let (_annotationList direction typeIR_param _id _parameterInitializerOptIR) be parameterIR_param)*

      3. (Let (_annotationList' direction' typeIR_arg _id' _parameterInitializerOptIR') be parameterIR_arg)*

      4. If ((direction' = direction))*, then

        1. Return $gen_constraint(constraint, typeIR_param*, typeIR_arg*)

  13. Case (% has type controlObjectTypeIR)

    1. (Let (control _typeId < _typeArgumentIR* > ( parameterIR_param* )) be (typeIR'' as controlObjectTypeIR))

    2. If ((typeIR_arg' has type controlObjectTypeIR)), then

      1. (Let (control _typeId' < _typeArgumentIR'* > ( parameterIR_arg* )) be (typeIR_arg' as controlObjectTypeIR))

      2. (Let (_annotationList direction typeIR_param _id _parameterInitializerOptIR) be parameterIR_param)*

