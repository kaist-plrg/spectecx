      2. (Let i_b be $int_of_integerValue(integerValue_b))

      3. (Let i_h be $int_of_integerValue(integerValue_h))

      4. (Let i_l be $int_of_integerValue(integerValue_l))

      5. (Let int be ((i_h + (1 as int)) - i_l))

      6. If ((int has type nat)), then

        1. (Let w be (int as nat))

        2. (Let i be $bitacc(i_b, i_h, i_l))

        3. Return ((w w i) as value)

      6. Else Phantom#481

    2. Else Phantom#482

  2. Else Phantom#483

1. Else Phantom#484

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1062:1-1064:37:
dec $bitacc_offset_op(value, value', value'')

1. If ((value has type integerValue)), then

  1. (Let integerValue_b be (value as integerValue))

  2. If ((value' has type integerValue)), then

    1. (Let integerValue_l be (value' as integerValue))

    2. If ((value'' has type integerValue)), then

      1. (Let integerValue_w be (value'' as integerValue))

      2. (Let i_b be $int_of_integerValue(integerValue_b))

      3. (Let i_l be $int_of_integerValue(integerValue_l))

      4. (Let nat? be $nat_of_integerValue(integerValue_w))

      5. If ((nat? matches pattern (_))), then

        1. (Let ?(w) be nat?)

        2. (Let i_h be ((i_l + (w as int)) - (1 as int)))

        3. (Let i be $bitacc(i_b, i_h, i_l))

        4. Return ((w w i) as value)

      5. Else Phantom#485

    2. Else Phantom#486

  2. Else Phantom#487

1. Else Phantom#488

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1077:1-1079:55:
dec $bitacc_range_replace_op(value, value', value'', value''')

1. If ((value has type integerValue)), then

  1. (Let integerValue_b be (value as integerValue))

  2. If ((value' has type integerValue)), then

    1. (Let integerValue_h be (value' as integerValue))

    2. If ((value'' has type integerValue)), then

      1. (Let integerValue_l be (value'' as integerValue))

      2. If ((value''' has type integerValue)), then

        1. (Let integerValue_r be (value''' as integerValue))

        2. If ((integerValue_b has type integerLiteral)), then

          1. (Let integerLiteral be (integerValue_b as integerLiteral))

          2. Case analysis on integerLiteral

            1. Case (% matches pattern `% W %`)

              1. (Let (w w i_b) be integerLiteral)

              2. (Let i_h be $int_of_integerValue(integerValue_h))

              3. (Let i_l be $int_of_integerValue(integerValue_l))

              4. If ((integerValue_r has type integerLiteral)), then

                1. (Let integerLiteral' be (integerValue_r as integerLiteral))

                2. If ((integerLiteral' matches pattern `% W %`)), then

                  1. (Let (_nat w i_r) be integerLiteral')

                  2. (Let i be $bitacc_replace(i_b, i_h, i_l, i_r))

                  3. Return ((w w i) as value)

                2. Else Phantom#489

              4. Else Phantom#490

            2. Case (% matches pattern `% S %`)

              1. (Let (w s i_b) be integerLiteral)

              2. (Let i_h be $int_of_integerValue(integerValue_h))

              3. (Let i_l be $int_of_integerValue(integerValue_l))

              4. If ((integerValue_r has type integerLiteral)), then

                1. (Let integerLiteral' be (integerValue_r as integerLiteral))

                2. If ((integerLiteral' matches pattern `% W %`)), then

                  1. (Let (_nat w i_r) be integerLiteral')

                  2. (Let i be $bitacc_replace(i_b, i_h, i_l, i_r))

                  3. Return ((w s i) as value)

                2. Else Phantom#491

              4. Else Phantom#492

          2. Else Phantom#493

        2. Else Phantom#494

      2. Else Phantom#495

    2. Else Phantom#496

  2. Else Phantom#497

1. Else Phantom#498

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1099:1-1101:56:
dec $bitacc_offset_replace_op(value, value', value'', value''')

1. If ((value has type integerValue)), then

  1. (Let integerValue_b be (value as integerValue))

  2. If ((value' has type integerValue)), then

    1. (Let integerValue_l be (value' as integerValue))

    2. If ((value'' has type integerValue)), then

      1. (Let integerValue_w be (value'' as integerValue))

      2. If ((value''' has type integerValue)), then

        1. (Let integerValue_r be (value''' as integerValue))

        2. If ((integerValue_b has type integerLiteral)), then

          1. (Let integerLiteral be (integerValue_b as integerLiteral))

          2. Case analysis on integerLiteral

            1. Case (% matches pattern `% W %`)

              1. (Let (w w i_b) be integerLiteral)

              2. (Let i_l be $int_of_integerValue(integerValue_l))

              3. (Let nat? be $nat_of_integerValue(integerValue_w))

              4. If ((nat? matches pattern (_))), then

                1. (Let ?(n_w) be nat?)

                2. (Let i_h be ((i_l + (n_w as int)) - (1 as int)))

                3. If ((integerValue_r has type integerLiteral)), then

                  1. (Let integerLiteral' be (integerValue_r as integerLiteral))

                  2. If ((integerLiteral' matches pattern `% W %`)), then

                    1. (Let (_nat w i_r) be integerLiteral')

                    2. (Let i be $bitacc_replace(i_b, i_h, i_l, i_r))

                    3. Return ((w w i) as value)

                  2. Else Phantom#499

                3. Else Phantom#500

              4. Else Phantom#501

            2. Case (% matches pattern `% S %`)

              1. (Let (w s i_b) be integerLiteral)

              2. (Let i_l be $int_of_integerValue(integerValue_l))

              3. (Let nat? be $nat_of_integerValue(integerValue_w))

              4. If ((nat? matches pattern (_))), then

                1. (Let ?(n_w) be nat?)

                2. (Let i_h be ((i_l + (n_w as int)) - (1 as int)))

                3. If ((integerValue_r has type integerLiteral)), then

                  1. (Let integerLiteral' be (integerValue_r as integerLiteral))

                  2. If ((integerLiteral' matches pattern `% W %`)), then

                    1. (Let (_nat w i_r) be integerLiteral')

                    2. (Let i be $bitacc_replace(i_b, i_h, i_l, i_r))

                    3. Return ((w s i) as value)

                  2. Else Phantom#502

                3. Else Phantom#503

              4. Else Phantom#504

          2. Else Phantom#505

        2. Else Phantom#506

      2. Else Phantom#507

    2. Else Phantom#508

  2. Else Phantom#509

1. Else Phantom#510

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1123:1-1124:23:
dec $sizeof(typeIR, text)

1. Case analysis on text

  1. Case (% = "minSizeInBits")

    1. Return $sizeof_minSizeInBits(typeIR)

  2. Case (% = "minSizeInBytes")

    1. Return $sizeof_minSizeInBytes(typeIR)

  3. Case (% = "maxSizeInBits")

    1. Return $sizeof_maxSizeInBits(typeIR)

  4. Case (% = "maxSizeInBytes")

    1. Return $sizeof_maxSizeInBytes(typeIR)

1. Else Phantom#511

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1126:1-1127:23:
dec $sizeof_minSizeInBits(typeIR)

1. Return ((d ($sizeof_minSizeInBits'(typeIR) as int)) as value)

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1128:1-1129:23:
dec $sizeof_minSizeInBits'(typeIR'')

1. Case analysis on typeIR''

  1. Case (% has type boolTypeIR)

    1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

    2. If ((boolTypeIR matches pattern `BOOL`)), then

      1. Return 1

    2. Else Phantom#512

  2. Case (% has type fixedIntTypeIR)

    1. (Let (int < w >) be (typeIR'' as fixedIntTypeIR))

    2. Return w

  3. Case (% has type fixedBitTypeIR)

    1. (Let (bit < w >) be (typeIR'' as fixedBitTypeIR))

    2. Return w

  4. Case (% has type varBitTypeIR)

    1. (Let (varbit < _nat >) be (typeIR'' as varBitTypeIR))

    2. Return 0

  5. Case (% has type typedefTypeIR)

    1. (Let (typedef _typeId typeIR) be (typeIR'' as typedefTypeIR))

    2. Return $sizeof_minSizeInBits'(typeIR)

  6. Case (% has type newTypeIR)

    1. (Let (type _typeId typeIR) be (typeIR'' as newTypeIR))

    2. Return $sizeof_minSizeInBits'(typeIR)

  7. Case (% has type serializableEnumTypeIR)

    1. (Let (enum _typeId < typeIR > { _valueFieldIR* }) be (typeIR'' as serializableEnumTypeIR))

    2. Return $sizeof_minSizeInBits'(typeIR)

  8. Case (% has type tupleTypeIR)

    1. (Let (tuple < typeIR* >) be (typeIR'' as tupleTypeIR))

    2. Return $sum_nat($sizeof_minSizeInBits'(typeIR)*)

  9. Case (% has type arrayTypeIR)

    1. (Let (array typeIR [ n_size ]) be (typeIR'' as arrayTypeIR))

    2. Return ($sizeof_minSizeInBits'(typeIR) * n_size)

  10. Case (% has type headerStackTypeIR)

    1. (Let (header_stack typeIR [ n_size ]) be (typeIR'' as headerStackTypeIR))

    2. Return ($sizeof_minSizeInBits'(typeIR) * n_size)

  11. Case (% has type structTypeIR)

    1. (Let (struct _typeId < _typeArgumentIR* > { (_annotationList typeIR _nameIR ;)* }) be (typeIR'' as structTypeIR))

    2. Return $sum_nat($sizeof_minSizeInBits'(typeIR)*)

  12. Case (% has type headerTypeIR)

    1. (Let (header _typeId < _typeArgumentIR* > { (_annotationList typeIR _nameIR ;)* }) be (typeIR'' as headerTypeIR))

    2. Return $sum_nat($sizeof_minSizeInBits'(typeIR)*)

  13. Case (% has type headerUnionTypeIR)

    1. (Let (header_union _typeId < _typeArgumentIR* > { fieldTypeIR* }) be (typeIR'' as headerUnionTypeIR))

    2. If ((fieldTypeIR* matches pattern [])), then

      1. Return 0

    2. Else Phantom#513

    3. (Let (header_union _typeId < _typeArgumentIR* > { (_annotationList typeIR _nameIR ;)* }) be (typeIR'' as headerUnionTypeIR))

    4. If ((typeIR* =/= [])), then

      1. Return $max_nat($sizeof_minSizeInBits'(typeIR)*)

    4. Else Phantom#514

1. Else Phantom#515

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1131:1-1132:23:
dec $sizeof_minSizeInBytes(typeIR)

1. (Let n_size be $sizeof_minSizeInBits'(typeIR))

2. Return ((d ((n_size / 8) as int)) as value)

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1134:1-1135:23:
dec $sizeof_maxSizeInBits(typeIR)

1. Return ((d ($sizeof_maxSizeInBits'(typeIR) as int)) as value)

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1136:1-1137:23:
dec $sizeof_maxSizeInBits'(typeIR'')

1. Case analysis on typeIR''

  1. Case (% has type boolTypeIR)

    1. (Let boolTypeIR be (typeIR'' as boolTypeIR))

    2. If ((boolTypeIR matches pattern `BOOL`)), then

      1. Return 1

    2. Else Phantom#516

  2. Case (% has type fixedIntTypeIR)

    1. (Let (int < w >) be (typeIR'' as fixedIntTypeIR))

    2. Return w

  3. Case (% has type fixedBitTypeIR)

    1. (Let (bit < w >) be (typeIR'' as fixedBitTypeIR))

    2. Return w

  4. Case (% has type varBitTypeIR)

    1. (Let (varbit < w >) be (typeIR'' as varBitTypeIR))

    2. Return w

  5. Case (% has type typedefTypeIR)

    1. (Let (typedef _typeId typeIR) be (typeIR'' as typedefTypeIR))

    2. Return $sizeof_maxSizeInBits'(typeIR)

  6. Case (% has type newTypeIR)

    1. (Let (type _typeId typeIR) be (typeIR'' as newTypeIR))

    2. Return $sizeof_maxSizeInBits'(typeIR)

  7. Case (% has type serializableEnumTypeIR)

    1. (Let (enum _typeId < typeIR > { _valueFieldIR* }) be (typeIR'' as serializableEnumTypeIR))

    2. Return $sizeof_maxSizeInBits'(typeIR)

  8. Case (% has type tupleTypeIR)

    1. (Let (tuple < typeIR* >) be (typeIR'' as tupleTypeIR))

    2. Return $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

  9. Case (% has type arrayTypeIR)

    1. (Let (array typeIR [ n_size ]) be (typeIR'' as arrayTypeIR))

    2. Return ($sizeof_maxSizeInBits'(typeIR) * n_size)

  10. Case (% has type headerStackTypeIR)

    1. (Let (header_stack typeIR [ n_size ]) be (typeIR'' as headerStackTypeIR))

    2. Return ($sizeof_maxSizeInBits'(typeIR) * n_size)

  11. Case (% has type structTypeIR)

    1. (Let (struct _typeId < _typeArgumentIR* > { (_annotationList typeIR _nameIR ;)* }) be (typeIR'' as structTypeIR))

    2. Return $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

  12. Case (% has type headerTypeIR)

    1. (Let (header _typeId < _typeArgumentIR* > { (_annotationList typeIR _nameIR ;)* }) be (typeIR'' as headerTypeIR))

    2. Return $sum_nat($sizeof_maxSizeInBits'(typeIR)*)

  13. Case (% has type headerUnionTypeIR)

    1. (Let (header_union _typeId < _typeArgumentIR* > { fieldTypeIR* }) be (typeIR'' as headerUnionTypeIR))

    2. If ((fieldTypeIR* matches pattern [])), then

      1. Return 0

    2. Else Phantom#517

    3. (Let (header_union _typeId < _typeArgumentIR* > { (_annotationList typeIR _nameIR ;)* }) be (typeIR'' as headerUnionTypeIR))

    4. If ((typeIR* =/= [])), then

      1. Return $max_nat($sizeof_maxSizeInBits'(typeIR)*)

    4. Else Phantom#518

1. Else Phantom#519

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:1139:1-1140:23:
dec $sizeof_maxSizeInBytes(typeIR)

1. (Let n_size be $sizeof_maxSizeInBits'(typeIR))

2. Return ((d ((n_size / 8) as int)) as value)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:6:1-7:15:
syntax prefixedNameIR = 
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:9:1-10:44:
dec $prefixedNonTypeName(prefixedNonTypeName)

1. If ((prefixedNonTypeName has type nonTypeName)), then

  1. (Let nonTypeName be (prefixedNonTypeName as nonTypeName))

  2. Return ($name((nonTypeName as name)))

1. Else Phantom#520

2. If ((prefixedNonTypeName matches pattern `_ID . %`)), then

  1. (Let (. nonTypeName) be prefixedNonTypeName)

  2. Return (. $name((nonTypeName as name)))

2. Else Phantom#521

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:14:1-15:44:
dec $prefixedTypeName(prefixedTypeName)

1. If ((prefixedTypeName has type typeName)), then

  1. (Let typeName be (prefixedTypeName as typeName))

  2. Return ($name((typeName as name)))

1. Else Phantom#522

2. If ((prefixedTypeName matches pattern `_TID . %`)), then

  1. (Let (. typeName) be prefixedTypeName)

  2. Return (. $name((typeName as name)))

2. Else Phantom#523

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:19:1-20:42:
dec $flatten_prefixedNameIR(prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `_BARE %`)

    1. (Let (nameIR) be prefixedNameIR)

    2. Return nameIR

  2. Case (% matches pattern `. %`)

    1. (Let (. nameIR) be prefixedNameIR)

    2. Return "." ++ nameIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:24:21-24:28:
syntax nameListIR = nameIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:30:30-30:46:
syntax typeParameterListIR = typeParameterIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:36:26-36:38:
syntax parameterListIR = parameterIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:42:37-42:49:
syntax constructorParameterListIR = parameterIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:48:23-48:39:
syntax namedValueIR = 
   | nameIR = value (from namedValueIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:50:27-50:40:
syntax namedValueListIR = namedValueIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:56:28-56:56:
syntax namedExpressionIR = 
   | nameIR = typedExpressionIR (from namedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:58:32-58:50:
syntax namedExpressionListIR = namedExpressionIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:68:30-68:47:
syntax literalExpressionIR = literalExpression

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:74:32-74:46:
syntax referenceExpressionIR = prefixedNameIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:80:30-80:47:
syntax defaultExpressionIR = defaultExpression

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:86:28-86:50:
syntax unaryExpressionIR = 
   | unop typedExpressionIR (from unaryExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:89:3-89:44:
syntax binaryExpressionIR = 
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:92:3-92:64:
syntax ternaryExpressionIR = 
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR (from ternaryExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:98:27-98:57:
syntax castExpressionIR = 
   | ( typeIR ) typedExpressionIR (from castExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:106:36-106:59:
syntax invalidHeaderExpressionIR = invalidHeaderExpression

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:109:1-110:46:
syntax sequenceExpressionIR = 
   | seq { typedExpressionListIR } (from sequenceExpressionIR)
   | seq { typedExpressionListIR , ... } (from sequenceExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:113:1-114:49:
syntax recordExpressionIR = 
   | record { namedExpressionListIR } (from recordExpressionIR)
   | record { namedExpressionListIR , ... } (from recordExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:117:1-119:23:
syntax dataExpressionIR = 
   | {#} (from invalidHeaderExpression)
   | seq { typedExpressionListIR } (from sequenceExpressionIR)
   | seq { typedExpressionListIR , ... } (from sequenceExpressionIR)
   | record { namedExpressionListIR } (from recordExpressionIR)
   | record { namedExpressionListIR , ... } (from recordExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:128:3-128:19:
syntax errorAccessExpressionIR = 
   | error . nameIR (from errorAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:131:3-131:32:
syntax memberAccessExpressionIR = 
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:134:3-134:44:
syntax indexAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:137:3-137:70:
syntax sliceAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR sliceop typedExpressionIR ] (from sliceAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:140:1-143:28:
syntax accessExpressionIR = 
   | error . nameIR (from errorAccessExpressionIR)
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR sliceop typedExpressionIR ] (from sliceAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:154:1-157:27:
syntax callableTargetIR = 
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)
   | typedExpressionIR . nameIR (from callableTargetIR)
   | type prefixedNameIR . nameIR (from callableTargetIR)
   | ( callableTargetIR ) (from callableTargetIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:159:30-159:69:
syntax constructorTargetIR = 
   | prefixedNameIR < typeArgumentListIR > (from constructorTargetIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:162:1-163:67:
syntax callExpressionIR = 
   | constructorTargetIR ( argumentListIR ) (from callExpressionIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) (from callExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:169:36-169:59:
syntax parenthesizedExpressionIR = 
   | ( typedExpressionIR ) (from parenthesizedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:176:1-186:30:
syntax expressionIR = 
   | true (from booleanLiteral)
   | false (from booleanLiteral)
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)
   | ... (from defaultExpression)
   | unop typedExpressionIR (from unaryExpressionIR)
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR)
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR (from ternaryExpressionIR)
   | ( typeIR ) typedExpressionIR (from castExpressionIR)
   | {#} (from invalidHeaderExpression)
   | seq { typedExpressionListIR } (from sequenceExpressionIR)
   | seq { typedExpressionListIR , ... } (from sequenceExpressionIR)
   | record { namedExpressionListIR } (from recordExpressionIR)
   | record { namedExpressionListIR , ... } (from recordExpressionIR)
   | error . nameIR (from errorAccessExpressionIR)
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR sliceop typedExpressionIR ] (from sliceAccessExpressionIR)
   | constructorTargetIR ( argumentListIR ) (from callExpressionIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) (from callExpressionIR)
   | ( typedExpressionIR ) (from parenthesizedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:188:27-190:54:
syntax expressionNoteIR = 
   | ( typeIR ctk ) (from expressionNoteIR) hint(prose "a pair of type" %0 "and compile-time known-ness" %1) hint(prose_fields "type" "compile-time known-ness")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:193:3-196:41:
syntax typedExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:198:32-198:50:
syntax typedExpressionListIR = typedExpressionIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:201:1-202:22:
syntax memberAccessBaseIR = 
   | type prefixedNameIR (from memberAccessBaseIR)
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:204:1-205:34:
dec $type_of_typedExpressionIR(typedExpressionIR)

1. (Let (_expressionIR # (( typeIR _ctk ))) be typedExpressionIR)

2. Return typeIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:209:1-210:53:
dec $ctk_of_typedExpressionIR(typedExpressionIR)

1. (Let (_expressionIR # (( _typeIR ctk ))) be typedExpressionIR)

2. Return ctk

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:219:1-223:8:
syntax simpleKeysetExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR &&& typedExpressionIR (from simpleKeysetExpressionIR)
   | typedExpressionIR .. typedExpressionIR (from simpleKeysetExpressionIR)
   | default (from simpleKeysetExpressionIR)
   | _ (from simpleKeysetExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:225:39-225:64:
