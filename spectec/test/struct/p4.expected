dec $lift_nameIR_as_nonTypeName(text')

1. Case analysis on text'

  1. Case (% = "apply")

    1. Return ?((apply))

  2. Case (% = "key")

    1. Return ?((key))

  3. Case (% = "actions")

    1. Return ?((actions))

  4. Case (% = "state")

    1. Return ?((state))

  5. Case (% = "entries")

    1. Return ?((entries))

  6. Case (% = "type")

    1. Return ?((type))

  7. Case (% = "priority")

    1. Return ?((priority))

2. Otherwise

  1. Return ?(((text') as nonTypeName))

;; ../../../../../spectec/specs/p4/4-p4-ir/4.5-ir-to-surface.spectec:40:1-42:23:
dec $lift_prefixedNameIR_as_prefixedNonTypeName(prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `_BARE %`)

    1. (Let (nameIR) be prefixedNameIR)

    2. Return ($lift_nameIR_as_nonTypeName(nameIR) as prefixedNonTypeName?)

  2. Case (% matches pattern `. %`)

    1. (Let (. nameIR) be prefixedNameIR)

    2. (Let nonTypeName'? be $lift_nameIR_as_nonTypeName(nameIR))

    3. If ((nonTypeName'? matches pattern (_))), then

      1. (Let ?(nonTypeName) be nonTypeName'?)

      2. Return ?((. nonTypeName))

    3. Else Phantom#573

;; ../../../../../spectec/specs/p4/4-p4-ir/4.5-ir-to-surface.spectec:56:1-57:23:
