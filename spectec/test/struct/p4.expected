syntax callTargetValue = callTargetParameter*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:13:1-14:12:
syntax callTargetMatch = 
   | match id* id* (from callTargetMatch) hint(prose MATCH "with defaults" %0 and "optionals" %1)
   | nomatch (from callTargetMatch)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:17:3-18:75:
syntax callResolution<V> = 
   | callableId : V # nameIR* # nameIR* (from callResolution<V>) hint(prose_fields "call target id" "call target" "defaults" "optionals")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:20:1-21:55:
dec $callTargetKey(nameIR_f, argumentIR*)

1. (Let id_arg? be $callTargetKey'(argumentIR))*

2. Return (nameIR_f ( id_arg?* ))

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:22:1-22:38:
dec $callTargetKey'(argumentIR)

1. If ((argumentIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

  2. Return ?()

1. Else Phantom#547

2. Case analysis on argumentIR

  1. Case (% matches pattern `% = %`)

    1. (Let (id_arg = _typedExpressionIR) be argumentIR)

    2. Return ?(id_arg)

  2. Case (% matches pattern `% = _`)

    1. (Let (id_arg = _) be argumentIR)

    2. Return ?(id_arg)

  3. Case (% matches pattern `_`)

    1. Return ?()

2. Else Phantom#548

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:37:1-42:82:
dec $match_overloaded_named<V>((callTargetId : V), (nameIR_f ( id_arg* )), $get_parameterListIR)

1. (Let (nameIR ( id_param* )) be callTargetId)

2. If ((nameIR = nameIR_f)), then

  1. (Let parameterIR* be $get_parameterListIR(V))

  2. If ((id_param = $id_of_parameterIR(parameterIR)))*, then

    1. If ((|id_param*| = |id_arg*|)), then

      1. Return $ite<callTargetMatch>($eq_set<id>(({ id_param* }), ({ id_arg* })), (match [] []), (nomatch))

    2. (Let b_default be $is_default_parameterIR(parameterIR))*

    3. (Let b_optional be $is_optional_parameterIR(parameterIR))*

    4. If ((|id_param*| > |id_arg*|)), then

      1. (Let ({ id_param_omitted* }) be $diff_set<id>(({ id_param* }), ({ id_arg* })))

      2. (Let id_default_param* be $filter_<id>(id_param*, $is_default_parameterIR(parameterIR)*))

      3. (Let id_default* be $filter_<id>(id_param_omitted*, id_param_omitted is in id_default_param**))

      4. (Let id_optional_param* be $filter_<id>(id_param*, $is_optional_parameterIR(parameterIR)*))

      5. (Let id_optional* be $filter_<id>(id_param_omitted*, id_param_omitted is in id_optional_param**))

      6. If ($eq_set<id>(({ id_default* ++ id_optional* }), ({ id_param_omitted* }))), then

        1. Return (match id_default* id_optional*)

2. Otherwise

  1. Return (nomatch)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:106:1-111:84:
dec $match_overloaded_unnamed<V>((callTargetId : V), (nameIR_f ( n_arg )), $get_parameterListIR)

1. (Let (nameIR ( id_param* )) be callTargetId)

2. If ((nameIR = nameIR_f)), then

  1. (Let parameterIR* be $get_parameterListIR(V))

  2. (Let b_default be $is_default_parameterIR(parameterIR))*

  3. (Let b_optional be $is_optional_parameterIR(parameterIR))*

  4. If (~($exists_(b_default*) /\ $exists_(b_optional*))), then

    1. If ((|id_param*| = n_arg)), then

      1. Return (match [] [])

    2. If ((|id_param*| > n_arg)), then

      1. (Let (parameterIR_given*, parameterIR_omitted*) be $partition_<parameterIR>(parameterIR*, n_arg))

      2. If (~$is_optional_parameterIR(parameterIR_omitted))*, then

        1. If ($is_default_parameterIR(parameterIR_omitted))*, then

          1. (Let id_default be $id_of_parameterIR(parameterIR_omitted))*

          2. Return (match id_default* [])

      3. If (~$is_default_parameterIR(parameterIR_given))*, then

        1. If ($is_optional_parameterIR(parameterIR_omitted))*, then

          1. (Let id_optional be $id_of_parameterIR(parameterIR_omitted))*

          2. Return (match [] id_optional*)

2. Otherwise

  1. Return (nomatch)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:194:1-199:95:
dec $find_overloadeds_named<V>(set<pair<callableId, V>>', (nameIR_f ( id_arg* )), $get_parameterListIR)

1. If ((set<pair<callableId, V>>' = ({ [] }))), then

  1. Return []

1. Else Phantom#549

2. (Let ({ pair<callableId, V>* }) be set<pair<callableId, V>>')

3. If ((pair<callableId, V>* matches pattern _ :: _)), then

  1. (Let (callTargetId_h : V_h) :: (callTargetId_t : V_t)* be pair<callableId, V>*)

  2. If (((nomatch) = $match_overloaded_named<V>((callTargetId_h : V_h), (nameIR_f ( id_arg* )), $get_parameterListIR))), then

    1. Return $find_overloadeds_named<V>(({ (callTargetId_t : V_t)* }), (nameIR_f ( id_arg* )), $get_parameterListIR)

  2. Else Phantom#550

  3. (Let callTargetMatch be $match_overloaded_named<V>((callTargetId_h : V_h), (nameIR_f ( id_arg* )), $get_parameterListIR))

  4. If ((callTargetMatch matches pattern `MATCH % %`)), then

    1. (Let (match id_default* id_optional*) be callTargetMatch)

    2. Return (callTargetId_h : V_h # id_default* # id_optional*) :: $find_overloadeds_named<V>(({ (callTargetId_t : V_t)* }), (nameIR_f ( id_arg* )), $get_parameterListIR)

  4. Else Phantom#551

3. Else Phantom#552

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:240:1-245:97:
dec $find_overloadeds_unnamed<V>(set<pair<callableId, V>>', (nameIR_f ( nat' )), $get_parameterListIR)

1. If ((set<pair<callableId, V>>' = ({ [] }))), then

  1. Return []

1. Else Phantom#553

2. (Let ({ pair<callableId, V>* }) be set<pair<callableId, V>>')

3. If ((pair<callableId, V>* matches pattern _ :: _)), then

  1. (Let (callTargetId_h : V_h) :: (callTargetId_t : V_t)* be pair<callableId, V>*)

  2. If (((nomatch) = $match_overloaded_unnamed<V>((callTargetId_h : V_h), (nameIR_f ( nat' )), $get_parameterListIR))), then

    1. Return $find_overloadeds_unnamed<V>(({ (callTargetId_t : V_t)* }), (nameIR_f ( nat' )), $get_parameterListIR)

  2. Else Phantom#554

  3. (Let callTargetMatch be $match_overloaded_unnamed<V>((callTargetId_h : V_h), (nameIR_f ( nat' )), $get_parameterListIR))

  4. If ((callTargetMatch matches pattern `MATCH % %`)), then

    1. (Let (match id_default* id_optional*) be callTargetMatch)

    2. Return (callTargetId_h : V_h # id_default* # id_optional*) :: $find_overloadeds_unnamed<V>(({ (callTargetId_t : V_t)* }), (nameIR_f ( nat' )), $get_parameterListIR)

  4. Else Phantom#555

3. Else Phantom#556

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:286:1-291:84:
dec $find_overloaded<V>(({ (callableId : V)* }), (nameIR_f ( id_arg?* )), $get_parameterListIR)

1. If ((|id_arg?*| > 0)), then

  1. (Let id? be id_arg?)*

  2. If ((id? matches pattern (_)))*, then

    1. (Let ?(id_arg_inner) be id?)*

    2. If (([] = $find_overloadeds_named<V>(({ (callableId : V)* }), (nameIR_f ( id_arg_inner* )), $get_parameterListIR))), then

      1. Return ?()

    2. Else Phantom#557

    3. (Let callResolution<V>* be $find_overloadeds_named<V>(({ (callableId : V)* }), (nameIR_f ( id_arg_inner* )), $get_parameterListIR))

    4. If ((callResolution<V>* matches pattern [ _/1 ])), then

      1. (Let [(callableId_found : V_found # id_default* # id_optional*)] be callResolution<V>*)

      2. Return ?((callableId_found : V_found # id_default* # id_optional*))

    4. Else Phantom#558

  2. Else Phantom#559

1. Else Phantom#560

2. If ((id_arg? = ?()))*, then

  1. If (([] = $find_overloadeds_unnamed<V>(({ (callableId : V)* }), (nameIR_f ( |id_arg?*| )), $get_parameterListIR))), then

    1. Return ?()

  1. Else Phantom#561

  2. (Let callResolution<V>* be $find_overloadeds_unnamed<V>(({ (callableId : V)* }), (nameIR_f ( |id_arg?*| )), $get_parameterListIR))

  3. If ((callResolution<V>* matches pattern [ _/1 ])), then

    1. (Let [(callableId_found : V_found # id_omitted* # id_optional*)] be callResolution<V>*)

    2. Return ?((callableId_found : V_found # id_omitted* # id_optional*))

  3. Else Phantom#562

2. Else Phantom#563

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:351:1-352:21:
dec $find_non_overloaded<V>(({ (callableId : V)* }), nameIR_f)

1. (Let (callableId, V)* be $find_non_overloadeds<V>(({ (callableId : V)* }), nameIR_f))

2. If (((callableId, V)* matches pattern [ _/1 ])), then

  1. (Let [(callableId_found, V_found)] be (callableId, V)*)

  2. Return ?((callableId_found, V_found))

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/4-p4-ir/4.2-ir-call-overload.spectec:353:1-354:21:
dec $find_non_overloadeds<V>(set<pair<callableId, V>>', nameIR_f)

1. If ((set<pair<callableId, V>>' = ({ [] }))), then

  1. Return []

1. Else Phantom#564

2. (Let ({ pair<callableId, V>* }) be set<pair<callableId, V>>')

3. If ((pair<callableId, V>* matches pattern _ :: _)), then

  1. (Let (callableId_h : V_h) :: (callableId_t : V_t)* be pair<callableId, V>*)

  2. (Let (nameIR ( _id* )) be callableId_h)

  3. Case analysis on nameIR

    1. Case (% = nameIR_f)

      1. (Let (callableId_t_found, V_t_found)* be $find_non_overloadeds<V>(({ (callableId_t : V_t)* }), nameIR_f))

      2. Return (callableId_h, V_h) :: (callableId_t_found, V_t_found)*

    2. Case (% =/= nameIR_f)

      1. (Let (callableId_t_found, V_t_found)* be $find_non_overloadeds<V>(({ (callableId_t : V_t)* }), nameIR_f))

      2. Return (callableId_t_found, V_t_found)*

3. Else Phantom#565

;; ../../../../../spectec/specs/p4/4-p4-ir/4.3-annotation.spectec:7:1-7:47:
dec $name_annotation(annotationList)

1. (Let annotation* be $flatten_annotationList(annotationList))

2. (Let nameIR_opt? be $name_annotation_opt(annotation))*

3. (Let nameIR_found** be $opt_as_seq_<nameIR>(nameIR_opt?)*)

4. Return $concat_<nameIR>(nameIR_found**)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.3-annotation.spectec:8:1-8:47:
dec $name_annotation_opt(annotation)

1. If ((annotation matches pattern `@ % (%)`)), then

  1. (Let (@ name ( annotationBody )) be annotation)

  2. If (("name" = $name(name))), then

    1. If ((annotationBody matches pattern `% %`)), then

      1. (Let (annotationBody' annotationToken) be annotationBody)

      2. If ((annotationBody' matches pattern `_EMPTY`)), then

        1. If ((annotationToken has type stringLiteral)), then

          1. (Let (" text ") be (annotationToken as stringLiteral))

          2. Return ?(text)

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/4-p4-ir/4.3-annotation.spectec:9:1-9:62:
dec $name_annotation_default(annotationList, nameIR)

1. (Let nameIR'* be $name_annotation(annotationList))

2. If ((nameIR'* matches pattern [ _/1 ])), then

  1. (Let [nameIR_found] be nameIR'*)

  2. Return nameIR_found

2. Else Phantom#566

3. If (([] = $name_annotation(annotationList))), then

  1. Return nameIR

3. Else Phantom#567

;; ../../../../../spectec/specs/p4/4-p4-ir/4.3-annotation.spectec:32:1-34:59:
dec $has_at_most_one_name_annotation(annotationList)

1. Return (|$name_annotation(annotationList)| <= 1)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.3-annotation.spectec:40:1-40:60:
dec $find_name_annotation_opt(annotationList')

1. If ((annotationList' matches pattern `_EMPTY`)), then

  1. Return ?()

2. If ((annotationList' has type annotation)), then

  1. (Let annotation be (annotationList' as annotation))

  2. If ((annotation matches pattern `@ % (%)`)), then

    1. (Let (@ name ( annotationBody )) be annotation)

    2. Case analysis on "name"

      1. Case (% = $name(name))

        1. Return ?(annotation)

      2. Case (% =/= $name(name))

        1. Return ?()

3. If ((annotationList' has type annotationListNonEmpty)), then

  1. (Let annotationListNonEmpty' be (annotationList' as annotationListNonEmpty))

  2. If ((annotationListNonEmpty' matches pattern `% %`)), then

    1. (Let (annotationListNonEmpty annotation) be annotationListNonEmpty')

    2. If ((?() = $find_name_annotation_opt((annotation as annotationList)))), then

      1. Return $find_name_annotation_opt((annotationListNonEmpty as annotationList))

    3. (Let annotation'? be $find_name_annotation_opt((annotation as annotationList)))

    4. If ((annotation'? matches pattern (_))), then

      1. (Let ?(annotation_found) be annotation'?)

      2. Return ?(annotation_found)

4. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/4-p4-ir/4.3-annotation.spectec:59:1-59:70:
dec $add_annotationList(annotationList, annotation''?)

1. If ((annotation''? matches pattern ())), then

  1. Return annotationList

1. Else Phantom#568

2. If ((annotationList matches pattern `_EMPTY`)), then

  1. If ((annotation''? matches pattern (_))), then

    1. (Let ?(annotation) be annotation''?)

    2. Return (annotation as annotationList)

  1. Else Phantom#569

2. Else Phantom#570

3. If ((annotationList has type annotationListNonEmpty)), then

  1. (Let annotationListNonEmpty be (annotationList as annotationListNonEmpty))

  2. If ((annotation''? matches pattern (_))), then

    1. (Let ?(annotation) be annotation''?)

    2. Return ((annotationListNonEmpty annotation) as annotationList)

  2. Else Phantom#571

3. Else Phantom#572

;; ../../../../../spectec/specs/p4/4-p4-ir/4.4-ir-subexpression.spectec:5:1-7:45:
dec $subexpressions_of_typedExpressionIR(typedExpressionIR)

1. (Let (expressionIR # _expressionNoteIR) be typedExpressionIR)

2. Return typedExpressionIR :: $subexpressions_of_expressionIR(expressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.4-ir-subexpression.spectec:9:1-11:45:
dec $subexpressions_of_typedExpressionListIR(typedExpressionIR*)

1. Return $concat_<typedExpressionIR>($subexpressions_of_typedExpressionIR(typedExpressionIR)*)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.4-ir-subexpression.spectec:13:1-15:45:
dec $subexpressions_of_expressionIR(expressionIR')

1. Case analysis on expressionIR'

  1. Case (% has type unaryExpressionIR)

    1. (Let (unop typedExpressionIR) be (expressionIR' as unaryExpressionIR))

    2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

  2. Case (% has type binaryExpressionIR)

    1. (Let (typedExpressionIR_l binop typedExpressionIR_r) be (expressionIR' as binaryExpressionIR))

    2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR_l) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_r)

  3. Case (% has type ternaryExpressionIR)

    1. (Let (typedExpressionIR_cond ? typedExpressionIR_then : typedExpressionIR_else) be (expressionIR' as ternaryExpressionIR))

    2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR_cond) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_then) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_else)

  4. Case (% has type castExpressionIR)

    1. (Let (( typeIR ) typedExpressionIR) be (expressionIR' as castExpressionIR))

    2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

  5. Case (% has type sequenceExpressionIR)

    1. (Let sequenceExpressionIR be (expressionIR' as sequenceExpressionIR))

    2. Case analysis on sequenceExpressionIR

      1. Case (% matches pattern `SEQ {%}`)

        1. (Let (seq { typedExpressionListIR }) be sequenceExpressionIR)

        2. Return $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

      2. Case (% matches pattern `SEQ {% , ...}`)

        1. (Let (seq { typedExpressionListIR , ... }) be sequenceExpressionIR)

        2. Return $subexpressions_of_typedExpressionListIR(typedExpressionListIR)

  6. Case (% has type recordExpressionIR)

    1. (Let recordExpressionIR be (expressionIR' as recordExpressionIR))

    2. Case analysis on recordExpressionIR

      1. Case (% matches pattern `RECORD {%}`)

        1. (Let (record { (nameIR = typedExpressionIR)* }) be recordExpressionIR)

        2. Return $subexpressions_of_typedExpressionListIR(typedExpressionIR*)

      2. Case (% matches pattern `RECORD {% , ...}`)

        1. (Let (record { (nameIR = typedExpressionIR)* , ... }) be recordExpressionIR)

        2. Return $subexpressions_of_typedExpressionListIR(typedExpressionIR*)

  7. Case (% has type memberAccessExpressionIR)

    1. (Let (memberAccessBaseIR . nameIR) be (expressionIR' as memberAccessExpressionIR))

    2. If ((memberAccessBaseIR has type typedExpressionIR)), then

      1. (Let typedExpressionIR be (memberAccessBaseIR as typedExpressionIR))

      2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

  8. Case (% has type indexAccessExpressionIR)

    1. (Let (typedExpressionIR_base [ typedExpressionIR_index ]) be (expressionIR' as indexAccessExpressionIR))

    2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_index)

  9. Case (% has type sliceAccessExpressionIR)

    1. (Let (typedExpressionIR_base [ typedExpressionIR_hi sliceop typedExpressionIR_lo ]) be (expressionIR' as sliceAccessExpressionIR))

    2. If ((sliceop matches pattern `:`)), then

      1. Return $subexpressions_of_typedExpressionIR(typedExpressionIR_base) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_hi) ++ $subexpressions_of_typedExpressionIR(typedExpressionIR_lo)

  10. Case (% has type callExpressionIR)

    1. (Let callExpressionIR be (expressionIR' as callExpressionIR))

    2. Case analysis on callExpressionIR

      1. Case (% matches pattern `% (%)`)

        1. (Let (constructorTargetIR ( argumentIR* )) be callExpressionIR)

        2. Return $subexpressions_of_argumentListIR(argumentIR*)

      2. Case (% matches pattern `% <%> (%)`)

        1. (Let (callableTargetIR < typeArgumentIR* > ( argumentIR* )) be callExpressionIR)

        2. Return $subexpressions_of_argumentListIR(argumentIR*)

  11. Case (% has type parenthesizedExpressionIR)

    1. (Let (( typedExpressionIR )) be (expressionIR' as parenthesizedExpressionIR))

    2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

2. Otherwise

  1. Return []

;; ../../../../../spectec/specs/p4/4-p4-ir/4.4-ir-subexpression.spectec:17:1-19:45:
dec $subexpressions_of_argumentIR(argumentIR')

1. If ((argumentIR' has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR' as typedExpressionIR))

  2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

2. If ((argumentIR' matches pattern `% = %`)), then

  1. (Let (nameIR = typedExpressionIR) be argumentIR')

  2. Return $subexpressions_of_typedExpressionIR(typedExpressionIR)

3. Otherwise

  1. Return []

;; ../../../../../spectec/specs/p4/4-p4-ir/4.4-ir-subexpression.spectec:21:1-23:45:
dec $subexpressions_of_argumentListIR(argumentIR*)

1. Return $concat_<typedExpressionIR>($subexpressions_of_argumentIR(argumentIR)*)

