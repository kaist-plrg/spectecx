        2. Result in EC_2, ARCH_2, statementResult

      2. Else Phantom#2384

    5. Else Phantom#2385

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:384:1-391:42:
relation ForThreeClauseStmt_eval: EC_0, ARCH_0, typedExpressionIR, statementIR, forUpdateStatementListIR

1. (Expr_eval: (local) EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

2. If ((expressionResult has type abortResult)), then

  1. (Let abortResult be (expressionResult as abortResult))

  2. Result in EC_1, ARCH_1, (abortResult as statementResult)

2. Else Phantom#2386

3. If ((expressionResult = ((((false) as value)) as expressionResult))), then

  1. Result in EC_1, ARCH_1, (() as statementResult)

3. Else Phantom#2387

4. If ((expressionResult = ((((true) as value)) as expressionResult))), then

  1. (Stmt_eval: (local) EC_1 ARCH_1 |- statementIR : EC_2 ARCH_2 statementResult)

  2. Case analysis on statementResult

    1. Case (% has type abortResult)

      1. (Let abortResult be (statementResult as abortResult))

      2. Result in EC_2, ARCH_2, (abortResult as statementResult)

    2. Case (% has type returnResult)

      1. (Let returnResult be (statementResult as returnResult))

      2. Result in EC_2, ARCH_2, (returnResult as statementResult)

    3. Case (% has type forBreakResult)

      1. (Let forBreakResult be (statementResult as forBreakResult))

      2. If ((forBreakResult matches pattern `BREAK`)), then

        1. Result in EC_2, ARCH_2, (() as statementResult)

      2. Else Phantom#2388

  2. Else Phantom#2389

  3. (Stmt_eval: (local) EC_1 ARCH_1 |- statementIR : EC_2 ARCH_2 statementResult_loop)

  4. If (((statementResult_loop = (() as statementResult)) \/ (statementResult_loop = ((continue) as statementResult)))), then

    1. (ForUpdateStmts_eval: EC_2 ARCH_2 |- forUpdateStatementListIR : EC_3 ARCH_3 statementResult)

    2. If ((statementResult has type exitResult)), then

      1. (Let exitResult be (statementResult as exitResult))

      2. If ((exitResult matches pattern `EXIT`)), then

        1. Result in EC_3, ARCH_3, ((exit) as statementResult)

      2. Else Phantom#2390

    2. Else Phantom#2391

    3. (ForUpdateStmts_eval: EC_2 ARCH_2 |- forUpdateStatementListIR : EC_3 ARCH_3 statementResult')

    4. If ((statementResult' has type continueEmptyResult)), then

      1. (Let continueEmptyResult be (statementResult' as continueEmptyResult))

      2. If ((continueEmptyResult matches pattern `_EMPTY`)), then

        1. (ForThreeClauseStmt_eval: EC_3 ARCH_3 |- typedExpressionIR statementIR forUpdateStatementListIR : EC_4 ARCH_4 statementResult)

        2. Result in EC_4, ARCH_4, statementResult

      2. Else Phantom#2392

    4. Else Phantom#2393

  4. Else Phantom#2394

4. Else Phantom#2395

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:510:1-517:42:
relation ForCollectionExpr_eval: EC_0, ARCH_0, forCollectionExpressionIR

1. If ((forCollectionExpressionIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (forCollectionExpressionIR as typedExpressionIR))

  2. (Expr_eval: (local) EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

  3. Case analysis on expressionResult

    1. Case (% has type abortResult)

      1. (Let abortResult be (expressionResult as abortResult))

      2. Result in EC_1, ARCH_1, (abortResult as expressionListResult)

    2. Case (% has type continueResult<value>)

      1. (Let (value') be (expressionResult as continueResult<value>))

      2. Case analysis on value'

        1. Case (% has type listValue)

          1. (Let listValue be (value' as listValue))

          2. (Let (list [ value* ]) be listValue)

          3. Result in EC_1, ARCH_1, ((value*) as expressionListResult)

        2. Case (% has type arrayValue)

          1. (Let arrayValue be (value' as arrayValue))

          2. (Let (array [ value* ]) be arrayValue)

          3. Result in EC_1, ARCH_1, ((value*) as expressionListResult)

        3. Case (% has type headerStackValue)

          1. (Let headerStackValue be (value' as headerStackValue))

          2. (Let (header_stack [ value* ( _nat ) ]) be headerStackValue)

          3. Result in EC_1, ARCH_1, ((value*) as expressionListResult)

      2. Else Phantom#2396

1. Else Phantom#2397

2. If ((forCollectionExpressionIR matches pattern `% .. %`)), then

  1. (Let (typedExpressionIR_l .. typedExpressionIR_r) be forCollectionExpressionIR)

  2. (Expr_eval: (local) EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult)

  3. Case analysis on expressionResult

    1. Case (% has type abortResult)

      1. (Let abortResult be (expressionResult as abortResult))

      2. Result in EC_1, ARCH_1, (abortResult as expressionListResult)

    2. Case (% has type continueResult<value>)

      1. (Let (value_l) be (expressionResult as continueResult<value>))

      2. (Expr_eval: (local) EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult')

      3. Case analysis on expressionResult'

        1. Case (% has type abortResult)

          1. (Let abortResult be (expressionResult' as abortResult))

          2. Result in EC_2, ARCH_2, (abortResult as expressionListResult)

        2. Case (% has type continueResult<value>)

          1. (Let (value_r) be (expressionResult' as continueResult<value>))

          2. (Let typeIR be $type_of_typedExpressionIR(typedExpressionIR_l))

          3. (Let value* be $values_of_setValue((set < typeIR >), (set { value_l .. value_r })))

          4. Result in EC_2, ARCH_2, ((value*) as expressionListResult)

2. Else Phantom#2398

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:556:1-557:49:
dec $values_of_setValue((set < typeIR >), setValue)

1. If ((setValue matches pattern `SET {% .. %}`)), then

  1. (Let (set { value_l .. value_r }) be setValue)

  2. If ($bin_lt(value_l, value_r)), then

    1. (Let value_one be $cast_op(typeIR, ((d (1 as int)) as value)))

    2. (Let value_l_inc be $bin_plus(value_l, value_one))

    3. Return value_l :: $values_of_setValue((set < typeIR >), (set { value_l_inc .. value_r }))

  2. Else Phantom#2399

  3. If ($bin_eq(value_l, value_r)), then

    1. Return [value_l]

  3. Else Phantom#2400

  4. If ($bin_gt(value_l, value_r)), then

    1. Return []

  4. Else Phantom#2401

1. Else Phantom#2402

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:602:1-609:42:
relation ForInStmt_eval: EC', ARCH', nameIR, value*, statementIR

1. Case analysis on value*

  1. Case (% matches pattern [])

    1. Result in EC', ARCH', (() as statementResult)

  2. Case (% matches pattern _ :: _)

    1. (Let value_h :: value_t* be value*)

    2. (Let EC_1 be $update_var_e((local), EC', (nameIR), value_h))

    3. (Stmt_eval: (local) EC_1 ARCH' |- statementIR : EC_2 ARCH_1 statementResult)

    4. Case analysis on statementResult

      1. Case (% has type abortResult)

        1. (Let abortResult be (statementResult as abortResult))

        2. Result in EC_2, ARCH_1, (abortResult as statementResult)

      2. Case (% has type returnResult)

        1. (Let returnResult be (statementResult as returnResult))

        2. Result in EC_2, ARCH_1, (returnResult as statementResult)

      3. Case (% has type forBreakResult)

        1. (Let forBreakResult be (statementResult as forBreakResult))

        2. If ((forBreakResult matches pattern `BREAK`)), then

          1. Result in EC_2, ARCH_1, (() as statementResult)

        2. Else Phantom#2403

    4. Else Phantom#2404

    5. (Stmt_eval: (local) EC_1 ARCH' |- statementIR : EC_2 ARCH_1 statementResult_loop)

    6. If (((statementResult_loop = (() as statementResult)) \/ (statementResult_loop = ((continue) as statementResult)))), then

      1. (ForInStmt_eval: EC_2 ARCH_1 |- nameIR value_t* statementIR : EC_3 ARCH_2 statementResult)

      2. Result in EC_3, ARCH_2, statementResult

    6. Else Phantom#2405

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:714:1-717:26:
relation Switch_table_eval: EC_0, ARCH_0, id_enum, switchCaseIR*

1. (SwitchCases_table_eval: id_enum |- switchCaseIR* : blockStatementIR?)

2. If ((blockStatementIR? matches pattern ())), then

  1. Result in EC_0, ARCH_0, (() as statementResult)

2. Else Phantom#2406

3. (SwitchCases_table_eval: id_enum |- switchCaseIR* : blockStatementIR'?)

4. If ((blockStatementIR'? matches pattern (_))), then

  1. (Let ?(blockStatementIR) be blockStatementIR'?)

  2. (Stmt_eval: (local) EC_0 ARCH_0 |- (blockStatementIR as statementIR) : EC_1 ARCH_1 statementResult)

  3. Result in EC_1, ARCH_1, statementResult

4. Else Phantom#2407

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:723:1-725:43:
dec $match_switchLabelIR_table(id, switchLabelIR')

1. If ((switchLabelIR' matches pattern `DEFAULT`)), then

  1. Return true

2. If ((switchLabelIR' has type typedExpressionIR)), then

  1. (Let (expressionIR # _expressionNoteIR) be (switchLabelIR' as typedExpressionIR))

  2. If ((expressionIR has type prefixedNameIR)), then

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

    2. If ((prefixedNameIR matches pattern `_BARE %`)), then

      1. (Let (id') be prefixedNameIR)

      2. If ((id = id')), then

        1. Return true

3. Otherwise

  1. Return false

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:735:1-739:41:
relation SwitchCases_table_eval: id, switchCaseIR*

1. Case analysis on switchCaseIR*

  1. Case (% matches pattern [])

    1. Result in ?()

  2. Case (% matches pattern _ :: _)

    1. (Let switchCaseIR_h :: switchCaseIR_t* be switchCaseIR*)

    2. Case analysis on switchCaseIR_h

      1. Case (% matches pattern `% : %`)

        1. (Let (switchLabelIR_h : blockStatementIR_h) be switchCaseIR_h)

        2. Case analysis on $match_switchLabelIR_table(id, switchLabelIR_h)

          1. Case true

            1. Result in ?(blockStatementIR_h)

          2. Case false

            1. (SwitchCases_table_eval: id |- switchCaseIR_t* : blockStatementIR?)

            2. Result in blockStatementIR?

      2. Case (% matches pattern `% :`)

        1. (Let (switchLabelIR_h :) be switchCaseIR_h)

        2. Case analysis on $match_switchLabelIR_table(id, switchLabelIR_h)

          1. Case true

            1. (Let switchCaseIR'''* be $filter_<switchCaseIR>(switchCaseIR_t*, $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*))

            2. If ((switchCaseIR'''* matches pattern _ :: _)), then

              1. (Let switchCaseIR'' :: _switchCaseIR* be switchCaseIR'''*)

              2. If ((switchCaseIR'' matches pattern `% : %`)), then

                1. (Let (_switchLabelIR : blockStatementIR) be switchCaseIR'')

                2. Result in ?(blockStatementIR)

              2. Else Phantom#2408

            2. Else Phantom#2409

            3. If (([] = $filter_<switchCaseIR>(switchCaseIR_t*, $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*))), then

              1. Result in ?()

            3. Else Phantom#2410

          2. Case false

            1. (SwitchCases_table_eval: id |- switchCaseIR_t* : blockStatementIR?)

            2. Result in blockStatementIR?

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:741:1-743:48:
dec $is_non_fallthrough_switchCaseIR(switchCaseIR)

1. Case analysis on switchCaseIR

  1. Case (% matches pattern `% : %`)

    1. (Let (switchLabelIR : blockStatementIR) be switchCaseIR)

    2. Return true

  2. Case (% matches pattern `% :`)

    1. (Let (switchLabelIR :) be switchCaseIR)

    2. Return false

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:823:1-826:26:
relation Switch_general_eval: EC_0, ARCH_0, value, switchCaseIR*

1. (SwitchCases_general_eval: (local) EC_0 ARCH_0 value |- switchCaseIR* : EC_1 ARCH_1 blockStatementIR?)

2. If ((blockStatementIR? matches pattern ())), then

  1. Result in EC_1, ARCH_1, (() as statementResult)

2. Else Phantom#2411

3. (SwitchCases_general_eval: (local) EC_0 ARCH_0 value |- switchCaseIR* : EC_1 ARCH_1 blockStatementIR'?)

4. If ((blockStatementIR'? matches pattern (_))), then

  1. (Let ?(blockStatementIR) be blockStatementIR'?)

  2. (Stmt_eval: (local) EC_1 ARCH_1 |- (blockStatementIR as statementIR) : EC_2 ARCH_2 statementResult)

  3. Result in EC_2, ARCH_2, statementResult

4. Else Phantom#2412

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:832:1-839:42:
relation SwitchLabel_general_eval: cursor, EC_0, ARCH_0, switchLabelIR

1. If ((cursor matches pattern `LOCAL`)), then

  1. If ((switchLabelIR matches pattern `DEFAULT`)), then

    1. Result in EC_0, ARCH_0, ((((default) as value)) as expressionResult)

  1. Else Phantom#2413

  2. If ((switchLabelIR has type typedExpressionIR)), then

    1. (Let typedExpressionIR be (switchLabelIR as typedExpressionIR))

    2. (Expr_eval: (local) EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

    3. Result in EC_1, ARCH_1, expressionResult

  2. Else Phantom#2414

1. Else Phantom#2415

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:854:1-856:43:
dec $match_switchLabelIR_general(value'', value''')

1. If ((value''' has type defaultValue)), then

  1. (Let defaultValue be (value''' as defaultValue))

  2. If ((defaultValue matches pattern `DEFAULT`)), then

    1. Return true

  2. Else Phantom#2416

1. Else Phantom#2417

2. If ((value''' =/= ((default) as value))), then

  1. Return $bin_eq(value'', value''')

2. Else Phantom#2418

;; ../../../../../spectec/specs/p4/8-dynamic/8.06-eval-statement.spectec:861:1-869:42:
relation SwitchCases_general_eval: cursor, EC_0, ARCH_0, value, switchCaseIR*

1. If ((cursor matches pattern `LOCAL`)), then

  1. Case analysis on switchCaseIR*

    1. Case (% matches pattern [])

      1. Result in EC_0, ARCH_0, ?()

    2. Case (% matches pattern _ :: _)

      1. (Let switchCaseIR_h :: switchCaseIR_t* be switchCaseIR*)

      2. Case analysis on switchCaseIR_h

        1. Case (% matches pattern `% : %`)

          1. (Let (switchLabelIR_h : blockStatementIR_h) be switchCaseIR_h)

          2. (SwitchLabel_general_eval: (local) EC_0 ARCH_0 |- switchLabelIR_h : EC_1 ARCH_1 expressionResult)

          3. If ((expressionResult has type continueResult<value>)), then

            1. (Let (value_label) be (expressionResult as continueResult<value>))

            2. Case analysis on $match_switchLabelIR_general(value, value_label)

              1. Case true

                1. Result in EC_1, ARCH_1, ?(blockStatementIR_h)

              2. Case false

                1. (SwitchCases_general_eval: (local) EC_1 ARCH_1 value |- switchCaseIR_t* : EC_2 ARCH_2 blockStatementIR?)

                2. Result in EC_2, ARCH_2, blockStatementIR?

          3. Else Phantom#2419

        2. Case (% matches pattern `% :`)

          1. (Let (switchLabelIR_h :) be switchCaseIR_h)

          2. (SwitchLabel_general_eval: (local) EC_0 ARCH_0 |- switchLabelIR_h : EC_1 ARCH_1 expressionResult)

          3. If ((expressionResult has type continueResult<value>)), then

            1. (Let (value_label) be (expressionResult as continueResult<value>))

            2. Case analysis on $match_switchLabelIR_general(value, value_label)

              1. Case true

                1. (Let switchCaseIR'''* be $filter_<switchCaseIR>(switchCaseIR_t*, $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*))

                2. If ((switchCaseIR'''* matches pattern _ :: _)), then

                  1. (Let switchCaseIR'' :: _switchCaseIR* be switchCaseIR'''*)

                  2. If ((switchCaseIR'' matches pattern `% : %`)), then

                    1. (Let (_switchLabelIR : blockStatementIR) be switchCaseIR'')

                    2. Result in EC_1, ARCH_1, ?(blockStatementIR)

                  2. Else Phantom#2420

                2. Else Phantom#2421

                3. If (([] = $filter_<switchCaseIR>(switchCaseIR_t*, $is_non_fallthrough_switchCaseIR(switchCaseIR_t)*))), then

                  1. Result in EC_1, ARCH_1, ?()

                3. Else Phantom#2422

              2. Case false

                1. (SwitchCases_general_eval: (local) EC_1 ARCH_1 value |- switchCaseIR_t* : EC_2 ARCH_2 blockStatementIR?)

                2. Result in EC_2, ARCH_2, blockStatementIR?

          3. Else Phantom#2423

1. Else Phantom#2424

;; ../../../../../spectec/specs/p4/8-dynamic/8.08.1-eval-parser-statement.spectec:8:1-9:27:
syntax selectCaseMatchResult = 
   | nameIR? (from continueResult<nameIR?>)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.08.1-eval-parser-statement.spectec:11:1-16:67:
relation SelectCase_match: EC_0, ARCH_0, value_key*, (keysetExpressionIR : nameIR ;)

