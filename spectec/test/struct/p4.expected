dec $add_object_e(ARCH, objectId, object)

1. (Let STO be $add_map<objectId, object>(ARCH.store, objectId, object))

2. Return ARCH[store = STO]

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:29:1-29:40:
dec $find_archState_e(ARCH)

1. Return ARCH.state

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:32:1-33:41:
dec $find_object_e(ARCH, objectId)

1. Return $find_map<objectId, object>(ARCH.store, objectId)

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:37:1-37:55:
dec $find_object_qualified_e(ARCH, objectId)

1. Return $find_object_e(ARCH, objectId)

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:41:1-41:51:
dec $find_object_unqualified_e(ARCH, id)

1. (Let ({ (objectId : object)* }) be ARCH.store)

2. (Let object_id? be $ite<object?>($objectId_ends_with(objectId, id), ?(object), ?()))*

3. (Let object''?* be $filter_<object?>(object_id?*, (object_id? =/= ?())*))

4. If ((object''?* matches pattern [ _/1 ])), then

  1. (Let [object'?] be object''?*)

  2. If ((object'? matches pattern (_))), then

    1. (Let ?(object_id_found) be object'?)

    2. Return ?(object_id_found)

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:51:1-51:55:
dec $find_objectState_e(ARCH, objectId)

1. (Let object'? be $find_object_e(ARCH, objectId))

2. If ((object'? matches pattern (_))), then

  1. (Let ?(object) be object'?)

  2. If ((object has type externObject)), then

    1. (Let externObject be (object as externObject))

    2. (Let (extern _typeId < _theta > { objectState _frame _externMethodDefEnv }) be externObject)

    3. Return ?(objectState)

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:63:1-63:48:
dec $update_archState_e(ARCH, archState)

1. Return ARCH[state = archState]

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:66:1-66:62:
dec $update_object_qualified_e(ARCH_0, objectId, object)

1. If ((?() =/= $find_object_qualified_e(ARCH_0, objectId))), then

  1. (Let ARCH_1 be $add_object_e(ARCH_0, objectId, object))

  2. Return ARCH_1

1. Else Phantom#2013

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:72:1-72:58:
dec $update_object_unqualified_e(ARCH_0, id, object)

1. (Let ({ (objectId : _object)* }) be ARCH_0.store)

2. (Let objectId_id? be $ite<objectId?>($objectId_ends_with(objectId, id), ?(objectId), ?()))*

3. (Let objectId''?* be $filter_<objectId?>(objectId_id?*, (objectId_id? =/= ?())*))

4. If ((objectId''?* matches pattern [ _/1 ])), then

  1. (Let [objectId'?] be objectId''?*)

  2. If ((objectId'? matches pattern (_))), then

    1. (Let ?(objectId_found) be objectId'?)

    2. (Let ARCH_1 be $add_object_e(ARCH_0, objectId_found, object))

    3. Return ARCH_1

  2. Else Phantom#2014

4. Else Phantom#2015

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:82:1-82:63:
dec $update_objectState_e(ARCH_0', objectId, objectState)

1. (Let object'? be $find_object_e(ARCH_0', objectId))

2. If ((object'? matches pattern (_))), then

  1. (Let ?(object) be object'?)

  2. If ((object has type externObject)), then

    1. (Let externObject be (object as externObject))

    2. (Let (extern typeId < theta > { _objectState frame externMethodDefEnv }) be externObject)

    3. (Let externObject_update be (extern typeId < theta > { objectState frame externMethodDefEnv }))

    4. (Let ARCH_1 be $add_object_e(ARCH_0', objectId, (externObject_update as object)))

    5. Return ?(ARCH_1)

2. Otherwise

  1. Return ?()

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:7:30-7:36:
syntax continueEmptyResult = 
   |  (from continueEmptyResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:8:28-8:35:
syntax continueResult<X> = 
   | X (from continueResult<X>)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:12:21-12:25:
syntax exitResult = 
   | exit (from exitResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:16:23-16:36:
syntax returnResult = 
   | return value? (from returnResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:20:33-20:39:
syntax acceptTransitionResult = 
   | accept (from acceptTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:21:33-21:50:
syntax rejectTransitionResult = 
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:22:32-22:40:
syntax stateTransitionResult = 
   | state id (from stateTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:25:1-26:27:
syntax abortResult = 
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:33:1-34:16:
syntax expressionResult = 
   | value (from continueResult<value>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:36:1-41:54:
relation Expr_eval: p, EC', ARCH', (expressionIR # _expressionNoteIR')

1. Case analysis on expressionIR

  1. Case (% has type booleanLiteral)

    1. (Let booleanLiteral be (expressionIR as booleanLiteral))

    2. (Let boolValue be $ite<boolValue>((booleanLiteral = (true)), (true), (false)))

    3. (Let expressionResult be (((boolValue as value)) as expressionResult))

    4. Result in EC', ARCH', expressionResult

  2. Case (% has type integerLiteral)

    1. (Let integerLiteral be (expressionIR as integerLiteral))

    2. (Let expressionResult be (((integerLiteral as value)) as expressionResult))

    3. Result in EC', ARCH', expressionResult

  3. Case (% has type stringLiteral)

    1. (Let stringLiteral be (expressionIR as stringLiteral))

    2. (Let expressionResult be (((stringLiteral as value)) as expressionResult))

    3. Result in EC', ARCH', expressionResult

  4. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

    2. (Let value be $find_var_e(prefixedNameIR, p, EC'))

    3. (Let expressionResult be ((value) as expressionResult))

    4. Result in EC', ARCH', expressionResult

  5. Case (% has type defaultExpression)

    1. (Let defaultExpression be (expressionIR as defaultExpression))

    2. If ((defaultExpression matches pattern `...`)), then

      1. (Let expressionResult be ((((default) as value)) as expressionResult))

      2. Result in EC', ARCH', expressionResult

    2. Else Phantom#2016

  6. Case (% has type unaryExpressionIR)

    1. (Let (unop typedExpressionIR) be (expressionIR as unaryExpressionIR))

    2. (Expr_eval: p EC' ARCH' |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

    3. If ((expressionResult has type abortResult)), then

      1. (Let abortResult be (expressionResult as abortResult))

      2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

    3. Else Phantom#2017

    4. (Expr_eval: p EC' ARCH' |- typedExpressionIR : EC_1 ARCH_1 expressionResult')

    5. If ((expressionResult' has type continueResult<value>)), then

      1. (Let (value) be (expressionResult' as continueResult<value>))

      2. (Let expressionResult be (($un_op(unop, value)) as expressionResult))

      3. Result in EC_1, ARCH_1, expressionResult

    5. Else Phantom#2018

  7. Case (% has type binaryExpressionIR)

    1. (Let (typedExpressionIR_l binop typedExpressionIR_r) be (expressionIR as binaryExpressionIR))

    2. If (~binop is in [(&&), (||)]), then

      1. (Exprs_eval: p EC' ARCH' |- [typedExpressionIR_l, typedExpressionIR_r] : EC_1 ARCH_1 expressionListResult)

      2. Case analysis on expressionListResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (expressionListResult as abortResult))

          2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

        2. Case (% has type continueResult<value*>)

          1. (Let (value*) be (expressionListResult as continueResult<value*>))

          2. If ((value* matches pattern [ _/2 ])), then

            1. (Let [value_l, value_r] be value*)

            2. (Let expressionResult be (($bin_op(binop, value_l, value_r)) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

          2. Else Phantom#2019

    2. Else Phantom#2020

    3. Case analysis on binop

      1. Case (% matches pattern `&&`)

        1. (Expr_eval: p EC' ARCH' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult)

        2. If ((expressionResult has type abortResult)), then

          1. (Let abortResult be (expressionResult as abortResult))

          2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

        2. Else Phantom#2021

        3. (Expr_eval: p EC' ARCH' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult')

        4. If ((expressionResult' = ((((false) as value)) as expressionResult))), then

          1. (Let expressionResult be ((((false) as value)) as expressionResult))

          2. Result in EC_1, ARCH_1, expressionResult

        4. Else Phantom#2022

        5. (Expr_eval: p EC' ARCH' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult)

        6. If ((expressionResult = ((((true) as value)) as expressionResult))), then

          1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r)

          2. Result in EC_2, ARCH_2, expressionResult_r

        6. Else Phantom#2023

      2. Case (% matches pattern `||`)

        1. (Expr_eval: p EC' ARCH' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult)

        2. If ((expressionResult has type abortResult)), then

          1. (Let abortResult be (expressionResult as abortResult))

          2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

        2. Else Phantom#2024

        3. (Expr_eval: p EC' ARCH' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult')

        4. If ((expressionResult' = ((((true) as value)) as expressionResult))), then

          1. (Let expressionResult be ((((true) as value)) as expressionResult))

          2. Result in EC_1, ARCH_1, expressionResult

        4. Else Phantom#2025

        5. (Expr_eval: p EC' ARCH' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult)

        6. If ((expressionResult = ((((false) as value)) as expressionResult))), then

          1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r)

          2. Result in EC_2, ARCH_2, expressionResult_r

        6. Else Phantom#2026

    3. Else Phantom#2027

  8. Case (% has type ternaryExpressionIR)

    1. (Let (typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false) be (expressionIR as ternaryExpressionIR))

    2. (Expr_eval: p EC' ARCH' |- typedExpressionIR_cond : EC_1 ARCH_1 expressionResult)

    3. If ((expressionResult has type abortResult)), then

      1. (Let abortResult be (expressionResult as abortResult))

      2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

    3. Else Phantom#2028

    4. If ((expressionResult = ((((true) as value)) as expressionResult))), then

      1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_true : EC_2 ARCH_2 expressionResult_true)

      2. Result in EC_2, ARCH_2, expressionResult_true

    4. Else Phantom#2029

    5. If ((expressionResult = ((((false) as value)) as expressionResult))), then

      1. (Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_false : EC_2 ARCH_2 expressionResult_false)

      2. Result in EC_2, ARCH_2, expressionResult_false

    5. Else Phantom#2030

  9. Case (% has type castExpressionIR)

    1. (Let (( typeIR ) typedExpressionIR) be (expressionIR as castExpressionIR))

    2. (Expr_eval: p EC' ARCH' |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

    3. Case analysis on expressionResult

      1. Case (% has type abortResult)

        1. (Let abortResult be (expressionResult as abortResult))

        2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

      2. Case (% has type continueResult<value>)

        1. (Let (value) be (expressionResult as continueResult<value>))

        2. (Let value_cast be $cast_op(typeIR, value))

        3. Result in EC_1, ARCH_1, ((value_cast) as expressionResult)

  10. Case (% has type invalidHeaderExpression)

    1. (Let invalidHeaderExpression be (expressionIR as invalidHeaderExpression))

    2. If ((invalidHeaderExpression matches pattern `{#}`)), then

      1. (Let expressionResult be (((({#}) as value)) as expressionResult))

      2. Result in EC', ARCH', expressionResult

    2. Else Phantom#2031

  11. Case (% has type sequenceExpressionIR)

    1. (Let sequenceExpressionIR be (expressionIR as sequenceExpressionIR))

    2. Case analysis on sequenceExpressionIR

      1. Case (% matches pattern `SEQ {%}`)

        1. (Let (seq { typedExpressionListIR }) be sequenceExpressionIR)

        2. (Exprs_eval: p EC' ARCH' |- typedExpressionListIR : EC_1 ARCH_1 expressionListResult)

        3. Case analysis on expressionListResult

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionListResult as abortResult))

            2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

          2. Case (% has type continueResult<value*>)

            1. (Let (value*) be (expressionListResult as continueResult<value*>))

            2. (Let expressionResult be ((((seq ( value* )) as value)) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

      2. Case (% matches pattern `SEQ {% , ...}`)

        1. (Let (seq { typedExpressionListIR , ... }) be sequenceExpressionIR)

        2. (Exprs_eval: p EC' ARCH' |- typedExpressionListIR : EC_1 ARCH_1 expressionListResult)

        3. Case analysis on expressionListResult

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionListResult as abortResult))

            2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

          2. Case (% has type continueResult<value*>)

            1. (Let (value*) be (expressionListResult as continueResult<value*>))

            2. (Let expressionResult be ((((seq ( value* , ... )) as value)) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

  12. Case (% has type recordExpressionIR)

    1. (Let recordExpressionIR be (expressionIR as recordExpressionIR))

    2. Case analysis on recordExpressionIR

      1. Case (% matches pattern `RECORD {%}`)

        1. (Let (record { (nameIR = typedExpressionIR)* }) be recordExpressionIR)

        2. (Exprs_eval: p EC' ARCH' |- typedExpressionIR* : EC_1 ARCH_1 expressionListResult)

        3. Case analysis on expressionListResult

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionListResult as abortResult))

            2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

          2. Case (% has type continueResult<value*>)

            1. (Let (value*) be (expressionListResult as continueResult<value*>))

            2. (Let expressionResult be ((((record { (value nameIR ;)* }) as value)) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

      2. Case (% matches pattern `RECORD {% , ...}`)

        1. (Let (record { (nameIR = typedExpressionIR)* , ... }) be recordExpressionIR)

        2. (Exprs_eval: p EC' ARCH' |- typedExpressionIR* : EC_1 ARCH_1 expressionListResult)

        3. Case analysis on expressionListResult

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionListResult as abortResult))

            2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

          2. Case (% has type continueResult<value*>)

            1. (Let (value*) be (expressionListResult as continueResult<value*>))

            2. (Let expressionResult be ((((record { (value nameIR ;)* , ... }) as value)) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

  13. Case (% has type errorAccessExpressionIR)

    1. (Let (error . nameIR) be (expressionIR as errorAccessExpressionIR))

    2. (Let nameIR_error be "error." ++ nameIR)

    3. (Let value_error be $find_var_e((nameIR_error), p, EC'))

    4. (Let expressionResult be ((value_error) as expressionResult))

    5. Result in EC', ARCH', expressionResult

  14. Case (% has type memberAccessExpressionIR)

    1. (Let (memberAccessBaseIR . nameIR) be (expressionIR as memberAccessExpressionIR))

    2. If ((memberAccessBaseIR matches pattern `TYPE %`)), then

      1. (Let (type prefixedNameIR) be memberAccessBaseIR)

      2. (Let typeDefIR? be $find_typeDef_e(p, EC', prefixedNameIR))

      3. If ((typeDefIR? matches pattern (_))), then

        1. (Let ?(typeDefIR_base) be typeDefIR?)

        2. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

        3. (Let typeIR be $unroll_typeIR(typeIR_base))

        4. Case analysis on typeIR

          1. Case (% has type simpleEnumTypeIR)

            1. (Let (enum typeId { _nameIR* }) be (typeIR as simpleEnumTypeIR))

            2. (Let expressionResult be ((((typeId . nameIR) as value)) as expressionResult))

            3. Result in EC', ARCH', expressionResult

          2. Case (% has type serializableEnumTypeIR)

            1. (Let (enum typeId < _typeIR > { (nameIR_member = value_member ;)* }) be (typeIR as serializableEnumTypeIR))

            2. (Let value'? be $assoc_<nameIR, value>(nameIR, (nameIR_member, value_member)*))

            3. If ((value'? matches pattern (_))), then

              1. (Let ?(value) be value'?)

              2. (Let expressionResult be ((((typeId . nameIR . value) as value)) as expressionResult))

              3. Result in EC', ARCH', expressionResult

            3. Else Phantom#2032

        4. Else Phantom#2033

      3. Else Phantom#2034

    2. Else Phantom#2035

1. Else Phantom#2036

2. (Let (( typeIR_base _ctk )) be _expressionNoteIR')

3. If ((expressionIR has type memberAccessExpressionIR)), then

  1. (Let (memberAccessBaseIR . nameIR) be (expressionIR as memberAccessExpressionIR))

  2. If ((memberAccessBaseIR has type typedExpressionIR)), then

    1. (Let typedExpressionIR_base be (memberAccessBaseIR as typedExpressionIR))

    2. (Expr_eval: p EC' ARCH' |- typedExpressionIR_base : EC_1 ARCH_1 expressionResult)

    3. If ((expressionResult has type abortResult)), then

      1. (Let abortResult be (expressionResult as abortResult))

      2. Result in EC_1, ARCH_1, (abortResult as expressionResult)

    3. Else Phantom#2037

    4. (Expr_eval: p EC' ARCH' |- typedExpressionIR_base : EC_1 ARCH_1 expressionResult')

    5. If ((expressionResult' has type continueResult<value>)), then

      1. (Let (value) be (expressionResult' as continueResult<value>))

      2. If ((value has type headerStackValue)), then

        1. (Let headerStackValue_base be (value as headerStackValue))

        2. (Let (header_stack [ value_elem* ( _nat ) ]) be headerStackValue_base)

        3. If ((nameIR = "size")), then

          1. (Let n_size be |value_elem*|)

          2. (Let expressionResult be ((((32 w (n_size as int)) as value)) as expressionResult))

          3. Result in EC_1, ARCH_1, expressionResult

        3. Else Phantom#2038

      2. Else Phantom#2039

    5. Else Phantom#2040

    6. (Expr_eval: p EC' ARCH' |- typedExpressionIR_base : EC_1 ARCH_1 expressionResult)

    7. If ((expressionResult has type continueResult<value>)), then

      1. (Let (value) be (expressionResult as continueResult<value>))

      2. If ((value has type headerStackValue)), then

        1. (Let headerStackValue_base be (value as headerStackValue))

        2. (Let (header_stack [ value_elem* ( n_idx ) ]) be headerStackValue_base)

        3. If ((nameIR = "last")), then

          1. (Let n_size be |value_elem*|)

          2. (Let b_out_of_bounds be ((n_idx < 1) \/ (n_idx > n_size)))

          3. If (b_out_of_bounds), then

            1. (Let rejectTransitionResult be (reject (error . "StackOutOfBounds")))

            2. Result in EC_1, ARCH_1, (rejectTransitionResult as expressionResult)

          3. Else Phantom#2041

        3. Else Phantom#2042

      2. Else Phantom#2043

    7. Else Phantom#2044

    8. (Expr_eval: p EC' ARCH' |- typedExpressionIR_base : EC_1 ARCH_1 expressionResult')

    9. If ((expressionResult' has type continueResult<value>)), then

      1. (Let (value) be (expressionResult' as continueResult<value>))

      2. Case analysis on value

        1. Case (% has type headerStackValue)

          1. (Let headerStackValue_base be (value as headerStackValue))

          2. (Let (header_stack [ value_elem* ( n_idx ) ]) be headerStackValue_base)

          3. Case analysis on nameIR

            1. Case (% = "last")

              1. (Let n_size be |value_elem*|)

              2. (Let b_out_of_bounds be ((n_idx < 1) \/ (n_idx > n_size)))

              3. If (~b_out_of_bounds), then

                1. (Let n_idx_last be (n_idx - 1))

                2. (Let value_last be value_elem*[n_idx_last])

                3. (Let expressionResult be ((value_last) as expressionResult))

                4. Result in EC_1, ARCH_1, expressionResult

              3. Else Phantom#2045

            2. Case (% = "lastIndex")

              1. (Let n_idx_last be ($max_nat([n_idx, 1]) - 1))

              2. (Let value_idx_last be ((32 w (n_idx_last as int)) as value))

              3. (Let expressionResult be ((value_idx_last) as expressionResult))

              4. Result in EC_1, ARCH_1, expressionResult

          3. Else Phantom#2046

        2. Case (% has type structValue)

          1. (Let structValue_base be (value as structValue))

          2. (Let (struct _typeId { (value_field id_field ;)* }) be structValue_base)

          3. (Let value'? be $assoc_<nameIR, value>(nameIR, (id_field, value_field)*))

          4. If ((value'? matches pattern (_))), then

            1. (Let ?(value_member) be value'?)

            2. (Let expressionResult be ((value_member) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

          4. Else Phantom#2047

        3. Case (% has type headerValue)

          1. (Let headerValue_base be (value as headerValue))

          2. (Let (header _typeId { _bool ; (value_field id_field ;)* }) be headerValue_base)

          3. (Let value'? be $assoc_<nameIR, value>(nameIR, (id_field, value_field)*))

          4. If ((value'? matches pattern (_))), then

            1. (Let ?(value_member) be value'?)

            2. (Let expressionResult be ((value_member) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

          4. Else Phantom#2048

        4. Case (% has type headerUnionValue)

          1. (Let headerUnionValue_base be (value as headerUnionValue))

          2. (Let (header_union _typeId { (value_field id_field ;)* }) be headerUnionValue_base)

          3. (Let value'? be $assoc_<nameIR, value>(nameIR, (id_field, value_field)*))

          4. If ((value'? matches pattern (_))), then

            1. (Let ?(value_member) be value'?)

            2. (Let expressionResult be ((value_member) as expressionResult))

            3. Result in EC_1, ARCH_1, expressionResult

          4. Else Phantom#2049

      2. Else Phantom#2050

    9. Else Phantom#2051

  2. Else Phantom#2052

3. Else Phantom#2053

4. Case analysis on expressionIR

  1. Case (% has type memberAccessExpressionIR)

    1. (Let (memberAccessBaseIR . nameIR) be (expressionIR as memberAccessExpressionIR))

    2. If ((memberAccessBaseIR has type typedExpressionIR)), then

      1. (Let typedExpressionIR_base be (memberAccessBaseIR as typedExpressionIR))

      2. (Expr_eval: p EC' ARCH' |- typedExpressionIR_base : EC_1 ARCH_1 expressionResult')

      3. If ((expressionResult' has type continueResult<value>)), then

        1. (Let (value) be (expressionResult' as continueResult<value>))

        2. If ((value has type tableMetadataStructValue)), then

          1. (Let tableMetadataStructValue_base be (value as tableMetadataStructValue))

          2. (Let (table_struct _typeId { hit boolValue_hit ; miss _boolValue ; action_run _tableMetadataEnumValue ; }) be tableMetadataStructValue_base)

          3. Case analysis on nameIR

            1. Case (% = "hit")

              1. (Let expressionResult be (((boolValue_hit as value)) as expressionResult))

              2. Result in EC_1, ARCH_1, expressionResult

            2. Case (% = "miss")

              1. (Let expressionResult be (((_boolValue as value)) as expressionResult))

              2. Result in EC_1, ARCH_1, expressionResult

