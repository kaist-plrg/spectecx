          1. Case (% has type parserObjectTypeIR)

            1. (Let (parser _typeId < _typeArgumentIR* > ( parameterIR* )) be (typeIR as parserObjectTypeIR))

            2. (Let parserApplyMethodTypeIR be (parser_apply ( parameterIR* )))

