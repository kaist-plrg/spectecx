;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:525:1-525:54:
dec $directionless_trailing'(_bool', direction''*)

1. Case analysis on direction''*

  1. Case (% matches pattern [])

    1. Return true

  2. Case (% matches pattern _ :: _)

    1. (Let direction_h :: direction_t* be direction''*)

