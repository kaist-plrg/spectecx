                    4. If (TypeDef_wf: $bound((global), TC_0) |- (typedefTypeIR as typeDefIR) holds), then

                      1. (Let TC_2 be $add_typeDef_t((global), TC_1, nameIR, (typedefTypeIR as typeDefIR)))

