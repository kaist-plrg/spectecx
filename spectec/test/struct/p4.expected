;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:370:1-371:16:
syntax copyInResult = 
   | storageReference?* (from continueResult<storageReference?*>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:373:1-385:46:
relation Copy_in: p_shared, ARCH', p_caller, EC_caller', parameterIR*, p_callee, EC_callee_0, argumentIR*

1. Case analysis on parameterIR*

  1. Case (% matches pattern [])

    1. If ((argumentIR* matches pattern [])), then

      1. (Let EC_callee_1 be $copy_e(p_shared, EC_caller', EC_callee_0))

      2. Result in ARCH', EC_caller', EC_callee_1, (([]) as copyInResult)

    1. Else Phantom#2295

  2. Case (% matches pattern _ :: _)

    1. (Let parameterIR_h :: parameterIR_t* be parameterIR*)

    2. If ((argumentIR* matches pattern _ :: _)), then

      1. (Let argumentIR_h :: argumentIR_t* be argumentIR*)

      2. (Copy_in_arg: ARCH' |- p_caller EC_caller' parameterIR_h @ p_callee EC_callee_0 argumentIR_h ~> ARCH_1 EC_caller_1 EC_callee_1 # copyInArgumentResult)

      3. Case analysis on copyInArgumentResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (copyInArgumentResult as abortResult))

          2. Result in ARCH_1, EC_caller_1, EC_callee_1, (abortResult as copyInResult)

        2. Case (% has type continueResult<storageReference?>)

          1. (Let (storageReference_h?) be (copyInArgumentResult as continueResult<storageReference?>))

          2. (Copy_in: p_shared ARCH_1 |- p_caller EC_caller_1 parameterIR_t* @ p_callee EC_callee_1 argumentIR_t* ~> ARCH_2 EC_caller_2 EC_callee_2 # copyInResult)

