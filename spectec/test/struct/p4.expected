dec $callable_action(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.local.kind)

    2. Return ((localKind = ((action) as localKind)) \/ (localKind = ((control_apply_method) as localKind)))

;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:291:1-291:60:
dec $callable_definedFunction(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.block.kind)

    2. Return ((blockKind = (parser)) \/ (blockKind = (control)))

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.local.kind)

    2. Return ~(localKind has type externMethodLocalKind)

;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:335:1-335:67:
dec $callable_externFunction(cursor, TC, nameIR)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Case analysis on nameIR

      1. Case (% = "verify")

        1. Return false

      2. Case (% =/= "verify")

        1. Return true

  2. Case (% matches pattern `BLOCK`)

    1. Case analysis on nameIR

      1. Case (% = "verify")

        1. (Let blockKind be TC.block.kind)

        2. Return (blockKind = (parser))

      2. Case (% =/= "verify")

        1. (Let blockKind be TC.block.kind)

        2. Return ((blockKind = (parser)) \/ (blockKind = (control)))

  3. Case (% matches pattern `LOCAL`)

    1. Case analysis on nameIR

      1. Case (% = "verify")

        1. (Let localKind be TC.local.kind)

        2. Return (localKind = ((parser_state) as localKind))

      2. Case (% =/= "verify")

        1. Return true

;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:415:1-415:57:
dec $callable_externMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. (Let blockKind be TC.block.kind)

    2. Return ((blockKind = (parser)) \/ (blockKind = (control)))

  3. Case (% matches pattern `LOCAL`)

    1. Return true

;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:490:1-490:62:
dec $callable_parserApplyMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.local.kind)

    2. Return (localKind = ((parser_state) as localKind))

;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:518:1-518:63:
dec $callable_controlApplyMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.local.kind)

    2. Return (localKind = ((control_apply_method) as localKind))

;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:545:1-545:61:
dec $callable_tableApplyMethod(cursor, TC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return false

  2. Case (% matches pattern `BLOCK`)

    1. Return false

  3. Case (% matches pattern `LOCAL`)

    1. (Let localKind be TC.local.kind)

    2. Return ((localKind = ((control_apply_method) as localKind)) \/ (localKind = ((table_apply_method) as localKind)))

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.0-domain.spectec:5:1-6:59:
dec $callableId_IR(nameIR, parameterIR*)

1. (Let (_annotationList _direction _typeIR id _parameterInitializerOptIR) be parameterIR)*

2. Return (nameIR ( id* ))

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.1-storage-reference.spectec:6:1-9:47:
syntax storageReference = 
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)
   | storageReference . nameIR (from storageReference)
   | storageReference [ value ] (from storageReference)
   | storageReference [ value sliceop value ] (from storageReference)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:12:3-12:70:
syntax actionDef = 
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:19:3-20:43:
syntax definedFunctionDef = 
   | function nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:23:3-24:52:
syntax externFunctionDef = 
   | extern_function nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:27:1-28:22:
syntax functionDef = 
   | function nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:35:1-38:54:
syntax externMethodDef = 
   | extern_method nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef)
   | extern_method abstract nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:41:3-42:52:
syntax parserApplyMethodDef = 
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:45:3-46:75:
syntax controlApplyMethodDef = 
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:49:3-49:40:
syntax tableApplyMethodDef = 
   | table_apply { tablePropertyListIR } (from tableApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:52:1-55:24:
syntax methodDef = 
   | extern_method nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef)
   | extern_method abstract nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef)
   | table_apply { tablePropertyListIR } (from tableApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:57:22-57:57:
syntax callableDef = 
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDef)
   | function nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef)
   | extern_method nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef)
   | extern_method abstract nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef)
   | table_apply { tablePropertyListIR } (from tableApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:5:1-6:17:
dec $parameterListIR_of_callableDef(callableDef)

1. Case analysis on callableDef

  1. Case (% has type actionDef)

    1. (Let actionDef be (callableDef as actionDef))

    2. Return $parameterListIR_of_actionDef(actionDef)

  2. Case (% has type functionDef)

    1. (Let functionDef be (callableDef as functionDef))

    2. Return $parameterListIR_of_functionDef(functionDef)

  3. Case (% has type methodDef)

    1. (Let methodDef be (callableDef as methodDef))

    2. Return $parameterListIR_of_methodDef(methodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:10:1-10:60:
dec $parameterListIR_of_actionDef((annotationList action _nameIR ( parameterListIR ) _blockStatementIR))

1. Return parameterListIR

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:20:1-21:17:
dec $parameterListIR_of_functionDef(functionDef)

1. Case analysis on functionDef

  1. Case (% has type definedFunctionDef)

    1. (Let definedFunctionDef be (functionDef as definedFunctionDef))

    2. Return $parameterListIR_of_definedFunctionDef(definedFunctionDef)

  2. Case (% has type externFunctionDef)

    1. (Let externFunctionDef be (functionDef as externFunctionDef))

    2. Return $parameterListIR_of_externFunctionDef(externFunctionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:23:1-24:17:
dec $parameterListIR_of_definedFunctionDef((function _nameIR < _typeParameterListIR > ( parameterListIR ) _blockStatementIR))

1. Return parameterListIR

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:29:1-30:17:
dec $parameterListIR_of_externFunctionDef((extern_function _nameIR < _typeParameterListIR > ( parameterListIR )))

1. Return parameterListIR

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:45:1-46:17:
dec $parameterListIR_of_methodDef(methodDef)

1. Case analysis on methodDef

  1. Case (% has type externMethodDef)

    1. (Let externMethodDef be (methodDef as externMethodDef))

    2. Return $parameterListIR_of_externMethodDef(externMethodDef)

  2. Case (% has type parserApplyMethodDef)

    1. (Let parserApplyMethodDef be (methodDef as parserApplyMethodDef))

    2. Return $parameterListIR_of_parserApplyMethodDef(parserApplyMethodDef)

  3. Case (% has type controlApplyMethodDef)

    1. (Let controlApplyMethodDef be (methodDef as controlApplyMethodDef))

    2. Return $parameterListIR_of_controlApplyMethodDef(controlApplyMethodDef)

  4. Case (% has type tableApplyMethodDef)

    1. (Let tableApplyMethodDef be (methodDef as tableApplyMethodDef))

    2. Return $parameterListIR_of_tableApplyMethodDef(tableApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:48:1-49:17:
dec $parameterListIR_of_externMethodDef(externMethodDef)

1. If ((externMethodDef matches pattern `EXTERN_METHOD % <%> (%) %`)), then

  1. (Let (extern_method _nameIR < _typeParameterListIR > ( parameterListIR ) _blockStatementIR?) be externMethodDef)

  2. Return parameterListIR

1. Else Phantom#1855

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:54:1-55:17:
dec $parameterListIR_of_parserApplyMethodDef((parser_apply ( parameterListIR ) { _parserLocalDeclarationListIR ; _stateEnv }))

1. Return parameterListIR

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:60:1-61:17:
dec $parameterListIR_of_controlApplyMethodDef((control_apply ( parameterListIR ) { _controlLocalDeclarationListIR ; _actionDefEnv ; _controlBodyIR }))

1. Return parameterListIR

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:66:1-67:17:
dec $parameterListIR_of_tableApplyMethodDef((table_apply { _tablePropertyListIR }))

1. Return []

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:10:3-11:51:
syntax actionCallee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:18:3-19:51:
syntax definedFunctionCallee = 
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:22:3-23:68:
syntax externFunctionCallee = 
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:26:1-27:25:
syntax functionCallee = 
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:33:40-33:73:
syntax builtinIsValidMethodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:34:40-34:74:
syntax builtinSetValidMethodCallee = 
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:35:40-35:76:
syntax builtinSetInvalidMethodCallee = 
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:36:40-36:75:
syntax builtinPushFrontMethodCallee = 
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:37:40-37:74:
syntax builtinPopFrontMethodCallee = 
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:38:40-38:69:
syntax builtinSizeMethodCallee = 
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:41:1-46:28:
syntax builtinMethodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:49:3-51:48:
syntax externMethodCallee = 
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:54:3-55:72:
syntax parserApplyMethodCallee = 
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:58:3-59:95:
syntax controlApplyMethodCallee = 
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:62:3-62:63:
syntax tableApplyMethodCallee = 
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:65:1-69:27:
syntax methodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:71:17-71:61:
syntax callee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee)
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:6:3-8:38:
syntax externObjectConstructorDef = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:11:3-15:28:
syntax parserObjectConstructorDef = 
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:18:3-22:30:
syntax controlObjectConstructorDef = 
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:25:3-26:37:
syntax packageObjectConstructorDef = 
   | package < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:29:1-32:32:
syntax constructorDef = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef)
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef)
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlObjectConstructorDef)
   | package < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:5:1-6:17:
dec $parameterListIR_of_constructorDef(constructorDef)

1. Case analysis on constructorDef

  1. Case (% has type externObjectConstructorDef)

    1. (Let (extern _nameIR < _typeParameterListIR > ( constructorParameterListIR ) { _externMethodPrototypeListIR }) be (constructorDef as externObjectConstructorDef))

    2. Return constructorParameterListIR

  2. Case (% has type parserObjectConstructorDef)

    1. (Let (parser < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _parserLocalDeclarationListIR _parserStateListIR }) be (constructorDef as parserObjectConstructorDef))

    2. Return constructorParameterListIR

  3. Case (% has type controlObjectConstructorDef)

    1. (Let (control < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _controlLocalDeclarationListIR apply _controlBodyIR }) be (constructorDef as controlObjectConstructorDef))

    2. Return constructorParameterListIR

  4. Case (% has type packageObjectConstructorDef)

    1. (Let (package < _typeParameterListIR > ( constructorParameterListIR )) be (constructorDef as packageObjectConstructorDef))

    2. Return constructorParameterListIR

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:12:1-12:26:
opaque syntax objectState

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:13:29-13:61:
syntax externMethodDefEnv = map<callableId, externMethodDef>

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:15:1-16:77:
builtin dec $init_objectState(nameIR, typeIR*, id*, value*)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:19:3-19:71:
syntax externObject = 
   | extern typeId < theta > { objectState frame externMethodDefEnv } (from externObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:29:3-32:19:
syntax parserObject = 
   | parser < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:42:23-42:49:
syntax actionDefEnv = map<callableId, actionDef>

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:45:3-49:24:
syntax controlObject = 
   | control < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:57:24-57:55:
syntax packageObject = 
   | package < theta > { frame } (from packageObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:65:3-69:37:
syntax tableObjectProperty = {keys tableKeysPropertyIR, actions tableActionsPropertyIR, default_action tableDefaultActionPropertyIR, entries tableEntriesPropertyIR, customs tableCustomPropertyIR*}

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:75:3-75:47:
syntax tableObject = 
   | table typeId { frame tableObjectProperty } (from tableObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:83:3-83:35:
syntax valueSetObject = 
   | value_set { value* ( nat ) } (from valueSetObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:86:1-91:19:
syntax object = 
   | extern typeId < theta > { objectState frame externMethodDefEnv } (from externObject)
   | parser < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject)
   | control < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject)
   | package < theta > { frame } (from packageObject)
   | table typeId { frame tableObjectProperty } (from tableObject)
   | value_set { value* ( nat ) } (from valueSetObject)

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:6:16-6:30:
syntax frame = map<id, value>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:8:1-8:25:
dec $empty_frame

1. Return $empty_map<id, value>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:12:19-12:41:
syntax stateEnv = map<id, parserStateIR>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:14:1-14:33:
dec $empty_stateEnv

1. Return $empty_map<id, parserStateIR>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:18:25-18:53:
syntax callableDefEnv = map<callableId, callableDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:20:1-20:45:
dec $empty_callableDefEnv

1. Return $empty_map<callableId, callableDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:24:28-24:59:
syntax constructorDefEnv = map<callableId, constructorDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:26:1-26:51:
dec $empty_constructorDefEnv

1. Return $empty_map<callableId, constructorDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:7:16-7:37:
syntax store = map<objectId, object>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:11:1-12:34:
dec $empty_store

1. (Let store be $empty_map<objectId, object>)

2. Return store

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:20:1-21:50:
dec $add_store(store, objectId, object)

1. (Let store' be $add_map<objectId, object>(store, objectId, object))

2. Return store'

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:30:1-31:41:
dec $find_store(store, objectId)

1. (Let object'? be $find_map<objectId, object>(store, objectId))

2. If ((object'? matches pattern (_))), then

  1. (Let ?(object) be object'?)

  2. Return object

2. Else Phantom#1856

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:8:3-11:18:
syntax globalInstLayer = {constructor constructorDefEnv, type typeDefEnv, callable callableDefEnv, frame frame}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:16:3-19:18:
syntax blockInstLayer = {type theta, callable callableDefEnv, state stateEnv, frame frame}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:24:3-25:20:
syntax localInstLayer = {type theta, frames frame*}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:32:3-35:27:
syntax instContext = {path objectId, global globalInstLayer, block blockInstLayer, local localInstLayer}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:43:1-44:50:
dec $empty_instContext

1. (Let globalInstLayer be {constructor $empty_constructorDefEnv, type $empty_typeDefEnv, callable $empty_callableDefEnv, frame $empty_frame})

2. (Let blockInstLayer be {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})

3. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

4. (Let IC be {path [], global globalInstLayer, block blockInstLayer, local localInstLayer})

5. Return IC

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:70:1-71:45:
dec $enter_i(IC)

1. Return IC[local.frames = $empty_frame :: IC.local.frames]

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:75:1-76:55:
dec $exit_i(IC)

1. (Let frame* be IC.local.frames)

2. If ((frame* matches pattern _ :: _)), then

  1. (Let frame_h :: frame_t* be frame*)

  2. Return IC[local.frames = frame_t*]

2. Else Phantom#1857

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:85:1-86:50:
dec $enter_path_i(IC, id)

1. Return IC[path = IC.path ++ [id]]

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:94:1-95:78:
dec $inherit_i(cursor, IC)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let blockInstLayer be {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})

    2. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

    3. Return IC[block = blockInstLayer][local = localInstLayer]

  2. Case (% matches pattern `BLOCK`)

    1. (Let localInstLayer be {type $empty_theta, frames [$empty_frame]})

    2. Return IC[local = localInstLayer]

  3. Case (% matches pattern `LOCAL`)

    1. Return IC

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:116:1-117:68:
dec $add_var_i(cursor, IC, id, value)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.global.frame))), then

      1. (Let frame be $add_map<id, value>(IC.global.frame, id, value))

      2. Return IC[global.frame = frame]

    1. Else Phantom#1858

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<id>(id, $dom_map<id, value>(IC.block.frame))), then

      1. (Let frame be $add_map<id, value>(IC.block.frame, id, value))

      2. Return IC[block.frame = frame]

    1. Else Phantom#1859

  3. Case (% matches pattern `LOCAL`)

    1. (Let frame* be IC.local.frames)

    2. If ((frame* matches pattern _ :: _)), then

      1. (Let frame_h :: frame_t* be frame*)

      2. If (~$in_set<id>(id, $dom_map<id, value>(frame_h))), then

        1. (Let frame_h' be $add_map<id, value>(frame_h, id, value))

        2. Return IC[local.frames = frame_h' :: frame_t*]

      2. Else Phantom#1860

    2. Else Phantom#1861

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:118:1-119:85:
dec $add_vars_i(p, IC, id*, value*)

1. Case analysis on id*

  1. Case (% matches pattern [])

    1. If ((value* matches pattern [])), then

      1. Return IC

    1. Else Phantom#1862

  2. Case (% matches pattern _ :: _)

    1. (Let id_h :: id_t* be id*)

    2. If ((value* matches pattern _ :: _)), then

      1. (Let value_h :: value_t* be value*)

      2. (Let IC' be $add_var_i(p, IC, id_h, value_h))

      3. (Let IC'' be $add_vars_i(p, IC', id_t*, value_t*))

      4. Return IC''

    2. Else Phantom#1863

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:139:1-140:68:
dec $add_typeDef_i(cursor, IC, typeId, typeDefIR)

1. If ((cursor matches pattern `GLOBAL`)), then

  1. (Let typeDefEnv be $add_map<typeId, typeDefIR>(IC.global.type, typeId, typeDefIR))

  2. Return IC[global.type = typeDefEnv]

1. Else Phantom#1864

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:149:1-150:50:
dec $add_parserState_i(IC, nameIR, parserStateIR)

1. If (~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.block.state))), then

  1. (Let stateEnv be $add_map<nameIR, parserStateIR>(IC.block.state, nameIR, parserStateIR))

  2. Return IC[block.state = stateEnv]

1. Else Phantom#1865

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:162:1-162:67:
dec $add_type_i(cursor, IC, typeId, typeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `BLOCK`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.block.type, typeId, typeIR))

    2. Return IC[block.type = theta]

  2. Case (% matches pattern `LOCAL`)

    1. (Let theta be $add_map<typeId, typeIR>(IC.local.type, typeId, typeIR))

    2. Return IC[local.type = theta]

1. Else Phantom#1866

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:163:1-163:70:
dec $add_types_i(p, IC, typeId*, typeIR*)

1. Case analysis on typeId*

  1. Case (% matches pattern [])

    1. If ((typeIR* matches pattern [])), then

      1. Return IC

    1. Else Phantom#1867

  2. Case (% matches pattern _ :: _)

    1. (Let typeId_h :: typeId_t* be typeId*)

    2. If ((typeIR* matches pattern _ :: _)), then

      1. (Let typeIR_h :: typeIR_t* be typeIR*)

      2. (Let IC' be $add_type_i(p, IC, typeId_h, typeIR_h))

      3. Return $add_types_i(p, IC', typeId_t*, typeIR_t*)

    2. Else Phantom#1868

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:177:1-179:94:
dec $add_callableDef_overload_i(cursor, IC, callableId, callableDef)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.global.callable))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.global.callable, callableId, callableDef))

      2. Return IC[global.callable = callableDefEnv]

    1. Else Phantom#1869

  2. Case (% matches pattern `BLOCK`)

    1. If (~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.block.callable))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.block.callable, callableId, callableDef))

      2. Return IC[block.callable = callableDefEnv]

    1. Else Phantom#1870

1. Else Phantom#1871

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:192:1-194:97:
dec $add_callableDef_non_overload_i(cursor, IC, callableId, callableDef)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. (Let (id ( _id* )) be callableId)

    2. (Let ({ (id_k ( _id'* ))* }) be $dom_map<callableId, callableDef>(IC.global.callable))

    3. If (~$in_set<id>(id, ({ id_k* }))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.global.callable, callableId, callableDef))

      2. Return IC[global.callable = callableDefEnv]

    3. Else Phantom#1872

  2. Case (% matches pattern `BLOCK`)

    1. (Let (id ( _id* )) be callableId)

    2. (Let ({ (id_k ( _id'* ))* }) be $dom_map<callableId, callableDef>(IC.block.callable))

    3. If (~$in_set<id>(id, ({ id_k* }))), then

      1. (Let callableDefEnv be $add_map<callableId, callableDef>(IC.block.callable, callableId, callableDef))

      2. Return IC[block.callable = callableDefEnv]

    3. Else Phantom#1873

1. Else Phantom#1874

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:213:1-215:92:
dec $find_callableDef_non_overload_i(p', IC, prefixedNameIR)

1. If ((prefixedNameIR matches pattern `. %`)), then

  1. (Let (. nameIR) be prefixedNameIR)

  2. If ((?() = $find_non_overloaded<callableDef>(IC.global.callable, nameIR))), then

    1. Return ?()

  2. Else Phantom#1875

  3. (Let (callableId, callableDef)? be $find_non_overloaded<callableDef>(IC.global.callable, nameIR))

  4. If (((callableId, callableDef)? matches pattern (_))), then

    1. (Let ?((callableId, callableDef)) be (callableId, callableDef)?)

    2. Return ?(((global), callableId, callableDef))

  4. Else Phantom#1876

1. Else Phantom#1877

2. Case analysis on p'

  1. Case (% matches pattern `GLOBAL`)

    1. If ((prefixedNameIR matches pattern `_BARE %`)), then

      1. (Let (nameIR) be prefixedNameIR)

      2. Return $find_callableDef_non_overload_i((global), IC, (. nameIR))

    1. Else Phantom#1878

  2. Case (% matches pattern `BLOCK`)

    1. If ((prefixedNameIR matches pattern `_BARE %`)), then

      1. (Let (nameIR) be prefixedNameIR)

      2. (Let (callableId, callableDef)? be $find_non_overloaded<callableDef>(IC.block.callable, nameIR))

      3. If (((callableId, callableDef)? matches pattern (_))), then

        1. (Let ?((callableId, callableDef)) be (callableId, callableDef)?)

        2. Return ?(((block), callableId, callableDef))

      3. Else Phantom#1879

      4. If ((?() = $find_non_overloaded<callableDef>(IC.block.callable, nameIR))), then

        1. Return $find_callableDef_non_overload_i((global), IC, (nameIR))

      4. Else Phantom#1880

    1. Else Phantom#1881

  3. Case (% matches pattern `LOCAL`)

    1. If ((prefixedNameIR matches pattern `_BARE %`)), then

      1. (Let (nameIR) be prefixedNameIR)

      2. Return $find_callableDef_non_overload_i((block), IC, (nameIR))

    1. Else Phantom#1882

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:238:1-239:53:
dec $add_constructorDef_i(IC, callableId, constructorDef)

1. (Let constructorDefEnv be $add_map<callableId, constructorDef>(IC.global.constructor, callableId, constructorDef))

2. Return IC[global.constructor = constructorDefEnv]

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:240:1-241:70:
dec $add_constructorDefs_i(IC, callableId*, constructorDef*)

1. Case analysis on callableId*

  1. Case (% matches pattern [])

    1. If ((constructorDef* matches pattern [])), then

      1. Return IC

    1. Else Phantom#1883

  2. Case (% matches pattern _ :: _)

    1. (Let callableId_h :: callableId_t* be callableId*)

    2. If ((constructorDef* matches pattern _ :: _)), then

      1. (Let constructorDef_h :: constructorDef_t* be constructorDef*)

      2. (Let IC' be $add_constructorDef_i(IC, callableId_h, constructorDef_h))

      3. (Let IC'' be $add_constructorDefs_i(IC', callableId_t*, constructorDef_t*))

      4. Return IC''

    2. Else Phantom#1884

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:263:1-264:63:
dec $find_var_i(prefixedNameIR, p', IC)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `. %`)

    1. (Let (. id) be prefixedNameIR)

    2. (Let value'? be $find_map<id, value>(IC.global.frame, id))

    3. If ((value'? matches pattern (_))), then

      1. (Let ?(value) be value'?)

      2. Return value

    3. Else Phantom#1885

  2. Case (% matches pattern `_BARE %`)

    1. (Let (id) be prefixedNameIR)

    2. Case analysis on p'

      1. Case (% matches pattern `GLOBAL`)

        1. (Let value'? be $find_map<id, value>(IC.global.frame, id))

        2. If ((value'? matches pattern (_))), then

          1. (Let ?(value) be value'?)

          2. Return value

        2. Else Phantom#1886

      2. Case (% matches pattern `BLOCK`)

        1. (Let value'? be $find_map<id, value>(IC.block.frame, id))

        2. If ((value'? matches pattern (_))), then

          1. (Let ?(value) be value'?)

          2. Return value

        2. Else Phantom#1887

        3. If ((?() = $find_map<id, value>(IC.block.frame, id))), then

          1. Return $find_var_i((id), (global), IC)

        3. Else Phantom#1888

      3. Case (% matches pattern `LOCAL`)

        1. (Let value'? be $find_maps<id, value>(IC.local.frames, id))

        2. If ((value'? matches pattern (_))), then

          1. (Let ?(value) be value'?)

          2. Return value

        2. Else Phantom#1889

        3. If ((?() = $find_maps<id, value>(IC.local.frames, id))), then

          1. Return $find_var_i((id), (block), IC)

        3. Else Phantom#1890

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:283:1-284:73:
dec $find_typeDef_i(_cursor, IC, prefixedNameIR)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `_BARE %`)

    1. (Let (nameIR) be prefixedNameIR)

    2. Return $find_map<typeId, typeDefIR>(IC.global.type, nameIR)

  2. Case (% matches pattern `. %`)

    1. (Let (. nameIR) be prefixedNameIR)

    2. Return $find_map<typeId, typeDefIR>(IC.global.type, nameIR)

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:293:1-295:80:
dec $find_constructorDef_i(IC, prefixedNameIR, argumentIR*)

1. Case analysis on prefixedNameIR

  1. Case (% matches pattern `_BARE %`)

    1. (Let (nameIR) be prefixedNameIR)

    2. (Let callTargetKey be $callTargetKey(nameIR, argumentIR*))

    3. Return $find_overloaded<constructorDef>(IC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)

  2. Case (% matches pattern `. %`)

    1. (Let (. nameIR) be prefixedNameIR)

    2. (Let callTargetKey be $callTargetKey(nameIR, argumentIR*))

    3. Return $find_overloaded<constructorDef>(IC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:314:1-315:86:
dec $subst_type_i(cursor, IC, typeIR)

1. Case analysis on cursor

  1. Case (% matches pattern `GLOBAL`)

    1. Return typeIR

  2. Case (% matches pattern `BLOCK`)

    1. (Let theta be IC.block.type)

    2. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

    3. Return typeIR_subst

  3. Case (% matches pattern `LOCAL`)

    1. (Let theta_block be IC.block.type)

    2. (Let theta_local be IC.local.type)

    3. (Let theta be $extend_map<typeId, typeIR>(theta_block, theta_local))

    4. (Let typeIR_subst be $subst_typeIR(theta, typeIR))

    5. Return typeIR_subst

;; ../../../../../spectec/specs/p4/7-instantiation/7.03-inst-relation.spectec:5:1-10:38:
relation Expr_inst: p, IC, STO', (expressionIR # _expressionNoteIR')

1. Case analysis on expressionIR

  1. Case (% has type booleanLiteral)

    1. (Let booleanLiteral be (expressionIR as booleanLiteral))

    2. (Let boolValue be $ite<boolValue>((booleanLiteral = (true)), (true), (false)))

    3. Result in STO', (boolValue as value)

  2. Case (% has type integerLiteral)

    1. (Let integerLiteral be (expressionIR as integerLiteral))

    2. Result in STO', (integerLiteral as value)

  3. Case (% has type stringLiteral)

    1. (Let stringLiteral be (expressionIR as stringLiteral))

    2. Result in STO', (stringLiteral as value)

  4. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

    2. (Let value be $find_var_i(prefixedNameIR, p, IC))

    3. Result in STO', value

  5. Case (% has type defaultExpression)

    1. (Let defaultExpression be (expressionIR as defaultExpression))

    2. If ((defaultExpression matches pattern `...`)), then

      1. Result in STO', ((default) as value)

    2. Else Phantom#1891

  6. Case (% has type unaryExpressionIR)

    1. (Let (unop typedExpressionIR) be (expressionIR as unaryExpressionIR))

    2. (Expr_inst: p IC STO' |- typedExpressionIR : STO_1 value)

    3. Result in STO_1, $un_op(unop, value)

  7. Case (% has type binaryExpressionIR)

    1. (Let (typedExpressionIR_l binop typedExpressionIR_r) be (expressionIR as binaryExpressionIR))

    2. If (~binop is in [(&&), (||)]), then

      1. (Expr_inst: p IC STO' |- typedExpressionIR_l : STO_1 value_l)

      2. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

      3. Result in STO_2, $bin_op(binop, value_l, value_r)

    2. Else Phantom#1892

    3. Case analysis on binop

      1. Case (% matches pattern `&&`)

        1. (Expr_inst: p IC STO' |- typedExpressionIR_l : STO_1 value)

        2. If ((value = ((false) as value))), then

          1. Result in STO_1, ((false) as value)

        2. Else Phantom#1893

        3. If ((value = ((true) as value))), then

          1. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

          2. Result in STO_2, value_r

        3. Else Phantom#1894

      2. Case (% matches pattern `||`)

        1. (Expr_inst: p IC STO' |- typedExpressionIR_l : STO_1 value)

        2. If ((value = ((true) as value))), then

          1. Result in STO_1, ((true) as value)

        2. Else Phantom#1895

        3. If ((value = ((false) as value))), then

          1. (Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r)

          2. Result in STO_2, value_r

        3. Else Phantom#1896

    3. Else Phantom#1897

  8. Case (% has type ternaryExpressionIR)

    1. (Let (typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false) be (expressionIR as ternaryExpressionIR))

    2. (Expr_inst: p IC STO' |- typedExpressionIR_cond : STO_1 value)

    3. If ((value = ((true) as value))), then

      1. (Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true)

      2. Result in STO_2, value_true

    3. Else Phantom#1898

    4. If ((value = ((false) as value))), then

      1. (Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false)

      2. Result in STO_2, value_false

    4. Else Phantom#1899

  9. Case (% has type castExpressionIR)

    1. (Let (( typeIR ) typedExpressionIR) be (expressionIR as castExpressionIR))

    2. (Expr_inst: p IC STO' |- typedExpressionIR : STO_1 value)

    3. (Let value_cast be $cast_op(typeIR, value))

    4. Result in STO_1, value_cast

  10. Case (% has type invalidHeaderExpression)

    1. (Let invalidHeaderExpression be (expressionIR as invalidHeaderExpression))

    2. If ((invalidHeaderExpression matches pattern `{#}`)), then

      1. Result in STO', (({#}) as value)

    2. Else Phantom#1900

  11. Case (% has type sequenceExpressionIR)

    1. (Let sequenceExpressionIR be (expressionIR as sequenceExpressionIR))

    2. Case analysis on sequenceExpressionIR

      1. Case (% matches pattern `SEQ {%}`)

        1. (Let (seq { typedExpressionListIR }) be sequenceExpressionIR)

        2. (Exprs_inst: p IC STO' |- typedExpressionListIR : STO_1 value*)

        3. Result in STO_1, ((seq ( value* )) as value)

      2. Case (% matches pattern `SEQ {% , ...}`)

        1. (Let (seq { typedExpressionListIR , ... }) be sequenceExpressionIR)

        2. (Exprs_inst: p IC STO' |- typedExpressionListIR : STO_1 value*)

        3. Result in STO_1, ((seq ( value* , ... )) as value)

  12. Case (% has type recordExpressionIR)

    1. (Let recordExpressionIR be (expressionIR as recordExpressionIR))

    2. Case analysis on recordExpressionIR

      1. Case (% matches pattern `RECORD {%}`)

        1. (Let (record { (nameIR = typedExpressionIR)* }) be recordExpressionIR)

        2. (Exprs_inst: p IC STO' |- typedExpressionIR* : STO_1 value*)

        3. Result in STO_1, ((record { (value nameIR ;)* }) as value)

      2. Case (% matches pattern `RECORD {% , ...}`)

        1. (Let (record { (nameIR = typedExpressionIR)* , ... }) be recordExpressionIR)

        2. (Exprs_inst: p IC STO' |- typedExpressionIR* : STO_1 value*)

        3. Result in STO_1, ((record { (value nameIR ;)* , ... }) as value)

  13. Case (% has type errorAccessExpressionIR)

    1. (Let (error . nameIR) be (expressionIR as errorAccessExpressionIR))

    2. (Let nameIR_error be "error." ++ nameIR)

    3. (Let value_error be $find_var_i((nameIR_error), p, IC))

    4. Result in STO', value_error

  14. Case (% has type memberAccessExpressionIR)

    1. (Let (memberAccessBaseIR . nameIR) be (expressionIR as memberAccessExpressionIR))

    2. If ((memberAccessBaseIR matches pattern `TYPE %`)), then

      1. (Let (type prefixedNameIR) be memberAccessBaseIR)

      2. (Let typeDefIR? be $find_typeDef_i(p, IC, prefixedNameIR))

      3. If ((typeDefIR? matches pattern (_))), then

        1. (Let ?(typeDefIR_base) be typeDefIR?)

        2. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

        3. (Let typeIR be $unroll_typeIR(typeIR_base))

        4. Case analysis on typeIR

          1. Case (% has type simpleEnumTypeIR)

            1. (Let (enum typeId { _nameIR* }) be (typeIR as simpleEnumTypeIR))

            2. Result in STO', ((typeId . nameIR) as value)

