dec $cast_binary(typedExpressionIR_l, typedExpressionIR_r)

1. (Let (_expressionIR # (( typeIR_l _ctk ))) be typedExpressionIR_l)

2. (Let (_expressionIR' # (( typeIR_r _ctk' ))) be typedExpressionIR_r)

3. (Cast_impl: typeIR_l -> typeIR_r : castResult)

4. Case analysis on castResult

  1. Case (% matches pattern `OK %`)

    1. (Let (ok typeIR_cast*) be castResult)

    2. (Let typedExpressionIR_l_cast be $apply_cast(typedExpressionIR_l, typeIR_cast*))

    3. Return ?((typedExpressionIR_l_cast, typedExpressionIR_r))

  2. Case (% matches pattern `FAIL`)

    1. (Cast_impl: typeIR_r -> typeIR_l : castResult')

    2. Case analysis on castResult'

      1. Case (% matches pattern `OK %`)

        1. (Let (ok typeIR_cast*) be castResult')

        2. (Let typedExpressionIR_r_cast be $apply_cast(typedExpressionIR_r, typeIR_cast*))

        3. Return ?((typedExpressionIR_l, typedExpressionIR_r_cast))

      2. Case (% matches pattern `FAIL`)

        1. (Let typedExpressionIR_l_cast be $reduce_serenum(typedExpressionIR_l))

        2. If ((typedExpressionIR_l =/= typedExpressionIR_l_cast)), then

          1. Return $cast_binary(typedExpressionIR_l_cast, typedExpressionIR_r)

        3. If ((typedExpressionIR_l = typedExpressionIR_l_cast)), then

          1. (Let typedExpressionIR_r_cast be $reduce_serenum(typedExpressionIR_r))

          2. If ((typedExpressionIR_r =/= typedExpressionIR_r_cast)), then

            1. Return $cast_binary(typedExpressionIR_l, typedExpressionIR_r_cast)

2. Otherwise

  1. Return ?()

