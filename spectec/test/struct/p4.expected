;; ../../../../../spectec/specs/p4/5-typing/5.11-typing-declaration.spectec:88:1-94:40:
relation InstDecl_non_objectInitializer_ok: p, TC_0, annotationList, prefixedTypeName, typeArgumentList, argumentList, name

1. If ($has_at_most_one_name_annotation(annotationList)), then

  1. (TypeArgumentList_ok: p TC_0 |- typeArgumentList : typeArgumentIR* # typeId_impl*)

  2. (ArgumentList_ok: p TC_0 |- argumentList : argumentIR*)

  3. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

  4. (Let constructorTargetIR be (prefixedNameIR < typeArgumentIR* >))

  5. (ConstructorType_ok: p TC_0 |- constructorTargetIR ( argumentIR* ) : constructorTypeIR < # typeId_inserted* > ( # id_default* # id_optional* ))

  6. (Let typeArgumentIR_infer* be typeArgumentIR* ++ ((typeId_inserted) as typeIR)*)

  7. (Let typeId_infer* be typeId_impl* ++ typeId_inserted*)

  8. (Inst_ok: p TC_0 (named) |- constructorTypeIR < typeArgumentIR_infer* # typeId_infer* > ( argumentIR* # id_default* # id_optional* ) : typeIR_object < typeArgumentIR_inferred* > ( argumentIR_cast* ))

  9. If ($is_concrete_extern_object(typeIR_object)), then

    1. (Let nameIR be $name(name))

    2. (Let TC_1 be $add_var_t(p, TC_0, nameIR, (() typeIR_object (ctk) ?())))

    3. (Let constructorTargetIR_inferred be (prefixedNameIR < typeArgumentIR_inferred* >))

    4. (Let instantiationIR be (annotationList typeIR_object constructorTargetIR_inferred ( argumentIR_cast* ) nameIR ?() ;))

    5. Result in TC_1, instantiationIR

  9. Else Phantom#1743

1. Else Phantom#1744

;; ../../../../../spectec/specs/p4/5-typing/5.11-typing-declaration.spectec:133:1-140:53:
relation ObjectDecl_ok: p, TC_0, typeFrame, externMethodTypeDefEnv, objectDeclaration

1. Case analysis on objectDeclaration

  1. Case (% has type instantiation)

    1. (Let instantiation be (objectDeclaration as instantiation))

    2. (InstDecl_ok: p TC_0 |- instantiation : TC_1 instantiationIR)

    3. (Let (_annotationList _typeIR _constructorTargetIR ( _argumentListIR ) nameIR _objectInitializerOptIR ;) be instantiationIR)

    4. (Let varTypeIR'? be $find_var_t((nameIR), p, TC_1))

    5. If ((varTypeIR'? matches pattern (_))), then

      1. (Let ?(varTypeIR) be varTypeIR'?)

      2. If (~$in_set<id>(nameIR, $dom_map<id, varTypeIR>(typeFrame))), then

        1. (Let typeFrame_init be $update_map<id, varTypeIR>(typeFrame, nameIR, varTypeIR))

        2. Result in typeFrame_init, externMethodTypeDefEnv, (instantiationIR as objectDeclarationIR)

      2. Else Phantom#1745

    5. Else Phantom#1746

  2. Case (% has type functionDeclaration)

    1. (Let (annotationList (typeOrVoid name typeParameterListOpt ( parameterList )) blockStatement) be (objectDeclaration as functionDeclaration))

    2. (Let TC_1 be TC_0[block.kind = (extern)])

    3. (Let TC_2 be TC_1[block.frame = typeFrame])

    4. (TypeParameterListOpt_ok: (local) TC_2 |- typeParameterListOpt : TC_3 typeId_expl*)

    5. (ParameterList_ok: (local) TC_3 |- parameterList : TC_4 parameterIR* # typeId_impl*)

    6. (Type_ok: (local) TC_3 |- typeOrVoid : typeIR_ret # typeId*)

    7. If ((typeId* matches pattern [])), then

      1. (Let TC_5 be TC_4[local.kind = ((extern_method : typeIR_ret) as localKind)])

      2. (Let TC_6 be TC_5[control = (cont)][loop = (out)])

      3. (Block_ok: TC_6 |- blockStatement : TC_7 blockStatementIR)

      4. If (((TC_7.control = (ret)) \/ (typeIR_ret = ((void) as typeIR)))), then

        1. (Let callableId be $callableId(name, parameterList))

        2. (Let nameIR be $name(name))

        3. (Let externMethodTypeDefIR be (extern_method nameIR < typeId_expl* , typeId_impl* > ( parameterIR* ) : typeIR_ret))

        4. If (CallableTypeDef_wf: $bound(p, TC_0) |- (externMethodTypeDefIR as callableTypeDefIR) holds), then

          1. (Let externMethodTypeDefEnv_init be $update_map<callableId, externMethodTypeDefIR>(externMethodTypeDefEnv, callableId, externMethodTypeDefIR))

          2. (Let functionDeclarationIR be (annotationList (typeIR_ret nameIR < typeId_expl* , typeId_impl* > ( parameterIR* )) blockStatementIR))

          3. Result in typeFrame, externMethodTypeDefEnv_init, (functionDeclarationIR as objectDeclarationIR)

        4. Else Phantom#1747

      4. Else Phantom#1748

    7. Else Phantom#1749

