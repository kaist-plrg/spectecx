1. (Let typeIR_resolved be $resolve_inference'(typeIR))*

2. Return ({ (typeId : typeIR_resolved)* })

;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:33:1-33:41:
dec $resolve_inference'(typeIR)

1. (Let typeIR' be $unroll_typeIR(typeIR))

2. If ((typeIR' has type sequenceTypeIR)), then

  1. (Let sequenceTypeIR be (typeIR' as sequenceTypeIR))

  2. If ((sequenceTypeIR matches pattern `SEQ <%>`)), then

    1. (Let (seq < typeIR_arg* >) be sequenceTypeIR)

    2. (Let typeIR_resolved be ((tuple < typeIR_arg* >) as typeIR))

    3. Return typeIR_resolved

2. Otherwise

  1. Return typeIR

