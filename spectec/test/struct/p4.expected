dec $resolve_constraint(strictness, set<pair<typeId, infer>>')

1. If ((set<pair<typeId, infer>>' = ({ [] }))), then

  1. Return ({ [] })

1. Else Phantom#1846

2. (Let ({ pair<typeId, infer>* }) be set<pair<typeId, infer>>')

3. If ((pair<typeId, infer>* matches pattern _ :: _)), then

  1. (Let (typeId_h : infer_h) :: (typeId_t : infer_t)* be pair<typeId, infer>*)

  2. If ((infer_h matches pattern `KNOWN AS %`)), then

    1. (Let (known as typeIR_h) be infer_h)

    2. (Let ({ (typeId : typeIR_t)* }) be $resolve_constraint(strictness, ({ (typeId_t : infer_t)* })))

    3. If ((typeId = typeId_t))*, then

      1. Return ({ (typeId_h : typeIR_h) :: (typeId_t : typeIR_t)* })

    3. Else Phantom#1847

  2. Else Phantom#1848

  3. If (((unknown) = infer_h)), then

    1. If (($find_map<typeId, strict>(strictness, typeId_h) = ?((lax)))), then

      1. (Let ({ (typeId : typeIR_t)* }) be $resolve_constraint(strictness, ({ (typeId_t : infer_t)* })))

      2. If ((typeId = typeId_t))*, then

        1. Return ({ (typeId_h : ((bool) as typeIR)) :: (typeId_t : typeIR_t)* })

