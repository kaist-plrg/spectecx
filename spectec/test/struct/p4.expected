  2. Case (% has type nameTypeIR)

    1. (Let nameTypeIR be (typeIR as nameTypeIR))

    2. Return ($lift_nameTypeIR(nameTypeIR) as type?)

  3. Case (% has type aliasTypeIR)

    1. (Let aliasTypeIR be (typeIR as aliasTypeIR))

    2. Return $lift_aliasTypeIR(aliasTypeIR)

  4. Case (% has type dataTypeIR)

    1. (Let dataTypeIR be (typeIR as dataTypeIR))

    2. Return $lift_dataTypeIR(dataTypeIR)

2. Otherwise

  1. Debug: typeIR

