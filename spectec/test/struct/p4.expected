          2. Case (% has type constructorTarget)

            1. (Let constructorTarget be (callTarget as constructorTarget))

            2. Return (((constructorTarget as callTargetNonBrace) ( argumentList )) as expressionNonBrace)

      2. Case (% matches pattern `% <%> (%)`)

        1. (Let (expression < realTypeArgumentList > ( argumentList )) be callExpression)

        2. (Let expressionNonBrace be $expression_as_expressionNonBrace(expression))

        3. Return ((expressionNonBrace < realTypeArgumentList > ( argumentList )) as expressionNonBrace)

  12. Case (% has type parenthesizedExpression)

    1. (Let parenthesizedExpression be (expression'' as parenthesizedExpression))

    2. Return (parenthesizedExpression as expressionNonBrace)

