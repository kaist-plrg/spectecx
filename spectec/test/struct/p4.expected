    9. Else Phantom#1597

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:470:1-474:40:
relation Decls_ok: TC', declaration*

1. Case analysis on declaration*

  1. Case (% matches pattern [])

    1. Result in TC', []

  2. Case (% matches pattern _ :: _)

    1. (Let declaration_h :: declaration_t* be declaration*)

    2. (Decl_ok: TC' |- declaration_h : TC_1 declarationIR_h)

    3. (Decls_ok: TC_1 |- declaration_t* : TC_2 declarationIR_t*)

    4. Result in TC_2, declarationIR_h :: declarationIR_t*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:476:1-480:40:
relation Program_ok: p4program

1. (Let declaration* be $flatten_p4program(p4program))

2. (Let TC_0 be $empty_typingContext)

3. (Decls_ok: TC_0 |- declaration* : TC_1 declarationIR*)

4. Result in (declarationIR* ;)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:490:18-490:35:
syntax actctxt = 
   | action (from actctxt)
   | noaction (from actctxt)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:492:1-498:30:
relation Call_convention_expr_ok: p, TC, actctxt, (_annotationList direction typeIR_param _id _parameterInitializerOptIR), typedExpressionIR_arg

1. If ((direction matches pattern `IN`)), then

  1. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_arg, typeIR_param))

  2. If ((typedExpressionIR? matches pattern (_))), then

    1. (Let ?(typedExpressionIR_arg_cast) be typedExpressionIR?)

    2. Result in typedExpressionIR_arg_cast

  2. Else Phantom#1598

1. Else Phantom#1599

2. If (((direction = (out)) \/ (direction = (inout)))), then

  1. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR_arg))

  2. If (Type_alpha: typeIR_param ~~ typeIR_arg holds), then

    1. (Let typedLvalueIR? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_arg))

    2. If ((typedLvalueIR? matches pattern (_))), then

      1. (Let ?(typedLvalueIR_arg) be typedLvalueIR?)

      2. (Let lvalue? be $lift_typedLvalueIR(typedLvalueIR_arg))

      3. If ((lvalue? matches pattern (_))), then

        1. (Let ?(lvalue_arg) be lvalue?)

        2. (Lvalue_ok: p TC |- lvalue_arg : _typedLvalueIR)

        3. Result in typedExpressionIR_arg

      3. Else Phantom#1600

    2. Else Phantom#1601

  2. Else Phantom#1602

2. Else Phantom#1603

3. Case analysis on actctxt

  1. Case (% matches pattern `ACTION`)

    1. If ((direction matches pattern `_EMPTY`)), then

      1. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_arg, typeIR_param))

      2. If ((typedExpressionIR? matches pattern (_))), then

        1. (Let ?(typedExpressionIR_arg_cast) be typedExpressionIR?)

        2. Result in typedExpressionIR_arg_cast

      2. Else Phantom#1604

    1. Else Phantom#1605

  2. Case (% matches pattern `NOACTION`)

    1. If ((direction matches pattern `_EMPTY`)), then

      1. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_arg, typeIR_param))

      2. If ((typedExpressionIR? matches pattern (_))), then

        1. (Let ?(typedExpressionIR_arg_cast) be typedExpressionIR?)

        2. If (((dyn) =/= $ctk_of_typedExpressionIR(typedExpressionIR_arg))), then

          1. Result in typedExpressionIR_arg_cast

        2. Else Phantom#1606

      2. Else Phantom#1607

    1. Else Phantom#1608

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:500:1-506:30:
relation Call_convention_arg_ok: p, TC, actctxt, parameterIR, argumentIR

1. If ((argumentIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

  2. (Call_convention_expr_ok: p TC actctxt |- parameterIR @ typedExpressionIR : typedExpressionIR_cast)

  3. Result in (typedExpressionIR_cast as argumentIR)

1. Else Phantom#1609

2. Case analysis on argumentIR

  1. Case (% matches pattern `% = %`)

    1. (Let (nameIR = typedExpressionIR) be argumentIR)

    2. (Call_convention_expr_ok: p TC actctxt |- parameterIR @ typedExpressionIR : typedExpressionIR_cast)

    3. Result in (nameIR = typedExpressionIR_cast)

  2. Case (% matches pattern `% = _`)

    1. (Let (nameIR = _) be argumentIR)

    2. (Let (_annotationList direction _typeIR _id _parameterInitializerOptIR) be parameterIR)

    3. If ((direction matches pattern `OUT`)), then

      1. Result in (nameIR = _)

    3. Else Phantom#1610

  3. Case (% matches pattern `_`)

    1. (Let (_annotationList direction _typeIR _id _parameterInitializerOptIR) be parameterIR)

    2. If ((direction matches pattern `OUT`)), then

      1. Result in (_)

    2. Else Phantom#1611

2. Else Phantom#1612

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:508:1-514:30:
relation Call_convention_ok: p, TC, actctxt, parameterIR*, argumentIR*

1. Case analysis on parameterIR*

  1. Case (% matches pattern [])

    1. If ((argumentIR* matches pattern [])), then

      1. Result in []

    1. Else Phantom#1613

  2. Case (% matches pattern _ :: _)

    1. (Let parameterIR_h :: parameterIR_t* be parameterIR*)

    2. If ((argumentIR* matches pattern _ :: _)), then

      1. (Let argumentIR_h :: argumentIR_t* be argumentIR*)

      2. (Call_convention_arg_ok: p TC actctxt |- parameterIR_h @ argumentIR_h : argumentIR_h_cast)

      3. (Call_convention_ok: p TC actctxt |- parameterIR_t* @ argumentIR_t* : argumentIR_t_cast*)

      4. Result in argumentIR_h_cast :: argumentIR_t_cast*

    2. Else Phantom#1614

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:524:1-525:49:
dec $is_static_callableTypeIR(callableTypeIR')

1. Case analysis on callableTypeIR'

  1. Case (% has type externFunctionTypeIR)

    1. (Let (extern_function text ( _parameterIR* ) : _typeIR) be (callableTypeIR' as externFunctionTypeIR))

    2. If ((text = "static_assert")), then

      1. Return (lctk)

  2. Case (% has type builtinSizeMethodTypeIR)

    1. (Let builtinSizeMethodTypeIR be (callableTypeIR' as builtinSizeMethodTypeIR))

    2. Return (lctk)

2. Otherwise

  1. Return (dyn)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:532:1-534:53:
dec $is_static_assert_callableTypeIR(callableTypeIR')

1. If ((callableTypeIR' has type externFunctionTypeIR)), then

  1. (Let (extern_function text ( _parameterIR* ) : _typeIR) be (callableTypeIR' as externFunctionTypeIR))

  2. If ((text = "static_assert")), then

    1. Return true

2. Otherwise

  1. Return false

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:540:1-544:45:
relation CallableTarget_ok: p, TC, callableTarget'

1. Case analysis on callableTarget'

  1. Case (% has type prefixedNonTypeName)

    1. (Let prefixedNonTypeName be (callableTarget' as prefixedNonTypeName))

    2. (Let prefixedNameIR be $prefixedNonTypeName(prefixedNonTypeName))

    3. Result in (prefixedNameIR as callableTargetIR)

  2. Case (% has type memberAccessExpression)

    1. (Let (memberAccessBase . member) be (callableTarget' as memberAccessExpression))

    2. Case analysis on memberAccessBase

      1. Case (% has type prefixedTypeName)

        1. (Let prefixedTypeName be (memberAccessBase as prefixedTypeName))

        2. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

        3. (Let nameIR be $name(member))

        4. Result in (type prefixedNameIR . nameIR)

      2. Case (% has type expression)

        1. (Let expression_base be (memberAccessBase as expression))

        2. (Let nameIR be $name(member))

        3. (Expr_ok: p TC |- expression_base : typedExpressionIR_base)

        4. Result in (typedExpressionIR_base . nameIR)

  3. Case (% has type parenthesizedExpression)

    1. (Let (( expression )) be (callableTarget' as parenthesizedExpression))

    2. (CallableTarget_ok: p TC |- expression : callableTargetIR)

    3. Result in (( callableTargetIR ))

1. Else Phantom#1615

2. If ((callableTarget' has type referenceExpression)), then

  1. (Let referenceExpression be (callableTarget' as referenceExpression))

  2. If ((referenceExpression matches pattern `THIS`)), then

    1. Result in (("this") as callableTargetIR)

  2. Else Phantom#1616

2. Else Phantom#1617

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:546:1-550:45:
relation CallableTarget_lvalue_ok: p, TC, lvalue

1. (Let expression be $lvalue_as_expression(lvalue))

2. (CallableTarget_ok: p TC |- expression : callableTargetIR)

3. Result in callableTargetIR

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:552:1-559:53:
relation CallableType_ok: p, TC, callableTargetIR'', typeArgumentIR*, argumentIR''*

1. If ((callableTargetIR'' has type prefixedNameIR)), then

  1. (Let prefixedNameIR be (callableTargetIR'' as prefixedNameIR))

  2. If ((typeArgumentIR* matches pattern [])), then

    1. (Let callResolution<callableTypeDefIR>? be $find_callableDef_overloaded_t(p, TC, prefixedNameIR, argumentIR''*))

    2. If ((callResolution<callableTypeDefIR>? matches pattern (_))), then

      1. (Let ?((callableId : callableTypeDefIR # id_default* # id_optional*)) be callResolution<callableTypeDefIR>?)

      2. If ((callableTypeDefIR has type actionTypeIR)), then

        1. (Let actionTypeIR be (callableTypeDefIR as actionTypeIR))

        2. Result in (actionTypeIR as callableTypeIR), [], id_default*, id_optional*

      2. Else Phantom#1618

    2. Else Phantom#1619

  2. Else Phantom#1620

  3. (Let callResolution<callableTypeDefIR>? be $find_callableDef_overloaded_t(p, TC, prefixedNameIR, argumentIR''*))

  4. If ((callResolution<callableTypeDefIR>? matches pattern (_))), then

    1. (Let ?((callableId : callableTypeDefIR # id_default* # id_optional*)) be callResolution<callableTypeDefIR>?)

