1. Return ({ (typeId : (unknown))* })

;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:23:20-23:39:
syntax inference = map<typeId, typeIR>

;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:29:1-29:73:
dec $infer(typeId'*, parameterIR*, parameterIR_optional*, argumentIR*)

1. If ((typeId'* matches pattern [])), then

  1. Return $empty_map<typeId, typeIR>

1. Else Phantom#1831

2. If ((typeId'* =/= [])), then

  1. (Let strictness_init be $empty_strictness(typeId'*))

  2. (Let B be $free_parameterIRs(parameterIR*))

  3. (Let B_optional be $free_parameterIRs(parameterIR_optional*))

  4. (Let ({ typeId_free* }) be $diff_set<typeId>(B_optional, B))

  5. (Let strict* be $repeat_<strict>((lax), |typeId_free*|))

  6. (Let strictness be $adds_map<typeId, strict>(strictness_init, typeId_free*, strict*))

  7. (Let constraint_init be $empty_constraint(typeId'*))

  8. (Let constraint_pair be $infer_pair(constraint_init, parameterIR, argumentIR))*

  9. (Let constraint_inferred be $merge_constraints(constraint_init, constraint_pair*))

  10. (Let inference be $resolve_constraint(strictness, constraint_inferred))

  11. (Let inference_resolved be $resolve_inference(inference))

  12. Return inference_resolved

2. Else Phantom#1832

;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:30:1-30:66:
dec $infer_pair(constraint, parameterIR, argumentIR)

1. If ((argumentIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

  2. (Let (_annotationList _direction typeIR_param _id _parameterInitializerOptIR) be parameterIR)

  3. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR))

  4. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

1. Else Phantom#1833

2. Case analysis on argumentIR

  1. Case (% matches pattern `% = %`)

    1. (Let (nameIR = typedExpressionIR) be argumentIR)

    2. (Let (_annotationList _direction typeIR_param _id _parameterInitializerOptIR) be parameterIR)

    3. (Let typeIR_arg be $type_of_typedExpressionIR(typedExpressionIR))

    4. Return $gen_constraint_pair(constraint, typeIR_param, typeIR_arg)

  2. Case (% matches pattern `% = _`)

    1. (Let (nameIR = _) be argumentIR)

    2. Return constraint

  3. Case (% matches pattern `_`)

    1. Return constraint

2. Else Phantom#1834

