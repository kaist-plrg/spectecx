    1. (Let (int < _nat >) be (typeIR'' as fixedIntTypeIR))

    2. Return true

  3. Case (% has type fixedBitTypeIR)

    1. (Let (bit < _nat >) be (typeIR'' as fixedBitTypeIR))

    2. Return true

  4. Case (% has type nameTypeIR)

    1. (Let nameTypeIR be (typeIR'' as nameTypeIR))

    2. Return true

  5. Case (% has type typedefTypeIR)

    1. (Let (typedef _typeId typeIR) be (typeIR'' as typedefTypeIR))

    2. Return $nestable_sequence_in_set(typeIR)

  6. Case (% has type newTypeIR)

    1. (Let newTypeIR be (typeIR'' as newTypeIR))

    2. Return true

  7. Case (% has type tupleTypeIR)

    1. (Let (tuple < typeIR* >) be (typeIR'' as tupleTypeIR))

    2. Return $forall_($nestable_sequence_in_set(typeIR)*)

  8. Case (% has type enumTypeIR)

    1. (Let enumTypeIR be (typeIR'' as enumTypeIR))

    2. Return true

  9. Case (% has type sequenceTypeIR)

    1. (Let sequenceTypeIR be (typeIR'' as sequenceTypeIR))

    2. If ((sequenceTypeIR matches pattern `SEQ <%>`)), then

      1. (Let (seq < typeIR* >) be sequenceTypeIR)

