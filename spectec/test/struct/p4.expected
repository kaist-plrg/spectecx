  18. Case (% has type packageTypeDeclaration)

    1. (Let (annotationList package name typeParameterListOpt ( parameterList ) ;) be (declaration as packageTypeDeclaration))

    2. (Let B be $bound((global), TC_0))

    3. (Let TC_1 be TC_0[block.kind = (package)])

    4. (TypeParameterListOpt_ok: (block) TC_1 |- typeParameterListOpt : TC_2 typeId_expl*)

    5. (ConstructorParameterListOpt_ok: TC_2 |- (( parameterList )) : TC_3 constructorParameterIR* # typeId_impl*)

    6. (Let nameIR be $name(name))

    7. (Let (_annotationList _direction typeIR_package_inner _id _parameterInitializerOptIR) be constructorParameterIR)*

    8. (Let packageObjectTypeDefIR be (package nameIR < typeId_expl* , typeId_impl* > { typeIR_package_inner* }))

