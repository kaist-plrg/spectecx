            1. (Let TBLC_1 be $add_action_tbl(TBLC', (. "NoAction"), [], []))

            2. (Let tableActionIR_NoAction be (() tableActionReferenceIR_NoAction # ( [] , [] ) ;))

            3. (Let tablePropertyIR_h_updated be ((actions = { tableActionIR* ++ [tableActionIR_NoAction] }) as tablePropertyIR))

