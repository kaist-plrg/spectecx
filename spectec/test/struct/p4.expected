          3. Else Phantom#2091

        3. Else Phantom#2092

      2. Else Phantom#2093

    7. Else Phantom#2094

    8. (Lvalue_eval: p EC' ARCH' |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult')

    9. If ((storageReferenceResult' has type continueResult<storageReference?>)), then

      1. (Let (storageReference'?) be (storageReferenceResult' as continueResult<storageReference?>))

      2. If ((storageReference'? matches pattern (_))), then

        1. (Let ?(storageReference) be storageReference'?)

        2. (Lvalue_read: p EC_1 ARCH_1 |- storageReference : value)

