        1. Else Phantom#1651

    3. Else Phantom#1652

    4. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

    5. (Let typeIR be $unroll_typeIR(typeIR_base))

    6. If ((typeIR has type externObjectTypeIR)), then

      1. (Let (extern typeId < _typeArgumentIR* > ({ (callableId_extern : externMethodTypeDefIR_extern)* })) be (typeIR as externObjectTypeIR))

      2. (Let callTargetKey be $callTargetKey(nameIR, argumentIR''*))

