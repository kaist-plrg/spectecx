  2. Case (% has type assignmentStatement)

    1. (Let (lvalue assignop expression ;) be (statement'' as assignmentStatement))

    2. Case analysis on (assignop matches pattern `=`)

      1. Case true

        1. (Lvalue_ok: p' TC' |- lvalue : typedLvalueIR)

        2. (Expr_ok: p' TC' |- expression : typedExpressionIR)

        3. (Let typeIR_l be $type_of_typedLvalueIR(typedLvalueIR))

        4. (Let typeIR_r be $type_of_typedExpressionIR(typedExpressionIR))

        5. (Let typedExpressionIR'? be $cast_unary(typedExpressionIR, typeIR_l))

        6. If ((typedExpressionIR'? matches pattern (_))), then

