    2. Else Phantom#1128

2. Case analysis on _bool'

  1. Case (% = true)

    1. If ((direction''* matches pattern _ :: _)), then

      1. (Let direction :: direction_t* be direction''*)

      2. If ((direction matches pattern `_EMPTY`)), then

        1. Return $directionless_trailing'(true, direction_t*)

      2. Else Phantom#1129

    1. Else Phantom#1130

  2. Case (% = false)

    1. If ((direction''* matches pattern _ :: _)), then

      1. (Let direction :: direction_t* be direction''*)

