;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:167:1-168:27:
syntax parserStatementResult = 
   |  (from continueEmptyResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:170:1-177:42:
relation ParserStmt_eval: EC_0', ARCH_0', parserStatementIR

1. Case analysis on parserStatementIR

  1. Case (% has type emptyStatementIR)

    1. (Let emptyStatementIR be (parserStatementIR as emptyStatementIR))

    2. (Stmt_eval: (local) EC_0' ARCH_0' |- (emptyStatementIR as statementIR) : EC_1 ARCH_1 statementResult)

    3. If ((statementResult has type continueEmptyResult)), then

      1. (Let continueEmptyResult be (statementResult as continueEmptyResult))

      2. If ((continueEmptyResult matches pattern `_EMPTY`)), then

        1. Result in EC_1, ARCH_1, (() as parserStatementResult)

      2. Else Phantom#2163

    3. Else Phantom#2164

  2. Case (% has type assignmentStatementIR)

    1. (Let assignmentStatementIR be (parserStatementIR as assignmentStatementIR))

    2. (Stmt_eval: (local) EC_0' ARCH_0' |- (assignmentStatementIR as statementIR) : EC_1 ARCH_1 statementResult)

    3. If ((statementResult has type rejectTransitionResult)), then

      1. (Let rejectTransitionResult be (statementResult as rejectTransitionResult))

      2. Result in EC_1, ARCH_1, (rejectTransitionResult as parserStatementResult)

    3. Else Phantom#2165

    4. (Stmt_eval: (local) EC_0' ARCH_0' |- (assignmentStatementIR as statementIR) : EC_1 ARCH_1 statementResult)

    5. If ((statementResult has type continueEmptyResult)), then

      1. (Let continueEmptyResult be (statementResult as continueEmptyResult))

      2. If ((continueEmptyResult matches pattern `_EMPTY`)), then

        1. Result in EC_1, ARCH_1, (() as parserStatementResult)

      2. Else Phantom#2166

    5. Else Phantom#2167

  3. Case (% has type callStatementIR)

    1. (Let callStatementIR be (parserStatementIR as callStatementIR))

    2. (Stmt_eval: (local) EC_0' ARCH_0' |- (callStatementIR as statementIR) : EC_1 ARCH_1 statementResult)

    3. If ((statementResult has type rejectTransitionResult)), then

      1. (Let rejectTransitionResult be (statementResult as rejectTransitionResult))

      2. Result in EC_1, ARCH_1, (rejectTransitionResult as parserStatementResult)

    3. Else Phantom#2168

    4. (Stmt_eval: (local) EC_0' ARCH_0' |- (callStatementIR as statementIR) : EC_1 ARCH_1 statementResult)

    5. If ((statementResult has type continueEmptyResult)), then

      1. (Let continueEmptyResult be (statementResult as continueEmptyResult))

      2. If ((continueEmptyResult matches pattern `_EMPTY`)), then

        1. Result in EC_1, ARCH_1, (() as parserStatementResult)

      2. Else Phantom#2169

    5. Else Phantom#2170

  4. Case (% has type parserBlockStatementIR)

    1. (Let parserBlockStatementIR be (parserStatementIR as parserBlockStatementIR))

    2. (Let EC_1 be $enter_e(EC_0'))

    3. (ParserBlock_eval: EC_1 ARCH_0' |- parserBlockStatementIR : EC_2 ARCH_1 parserStatementResult)

    4. (Let EC_3 be $exit_e(EC_2))

    5. Result in EC_3, ARCH_1, parserStatementResult

  5. Case (% has type parserConditionalStatementIR)

    1. (Let parserConditionalStatementIR be (parserStatementIR as parserConditionalStatementIR))

    2. Case analysis on parserConditionalStatementIR

      1. Case (% matches pattern `IF (%) %`)

        1. (Let (if ( typedExpressionIR_cond ) parserStatementIR_then) be parserConditionalStatementIR)

        2. (Expr_eval: (local) EC_0' ARCH_0' |- typedExpressionIR_cond : EC_cond ARCH_cond expressionResult)

        3. If ((expressionResult has type rejectTransitionResult)), then

          1. (Let rejectTransitionResult be (expressionResult as rejectTransitionResult))

          2. Result in EC_cond, ARCH_cond, (rejectTransitionResult as parserStatementResult)

        3. Else Phantom#2171

        4. If ((expressionResult = ((((true) as value)) as expressionResult))), then

          1. (ParserStmt_eval: EC_cond ARCH_cond |- parserStatementIR_then : EC_then ARCH_then parserStatementResult)

          2. Result in EC_then, ARCH_then, parserStatementResult

        4. Else Phantom#2172

        5. If ((expressionResult = ((((false) as value)) as expressionResult))), then

          1. Result in EC_cond, ARCH_cond, (() as parserStatementResult)

        5. Else Phantom#2173

      2. Case (% matches pattern `IF (%) % ELSE %`)

        1. (Let (if ( typedExpressionIR_cond ) parserStatementIR_then else parserStatementIR_else) be parserConditionalStatementIR)

        2. (Expr_eval: (local) EC_0' ARCH_0' |- typedExpressionIR_cond : EC_cond ARCH_cond expressionResult)

        3. If ((expressionResult has type rejectTransitionResult)), then

          1. (Let rejectTransitionResult be (expressionResult as rejectTransitionResult))

          2. Result in EC_cond, ARCH_cond, (rejectTransitionResult as parserStatementResult)

        3. Else Phantom#2174

        4. If ((expressionResult = ((((true) as value)) as expressionResult))), then

          1. (ParserStmt_eval: EC_cond ARCH_cond |- parserStatementIR_then : EC_then ARCH_then parserStatementResult)

          2. Result in EC_then, ARCH_then, parserStatementResult

        4. Else Phantom#2175

        5. If ((expressionResult = ((((false) as value)) as expressionResult))), then

          1. (ParserStmt_eval: EC_cond ARCH_cond |- parserStatementIR_else : EC_else ARCH_else parserStatementResult)

          2. Result in EC_else, ARCH_else, parserStatementResult

        5. Else Phantom#2176

1. Else Phantom#2177

