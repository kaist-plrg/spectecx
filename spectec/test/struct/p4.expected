dec $expression_as_expressionNonBrace(expression'')

1. Case analysis on expression''

  1. Case (% has type literalExpression)

    1. (Let literalExpression be (expression'' as literalExpression))

    2. Return (literalExpression as expressionNonBrace)

  2. Case (% has type referenceExpression)

    1. (Let referenceExpression be (expression'' as referenceExpression))

    2. Return (referenceExpression as expressionNonBrace)

  3. Case (% has type unaryExpression)

    1. (Let unaryExpression be (expression'' as unaryExpression))

    2. Return (unaryExpression as expressionNonBrace)

  4. Case (% has type binaryExpression)

    1. (Let (expression_l binop expression_r) be (expression'' as binaryExpression))

    2. (Let expressionNonBrace_l be $expression_as_expressionNonBrace(expression_l))

    3. Return ((expressionNonBrace_l binop expression_r) as expressionNonBrace)

  5. Case (% has type ternaryExpression)

    1. (Let (expression_cond ? expression_true : expression_false) be (expression'' as ternaryExpression))

    2. (Let expressionNonBrace_cond be $expression_as_expressionNonBrace(expression_cond))

    3. Return ((expressionNonBrace_cond ? expression_true : expression_false) as expressionNonBrace)

  6. Case (% has type castExpression)

    1. (Let castExpression be (expression'' as castExpression))

    2. Return (castExpression as expressionNonBrace)

  7. Case (% has type errorAccessExpression)

    1. (Let errorAccessExpression be (expression'' as errorAccessExpression))

    2. Return (errorAccessExpression as expressionNonBrace)

  8. Case (% has type memberAccessExpression)

    1. (Let (memberAccessBase . member) be (expression'' as memberAccessExpression))

    2. Case analysis on memberAccessBase

      1. Case (% has type prefixedTypeName)

        1. (Let prefixedTypeName be (memberAccessBase as prefixedTypeName))

        2. Return (((prefixedTypeName as memberAccessBaseNonBrace) . member) as expressionNonBrace)

      2. Case (% has type expression)

        1. (Let expression_base be (memberAccessBase as expression))

        2. (Let expressionNonBrace_base be $expression_as_expressionNonBrace(expression_base))

        3. Return (((expressionNonBrace_base as memberAccessBaseNonBrace) . member) as expressionNonBrace)

  9. Case (% has type indexAccessExpression)

    1. (Let (expression_base [ expression_index ]) be (expression'' as indexAccessExpression))

    2. (Let expressionNonBrace_base be $expression_as_expressionNonBrace(expression_base))

    3. Return ((expressionNonBrace_base [ expression_index ]) as expressionNonBrace)

  10. Case (% has type sliceAccessExpression)

    1. (Let (expression_base [ expression_hi sliceop expression_lo ]) be (expression'' as sliceAccessExpression))

    2. If ((sliceop matches pattern `:`)), then

      1. (Let expressionNonBrace_base be $expression_as_expressionNonBrace(expression_base))

      2. Return ((expressionNonBrace_base [ expression_hi (:) expression_lo ]) as expressionNonBrace)

