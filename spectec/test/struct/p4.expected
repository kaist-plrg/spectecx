3. Result in EC_1

;; ../../../../../spectec/specs/p4/9-arch/9.0-eval-arch.spectec:28:1-33:43:
relation Extern_init: EC, ARCH_0, nameIR_extern, nameIR

1. (Let IC be {path [], global EC.global, block EC.block, local EC.local})

2. (Constructor_inst: (global) IC |- (nameIR_extern) < [] > ( [] ) : constructorDef < typeArgumentIR* > ( # id* # id'* ))

3. If ((typeArgumentIR* matches pattern [])), then

  1. If ((id* matches pattern [])), then

    1. If ((id'* matches pattern [])), then

      1. (Let STO be ARCH_0.store)

      2. (Constructor_call: (global) IC STO |- constructorDef < [] > ( [] # [] # [] ) : STO_1 object)

      3. (Let ARCH_1 be ARCH_0[store = STO_1])

      4. (Let objectId_object be [nameIR])

      5. (Let ARCH_2 be $add_object_e(ARCH_1, objectId_object, object))

      6. Result in ARCH_2

    1. Else Phantom#2455

  1. Else Phantom#2456

3. Else Phantom#2457

