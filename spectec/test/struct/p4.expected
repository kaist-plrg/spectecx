          1. Result in EC_1, ARCH_1, ((exit) as tableMatchesResult)

        2. Else Phantom#2435

      2. Case (% has type continueResult<tableMatch?>)

        1. (Let (tableMatch_h?) be (tableMatchResult as continueResult<tableMatch?>))

        2. (TableMatches_eval: EC_1 ARCH_1 |- tableKeyValue* @ tableEntryIR_t* : EC_2 ARCH_2 tableMatchesResult)

        3. Case analysis on tableMatchesResult

          1. Case (% has type exitResult)

            1. (Let exitResult be (tableMatchesResult as exitResult))

            2. If ((exitResult matches pattern `EXIT`)), then

              1. Result in EC_2, ARCH_2, ((exit) as tableMatchesResult)

            2. Else Phantom#2436

          2. Case (% has type continueResult<tableMatch*>)

            1. (Let (tableMatch_t*) be (tableMatchesResult as continueResult<tableMatch*>))

            2. (Let tableMatch* be $opt_as_seq_<tableMatch>(tableMatch_h?) ++ tableMatch_t*)

            3. Result in EC_2, ARCH_2, ((tableMatch*) as tableMatchesResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.09.1-eval-control-table.spectec:202:1-204:70:
dec $largest_priority_wins(TBL)

1. (Let tableCustomPropertyIR* be TBL.customs)

2. (Let tableCustomPropertyIR''* be $filter_<tableCustomPropertyIR>(tableCustomPropertyIR*, $is_largest_priority_wins(tableCustomPropertyIR)*))

3. If ((tableCustomPropertyIR''* matches pattern [ _/1 ])), then

  1. (Let [tableCustomPropertyIR'] be tableCustomPropertyIR''*)

  2. If ((tableCustomPropertyIR' matches pattern `% % CUSTOM_CONST % % ;`)), then

    1. (Let (_annotationList _constOptIR custom_const _nameIR (= value) ;) be tableCustomPropertyIR')

    2. If ((value has type boolValue)), then

      1. (Let (b) be (value as boolValue))

      2. Return b

    2. Else Phantom#2437

  2. Else Phantom#2438

3. Else Phantom#2439

4. If (([] = $filter_<tableCustomPropertyIR>(tableCustomPropertyIR*, $is_largest_priority_wins(tableCustomPropertyIR)*))), then

  1. Return true

4. Else Phantom#2440

;; ../../../../../spectec/specs/p4/8-dynamic/8.09.1-eval-control-table.spectec:205:1-205:60:
dec $is_largest_priority_wins(tableCustomPropertyIR')

1. If ((tableCustomPropertyIR' matches pattern `% % CUSTOM_CONST % % ;`)), then

  1. (Let (_annotationList _constOptIR custom_const text _constantInitializerIR ;) be tableCustomPropertyIR')

  2. If ((text = "largest_priority_wins")), then

    1. Return true

2. Otherwise

  1. Return false

;; ../../../../../spectec/specs/p4/8-dynamic/8.09.1-eval-control-table.spectec:226:1-228:71:
dec $select_action(TBL, tableMatch''*)

1. Case analysis on tableMatch''*

  1. Case (% matches pattern [])

    1. (Let (_annotationList _constOptIR default_action = tableActionReferenceIR ;) be TBL.default_action)

    2. Return tableActionReferenceIR

  2. Case (% matches pattern [ _/1 ])

    1. (Let [tableMatch] be tableMatch''*)

    2. (Let (_nat? : tableActionReferenceIR) be tableMatch)

    3. Return tableActionReferenceIR

1. Else Phantom#2441

2. If ((|tableMatch''*| > 1)), then

  1. (Let (nat? : tableActionReferenceIR) be tableMatch'')*

  2. If ((nat? matches pattern (_)))*, then

    1. (Let ?(n_priority) be nat?)*

    2. (Let (n_priority_sorted, tableActionReferenceIR_sorted)* be $sort_<tableActionReferenceIR>((n_priority, tableActionReferenceIR)*))

    3. Case analysis on $largest_priority_wins(TBL)

      1. Case true

        1. (Let tableActionReferenceIR'* be $rev_<tableActionReferenceIR>(tableActionReferenceIR_sorted*))

        2. If ((tableActionReferenceIR'* matches pattern _ :: _)), then

          1. (Let tableActionReferenceIR_h :: _tableActionReferenceIR* be tableActionReferenceIR'*)

          2. Return tableActionReferenceIR_h

        2. Else Phantom#2442

      2. Case false

        1. (Let tableActionReferenceIR'* be tableActionReferenceIR_sorted*)

        2. If ((tableActionReferenceIR'* matches pattern _ :: _)), then

          1. (Let tableActionReferenceIR_h :: _tableActionReferenceIR* be tableActionReferenceIR'*)

          2. Return tableActionReferenceIR_h

        2. Else Phantom#2443

  2. Else Phantom#2444

2. Else Phantom#2445

