;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:40:1-42:12:
syntax tableEntryState = 
   | lpm nat (from tableEntryState)
   | non_lpm (from tableEntryState)

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:50:1-50:38:
dec $empty_tableContext

1. (Let matchPriority be {delta 1, largest_wins true})

2. (Let matchEntries be {size 0, const true})

3. Return {keys [], actions [], priorities matchPriority, entries matchEntries, mode (none)}

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:70:1-71:61:
dec $add_key_tbl(TBLC, id, typeIR)

1. (Let matchKey be (typeIR : id))

2. Return TBLC[keys = TBLC.keys ++ [matchKey]]

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:79:1-81:79:
dec $add_action_tbl(TBLC, prefixedNameIR, parameterIR*, argumentListIR)

1. (Let matchAction be (prefixedNameIR ( parameterIR* @ argumentListIR )))

2. Return TBLC[actions = TBLC.actions ++ [matchAction]]

;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:92:1-94:62:
