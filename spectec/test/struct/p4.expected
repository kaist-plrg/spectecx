            2. (Let constructorId be $constructorId(name, constructorParameterListOpt))

            3. (Let typeDefIR_parser be ((parser nameIR < [] , [] > ( parameterIR* )) as typeDefIR))

            4. (Let typeIR_parser be $typeIR_of_typeDefIR(typeDefIR_parser))

            5. (Let constructorTypeDefIR be (constructor < [] , [] > ( constructorParameterIR* ) : typeIR_parser))

            6. If (ConstructorTypeDef_wf: $bound((global), TC_0) |- constructorTypeDefIR holds), then

              1. (Let TC_6 be $add_constructorDef_t(TC_0, constructorId, constructorTypeDefIR))

              2. (Let parserDeclarationIR be (annotationList parser nameIR < [] , [] > ( parameterIR* ) ( constructorParameterIR* ) { parserLocalDeclarationIR* parserStateIR* }))

              3. Result in TC_6, (parserDeclarationIR as declarationIR)

            6. Else Phantom#1557

          5. Else Phantom#1558

        2. Else Phantom#1559

      2. Else Phantom#1560

    3. Else Phantom#1561

  10. Case (% has type controlDeclaration)

    1. (Let (annotationList control name typeParameterListOpt ( parameterList ) constructorParameterListOpt { controlLocalDeclarationList apply controlBody }) be (declaration as controlDeclaration))

    2. (Let TC_1 be TC_0[block.kind = (control)])

    3. If ((typeParameterListOpt matches pattern `_EMPTY`)), then

      1. (ConstructorParameterListOpt_ok: TC_1 |- constructorParameterListOpt : TC_2 constructorParameterIR* # typeId*)

      2. If ((typeId* matches pattern [])), then

        1. (ParameterList_ok: (block) TC_2 |- parameterList : TC_3 parameterIR* # typeId'*)

        2. If ((typeId'* matches pattern [])), then

          1. (ControlLocalDeclList_ok: TC_3 |- controlLocalDeclarationList : TC_4 controlLocalDeclarationIR*)

          2. (Let TC_5 be TC_4[local.kind = ((control_apply_method) as localKind)])

          3. (Let TC_6 be TC_5[control = (cont)][loop = (out)])

          4. (Block_ok: TC_6 |- controlBody : _typingContext controlBodyIR)

          5. (Let callableTypeDefIR be ((control_apply ( parameterIR* )) as callableTypeDefIR))

          6. If (CallableTypeDef_wf: $bound((block), TC_1) |- callableTypeDefIR holds), then

            1. (Let nameIR be $name(name))

            2. (Let constructorId be $constructorId(name, constructorParameterListOpt))

            3. (Let typeDefIR_control be ((control nameIR < [] , [] > ( parameterIR* )) as typeDefIR))

            4. (Let typeIR_control be $typeIR_of_typeDefIR(typeDefIR_control))

            5. (Let constructorTypeDefIR be (constructor < [] , [] > ( constructorParameterIR* ) : typeIR_control))

