;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:44:1-45:16:
syntax expressionListResult = 
   | value* (from continueResult<value*>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:47:1-52:54:
relation Exprs_eval: p, EC', ARCH', typedExpressionIR*

1. Case analysis on typedExpressionIR*

  1. Case (% matches pattern [])

    1. Result in EC', ARCH', (([]) as expressionListResult)

  2. Case (% matches pattern _ :: _)

    1. (Let typedExpressionIR_h :: typedExpressionIR_t* be typedExpressionIR*)

    2. (Expr_eval: p EC' ARCH' |- typedExpressionIR_h : EC_1 ARCH_1 expressionResult)

    3. Case analysis on expressionResult

      1. Case (% has type abortResult)

        1. (Let abortResult be (expressionResult as abortResult))

        2. Result in EC_1, ARCH_1, (abortResult as expressionListResult)

      2. Case (% has type continueResult<value>)

        1. (Let (value_h) be (expressionResult as continueResult<value>))

        2. (Exprs_eval: p EC_1 ARCH_1 |- typedExpressionIR_t* : EC_2 ARCH_2 expressionListResult)

        3. Case analysis on expressionListResult

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionListResult as abortResult))

            2. Result in EC_2, ARCH_2, (abortResult as expressionListResult)

          2. Case (% has type continueResult<value*>)

            1. (Let (value_t*) be (expressionListResult as continueResult<value*>))

            2. Result in EC_2, ARCH_2, ((value_h :: value_t*) as expressionListResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:55:1-56:16:
syntax keysetExpressionResult = 
   | setValue* (from continueResult<setValue*>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:58:1-63:62:
relation Eval_keyset: EC_0, ARCH_0, keysetExpressionIR

1. (Let simpleKeysetExpressionListIR be $flatten_keysetExpressionIR(keysetExpressionIR))

2. (Eval_keysets_simple: EC_0 ARCH_0 |- simpleKeysetExpressionListIR : EC_1 ARCH_1 keysetExpressionResult)

3. Result in EC_1, ARCH_1, keysetExpressionResult

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:69:1-72:26:
relation Argument_eval: p, EC_0, ARCH_0, argumentIR

1. If ((argumentIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

  2. (Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

  3. Result in EC_1, ARCH_1, expressionResult

1. Else Phantom#2074

2. If ((argumentIR matches pattern `% = %`)), then

  1. (Let (nameIR = typedExpressionIR) be argumentIR)

  2. (Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

  3. Result in EC_1, ARCH_1, expressionResult

2. Else Phantom#2075

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:75:1-76:16:
syntax storageReferenceResult = 
   | storageReference? (from continueResult<storageReference?>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:78:1-81:26:
relation Argument_eval_lvalue: p, EC_0', ARCH_0', argumentIR

1. If ((argumentIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

  2. (Let typedLvalueIR'? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

  3. If ((typedLvalueIR'? matches pattern (_))), then

    1. (Let ?(typedLvalueIR) be typedLvalueIR'?)

    2. (Lvalue_eval: p EC_0' ARCH_0' |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

    3. Result in EC_1, ARCH_1, storageReferenceResult

  3. Else Phantom#2076

1. Else Phantom#2077

2. Case analysis on argumentIR

  1. Case (% matches pattern `% = %`)

    1. (Let (nameIR = typedExpressionIR) be argumentIR)

    2. (Let typedLvalueIR'? be $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

    3. If ((typedLvalueIR'? matches pattern (_))), then

      1. (Let ?(typedLvalueIR) be typedLvalueIR'?)

      2. (Lvalue_eval: p EC_0' ARCH_0' |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

      3. Result in EC_1, ARCH_1, storageReferenceResult

    3. Else Phantom#2078

  2. Case (% matches pattern `% = _`)

    1. (Let (nameIR = _) be argumentIR)

    2. Result in EC_0', ARCH_0', ((?()) as storageReferenceResult)

  3. Case (% matches pattern `_`)

    1. Result in EC_0', ARCH_0', ((?()) as storageReferenceResult)

2. Else Phantom#2079

