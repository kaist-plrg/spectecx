builtin dec $bitstr_to_int(int, int')

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:13:1-14:75:
builtin dec $int_to_bitstr(int, int')

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:20:14-20:18:
syntax bit = bool

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:21:15-21:19:
syntax bits = bit*

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:23:1-23:46:
