                3. If ((typeDefIR'? matches pattern (_))), then

                  1. (Let ?(typeDefIR) be typeDefIR'?)

                  2. If (~$is_monomorphic_typeDefIR(typeDefIR)), then

                    1. If ((([], []) = $typeParameterListIR_of_typeDefIR(typeDefIR))), then

                      1. (Let nameIR be $name(name))

                      2. (Let typeIR be $specialize_typeDefIR(typeDefIR, []))

                      3. (Let typedefTypeIR be (typedef nameIR typeIR))

                      4. If (TypeDef_wf: $bound((global), TC_0) |- (typedefTypeIR as typeDefIR) holds), then

                        1. (Let TC_2 be $add_typeDef_t((global), TC_1, nameIR, (typedefTypeIR as typeDefIR)))

                        2. (Let typedefDeclarationIR be (annotationList typedef (derivedTypeDeclarationIR as typedefIR) nameIR ;))

                        3. Result in TC_2, (typedefDeclarationIR as declarationIR)

                      4. Else Phantom#1585

                    1. Else Phantom#1586

                  2. Else Phantom#1587

                3. Else Phantom#1588

              3. Else Phantom#1589

            5. Else Phantom#1590

      2. Case (% matches pattern `% TYPE % % ;`)

        1. (Let (annotationList type type name ;) be typedefDeclaration)

        2. (Let B be $bound((global), TC_0))

        3. (Type_ok: (global) TC_0 |- (type as typeOrVoid) : typeIR # typeId*)

        4. If ((typeId* matches pattern [])), then

          1. If (Type_wf: B |- typeIR holds), then

            1. (Let nameIR be $name(name))

            2. (Let newTypeIR be (type nameIR typeIR))

            3. If (TypeDef_wf: B |- (newTypeIR as typeDefIR) holds), then

              1. (Let TC_1 be $add_typeDef_t((global), TC_0, nameIR, (newTypeIR as typeDefIR)))

              2. (Let typedefDeclarationIR be (annotationList type typeIR nameIR ;))

              3. Result in TC_1, (typedefDeclarationIR as declarationIR)

            3. Else Phantom#1591

          1. Else Phantom#1592

        4. Else Phantom#1593

  16. Case (% has type parserTypeDeclaration)

    1. (Let (annotationList parser name typeParameterListOpt ( parameterList ) ;) be (declaration as parserTypeDeclaration))

    2. (Let TC_1 be TC_0[block.kind = (parser)])

    3. (TypeParameterListOpt_ok: (block) TC_1 |- typeParameterListOpt : TC_2 typeId_expl*)

    4. (ParameterList_ok: (block) TC_2 |- parameterList : TC_3 parameterIR* # typeId_impl*)

    5. (Let nameIR be $name(name))

    6. (Let parserObjectTypeDefIR be (parser nameIR < typeId_expl* , typeId_impl* > ( parameterIR* )))

    7. If (TypeDef_wf: $bound((global), TC_0) |- (parserObjectTypeDefIR as typeDefIR) holds), then

      1. (Let TC_4 be $add_typeDef_t((global), TC_0, nameIR, (parserObjectTypeDefIR as typeDefIR)))

      2. (Let parserTypeDeclarationIR be (annotationList parser nameIR < typeId_expl* , typeId_impl* > ( parameterIR* ) ;))

      3. Result in TC_4, (parserTypeDeclarationIR as declarationIR)

    7. Else Phantom#1594

  17. Case (% has type controlTypeDeclaration)

    1. (Let (annotationList control name typeParameterListOpt ( parameterList ) ;) be (declaration as controlTypeDeclaration))

    2. (Let TC_1 be TC_0[block.kind = (control)])

    3. (TypeParameterListOpt_ok: (block) TC_1 |- typeParameterListOpt : TC_2 typeId_expl*)

    4. (ParameterList_ok: (block) TC_2 |- parameterList : TC_3 parameterIR* # typeId_impl*)

    5. (Let nameIR be $name(name))

    6. (Let controlObjectTypeDefIR be (control nameIR < typeId_expl* , typeId_impl* > ( parameterIR* )))

    7. If (TypeDef_wf: $bound((global), TC_0) |- (controlObjectTypeDefIR as typeDefIR) holds), then

      1. (Let TC_4 be $add_typeDef_t((global), TC_0, nameIR, (controlObjectTypeDefIR as typeDefIR)))

      2. (Let controlTypeDeclarationIR be (annotationList control nameIR < typeId_expl* , typeId_impl* > ( parameterIR* ) ;))

      3. Result in TC_4, (controlTypeDeclarationIR as declarationIR)

