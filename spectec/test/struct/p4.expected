      4. Case (% has type headerUnionValue)

        1. (Let headerUnionValue_base be (value' as headerUnionValue))

        2. (Let (header_union _typeId { (value_field nameIR_field ;)* }) be headerUnionValue_base)

        3. (Let value''? be $assoc_<id, value>(nameIR, (nameIR_field, value_field)*))

        4. If ((value''? matches pattern (_))), then

          1. (Let ?(value) be value''?)

          2. Result in value

        4. Else Phantom#2122

    5. Else Phantom#2123

  2. Case (% matches pattern `% [%]`)

    1. (Let (storageReference [ value' ]) be storageReference'')

    2. If ((value' has type integerValue)), then

      1. (Let integerValue_index be (value' as integerValue))

      2. (Lvalue_read: p EC' ARCH |- storageReference : value'')

      3. Case analysis on value''

        1. Case (% has type arrayValue)

          1. (Let arrayValue_base be (value'' as arrayValue))

          2. (Let (array [ value_element* ]) be arrayValue_base)

          3. (Let n_size be |value_element*|)

          4. (Let i_idx be $int_of_integerValue(integerValue_index))

          5. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

          6. Case analysis on b_in_bounds

            1. Case true

              1. If ((i_idx has type nat)), then

                1. (Let n_idx be (i_idx as nat))

                2. (Let value be value_element*[n_idx])

                3. Result in value

              1. Else Phantom#2124

            2. Case false

              1. (Let value''' be value_element*[0])

              2. If ((value''' has type headerValue)), then

                1. (Let (header typeId { b_valid ; fieldValue* }) be (value''' as headerValue))

                2. (Let value be ((header typeId { false ; fieldValue* }) as value))

                3. Result in value

              2. Else Phantom#2125

        2. Case (% has type headerStackValue)

          1. (Let headerStackValue_base be (value'' as headerStackValue))

          2. (Let (header_stack [ value_element* ( _nat ) ]) be headerStackValue_base)

          3. (Let n_size be |value_element*|)

          4. (Let i_idx be $int_of_integerValue(integerValue_index))

          5. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

          6. Case analysis on b_in_bounds

            1. Case true

              1. If ((i_idx has type nat)), then

                1. (Let n_idx be (i_idx as nat))

                2. (Let value be value_element*[n_idx])

                3. Result in value

              1. Else Phantom#2126

            2. Case false

              1. (Let value''' be value_element*[0])

              2. If ((value''' has type headerValue)), then

                1. (Let (header typeId { b_valid ; fieldValue* }) be (value''' as headerValue))

                2. (Let value be ((header typeId { false ; fieldValue* }) as value))

                3. Result in value

              2. Else Phantom#2127

      3. Else Phantom#2128

    2. Else Phantom#2129

  3. Case (% matches pattern `% [% % %]`)

    1. (Let (storageReference [ value_hi sliceop value_lo ]) be storageReference'')

    2. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Lvalue_read: p EC' ARCH |- storageReference : value_base)

        2. (Let value be $bitacc_range_op(value_base, value_hi, value_lo))

        3. Result in value

      2. Case (% matches pattern `+:`)

        1. (Lvalue_read: p EC' ARCH |- storageReference : value_base)

        2. (Let value be $bitacc_offset_op(value_base, value_hi, value_lo))

        3. Result in value

2. Else Phantom#2130

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:100:1-105:31:
relation Lvalue_write: p, EC_0, ARCH, storageReference'', value

1. If ((storageReference'' has type prefixedNameIR)), then

  1. (Let prefixedNameIR be (storageReference'' as prefixedNameIR))

  2. (Let EC_1 be $update_var_e(p, EC_0, prefixedNameIR, value))

  3. Result in EC_1

1. Else Phantom#2131

2. Case analysis on storageReference''

  1. Case (% matches pattern `% . %`)

    1. (Let (storageReference . nameIR) be storageReference'')

    2. (Lvalue_read: p EC_0 ARCH |- storageReference : value')

    3. Case analysis on value'

      1. Case (% has type headerStackValue)

        1. (Let headerStackValue_base be (value' as headerStackValue))

        2. (Let (header_stack [ value_element* ( n_idx ) ]) be headerStackValue_base)

        3. Case analysis on nameIR

          1. Case (% = "next")

            1. (Let value_element_update* be value_element*[[n_idx] = value])

            2. (Let headerStackValue_base_update be (header_stack [ value_element_update* ( (n_idx + 1) ) ]))

            3. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

            4. Result in EC_1

          2. Case (% = "last")

            1. (Let n_idx_last be (n_idx - 1))

            2. (Let value_element_update* be value_element*[[n_idx_last] = value])

            3. (Let headerStackValue_base_update be (header_stack [ value_element_update* ( n_idx ) ]))

            4. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

            5. Result in EC_1

        3. Else Phantom#2132

      2. Case (% has type structValue)

        1. (Let structValue_base be (value' as structValue))

        2. (Let (struct typeId { fieldValue* }) be structValue_base)

        3. (Let fieldValue_update* be $update_fieldValue(fieldValue*, nameIR, value))

        4. (Let structValue_base_update be (struct typeId { fieldValue_update* }))

        5. (Lvalue_write: p EC_0 ARCH |- storageReference := (structValue_base_update as value) : EC_1)

        6. Result in EC_1

      3. Case (% has type headerValue)

        1. (Let headerValue_base be (value' as headerValue))

        2. (Let (header typeId { b_valid ; fieldValue* }) be headerValue_base)

        3. (Let fieldValue_update* be $update_fieldValue(fieldValue*, nameIR, value))

        4. (Let headerValue_base_update be (header typeId { b_valid ; fieldValue_update* }))

        5. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerValue_base_update as value) : EC_1)

        6. Result in EC_1

      4. Case (% has type headerUnionValue)

        1. (Let headerUnionValue_base be (value' as headerUnionValue))

        2. (Let (header_union typeId { fieldValue* }) be headerUnionValue_base)

        3. (Let (value_field nameIR_field ;)* be fieldValue*)

        4. (Let value''? be $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*))

        5. If ((value''? matches pattern (_))), then

          1. (Let ?(value_old) be value''?)

          2. If ((value_old has type headerValue)), then

            1. (Let (header _typeId { b_valid_old ; _fieldValue* }) be (value_old as headerValue))

            2. (Let fieldValue_update* be $update_fieldValue(fieldValue*, nameIR, value))

            3. If ((value has type headerValue)), then

              1. (Let (header _typeId' { b_valid_new ; _fieldValue'* }) be (value as headerValue))

              2. (Let b_toggled be ((~b_valid_old /\ b_valid_new) \/ (b_valid_old /\ ~b_valid_new)))

              3. Case analysis on b_toggled

                1. Case false

                  1. (Let headerUnionValue_base_update be (header_union typeId { fieldValue_update* }))

                  2. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerUnionValue_base_update as value) : EC_1)

                  3. Result in EC_1

                2. Case true

                  1. (Let fieldValue_update'* be $update_headerUnion(fieldValue_update*, nameIR))

                  2. (Let headerUnionValue_base_update be (header_union typeId { fieldValue_update'* }))

                  3. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerUnionValue_base_update as value) : EC_1)

                  4. Result in EC_1

            3. Else Phantom#2133

          2. Else Phantom#2134

        5. Else Phantom#2135

    3. Else Phantom#2136

  2. Case (% matches pattern `% [%]`)

    1. (Let (storageReference [ value' ]) be storageReference'')

    2. If ((value' has type integerValue)), then

      1. (Let integerValue_index be (value' as integerValue))

      2. (Lvalue_read: p EC_0 ARCH |- storageReference : value'')

      3. Case analysis on value''

        1. Case (% has type arrayValue)

          1. (Let arrayValue_base be (value'' as arrayValue))

          2. (Let (array [ value_element* ]) be arrayValue_base)

          3. (Let n_size be |value_element*|)

          4. (Let i_idx be $int_of_integerValue(integerValue_index))

          5. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

          6. Case analysis on b_in_bounds

            1. Case true

              1. If ((i_idx has type nat)), then

                1. (Let n_idx be (i_idx as nat))

                2. (Let value_element_update* be value_element*[[n_idx] = value])

                3. (Let arrayValue_base_update be (array [ value_element_update* ]))

                4. (Lvalue_write: p EC_0 ARCH |- storageReference := (arrayValue_base_update as value) : EC_1)

                5. Result in EC_1

              1. Else Phantom#2137

            2. Case false

              1. Result in EC_0

        2. Case (% has type headerStackValue)

          1. (Let headerStackValue_base be (value'' as headerStackValue))

          2. (Let (header_stack [ value_element* ( n_base_idx ) ]) be headerStackValue_base)

          3. (Let n_size be |value_element*|)

          4. (Let i_idx be $int_of_integerValue(integerValue_index))

          5. (Let b_in_bounds be ((i_idx < (n_size as int)) /\ (i_idx >= (0 as int))))

          6. Case analysis on b_in_bounds

            1. Case true

              1. If ((i_idx has type nat)), then

                1. (Let n_idx be (i_idx as nat))

                2. (Let value_element_update* be value_element*[[n_idx] = value])

                3. (Let headerStackValue_base_update be (header_stack [ value_element_update* ( n_base_idx ) ]))

                4. (Lvalue_write: p EC_0 ARCH |- storageReference := (headerStackValue_base_update as value) : EC_1)

                5. Result in EC_1

              1. Else Phantom#2138

            2. Case false

              1. Result in EC_0

      3. Else Phantom#2139

    2. Else Phantom#2140

  3. Case (% matches pattern `% [% % %]`)

    1. (Let (storageReference [ value_hi sliceop value_lo ]) be storageReference'')

    2. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Lvalue_read: p EC_0 ARCH |- storageReference : value_base)

        2. (Let value_base_update be $bitacc_range_replace_op(value_base, value_hi, value_lo, value))

        3. (Lvalue_write: p EC_0 ARCH |- storageReference := value_base_update : EC_1)

        4. Result in EC_1

      2. Case (% matches pattern `+:`)

        1. (Lvalue_read: p EC_0 ARCH |- storageReference : value_base)

        2. (Let value_base_update be $bitacc_offset_replace_op(value_base, value_hi, value_lo, value))

        3. (Lvalue_write: p EC_0 ARCH |- storageReference := value_base_update : EC_1)

        4. Result in EC_1

2. Else Phantom#2141

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:112:1-113:17:
syntax callResult = 
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)
   | return value? (from returnResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:115:25-115:30:
syntax forBreakResult = 
   | break (from forBreakResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:116:28-116:36:
syntax forContinueResult = 
   | continue (from forContinueResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:119:1-120:22:
syntax forResult = 
   | break (from forBreakResult)
   | continue (from forContinueResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:123:1-125:14:
syntax statementResult = 
   |  (from continueEmptyResult)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)
   | return value? (from returnResult)
   | break (from forBreakResult)
   | continue (from forContinueResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:127:1-133:55:
relation Stmt_eval: p', EC', ARCH', statementIR''

1. Case analysis on statementIR''

  1. Case (% has type emptyStatement)

    1. (Let emptyStatement be (statementIR'' as emptyStatement))

    2. If ((emptyStatement matches pattern `;`)), then

      1. Result in EC', ARCH', (() as statementResult)

    2. Else Phantom#2142

  2. Case (% has type assignmentStatementIR)

    1. (Let (typedLvalueIR assignop typedExpressionIR ;) be (statementIR'' as assignmentStatementIR))

    2. (Lvalue_eval: p' EC' ARCH' |- typedLvalueIR : EC_1 ARCH_1 storageReferenceResult)

    3. Case analysis on storageReferenceResult

      1. Case (% has type abortResult)

        1. (Let abortResult be (storageReferenceResult as abortResult))

        2. Result in EC_1, ARCH_1, (abortResult as statementResult)

      2. Case (% has type continueResult<storageReference?>)

        1. (Let (storageReference'?) be (storageReferenceResult as continueResult<storageReference?>))

        2. If ((storageReference'? matches pattern (_))), then

          1. (Let ?(storageReference) be storageReference'?)

          2. Case analysis on (assignop matches pattern `=`)

            1. Case true

              1. (Expr_eval: p' EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

              2. Case analysis on expressionResult

                1. Case (% has type abortResult)

                  1. (Let abortResult be (expressionResult as abortResult))

                  2. Result in EC_2, ARCH_2, (abortResult as statementResult)

                2. Case (% has type continueResult<value>)

                  1. (Let (value) be (expressionResult as continueResult<value>))

                  2. (Lvalue_write: p' EC_2 ARCH_2 |- storageReference := value : EC_3)

                  3. Result in EC_3, ARCH_2, (() as statementResult)

            2. Case false

              1. (Expr_eval: p' EC_1 ARCH_1 |- typedExpressionIR : EC_2 ARCH_2 expressionResult)

              2. Case analysis on expressionResult

                1. Case (% has type abortResult)

                  1. (Let abortResult be (expressionResult as abortResult))

                  2. Result in EC_2, ARCH_2, (abortResult as statementResult)

                2. Case (% has type continueResult<value>)

                  1. (Let (value) be (expressionResult as continueResult<value>))

                  2. (Lvalue_read: p' EC_2 ARCH_2 |- storageReference : value_lvalue)

                  3. (Let binop'? be $assignop_as_binop(assignop))

                  4. If ((binop'? matches pattern (_))), then

                    1. (Let ?(binop) be binop'?)

                    2. (Let value_new be $bin_op(binop, value_lvalue, value))

                    3. (Lvalue_write: p' EC_2 ARCH_2 |- storageReference := value_new : EC_3)

                    4. Result in EC_3, ARCH_2, (() as statementResult)

                  4. Else Phantom#2143

        2. Else Phantom#2144

  3. Case (% has type callStatementIR)

    1. (Let (callableTargetIR < typeArgumentIR* > ( argumentIR* ) ;) be (statementIR'' as callStatementIR))

    2. (Callee_eval: p' EC' ARCH' |- callableTargetIR < _ > ( argumentIR* ) : EC_1 ARCH_1 calleeResult)

    3. Case analysis on calleeResult

      1. Case (% has type abortResult)

        1. (Let abortResult be (calleeResult as abortResult))

        2. Result in EC_1, ARCH_1, (abortResult as statementResult)

      2. Case (% has type continueResult<callee>)

        1. (Let (callee) be (calleeResult as continueResult<callee>))

        2. (Call_eval: p' EC_1 ARCH_1 |- callee @ < typeArgumentIR* > ( argumentIR* ) : EC_2 ARCH_2 callResult)

        3. Case analysis on callResult

          1. Case (% has type abortResult)

            1. (Let abortResult be (callResult as abortResult))

            2. Result in EC_2, ARCH_2, (abortResult as statementResult)

          2. Case (% has type returnResult)

            1. (Let returnResult be (callResult as returnResult))

            2. Result in EC_2, ARCH_2, (() as statementResult)

  4. Case (% has type exitStatement)

    1. (Let exitStatement be (statementIR'' as exitStatement))

    2. If ((exitStatement matches pattern `EXIT ;`)), then

      1. Result in EC', ARCH', ((exit) as statementResult)

    2. Else Phantom#2145

  5. Case (% has type blockStatementIR)

    1. (Let blockStatementIR be (statementIR'' as blockStatementIR))

    2. (Let EC_1 be $enter_e(EC'))

    3. (Block_eval: EC_1 ARCH' |- blockStatementIR : EC_2 ARCH_1 statementResult)

    4. (Let EC_3 be $exit_e(EC_2))

    5. Result in EC_3, ARCH_1, statementResult

  6. Case (% has type conditionalStatementIR)

    1. (Let conditionalStatementIR be (statementIR'' as conditionalStatementIR))

    2. Case analysis on conditionalStatementIR

      1. Case (% matches pattern `IF (%) %`)

        1. (Let (if ( typedExpressionIR_cond ) statementIR_then) be conditionalStatementIR)

        2. (Expr_eval: p' EC' ARCH' |- typedExpressionIR_cond : EC_cond ARCH_cond expressionResult)

        3. If ((expressionResult has type abortResult)), then

          1. (Let abortResult be (expressionResult as abortResult))

          2. Result in EC_cond, ARCH_cond, (abortResult as statementResult)

        3. Else Phantom#2146

        4. If ((expressionResult = ((((true) as value)) as expressionResult))), then

          1. (Stmt_eval: p' EC_cond ARCH_cond |- statementIR_then : EC_then ARCH_then statementResult)

          2. Result in EC_then, ARCH_then, statementResult

        4. Else Phantom#2147

        5. If ((expressionResult = ((((false) as value)) as expressionResult))), then

          1. Result in EC_cond, ARCH_cond, (() as statementResult)

        5. Else Phantom#2148

      2. Case (% matches pattern `IF (%) % ELSE %`)

        1. (Let (if ( typedExpressionIR_cond ) statementIR_then else statementIR_else) be conditionalStatementIR)

        2. (Expr_eval: p' EC' ARCH' |- typedExpressionIR_cond : EC_cond ARCH_cond expressionResult)

        3. If ((expressionResult has type abortResult)), then

          1. (Let abortResult be (expressionResult as abortResult))

          2. Result in EC_cond, ARCH_cond, (abortResult as statementResult)

        3. Else Phantom#2149

        4. If ((expressionResult = ((((true) as value)) as expressionResult))), then

          1. (Stmt_eval: p' EC_cond ARCH_cond |- statementIR_then : EC_then ARCH_then statementResult)

          2. Result in EC_then, ARCH_then, statementResult

        4. Else Phantom#2150

        5. If ((expressionResult = ((((false) as value)) as expressionResult))), then

          1. (Stmt_eval: p' EC_cond ARCH_cond |- statementIR_else : EC_else ARCH_else statementResult)

          2. Result in EC_else, ARCH_else, statementResult

        5. Else Phantom#2151

1. Else Phantom#2152

2. If ((p' matches pattern `LOCAL`)), then

  1. Case analysis on statementIR''

    1. Case (% has type returnStatementIR)

      1. (Let returnStatementIR be (statementIR'' as returnStatementIR))

      2. Case analysis on returnStatementIR

        1. Case (% matches pattern `RETURN ;`)

          1. Result in EC', ARCH', ((return ?()) as statementResult)

        2. Case (% matches pattern `RETURN % ;`)

          1. (Let (return typedExpressionIR ;) be returnStatementIR)

          2. (Expr_eval: (local) EC' ARCH' |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

          3. Case analysis on expressionResult

            1. Case (% has type abortResult)

              1. (Let abortResult be (expressionResult as abortResult))

              2. Result in EC_1, ARCH_1, (abortResult as statementResult)

            2. Case (% has type continueResult<value>)

              1. (Let (value) be (expressionResult as continueResult<value>))

              2. Result in EC_1, ARCH_1, ((return ?(value)) as statementResult)

    2. Case (% has type forStatementIR)

      1. (Let forStatementIR be (statementIR'' as forStatementIR))

      2. Case analysis on forStatementIR

        1. Case (% matches pattern `% FOR (% ; % ; %) %`)

          1. (Let (annotationList for ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR) be forStatementIR)

          2. (Let EC_1 be $enter_e(EC'))

          3. (ForInitStmts_eval: EC_1 ARCH' |- forInitStatementListIR : EC_2 ARCH_1 statementResult)

          4. If ((statementResult has type abortResult)), then

            1. (Let abortResult be (statementResult as abortResult))

            2. (Let EC_3 be $exit_e(EC_2))

            3. Result in EC_3, ARCH_1, (abortResult as statementResult)

          4. Else Phantom#2153

          5. (ForInitStmts_eval: EC_1 ARCH' |- forInitStatementListIR : EC_2 ARCH_1 statementResult')

          6. If ((statementResult' has type continueEmptyResult)), then

            1. (Let continueEmptyResult be (statementResult' as continueEmptyResult))

            2. If ((continueEmptyResult matches pattern `_EMPTY`)), then

              1. (ForThreeClauseStmt_eval: EC_2 ARCH_1 |- typedExpressionIR statementIR forUpdateStatementListIR : EC_3 ARCH_2 statementResult)

              2. (Let EC_4 be $exit_e(EC_3))

              3. Result in EC_4, ARCH_2, statementResult

            2. Else Phantom#2154

          6. Else Phantom#2155

        2. Case (% matches pattern `% FOR (% % IN %) %`)

          1. (Let (annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR) be forStatementIR)

          2. (Let EC_1 be $enter_e(EC'))

          3. (ForCollectionExpr_eval: EC_1 ARCH' |- forCollectionExpressionIR : EC_2 ARCH_1 expressionListResult)

          4. Case analysis on expressionListResult

            1. Case (% has type abortResult)

              1. (Let abortResult be (expressionListResult as abortResult))

              2. (Let EC_3 be $exit_e(EC_2))

              3. Result in EC_3, ARCH_1, (abortResult as statementResult)

            2. Case (% has type continueResult<value*>)

              1. (Let (value*) be (expressionListResult as continueResult<value*>))

              2. (Let typeIR_subst be $subst_type_e((local), EC', typeIR))

              3. (Let value_init be $default(typeIR_subst))

              4. (Let EC_3 be $add_var_e((local), EC_2, (nameIR), value_init))

              5. (ForInStmt_eval: EC_3 ARCH_1 |- nameIR value* statementIR : EC_4 ARCH_2 statementResult)

              6. (Let EC_5 be $exit_e(EC_4))

              7. Result in EC_5, ARCH_2, statementResult

        3. Case (% matches pattern `% FOR (% % % IN %) %`)

          1. (Let (annotationList for ( annotationList_in typeIR nameIR in forCollectionExpressionIR ) statementIR) be forStatementIR)

          2. (Stmt_eval: (local) EC' ARCH' |- ((annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR) as statementIR) : EC_1 ARCH_1 statementResult)

          3. Result in EC_1, ARCH_1, statementResult

    3. Case (% has type breakStatement)

      1. (Let breakStatement be (statementIR'' as breakStatement))

      2. If ((breakStatement matches pattern `BREAK ;`)), then

        1. Result in EC', ARCH', ((break) as statementResult)

      2. Else Phantom#2156

    4. Case (% has type continueStatement)

      1. (Let continueStatement be (statementIR'' as continueStatement))

      2. If ((continueStatement matches pattern `CONTINUE ;`)), then

        1. Result in EC', ARCH', ((continue) as statementResult)

      2. Else Phantom#2157

    5. Case (% has type switchStatementIR)

      1. (Let (switch ( typedExpressionIR ) { switchCaseIR* }) be (statementIR'' as switchStatementIR))

      2. (Expr_eval: (local) EC' ARCH' |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

      3. Case analysis on expressionResult

        1. Case (% has type abortResult)

          1. (Let abortResult be (expressionResult as abortResult))

          2. Result in EC_1, ARCH_1, (abortResult as statementResult)

        2. Case (% has type continueResult<value>)

          1. (Let (value) be (expressionResult as continueResult<value>))

          2. Case analysis on (value has type tableMetadataEnumValue)

            1. Case true

              1. (Let (table_enum _typeId . id_enum) be (value as tableMetadataEnumValue))

              2. (Switch_table_eval: EC_1 ARCH_1 |- switch ( id_enum ) { switchCaseIR* } : EC_2 ARCH_2 statementResult)

              3. Result in EC_2, ARCH_2, statementResult

            2. Case false

              1. (Switch_general_eval: EC_1 ARCH_1 |- switch ( value ) { switchCaseIR* } : EC_2 ARCH_2 statementResult)

              2. Result in EC_2, ARCH_2, statementResult

  1. Else Phantom#2158

2. Else Phantom#2159

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:135:1-142:42:
relation BlockElementStmt_eval: EC_0, ARCH', blockElementStatementIR

1. Case analysis on blockElementStatementIR

  1. Case (% has type constantDeclarationIR)

    1. (Let constantDeclarationIR be (blockElementStatementIR as constantDeclarationIR))

    2. (ConstDecl_eval: (local) EC_0 |- constantDeclarationIR : EC_1)

    3. Result in EC_1, ARCH', (() as statementResult)

  2. Case (% has type variableDeclarationIR)

    1. (Let variableDeclarationIR be (blockElementStatementIR as variableDeclarationIR))

    2. (VarDecl_eval: (local) EC_0 ARCH' |- variableDeclarationIR : EC_1 ARCH_1 declarationResult)

    3. Result in EC_1, ARCH_1, (declarationResult as statementResult)

  3. Case (% has type statementIR)

    1. (Let statementIR be (blockElementStatementIR as statementIR))

