          2. (Lvalue_ok: p' TC' |- lvalue : typedLvalueIR)

          3. (Let expression_lvalue be $lvalue_as_expression(lvalue))

          4. (Let expression_binary be ((expression_lvalue binop expression) as expression))

          5. (Expr_ok: p' TC' |- expression_binary : typedExpressionIR_binary)

          6. (Let (_lvalueIR # (( typeIR_lvalue ))) be typedLvalueIR)

          7. (Let typedExpressionIR? be $cast_unary(typedExpressionIR_binary, typeIR_lvalue))

          8. If ((typedExpressionIR? matches pattern (_))), then

            1. (Let ?((expressionIR # _expressionNoteIR)) be typedExpressionIR?)

            2. If ((expressionIR has type binaryExpressionIR)), then

              1. (Let (_typedExpressionIR binop'' typedExpressionIR_cast) be (expressionIR as binaryExpressionIR))

              2. If ((binop'' = binop)), then

