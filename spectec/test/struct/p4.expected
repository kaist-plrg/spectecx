        3. Case analysis on tableKeysResult

          1. Case (% has type exitResult)

            1. (Let exitResult be (tableKeysResult as exitResult))

            2. If ((exitResult matches pattern `EXIT`)), then

              1. Result in EC_2, ARCH_2, ((exit) as tableKeysResult)

            2. Else Phantom#2431

          2. Case (% has type continueResult<tableKeyValue*>)

            1. (Let (tableKeyValue_t*) be (tableKeysResult as continueResult<tableKeyValue*>))

            2. (Let tableKeyValue* be tableKeyValue_h :: tableKeyValue_t*)

            3. Result in EC_2, ARCH_2, ((tableKeyValue*) as tableKeysResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.09.1-eval-control-table.spectec:82:1-83:38:
dec $get_tableEntryPriority(tableEntryPriorityIR?)

1. Case analysis on tableEntryPriorityIR?

  1. Case (% matches pattern ())

    1. Return ?()

  2. Case (% matches pattern (_))

    1. (Let ?((priority = integerLiteral :)) be tableEntryPriorityIR?)

    2. (Let nat? be $nat_of_integerValue((integerLiteral as integerValue)))

    3. If ((nat? matches pattern (_))), then

      1. (Let ?(n) be nat?)

      2. Return ?(n)

    3. Else Phantom#2432

;; ../../../../../spectec/specs/p4/8-dynamic/8.09.1-eval-control-table.spectec:88:21-88:52:
syntax tableMatch = 
   | nat? : tableActionReferenceIR (from tableMatch)

;; ../../../../../spectec/specs/p4/8-dynamic/8.09.1-eval-control-table.spectec:91:1-92:15:
