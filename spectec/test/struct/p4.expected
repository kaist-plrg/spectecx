;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:5:1-7:43:
dec $match_keysets(setValue''*, value'*)

1. Case analysis on setValue''*

  1. Case (% matches pattern [])

    1. If ((value'* matches pattern [])), then

      1. Return true

    1. Else Phantom#2358

  2. Case (% matches pattern [ _/1 ])

    1. (Let [setValue] be setValue''*)

    2. If ((value'* matches pattern [ _/1 ])), then

      1. (Let [value_key] be value'*)

      2. If (~(setValue matches pattern `SET {...}`)), then

        1. Return $match_keyset(setValue, value_key)

      2. Else Phantom#2359

    2. Else Phantom#2360

1. Else Phantom#2361

2. If ((setValue''* = [(set { ... })])), then

  1. Return true

2. Else Phantom#2362

3. If ((setValue''* matches pattern _ :: _)), then

  1. (Let setValue_h :: setValue_t* be setValue''*)

  2. If ((value'* matches pattern _ :: _)), then

    1. (Let value_key_h :: value_key_t* be value'*)

    2. If ((setValue_t* =/= [])), then

      1. If ((value_key_t* =/= [])), then

        1. Case analysis on $match_keyset(setValue_h, value_key_h)

          1. Case true

            1. Return $match_keysets(setValue_t*, value_key_t*)

          2. Case false

            1. Return false

      1. Else Phantom#2363

    2. Else Phantom#2364

  2. Else Phantom#2365

3. Else Phantom#2366

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:8:1-8:42:
dec $match_keyset(setValue, value_key)

1. Case analysis on setValue

  1. Case (% matches pattern `SET {...}`)

    1. Return true

  2. Case (% matches pattern `SET {%}`)

    1. (Let (set { value }) be setValue)

    2. Return $bin_eq(value, value_key)

  3. Case (% matches pattern `SET {% (%)}`)

    1. (Let (set { value* ( _nat ) }) be setValue)

    2. Return $exists_($bin_eq(value, value_key)*)

  4. Case (% matches pattern `SET {% &&& %}`)

    1. (Let (set { value_base &&& value_mask }) be setValue)

    2. Return $bin_eq($bin_band(value_base, value_mask), $bin_band(value_key, value_mask))

  5. Case (% matches pattern `SET {% .. %}`)

    1. (Let (set { value_base .. value_limit }) be setValue)

    2. Return ($bin_le(value_base, value_key) /\ $bin_le(value_key, value_limit))

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:44:1-45:16:
syntax simpleKeysetExpressionResult = 
   | setValue (from continueResult<setValue>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:47:1-52:62:
relation Eval_keyset_simple: EC_0', ARCH_0', simpleKeysetExpressionIR

1. If ((simpleKeysetExpressionIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (simpleKeysetExpressionIR as typedExpressionIR))

  2. (Expr_eval: (local) EC_0' ARCH_0' |- typedExpressionIR : EC_1 ARCH_1 expressionResult)

  3. Case analysis on expressionResult

    1. Case (% has type abortResult)

      1. (Let abortResult be (expressionResult as abortResult))

      2. Result in EC_1, ARCH_1, (abortResult as simpleKeysetExpressionResult)

    2. Case (% has type continueResult<value>)

      1. (Let (value) be (expressionResult as continueResult<value>))

      2. Case analysis on value

        1. Case (% has type setValue)

          1. (Let setValue be (value as setValue))

          2. Result in EC_1, ARCH_1, ((setValue) as simpleKeysetExpressionResult)

        2. Case (% has type objectReferenceValue)

          1. (Let (ref objectId) be (value as objectReferenceValue))

          2. (Let object'? be $find_object_e(ARCH_1, objectId))

          3. If ((object'? matches pattern (_))), then

            1. (Let ?(object) be object'?)

            2. If ((object has type valueSetObject)), then

              1. (Let (value_set { value* ( n_size ) }) be (object as valueSetObject))

              2. (Let setValue be (set { value* ( n_size ) }))

              3. Result in EC_1, ARCH_1, ((setValue) as simpleKeysetExpressionResult)

            2. Else Phantom#2367

          3. Else Phantom#2368

      2. Else Phantom#2369

1. Else Phantom#2370

2. Case analysis on simpleKeysetExpressionIR

  1. Case (% matches pattern `% &&& %`)

    1. (Let (typedExpressionIR_l &&& typedExpressionIR_r) be simpleKeysetExpressionIR)

    2. (Expr_eval: (local) EC_0' ARCH_0' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult)

    3. Case analysis on expressionResult

      1. Case (% has type abortResult)

        1. (Let abortResult be (expressionResult as abortResult))

        2. Result in EC_1, ARCH_1, (abortResult as simpleKeysetExpressionResult)

      2. Case (% has type continueResult<value>)

        1. (Let (value_l) be (expressionResult as continueResult<value>))

        2. (Expr_eval: (local) EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult')

        3. Case analysis on expressionResult'

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionResult' as abortResult))

            2. Result in EC_2, ARCH_2, (abortResult as simpleKeysetExpressionResult)

          2. Case (% has type continueResult<value>)

            1. (Let (value_r) be (expressionResult' as continueResult<value>))

            2. (Let setValue be (set { value_l &&& value_r }))

            3. Result in EC_2, ARCH_2, ((setValue) as simpleKeysetExpressionResult)

  2. Case (% matches pattern `% .. %`)

    1. (Let (typedExpressionIR_l .. typedExpressionIR_r) be simpleKeysetExpressionIR)

    2. (Expr_eval: (local) EC_0' ARCH_0' |- typedExpressionIR_l : EC_1 ARCH_1 expressionResult)

    3. Case analysis on expressionResult

      1. Case (% has type abortResult)

        1. (Let abortResult be (expressionResult as abortResult))

        2. Result in EC_1, ARCH_1, (abortResult as simpleKeysetExpressionResult)

      2. Case (% has type continueResult<value>)

        1. (Let (value_l) be (expressionResult as continueResult<value>))

        2. (Expr_eval: (local) EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult')

        3. Case analysis on expressionResult'

          1. Case (% has type abortResult)

            1. (Let abortResult be (expressionResult' as abortResult))

            2. Result in EC_2, ARCH_2, (abortResult as simpleKeysetExpressionResult)

          2. Case (% has type continueResult<value>)

            1. (Let (value_r) be (expressionResult' as continueResult<value>))

            2. (Let setValue be (set { value_l .. value_r }))

            3. Result in EC_2, ARCH_2, ((setValue) as simpleKeysetExpressionResult)

2. Else Phantom#2371

3. If (((simpleKeysetExpressionIR = (default)) \/ (simpleKeysetExpressionIR = (_)))), then

  1. (Let setValue be (set { ... }))

  2. Result in EC_0', ARCH_0', ((setValue) as simpleKeysetExpressionResult)

3. Else Phantom#2372

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:157:1-160:23:
relation Eval_keysets_simple: EC', ARCH', simpleKeysetExpressionIR*

1. Case analysis on simpleKeysetExpressionIR*

  1. Case (% matches pattern [])

    1. Result in EC', ARCH', (([]) as keysetExpressionResult)

  2. Case (% matches pattern _ :: _)

    1. (Let simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t* be simpleKeysetExpressionIR*)

    2. (Eval_keyset_simple: EC' ARCH' |- simpleKeysetExpressionIR_h : EC_1 ARCH_1 simpleKeysetExpressionResult)

