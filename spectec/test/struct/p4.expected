    1. (Let (_annotationList abstract (_typeOrVoid name _typeParameterListOpt ( parameterList )) ;) be externMethodPrototype)

    2. Return $callableId(name, parameterList)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:198:1-200:51:
dec $type_of_externMethodPrototypeIR(externMethodPrototypeIR)

1. Case analysis on externMethodPrototypeIR

  1. Case (% matches pattern `% % ;`)

    1. (Let (_annotationList (typeIR_ret nameIR < typeParameterListIR_expl , typeParameterListIR_impl > ( parameterIR* )) ;) be externMethodPrototypeIR)

    2. (Let externMethodTypeDefIR be (extern_method nameIR < typeParameterListIR_expl , typeParameterListIR_impl > ( parameterIR* ) : typeIR_ret))

    3. Return externMethodTypeDefIR

  2. Case (% matches pattern `% ABSTRACT % ;`)

    1. (Let (_annotationList abstract (typeIR_ret nameIR < typeParameterListIR_expl , typeParameterListIR_impl > ( parameterIR* )) ;) be externMethodPrototypeIR)

    2. (Let externMethodTypeDefIR be (extern_method abstract nameIR < typeParameterListIR_expl , typeParameterListIR_impl > ( parameterIR* ) : typeIR_ret))

    3. Return externMethodTypeDefIR

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:221:1-224:41:
dec $constructorId_of_externConstructorPrototype((_annotationList typeIdentifier ( parameterList ) ;))

1. Return $callableId((typeIdentifier as name), parameterList)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:230:1-235:21:
relation ExternMethod_ok: TC_0, typeId_extern, externMethodPrototype

1. Case analysis on externMethodPrototype

  1. Case (% matches pattern `% % ;`)

    1. (Let (annotationList functionPrototype ;) be externMethodPrototype)

    2. (Let (typeOrVoid name typeParameterListOpt ( parameterList )) be functionPrototype)

    3. (Let nameIR be $name(name))

    4. If ((nameIR =/= typeId_extern)), then

      1. (TypeParameterListOpt_ok: (local) TC_0 |- typeParameterListOpt : TC_1 typeId_expl*)

      2. (Type_ok: (local) TC_1 |- typeOrVoid : typeIR_ret # typeId*)

      3. If ((typeId* matches pattern [])), then

        1. (Let TC_2 be TC_1[local.kind = ((extern_method : typeIR_ret) as localKind)])

        2. (ParameterList_ok: (local) TC_2 |- parameterList : TC_3 parameterIR* # typeId_impl*)

        3. (Let externMethodTypeDefIR be (extern_method nameIR < typeId_expl* , typeId_impl* > ( parameterIR* ) : typeIR_ret))

        4. If (CallableTypeDef_wf: $bound((block), TC_0) |- (externMethodTypeDefIR as callableTypeDefIR) holds), then

          1. (Let externMethodPrototypeIR be (annotationList (typeIR_ret nameIR < typeId_expl* , typeId_impl* > ( parameterIR* )) ;))

          2. Result in externMethodPrototypeIR

        4. Else Phantom#1429

      3. Else Phantom#1430

    4. Else Phantom#1431

  2. Case (% matches pattern `% ABSTRACT % ;`)

    1. (Let (annotationList abstract functionPrototype ;) be externMethodPrototype)

    2. (Let (typeOrVoid name typeParameterListOpt ( parameterList )) be functionPrototype)

    3. (Let nameIR be $name(name))

    4. If ((nameIR =/= typeId_extern)), then

      1. (TypeParameterListOpt_ok: (local) TC_0 |- typeParameterListOpt : TC_1 typeId_expl*)

      2. (Type_ok: (local) TC_1 |- typeOrVoid : typeIR_ret # typeId*)

      3. If ((typeId* matches pattern [])), then

        1. (Let TC_2 be TC_1[local.kind = ((extern_method abstract : typeIR_ret) as localKind)])

        2. (ParameterList_ok: (local) TC_2 |- parameterList : TC_3 parameterIR* # typeId_impl*)

        3. (Let externMethodTypeDefIR be (extern_method abstract nameIR < typeId_expl* , typeId_impl* > ( parameterIR* ) : typeIR_ret))

        4. If (CallableTypeDef_wf: $bound((block), TC_0) |- (externMethodTypeDefIR as callableTypeDefIR) holds), then

          1. (Let externMethodPrototypeIR be (annotationList abstract (typeIR_ret nameIR < typeId_expl* , typeId_impl* > ( parameterIR* )) ;))

          2. Result in externMethodPrototypeIR

        4. Else Phantom#1432

      3. Else Phantom#1433

    4. Else Phantom#1434

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:237:1-242:21:
relation ExternConstructor_ok: TC_0, typeId_extern, (annotationList typeIdentifier ( parameterList ) ;)

1. (Let nameIR be $name((typeIdentifier as name)))

2. If ((nameIR = typeId_extern)), then

  1. (ConstructorParameterListOpt_ok: TC_0 |- (( parameterList )) : TC_1 constructorParameterIR* # typeId_impl*)

  2. (Let typeDefIR'? be $find_typeDef_t((global), TC_0, (typeId_extern)))

  3. If ((typeDefIR'? matches pattern (_))), then

    1. (Let ?(typeDefIR) be typeDefIR'?)

    2. If ((typeDefIR has type externObjectTypeDefIR)), then

      1. (Let externObjectTypeDefIR be (typeDefIR as externObjectTypeDefIR))

      2. (Let (typeId_expl*, typeParameterIR*) be $typeParameterListIR_of_typeDefIR((externObjectTypeDefIR as typeDefIR)))

      3. If ((typeParameterIR* matches pattern [])), then

        1. (Let typeIR_extern be $typeIR_of_typeDefIR((externObjectTypeDefIR as typeDefIR)))

        2. (Let constructorTypeDefIR be (constructor < typeId_expl* , typeId_impl* > ( constructorParameterIR* ) : typeIR_extern))

        3. If (ConstructorTypeDef_wf: $bound((block), TC_0) |- constructorTypeDefIR holds), then

          1. (Let externConstructorPrototypeIR be (annotationList nameIR < , typeId_impl* > ( constructorParameterIR* ) ;))

          2. Result in externConstructorPrototypeIR

        3. Else Phantom#1435

      3. Else Phantom#1436

    2. Else Phantom#1437

  3. Else Phantom#1438

2. Else Phantom#1439

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:248:1-252:50:
relation ParserSelect_ok: TC_0, nameIR_state*, (select ( expressionList_key ) { selectCaseList })

1. (Let expression_key* be $flatten_expressionList(expressionList_key))

2. (Expr_ok: (local) TC_0 |- expression_key : typedExpressionIR_key)*

3. (Let typedExpressionIR_key_reduced be $reduce_serenum(typedExpressionIR_key))*

4. (Let typeIR_key_reduced be $type_of_typedExpressionIR(typedExpressionIR_key_reduced))*

5. If (Type_wf: $bound((local), TC_0) |- ((set < typeIR_key_reduced >) as typeIR) holds)*, then

  1. (Let selectCase* be $flatten_selectCaseList(selectCaseList))

  2. (SelectCase_ok: TC_0 nameIR_state* typeIR_key_reduced* |- selectCase : selectCaseIR)*

  3. (Let selectExpressionIR be (select ( typedExpressionIR_key_reduced* ) { selectCaseIR* }))

  4. Result in selectExpressionIR

5. Else Phantom#1440

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:254:1-258:50:
relation ParserTransition_ok: TC_0, nameIR_state*, transitionStatement

1. Case analysis on transitionStatement

  1. Case (% matches pattern `_EMPTY`)

    1. Result in (transition ("reject" ;))

  2. Case (% matches pattern `TRANSITION %`)

    1. (Let (transition stateExpression) be transitionStatement)

    2. If ((stateExpression matches pattern `% ;`)), then

      1. (Let (name ;) be stateExpression)

      2. (Let nameIR be $name(name))

      3. If (nameIR is in nameIR_state*), then

        1. (Let transitionStatementIR be (transition (nameIR ;)))

        2. Result in transitionStatementIR

      3. Else Phantom#1441

    2. Else Phantom#1442

    3. If ((stateExpression has type selectExpression)), then

      1. (Let selectExpression be (stateExpression as selectExpression))

      2. (ParserSelect_ok: TC_0 nameIR_state* |- selectExpression : selectExpressionIR)

      3. Result in (transition (selectExpressionIR as stateExpressionIR))

    3. Else Phantom#1443

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:260:1-264:63:
relation ParserStmt_ok: TC', parserStatement

1. Case analysis on parserStatement

  1. Case (% has type emptyStatement)

    1. (Let emptyStatement be (parserStatement as emptyStatement))

    2. (Stmt_ok: (local) TC' |- (emptyStatement as statement) : typingContext statementIR)

    3. If ((typingContext = TC')), then

      1. If ((statementIR has type emptyStatementIR)), then

        1. (Let emptyStatementIR be (statementIR as emptyStatementIR))

        2. Result in TC', (emptyStatementIR as parserStatementIR)

      1. Else Phantom#1444

    3. Else Phantom#1445

  2. Case (% has type assignmentStatement)

    1. (Let assignmentStatement be (parserStatement as assignmentStatement))

    2. (Stmt_ok: (local) TC' |- (assignmentStatement as statement) : TC_1 statementIR)

    3. If ((statementIR has type assignmentStatementIR)), then

      1. (Let assignmentStatementIR be (statementIR as assignmentStatementIR))

      2. Result in TC_1, (assignmentStatementIR as parserStatementIR)

    3. Else Phantom#1446

  3. Case (% has type callStatement)

    1. (Let callStatement be (parserStatement as callStatement))

    2. (Stmt_ok: (local) TC' |- (callStatement as statement) : TC_1 statementIR)

    3. If ((statementIR has type callStatementIR)), then

      1. (Let callStatementIR be (statementIR as callStatementIR))

      2. Result in TC_1, (callStatementIR as parserStatementIR)

    3. Else Phantom#1447

  4. Case (% has type directApplicationStatement)

    1. (Let directApplicationStatement be (parserStatement as directApplicationStatement))

    2. (Stmt_ok: (local) TC' |- (directApplicationStatement as statement) : TC_1 statementIR)

    3. If ((statementIR has type directApplicationStatementIR)), then

      1. (Let directApplicationStatementIR be (statementIR as directApplicationStatementIR))

      2. Result in TC_1, (directApplicationStatementIR as parserStatementIR)

    3. Else Phantom#1448

  5. Case (% has type parserBlockStatement)

    1. (Let parserBlockStatement be (parserStatement as parserBlockStatement))

    2. (Let TC_1 be $enter_t(TC'))

    3. (ParserBlock_ok: TC_1 |- parserBlockStatement : TC_2 parserBlockStatementIR)

    4. (Let TC_3 be $exit_t(TC_2))

    5. Result in TC_3, (parserBlockStatementIR as parserStatementIR)

  6. Case (% has type parserConditionalStatement)

    1. (Let parserConditionalStatement be (parserStatement as parserConditionalStatement))

    2. Case analysis on parserConditionalStatement

      1. Case (% matches pattern `IF (%) %`)

        1. (Let (if ( expression_cond ) parserStatement_then) be parserConditionalStatement)

        2. (Expr_ok: (local) TC' |- expression_cond : typedExpressionIR_cond)

        3. (Let typeIR_cond be $type_of_typedExpressionIR(typedExpressionIR_cond))

        4. If ((((bool) as typeIR) = $unroll_typeIR(typeIR_cond))), then

          1. (ParserStmt_ok: TC' |- parserStatement_then : TC_then parserStatementIR_then)

          2. Result in TC', ((if ( typedExpressionIR_cond ) parserStatementIR_then) as parserStatementIR)

        4. Else Phantom#1449

      2. Case (% matches pattern `IF (%) % ELSE %`)

        1. (Let (if ( expression_cond ) parserStatement_then else parserStatement_else) be parserConditionalStatement)

        2. (Expr_ok: (local) TC' |- expression_cond : typedExpressionIR_cond)

        3. (Let typeIR_cond be $type_of_typedExpressionIR(typedExpressionIR_cond))

        4. If ((((bool) as typeIR) = $unroll_typeIR(typeIR_cond))), then

          1. (ParserStmt_ok: TC' |- parserStatement_then : TC_then parserStatementIR_then)

          2. (ParserStmt_ok: TC' |- parserStatement_else : TC_else parserStatementIR_else)

          3. Result in TC', ((if ( typedExpressionIR_cond ) parserStatementIR_then else parserStatementIR_else) as parserStatementIR)

        4. Else Phantom#1450

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:266:1-271:40:
relation ParserBlockElementStmt_ok: TC_0, parserBlockElementStatement

1. Case analysis on parserBlockElementStatement

  1. Case (% has type constantDeclaration)

    1. (Let constantDeclaration be (parserBlockElementStatement as constantDeclaration))

    2. (ConstDecl_ok: (local) TC_0 |- constantDeclaration : TC_1 constantDeclarationIR)

    3. Result in TC_1, (constantDeclarationIR as parserBlockElementStatementIR)

  2. Case (% has type variableDeclaration)

    1. (Let variableDeclaration be (parserBlockElementStatement as variableDeclaration))

    2. (VarDecl_ok: (local) TC_0 |- variableDeclaration : TC_1 variableDeclarationIR)

    3. Result in TC_1, (variableDeclarationIR as parserBlockElementStatementIR)

  3. Case (% has type parserStatement)

    1. (Let parserStatement be (parserBlockElementStatement as parserStatement))

    2. (ParserStmt_ok: TC_0 |- parserStatement : TC_1 parserStatementIR)

    3. Result in TC_1, (parserStatementIR as parserBlockElementStatementIR)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:273:1-278:40:
relation ParserBlockElementStmtList_ok: TC_0, parserBlockElementStatementList

