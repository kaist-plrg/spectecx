;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:13:1-18:21:
relation Expr_eval_lctk: p, TC, (expressionIR # _expressionNoteIR')

1. Case analysis on expressionIR

  1. Case (% has type booleanLiteral)

    1. (Let booleanLiteral be (expressionIR as booleanLiteral))

    2. (Let boolValue be $ite<boolValue>((booleanLiteral = (true)), (true), (false)))

    3. Result in (boolValue as value)

  2. Case (% has type integerLiteral)

    1. (Let integerLiteral be (expressionIR as integerLiteral))

    2. Result in (integerLiteral as value)

  3. Case (% has type stringLiteral)

    1. (Let stringLiteral be (expressionIR as stringLiteral))

    2. Result in (stringLiteral as value)

  4. Case (% has type prefixedNameIR)

    1. (Let prefixedNameIR be (expressionIR as prefixedNameIR))

    2. (Let value be $find_var_value_t(prefixedNameIR, p, TC))

    3. Result in value

  5. Case (% has type defaultExpression)

    1. (Let defaultExpression be (expressionIR as defaultExpression))

    2. If ((defaultExpression matches pattern `...`)), then

      1. Result in ((default) as value)

    2. Else Phantom#1134

  6. Case (% has type unaryExpressionIR)

    1. (Let (unop typedExpressionIR) be (expressionIR as unaryExpressionIR))

    2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

    3. Result in $un_op(unop, value)

  7. Case (% has type binaryExpressionIR)

    1. (Let (typedExpressionIR_l binop typedExpressionIR_r) be (expressionIR as binaryExpressionIR))

    2. If (~binop is in [(&&), (||)]), then

      1. (Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value_l)

      2. (Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r)

      3. Result in $bin_op(binop, value_l, value_r)

    2. Else Phantom#1135

    3. Case analysis on binop

      1. Case (% matches pattern `&&`)

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value)

        2. If ((value = ((false) as value))), then

          1. Result in ((false) as value)

        2. Else Phantom#1136

        3. If ((value = ((true) as value))), then

          1. (Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r)

          2. Result in value_r

        3. Else Phantom#1137

      2. Case (% matches pattern `||`)

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value)

        2. If ((value = ((true) as value))), then

          1. Result in ((true) as value)

        2. Else Phantom#1138

        3. If ((value = ((false) as value))), then

          1. (Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r)

          2. Result in value_r

        3. Else Phantom#1139

    3. Else Phantom#1140

  8. Case (% has type ternaryExpressionIR)

    1. (Let (typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false) be (expressionIR as ternaryExpressionIR))

    2. (Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> value)

    3. If ((value = ((true) as value))), then

      1. (Expr_eval_lctk: p TC |- typedExpressionIR_true ~> value_true)

      2. Result in value_true

    3. Else Phantom#1141

    4. If ((value = ((false) as value))), then

      1. (Expr_eval_lctk: p TC |- typedExpressionIR_false ~> value_false)

      2. Result in value_false

    4. Else Phantom#1142

  9. Case (% has type castExpressionIR)

    1. (Let (( typeIR ) typedExpressionIR) be (expressionIR as castExpressionIR))

    2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

    3. (Let value_cast be $cast_op(typeIR, value))

    4. Result in value_cast

  10. Case (% has type invalidHeaderExpression)

    1. (Let invalidHeaderExpression be (expressionIR as invalidHeaderExpression))

    2. If ((invalidHeaderExpression matches pattern `{#}`)), then

      1. Result in (({#}) as value)

    2. Else Phantom#1143

  11. Case (% has type sequenceExpressionIR)

    1. (Let sequenceExpressionIR be (expressionIR as sequenceExpressionIR))

    2. Case analysis on sequenceExpressionIR

      1. Case (% matches pattern `SEQ {%}`)

        1. (Let (seq { typedExpressionIR* }) be sequenceExpressionIR)

        2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

        3. Result in ((seq ( value* )) as value)

      2. Case (% matches pattern `SEQ {% , ...}`)

        1. (Let (seq { typedExpressionIR* , ... }) be sequenceExpressionIR)

        2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

        3. Result in ((seq ( value* , ... )) as value)

  12. Case (% has type recordExpressionIR)

    1. (Let recordExpressionIR be (expressionIR as recordExpressionIR))

    2. Case analysis on recordExpressionIR

      1. Case (% matches pattern `RECORD {%}`)

        1. (Let (record { (nameIR = typedExpressionIR)* }) be recordExpressionIR)

        2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

        3. Result in ((record { (value nameIR ;)* }) as value)

      2. Case (% matches pattern `RECORD {% , ...}`)

        1. (Let (record { (nameIR = typedExpressionIR)* , ... }) be recordExpressionIR)

        2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

        3. Result in ((record { (value nameIR ;)* , ... }) as value)

1. Else Phantom#1144

2. (Let (( _typeIR _ctk )) be _expressionNoteIR')

3. If ((expressionIR has type errorAccessExpressionIR)), then

  1. (Let (error . nameIR) be (expressionIR as errorAccessExpressionIR))

  2. (Let nameIR_error be "error." ++ nameIR)

  3. (Let value_error be $find_var_value_t((nameIR_error), p, TC))

  4. Result in value_error

3. Else Phantom#1145

4. Case analysis on expressionIR

  1. Case (% has type memberAccessExpressionIR)

    1. (Let (memberAccessBaseIR . nameIR) be (expressionIR as memberAccessExpressionIR))

    2. If ((memberAccessBaseIR matches pattern `TYPE %`)), then

      1. (Let (type prefixedNameIR_base) be memberAccessBaseIR)

      2. (Let typeDefIR? be $find_typeDef_t(p, TC, prefixedNameIR_base))

      3. If ((typeDefIR? matches pattern (_))), then

        1. (Let ?(typeDefIR_base) be typeDefIR?)

        2. If ($is_monomorphic_typeDefIR(typeDefIR_base)), then

          1. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

          2. (Let typeIR be $unroll_typeIR(typeIR_base))

          3. Case analysis on typeIR

            1. Case (% has type simpleEnumTypeIR)

              1. (Let (enum typeId { nameIR_field* }) be (typeIR as simpleEnumTypeIR))

              2. If (nameIR is in nameIR_field*), then

                1. Result in ((typeId . nameIR) as value)

              2. Else Phantom#1146

            2. Case (% has type serializableEnumTypeIR)

              1. (Let (enum typeId < typeIR > { (nameIR_field = value_field ;)* }) be (typeIR as serializableEnumTypeIR))

              2. (Let value'? be $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*))

              3. If ((value'? matches pattern (_))), then

                1. (Let ?(value) be value'?)

                2. Result in ((typeId . nameIR . value) as value)

              3. Else Phantom#1147

          3. Else Phantom#1148

        2. Else Phantom#1149

      3. Else Phantom#1150

    2. Else Phantom#1151

    3. If ((memberAccessBaseIR has type typedExpressionIR)), then

      1. (Let typedExpressionIR_base be (memberAccessBaseIR as typedExpressionIR))

      2. (Let typeIR_base be $type_of_typedExpressionIR(typedExpressionIR_base))

      3. (Let typeIR be $unroll_typeIR(typeIR_base))

      4. If ((typeIR has type headerStackTypeIR)), then

        1. (Let (header_stack _typeIR [ n_size ]) be (typeIR as headerStackTypeIR))

        2. If ((nameIR = "size")), then

          1. Result in ((32 w (n_size as int)) as value)

        2. Else Phantom#1152

      4. Else Phantom#1153

      5. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value')

      6. Case analysis on value'

        1. Case (% has type structValue)

          1. (Let structValue be (value' as structValue))

          2. (Let (struct _typeId { (value_field nameIR_field ;)* }) be structValue)

          3. (Let value''? be $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*))

          4. If ((value''? matches pattern (_))), then

            1. (Let ?(value) be value''?)

            2. Result in value

          4. Else Phantom#1154

        2. Case (% has type headerValue)

          1. (Let headerValue be (value' as headerValue))

          2. (Let (header _typeId { _bool ; (value_field nameIR_field ;)* }) be headerValue)

          3. (Let value''? be $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*))

          4. If ((value''? matches pattern (_))), then

            1. (Let ?(value) be value''?)

            2. Result in value

          4. Else Phantom#1155

        3. Case (% has type headerUnionValue)

          1. (Let headerUnionValue be (value' as headerUnionValue))

          2. (Let (header_union _typeId { (value_field nameIR_field ;)* }) be headerUnionValue)

          3. (Let value''? be $assoc_<nameIR, value>(nameIR, (nameIR_field, value_field)*))

          4. If ((value''? matches pattern (_))), then

            1. (Let ?(value) be value''?)

            2. Result in value

          4. Else Phantom#1156

      6. Else Phantom#1157

    3. Else Phantom#1158

  2. Case (% has type indexAccessExpressionIR)

    1. (Let (typedExpressionIR_base [ typedExpressionIR_index ]) be (expressionIR as indexAccessExpressionIR))

    2. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base)

    3. (Expr_eval_lctk: p TC |- typedExpressionIR_index ~> value')

    4. If ((value' has type integerValue)), then

      1. (Let integerValue_index be (value' as integerValue))

      2. Case analysis on value_base

        1. Case (% has type tupleValue)

          1. (Let (tuple ( value_e* )) be (value_base as tupleValue))

          2. (Let nat? be $nat_of_integerValue(integerValue_index))

          3. If ((nat? matches pattern (_))), then

            1. (Let ?(n_index) be nat?)

            2. If ((n_index < |value_e*|)), then

              1. (Let value be value_e*[n_index])

              2. Result in value

            2. Else Phantom#1159

          3. Else Phantom#1160

        2. Case (% has type arrayValue)

          1. (Let (array [ value_e* ]) be (value_base as arrayValue))

          2. (Let nat? be $nat_of_integerValue(integerValue_index))

          3. If ((nat? matches pattern (_))), then

            1. (Let ?(n_index) be nat?)

            2. If ((n_index < |value_e*|)), then

              1. (Let value be value_e*[n_index])

              2. Result in value

            2. Else Phantom#1161

          3. Else Phantom#1162

        3. Case (% has type headerStackValue)

          1. (Let (header_stack [ value_e* ( _nat ) ]) be (value_base as headerStackValue))

          2. (Let nat? be $nat_of_integerValue(integerValue_index))

          3. If ((nat? matches pattern (_))), then

            1. (Let ?(n_index) be nat?)

            2. If ((n_index < |value_e*|)), then

              1. (Let value be value_e*[n_index])

              2. Result in value

            2. Else Phantom#1163

          3. Else Phantom#1164

      2. Else Phantom#1165

    4. Else Phantom#1166

  3. Case (% has type sliceAccessExpressionIR)

    1. (Let (typedExpressionIR_base [ typedExpressionIR_hi sliceop typedExpressionIR_lo ]) be (expressionIR as sliceAccessExpressionIR))

    2. Case analysis on sliceop

      1. Case (% matches pattern `:`)

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base)

        2. (Expr_eval_lctk: p TC |- typedExpressionIR_hi ~> value_hi)

        3. (Expr_eval_lctk: p TC |- typedExpressionIR_lo ~> value_lo)

        4. Result in $bitacc_range_op(value_base, value_hi, value_lo)

      2. Case (% matches pattern `+:`)

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_base ~> value_base)

        2. (Expr_eval_lctk: p TC |- typedExpressionIR_hi ~> value_l)

        3. (Expr_eval_lctk: p TC |- typedExpressionIR_lo ~> value_w)

        4. Result in $bitacc_offset_op(value_base, value_l, value_w)

  4. Case (% has type callExpressionIR)

    1. (Let callExpressionIR be (expressionIR as callExpressionIR))

    2. If ((callExpressionIR matches pattern `% <%> (%)`)), then

      1. (Let (callableTargetIR < typeArgumentIR* > ( argumentIR* )) be callExpressionIR)

      2. If ((callableTargetIR has type prefixedNameIR)), then

        1. (Let prefixedNameIR be (callableTargetIR as prefixedNameIR))

        2. (CallableType_ok: p TC |- (prefixedNameIR as callableTargetIR) < typeArgumentIR* > ( argumentIR* ) : callableTypeIR < # _typeId* > ( # id_default* # id_optional* ))

        3. If ((callableTypeIR has type externFunctionTypeIR)), then

          1. (Let externFunctionTypeIR be (callableTypeIR as externFunctionTypeIR))

          2. (Let (extern_function text ( parameterIR* ) : typeIR) be externFunctionTypeIR)

          3. If ((text = "static_assert")), then

            1. If ((typeIR has type boolTypeIR)), then

              1. (Let boolTypeIR be (typeIR as boolTypeIR))

              2. If ((boolTypeIR matches pattern `BOOL`)), then

                1. (Let (_annotationList _direction _typeIR nameIR_param _parameterInitializerOptIR) be parameterIR)*

                2. (Let TC_callee_0 be $empty_typingContext)

                3. (Let (given parameterIR_aligned* default parameterIR'* optional _parameterIR*) be $align_parameterListIR(parameterIR*, argumentIR*, id_default*, id_optional*))

                4. If ((parameterIR'* matches pattern [])), then

                  1. (Argument_eval_lctk: p TC |- argumentIR ~> value_argument)*

                  2. (Let (_annotationList' direction_param_aligned typeIR_param_aligned nameIR_param_aligned _parameterInitializerOptIR') be parameterIR_aligned)*

                  3. (Let varTypeIR be (direction_param_aligned typeIR_param_aligned (lctk) ?(value_argument)))*

                  4. (Let TC_callee_1 be $add_vars_t((local), TC_callee_0, nameIR_param_aligned*, varTypeIR*))

                  5. (ExternFunctionCall_eval_lctk: TC_callee_1 |- "static_assert" ( nameIR_param* ) ~> value)

                  6. If ((value has type boolValue)), then

                    1. (Let boolValue be (value as boolValue))

                    2. If (((true) = boolValue)), then

                      1. Result in (boolValue as value)

                    2. Else Phantom#1167

                  6. Else Phantom#1168

                4. Else Phantom#1169

              2. Else Phantom#1170

            1. Else Phantom#1171

          3. Else Phantom#1172

        3. Else Phantom#1173

      2. Else Phantom#1174

      3. (Let (callableTargetIR < _typeArgumentListIR > ( _argumentListIR )) be callExpressionIR)

      4. Case analysis on callableTargetIR

        1. Case (% matches pattern `% . %`)

          1. (Let (typedExpressionIR_base . nameIR) be callableTargetIR)

          2. (Let (_expressionIR # (( typeIR_base _ctk ))) be typedExpressionIR_base)

          3. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

            1. Result in $sizeof(typeIR_base, nameIR)

          3. Else Phantom#1175

        2. Case (% matches pattern `TYPE % . %`)

          1. (Let (type prefixedNameIR . nameIR) be callableTargetIR)

          2. (Let typeDefIR? be $find_typeDef_t(p, TC, prefixedNameIR))

          3. If ((typeDefIR? matches pattern (_))), then

            1. (Let ?(typeDefIR_base) be typeDefIR?)

            2. Case analysis on $is_monomorphic_typeDefIR(typeDefIR_base)

              1. Case true

                1. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

                2. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

                  1. Result in $sizeof(typeIR_base, nameIR)

                2. Else Phantom#1176

              2. Case false

                1. If ((([], []) = $typeParameterListIR_of_typeDefIR(typeDefIR_base))), then

                  1. (Let typeIR_base be $typeIR_of_typeDefIR(typeDefIR_base))

                  2. If (nameIR is in ["minSizeInBits", "minSizeInBytes", "maxSizeInBits", "maxSizeInBytes"]), then

                    1. Result in $sizeof(typeIR_base, nameIR)

                  2. Else Phantom#1177

                1. Else Phantom#1178

          3. Else Phantom#1179

      4. Else Phantom#1180

    2. Else Phantom#1181

4. Else Phantom#1182

5. (Let (( typeIR ctk )) be _expressionNoteIR')

6. If ((expressionIR has type callExpressionIR)), then

  1. (Let callExpressionIR be (expressionIR as callExpressionIR))

  2. If ((callExpressionIR matches pattern `% <%> (%)`)), then

    1. (Let (callableTargetIR' < typeArgumentIR* > ( argumentIR* )) be callExpressionIR)

    2. If ((callableTargetIR' matches pattern `(%)`)), then

      1. (Let (( callableTargetIR )) be callableTargetIR')

      2. (Expr_eval_lctk: p TC |- (((callableTargetIR < typeArgumentIR* > ( argumentIR* )) as expressionIR) # (( typeIR ctk ))) ~> value)

      3. Result in value

    2. Else Phantom#1183

  2. Else Phantom#1184

6. Else Phantom#1185

7. If ((expressionIR has type parenthesizedExpressionIR)), then

  1. (Let (( typedExpressionIR )) be (expressionIR as parenthesizedExpressionIR))

  2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

  3. Result in value

7. Else Phantom#1186

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:20:1-25:21:
relation Argument_eval_lctk: p, TC, argumentIR

1. If ((argumentIR has type typedExpressionIR)), then

  1. (Let typedExpressionIR be (argumentIR as typedExpressionIR))

  2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

  3. Result in value

1. Else Phantom#1187

2. If ((argumentIR matches pattern `% = %`)), then

  1. (Let (nameIR = typedExpressionIR) be argumentIR)

  2. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

  3. Result in value

2. Else Phantom#1188

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:32:1-36:51:
relation Type_ok: p, TC, typeOrVoid

1. If ((typeOrVoid matches pattern `VOID`)), then

  1. Result in ((void) as typeIR), []

1. Else Phantom#1189

2. Case analysis on typeOrVoid

  1. Case (% has type baseType)

    1. (Let baseType be (typeOrVoid as baseType))

    2. Case analysis on baseType

      1. Case (% matches pattern `BOOL`)

        1. Result in ((bool) as typeIR), []

      2. Case (% matches pattern `ERROR`)

        1. Result in ((error) as typeIR), []

      3. Case (% matches pattern `MATCH_KIND`)

        1. Result in ((match_kind) as typeIR), []

      4. Case (% matches pattern `STRING`)

        1. Result in ((string) as typeIR), []

      5. Case (% matches pattern `INT`)

        1. Result in ((int) as typeIR), []

      6. Case (% matches pattern `INT <%>`)

        1. (Let (int < int >) be baseType)

        2. If ((int has type nat)), then

          1. (Let n be (int as nat))

          2. If ((n > 0)), then

            1. Result in ((int < n >) as typeIR), []

          2. Else Phantom#1190

        2. Else Phantom#1191

      7. Case (% matches pattern `INT <(%)>`)

        1. (Let (int < ( expression ) >) be baseType)

        2. (Expr_ok: p TC |- expression : typedExpressionIR)

        3. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR))), then

          1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

          2. If ((value has type integerValue)), then

            1. (Let integerValue be (value as integerValue))

            2. (Let nat? be $nat_of_integerValue(integerValue))

            3. If ((nat? matches pattern (_))), then

              1. (Let ?(n) be nat?)

              2. If ((n > 0)), then

                1. Result in ((int < n >) as typeIR), []

              2. Else Phantom#1192

            3. Else Phantom#1193

          2. Else Phantom#1194

        3. Else Phantom#1195

      8. Case (% matches pattern `BIT`)

        1. Result in ((bit < 1 >) as typeIR), []

      9. Case (% matches pattern `BIT <%>`)

        1. (Let (bit < int >) be baseType)

        2. If ((int has type nat)), then

          1. (Let n be (int as nat))

          2. Result in ((bit < n >) as typeIR), []

        2. Else Phantom#1196

      10. Case (% matches pattern `BIT <(%)>`)

        1. (Let (bit < ( expression ) >) be baseType)

        2. (Expr_ok: p TC |- expression : typedExpressionIR)

        3. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR))), then

          1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

          2. If ((value has type integerValue)), then

            1. (Let integerValue be (value as integerValue))

            2. (Let nat? be $nat_of_integerValue(integerValue))

            3. If ((nat? matches pattern (_))), then

              1. (Let ?(n) be nat?)

              2. Result in ((bit < n >) as typeIR), []

            3. Else Phantom#1197

          2. Else Phantom#1198

        3. Else Phantom#1199

      11. Case (% matches pattern `VARBIT <%>`)

        1. (Let (varbit < int >) be baseType)

        2. If ((int has type nat)), then

          1. (Let n be (int as nat))

          2. Result in ((varbit < n >) as typeIR), []

        2. Else Phantom#1200

      12. Case (% matches pattern `VARBIT <(%)>`)

        1. (Let (varbit < ( expression ) >) be baseType)

        2. (Expr_ok: p TC |- expression : typedExpressionIR)

        3. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR))), then

          1. (Expr_eval_lctk: p TC |- typedExpressionIR ~> value)

          2. If ((value has type integerValue)), then

            1. (Let integerValue be (value as integerValue))

            2. (Let nat? be $nat_of_integerValue(integerValue))

            3. If ((nat? matches pattern (_))), then

              1. (Let ?(n) be nat?)

              2. Result in ((varbit < n >) as typeIR), []

            3. Else Phantom#1201

          2. Else Phantom#1202

        3. Else Phantom#1203

  2. Case (% has type identifier)

    1. (Let (typeId) be (typeOrVoid as identifier))

    2. (Type_ok: p TC |- ((typeId) as typeOrVoid) : typeIR # typeId_fresh*)

    3. Result in typeIR, typeId_fresh*

  3. Case (% has type prefixedTypeName)

    1. (Let prefixedTypeName be (typeOrVoid as prefixedTypeName))

    2. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

    3. (Let typeDefIR'? be $find_typeDef_t(p, TC, prefixedNameIR))

    4. If ((typeDefIR'? matches pattern (_))), then

      1. (Let ?(typeDefIR) be typeDefIR'?)

      2. Case analysis on $is_monomorphic_typeDefIR(typeDefIR)

        1. Case true

          1. (Let typeIR be $typeIR_of_typeDefIR(typeDefIR))

          2. Result in typeIR, []

        2. Case false

          1. (Let typeIR be $specialize_typeDefIR(typeDefIR, []))

          2. Result in typeIR, []

    4. Else Phantom#1204

  4. Case (% has type specializedType)

    1. (Let (prefixedTypeName < typeArgumentList >) be (typeOrVoid as specializedType))

    2. (Let prefixedNameIR be $prefixedTypeName(prefixedTypeName))

    3. (Let typeDefIR'? be $find_typeDef_t(p, TC, prefixedNameIR))

    4. If ((typeDefIR'? matches pattern (_))), then

      1. (Let ?(typeDefIR) be typeDefIR'?)

      2. If ($is_polymorphic_typeDefIR(typeDefIR)), then

        1. (TypeArgumentList_ok: p TC |- typeArgumentList : typeIR_arg* # typeId_fresh*)

        2. (Let typeIR be $specialize_typeDefIR(typeDefIR, typeIR_arg*))

        3. Result in typeIR, typeId_fresh*

      2. Else Phantom#1205

    4. Else Phantom#1206

  5. Case (% has type arrayType)

    1. (Let (type [ expression_size ]) be (typeOrVoid as arrayType))

    2. (Type_ok: p TC |- (type as typeOrVoid) : typeIR_base # typeId_fresh*)

    3. (Let typeIR_base' be $unroll_typeIR(typeIR_base))

    4. If (((typeIR_base' has type headerTypeIR) \/ (typeIR_base' has type headerUnionTypeIR))), then

      1. (Expr_ok: p TC |- expression_size : typedExpressionIR_size)

      2. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR_size))), then

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_size ~> value)

        2. If ((value has type integerValue)), then

          1. (Let integerValue_size be (value as integerValue))

          2. (Let nat? be $nat_of_integerValue(integerValue_size))

          3. If ((nat? matches pattern (_))), then

            1. (Let ?(n_size) be nat?)

            2. If ((n_size > 0)), then

              1. Result in ((header_stack typeIR_base [ n_size ]) as typeIR), typeId_fresh*

            2. Else Phantom#1207

          3. Else Phantom#1208

        2. Else Phantom#1209

      2. Else Phantom#1210

    4. Else Phantom#1211

    5. (Type_ok: p TC |- (type as typeOrVoid) : typeIR_base # typeId_fresh*)

    6. (Let typeIR_base' be $unroll_typeIR(typeIR_base))

    7. If (~((typeIR_base' has type headerTypeIR) \/ (typeIR_base' has type headerUnionTypeIR))), then

      1. (Expr_ok: p TC |- expression_size : typedExpressionIR_size)

      2. If (((lctk) = $ctk_of_typedExpressionIR(typedExpressionIR_size))), then

        1. (Expr_eval_lctk: p TC |- typedExpressionIR_size ~> value)

        2. If ((value has type integerValue)), then

          1. (Let integerValue_size be (value as integerValue))

          2. (Let nat? be $nat_of_integerValue(integerValue_size))

          3. If ((nat? matches pattern (_))), then

            1. (Let ?(n_size) be nat?)

            2. If ((n_size > 0)), then

              1. Result in ((array typeIR_base [ n_size ]) as typeIR), typeId_fresh*

            2. Else Phantom#1212

          3. Else Phantom#1213

        2. Else Phantom#1214

      2. Else Phantom#1215

    7. Else Phantom#1216

  6. Case (% has type listType)

    1. (Let (list < typeArgument >) be (typeOrVoid as listType))

    2. (TypeArgument_ok: p TC |- typeArgument : typeIR_arg # typeId_fresh*)

    3. Result in ((list < typeIR_arg >) as typeIR), typeId_fresh*

  7. Case (% has type tupleType)

    1. (Let (tuple < typeArgumentList >) be (typeOrVoid as tupleType))

    2. (TypeArgumentList_ok: p TC |- typeArgumentList : typeIR_arg* # typeId_fresh*)

    3. Result in ((tuple < typeIR_arg* >) as typeIR), typeId_fresh*

2. Else Phantom#1217

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:38:1-42:56:
relation TypeParameterListOpt_ok: p, TC_0, typeParameterListOpt

1. (Let typeParameter* be $flatten_typeParameterListOpt(typeParameterListOpt))

2. (Let typeId be $name(typeParameter))*

3. (Let TC_1 be $add_typeParameters_t(p, TC_0, typeId*))

4. Result in TC_1, typeId*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:44:1-48:51:
relation TypeArgument_ok: p, TC, typeArgument

1. Case analysis on typeArgument

  1. Case (% has type type)

    1. (Let type be (typeArgument as type))

    2. (Type_ok: p TC |- (type as typeOrVoid) : typeIR # typeId_impl*)

    3. Result in typeIR, typeId_impl*

  2. Case (% has type nonTypeName)

    1. (Let nonTypeName be (typeArgument as nonTypeName))

    2. (Let typeId be $name((nonTypeName as name)))

    3. If (Type_wf: $bound(p, TC) |- ((typeId) as typeIR) holds), then

      1. Result in ((typeId) as typeIR), []

    3. Else Phantom#1218

1. Else Phantom#1219

2. If ((typeArgument has type realTypeArgument)), then

  1. (Let realTypeArgument be (typeArgument as realTypeArgument))

  2. Case analysis on realTypeArgument

    1. Case (% matches pattern `VOID`)

      1. Result in ((void) as typeIR), []

    2. Case (% matches pattern `_`)

      1. (Let typeId_impl be $fresh_typeId)

      2. Result in ((typeId_impl) as typeIR), [typeId_impl]

  2. Else Phantom#1220

2. Else Phantom#1221

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:50:1-54:51:
relation TypeArguments_ok: p, TC, typeArgument*

1. Case analysis on typeArgument*

  1. Case (% matches pattern [])

    1. Result in [], []

  2. Case (% matches pattern _ :: _)

    1. (Let typeArgument_h :: typeArgument_t* be typeArgument*)

    2. (TypeArgument_ok: p TC |- typeArgument_h : typeArgumentIR_h # typeId_impl_h*)

    3. (TypeArguments_ok: p TC |- typeArgument_t* : typeArgumentIR_t* # typeId_impl_t*)

    4. (Let typeId_impl* be typeId_impl_h* ++ typeId_impl_t*)

    5. Result in typeArgumentIR_h :: typeArgumentIR_t*, typeId_impl*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:56:1-60:51:
relation TypeArgumentList_ok: p, TC, typeArgumentList

1. (Let typeArgument* be $flatten_typeArgumentList(typeArgumentList))

2. (TypeArguments_ok: p TC |- typeArgument* : typeArgumentIR* # typeId_impl*)

3. Result in typeArgumentIR*, typeId_impl*

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:67:1-68:9:
syntax castResult = 
   | ok typeIR* (from castResult)
   | fail (from castResult)

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:70:1-73:29:
relation Cast_expl: typeIR_a, typeIR_b

1. (Let typeIR_a_unroll be $unroll_typeIR(typeIR_a))

2. (Let typeIR_b_unroll be $unroll_typeIR(typeIR_b))

3. If (Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll holds), then

  1. Result in (ok [typeIR_b])

3. Else Phantom#1222

4. If (Type_alpha: typeIR_a_unroll ~~ typeIR_b_unroll does not hold), then

  1. (Cast_expl_neq: typeIR_a_unroll -> typeIR_b_unroll : castResult)

  2. Result in castResult

4. Else Phantom#1223

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:74:1-77:29:
relation Cast_expl_neq: typeIR''''', typeIR''''''

1. Case analysis on typeIR'''''

  1. Case (% has type boolTypeIR)

    1. (Let boolTypeIR be (typeIR''''' as boolTypeIR))

    2. If ((boolTypeIR matches pattern `BOOL`)), then

      1. If ((typeIR'''''' = ((bit < 1 >) as typeIR))), then

        1. Result in (ok [((bit < 1 >) as typeIR)])

  2. Case (% has type intTypeIR)

    1. (Let intTypeIR be (typeIR''''' as intTypeIR))

    2. If ((intTypeIR matches pattern `INT`)), then

      1. Case analysis on typeIR''''''

        1. Case (% has type boolTypeIR)

          1. (Let boolTypeIR be (typeIR'''''' as boolTypeIR))

          2. If ((boolTypeIR matches pattern `BOOL`)), then

            1. Result in (ok [((bool) as typeIR)])

        2. Case (% has type fixedIntTypeIR)

          1. (Let (int < w >) be (typeIR'''''' as fixedIntTypeIR))

          2. Result in (ok [((int < w >) as typeIR)])

        3. Case (% has type fixedBitTypeIR)

          1. (Let (bit < w >) be (typeIR'''''' as fixedBitTypeIR))

          2. Result in (ok [((bit < w >) as typeIR)])

  3. Case (% has type fixedIntTypeIR)

    1. (Let (int < _nat >) be (typeIR''''' as fixedIntTypeIR))

    2. Case analysis on typeIR''''''

      1. Case (% has type intTypeIR)

        1. (Let intTypeIR be (typeIR'''''' as intTypeIR))

        2. If ((intTypeIR matches pattern `INT`)), then

          1. Result in (ok [((int) as typeIR)])

      2. Case (% has type fixedIntTypeIR)

        1. (Let (int < w_b >) be (typeIR'''''' as fixedIntTypeIR))

        2. Result in (ok [((int < w_b >) as typeIR)])

      3. Case (% has type fixedBitTypeIR)

        1. (Let (bit < w' >) be (typeIR'''''' as fixedBitTypeIR))

        2. If ((_nat = w')), then

          1. Result in (ok [((bit < _nat >) as typeIR)])

  4. Case (% has type fixedBitTypeIR)

    1. (Let (bit < _nat >) be (typeIR''''' as fixedBitTypeIR))

    2. Case analysis on typeIR''''''

      1. Case (% has type intTypeIR)

        1. (Let intTypeIR be (typeIR'''''' as intTypeIR))

        2. If ((intTypeIR matches pattern `INT`)), then

          1. Result in (ok [((int) as typeIR)])

      2. Case (% has type fixedIntTypeIR)

        1. (Let (int < w' >) be (typeIR'''''' as fixedIntTypeIR))

        2. If ((_nat = w')), then

          1. Result in (ok [((int < _nat >) as typeIR)])

      3. Case (% has type fixedBitTypeIR)

        1. (Let (bit < w_b >) be (typeIR'''''' as fixedBitTypeIR))

        2. Result in (ok [((bit < w_b >) as typeIR)])

  5. Case (% has type newTypeIR)

    1. (Let (type _typeId typeIR_a) be (typeIR''''' as newTypeIR))

    2. (Cast_impl: typeIR_a -> typeIR'''''' : castResult)

    3. If ((castResult matches pattern `OK %`)), then

      1. (Let (ok typeIR_cast*) be castResult)

      2. Result in (ok typeIR_a :: typeIR_cast*)

  6. Case (% has type serializableEnumTypeIR)

    1. (Let (enum _typeId < typeIR_a > { _valueFieldIR* }) be (typeIR''''' as serializableEnumTypeIR))

    2. (Cast_impl: typeIR_a -> typeIR'''''' : castResult)

    3. If ((castResult matches pattern `OK %`)), then

      1. (Let (ok typeIR_cast*) be castResult)

      2. Result in (ok typeIR_a :: typeIR_cast*)

  7. Case (% has type defaultTypeIR)

    1. (Let defaultTypeIR be (typeIR''''' as defaultTypeIR))

    2. If ((defaultTypeIR matches pattern `DEFAULT`)), then

      1. If ($is_defaultable_typeIR(typeIR'''''')), then

        1. Result in (ok [typeIR''''''])

  8. Case (% has type invalidHeaderTypeIR)

    1. (Let invalidHeaderTypeIR be (typeIR''''' as invalidHeaderTypeIR))

    2. If ((invalidHeaderTypeIR matches pattern `HEADER_INVALID`)), then

      1. Case analysis on typeIR''''''

        1. Case (% has type headerTypeIR)

          1. (Let headerTypeIR be (typeIR'''''' as headerTypeIR))

          2. Result in (ok ([headerTypeIR] as typeIR*))

        2. Case (% has type headerUnionTypeIR)

          1. (Let headerUnionTypeIR be (typeIR'''''' as headerUnionTypeIR))

          2. Result in (ok ([headerUnionTypeIR] as typeIR*))

  9. Case (% has type sequenceTypeIR)

    1. (Let sequenceTypeIR be (typeIR''''' as sequenceTypeIR))

    2. Case analysis on sequenceTypeIR

      1. Case (% matches pattern `SEQ <%>`)

        1. (Let (seq < typeIR_a* >) be sequenceTypeIR)

        2. Case analysis on typeIR''''''

          1. Case (% has type listTypeIR)

            1. (Let listTypeIR be (typeIR'''''' as listTypeIR))

            2. (Let (list < typeIR_b >) be listTypeIR)

            3. (Cast_expl: typeIR_a -> typeIR_b : castResult)*

            4. If ((castResult matches pattern `OK %`))*, then

              1. (Let (ok typeIR_cast*) be castResult)*

              2. (Let typeIR_cast_agg* be $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, (listTypeIR as typeIR)))

              3. Result in (ok typeIR_cast_agg*)

          2. Case (% has type tupleTypeIR)

            1. (Let tupleTypeIR be (typeIR'''''' as tupleTypeIR))

            2. (Let (tuple < typeIR_b* >) be tupleTypeIR)

            3. (Cast_expl: typeIR_a -> typeIR_b : castResult)*

            4. If ((castResult matches pattern `OK %`))*, then

              1. (Let (ok typeIR_cast*) be castResult)*

              2. (Let typeIR_cast_agg* be $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, (tupleTypeIR as typeIR)))

              3. Result in (ok typeIR_cast_agg*)

          3. Case (% has type arrayTypeIR)

            1. (Let arrayTypeIR be (typeIR'''''' as arrayTypeIR))

            2. (Let (array typeIR_b [ n_size ]) be arrayTypeIR)

            3. If ((|typeIR_a*| = n_size)), then

              1. (Cast_expl: typeIR_a -> typeIR_b : castResult)*

              2. If ((castResult matches pattern `OK %`))*, then

                1. (Let (ok typeIR_cast*) be castResult)*

                2. (Let typeIR_cast_agg* be $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, (arrayTypeIR as typeIR)))

                3. Result in (ok typeIR_cast_agg*)

          4. Case (% has type headerStackTypeIR)

            1. (Let headerStackTypeIR be (typeIR'''''' as headerStackTypeIR))

            2. (Let (header_stack typeIR_b [ n_size ]) be headerStackTypeIR)

            3. If ((|typeIR_a*| = n_size)), then

              1. (Cast_expl: typeIR_a -> typeIR_b : castResult)*

              2. If ((castResult matches pattern `OK %`))*, then

                1. (Let (ok typeIR_cast*) be castResult)*

                2. (Let typeIR_cast_agg* be $chain_casts_sequenceTypeIR(typeIR_a*, typeIR_cast**, (headerStackTypeIR as typeIR)))

                3. Result in (ok typeIR_cast_agg*)

          5. Case (% has type structTypeIR)

