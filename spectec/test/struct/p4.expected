   | exit (from exitResult)
   | return value? (from returnResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:275:1-278:26:
relation Table_eval: EC_0, ARCH_0, typeId, TBL

1. (Let (key = { tableKeyListIR }) be TBL.keys)

2. (TableKeys_eval: EC_0 ARCH_0 |- tableKeyListIR : EC_1 ARCH_1 tableKeysResult)

3. Case analysis on tableKeysResult

  1. Case (% has type exitResult)

    1. (Let exitResult be (tableKeysResult as exitResult))

    2. If ((exitResult matches pattern `EXIT`)), then

      1. Result in EC_1, ARCH_1, ((exit) as tableResult)

    2. Else Phantom#2198

  2. Case (% has type continueResult<tableKeyValue*>)

    1. (Let (tableKeyValue*) be (tableKeysResult as continueResult<tableKeyValue*>))

    2. (Let (_annotationList _constOptIR entries = { tableEntryListIR }) be TBL.entries)

    3. (TableMatches_eval: EC_1 ARCH_1 |- tableKeyValue* @ tableEntryListIR : EC_2 ARCH_2 tableMatchesResult)

    4. Case analysis on tableMatchesResult

      1. Case (% has type exitResult)

        1. (Let exitResult be (tableMatchesResult as exitResult))

        2. If ((exitResult matches pattern `EXIT`)), then

          1. Result in EC_2, ARCH_2, ((exit) as tableResult)

        2. Else Phantom#2199

      2. Case (% has type continueResult<tableMatch*>)

        1. (Let (tableMatch*) be (tableMatchesResult as continueResult<tableMatch*>))

        2. (Let (prefixedNameIR _controlPlaneNameIR ( argumentListIR )) be $select_action(TBL, tableMatch*))

        3. (Stmt_eval: (local) EC_2 ARCH_2 |- (((prefixedNameIR as callableTargetIR) < [] > ( argumentListIR ) ;) as statementIR) : EC_3 ARCH_3 statementResult)

        4. If ((statementResult has type exitResult)), then

          1. (Let exitResult be (statementResult as exitResult))

          2. If ((exitResult matches pattern `EXIT`)), then

            1. Result in EC_3, ARCH_3, ((exit) as tableResult)

          2. Else Phantom#2200

        4. Else Phantom#2201

        5. (Stmt_eval: (local) EC_2 ARCH_2 |- (((prefixedNameIR as callableTargetIR) < [] > ( argumentListIR ) ;) as statementIR) : EC_3 ARCH_3 statementResult)

        6. If ((statementResult has type continueEmptyResult)), then

          1. (Let continueEmptyResult be (statementResult as continueEmptyResult))

          2. If ((continueEmptyResult matches pattern `_EMPTY`)), then

            1. (Let b_hit be ~(tableMatch* = []))

            2. (Let b_miss be ~b_hit)

            3. (Let tableMetadataEnumValue be (table_enum "action_list(" ++ typeId ++ ")" . $flatten_prefixedNameIR(prefixedNameIR)))

            4. (Let tableMetadataStructValue be (table_struct "apply_result(" ++ typeId ++ ")" { hit (b_hit) ; miss (b_miss) ; action_run tableMetadataEnumValue ; }))

            5. Result in EC_3, ARCH_3, ((return ?((tableMetadataStructValue as value))) as tableResult)

          2. Else Phantom#2202

        6. Else Phantom#2203

