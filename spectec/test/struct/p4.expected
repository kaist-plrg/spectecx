dec $signature_of_builtinMethodTypeIR(builtinMethodTypeIR)

1. Case analysis on builtinMethodTypeIR

  1. Case (% has type builtinIsValidMethodTypeIR)

    1. (Let builtinIsValidMethodTypeIR be (builtinMethodTypeIR as builtinIsValidMethodTypeIR))

    2. If ((builtinIsValidMethodTypeIR matches pattern `BUILTIN_IS_VALID`)), then

      1. Return ([], ((bool) as typeIR))

    2. Else Phantom#97

  2. Case (% has type builtinSetValidMethodTypeIR)

    1. (Let builtinSetValidMethodTypeIR be (builtinMethodTypeIR as builtinSetValidMethodTypeIR))

    2. If ((builtinSetValidMethodTypeIR matches pattern `BUILTIN_SET_VALID`)), then

      1. Return ([], ((void) as typeIR))

    2. Else Phantom#98

  3. Case (% has type builtinSetInvalidMethodTypeIR)

    1. (Let builtinSetInvalidMethodTypeIR be (builtinMethodTypeIR as builtinSetInvalidMethodTypeIR))

    2. If ((builtinSetInvalidMethodTypeIR matches pattern `BUILTIN_SET_INVALID`)), then

      1. Return ([], ((void) as typeIR))

    2. Else Phantom#99

  4. Case (% has type builtinPushFrontMethodTypeIR)

    1. (Let builtinPushFrontMethodTypeIR be (builtinMethodTypeIR as builtinPushFrontMethodTypeIR))

    2. If ((builtinPushFrontMethodTypeIR matches pattern `BUILTIN_PUSH_FRONT`)), then

      1. Return ([(() () ((int) as typeIR) "count" ?())], ((void) as typeIR))

    2. Else Phantom#100

  5. Case (% has type builtinPopFrontMethodTypeIR)

    1. (Let builtinPopFrontMethodTypeIR be (builtinMethodTypeIR as builtinPopFrontMethodTypeIR))

    2. If ((builtinPopFrontMethodTypeIR matches pattern `BUILTIN_POP_FRONT`)), then

      1. Return ([(() () ((int) as typeIR) "count" ?())], ((void) as typeIR))

    2. Else Phantom#101

  6. Case (% has type builtinSizeMethodTypeIR)

    1. (Let builtinSizeMethodTypeIR be (builtinMethodTypeIR as builtinSizeMethodTypeIR))

    2. If ((builtinSizeMethodTypeIR matches pattern `BUILTIN_SIZE_OF`)), then

      1. Return ([], ((int) as typeIR))

    2. Else Phantom#102

