   | exit (from exitResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.09.1-eval-control-table.spectec:39:1-44:61:
relation TableKeys_eval: EC', ARCH', tableKeyIR*

1. Case analysis on tableKeyIR*

  1. Case (% matches pattern [])

    1. Result in EC', ARCH', (([]) as tableKeysResult)

  2. Case (% matches pattern _ :: _)

    1. (Let tableKeyIR_h :: tableKeyIR_t* be tableKeyIR*)

