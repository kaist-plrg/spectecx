;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:207:1-209:26:
syntax transitionResult = 
   | accept (from acceptTransitionResult)
   | reject errorValue (from rejectTransitionResult)
   | state id (from stateTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:211:1-218:42:
relation ParserSelect_eval: EC_0, ARCH_0, selectExpressionIR

1. (Let (select ( typedExpressionIR_key* ) { selectCaseListIR }) be selectExpressionIR)

2. (Exprs_eval: (local) EC_0 ARCH_0 |- typedExpressionIR_key* : EC_1 ARCH_1 expressionListResult)

3. Case analysis on expressionListResult

  1. Case (% has type rejectTransitionResult)

    1. (Let rejectTransitionResult be (expressionListResult as rejectTransitionResult))

    2. Result in EC_1, ARCH_1, (rejectTransitionResult as transitionResult)

  2. Case (% has type continueResult<value*>)

    1. (Let (value_key*) be (expressionListResult as continueResult<value*>))

    2. (SelectCases_match: EC_1 ARCH_1 value_key* |- selectCaseListIR : EC_2 ARCH_2 selectCaseMatchResult)

    3. Case analysis on selectCaseMatchResult

      1. Case (% has type rejectTransitionResult)

        1. (Let rejectTransitionResult be (selectCaseMatchResult as rejectTransitionResult))

        2. Result in EC_2, ARCH_2, (rejectTransitionResult as transitionResult)

      2. Case (% has type continueResult<nameIR?>)

        1. (Let (nameIR_state?) be (selectCaseMatchResult as continueResult<nameIR?>))

        2. If ((?() = nameIR_state?)), then

          1. (Let rejectTransitionResult be (reject (error . "NoMatch")))

          2. Result in EC_2, ARCH_2, (rejectTransitionResult as transitionResult)

        2. Else Phantom#2183

        3. If ((nameIR_state? matches pattern (_))), then

          1. (Let ?(nameIR_state) be nameIR_state?)

          2. (ParserTransition_eval: EC_2 ARCH_2 |- (transition (nameIR_state ;)) : EC_3 ARCH_3 transitionResult)

          3. Result in EC_3, ARCH_3, transitionResult

        3. Else Phantom#2184

3. Else Phantom#2185

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:220:1-227:42:
relation ParserTransition_eval: EC', ARCH', (transition stateExpressionIR)

1. If ((stateExpressionIR matches pattern `% ;`)), then

  1. (Let (nameIR ;) be stateExpressionIR)

  2. Case analysis on nameIR

    1. Case (% = "accept")

      1. Result in EC', ARCH', ((accept) as transitionResult)

    2. Case (% = "reject")

      1. (Let errorValue be (error . "NoError"))

      2. Result in EC', ARCH', ((reject errorValue) as transitionResult)

  2. Else Phantom#2186

  3. If (((nameIR =/= "accept") /\ (nameIR =/= "reject"))), then

    1. Result in EC', ARCH', ((state nameIR) as transitionResult)

  3. Else Phantom#2187

1. Else Phantom#2188

2. If ((stateExpressionIR has type selectExpressionIR)), then

  1. (Let selectExpressionIR be (stateExpressionIR as selectExpressionIR))

  2. (ParserSelect_eval: EC' ARCH' |- selectExpressionIR : EC_1 ARCH_1 transitionResult)

  3. Result in EC_1, ARCH_1, transitionResult

2. Else Phantom#2189

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:229:1-236:42:
relation ParserState_eval: EC_0, ARCH_0, parserStateIR

1. (Let (annotationList state nameIR { parserBlockElementStatementListIR transitionStatementIR }) be parserStateIR)

2. (Let EC_1 be $enter_e(EC_0))

3. (ParserBlockElementStmtList_eval: EC_1 ARCH_0 |- parserBlockElementStatementListIR : EC_2 ARCH_1 parserStatementResult)

4. Case analysis on parserStatementResult

  1. Case (% has type rejectTransitionResult)

    1. (Let rejectTransitionResult be (parserStatementResult as rejectTransitionResult))

    2. (Let EC_3 be $exit_e(EC_2))

    3. Result in EC_3, ARCH_1, (rejectTransitionResult as transitionResult)

  2. Case (% has type continueEmptyResult)

    1. (Let continueEmptyResult be (parserStatementResult as continueEmptyResult))

    2. If ((continueEmptyResult matches pattern `_EMPTY`)), then

      1. (ParserTransition_eval: EC_2 ARCH_1 |- transitionStatementIR : EC_3 ARCH_2 transitionResult)

      2. (Let EC_4 be $exit_e(EC_3))

      3. Result in EC_4, ARCH_2, transitionResult

    2. Else Phantom#2190

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:238:1-245:42:
relation ParserState_trans: EC_0, ARCH_0, nameIR

1. (Let parserStateIR'? be $find_parserState_e(EC_0, nameIR))

2. If ((parserStateIR'? matches pattern (_))), then

  1. (Let ?(parserStateIR) be parserStateIR'?)

  2. (ParserState_eval: EC_0 ARCH_0 |- parserStateIR : EC_1 ARCH_1 transitionResult)

  3. Case analysis on transitionResult

    1. Case (% has type acceptTransitionResult)

      1. (Let acceptTransitionResult be (transitionResult as acceptTransitionResult))

      2. If ((acceptTransitionResult matches pattern `ACCEPT`)), then

        1. Result in EC_1, ARCH_1, ((accept) as transitionResult)

      2. Else Phantom#2191

    2. Case (% has type rejectTransitionResult)

      1. (Let rejectTransitionResult be (transitionResult as rejectTransitionResult))

      2. Result in EC_1, ARCH_1, (rejectTransitionResult as transitionResult)

  3. Else Phantom#2192

  4. (ParserState_eval: EC_0 ARCH_0 |- parserStateIR : EC_1 ARCH_1 transitionResult')

  5. If ((transitionResult' has type stateTransitionResult)), then

    1. (Let (state nameIR_next) be (transitionResult' as stateTransitionResult))

    2. (ParserState_trans: EC_1 ARCH_1 |- transition nameIR_next : EC_2 ARCH_2 transitionResult)

    3. Result in EC_2, ARCH_2, transitionResult

  5. Else Phantom#2193

2. Else Phantom#2194

