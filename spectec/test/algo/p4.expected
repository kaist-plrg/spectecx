;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:815:1-816:76:
syntax tableCustomPropertyIR = 
   | annotationList constOptIR custom nameIR initializerIR ; (from tableCustomPropertyIR)
   | annotationList constOptIR custom_const nameIR constantInitializerIR ; (from tableCustomPropertyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:819:1-823:26:
syntax tablePropertyIR = 
   | key = { tableKeyListIR } (from tableKeysPropertyIR)
   | actions = { tableActionListIR } (from tableActionsPropertyIR)
   | annotationList constOptIR default_action = tableActionReferenceIR ; (from tableDefaultActionPropertyIR)
   | annotationList constOptIR entries = { tableEntryListIR } (from tableEntriesPropertyIR)
   | annotationList constOptIR custom nameIR initializerIR ; (from tableCustomPropertyIR)
   | annotationList constOptIR custom_const nameIR constantInitializerIR ; (from tableCustomPropertyIR)

