;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:545:1-545:61:
def $callable_tableApplyMethod(cursor, typingContext) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:547:1-547:51:
   clause 0(cursor, TC) = false
      -- if cursor matches `GLOBAL`

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:548:1-548:50:
