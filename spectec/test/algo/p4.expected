def $starts_with(text, text) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:100:1-102:37:
   clause 0(t, t_prefix) = true
      -- if (|t_prefix| <= |t|)
      -- if (t[0 : |t_prefix|] = t_prefix)

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:103:1-104:15:
   clause 1(t, t_prefix) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:106:1-107:46:
def $ends_with(text, text) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:108:1-111:43:
   clause 0(t, t_suffix) = true
      -- if (|t_suffix| <= |t|)
