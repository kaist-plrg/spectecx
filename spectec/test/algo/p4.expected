;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1070:3-1070:46:
syntax externFunctionDeclaration = 
   | annotationList extern functionPrototype ; (from externFunctionDeclaration)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1073:1-1073:58:
syntax externConstructorPrototype = 
   | annotationList typeIdentifier ( parameterList ) ; (from externConstructorPrototype)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1076:1-1077:50:
syntax externMethodPrototype = 
