;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:7:30-7:36:
syntax continueEmptyResult = 
   |  (from continueEmptyResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:8:28-8:35:
syntax continueResult<X> = 
   | X (from continueResult<X>)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:12:21-12:25:
syntax exitResult = 
   | exit (from exitResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:16:23-16:36:
syntax returnResult = 
   | return value? (from returnResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:20:33-20:39:
syntax acceptTransitionResult = 
   | accept (from acceptTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:21:33-21:50:
syntax rejectTransitionResult = 
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:22:32-22:40:
syntax stateTransitionResult = 
   | state id (from stateTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:25:1-26:27:
syntax abortResult = 
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:33:1-34:16:
syntax expressionResult = 
   | value (from continueResult<value>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:36:1-41:54:
relation Expr_eval: cursor evalContext arch |- typedExpressionIR : evalContext arch expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:17:1-22:43:
   rule booleanLiteral: p EC ARCH |- expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if expressionIR <: booleanLiteral
      -- let booleanLiteral = expressionIR as booleanLiteral
      -- let boolValue = $ite<boolValue>((booleanLiteral = true), true, false)
      -- let expressionResult = boolValue as value as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:24:1-27:48:
   rule integerLiteral: p EC ARCH |- expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if expressionIR <: integerLiteral
      -- let integerLiteral = expressionIR as integerLiteral
      -- let expressionResult = integerLiteral as value as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:29:1-32:47:
   rule stringLiteral: p EC ARCH |- expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if expressionIR <: stringLiteral
      -- let stringLiteral = expressionIR as stringLiteral
      -- let expressionResult = stringLiteral as value as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:38:1-42:39:
   rule referenceExpressionIR: p EC ARCH |- expressionIR # _expressionNoteIR : EC ARCH expressionResult
