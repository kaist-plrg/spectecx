      -- if (t[n_start : |t_suffix|] = t_suffix)

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:112:1-113:15:
   clause 1(t, t_suffix) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:115:1-116:85:
def $strip_prefix_rec(text, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:117:1-120:48:
   clause 0(t, t_prefix) = $strip_prefix_rec(t_stripped, t_prefix)
