def $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR) : tableEntryPriorityOptIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:787:1-789:63:
   clause 0(tableEntryIR) = tableEntryPriorityOptIR
      -- let _constOptIR tableEntryPriorityOptIR _keysetExpressionIR : _tableActionReferenceIR _annotationList ; = tableEntryIR

