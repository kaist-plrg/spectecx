;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1048:1-1051:31:
syntax derivedTypeDeclaration = 
   | annotationList enum name { nameList trailingCommaOpt } (from enumTypeDeclaration)
