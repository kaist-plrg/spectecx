;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:10:3-11:51:
syntax actionCallee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:18:3-19:51:
syntax definedFunctionCallee = 
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:22:3-23:68:
syntax externFunctionCallee = 
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:26:1-27:25:
syntax functionCallee = 
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:33:40-33:73:
syntax builtinIsValidMethodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:34:40-34:74:
syntax builtinSetValidMethodCallee = 
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:35:40-35:76:
syntax builtinSetInvalidMethodCallee = 
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:36:40-36:75:
syntax builtinPushFrontMethodCallee = 
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:37:40-37:74:
syntax builtinPopFrontMethodCallee = 
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:38:40-38:69:
syntax builtinSizeMethodCallee = 
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:41:1-46:28:
syntax builtinMethodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:49:3-51:48:
syntax externMethodCallee = 
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:54:3-55:72:
syntax parserApplyMethodCallee = 
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:58:3-59:95:
syntax controlApplyMethodCallee = 
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:62:3-62:63:
syntax tableApplyMethodCallee = 
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:65:1-69:27:
syntax methodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:71:17-71:61:
syntax callee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee)
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:6:3-8:38:
syntax externObjectConstructorDef = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:11:3-15:28:
syntax parserObjectConstructorDef = 
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:18:3-22:30:
syntax controlObjectConstructorDef = 
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:25:3-26:37:
syntax packageObjectConstructorDef = 
   | package < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:29:1-32:32:
syntax constructorDef = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef)
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef)
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlObjectConstructorDef)
   | package < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:5:1-6:17:
def $parameterListIR_of_constructorDef(constructorDef) : parameterIR* =

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:8:1-10:31:
   clause 0(constructorDef) = constructorParameterListIR
      -- if constructorDef <: externObjectConstructorDef
      -- let extern _nameIR < _typeParameterListIR > ( constructorParameterListIR ) { _externMethodPrototypeListIR } = constructorDef as externObjectConstructorDef

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:12:1-14:31:
   clause 1(constructorDef) = constructorParameterListIR
      -- if constructorDef <: parserObjectConstructorDef
      -- let parser < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _parserLocalDeclarationListIR _parserStateListIR } = constructorDef as parserObjectConstructorDef

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:16:1-18:31:
   clause 2(constructorDef) = constructorParameterListIR
      -- if constructorDef <: controlObjectConstructorDef
      -- let control < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _controlLocalDeclarationListIR apply _controlBodyIR } = constructorDef as controlObjectConstructorDef

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:20:1-22:31:
   clause 3(constructorDef) = constructorParameterListIR
      -- if constructorDef <: packageObjectConstructorDef
      -- let package < _typeParameterListIR > ( constructorParameterListIR ) = constructorDef as packageObjectConstructorDef

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:12:1-12:26:
opaque syntax objectState

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:13:29-13:61:
syntax externMethodDefEnv = map<callableId, externMethodDef>

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:15:1-16:77:
builtin dec $init_objectState(nameIR, typeIR*, id*, value*) : objectState

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:19:3-19:71:
syntax externObject = 
   | extern typeId < theta > { objectState frame externMethodDefEnv } (from externObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:29:3-32:19:
syntax parserObject = 
   | parser < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:42:23-42:49:
syntax actionDefEnv = map<callableId, actionDef>

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:45:3-49:24:
syntax controlObject = 
   | control < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:57:24-57:55:
