;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:640:1-641:32:
def $flatten_typeArgumentList(typeArgumentList) : typeArgument* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:642:1-642:44:
   clause 0(typeArgumentList) = []
      -- if typeArgumentList matches `_EMPTY`

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:643:1-643:59:
