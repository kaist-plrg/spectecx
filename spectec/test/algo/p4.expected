      -- let ?(typedLvalueIR_base) = typedLvalueIR?{typedLvalueIR <- typedLvalueIR?}

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:326:1-330:68:
   clause 3(expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] # ( typeIR ))
      -- if expressionIR <: sliceAccessExpressionIR
      -- let typedExpressionIR_base [ typedExpressionIR_hi sliceop typedExpressionIR_lo ] = expressionIR as sliceAccessExpressionIR
      -- if sliceop matches `:`
      -- let typedLvalueIR?{typedLvalueIR <- typedLvalueIR?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)
      -- if typedLvalueIR?{typedLvalueIR <- typedLvalueIR?} matches (_)
      -- let ?(typedLvalueIR_base) = typedLvalueIR?{typedLvalueIR <- typedLvalueIR?}

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:331:1-335:68:
   clause 4(expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR_base [ typedExpressionIR_l +: typedExpressionIR_w ] # ( typeIR ))
      -- if expressionIR <: sliceAccessExpressionIR
      -- let typedExpressionIR_base [ typedExpressionIR_l sliceop typedExpressionIR_w ] = expressionIR as sliceAccessExpressionIR
      -- if sliceop matches `+:`
      -- let typedLvalueIR?{typedLvalueIR <- typedLvalueIR?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base)
