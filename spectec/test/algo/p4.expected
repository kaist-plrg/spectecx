   | annotationList abstract functionPrototype ; (from externMethodPrototype)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1083:1-1085:9:
def $is_externConstructorPrototype(externConstructorOrMethodPrototype) : bool =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1087:1-1089:9:
   clause 0(externConstructorOrMethodPrototype) = true
      -- if externConstructorOrMethodPrototype <: externConstructorPrototype
