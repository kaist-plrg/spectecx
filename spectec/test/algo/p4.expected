;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1168:1-1170:21:
syntax valueSetType = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
