;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:5:1-7:43:
def $match_keysets(setValue*, value*) : bool =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:10:1-10:36:
   clause 0(setValue*{setValue <- setValue*}, value*{value <- value*}) = true
      -- if setValue*{setValue <- setValue*} matches []
      -- if value*{value <- value*} matches []

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:11:1-11:55:
   clause 1(setValue*{setValue <- setValue*}, value_key*{value_key <- value_key*}) = true
      -- if (setValue*{setValue <- setValue*} = [set { ... }])

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:12:1-13:37:
   clause 2(setValue'*{setValue' <- setValue'*}, value*{value <- value*}) = $match_keyset(setValue, value_key)
      -- if setValue'*{setValue' <- setValue'*} matches [ _/1 ]
      -- let [setValue] = setValue'*{setValue' <- setValue'*}
      -- if value*{value <- value*} matches [ _/1 ]
      -- let [value_key] = value*{value <- value*}
      -- if (setValue =/= set { ... })

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:14:1-18:47:
   clause 3(setValue*{setValue <- setValue*}, value*{value <- value*}) = $match_keysets(setValue_t*{setValue_t <- setValue_t*}, value_key_t*{value_key_t <- value_key_t*})
      -- if setValue*{setValue <- setValue*} matches _ :: _
      -- let setValue_h :: setValue_t*{setValue_t <- setValue_t*} = setValue*{setValue <- setValue*}
      -- if value*{value <- value*} matches _ :: _
      -- let value_key_h :: value_key_t*{value_key_t <- value_key_t*} = value*{value <- value*}
      -- if (setValue_t*{setValue_t <- setValue_t*} =/= [])
      -- if (value_key_t*{value_key_t <- value_key_t*} =/= [])
      -- if $match_keyset(setValue_h, value_key_h)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:19:1-23:48:
   clause 4(setValue*{setValue <- setValue*}, value*{value <- value*}) = false
      -- if setValue*{setValue <- setValue*} matches _ :: _
      -- let setValue_h :: setValue_t*{setValue_t <- setValue_t*} = setValue*{setValue <- setValue*}
      -- if value*{value <- value*} matches _ :: _
      -- let value_key_h :: value_key_t*{value_key_t <- value_key_t*} = value*{value <- value*}
      -- if (setValue_t*{setValue_t <- setValue_t*} =/= [])
      -- if (value_key_t*{value_key_t <- value_key_t*} =/= [])
      -- if ~$match_keyset(setValue_h, value_key_h)

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:8:1-8:42:
def $match_keyset(setValue, value) : bool =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:25:1-25:53:
   clause 0(setValue, value_key) = true
      -- if setValue matches `SET {...}`

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:26:1-26:74:
   clause 1(setValue, value_key) = $bin_eq(value, value_key)
      -- if setValue matches `SET {%}`
      -- let set { value } = setValue

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:27:1-28:41:
   clause 2(setValue, value_key) = $exists_($bin_eq(value, value_key)*{value <- value*})
      -- if setValue matches `SET {% (%)}`
      -- let set { value*{value <- value*} ( _nat ) } = setValue

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:29:1-32:40:
   clause 3(setValue, value_key) = $bin_eq($bin_band(value_base, value_mask), $bin_band(value_key, value_mask))
      -- if setValue matches `SET {% &&& %}`
      -- let set { value_base &&& value_mask } = setValue

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:33:1-35:39:
   clause 4(setValue, value_key) = ($bin_le(value_base, value_key) /\ $bin_le(value_key, value_limit))
      -- if setValue matches `SET {% .. %}`
      -- let set { value_base .. value_limit } = setValue

