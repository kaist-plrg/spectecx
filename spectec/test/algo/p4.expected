;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:12:21-12:25:
syntax voidTypeIR = 
   | void (from voidTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:13:21-13:25:
syntax boolTypeIR = 
   | bool (from boolTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:14:22-14:27:
syntax errorTypeIR = 
   | error (from errorTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:15:26-15:36:
syntax matchKindTypeIR = 
   | match_kind (from matchKindTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:16:23-16:29:
syntax stringTypeIR = 
   | string (from stringTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:18:20-18:23:
syntax intTypeIR = 
   | int (from intTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:19:25-19:38:
syntax fixedIntTypeIR = 
   | int < nat > (from fixedIntTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:20:25-20:38:
syntax fixedBitTypeIR = 
   | bit < nat > (from fixedBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:21:23-21:39:
syntax varBitTypeIR = 
   | varbit < nat > (from varBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:24:1-27:17:
syntax integerTypeIR = 
   | int (from intTypeIR)
   | int < nat > (from fixedIntTypeIR)
   | bit < nat > (from fixedBitTypeIR)
   | varbit < nat > (from varBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:30:1-35:18:
syntax baseTypeIR = 
   | void (from voidTypeIR)
   | bool (from boolTypeIR)
   | error (from errorTypeIR)
   | match_kind (from matchKindTypeIR)
   | string (from stringTypeIR)
   | int (from intTypeIR)
   | int < nat > (from fixedIntTypeIR)
   | bit < nat > (from fixedBitTypeIR)
   | varbit < nat > (from varBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:41:21-41:48:
syntax nameTypeIR = 
   | typeId (from nameTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:48:3-49:17:
syntax typedefTypeIR = 
   | typedef typeId typeIR (from typedefTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:52:3-53:17:
syntax newTypeIR = 
   | type typeId typeIR (from newTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:56:1-57:14:
syntax aliasTypeIR = 
   | typedef typeId typeIR (from typedefTypeIR) hint(print %0)
   | type typeId typeIR (from newTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:63:21-63:38:
syntax listTypeIR = 
   | list < typeIR > (from listTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:64:22-64:41:
syntax tupleTypeIR = 
   | tuple < typeIR* > (from tupleTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:65:22-65:44:
syntax arrayTypeIR = 
   | array typeIR [ nat ] (from arrayTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:66:28-66:57:
syntax headerStackTypeIR = 
   | header_stack typeIR [ nat ] (from headerStackTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:68:22-68:54:
syntax fieldTypeIR = 
   | annotationList typeIR nameIR ; (from fieldTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:71:3-72:28:
syntax structTypeIR = 
   | struct typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:74:3-75:28:
syntax headerTypeIR = 
   | header typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:77:3-78:28:
syntax headerUnionTypeIR = 
   | header_union typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:80:23-80:43:
syntax valueFieldIR = 
   | nameIR = value ; (from valueFieldIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:83:3-83:43:
syntax simpleEnumTypeIR = 
   | enum typeId { nameIR* } (from simpleEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:86:3-86:62:
syntax serializableEnumTypeIR = 
   | enum typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:89:1-90:27:
syntax enumTypeIR = 
   | enum typeId { nameIR* } (from simpleEnumTypeIR) hint(print %0)
   | enum typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:93:1-100:15:
syntax dataTypeIR = 
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | array typeIR [ nat ] (from arrayTypeIR)
   | header_stack typeIR [ nat ] (from headerStackTypeIR)
   | struct typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR) hint(print %0#"<"#%1#">")
   | header typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR) hint(print %0#"<"#%1#">")
   | header_union typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR) hint(print %0#"<"#%1#">")
   | enum typeId { nameIR* } (from simpleEnumTypeIR) hint(print %0)
   | enum typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:111:3-111:41:
syntax externMethodTypeDefEnv = map<callableId, externMethodTypeDefIR>

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:114:3-115:28:
syntax externObjectTypeIR = 
   | extern typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:118:3-119:28:
syntax parserObjectTypeIR = 
   | parser typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:122:3-123:28:
syntax controlObjectTypeIR = 
   | control typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:126:3-127:28:
syntax packageObjectTypeIR = 
   | package typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:130:3-131:17:
syntax tableObjectTypeIR = 
   | table typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:134:1-138:22:
syntax objectTypeIR = 
   | extern typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR) hint(print %0#"<"#%1#">")
   | parser typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR) hint(print %0#"<"#%1#">")
   | control typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR) hint(print %0#"<"#%1#">")
   | package typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR) hint(print %0#"<"#%1#">")
   | table typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:144:24-144:31:
syntax defaultTypeIR = 
   | default (from defaultTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:146:30-146:44:
syntax invalidHeaderTypeIR = 
   | header_invalid (from invalidHeaderTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:149:1-150:32:
syntax sequenceTypeIR = 
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:153:1-154:40:
syntax recordTypeIR = 
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:156:20-156:36:
syntax setTypeIR = 
   | set < typeIR > (from setTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:159:3-160:17:
syntax tableMetadataEnumTypeIR = 
   | table_enum typeId { nameIR* } (from tableMetadataEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:163:3-166:17:
syntax tableMetadataStructTypeIR = 
   | table_struct typeId { hit boolTypeIR ; miss boolTypeIR ; action_run tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:169:1-170:30:
syntax tableMetadataTypeIR = 
   | table_enum typeId { nameIR* } (from tableMetadataEnumTypeIR) hint(print %0)
   | table_struct typeId { hit boolTypeIR ; miss boolTypeIR ; action_run tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:173:1-178:24:
syntax synthesizedTypeIR = 
   | default (from defaultTypeIR)
   | header_invalid (from invalidHeaderTypeIR)
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)
   | set < typeIR > (from setTypeIR)
   | table_enum typeId { nameIR* } (from tableMetadataEnumTypeIR) hint(print %0)
   | table_struct typeId { hit boolTypeIR ; miss boolTypeIR ; action_run tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:185:1-190:22:
syntax typeIR = 
   | void (from voidTypeIR)
   | bool (from boolTypeIR)
   | error (from errorTypeIR)
   | match_kind (from matchKindTypeIR)
   | string (from stringTypeIR)
   | int (from intTypeIR)
   | int < nat > (from fixedIntTypeIR)
   | bit < nat > (from fixedBitTypeIR)
   | varbit < nat > (from varBitTypeIR)
   | typeId (from nameTypeIR) hint(print %0)
   | typedef typeId typeIR (from typedefTypeIR) hint(print %0)
   | type typeId typeIR (from newTypeIR) hint(print %0)
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | array typeIR [ nat ] (from arrayTypeIR)
   | header_stack typeIR [ nat ] (from headerStackTypeIR)
   | struct typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR) hint(print %0#"<"#%1#">")
   | header typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR) hint(print %0#"<"#%1#">")
   | header_union typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR) hint(print %0#"<"#%1#">")
   | enum typeId { nameIR* } (from simpleEnumTypeIR) hint(print %0)
   | enum typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR) hint(print %0)
   | extern typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR) hint(print %0#"<"#%1#">")
   | parser typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR) hint(print %0#"<"#%1#">")
   | control typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR) hint(print %0#"<"#%1#">")
   | package typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR) hint(print %0#"<"#%1#">")
   | table typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR) hint(print %0)
   | default (from defaultTypeIR)
   | header_invalid (from invalidHeaderTypeIR)
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)
   | set < typeIR > (from setTypeIR)
   | table_enum typeId { nameIR* } (from tableMetadataEnumTypeIR) hint(print %0)
   | table_struct typeId { hit boolTypeIR ; miss boolTypeIR ; action_run tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR) hint(print %0)

