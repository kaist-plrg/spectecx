   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:56:1-57:24:
syntax prefixedNonTypeName = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:63:19-63:33:
syntax typeName = typeIdentifier

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:66:1-67:22:
syntax prefixedTypeName = 
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:74:1-76:36:
syntax tableCustomName = 
   | text (from identifier)
   | text (from typeIdentifier)
   | apply (from tableCustomName)
   | state (from tableCustomName)
   | type (from tableCustomName)
   | priority (from tableCustomName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:83:1-85:9:
syntax name = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:88:1-89:22:
syntax nameList = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)
   | nameList , name (from nameList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:91:1-92:32:
def $flatten_nameList(nameList) : name* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:93:1-93:35:
   clause 0(nameList) = [name]
      -- if nameList <: name
      -- let name = nameList as name

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:94:1-95:42:
   clause 1(nameList') = $flatten_nameList(nameList) ++ [name]
      -- if nameList' matches `% , %`
      -- let nameList , name = nameList'

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:97:17-97:21:
syntax member = name

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:103:20-103:45:
syntax direction = 
   |  (from direction)
   | in (from direction)
   | out (from direction)
   | inout (from direction)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:116:1-127:34:
syntax baseType = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:135:26-135:65:
syntax specializedType = 
   | prefixedTypeName < typeArgumentList > (from specializedType)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:138:1-139:20:
syntax namedType = 
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:147:20-147:41:
syntax arrayType = 
   | type [ expression ] (from arrayType)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:155:19-155:42:
syntax listType = 
   | list < typeArgument > (from listType)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:161:20-161:48:
syntax tupleType = 
   | tuple < typeArgumentList > (from tupleType)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:168:1-172:14:
syntax type = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)
   | type [ expression ] (from arrayType)
   | list < typeArgument > (from listType)
   | tuple < typeArgumentList > (from tupleType)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:175:1-177:15:
syntax typeOrVoid = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)
   | type [ expression ] (from arrayType)
   | list < typeArgument > (from listType)
   | tuple < typeArgumentList > (from tupleType)
   | void (from typeOrVoid)
   | text (from identifier)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:183:24-183:28:
syntax typeParameter = name

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:186:1-187:40:
syntax typeParameterList = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)
   | typeParameterList , typeParameter (from typeParameterList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:189:1-190:32:
def $flatten_typeParameterList(typeParameterList) : typeParameter* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:191:1-191:62:
   clause 0(typeParameterList) = [typeParameter]
      -- if typeParameterList <: typeParameter
      -- let typeParameter = typeParameterList as typeParameter

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:192:1-193:69:
   clause 1(typeParameterList') = $flatten_typeParameterList(typeParameterList) ++ [typeParameter]
      -- if typeParameterList' matches `% , %`
      -- let typeParameterList , typeParameter = typeParameterList'

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:196:1-197:28:
syntax typeParameterListOpt = 
   |  (from typeParameterListOpt)
   | < typeParameterList > (from typeParameterListOpt)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:199:1-200:32:
def $flatten_typeParameterListOpt(typeParameterListOpt) : typeParameter* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:201:1-201:48:
   clause 0(typeParameterListOpt) = []
      -- if typeParameterListOpt matches `_EMPTY`

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:202:1-203:50:
   clause 1(typeParameterListOpt) = $flatten_typeParameterList(typeParameterList)
      -- if typeParameterListOpt matches `<%>`
      -- let < typeParameterList > = typeParameterListOpt

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:212:3-212:52:
syntax parameter = 
   | annotationList direction type name initializerOpt (from parameter)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:215:1-216:40:
syntax nonEmptyParameterList = 
   | annotationList direction type name initializerOpt (from parameter)
   | nonEmptyParameterList , parameter (from nonEmptyParameterList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:219:1-220:26:
syntax parameterList = 
   |  (from parameterList)
   | annotationList direction type name initializerOpt (from parameter)
   | nonEmptyParameterList , parameter (from nonEmptyParameterList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:222:1-223:32:
def $flatten_parameterList(parameterList) : parameter* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:224:1-224:41:
   clause 0(parameterList) = []
      -- if parameterList matches `_EMPTY`

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:225:1-225:50:
   clause 1(parameterList) = [parameter]
      -- if parameterList <: parameter
      -- let parameter = parameterList as parameter

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:226:1-227:67:
   clause 2(parameterList) = $flatten_parameterList(nonEmptyParameterList as parameterList) ++ [parameter]
      -- if parameterList <: nonEmptyParameterList
      -- let nonEmptyParameterList' = parameterList as nonEmptyParameterList
      -- if nonEmptyParameterList' matches `% , %`
      -- let nonEmptyParameterList , parameter = nonEmptyParameterList'

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:233:31-233:40:
syntax constructorParameter = parameter

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:235:35-235:48:
syntax constructorParameterList = parameterList

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:238:1-239:24:
syntax constructorParameterListOpt = 
   |  (from constructorParameterListOpt)
