      -- let ?(typedLvalueIR_base) = typedLvalueIR?{typedLvalueIR <- typedLvalueIR?}

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:336:1-340:63:
   clause 5(expressionIR # ( typeIR _ctk )) = ?(( typedLvalueIR ) # ( typeIR ))
      -- if expressionIR <: parenthesizedExpressionIR
      -- let ( typedExpressionIR ) = expressionIR as parenthesizedExpressionIR
      -- let typedLvalueIR'?{typedLvalueIR' <- typedLvalueIR'?} = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
