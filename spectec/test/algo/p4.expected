;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:518:1-518:63:
def $callable_controlApplyMethod(cursor, typingContext) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:520:1-520:53:
   clause 0(cursor, TC) = false
      -- if cursor matches `GLOBAL`

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:521:1-521:52:
   clause 1(cursor, TC) = false
      -- if cursor matches `BLOCK`

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.4-typing-callable-call.spectec:522:1-524:34:
   clause 2(cursor, TC) = (localKind = control_apply_method as localKind)
      -- if cursor matches `LOCAL`
