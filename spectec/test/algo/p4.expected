   | annotationList abstract functionPrototype ; (from externMethodPrototype)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1080:1-1081:26:
syntax externConstructorOrMethodPrototype = 
   | annotationList typeIdentifier ( parameterList ) ; (from externConstructorPrototype)
