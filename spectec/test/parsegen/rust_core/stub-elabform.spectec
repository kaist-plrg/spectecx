;; STUB for the `rust check` test (Task 1.6, 2026-10-22). Not the real
;; ElabForm: Task 1.5 writes 06-core-calculus/spectec/static/05-elabform.spectec
;; later and will re-point the check test at it. Until then this stub stands in
;; for it, over the fixed grammar snapshot
;; ../../../testdata/parsegen/rust-core/syntax.spectec.
;;
;; ElabForm holds when every `let` directly in the body of a top-level fn has
;; a type annotation. Nested blocks and closures are not looked at.

relation ElabForm: |- program ELAB
  hint(input %0)
relation ItemElab: |- item ELAB
  hint(input %0)
relation StmtElab: |- stmt ELAB
  hint(input %0)

rule ElabForm:
  |- (_PROGRAM item*) ELAB
  -- (ItemElab: |- item ELAB)*

rule ItemElab/fn:
  |- (FN id generics? `( param* `) ret? whereclause? `{ stmt* expr? `}) ELAB
  -- (StmtElab: |- stmt ELAB)*

rule ItemElab/use:
  |- (USE path ';') ELAB

rule ItemElab/struct:
  |- (STRUCT id generics? `( typ* `) ';') ELAB

rule ItemElab/trait:
  |- (TRAIT id generics? supers? whereclause? `{ titem* `}) ELAB

rule ItemElab/impl:
  |- (IMPL generics? traitref FOR typ whereclause? `{ iitem* `}) ELAB

rule StmtElab/let:
  |- (LET pat tyannot '=' expr ';') ELAB

rule StmtElab/item:
  |- (_ITEM item) ELAB

rule StmtElab/expr:
  |- (_EXPR expr ';') ELAB
