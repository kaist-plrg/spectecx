     1                (Let annotationList_f type_f name_f ;*{annotationList_f <- annotati...
  ####                  (Type_ok: block TC_1 |- type_f as typeOrVoid : typeIR_f # typeId'...
  ####/####               If (typeId'*{typeId' <- typeId'*} matches [])*{typeId'* <- type...
     1                      (Let nameIR be $name(name))
  ####                        (Let nameIR_f be $name(name_f))*
  $ sed -n '/^relation Type_wf:/,/^relation/p' none.txt | grep -A5 'Case (% <: headerTypeIR):'
     1/####      Case (% <: headerTypeIR):
     1            (Let header _typeId < _typeArgumentIR*{_typeArgumentIR <- _typeArgument...
