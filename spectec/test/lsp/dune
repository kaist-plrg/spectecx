(executable
 (name main)
 (modules main)
 (libraries spectec.lsp spectec linol-eio yojson))

(executable
 (name e2e)
 (modules e2e)
 (libraries linol-eio yojson unix))

(rule
 (target main.actual)
 (deps
  (source_tree multifile)
  (source_tree ../../specs/impty/base))
 (action
  (with-stdout-to
   %{target}
   (run ./main.exe))))

(rule
 (alias runtest)
 (action
  (diff main.expected main.actual)))

(rule
 (target e2e.actual)
 (deps
  %{exe:../../bin/lsp_main.exe}
  (source_tree multifile)
  (source_tree unmarked)
  (source_tree overlapping))
 (action
  (with-stdout-to
   %{target}
   (run ./e2e.exe %{exe:../../bin/lsp_main.exe}))))

(rule
 (alias runtest)
 (action
  (diff e2e.expected e2e.actual)))

