 (name workspace)
 (modules workspace)
 (libraries spectec.lsp spectec)
 (deps
  (source_tree unmarked)
  (source_tree overlapping)))

(test
 (name convert)
 (modules convert)
 (libraries spectec.lsp spectec.common linol-eio))

(test
 (name publication)
 (modules publication)
 (libraries spectec.lsp)
