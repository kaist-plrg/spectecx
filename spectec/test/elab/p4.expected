   | if ( expression ) parserStatement else parserStatement (from parserConditionalStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1211:1-1216:31:
syntax parserStatement = 
   | ; (from emptyStatement)
