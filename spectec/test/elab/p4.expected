   ;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:535:1-536:9:
   clause 0(extern_function "static_assert" ( _parameterIR*{} ) : _typeIR as callableTypeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:537:1-538:15:
   clause 1(_callableTypeIR) = false
      -- otherwise

