def $compat_switch(typeIR) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:802:1-802:33:
   clause 0(error as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:803:1-803:39:
   clause 1(int < _nat > as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:804:1-804:39:
   clause 2(bit < _nat > as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:805:1-805:62:
   clause 3(typedef _typeId typeIR as typeIR) = $compat_switch(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:806:1-806:38:
   clause 4(enumTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:807:1-808:15:
   clause 5(_typeIR) = false
      -- otherwise

