   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:243:1-247:61:
   clause 0(IC, callableId, constructorDef) = IC[global.constructor = constructorDefEnv]
      -- if (constructorDefEnv = $add_map<callableId, constructorDef>(IC.global.constructor, callableId, constructorDef))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:240:1-241:70:
def $add_constructorDefs_i(instContext, callableId*, constructorDef*) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:249:1-249:46:
   clause 0(IC, [], []) = IC

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:250:1-255:77:
   clause 1(IC, callableId_h :: callableId_t*{}, constructorDef_h :: constructorDef_t*{}) = IC''
      -- if (IC' = $add_constructorDef_i(IC, callableId_h, constructorDef_h))
      -- if (IC'' = $add_constructorDefs_i(IC', callableId_t*{}, constructorDef_t*{}))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:263:1-264:63:
def $find_var_i(prefixedNameIR, cursor, instContext) : value =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:266:1-267:58:
   clause 0(. id, p, IC) = value
      -- if (?(value) = $find_map<id, value>(IC.global.frame, id))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:268:1-269:58:
   clause 1(id, global, IC) = value
      -- if (?(value) = $find_map<id, value>(IC.global.frame, id))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:270:1-271:57:
   clause 2(id, block, IC) = value
      -- if (?(value) = $find_map<id, value>(IC.block.frame, id))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:272:1-274:55:
   clause 3(id, block, IC) = $find_var_i(id, global, IC)
      -- if (?() = $find_map<id, value>(IC.block.frame, id))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:275:1-276:59:
   clause 4(id, local, IC) = value
      -- if (?(value) = $find_maps<id, value>(IC.local.frames, id))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:277:1-279:57:
   clause 5(id, local, IC) = $find_var_i(id, block, IC)
      -- if (?() = $find_maps<id, value>(IC.local.frames, id))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:283:1-284:73:
def $find_typeDef_i(cursor, instContext, prefixedNameIR) : typeDefIR? =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:286:1-287:57:
   clause 0(_cursor, IC, nameIR) = $find_map<typeId, typeDefIR>(IC.global.type, nameIR)

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:288:1-289:57:
   clause 1(_cursor, IC, . nameIR) = $find_map<typeId, typeDefIR>(IC.global.type, nameIR)

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:293:1-295:80:
def $find_constructorDef_i(instContext, prefixedNameIR, argumentIR*) : callResolution<constructorDef>? =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:297:1-302:60:
   clause 0(IC, nameIR, argumentIR*{}) = $find_overloaded<constructorDef>(IC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:303:1-308:60:
   clause 1(IC, . nameIR, argumentIR*{}) = $find_overloaded<constructorDef>(IC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:314:1-315:86:
def $subst_type_i(cursor, instContext, typeIR) : typeIR =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:317:1-317:47:
   clause 0(global, IC, typeIR) = typeIR

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:318:1-320:52:
   clause 1(block, IC, typeIR) = typeIR_subst
      -- if (theta = IC.block.type)
      -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:321:1-325:52:
   clause 2(local, IC, typeIR) = typeIR_subst
      -- if (theta_block = IC.block.type)
      -- if (theta_local = IC.local.type)
      -- if (theta = $extend_map<typeId, typeIR>(theta_block, theta_local))
      -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

;; ../../../../../spectec/specs/p4/7-instantiation/7.03-inst-relation.spectec:5:1-10:38:
relation Expr_inst: cursor instContext store |- typedExpressionIR : store value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:17:1-20:66:
   rule booleanLiteral: p IC STO |- booleanLiteral as expressionIR # _expressionNoteIR : STO boolValue as value
      -- if (boolValue = $ite<boolValue>((booleanLiteral = true), true, false))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:22:1-23:56:
   rule integerLiteral: p IC STO |- integerLiteral as expressionIR # _expressionNoteIR : STO integerLiteral as value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:25:1-26:54:
   rule stringLiteral: p IC STO |- stringLiteral as expressionIR # _expressionNoteIR : STO stringLiteral as value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:32:1-34:51:
   rule referenceExpressionIR: p IC STO |- prefixedNameIR as expressionIR # _expressionNoteIR : STO value
      -- if (value = $find_var_i(prefixedNameIR, p, IC))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:38:1-39:40:
   rule defaultExpressionIR: p IC STO |- ... as expressionIR # _expressionNoteIR : STO default as value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:44:1-46:62:
   rule unaryExpressionIR: p IC STO_0 |- unop typedExpressionIR as expressionIR # _expressionNoteIR : STO_1 $un_op(unop, value)
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:53:1-58:66:
   rule non-short-circuit: p IC STO_0 |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_2 $bin_op(binop, value_l, value_r)
      -- if ~binop <- [&&, ||]
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 value_l
      -- rel Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:60:1-63:69:
   rule land-false: p IC STO_0 |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_1 false as value
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 false as value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:65:1-69:66:
   rule land-true: p IC STO_0 |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_2 value_r
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 true as value
      -- rel Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:71:1-74:68:
   rule lor-true: p IC STO_0 |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_1 true as value
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 true as value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:76:1-80:66:
   rule lor-false: p IC STO_0 |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR : STO_2 value_r
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR_l : STO_1 false as value
      -- rel Expr_inst: p IC STO_1 |- typedExpressionIR_r : STO_2 value_r

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:88:1-93:72:
   rule true: p IC STO_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : STO_2 value_true
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 true as value
      -- rel Expr_inst: p IC STO_1 |- typedExpressionIR_true : STO_2 value_true

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:95:1-100:74:
   rule false: p IC STO_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : STO_2 value_false
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR_cond : STO_1 false as value
      -- rel Expr_inst: p IC STO_1 |- typedExpressionIR_false : STO_2 value_false

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:106:1-109:45:
   rule castExpressionIR: p IC STO_0 |- ( typeIR ) typedExpressionIR as expressionIR # _expressionNoteIR : STO_1 value_cast
      -- rel Expr_inst: p IC STO_0 |- typedExpressionIR : STO_1 value
      -- if (value_cast = $cast_op(typeIR, value))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:117:1-118:38:
   rule invalidHeaderExpressionIR: p IC STO |- {#} as expressionIR # _expressionNoteIR : STO {#} as value

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:126:1-129:68:
   rule non-default: p IC STO_0 |- seq { typedExpressionListIR } as expressionIR # _expressionNoteIR : STO_1 seq ( value*{} ) as value
      -- rel Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{}

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:131:1-134:68:
   rule default: p IC STO_0 |- seq { typedExpressionListIR , ... } as expressionIR # _expressionNoteIR : STO_1 seq ( value*{} , ... ) as value
      -- rel Exprs_inst: p IC STO_0 |- typedExpressionListIR : STO_1 value*{}

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:143:1-146:65:
   rule non-default: p IC STO_0 |- record { nameIR = typedExpressionIR*{} } as expressionIR # _expressionNoteIR : STO_1 record { value nameIR ;*{} } as value
      -- rel Exprs_inst: p IC STO_0 |- typedExpressionIR*{} : STO_1 value*{}

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:148:1-151:65:
   rule default: p IC STO_0 |- record { nameIR = typedExpressionIR*{} , ... } as expressionIR # _expressionNoteIR : STO_1 record { value nameIR ;*{} , ... } as value
      -- rel Exprs_inst: p IC STO_0 |- typedExpressionIR*{} : STO_1 value*{}

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:160:1-163:61:
   rule errorAccessExpressionIR: p IC STO |- error . nameIR as expressionIR # _expressionNoteIR : STO value_error
      -- if (nameIR_error = "error." ++ nameIR)
      -- if (value_error = $find_var_i(nameIR_error, p, IC))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:172:1-177:58:
   rule enum: p IC STO |- type prefixedNameIR . nameIR as expressionIR # _expressionNoteIR : STO typeId . nameIR as value
      -- if (?(typeDefIR_base) = $find_typeDef_i(p, IC, prefixedNameIR))
      -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base))
      -- if (enum typeId { _nameIR*{} } as typeIR = $unroll_typeIR(typeIR_base))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:179:1-186:75:
   rule serenum: p IC STO |- type prefixedNameIR . nameIR as expressionIR # _expressionNoteIR : STO typeId . nameIR . value as value
      -- if (?(typeDefIR_base) = $find_typeDef_i(p, IC, prefixedNameIR))
      -- if (typeIR_base = $typeIR_of_typeDefIR(typeDefIR_base))
      -- if (enum typeId < _typeIR > { id_member = value_member ;*{} } as typeIR = $unroll_typeIR(typeIR_base))
      -- if (?(value) = $assoc_<nameIR, value>(nameIR, (id_member, value_member)*{}))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.04-inst-expression.spectec:192:1-197:24:
