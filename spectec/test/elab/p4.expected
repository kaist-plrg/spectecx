   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1099:1-1102:42:
   clause 0(externConstructorOrMethodPrototype) = ~$is_externConstructorPrototype(externConstructorOrMethodPrototype)

