;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:6:1-11:21:
relation ExternFunctionCall_eval_lctk: typingContext |- nameIR ( nameIR* ) ~> value

;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:13:1-18:21:
relation Expr_eval_lctk: cursor typingContext |- typedExpressionIR ~> value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:17:1-20:66:
   rule booleanLiteral: p TC |- booleanLiteral as expressionIR # _expressionNoteIR ~> boolValue as value
      -- if (boolValue = $ite<boolValue>((booleanLiteral = true), true, false))

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:22:1-23:49:
   rule integerLiteral: p TC |- integerLiteral as expressionIR # _expressionNoteIR ~> integerLiteral as value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:25:1-26:47:
   rule stringLiteral: p TC |- stringLiteral as expressionIR # _expressionNoteIR ~> stringLiteral as value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:32:1-34:57:
   rule referenceExpressionIR: p TC |- prefixedNameIR as expressionIR # _expressionNoteIR ~> value
      -- if (value = $find_var_value_t(prefixedNameIR, p, TC))

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:39:1-40:33:
   rule defaultExpressionIR: p TC |- ... as expressionIR # _expressionNoteIR ~> default as value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:45:1-47:56:
   rule unaryExpressionIR: p TC |- unop typedExpressionIR as expressionIR # _expressionNoteIR ~> $un_op(unop, value)
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR ~> value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:54:1-59:60:
   rule non-short-circuit: p TC |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR # _expressionNoteIR ~> $bin_op(binop, value_l, value_r)
      -- if ~binop <- [&&, ||]
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_l ~> value_l
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:61:1-64:63:
   rule land-false: p TC |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR ~> false as value
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_l ~> false as value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:66:1-70:60:
   rule land-true: p TC |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR ~> value_r
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_l ~> true as value
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:72:1-75:62:
   rule lor-true: p TC |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR ~> true as value
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_l ~> true as value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:77:1-81:60:
   rule lor-false: p TC |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR ~> value_r
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_l ~> false as value
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_r ~> value_r

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:88:1-93:66:
   rule true: p TC |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR ~> value_true
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> true as value
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_true ~> value_true

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:95:1-100:68:
   rule false: p TC |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR ~> value_false
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_cond ~> false as value
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR_false ~> value_false

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:106:1-109:45:
   rule castExpressionIR: p TC |- ( typeIR ) typedExpressionIR as expressionIR # _expressionNoteIR ~> value_cast
      -- rel Expr_eval_lctk: p TC |- typedExpressionIR ~> value
      -- if (value_cast = $cast_op(typeIR, value))

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:117:1-118:31:
   rule invalidHeaderExpressionIR: p TC |- {#} as expressionIR # _expressionNoteIR ~> {#} as value

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:126:1-128:59:
   rule non-default: p TC |- seq { typedExpressionIR*{} } as expressionIR # _expressionNoteIR ~> seq ( value*{} ) as value
      -- (rel Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:130:1-132:59:
   rule default: p TC |- seq { typedExpressionIR*{} , ... } as expressionIR # _expressionNoteIR ~> seq ( value*{} , ... ) as value
      -- (rel Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:141:1-144:59:
   rule non-default: p TC |- record { nameIR = typedExpressionIR*{} } as expressionIR # _expressionNoteIR ~> record { value nameIR ;*{} } as value
      -- (rel Expr_eval_lctk: p TC |- typedExpressionIR ~> value)*

   ;; ../../../../../spectec/specs/p4/5-typing/5.06.2-typing-expression-eval.spectec:146:1-149:59:
