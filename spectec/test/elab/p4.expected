;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1457:1-1459:35:
syntax annotationBody = 
   |  (from annotationBody)
   | annotationBody ( annotationBody ) (from annotationBody)
   | annotationBody annotationToken (from annotationBody)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1462:3-1462:53:
syntax structuredAnnotationBody = 
   | sequenceOrRecordElementExpression trailingCommaOpt (from structuredAnnotationBody)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1465:1-1472:32:
syntax annotation = 
   | @ name (from annotation) hint(print "@"#%0)
   | @ name ( annotationBody ) (from annotation) hint(print "@"#%0#"("#%1#")")
   | @ name [ structuredAnnotationBody ] (from annotation) hint(print "@"#%0#"["#%1#"]")
   | @ pragma name annotationBody (from annotation) hint(print "@pragma" %0 %1)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1475:1-1476:38:
syntax annotationListNonEmpty = 
   | @ name (from annotation) hint(print "@"#%0)
   | @ name ( annotationBody ) (from annotation) hint(print "@"#%0#"("#%1#")")
   | @ name [ structuredAnnotationBody ] (from annotation) hint(print "@"#%0#"["#%1#"]")
   | @ pragma name annotationBody (from annotation) hint(print "@pragma" %0 %1)
   | annotationListNonEmpty annotation (from annotationListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1479:1-1480:27:
syntax annotationList = 
   |  (from annotationList)
   | @ name (from annotation) hint(print "@"#%0)
   | @ name ( annotationBody ) (from annotation) hint(print "@"#%0#"("#%1#")")
   | @ name [ structuredAnnotationBody ] (from annotation) hint(print "@"#%0#"["#%1#"]")
   | @ pragma name annotationBody (from annotation) hint(print "@pragma" %0 %1)
   | annotationListNonEmpty annotation (from annotationListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1482:1-1483:32:
def $flatten_annotationList(annotationList) : annotation* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1484:1-1484:42:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1485:1-1485:53:
   clause 1(annotation as annotationList) = [annotation]

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1486:1-1487:70:
   clause 2(annotationListNonEmpty annotation as annotationList) = $flatten_annotationList(annotationListNonEmpty as annotationList) ++ [annotation]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1494:1-1496:18:
syntax p4program = 
   |  (from p4program)
   | p4program declaration (from p4program)
   | p4program ; (from p4program)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1498:1-1499:50:
def $flatten_p4program(p4program) : declaration* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1500:1-1500:37:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1501:1-1502:53:
   clause 1(p4program declaration) = $flatten_p4program(p4program) ++ [declaration]

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1503:1-1504:34:
   clause 2(p4program ;) = $flatten_p4program(p4program)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:5:17-5:39:
syntax cursor = 
