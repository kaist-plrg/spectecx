   ;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:526:1-527:9:
   clause 0(extern_function "static_assert" ( _parameterIR*{} ) : _typeIR as callableTypeIR) = lctk

   ;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:528:1-528:62:
   clause 1(builtinSizeMethodTypeIR as callableTypeIR) = lctk

   ;; ../../../../../spectec/specs/p4/5-typing/5.04-typing-relation.spectec:529:1-530:15:
   clause 2(_callableTypeIR) = dyn
      -- otherwise

