;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:222:1-223:32:
def $flatten_parameterList(parameterList) : parameter* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:224:1-224:41:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:225:1-225:50:
