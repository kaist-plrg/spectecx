builtin dec $adds_map<K, V>(map<K, V>, K*, V*) : map<K, V>

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:279:1-280:73:
builtin dec $update_map<K, V>(map<K, V>, K, V) : map<K, V>

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:282:1-282:56:
def $extend_map<K, V>(map<K, V>, map<K, V>) : map<K, V> =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:283:1-286:58:
   clause 0({ K_a : V_a*{} }, { K_b : V_b*{} }) = { K_c : V_c*{} }
      -- if ({ K_c : V_c*{} } = $adds_map<K, V>({ K_a : V_a*{} }, K_b*{}, V_b*{}))

;; ../../../../../spectec/specs/p4/0-aux/0.2-example.spectec:1:1-2:29:
def $modulo(nat, nat) : nat? =

   ;; ../../../../../spectec/specs/p4/0-aux/0.2-example.spectec:4:1-5:18:
   clause 0(n_a, n_b) = ?((n_a \ n_b))
      -- if (n_b =/= 0)

   ;; ../../../../../spectec/specs/p4/0-aux/0.2-example.spectec:6:1-7:16:
   clause 1(n_a, n_b) = ?()
      -- if (n_b = 0)

;; ../../../../../spectec/specs/p4/0-aux/0.2-example.spectec:9:1-10:36:
def $modulo_42(nat) : nat =

   ;; ../../../../../spectec/specs/p4/0-aux/0.2-example.spectec:12:1-13:34:
   clause 0(n) = n_result
      -- if (?(n_result) = $modulo(n, 42))

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:6:1-7:8:
syntax trailingCommaOpt = 
   |  (from trailingCommaOpt)
   | , (from trailingCommaOpt)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:14:1-15:10:
syntax booleanLiteral = 
   | true (from booleanLiteral)
   | false (from booleanLiteral)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:22:1-24:35:
syntax integerLiteral = 
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:30:24-30:58:
syntax stringLiteral = 
   | " text " (from stringLiteral) hint(print "#%#")

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:43:21-43:29:
syntax identifier = 
   | text (from identifier)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:44:25-44:34:
syntax typeIdentifier = 
   | text (from typeIdentifier)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:51:1-53:30:
syntax nonTypeName = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:56:1-57:24:
syntax prefixedNonTypeName = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:63:19-63:33:
syntax typeName = typeIdentifier

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:66:1-67:22:
syntax prefixedTypeName = 
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:74:1-76:36:
syntax tableCustomName = 
   | text (from identifier)
   | text (from typeIdentifier)
   | apply (from tableCustomName)
   | state (from tableCustomName)
   | type (from tableCustomName)
   | priority (from tableCustomName)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:83:1-85:9:
syntax name = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:88:1-89:22:
syntax nameList = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)
   | nameList , name (from nameList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:91:1-92:32:
def $flatten_nameList(nameList) : name* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:93:1-93:35:
   clause 0(name as nameList) = [name]

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:94:1-95:42:
   clause 1(nameList , name) = $flatten_nameList(nameList) ++ [name]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:97:17-97:21:
syntax member = name

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:103:20-103:45:
