;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:18:1-19:43:
def $ite<X>(bool, X, X) : X =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:20:1-20:34:
   clause 0(true, X_t, X_f) = X_t

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:21:1-21:35:
   clause 1(false, X_t, X_f) = X_f

