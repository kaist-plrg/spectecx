;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:5:1-7:43:
def $match_keysets(setValue*, value*) : bool =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:10:1-10:36:
   clause 0([], []) = true

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:11:1-11:55:
   clause 1([set { ... }], value_key*{}) = true

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:12:1-13:37:
   clause 2([setValue], [value_key]) = $match_keyset(setValue, value_key)
      -- if (setValue =/= set { ... })

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:14:1-18:47:
   clause 3(setValue_h :: setValue_t*{}, value_key_h :: value_key_t*{}) = $match_keysets(setValue_t*{}, value_key_t*{})
      -- if (setValue_t*{} =/= [])
      -- if (value_key_t*{} =/= [])
      -- if $match_keyset(setValue_h, value_key_h)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:19:1-23:48:
   clause 4(setValue_h :: setValue_t*{}, value_key_h :: value_key_t*{}) = false
      -- if (setValue_t*{} =/= [])
      -- if (value_key_t*{} =/= [])
      -- if ~$match_keyset(setValue_h, value_key_h)

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:8:1-8:42:
def $match_keyset(setValue, value) : bool =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:25:1-25:53:
   clause 0(set { ... }, value_key) = true

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:26:1-26:74:
   clause 1(set { value }, value_key) = $bin_eq(value, value_key)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:27:1-28:41:
   clause 2(set { value*{} ( _nat ) }, value_key) = $exists_($bin_eq(value, value_key)*{})

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:29:1-32:40:
   clause 3(set { value_base &&& value_mask }, value_key) = $bin_eq($bin_band(value_base, value_mask), $bin_band(value_key, value_mask))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:33:1-35:39:
   clause 4(set { value_base .. value_limit }, value_key) = ($bin_le(value_base, value_key) /\ $bin_le(value_key, value_limit))

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:44:1-45:16:
syntax simpleKeysetExpressionResult = 
   | setValue (from continueResult<setValue>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:47:1-52:62:
