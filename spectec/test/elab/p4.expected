      -- rel Expr_eval: local EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:89:1-97:51:
   rule left-cont-right-abort: EC_0 ARCH_0 |- typedExpressionIR_l &&& typedExpressionIR_r : EC_2 ARCH_2 abortResult as simpleKeysetExpressionResult
