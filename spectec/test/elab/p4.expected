   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:445:1-445:63:
   clause 2(bit < w_l > as typeIR, bit < w_r > as typeIR) = (w_l = w_r)

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:446:1-447:38:
   clause 3(typedef _typeId typeIR_l as typeIR, typeIR_r) = $compat_range(typeIR_l, typeIR_r)

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:448:1-450:37:
   clause 4(typeIR_l, typedef _typeId typeIR_r as typeIR) = $compat_range(typeIR_l, typeIR_r)
      -- if ~typeIR_l <: typedefTypeIR

   ;; ../../../../../spectec/specs/p4/5-typing/5.10-typing-statement.spectec:451:1-452:15:
   clause 5(_typeIR, _typeIR') = false
      -- otherwise

