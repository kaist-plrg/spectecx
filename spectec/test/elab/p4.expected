;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:116:1-127:34:
syntax baseType = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
