;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:98:1-99:48:
def $starts_with(text, text) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:100:1-102:37:
   clause 0(t, t_prefix) = true
      -- if (|t_prefix| <= |t|)
      -- if (t[0 : |t_prefix|] = t_prefix)

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:103:1-104:15:
   clause 1(t, t_prefix) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:106:1-107:46:
def $ends_with(text, text) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:108:1-111:43:
   clause 0(t, t_suffix) = true
      -- if (|t_suffix| <= |t|)
      -- if (n_start = (|t| - |t_suffix|))
      -- if (t[n_start : |t_suffix|] = t_suffix)

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:112:1-113:15:
   clause 1(t, t_suffix) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:115:1-116:85:
def $strip_prefix_rec(text, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:117:1-120:48:
   clause 0(t, t_prefix) = $strip_prefix_rec(t_stripped, t_prefix)
      -- if $starts_with(t, t_prefix)
      -- if (t_stripped = $strip_prefix(t, t_prefix))

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:121:1-122:35:
   clause 1(t, t_prefix) = t
      -- if ~$starts_with(t, t_prefix)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:124:1-125:85:
def $strip_suffix_rec(text, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:126:1-129:48:
   clause 0(t, t_suffix) = $strip_suffix_rec(t_stripped, t_suffix)
      -- if $ends_with(t, t_suffix)
      -- if (t_stripped = $strip_suffix(t, t_suffix))

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:130:1-131:33:
   clause 1(t, t_suffix) = t
      -- if ~$ends_with(t, t_suffix)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:133:1-134:45:
def $contains(text, text) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:136:1-136:51:
   clause 0(t, t_c) = $contains'(0, |t|, t, t_c)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:135:1-135:44:
def $contains'(nat, nat, text, text) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:137:1-137:45:
   clause 0(n_len, n_len, t, t_c) = false

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:138:1-140:19:
   clause 1(n, n_len, t, t_c) = true
      -- if (n < n_len)
      -- if (t[n] = t_c)

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:141:1-144:21:
   clause 2(n, n_len, t, t_c) = $contains'((n + 1), n_len, t, t_c)
      -- if (n < n_len)
      -- if (t[n] =/= t_c)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:150:1-150:28:
def $is_some_<X>(X?) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:151:1-151:30:
   clause 0(?()) = false

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:152:1-152:27:
   clause 1(?(X)) = true

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:154:1-154:29:
def $opt_as_seq_<X>(X?) : X* =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:155:1-155:31:
   clause 0(?()) = []

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:156:1-156:31:
   clause 1(?(X)) = [X]

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:162:1-164:43:
def $exists_(bool*) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:165:1-165:26:
   clause 0([]) = false

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:166:1-166:50:
   clause 1(b_h :: b_t*{}) = (b_h \/ $exists_(b_t*{}))

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:168:1-170:44:
def $forall_(bool*) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:171:1-171:25:
   clause 0([]) = true

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:172:1-172:50:
   clause 1(b_h :: b_t*{}) = (b_h /\ $forall_(b_t*{}))

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:174:1-175:62:
def $init_(nat) : nat* =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:176:1-176:20:
   clause 0(0) = []

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:177:1-179:22:
   clause 1(n) = n' :: $init_(n')
      -- if (n =/= 0)
      -- if (n' = (n - 1))

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:181:1-182:47:
def $repeat_<X>(X, nat) : X* =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:183:1-183:28:
   clause 0(X, 0) = []

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:184:1-186:22:
   clause 1(X, n) = [X] ++ $repeat_<X>(X, n')
      -- if (n =/= 0)
      -- if (n' = (n - 1))

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:188:1-189:38:
builtin dec $rev_<X>(X*) : X*

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:191:1-191:36:
builtin dec $concat_<X>(X**) : X*

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:193:1-193:47:
builtin dec $partition_<X>(X*, nat) : (X*, X*)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:195:1-196:37:
def $filter_<X>(X*, bool*) : X* =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:197:1-197:32:
   clause 0([], []) = []

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:198:1-200:12:
   clause 1(X_h :: X_t*{}, b_h :: b_t*{}) = X_h :: $filter_<X>(X_t*{}, b_t*{})
      -- if b_h

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:201:1-203:13:
   clause 2(X_h :: X_t*{}, b_h :: b_t*{}) = $filter_<X>(X_t*{}, b_t*{})
      -- if ~b_h

