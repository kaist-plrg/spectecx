;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:5:1-5:51:
def $chain_casts(typeIR*, typeIR**) : typeIR** =

   ;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:7:1-8:49:
   clause 0(typeIR_cur*{}, typeIR_chain*{}*{}) = []
      -- if ([] = $concat_<typeIR>(typeIR_chain*{}*{}))

   ;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:9:1-13:51:
   clause 1(typeIR_cur*{}, typeIR_chain*{}*{}) = typeIR_next*{} :: $chain_casts(typeIR_next*{}, typeIR_chain_rest*{}*{})
      -- if ([] =/= $concat_<typeIR>(typeIR_chain*{}*{}))
      -- (if ((typeIR_next, typeIR_chain_rest*{}) = $chain_casts'(typeIR_cur, typeIR_chain*{})))*

;; ../../../../../spectec/specs/p4/5-typing/5.05.2-typing-casting.spectec:6:1-6:55:
