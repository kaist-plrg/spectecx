   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:25:1-25:115:
   clause 6(enum _typeId < typeIR > { _valueFieldIR*{} } as typeIR) = $compat_table_lpm_ternary_range_key(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:26:1-27:15:
