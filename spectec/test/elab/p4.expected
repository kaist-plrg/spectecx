def $empty_typingContext : typingContext =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:83:1-103:35:
   clause 0 = TC
      -- if (globalTypingLayer = {constructor $empty_constructorTypeDefEnv, type $empty_typeDefEnv, callable $empty_callableTypeDefEnv, frame $empty_typeFrame})
      -- if (blockTypingLayer = {kind , type $empty_typeDefEnv, callable $empty_callableTypeDefEnv, frame $empty_typeFrame})
      -- if (localTypingLayer = {kind , type $empty_typeDefEnv, frames [$empty_typeFrame]})
      -- if (TC = {control cont, loop out, global globalTypingLayer, block blockTypingLayer, local localTypingLayer})

;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:109:1-110:66:
def $bound(cursor, typingContext) : bound =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:112:1-112:35:
   clause 0(global, TC) = { [] }

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:113:1-113:67:
   clause 1(block, TC) = $dom_map<typeId, typeDefIR>(TC.block.type)

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:114:1-116:61:
   clause 2(local, TC) = $union_set<typeId>(B_block, B_local)
      -- if (B_block = $bound(block, TC))
      -- if (B_local = $dom_map<typeId, typeDefIR>(TC.local.type))

;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:122:1-123:45:
def $enter_t(typingContext) : typingContext =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:124:1-125:62:
   clause 0(TC) = TC[local.frames = $empty_typeFrame :: TC.local.frames]

;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:127:1-128:55:
def $exit_t(typingContext) : typingContext =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:129:1-130:54:
