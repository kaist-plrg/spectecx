def $empty_map<K, V> : map<K, V> =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:257:1-257:33:
   clause 0 = { [] }

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:259:1-260:44:
def $dom_map<K, V>(map<K, V>) : set<K> =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:261:1-261:48:
   clause 0({ K : V*{} }) = { K*{} }

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:263:1-264:46:
def $codom_map<K, V>(map<K, V>) : set<V> =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:265:1-265:50:
   clause 0({ K : V*{} }) = { V*{} }

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:267:1-268:47:
builtin dec $find_map<K, V>(map<K, V>, K) : V?

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:270:1-271:48:
builtin dec $find_maps<K, V>(map<K, V>*, K) : V?

