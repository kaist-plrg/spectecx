def $compat_table_exact_optional_key(typeIR) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:8:1-8:50:
   clause 0(bool as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:9:1-9:51:
   clause 1(error as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:10:1-10:59:
   clause 2(integerTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:11:1-11:98:
   clause 3(typedef _typeId typeIR as typeIR) = $compat_table_exact_optional_key(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:12:1-12:95:
   clause 4(type _typeId typeIR as typeIR) = $compat_table_exact_optional_key(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:13:1-13:60:
   clause 5(enum _typeId { _nameIR*{} } as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:14:1-14:109:
   clause 6(enum _typeId < typeIR > { _valueFieldIR*{} } as typeIR) = $compat_table_exact_optional_key(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:15:1-16:15:
   clause 7(_typeIR) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:18:1-18:55:
def $compat_table_lpm_ternary_range_key(typeIR) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:19:1-19:53:
