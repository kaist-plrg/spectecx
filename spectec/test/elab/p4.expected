;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:17:1-21:56:
relation ExternMethodType_alpha: externMethodTypeIR ~~ externMethodTypeIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:178:1-182:38:
   rule non-abstract: extern_method nameIR ( parameterIR_a*{} ) : typeIR_a ~~ extern_method nameIR ( parameterIR_b*{} ) : typeIR_b
