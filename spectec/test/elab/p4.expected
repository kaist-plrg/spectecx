      -- if (?(callableId : callableDef # id_default*{} # id_optional*{}) = $find_overloaded<callableDef>(EC.global.callable, callTargetKey, $parameterListIR_of_callableDef))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:203:1-210:47:
   clause 1(global, EC, nameIR, argumentIR*{}) = ?()
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))
      -- if (?() = $find_overloaded<callableDef>(EC.global.callable, callTargetKey, $parameterListIR_of_callableDef))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:211:1-218:47:
   clause 2(global, EC, . nameIR, argumentIR*{}) = ?(callableId : (global, callableDef) # id_default*{} # id_optional*{})
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))
      -- if (?(callableId : callableDef # id_default*{} # id_optional*{}) = $find_overloaded<callableDef>(EC.global.callable, callTargetKey, $parameterListIR_of_callableDef))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:219:1-226:47:
   clause 3(global, EC, . nameIR, argumentIR*{}) = ?()
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))
      -- if (?() = $find_overloaded<callableDef>(EC.global.callable, callTargetKey, $parameterListIR_of_callableDef))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:227:1-234:47:
   clause 4(block, EC, nameIR, argumentIR*{}) = ?(callableId : (block, callableDef) # id_default*{} # id_optional*{})
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))
      -- if (?(callableId : callableDef # id_default*{} # id_optional*{}) = $find_overloaded<callableDef>(EC.block.callable, callTargetKey, $parameterListIR_of_callableDef))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:235:1-242:47:
   clause 5(block, EC, nameIR, argumentIR*{}) = $find_callableDef_overloaded_e(global, EC, nameIR, argumentIR*{})
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))
      -- if (?() = $find_overloaded<callableDef>(EC.block.callable, callTargetKey, $parameterListIR_of_callableDef))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:243:1-244:73:
   clause 6(local, EC, nameIR, argumentIR*{}) = $find_callableDef_overloaded_e(block, EC, nameIR, argumentIR*{})

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:245:1-246:72:
   clause 7(block, EC, . nameIR, argumentIR*{}) = $find_callableDef_overloaded_e(global, EC, . nameIR, argumentIR*{})

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:247:1-248:72:
   clause 8(local, EC, . nameIR, argumentIR*{}) = $find_callableDef_overloaded_e(global, EC, . nameIR, argumentIR*{})

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:252:1-253:36:
def $find_constructorDef_e(evalContext, prefixedNameIR, argumentIR*) : callResolution<constructorDef>? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:255:1-260:60:
   clause 0(EC, nameIR, argumentIR*{}) = $find_overloaded<constructorDef>(EC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:261:1-266:60:
   clause 1(EC, . nameIR, argumentIR*{}) = $find_overloaded<constructorDef>(EC.global.constructor, callTargetKey, $parameterListIR_of_constructorDef)
      -- if (callTargetKey = $callTargetKey(nameIR, argumentIR*{}))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:270:1-271:50:
def $find_parserState_e(evalContext, nameIR) : parserStateIR? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:273:1-274:61:
   clause 0(EC, nameIR) = $find_map<nameIR, parserStateIR>(EC.block.state, nameIR)

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:280:1-281:86:
def $subst_type_e(cursor, evalContext, typeIR) : typeIR =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:283:1-283:47:
   clause 0(global, EC, typeIR) = typeIR

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:284:1-286:52:
   clause 1(block, EC, typeIR) = typeIR_subst
      -- if (theta = EC.block.type)
      -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:287:1-291:52:
   clause 2(local, EC, typeIR) = typeIR_subst
      -- if (theta_block = EC.block.type)
      -- if (theta_local = EC.local.type)
      -- if (theta = $extend_map<typeId, typeIR>(theta_block, theta_local))
      -- if (typeIR_subst = $subst_typeIR(theta, typeIR))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:5:1-5:24:
opaque syntax archState

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:6:1-6:40:
builtin dec $init_archState : archState

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:9:3-10:18:
syntax arch = {state archState, store store}

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:18:1-18:49:
def $add_object_e(arch, objectId, object) : arch =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:20:1-23:65:
   clause 0(ARCH, objectId, object) = ARCH[store = STO]
      -- if (STO = $add_map<objectId, object>(ARCH.store, objectId, object))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:29:1-29:40:
def $find_archState_e(arch) : archState =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:30:1-30:41:
   clause 0(ARCH) = ARCH.state

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:32:1-33:41:
def $find_object_e(arch, objectId) : object? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:34:1-35:54:
   clause 0(ARCH, objectId) = $find_map<objectId, object>(ARCH.store, objectId)

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:37:1-37:55:
def $find_object_qualified_e(arch, objectId) : object? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:38:1-39:35:
   clause 0(ARCH, objectId) = $find_object_e(ARCH, objectId)

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:41:1-41:51:
def $find_object_unqualified_e(arch, id) : object? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:42:1-47:62:
   clause 0(ARCH, id) = ?(object_id_found)
      -- if ({ objectId : object*{} } = ARCH.store)
      -- (if (object_id?{} = $ite<object?>($objectId_ends_with(objectId, id), ?(object), ?())))*
      -- if ([?(object_id_found)] = $filter_<object?>(object_id?{}*{}, (object_id?{} =/= ?())*{}))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:48:1-49:15:
   clause 1(ARCH, id) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:51:1-51:55:
def $find_objectState_e(arch, objectId) : objectState? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:53:1-55:62:
   clause 0(ARCH, objectId) = ?(objectState)
      -- if (?(externObject as object) = $find_object_e(ARCH, objectId))
      -- if (extern _typeId < _theta > { objectState _frame _externMethodDefEnv } = externObject)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:56:1-57:15:
   clause 1(ARCH, objectId) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:63:1-63:48:
def $update_archState_e(arch, archState) : arch =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:64:1-64:70:
   clause 0(ARCH, archState) = ARCH[state = archState]

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:66:1-66:62:
def $update_object_qualified_e(arch, objectId, object) : arch =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:68:1-70:57:
   clause 0(ARCH_0, objectId, object) = ARCH_1
      -- if (?() =/= $find_object_qualified_e(ARCH_0, objectId))
      -- if (ARCH_1 = $add_object_e(ARCH_0, objectId, object))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:72:1-72:58:
def $update_object_unqualified_e(arch, id, object) : arch =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:74:1-80:63:
   clause 0(ARCH_0, id, object) = ARCH_1
      -- if ({ objectId : _object*{} } = ARCH_0.store)
      -- (if (objectId_id?{} = $ite<objectId?>($objectId_ends_with(objectId, id), ?(objectId), ?())))*
      -- if ([?(objectId_found)] = $filter_<objectId?>(objectId_id?{}*{}, (objectId_id?{} =/= ?())*{}))
      -- if (ARCH_1 = $add_object_e(ARCH_0, objectId_found, object))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:82:1-82:63:
def $update_objectState_e(arch, objectId, objectState) : arch? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:84:1-90:70:
   clause 0(ARCH_0, objectId, objectState) = ?(ARCH_1)
      -- if (?(externObject as object) = $find_object_e(ARCH_0, objectId))
      -- if (extern typeId < theta > { _objectState frame externMethodDefEnv } = externObject)
      -- if (externObject_update = extern typeId < theta > { objectState frame externMethodDefEnv })
      -- if (ARCH_1 = $add_object_e(ARCH_0, objectId, externObject_update as object))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.2-eval-arch.spectec:91:1-92:15:
   clause 1(ARCH, objectId, objectState) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:7:30-7:36:
syntax continueEmptyResult = 
   |  (from continueEmptyResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:8:28-8:35:
syntax continueResult<X> = 
   | X (from continueResult<X>)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:12:21-12:25:
syntax exitResult = 
   | exit (from exitResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:16:23-16:36:
syntax returnResult = 
   | return value? (from returnResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:20:33-20:39:
syntax acceptTransitionResult = 
   | accept (from acceptTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:21:33-21:50:
syntax rejectTransitionResult = 
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:22:32-22:40:
syntax stateTransitionResult = 
   | state id (from stateTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:25:1-26:27:
syntax abortResult = 
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:33:1-34:16:
syntax expressionResult = 
   | value (from continueResult<value>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:36:1-41:54:
relation Expr_eval: cursor evalContext arch |- typedExpressionIR : evalContext arch expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:17:1-22:43:
   rule booleanLiteral: p EC ARCH |- booleanLiteral as expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if (boolValue = $ite<boolValue>((booleanLiteral = true), true, false))
      -- if (expressionResult = boolValue as value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:24:1-27:48:
   rule integerLiteral: p EC ARCH |- integerLiteral as expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if (expressionResult = integerLiteral as value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:29:1-32:47:
   rule stringLiteral: p EC ARCH |- stringLiteral as expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if (expressionResult = stringLiteral as value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:38:1-42:39:
   rule referenceExpressionIR: p EC ARCH |- prefixedNameIR as expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if (value = $find_var_e(prefixedNameIR, p, EC))
      -- if (expressionResult = value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:46:1-49:41:
   rule defaultExpressionIR: p EC ARCH |- ... as expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if (expressionResult = default as value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:55:1-59:57:
   rule abort: p EC_0 ARCH_0 |- unop typedExpressionIR as expressionIR # _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:61:1-66:53:
   rule cont: p EC_0 ARCH_0 |- unop typedExpressionIR as expressionIR # _expressionNoteIR : EC_1 ARCH_1 expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 value as expressionResult
      -- if (expressionResult = $un_op(unop, value) as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:74:1-80:47:
   rule non-short-circuit-abort: p EC_0 ARCH_0 |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
      -- if ~binop <- [&&, ||]
      -- rel Exprs_eval: p EC_0 ARCH_0 |- [typedExpressionIR_l, typedExpressionIR_r] : EC_1 ARCH_1 abortResult as expressionListResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:82:1-89:66:
   rule non-short-circuit-cont: p EC_0 ARCH_0 |- typedExpressionIR_l binop typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_1 ARCH_1 expressionResult
      -- if ~binop <- [&&, ||]
      -- rel Exprs_eval: p EC_0 ARCH_0 |- [typedExpressionIR_l, typedExpressionIR_r] : EC_1 ARCH_1 [value_l, value_r] as expressionListResult
      -- if (expressionResult = $bin_op(binop, value_l, value_r) as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:91:1-95:57:
   rule land-abort: p EC_0 ARCH_0 |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:97:1-102:44:
   rule land-false: p EC_0 ARCH_0 |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_1 ARCH_1 expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 false as value as expressionResult
      -- if (expressionResult = false as value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:104:1-110:64:
   rule land-true: p EC_0 ARCH_0 |- typedExpressionIR_l && typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_2 ARCH_2 expressionResult_r
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 true as value as expressionResult
      -- rel Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:112:1-116:57:
   rule lor-abort: p EC_0 ARCH_0 |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:118:1-123:43:
   rule lor-true: p EC_0 ARCH_0 |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_1 ARCH_1 expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 true as value as expressionResult
      -- if (expressionResult = true as value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:125:1-131:64:
   rule lor-false: p EC_0 ARCH_0 |- typedExpressionIR_l || typedExpressionIR_r as expressionIR # _expressionNoteIR : EC_2 ARCH_2 expressionResult_r
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 false as value as expressionResult
      -- rel Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 expressionResult_r

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:139:1-144:57:
   rule cond-abort: p EC_0 ARCH_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:146:1-153:67:
   rule cond-true: p EC_0 ARCH_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : EC_2 ARCH_2 expressionResult_true
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 true as value as expressionResult
      -- rel Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_true : EC_2 ARCH_2 expressionResult_true

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:155:1-162:68:
   rule cond-false: p EC_0 ARCH_0 |- typedExpressionIR_cond ? typedExpressionIR_true : typedExpressionIR_false as expressionIR # _expressionNoteIR : EC_2 ARCH_2 expressionResult_false
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR_cond : EC_1 ARCH_1 false as value as expressionResult
      -- rel Expr_eval: p EC_1 ARCH_1 |- typedExpressionIR_false : EC_2 ARCH_2 expressionResult_false

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:169:1-173:57:
   rule abort: p EC_0 ARCH_0 |- ( typeIR ) typedExpressionIR as expressionIR # _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:175:1-180:45:
   rule cont: p EC_0 ARCH_0 |- ( typeIR ) typedExpressionIR as expressionIR # _expressionNoteIR : EC_1 ARCH_1 value_cast as expressionResult
      -- rel Expr_eval: p EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 value as expressionResult
      -- if (value_cast = $cast_op(typeIR, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:189:1-191:39:
   rule invalidHeaderExpressionIR: p EC ARCH |- {#} as expressionIR # _expressionNoteIR : EC ARCH expressionResult
      -- if (expressionResult = {#} as value as expressionResult)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.1-eval-expression.spectec:199:1-204:47:
   rule non-default-abort: p EC_0 ARCH_0 |- seq { typedExpressionListIR } as expressionIR # _expressionNoteIR : EC_1 ARCH_1 abortResult as expressionResult
