;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1083:1-1085:9:
def $is_externConstructorPrototype(externConstructorOrMethodPrototype) : bool =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1087:1-1089:9:
   clause 0(externConstructorPrototype as externConstructorOrMethodPrototype) = true

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1090:1-1093:15:
   clause 1(externConstructorOrMethodPrototype) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1095:1-1097:9:
