      -- rel Expr_eval: local EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 value_l as expressionResult
      -- rel Expr_eval: local EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 value_r as expressionResult
      -- if (setValue = set { value_l .. value_r })

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:145:1-149:35:
   rule default-any: EC ARCH |- simpleKeysetExpressionIR : EC ARCH setValue as simpleKeysetExpressionResult
      -- if ((simpleKeysetExpressionIR = default) \/ (simpleKeysetExpressionIR = _))
