;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:10:3-11:51:
syntax actionCallee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:18:3-19:51:
syntax definedFunctionCallee = 
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:22:3-23:68:
syntax externFunctionCallee = 
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:26:1-27:25:
syntax functionCallee = 
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:33:40-33:73:
syntax builtinIsValidMethodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:34:40-34:74:
syntax builtinSetValidMethodCallee = 
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:35:40-35:76:
syntax builtinSetInvalidMethodCallee = 
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:36:40-36:75:
syntax builtinPushFrontMethodCallee = 
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:37:40-37:74:
syntax builtinPopFrontMethodCallee = 
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:38:40-38:69:
syntax builtinSizeMethodCallee = 
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:41:1-46:28:
syntax builtinMethodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:49:3-51:48:
syntax externMethodCallee = 
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:54:3-55:72:
syntax parserApplyMethodCallee = 
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:58:3-59:95:
syntax controlApplyMethodCallee = 
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:62:3-62:63:
syntax tableApplyMethodCallee = 
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:65:1-69:27:
syntax methodCallee = 
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.3-callable-callee.spectec:71:17-71:61:
syntax callee = 
   | action cursor . nameIR ( parameterListIR # id* ) blockStatementIR (from actionCallee)
   | function nameIR < typeParameterListIR > ( parameterListIR # id* ) blockStatementIR (from definedFunctionCallee)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) (from externFunctionCallee)
   | builtin_is_valid storageReference (from builtinIsValidMethodCallee)
   | builtin_set_valid storageReference (from builtinSetValidMethodCallee)
   | builtin_set_invalid storageReference (from builtinSetInvalidMethodCallee)
   | builtin_push_front storageReference (from builtinPushFrontMethodCallee)
   | builtin_pop_front storageReference (from builtinPopFrontMethodCallee)
   | builtin_size_of nameIR typeIR (from builtinSizeMethodCallee)
   | extern_method objectId . nameIR < typeParameterListIR > ( parameterListIR # id* # id* ) { theta ; frame ; blockStatementIR? } (from externMethodCallee)
   | parser objectId . apply ( parameterListIR # id* ) { theta ; frame ; parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodCallee)
   | control objectId . apply ( parameterListIR # id* ) { theta ; frame ; controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodCallee)
   | table objectId . apply { frame ; tableObjectProperty } (from tableApplyMethodCallee)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:6:3-8:38:
syntax externObjectConstructorDef = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:11:3-15:28:
syntax parserObjectConstructorDef = 
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:18:3-22:30:
syntax controlObjectConstructorDef = 
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:25:3-26:37:
syntax packageObjectConstructorDef = 
   | package < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.1-constructor-def.spectec:29:1-32:32:
syntax constructorDef = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { externMethodPrototypeListIR } (from externObjectConstructorDef)
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserObjectConstructorDef)
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlObjectConstructorDef)
   | package < typeParameterListIR > ( constructorParameterListIR ) (from packageObjectConstructorDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:5:1-6:17:
def $parameterListIR_of_constructorDef(constructorDef) : parameterIR* =

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:8:1-10:31:
   clause 0(extern _nameIR < _typeParameterListIR > ( constructorParameterListIR ) { _externMethodPrototypeListIR } as constructorDef) = constructorParameterListIR

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:12:1-14:31:
   clause 1(parser < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _parserLocalDeclarationListIR _parserStateListIR } as constructorDef) = constructorParameterListIR

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:16:1-18:31:
   clause 2(control < _typeParameterListIR > ( _parameterListIR ) ( constructorParameterListIR ) { _controlLocalDeclarationListIR apply _controlBodyIR } as constructorDef) = constructorParameterListIR

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.3.2-constructor-def-aux.spectec:20:1-22:31:
   clause 3(package < _typeParameterListIR > ( constructorParameterListIR ) as constructorDef) = constructorParameterListIR

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:12:1-12:26:
opaque syntax objectState

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:13:29-13:61:
syntax externMethodDefEnv = map<callableId, externMethodDef>

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:15:1-16:77:
builtin dec $init_objectState(nameIR, typeIR*, id*, value*) : objectState

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:19:3-19:71:
syntax externObject = 
   | extern typeId < theta > { objectState frame externMethodDefEnv } (from externObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:29:3-32:19:
syntax parserObject = 
   | parser < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:42:23-42:49:
syntax actionDefEnv = map<callableId, actionDef>

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:45:3-49:24:
syntax controlObject = 
   | control < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:57:24-57:55:
syntax packageObject = 
   | package < theta > { frame } (from packageObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:65:3-69:37:
syntax tableObjectProperty = {keys tableKeysPropertyIR, actions tableActionsPropertyIR, default_action tableDefaultActionPropertyIR, entries tableEntriesPropertyIR, customs tableCustomPropertyIR*}

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:75:3-75:47:
syntax tableObject = 
   | table typeId { frame tableObjectProperty } (from tableObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:83:3-83:35:
syntax valueSetObject = 
   | value_set { value* ( nat ) } (from valueSetObject)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.4.1-object.spectec:86:1-91:19:
syntax object = 
   | extern typeId < theta > { objectState frame externMethodDefEnv } (from externObject)
   | parser < theta > ( parameterListIR ) { frame parserLocalDeclarationListIR stateEnv } (from parserObject)
   | control < theta > ( parameterListIR ) { frame controlLocalDeclarationListIR actionDefEnv controlBodyIR } (from controlObject)
   | package < theta > { frame } (from packageObject)
   | table typeId { frame tableObjectProperty } (from tableObject)
   | value_set { value* ( nat ) } (from valueSetObject)

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:6:16-6:30:
syntax frame = map<id, value>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:8:1-8:25:
def $empty_frame : frame =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:9:1-9:41:
   clause 0 = $empty_map<id, value>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:12:19-12:41:
syntax stateEnv = map<id, parserStateIR>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:14:1-14:33:
def $empty_stateEnv : stateEnv =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:15:1-15:54:
   clause 0 = $empty_map<id, parserStateIR>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:18:25-18:53:
syntax callableDefEnv = map<callableId, callableDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:20:1-20:45:
def $empty_callableDefEnv : callableDefEnv =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:21:1-21:66:
   clause 0 = $empty_map<callableId, callableDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:24:28-24:59:
syntax constructorDefEnv = map<callableId, constructorDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:26:1-26:51:
def $empty_constructorDefEnv : constructorDefEnv =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.01.1-dynamic-env.spectec:27:1-27:72:
   clause 0 = $empty_map<callableId, constructorDef>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:7:16-7:37:
syntax store = map<objectId, object>

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:11:1-12:34:
def $empty_store : store =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:13:1-14:45:
   clause 0 = store
      -- if (store = $empty_map<objectId, object>)

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:20:1-21:50:
def $add_store(store, objectId, object) : store =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:22:1-24:69:
   clause 0(store, objectId, object) = store'
      -- if (store' = $add_map<objectId, object>(store, objectId, object))

;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:30:1-31:41:
def $find_store(store, objectId) : object =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.01.2-dynamic-store.spectec:32:1-33:62:
   clause 0(store, objectId) = object
      -- if (?(object) = $find_map<objectId, object>(store, objectId))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:8:3-11:18:
syntax globalInstLayer = {constructor constructorDefEnv, type typeDefEnv, callable callableDefEnv, frame frame}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:16:3-19:18:
syntax blockInstLayer = {type theta, callable callableDefEnv, state stateEnv, frame frame}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:24:3-25:20:
syntax localInstLayer = {type theta, frames frame*}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:32:3-35:27:
syntax instContext = {path objectId, global globalInstLayer, block blockInstLayer, local localInstLayer}

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:43:1-44:50:
def $empty_instContext : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:46:1-64:33:
   clause 0 = IC
      -- if (globalInstLayer = {constructor $empty_constructorDefEnv, type $empty_typeDefEnv, callable $empty_callableDefEnv, frame $empty_frame})
      -- if (blockInstLayer = {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})
      -- if (localInstLayer = {type $empty_theta, frames [$empty_frame]})
      -- if (IC = {path [], global globalInstLayer, block blockInstLayer, local localInstLayer})

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:70:1-71:45:
def $enter_i(instContext) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:73:1-73:73:
   clause 0(IC) = IC[local.frames = $empty_frame :: IC.local.frames]

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:75:1-76:55:
def $exit_i(instContext) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:78:1-79:46:
   clause 0(IC) = IC[local.frames = frame_t*{}]
      -- if (IC.local.frames = frame_h :: frame_t*{})

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:85:1-86:50:
def $enter_path_i(instContext, id) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:88:1-88:56:
   clause 0(IC, id) = IC[path = IC.path ++ [id]]

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:94:1-95:78:
def $inherit_i(cursor, instContext) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:97:1-104:55:
   clause 0(global, IC) = IC[block = blockInstLayer][local = localInstLayer]
      -- if (blockInstLayer = {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})
      -- if (localInstLayer = {type $empty_theta, frames [$empty_frame]})

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:105:1-107:55:
   clause 1(block, IC) = IC[local = localInstLayer]
      -- if (localInstLayer = {type $empty_theta, frames [$empty_frame]})

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:108:1-108:31:
   clause 2(local, IC) = IC

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:116:1-117:68:
def $add_var_i(cursor, instContext, id, value) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:121:1-123:64:
   clause 0(global, IC, id, value) = IC[global.frame = frame]
      -- if ~$in_set<id>(id, $dom_map<id, value>(IC.global.frame))
      -- if (frame = $add_map<id, value>(IC.global.frame, id, value))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:124:1-126:63:
   clause 1(block, IC, id, value) = IC[block.frame = frame]
      -- if ~$in_set<id>(id, $dom_map<id, value>(IC.block.frame))
      -- if (frame = $add_map<id, value>(IC.block.frame, id, value))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:127:1-130:59:
   clause 2(local, IC, id, value) = IC[local.frames = frame_h' :: frame_t*{}]
      -- if (IC.local.frames = frame_h :: frame_t*{})
      -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
      -- if (frame_h' = $add_map<id, value>(frame_h, id, value))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:118:1-119:85:
def $add_vars_i(cursor, instContext, id*, value*) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:132:1-132:38:
   clause 0(p, IC, [], []) = IC

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:133:1-135:52:
   clause 1(p, IC, id_h :: id_t*{}, value_h :: value_t*{}) = IC''
      -- if (IC' = $add_var_i(p, IC, id_h, value_h))
      -- if (IC'' = $add_vars_i(p, IC', id_t*{}, value_t*{}))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:139:1-140:68:
def $add_typeDef_i(cursor, instContext, typeId, typeDefIR) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:142:1-145:71:
   clause 0(global, IC, typeId, typeDefIR) = IC[global.type = typeDefEnv]
      -- if (typeDefEnv = $add_map<typeId, typeDefIR>(IC.global.type, typeId, typeDefIR))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:149:1-150:50:
def $add_parserState_i(instContext, nameIR, parserStateIR) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:152:1-158:79:
   clause 0(IC, nameIR, parserStateIR) = IC[block.state = stateEnv]
      -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, parserStateIR>(IC.block.state))
      -- if (stateEnv = $add_map<nameIR, parserStateIR>(IC.block.state, nameIR, parserStateIR))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:162:1-162:67:
def $add_type_i(cursor, instContext, typeId, typeIR) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:165:1-166:72:
   clause 0(block, IC, typeId, typeIR) = IC[block.type = theta]
      -- if (theta = $add_map<typeId, typeIR>(IC.block.type, typeId, typeIR))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:167:1-168:72:
   clause 1(local, IC, typeId, typeIR) = IC[local.type = theta]
      -- if (theta = $add_map<typeId, typeIR>(IC.local.type, typeId, typeIR))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:163:1-163:70:
def $add_types_i(cursor, instContext, typeId*, typeIR*) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:170:1-170:39:
   clause 0(p, IC, [], []) = IC

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:171:1-173:53:
   clause 1(p, IC, typeId_h :: typeId_t*{}, typeIR_h :: typeIR_t*{}) = $add_types_i(p, IC', typeId_t*{}, typeIR_t*{})
      -- if (IC' = $add_type_i(p, IC, typeId_h, typeIR_h))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:177:1-179:94:
def $add_callableDef_overload_i(cursor, instContext, callableId, callableDef) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:181:1-185:87:
   clause 0(global, IC, callableId, callableDef) = IC[global.callable = callableDefEnv]
      -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.global.callable))
      -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.global.callable, callableId, callableDef))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:186:1-190:84:
   clause 1(block, IC, callableId, callableDef) = IC[block.callable = callableDefEnv]
      -- if ~$in_set<callableId>(callableId, $dom_map<callableId, callableDef>(IC.block.callable))
      -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.block.callable, callableId, callableDef))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:192:1-194:97:
def $add_callableDef_non_overload_i(cursor, instContext, callableId, callableDef) : instContext =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:196:1-202:87:
   clause 0(global, IC, callableId, callableDef) = IC[global.callable = callableDefEnv]
      -- if (id ( _id*{} ) = callableId)
      -- if ({ id_k ( _id'*{} )*{} } = $dom_map<callableId, callableDef>(IC.global.callable))
      -- if ~$in_set<id>(id, { id_k*{} })
      -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.global.callable, callableId, callableDef))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:203:1-209:86:
   clause 1(block, IC, callableId, callableDef) = IC[block.callable = callableDefEnv]
      -- if (id ( _id*{} ) = callableId)
      -- if ({ id_k ( _id'*{} )*{} } = $dom_map<callableId, callableDef>(IC.block.callable))
      -- if ~$in_set<id>(id, { id_k*{} })
      -- if (callableDefEnv = $add_map<callableId, callableDef>(IC.block.callable, callableId, callableDef))

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:213:1-215:92:
def $find_callableDef_non_overload_i(cursor, instContext, prefixedNameIR) : (cursor, callableId, callableDef)? =

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:217:1-219:76:
   clause 0(p, IC, . nameIR) = ?()
      -- if (?() = $find_non_overloaded<callableDef>(IC.global.callable, nameIR))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:220:1-222:98:
   clause 1(p, IC, . nameIR) = ?((global, callableId, callableDef))
      -- if (?((callableId, callableDef)) = $find_non_overloaded<callableDef>(IC.global.callable, nameIR))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:223:1-224:61:
   clause 2(global, IC, nameIR) = $find_callableDef_non_overload_i(global, IC, . nameIR)

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:225:1-228:69:
   clause 3(block, IC, nameIR) = ?((block, callableId, callableDef))
      -- if (?((callableId, callableDef)) = $find_non_overloaded<callableDef>(IC.block.callable, nameIR))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:229:1-232:69:
   clause 4(block, IC, nameIR) = $find_callableDef_non_overload_i(global, IC, nameIR)
      -- if (?() = $find_non_overloaded<callableDef>(IC.block.callable, nameIR))

   ;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:233:1-234:62:
   clause 5(local, IC, nameIR) = $find_callableDef_non_overload_i(block, IC, nameIR)

;; ../../../../../spectec/specs/p4/7-instantiation/7.02-inst-context.spectec:238:1-239:53:
