;; ../../../../../spectec/specs/p4/8-dynamic/8.02-evaluation-relation.spectec:44:1-45:16:
syntax expressionListResult = 
   | value* (from continueResult<value*>)
   | exit (from exitResult)
   | reject errorValue (from rejectTransitionResult)

