;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:218:17-218:25:
syntax set<K> = 
   | { K* } (from set<K>)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:220:1-220:27:
def $empty_set<K> : set<K> =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:221:1-221:30:
   clause 0 = { [] }

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:223:1-224:52:
def $in_set<K>(K, set<K>) : bool =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:225:1-225:42:
   clause 0(K, { K_e*{} }) = K <- K_e*{}

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:227:1-228:60:
