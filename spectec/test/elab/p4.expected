;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:76:1-78:53:
def $nestable_typedef(typeIR) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:80:1-80:35:
   clause 0(bool as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:81:1-81:36:
   clause 1(error as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:82:1-82:37:
   clause 2(string as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:83:1-83:44:
   clause 3(integerTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:84:1-84:41:
   clause 4(nameTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:85:1-85:68:
   clause 5(typedef _typeId typeIR as typeIR) = $nestable_typedef(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:86:1-86:40:
   clause 6(newTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:87:1-87:41:
   clause 7(dataTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:88:1-88:49:
   clause 8(externObjectTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:89:1-89:49:
   clause 9(parserObjectTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:90:1-90:50:
   clause 10(controlObjectTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:91:1-91:50:
   clause 11(packageObjectTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:92:1-93:15:
   clause 12(_typeIR) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:100:1-102:54:
def $nestable_new(typeIR) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:104:1-104:31:
   clause 0(bool as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:105:1-105:38:
   clause 1(bit < _nat > as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:106:1-106:38:
   clause 2(int < _nat > as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:107:1-107:37:
   clause 3(nameTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:108:1-108:60:
   clause 4(typedef _typeId typeIR as typeIR) = $nestable_new(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:109:1-109:36:
   clause 5(newTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.03-typing-wellformed.spectec:110:1-111:15:
   clause 6(_typeIR) = false
      -- otherwise

