;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:7:26-7:41:
syntax globalEvalLayer = globalInstLayer

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:11:25-11:39:
syntax blockEvalLayer = blockInstLayer

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:15:25-15:39:
syntax localEvalLayer = localInstLayer

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:22:3-24:27:
syntax evalContext = {global globalEvalLayer, block blockEvalLayer, local localEvalLayer}

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:32:1-33:45:
def $enter_e(evalContext) : evalContext =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:35:1-35:73:
   clause 0(EC) = EC[local.frames = $empty_frame :: EC.local.frames]

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:37:1-38:55:
def $exit_e(evalContext) : evalContext =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:40:1-41:46:
   clause 0(EC) = EC[local.frames = frame_t*{}]
      -- if (EC.local.frames = frame_h :: frame_t*{})

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:47:1-48:52:
def $inherit_e(cursor, evalContext) : evalContext =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:50:1-57:55:
   clause 0(global, EC) = EC[block = blockEvalLayer][local = localEvalLayer]
      -- if (blockEvalLayer = {type $empty_theta, callable $empty_callableDefEnv, state $empty_stateEnv, frame $empty_frame})
      -- if (localEvalLayer = {type $empty_theta, frames [$empty_frame]})

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:58:1-60:55:
   clause 1(block, EC) = EC[local = localEvalLayer]
      -- if (localEvalLayer = {type $empty_theta, frames [$empty_frame]})

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:61:1-61:31:
   clause 2(local, EC) = EC

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:67:1-67:60:
def $copy_e(cursor, evalContext, evalContext) : evalContext =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:69:1-70:38:
   clause 0(global, EC_from, EC_to) = EC_to[global = EC_from.global]

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:71:1-73:36:
   clause 1(block, EC_from, EC_to) = EC_to[global = EC_from.global][block = EC_from.block]

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:74:1-77:36:
   clause 2(local, EC_from, EC_to) = EC_to[global = EC_from.global][block = EC_from.block][local = EC_from.local]

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:85:1-86:68:
def $add_var_e(cursor, evalContext, prefixedNameIR, value) : evalContext =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:89:1-90:64:
   clause 0(global, EC, . id, value) = EC[global.frame = frame]
      -- if (frame = $add_map<id, value>(EC.global.frame, id, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:91:1-92:64:
   clause 1(global, EC, id, value) = EC[global.frame = frame]
      -- if (frame = $add_map<id, value>(EC.global.frame, id, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:93:1-94:63:
   clause 2(block, EC, id, value) = EC[block.frame = frame]
      -- if (frame = $add_map<id, value>(EC.block.frame, id, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:95:1-97:59:
   clause 3(local, EC, id, value) = EC[local.frames = frame_h' :: frame_t*{}]
      -- if (EC.local.frames = frame_h :: frame_t*{})
      -- if (frame_h' = $add_map<id, value>(frame_h, id, value))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:87:1-87:75:
def $add_vars_e(cursor, evalContext, prefixedNameIR*, value*) : evalContext =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:99:1-99:38:
   clause 0(p, EC, [], []) = EC

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:100:1-106:64:
   clause 1(p, EC, prefixedNameIR_h :: prefixedNameIR_t*{}, value_h :: value_t*{}) = EC''
      -- if (EC' = $add_var_e(p, EC, prefixedNameIR_h, value_h))
      -- if (EC'' = $add_vars_e(p, EC', prefixedNameIR_t*{}, value_t*{}))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:112:1-113:72:
def $update_var_e(cursor, evalContext, prefixedNameIR, value) : evalContext =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:115:1-116:67:
   clause 0(p, EC, . id, value) = EC[global.frame = frame]
      -- if (frame = $update_map<id, value>(EC.global.frame, id, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:117:1-120:58:
   clause 1(global, EC, id, value) = EC[global.frame = frame']
      -- if (frame = EC.global.frame)
      -- if $in_set<id>(id, $dom_map<id, value>(frame))
      -- if (frame' = $update_map<id, value>(frame, id, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:121:1-124:58:
   clause 2(block, EC, id, value) = EC[block.frame = frame']
      -- if (frame = EC.block.frame)
      -- if $in_set<id>(id, $dom_map<id, value>(frame))
      -- if (frame' = $update_map<id, value>(frame, id, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:125:1-128:53:
   clause 3(block, EC, id, value) = $update_var_e(global, EC, id, value)
      -- if (frame = EC.block.frame)
      -- if ~$in_set<id>(id, $dom_map<id, value>(frame))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:129:1-131:30:
   clause 4(local, EC, id, value) = $update_var_e(block, EC, id, value)
      -- if ([] = EC.local.frames)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:132:1-136:62:
   clause 5(local, EC, id, value) = EC[local.frames = frame_h' :: frame_t*{}]
      -- if (frame_h :: frame_t*{} = EC.local.frames)
      -- if $in_set<id>(id, $dom_map<id, value>(frame_h))
      -- if (frame_h' = $update_map<id, value>(frame_h, id, value))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:137:1-142:64:
   clause 6(local, EC, id, value) = EC_pop'[local.frames = frame_h :: EC_pop'.local.frames]
      -- if (frame_h :: frame_t*{} = EC.local.frames)
      -- if ~$in_set<id>(id, $dom_map<id, value>(frame_h))
      -- if (EC_pop = EC[local.frames = frame_t*{}])
      -- if (EC_pop' = $update_var_e(local, EC_pop, id, value))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:150:1-151:63:
def $find_var_e(prefixedNameIR, cursor, evalContext) : value =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:153:1-154:58:
   clause 0(. id, p, EC) = value
      -- if (?(value) = $find_map<id, value>(EC.global.frame, id))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:155:1-156:58:
   clause 1(id, global, EC) = value
      -- if (?(value) = $find_map<id, value>(EC.global.frame, id))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:157:1-158:57:
   clause 2(id, block, EC) = value
      -- if (?(value) = $find_map<id, value>(EC.block.frame, id))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:159:1-161:55:
   clause 3(id, block, EC) = $find_var_e(id, global, EC)
      -- if (?() = $find_map<id, value>(EC.block.frame, id))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:162:1-163:59:
   clause 4(id, local, EC) = value
      -- if (?(value) = $find_maps<id, value>(EC.local.frames, id))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:164:1-166:57:
   clause 5(id, local, EC) = $find_var_e(id, block, EC)
      -- if (?() = $find_maps<id, value>(EC.local.frames, id))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:170:1-170:70:
def $find_typeDef_e(cursor, evalContext, prefixedNameIR) : typeDefIR? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:172:1-173:57:
   clause 0(_cursor, EC, nameIR) = $find_map<typeId, typeDefIR>(EC.global.type, nameIR)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:174:1-175:57:
   clause 1(_cursor, EC, . nameIR) = $find_map<typeId, typeDefIR>(EC.global.type, nameIR)

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:179:1-179:56:
