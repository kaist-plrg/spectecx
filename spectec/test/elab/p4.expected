      -- rel Expr_eval: local EC_0 ARCH_0 |- typedExpressionIR : EC_1 ARCH_1 ref objectId as value as expressionResult
      -- if (?(value_set { value*{} ( n_size ) } as object) = $find_object_e(ARCH_1, objectId))
      -- if (setValue = set { value*{} ( n_size ) })

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:82:1-87:51:
