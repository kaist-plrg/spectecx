   ;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:293:1-293:59:
   clause 0(strictness, { [] }) = { [] }

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:294:1-298:71:
   clause 1(strictness, { typeId_h : infer_h :: typeId_t : infer_t*{} }) = { typeId_h : typeIR_h :: typeId_t : typeIR_t*{} }
      -- if (known as typeIR_h = infer_h)
      -- if ({ typeId_t : typeIR_t*{} } = $resolve_constraint(strictness, { typeId_t : infer_t*{} }))

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:299:1-304:71:
   clause 2(strictness, { typeId_h : infer_h :: typeId_t : infer_t*{} }) = { typeId_h : bool as typeIR :: typeId_t : typeIR_t*{} }
      -- if (unknown = infer_h)
      -- if ($find_map<typeId, strict>(strictness, typeId_h) = ?(lax))
      -- if ({ typeId_t : typeIR_t*{} } = $resolve_constraint(strictness, { typeId_t : infer_t*{} }))

