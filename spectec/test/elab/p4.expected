;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:43:1-44:32:
builtin dec $max_int(int*) : int

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:46:1-47:32:
