   | else (from annotationToken)
   | entries (from annotationToken)
   | enum (from annotationToken)
   | error (from annotationToken)
   | exit (from annotationToken)
   | extern (from annotationToken)
   | false (from annotationToken)
   | for (from annotationToken)
   | header (from annotationToken)
   | header_union (from annotationToken)
   | if (from annotationToken)
   | in (from annotationToken)
   | inout (from annotationToken)
   | int (from annotationToken)
   | key (from annotationToken)
   | match_kind (from annotationToken)
   | type (from annotationToken)
   | out (from annotationToken)
   | parser (from annotationToken)
   | package (from annotationToken)
   | pragma (from annotationToken)
   | return (from annotationToken)
   | select (from annotationToken)
   | state (from annotationToken)
   | string (from annotationToken)
   | struct (from annotationToken)
   | switch (from annotationToken)
   | table (from annotationToken)
   | this (from annotationToken)
   | transition (from annotationToken)
   | true (from annotationToken)
   | tuple (from annotationToken)
   | typedef (from annotationToken)
   | varbit (from annotationToken)
   | value_set (from annotationToken)
   | list (from annotationToken)
   | void (from annotationToken)
   | _ (from annotationToken)
   | text (from identifier)
   | text (from typeIdentifier)
   | " text " (from stringLiteral) hint(print "#%#")
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | &&& (from annotationToken)
   | .. (from annotationToken)
   | << (from annotationToken)
   | && (from annotationToken)
   | || (from annotationToken)
   | == (from annotationToken)
   | != (from annotationToken)
   | >= (from annotationToken)
   | <= (from annotationToken)
   | ++ (from annotationToken)
   | + (from annotationToken)
   | |+| (from annotationToken)
   | - (from annotationToken)
   | |-| (from annotationToken)
   | * (from annotationToken)
   | / (from annotationToken)
   | % (from annotationToken)
   | | (from annotationToken)
   | & (from annotationToken)
   | ^ (from annotationToken)
   | ~ (from annotationToken)
   | [ (from annotationToken)
   | ] (from annotationToken)
   | { (from annotationToken)
   | } (from annotationToken)
   | < (from annotationToken)
   | > (from annotationToken)
   | ! (from annotationToken)
   | : (from annotationToken)
   | , (from annotationToken)
   | ? (from annotationToken)
   | . (from annotationToken)
   | = (from annotationToken)
   | ; (from annotationToken)
