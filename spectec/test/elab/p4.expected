      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:184:1-188:38:
   rule abstract: extern_method abstract nameIR ( parameterIR_a*{} ) : typeIR_a ~~ extern_method abstract nameIR ( parameterIR_b*{} ) : typeIR_b
      -- (if ParameterType_alpha: parameterIR_a ~~ parameterIR_b holds)*
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:23:1-27:56:
relation ExternMethodTypeDef_alpha: externMethodTypeDefIR ~~ externMethodTypeDefIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:195:1-224:63:
   rule : externMethodTypeDefIR_a ~~ externMethodTypeDefIR_b
      -- if ((typeParameterIR_expl_a*{}, typeParameterIR_impl_a*{}) = $typeParameterListIR_of_callableTypeDefIR(externMethodTypeDefIR_a as callableTypeDefIR))
      -- if ((typeParameterIR_expl_b*{}, typeParameterIR_impl_b*{}) = $typeParameterListIR_of_callableTypeDefIR(externMethodTypeDefIR_b as callableTypeDefIR))
      -- if (|typeParameterIR_expl_a*{}| = |typeParameterIR_expl_b*{}|)
      -- if (|typeParameterIR_impl_a*{}| = |typeParameterIR_impl_b*{}|)
      -- if (typeParameterIR_fresh*{} = $fresh_typeIds(|typeParameterIR_expl_a*{} ++ typeParameterIR_impl_a*{}|))
      -- if (typeParameterIR_a*{} = typeParameterIR_expl_a*{} ++ typeParameterIR_impl_a*{})
      -- if (theta_a = { typeParameterIR_a : typeParameterIR_fresh as typeIR*{} })
      -- if (externMethodTypeIR_a as callableTypeIR = $callableTypeIR_of_callableTypeDefIR(externMethodTypeDefIR_a as callableTypeDefIR))
      -- if (externMethodTypeIR_a_subst as callableTypeIR = $subst_callableTypeIR(theta_a, externMethodTypeIR_a as callableTypeIR))
      -- if (typeParameterIR_b*{} = typeParameterIR_expl_b*{} ++ typeParameterIR_impl_b*{})
      -- if (theta_b = { typeParameterIR_b : typeParameterIR_fresh as typeIR*{} })
      -- if (externMethodTypeIR_b as callableTypeIR = $callableTypeIR_of_callableTypeDefIR(externMethodTypeDefIR_b as callableTypeDefIR))
      -- if (externMethodTypeIR_b_subst as callableTypeIR = $subst_callableTypeIR(theta_b, externMethodTypeIR_b as callableTypeIR))
      -- if ExternMethodType_alpha: externMethodTypeIR_a_subst ~~ externMethodTypeIR_b_subst holds

;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:5:14-5:30:
syntax ctk = 
   | lctk (from ctk)
   | ctk (from ctk)
   | dyn (from ctk)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:7:1-8:43:
def $join_ctk(ctk, ctk) : ctk =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:10:1-10:33:
   clause 0(lctk, lctk) = lctk

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:11:1-11:31:
   clause 1(lctk, ctk) = ctk

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:12:1-12:31:
   clause 2(ctk, lctk) = ctk

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:13:1-13:30:
   clause 3(ctk, ctk) = ctk

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:14:1-15:15:
   clause 4(ctk_a, ctk_b) = dyn
      -- otherwise

;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:17:1-18:34:
def $joins_ctk(ctk*) : ctk =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:20:1-20:27:
   clause 0([]) = lctk

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:21:1-21:26:
   clause 1([ctk]) = ctk

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:22:1-22:57:
   clause 2(ctk_a :: [ctk_b]) = $join_ctk(ctk_a, ctk_b)

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.7-compile-time-known.spectec:23:1-25:40:
   clause 3(ctk_a :: ctk_b :: ctk_c*{}) = $joins_ctk(ctk_d :: ctk_c*{})
      -- if (ctk_c*{} =/= [])
      -- if (ctk_d = $join_ctk(ctk_a, ctk_b))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:5:1-6:40:
builtin dec $pow2(nat) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:8:1-9:48:
builtin dec $shl(int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:10:1-11:57:
builtin dec $shr(int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:12:1-13:85:
builtin dec $shr_arith(int, int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:15:1-16:55:
builtin dec $bneg(int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:17:1-18:50:
builtin dec $band(int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:19:1-20:50:
builtin dec $bxor(int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:21:1-22:49:
builtin dec $bor(int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:24:1-25:56:
builtin dec $bitacc(int, int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:26:1-27:75:
builtin dec $bitacc_replace(int, int, int, int) : int

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:33:1-35:23:
def $un_op(unop, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:51:1-51:41:
   clause 0(~, value) = $un_bnot(value)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:61:1-61:41:
   clause 1(!, value) = $un_lnot(value)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:73:1-73:41:
   clause 2(+, value) = $un_plus(value)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:87:1-87:42:
   clause 3(-, value) = $un_minus(value)

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:39:1-41:23:
def $un_bnot(value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:43:1-45:58:
   clause 0(w w i as value) = w w i'' as value
      -- if (i' = $bneg(i))
      -- if (i'' = $ite<int>((i' >= 0 as int), i', ($pow2(w) + i')))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:47:1-49:58:
   clause 1(w s i as value) = w s i'' as value
      -- if (i' = $bneg(i))
      -- if (i'' = $ite<int>((i' >= 0 as int), i', ($pow2(w) + i')))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:55:1-57:23:
def $un_lnot(value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:59:1-59:29:
   clause 0(b as value) = ~b as value

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:65:1-67:23:
def $un_plus(value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:69:1-69:24:
   clause 0(d i as value) = d i as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:70:1-70:28:
   clause 1(w w i as value) = w w i as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:71:1-71:28:
   clause 2(w s i as value) = w s i as value

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:77:1-79:23:
def $un_minus(value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:81:1-81:29:
   clause 0(d i as value) = d -i as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:82:1-83:48:
   clause 1(w w i as value) = w w i' as value
      -- if (i' = $int_to_bitstr(w as int, ($pow2(w) - i)))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:84:1-85:57:
   clause 2(w s i as value) = w s i' as value
      -- if (i' = $int_to_bitstr(w as int, $bitstr_to_int(w as int, -i)))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:93:1-95:23:
def $bin_op(binop, value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:113:1-113:65:
   clause 0(+, value_l, value_r) = $bin_plus(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:144:1-144:70:
   clause 1(|+|, value_l, value_r) = $bin_satplus(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:162:1-162:66:
   clause 2(-, value_l, value_r) = $bin_minus(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:192:1-192:71:
   clause 3(|-|, value_l, value_r) = $bin_satminus(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:210:1-210:64:
   clause 4(*, value_l, value_r) = $bin_mul(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:224:1-224:64:
   clause 5(/, value_l, value_r) = $bin_div(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:238:1-238:64:
   clause 6(%, value_l, value_r) = $bin_mod(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:269:1-269:65:
   clause 7(<<, value_l, value_r) = $bin_shl(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:326:1-326:65:
   clause 8(>>, value_l, value_r) = $bin_shr(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:341:1-341:67:
   clause 9(<=, value_l, value_r) = $bin_le(value_l, value_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:356:1-356:67:
   clause 10(>=, value_l, value_r) = $bin_ge(value_l, value_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:371:1-371:66:
   clause 11(<, value_l, value_r) = $bin_lt(value_l, value_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:386:1-386:66:
   clause 12(>, value_l, value_r) = $bin_gt(value_l, value_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:475:1-475:67:
   clause 13(==, value_l, value_r) = $bin_eq(value_l, value_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:486:1-486:67:
   clause 14(!=, value_l, value_r) = $bin_ne(value_l, value_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:501:1-501:65:
   clause 15(&, value_l, value_r) = $bin_band(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:516:1-516:65:
   clause 16(^, value_l, value_r) = $bin_bxor(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:531:1-531:64:
   clause 17(|, value_l, value_r) = $bin_bor(value_l, value_r)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:563:1-563:68:
   clause 18(++, value_l, value_r) = $bin_concat(value_l, value_r)

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:99:1-101:23:
def $bin_plus(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:103:1-103:45:
   clause 0(d i_l as value, d i_r as value) = d (i_l + i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:104:1-107:47:
   clause 1(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' + i_r')))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:108:1-111:47:
   clause 2(w s i_l as value, w s i_r as value) = w s i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' + i_r')))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:117:1-119:23:
def $bin_satplus(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:121:1-124:54:
   clause 0(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i = (i_l + i_r))
      -- if (i_max = $pow2(w))
      -- if (i' = $ite<int>((i < i_max), i, (i_max - 1 as int)))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:125:1-133:38:
   clause 1(w s i_l as value, w s i_r as value) = w s i''' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = (i_l' + i_r'))
      -- if (i' > 0 as int)
      -- if (w' = (w - 1))
      -- if (i_max = $pow2(w'))
      -- if (i'' = $ite<int>((i' < i_max), i', (i_max - 1 as int)))
      -- if (i''' = $int_to_bitstr(w as int, i''))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:134:1-142:38:
   clause 2(w s i_l as value, w s i_r as value) = w s i''' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = (i_l' + i_r'))
      -- if (i' <= 0 as int)
      -- if (w' = (w - 1))
      -- if (i_min = -$pow2(w'))
      -- if (i'' = $ite<int>((i' >= i_min), i', i_min))
      -- if (i''' = $int_to_bitstr(w as int, i''))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:148:1-150:23:
def $bin_minus(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:152:1-152:46:
   clause 0(d i_l as value, d i_r as value) = d (i_l - i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:153:1-156:47:
   clause 1(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' - i_r')))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:157:1-160:47:
   clause 2(w s i_l as value, w s i_r as value) = w s i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' - i_r')))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:166:1-168:23:
def $bin_satminus(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:170:1-172:40:
   clause 0(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i = (i_l - i_r))
      -- if (i' = $ite<int>((i >= 0 as int), i, 0 as int))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:173:1-181:38:
   clause 1(w s i_l as value, w s i_r as value) = w s i''' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = (i_l' - i_r'))
      -- if (i' > 0 as int)
      -- if (w' = (w - 1))
      -- if (i_max = $pow2(w'))
      -- if (i'' = $ite<int>((i' < i_max), i', (i_max - 1 as int)))
      -- if (i''' = $int_to_bitstr(w as int, i''))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:182:1-190:38:
   clause 2(w s i_l as value, w s i_r as value) = w s i''' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = (i_l' - i_r'))
      -- if (i' <= 0 as int)
      -- if (w' = (w - 1))
      -- if (i_min = -$pow2(w'))
      -- if (i'' = $ite<int>((i' >= i_min), i', i_min))
      -- if (i''' = $int_to_bitstr(w as int, i''))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:196:1-198:23:
def $bin_mul(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:200:1-200:44:
   clause 0(d i_l as value, d i_r as value) = d (i_l * i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:201:1-204:47:
   clause 1(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' * i_r')))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:205:1-208:47:
   clause 2(w s i_l as value, w s i_r as value) = w s i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' * i_r')))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:214:1-216:23:
def $bin_div(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:218:1-218:44:
   clause 0(d i_l as value, d i_r as value) = d (i_l / i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:219:1-222:47:
   clause 1(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' / i_r')))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:228:1-230:23:
def $bin_mod(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:232:1-232:44:
   clause 0(d i_l as value, d i_r as value) = d (i_l \ i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:233:1-236:47:
   clause 1(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $bitstr_to_int(w as int, i_l))
      -- if (i_r' = $bitstr_to_int(w as int, i_r))
      -- if (i' = $int_to_bitstr(w as int, (i_l' \ i_r')))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:242:1-244:23:
def $bin_shl(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:246:1-246:46:
   clause 0(d i_l as value, d i_r as value) = d $shl(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:247:1-247:50:
   clause 1(d i_l as value, w_r w i_r as value) = d $shl(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:248:1-249:40:
   clause 2(d i_l as value, w_r s i_r as value) = d $shl(i_l, i_r') as value
      -- if (i_r' = $bitstr_to_int(w_r as int, i_r))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:251:1-252:56:
   clause 3(w_l w i_l as value, d i_r as value) = $bin_shl(w_l w i_l as value, w_l w $bitstr_to_int(w_l as int, i_r) as value)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:253:1-254:49:
   clause 4(w_l w i_l as value, w_r w i_r as value) = w_l w i' as value
      -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l, i_r)))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:255:1-257:50:
   clause 5(w_l w i_l as value, w_r s i_r as value) = w_l w i' as value
      -- if (i_r' = $bitstr_to_int(w_r as int, i_r))
      -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l, i_r')))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:259:1-260:56:
   clause 6(w_l s i_l as value, d i_r as value) = $bin_shl(w_l s i_l as value, w_l s $bitstr_to_int(w_l as int, i_r) as value)

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:261:1-263:50:
   clause 7(w_l s i_l as value, w_r w i_r as value) = w_l s i' as value
      -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
      -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l', i_r)))

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:264:1-267:51:
   clause 8(w_l s i_l as value, w_r s i_r as value) = w_l s i' as value
      -- if (i_l' = $bitstr_to_int(w_l as int, i_l))
      -- if (i_r' = $bitstr_to_int(w_r as int, i_r))
      -- if (i' = $int_to_bitstr(w_l as int, $shl(i_l', i_r')))

;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:273:1-275:23:
def $bin_shr(value, value) : value =

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:277:1-277:46:
   clause 0(d i_l as value, d i_r as value) = d $shr(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:278:1-278:50:
   clause 1(d i_l as value, w_r w i_r as value) = d $shr(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4/3-operations/3-operations.spectec:279:1-280:40:
   clause 2(d i_l as value, w_r s i_r as value) = d $shr(i_l, i_r') as value
      -- if (i_r' = $bitstr_to_int(w_r as int, i_r))

