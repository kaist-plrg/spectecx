      -- otherwise

;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:49:1-49:36:
def $name_sliceop(sliceop) : nameIR =

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:50:1-50:29:
   clause 0(:) = ":"

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:51:1-51:31:
   clause 1(+:) = "+:"

;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:53:1-53:42:
def $name_expression(expression) : nameIR =

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:56:1-56:36:
   clause 0(true as expression) = "true"

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:57:1-57:38:
   clause 1(false as expression) = "false"

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:58:1-58:44:
   clause 2(d i as expression) = $int_to_text(i)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:59:1-59:72:
   clause 3(n w i as expression) = $int_to_text(n as int) ++ "w" ++ $int_to_text(i)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:60:1-60:72:
   clause 4(n s i as expression) = $int_to_text(n as int) ++ "s" ++ $int_to_text(i)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:61:1-61:58:
   clause 5(" text " as expression) = "\"" ++ text ++ "\""

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:64:1-64:36:
   clause 6(this as expression) = "this"

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:65:1-65:55:
   clause 7(nonTypeName as expression) = $name(nonTypeName as name)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:66:1-66:70:
   clause 8(. nonTypeName as expression) = "." ++ $name(nonTypeName as name)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:69:1-69:67:
   clause 9(error . member as expression) = "error." ++ $name(member)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:70:1-72:28:
   clause 10(prefixedTypeName as memberAccessBase . member as expression) = $flatten_prefixedNameIR($prefixedTypeName(prefixedTypeName)) ++ "." ++ $name(member)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:73:1-74:57:
   clause 11(expression as memberAccessBase . member as expression) = $name_expression(expression) ++ "." ++ $name(member)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:75:1-77:56:
   clause 12(expression_base [ expression_index ] as expression) = $name_expression(expression_base) ++ "[" ++ $name_expression(expression_index) ++ "]"

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:78:1-81:45:
   clause 13(expression_base [ expression_l sliceop expression_r ] as expression) = $name_expression(expression_base) ++ "[" ++ $name_expression(expression_l) ++ $name_sliceop(sliceop) ++ $name_expression(expression_r) ++ "]"

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:84:1-84:84:
   clause 14(( expression ) as expression) = "(" ++ $name_expression(expression) ++ ")"

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:90:1-91:15:
   clause 15(_expression) = ""
      -- otherwise

