;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1058:1-1059:27:
syntax typedef = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
