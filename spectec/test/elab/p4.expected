      -- rel Expr_eval: local EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:99:1-108:51:
   rule left-cont-right-cont: EC_0 ARCH_0 |- typedExpressionIR_l &&& typedExpressionIR_r : EC_2 ARCH_2 setValue as simpleKeysetExpressionResult
      -- rel Expr_eval: local EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 value_l as expressionResult
      -- rel Expr_eval: local EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 value_r as expressionResult
      -- if (setValue = set { value_l &&& value_r })

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:114:1-119:51:
   rule left-abort: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_1 ARCH_1 abortResult as simpleKeysetExpressionResult
      -- rel Expr_eval: local EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:121:1-129:51:
   rule left-cont-right-abort: EC_0 ARCH_0 |- typedExpressionIR_l .. typedExpressionIR_r : EC_2 ARCH_2 abortResult as simpleKeysetExpressionResult
      -- rel Expr_eval: local EC_0 ARCH_0 |- typedExpressionIR_l : EC_1 ARCH_1 value_l as expressionResult
      -- rel Expr_eval: local EC_1 ARCH_1 |- typedExpressionIR_r : EC_2 ARCH_2 abortResult as expressionResult

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:131:1-140:50:
