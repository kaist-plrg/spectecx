   clause 14(constraint, package _typeId < _typeArgumentIR*{} > { typeIR_param*{} } as typeIR, package _typeId' < _typeArgumentIR'*{} > { typeIR_arg*{} } as typeIR) = $gen_constraint(constraint, typeIR_param*{}, typeIR_arg*{})

   ;; ../../../../../spectec/specs/p4/5-typing/5.15.2-typing-call-inference.spectec:199:1-201:15:
   clause 15(constraint, typeIR_param, typeIR_arg) = constraint
      -- otherwise

