;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:296:1-296:46:
def $tableEntry_lpm_prefix'(value, nat) : nat =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:299:1-299:56:
   clause 0(0 w _int as value, n_prefix) = n_prefix

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:300:1-306:25:
   clause 1(w w n as int as value, n_prefix) = $tableEntry_lpm_prefix'(value', (n_prefix + 1))
      -- if (w > 0)
      -- if (w' = (w - 1))
      -- if ((n \ 2) =/= 0)
      -- if (n' = ((n - 1) / 2))
      -- if (value' = w' w n' as int as value)

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.2-typing-table-context.spectec:307:1-312:31:
   clause 2(w w n as int as value, 0) = $tableEntry_lpm_prefix'(value', 0)
      -- if (w > 0)
      -- if (w' = (w - 1))
      -- if ((n \ 2) = 0)
      -- if (value' = w' w (n / 2) as int as value)

