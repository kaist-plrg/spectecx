   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:130:1-131:21:
   rule defaultTypeIR: default as typeIR ~~ default as typeIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:133:1-134:35:
