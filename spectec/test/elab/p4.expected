   | lvalue ( argumentList ) ; (from callStatement)
   | lvalue < typeArgumentList > ( argumentList ) ; (from callStatement)
   | namedType . apply ( argumentList ) ; (from directApplicationStatement)
   | annotationList { parserBlockElementStatementList } (from parserBlockStatement)
   | if ( expression ) parserStatement (from parserConditionalStatement)
   | if ( expression ) parserStatement else parserStatement (from parserConditionalStatement)

