;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1384:1-1386:32:
def $flatten_controlLocalDeclarationList(controlLocalDeclarationList) : controlLocalDeclaration* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1387:1-1387:55:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1388:1-1391:35:
   clause 1(controlLocalDeclarationList controlLocalDeclaration) = $flatten_controlLocalDeclarationList(controlLocalDeclarationList) ++ [controlLocalDeclaration]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1394:3-1396:56:
syntax controlDeclaration = 
   | annotationList control name typeParameterListOpt ( parameterList ) constructorParameterListOpt { controlLocalDeclarationList apply controlBody } (from controlDeclaration)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1403:3-1403:75:
syntax packageTypeDeclaration = 
   | annotationList package name typeParameterListOpt ( parameterList ) ; (from packageTypeDeclaration)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1410:1-1414:27:
syntax typeDeclaration = 
   | annotationList enum name { nameList trailingCommaOpt } (from enumTypeDeclaration)
   | annotationList enum type name { namedExpressionList trailingCommaOpt } (from enumTypeDeclaration)
   | annotationList struct name typeParameterListOpt { typeFieldList } (from structTypeDeclaration)
   | annotationList header name typeParameterListOpt { typeFieldList } (from headerTypeDeclaration)
   | annotationList header_union name typeParameterListOpt { typeFieldList } (from headerUnionTypeDeclaration)
   | annotationList typedef typedef name ; (from typedefDeclaration)
   | annotationList type type name ; (from typedefDeclaration)
   | annotationList parser name typeParameterListOpt ( parameterList ) ; (from parserTypeDeclaration)
   | annotationList control name typeParameterListOpt ( parameterList ) ; (from controlTypeDeclaration)
   | annotationList package name typeParameterListOpt ( parameterList ) ; (from packageTypeDeclaration)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1421:1-1430:20:
syntax declaration = 
   | annotationList const type name initializer ; (from constantDeclaration)
   | annotationList type ( argumentList ) name ; (from instantiation)
   | annotationList type ( argumentList ) name objectInitializer ; (from instantiation)
   | annotationList functionPrototype blockStatement (from functionDeclaration)
   | annotationList action name ( parameterList ) blockStatement (from actionDeclaration)
   | error { nameList } (from errorDeclaration)
   | match_kind { nameList trailingCommaOpt } (from matchKindDeclaration)
   | annotationList extern functionPrototype ; (from externFunctionDeclaration)
   | annotationList extern nonTypeName typeParameterListOpt { externConstructorOrMethodPrototypeList } (from externObjectDeclaration)
   | annotationList parser name typeParameterListOpt ( parameterList ) constructorParameterListOpt { parserLocalDeclarationList parserStateList } (from parserDeclaration)
   | annotationList control name typeParameterListOpt ( parameterList ) constructorParameterListOpt { controlLocalDeclarationList apply controlBody } (from controlDeclaration)
   | annotationList enum name { nameList trailingCommaOpt } (from enumTypeDeclaration)
   | annotationList enum type name { namedExpressionList trailingCommaOpt } (from enumTypeDeclaration)
   | annotationList struct name typeParameterListOpt { typeFieldList } (from structTypeDeclaration)
   | annotationList header name typeParameterListOpt { typeFieldList } (from headerTypeDeclaration)
   | annotationList header_union name typeParameterListOpt { typeFieldList } (from headerUnionTypeDeclaration)
   | annotationList typedef typedef name ; (from typedefDeclaration)
   | annotationList type type name ; (from typedefDeclaration)
   | annotationList parser name typeParameterListOpt ( parameterList ) ; (from parserTypeDeclaration)
   | annotationList control name typeParameterListOpt ( parameterList ) ; (from controlTypeDeclaration)
   | annotationList package name typeParameterListOpt ( parameterList ) ; (from packageTypeDeclaration)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:1437:1-1454:32:
syntax annotationToken = 
   | unexpected_token (from annotationToken)
   | abstract (from annotationToken)
   | action (from annotationToken)
   | actions (from annotationToken)
   | apply (from annotationToken)
   | bool (from annotationToken)
   | bit (from annotationToken)
   | break (from annotationToken)
   | const (from annotationToken)
   | continue (from annotationToken)
