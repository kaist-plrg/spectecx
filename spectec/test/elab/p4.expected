def $join_control_t(typingContext, typingContext) : flow =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:138:1-138:73:
   clause 0(TC_a, TC_b) = $join_flow(TC_a.control, TC_b.control)

;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:140:1-141:50:
def $set_control_t(typingContext, flow) : typingContext =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:142:1-142:54:
   clause 0(TC, flow) = TC[control = flow]

;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:148:1-149:36:
def $enter_loop_t(typingContext) : typingContext =

   ;; ../../../../../spectec/specs/p4/5-typing/5.02.1-typing-context.spectec:150:1-150:42:
   clause 0(TC) = TC[loop = in]

