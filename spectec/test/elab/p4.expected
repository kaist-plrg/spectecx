   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:137:1-139:41:
   rule non-default: seq < typeIR_a*{} > as typeIR ~~ seq < typeIR_b*{} > as typeIR
      -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:141:1-143:41:
   rule default: seq < typeIR_a*{} , ... > as typeIR ~~ seq < typeIR_b*{} , ... > as typeIR
      -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:147:1-150:53:
   rule non-default: record { annotationList typeIR_field_a nameIR_field ;*{} } as typeIR ~~ record { annotationList typeIR_field_b nameIR_field ;*{} } as typeIR
      -- (if Type_alpha: typeIR_field_a ~~ typeIR_field_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:152:1-155:53:
   rule default: record { annotationList typeIR_field_a nameIR_field ;*{} , ... } as typeIR ~~ record { annotationList typeIR_field_b nameIR_field ;*{} , ... } as typeIR
      -- (if Type_alpha: typeIR_field_a ~~ typeIR_field_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:158:1-160:38:
   rule setTypeIR: set < typeIR_a > as typeIR ~~ set < typeIR_b > as typeIR
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:162:1-163:45:
