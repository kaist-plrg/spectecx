   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:21:1-21:60:
   clause 2(int < _nat > as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:22:1-22:60:
   clause 3(bit < _nat > as typeIR) = true

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:23:1-23:104:
   clause 4(typedef _typeId typeIR as typeIR) = $compat_table_lpm_ternary_range_key(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:24:1-24:101:
