;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:5:1-9:56:
relation Type_alpha: typeIR ~~ typeIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:35:1-36:27:
   rule baseTypeIR: baseTypeIR as typeIR ~~ baseTypeIR as typeIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:40:1-41:36:
   rule nameTypeIR: typeId as typeIR ~~ typeId as typeIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:46:1-48:38:
   rule left: typedef _typeId typeIR_a as typeIR ~~ typeIR_b
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:50:1-53:38:
   rule right: typeIR_a ~~ typedef _typeId typeIR_b as typeIR
      -- if ~typeIR_a <: typedefTypeIR
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:56:1-58:38:
   rule newTypeIR: type typeId typeIR_a as typeIR ~~ type typeId typeIR_b as typeIR
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:62:1-64:38:
   rule listTypeIR: list < typeIR_a > as typeIR ~~ list < typeIR_b > as typeIR
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:66:1-68:41:
   rule tupleTypeIR: tuple < typeIR_a*{} > as typeIR ~~ tuple < typeIR_b*{} > as typeIR
      -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:70:1-72:38:
   rule arrayTypeIR: array typeIR_a [ n_size ] as typeIR ~~ array typeIR_b [ n_size ] as typeIR
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:74:1-76:38:
   rule headerStackTypeIR: header_stack typeIR_a [ n_size ] as typeIR ~~ header_stack typeIR_b [ n_size ] as typeIR
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:78:1-81:57:
   rule structTypeIR: struct typeId < typeArgumentIR_a*{} > { _fieldTypeIR*{} } as typeIR ~~ struct typeId < typeArgumentIR_b*{} > { _fieldTypeIR'*{} } as typeIR
      -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:83:1-86:57:
   rule headerTypeIR: header typeId < typeArgumentIR_a*{} > { _fieldTypeIR*{} } as typeIR ~~ header typeId < typeArgumentIR_b*{} > { _fieldTypeIR'*{} } as typeIR
      -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:88:1-91:57:
   rule headerUnionTypeIR: header_union typeId < typeArgumentIR_a*{} > { _fieldTypeIR*{} } as typeIR ~~ header_union typeId < typeArgumentIR_b*{} > { _fieldTypeIR'*{} } as typeIR
      -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:94:1-95:73:
   rule non-serializable: enum typeId { nameIR_field*{} } as typeIR ~~ enum typeId { nameIR_field*{} } as typeIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:97:1-100:38:
   rule serializable: enum typeId < typeIR_a > { nameIR_field = value_field ;*{} } as typeIR ~~ enum typeId < typeIR_b > { nameIR_field = value_field ;*{} } as typeIR
      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:105:1-108:57:
   rule externObjectTypeIR: extern typeId < typeArgumentIR_a*{} > _externMethodTypeDefEnv as typeIR ~~ extern typeId < typeArgumentIR_b*{} > _externMethodTypeDefEnv' as typeIR
      -- (if Type_alpha: typeArgumentIR_a ~~ typeArgumentIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:110:1-113:60:
   rule parserObjectTypeIR: parser _typeId < _typeArgumentIR*{} > ( parameterIR_a*{} ) as typeIR ~~ parser _typeId' < _typeArgumentIR'*{} > ( parameterIR_b*{} ) as typeIR
      -- (if ParameterType_alpha: parameterIR_a ~~ parameterIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:115:1-118:60:
   rule controlObjectTypeIR: control _typeId < _typeArgumentIR*{} > ( parameterIR_a*{} ) as typeIR ~~ control _typeId' < _typeArgumentIR'*{} > ( parameterIR_b*{} ) as typeIR
      -- (if ParameterType_alpha: parameterIR_a ~~ parameterIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:120:1-123:41:
   rule packageObjectTypeIR: package _typeId < _typeArgumentIR*{} > { typeIR_a*{} } as typeIR ~~ package _typeId' < _typeArgumentIR'*{} > { typeIR_b*{} } as typeIR
      -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:125:1-126:41:
