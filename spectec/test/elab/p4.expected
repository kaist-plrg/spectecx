;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:6:1-7:15:
syntax prefixedNameIR = 
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:9:1-10:44:
def $prefixedNonTypeName(prefixedNonTypeName) : prefixedNameIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:11:1-11:65:
   clause 0(nonTypeName as prefixedNonTypeName) = $name(nonTypeName as name)

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:12:1-12:71:
   clause 1(. nonTypeName) = . $name(nonTypeName as name)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:14:1-15:44:
def $prefixedTypeName(prefixedTypeName) : prefixedNameIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:16:1-16:56:
   clause 0(typeName as prefixedTypeName) = $name(typeName as name)

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:17:1-17:63:
   clause 1(. typeName) = . $name(typeName as name)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:19:1-20:42:
def $flatten_prefixedNameIR(prefixedNameIR) : nameIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:21:1-21:51:
   clause 0(nameIR) = nameIR

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:22:1-22:56:
   clause 1(. nameIR) = "." ++ nameIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:24:21-24:28:
syntax nameListIR = nameIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:30:30-30:46:
syntax typeParameterListIR = typeParameterIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:36:26-36:38:
syntax parameterListIR = parameterIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:42:37-42:49:
syntax constructorParameterListIR = parameterIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:48:23-48:39:
syntax namedValueIR = 
   | nameIR = value (from namedValueIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:50:27-50:40:
syntax namedValueListIR = namedValueIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:56:28-56:56:
syntax namedExpressionIR = 
   | nameIR = typedExpressionIR (from namedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:58:32-58:50:
syntax namedExpressionListIR = namedExpressionIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:68:30-68:47:
syntax literalExpressionIR = literalExpression

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:74:32-74:46:
syntax referenceExpressionIR = prefixedNameIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:80:30-80:47:
syntax defaultExpressionIR = defaultExpression

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:86:28-86:50:
syntax unaryExpressionIR = 
   | unop typedExpressionIR (from unaryExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:89:3-89:44:
syntax binaryExpressionIR = 
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:92:3-92:64:
syntax ternaryExpressionIR = 
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR (from ternaryExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:98:27-98:57:
syntax castExpressionIR = 
   | ( typeIR ) typedExpressionIR (from castExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:106:36-106:59:
syntax invalidHeaderExpressionIR = invalidHeaderExpression

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:109:1-110:46:
syntax sequenceExpressionIR = 
   | seq { typedExpressionListIR } (from sequenceExpressionIR)
   | seq { typedExpressionListIR , ... } (from sequenceExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:113:1-114:49:
syntax recordExpressionIR = 
   | record { namedExpressionListIR } (from recordExpressionIR)
   | record { namedExpressionListIR , ... } (from recordExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:117:1-119:23:
syntax dataExpressionIR = 
   | {#} (from invalidHeaderExpression)
   | seq { typedExpressionListIR } (from sequenceExpressionIR)
   | seq { typedExpressionListIR , ... } (from sequenceExpressionIR)
   | record { namedExpressionListIR } (from recordExpressionIR)
   | record { namedExpressionListIR , ... } (from recordExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:128:3-128:19:
syntax errorAccessExpressionIR = 
   | error . nameIR (from errorAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:131:3-131:32:
syntax memberAccessExpressionIR = 
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:134:3-134:44:
syntax indexAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:137:3-137:70:
syntax sliceAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR sliceop typedExpressionIR ] (from sliceAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:140:1-143:28:
syntax accessExpressionIR = 
   | error . nameIR (from errorAccessExpressionIR)
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR sliceop typedExpressionIR ] (from sliceAccessExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:154:1-157:27:
syntax callableTargetIR = 
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)
   | typedExpressionIR . nameIR (from callableTargetIR)
   | type prefixedNameIR . nameIR (from callableTargetIR)
   | ( callableTargetIR ) (from callableTargetIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:159:30-159:69:
syntax constructorTargetIR = 
   | prefixedNameIR < typeArgumentListIR > (from constructorTargetIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:162:1-163:67:
syntax callExpressionIR = 
   | constructorTargetIR ( argumentListIR ) (from callExpressionIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) (from callExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:169:36-169:59:
syntax parenthesizedExpressionIR = 
   | ( typedExpressionIR ) (from parenthesizedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:176:1-186:30:
syntax expressionIR = 
   | true (from booleanLiteral)
   | false (from booleanLiteral)
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)
   | ... (from defaultExpression)
   | unop typedExpressionIR (from unaryExpressionIR)
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR)
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR (from ternaryExpressionIR)
   | ( typeIR ) typedExpressionIR (from castExpressionIR)
   | {#} (from invalidHeaderExpression)
   | seq { typedExpressionListIR } (from sequenceExpressionIR)
   | seq { typedExpressionListIR , ... } (from sequenceExpressionIR)
   | record { namedExpressionListIR } (from recordExpressionIR)
   | record { namedExpressionListIR , ... } (from recordExpressionIR)
   | error . nameIR (from errorAccessExpressionIR)
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR sliceop typedExpressionIR ] (from sliceAccessExpressionIR)
   | constructorTargetIR ( argumentListIR ) (from callExpressionIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) (from callExpressionIR)
   | ( typedExpressionIR ) (from parenthesizedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:188:27-190:54:
syntax expressionNoteIR = 
   | ( typeIR ctk ) (from expressionNoteIR) hint(prose "a pair of type" %0 "and compile-time known-ness" %1) hint(prose_fields "type" "compile-time known-ness")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:193:3-196:41:
syntax typedExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:198:32-198:50:
syntax typedExpressionListIR = typedExpressionIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:201:1-202:22:
syntax memberAccessBaseIR = 
   | type prefixedNameIR (from memberAccessBaseIR)
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:204:1-205:34:
def $type_of_typedExpressionIR(typedExpressionIR) : typeIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:206:1-207:49:
   clause 0(typedExpressionIR) = typeIR
      -- if (_expressionIR # ( typeIR _ctk ) = typedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:209:1-210:53:
def $ctk_of_typedExpressionIR(typedExpressionIR) : ctk =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:211:1-212:46:
   clause 0(typedExpressionIR) = ctk
      -- if (_expressionIR # ( _typeIR ctk ) = typedExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:219:1-223:8:
syntax simpleKeysetExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR &&& typedExpressionIR (from simpleKeysetExpressionIR)
   | typedExpressionIR .. typedExpressionIR (from simpleKeysetExpressionIR)
   | default (from simpleKeysetExpressionIR)
   | _ (from simpleKeysetExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:225:39-225:64:
syntax simpleKeysetExpressionListIR = simpleKeysetExpressionIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:227:34-227:68:
syntax tupleKeysetExpressionIR = 
   | ( simpleKeysetExpressionListIR ) (from tupleKeysetExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:230:1-231:28:
syntax keysetExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR &&& typedExpressionIR (from simpleKeysetExpressionIR)
   | typedExpressionIR .. typedExpressionIR (from simpleKeysetExpressionIR)
   | default (from simpleKeysetExpressionIR)
   | _ (from simpleKeysetExpressionIR)
   | ( simpleKeysetExpressionListIR ) (from tupleKeysetExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:233:1-235:63:
def $flatten_keysetExpressionIR(keysetExpressionIR) : simpleKeysetExpressionListIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:237:1-238:33:
   clause 0(simpleKeysetExpressionIR as keysetExpressionIR) = [simpleKeysetExpressionIR]

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:239:1-240:33:
   clause 1(( simpleKeysetExpressionListIR ) as keysetExpressionIR) = simpleKeysetExpressionListIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:246:29-246:44:
syntax typeArgumentListIR = typeArgumentIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:253:1-256:8:
syntax argumentIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | nameIR = typedExpressionIR (from argumentIR)
   | nameIR = _ (from argumentIR)
   | _ (from argumentIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:258:25-258:36:
syntax argumentListIR = argumentIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:265:1-269:24:
syntax lvalueIR = 
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)
   | typedLvalueIR . nameIR (from lvalueIR)
   | typedLvalueIR [ typedExpressionIR ] (from lvalueIR)
   | typedLvalueIR [ typedExpressionIR sliceop typedExpressionIR ] (from lvalueIR)
   | ( typedLvalueIR ) (from lvalueIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:271:23-271:35:
syntax lvalueNoteIR = 
   | ( typeIR ) (from lvalueNoteIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:273:24-276:37:
syntax typedLvalueIR = 
   | lvalueIR # lvalueNoteIR (from typedLvalueIR) hint(print %0) hint(prose %0 "with note" %1) hint(prose_fields "lvalue" "note")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:278:1-279:41:
def $type_of_typedLvalueIR(typedLvalueIR) : typeIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:280:1-281:43:
   clause 0(typedLvalueIR) = typeIR
      -- if (_lvalueIR # ( typeIR ) = typedLvalueIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:283:1-285:45:
def $typedLvalueIR_as_typedExpressionIR(typedLvalueIR) : typedExpressionIR? =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:286:1-288:47:
   clause 0(referenceExpressionIR as lvalueIR # ( typeIR )) = ?(referenceExpressionIR as expressionIR # ( typeIR dyn ))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:289:1-293:59:
   clause 1(typedLvalueIR . nameIR # ( typeIR )) = ?(typedExpressionIR as memberAccessBaseIR . nameIR as expressionIR # ( typeIR dyn ))
      -- if (?(typedExpressionIR) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:294:1-298:64:
   clause 2(typedLvalueIR_base [ typedExpressionIR_index ] # ( typeIR )) = ?(typedExpressionIR_base [ typedExpressionIR_index ] as expressionIR # ( typeIR dyn ))
      -- if (?(typedExpressionIR_base) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:299:1-303:64:
   clause 3(typedLvalueIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] # ( typeIR )) = ?(typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] as expressionIR # ( typeIR dyn ))
      -- if (?(typedExpressionIR_base) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:304:1-308:64:
   clause 4(typedLvalueIR_base [ typedExpressionIR_l +: typedExpressionIR_w ] # ( typeIR )) = ?(typedExpressionIR_base [ typedExpressionIR_l +: typedExpressionIR_w ] as expressionIR # ( typeIR dyn ))
      -- if (?(typedExpressionIR_base) = $typedLvalueIR_as_typedExpressionIR(typedLvalueIR_base))

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:310:1-312:42:
def $typedExpressionIR_as_typedLvalueIR(typedExpressionIR) : typedLvalueIR? =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:313:1-315:43:
   clause 0(referenceExpressionIR as expressionIR # ( typeIR _ctk )) = ?(referenceExpressionIR as lvalueIR # ( typeIR ))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:316:1-320:63:
   clause 1(typedExpressionIR as memberAccessBaseIR . nameIR as expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR . nameIR # ( typeIR ))
      -- if (?(typedLvalueIR) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:321:1-325:68:
   clause 2(typedExpressionIR_base [ typedExpressionIR_index ] as expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR_base [ typedExpressionIR_index ] # ( typeIR ))
      -- if (?(typedLvalueIR_base) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:326:1-330:68:
   clause 3(typedExpressionIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] as expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR_base [ typedExpressionIR_hi : typedExpressionIR_lo ] # ( typeIR ))
      -- if (?(typedLvalueIR_base) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:331:1-335:68:
   clause 4(typedExpressionIR_base [ typedExpressionIR_l +: typedExpressionIR_w ] as expressionIR # ( typeIR _ctk )) = ?(typedLvalueIR_base [ typedExpressionIR_l +: typedExpressionIR_w ] # ( typeIR ))
      -- if (?(typedLvalueIR_base) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_base))

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:336:1-340:63:
   clause 5(( typedExpressionIR ) as expressionIR # ( typeIR _ctk )) = ?(( typedLvalueIR ) # ( typeIR ))
      -- if (?(typedLvalueIR) = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR))

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:350:27-350:41:
syntax emptyStatementIR = emptyStatement

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:357:3-357:47:
syntax assignmentStatementIR = 
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:364:3-364:69:
syntax callStatementIR = 
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:371:3-371:57:
syntax directApplicationStatementIR = 
   | constructorTargetIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:378:1-379:33:
syntax returnStatementIR = 
   | return ; (from returnStatementIR)
   | return typedExpressionIR ; (from returnStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:385:26-385:39:
syntax exitStatementIR = exitStatement

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:394:3-394:51:
syntax blockStatementIR = 
   | annotationList { blockElementStatementListIR } (from blockStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:403:1-404:60:
syntax conditionalStatementIR = 
   | if ( typedExpressionIR ) statementIR (from conditionalStatementIR)
   | if ( typedExpressionIR ) statementIR else statementIR (from conditionalStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:413:1-414:45:
syntax forUpdateStatementIR = 
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) (from forUpdateStatementIR)
   | typedLvalueIR assignop typedExpressionIR (from forUpdateStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:416:35-416:56:
syntax forUpdateStatementListIR = forUpdateStatementIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:419:1-420:25:
syntax forInitStatementIR = 
   | annotationList typeIR nameIR initializerOptIR (from forInitStatementIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) (from forUpdateStatementIR)
   | typedLvalueIR assignop typedExpressionIR (from forUpdateStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:422:33-422:52:
syntax forInitStatementListIR = forInitStatementIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:425:1-426:45:
syntax forCollectionExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")
   | typedExpressionIR .. typedExpressionIR (from forCollectionExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:429:1-437:18:
syntax forStatementIR = 
   | annotationList for ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR (from forStatementIR)
   | annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | annotationList for ( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:444:1-445:22:
syntax switchLabelIR = 
   | default (from switchLabelIR)
   | expressionIR # expressionNoteIR (from typedExpressionIR) hint(print %0) hint(prose %0 "annotated with" %1) hint(prose_fields "expression" "note")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:448:1-449:22:
syntax switchCaseIR = 
   | switchLabelIR : blockStatementIR (from switchCaseIR)
   | switchLabelIR : (from switchCaseIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:451:1-452:35:
def $switchLabelIR_of_switchCaseIR(switchCaseIR) : switchLabelIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:453:1-453:72:
   clause 0(switchLabelIR : _blockStatementIR) = switchLabelIR

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:454:1-454:70:
   clause 1(switchLabelIR :) = switchLabelIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:456:27-456:40:
syntax switchCaseListIR = switchCaseIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:459:3-459:56:
syntax switchStatementIR = 
   | switch ( typedExpressionIR ) { switchCaseListIR } (from switchStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:465:27-465:41:
syntax breakStatementIR = breakStatement

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:467:30-467:47:
syntax continueStatementIR = continueStatement

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:474:1-485:22:
syntax statementIR = 
   | ; (from emptyStatement)
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)
   | constructorTargetIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)
   | return ; (from returnStatementIR)
   | return typedExpressionIR ; (from returnStatementIR)
   | exit ; (from exitStatement)
   | annotationList { blockElementStatementListIR } (from blockStatementIR)
   | if ( typedExpressionIR ) statementIR (from conditionalStatementIR)
   | if ( typedExpressionIR ) statementIR else statementIR (from conditionalStatementIR)
   | annotationList for ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR (from forStatementIR)
   | annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | annotationList for ( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | break ; (from breakStatement)
   | continue ; (from continueStatement)
   | switch ( typedExpressionIR ) { switchCaseListIR } (from switchStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:496:3-496:63:
syntax constantDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:498:27-498:41:
syntax initializerOptIR = initializerIR?

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:501:3-501:52:
syntax variableDeclarationIR = 
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:504:1-506:16:
syntax blockElementStatementIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | ; (from emptyStatement)
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)
   | constructorTargetIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)
   | return ; (from returnStatementIR)
   | return typedExpressionIR ; (from returnStatementIR)
   | exit ; (from exitStatement)
   | annotationList { blockElementStatementListIR } (from blockStatementIR)
   | if ( typedExpressionIR ) statementIR (from conditionalStatementIR)
   | if ( typedExpressionIR ) statementIR else statementIR (from conditionalStatementIR)
   | annotationList for ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR (from forStatementIR)
   | annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | annotationList for ( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | break ; (from breakStatement)
   | continue ; (from continueStatement)
   | switch ( typedExpressionIR ) { switchCaseListIR } (from switchStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:508:38-508:62:
syntax blockElementStatementListIR = blockElementStatementIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:515:3-516:76:
syntax functionPrototypeIR = 
   | typeIR nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) (from functionPrototypeIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:519:3-519:54:
syntax functionDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:526:3-526:70:
syntax actionDeclarationIR = 
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:534:30-534:63:
syntax objectInitializerIR = 
   | = { objectDeclarationListIR } (from objectInitializerIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:536:33-536:53:
syntax objectInitializerOptIR = objectInitializerIR?

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:539:3-543:61:
syntax instantiationIR = 
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR) hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:546:1-547:20:
syntax objectDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR)
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR) hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:549:34-549:54:
syntax objectDeclarationListIR = objectDeclarationIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:551:1-553:57:
def $flatten_objectInitializerOptIR(objectInitializerOptIR) : objectDeclarationListIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:555:1-555:47:
   clause 0(?()) = []

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:556:1-557:28:
   clause 1(?(= { objectDeclarationListIR })) = objectDeclarationListIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:563:29-563:51:
syntax errorDeclarationIR = 
   | error { nameListIR } (from errorDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:569:33-569:60:
syntax matchKindDeclarationIR = 
   | match_kind { nameListIR } (from matchKindDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:580:1-581:61:
syntax enumTypeDeclarationIR = 
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedValueListIR } (from enumTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:587:22-587:54:
syntax typeFieldIR = 
   | annotationList typeIR nameIR ; (from typeFieldIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:589:26-589:38:
syntax typeFieldListIR = typeFieldIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:592:3-593:52:
syntax structTypeDeclarationIR = 
   | annotationList struct nameIR < typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:596:3-597:52:
syntax headerTypeDeclarationIR = 
   | annotationList header nameIR < typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:600:3-601:52:
syntax headerUnionTypeDeclarationIR = 
   | annotationList header_union nameIR < typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:604:1-607:33:
syntax derivedTypeDeclarationIR = 
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedValueListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:614:1-615:29:
syntax typedefIR = 
   | void (from voidTypeIR)
   | bool (from boolTypeIR)
   | error (from errorTypeIR)
   | match_kind (from matchKindTypeIR)
   | string (from stringTypeIR)
   | int (from intTypeIR)
   | int < nat > (from fixedIntTypeIR)
   | bit < nat > (from fixedBitTypeIR)
   | varbit < nat > (from varBitTypeIR)
   | typeId (from nameTypeIR) hint(print %0)
   | typedef typeId typeIR (from typedefTypeIR) hint(print %0)
   | type typeId typeIR (from newTypeIR) hint(print %0)
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | array typeIR [ nat ] (from arrayTypeIR)
   | header_stack typeIR [ nat ] (from headerStackTypeIR)
   | struct typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR) hint(print %0#"<"#%1#">")
   | header typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR) hint(print %0#"<"#%1#">")
   | header_union typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR) hint(print %0#"<"#%1#">")
   | enum typeId { nameIR* } (from simpleEnumTypeIR) hint(print %0)
   | enum typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR) hint(print %0)
   | extern typeId < typeArgumentIR* > externMethodTypeDefEnv (from externObjectTypeIR) hint(print %0#"<"#%1#">")
   | parser typeId < typeArgumentIR* > ( parameterIR* ) (from parserObjectTypeIR) hint(print %0#"<"#%1#">")
   | control typeId < typeArgumentIR* > ( parameterIR* ) (from controlObjectTypeIR) hint(print %0#"<"#%1#">")
   | package typeId < typeArgumentIR* > { typeIR* } (from packageObjectTypeIR) hint(print %0#"<"#%1#">")
   | table typeId { tableMetadataStructTypeIR } (from tableObjectTypeIR) hint(print %0)
   | default (from defaultTypeIR)
   | header_invalid (from invalidHeaderTypeIR)
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)
   | set < typeIR > (from setTypeIR)
   | table_enum typeId { nameIR* } (from tableMetadataEnumTypeIR) hint(print %0)
   | table_struct typeId { hit boolTypeIR ; miss boolTypeIR ; action_run tableMetadataEnumTypeIR ; } (from tableMetadataStructTypeIR) hint(print %0)
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedValueListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:618:1-619:42:
syntax typedefDeclarationIR = 
   | annotationList typedef typedefIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:626:3-626:48:
syntax externFunctionDeclarationIR = 
   | annotationList extern functionPrototypeIR ; (from externFunctionDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:629:3-629:80:
syntax externConstructorPrototypeIR = 
   | annotationList nameIR < , typeParameterListIR > ( parameterListIR ) ; (from externConstructorPrototypeIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:631:43-631:72:
syntax externConstructorPrototypeListIR = externConstructorPrototypeIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:634:1-635:52:
syntax externMethodPrototypeIR = 
   | annotationList functionPrototypeIR ; (from externMethodPrototypeIR)
   | annotationList abstract functionPrototypeIR ; (from externMethodPrototypeIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:637:38-637:62:
syntax externMethodPrototypeListIR = externMethodPrototypeIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:640:3-642:38:
syntax externObjectDeclarationIR = 
   | annotationList extern nameIR < typeParameterListIR , > { externConstructorPrototypeListIR externMethodPrototypeListIR } (from externObjectDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:645:1-646:30:
syntax externDeclarationIR = 
   | annotationList extern functionPrototypeIR ; (from externFunctionDeclarationIR)
   | annotationList extern nameIR < typeParameterListIR , > { externConstructorPrototypeListIR externMethodPrototypeListIR } (from externObjectDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:656:23-656:56:
syntax selectCaseIR = 
   | keysetExpressionIR : nameIR ; (from selectCaseIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:658:27-658:40:
syntax selectCaseListIR = selectCaseIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:661:3-661:60:
syntax selectExpressionIR = 
   | select ( typedExpressionListIR ) { selectCaseListIR } (from selectExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:668:1-669:23:
syntax stateExpressionIR = 
   | nameIR ; (from stateExpressionIR)
   | select ( typedExpressionListIR ) { selectCaseListIR } (from selectExpressionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:671:32-671:60:
syntax transitionStatementIR = 
   | transition stateExpressionIR (from transitionStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:678:3-678:75:
syntax valueSetDeclarationIR = 
   | annotationList value_set < typeIR > ( typedExpressionIR ) nameIR ; (from valueSetDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:685:3-686:80:
syntax parserTypeDeclarationIR = 
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:694:44-694:74:
syntax parserBlockElementStatementListIR = parserBlockElementStatementIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:697:3-697:57:
syntax parserBlockStatementIR = 
   | annotationList { parserBlockElementStatementListIR } (from parserBlockStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:700:1-701:72:
syntax parserConditionalStatementIR = 
   | if ( typedExpressionIR ) parserStatementIR (from parserConditionalStatementIR)
   | if ( typedExpressionIR ) parserStatementIR else parserStatementIR (from parserConditionalStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:704:1-709:33:
syntax parserStatementIR = 
   | ; (from emptyStatement)
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)
   | constructorTargetIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)
   | annotationList { parserBlockElementStatementListIR } (from parserBlockStatementIR)
   | if ( typedExpressionIR ) parserStatementIR (from parserConditionalStatementIR)
   | if ( typedExpressionIR ) parserStatementIR else parserStatementIR (from parserConditionalStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:712:1-714:22:
syntax parserBlockElementStatementIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | ; (from emptyStatement)
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)
   | callableTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)
   | constructorTargetIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)
   | annotationList { parserBlockElementStatementListIR } (from parserBlockStatementIR)
   | if ( typedExpressionIR ) parserStatementIR (from parserConditionalStatementIR)
   | if ( typedExpressionIR ) parserStatementIR else parserStatementIR (from parserConditionalStatementIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:717:3-718:66:
syntax parserStateIR = 
   | annotationList state nameIR { parserBlockElementStatementListIR transitionStatementIR } (from parserStateIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:720:28-720:42:
syntax parserStateListIR = parserStateIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:723:1-726:26:
syntax parserLocalDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR) hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | annotationList value_set < typeIR > ( typedExpressionIR ) nameIR ; (from valueSetDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:729:3-729:28:
syntax parserLocalDeclarationListIR = parserLocalDeclarationIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:732:3-735:57:
syntax parserDeclarationIR = 
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:745:18-745:23:
syntax constIR = const

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:747:21-747:29:
syntax constOptIR = constIR?

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:753:21-753:79:
syntax tableKeyIR = 
   | typedExpressionIR # nameIR : nameIR annotationList ; (from tableKeyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:755:25-755:36:
syntax tableKeyListIR = tableKeyIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:761:29-761:36:
syntax controlPlaneNameIR = nameIR?

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:764:3-764:57:
syntax tableActionReferenceIR = 
   | prefixedNameIR controlPlaneNameIR ( argumentListIR ) (from tableActionReferenceIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:767:3-768:54:
syntax tableActionIR = 
   | annotationList tableActionReferenceIR # ( parameterListIR , parameterListIR ) ; (from tableActionIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:770:28-770:42:
syntax tableActionListIR = tableActionIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:776:31-776:62:
syntax tableEntryPriorityIR = 
   | priority = integerLiteral : (from tableEntryPriorityIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:778:34-778:55:
syntax tableEntryPriorityOptIR = tableEntryPriorityIR?

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:781:3-782:69:
syntax tableEntryIR = 
   | constOptIR tableEntryPriorityOptIR keysetExpressionIR : tableActionReferenceIR annotationList ; (from tableEntryIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:784:1-786:38:
def $tableEntryPriorityOptIR_of_tableEntryIR(tableEntryIR) : tableEntryPriorityOptIR =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:787:1-789:63:
   clause 0(tableEntryIR) = tableEntryPriorityOptIR
      -- if (_constOptIR tableEntryPriorityOptIR _keysetExpressionIR : _tableActionReferenceIR _annotationList ; = tableEntryIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:791:27-791:40:
syntax tableEntryListIR = tableEntryIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:803:30-803:58:
syntax tableKeysPropertyIR = 
   | key = { tableKeyListIR } (from tableKeysPropertyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:805:33-805:68:
syntax tableActionsPropertyIR = 
   | actions = { tableActionListIR } (from tableActionsPropertyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:808:3-808:74:
syntax tableDefaultActionPropertyIR = 
   | annotationList constOptIR default_action = tableActionReferenceIR ; (from tableDefaultActionPropertyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:811:3-811:63:
syntax tableEntriesPropertyIR = 
   | annotationList constOptIR entries = { tableEntryListIR } (from tableEntriesPropertyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:815:1-816:76:
syntax tableCustomPropertyIR = 
   | annotationList constOptIR custom nameIR initializerIR ; (from tableCustomPropertyIR)
   | annotationList constOptIR custom_const nameIR constantInitializerIR ; (from tableCustomPropertyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:819:1-823:26:
syntax tablePropertyIR = 
   | key = { tableKeyListIR } (from tableKeysPropertyIR)
   | actions = { tableActionListIR } (from tableActionsPropertyIR)
   | annotationList constOptIR default_action = tableActionReferenceIR ; (from tableDefaultActionPropertyIR)
   | annotationList constOptIR entries = { tableEntryListIR } (from tableEntriesPropertyIR)
   | annotationList constOptIR custom nameIR initializerIR ; (from tableCustomPropertyIR)
   | annotationList constOptIR custom_const nameIR constantInitializerIR ; (from tableCustomPropertyIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:825:30-825:46:
syntax tablePropertyListIR = tablePropertyIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:828:3-829:36:
syntax tableDeclarationIR = 
   | annotationList table typeIR nameIR { tablePropertyListIR } (from tableDeclarationIR) hint(print %0 TABLE %2 `{%3})

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:836:3-838:30:
syntax controlTypeDeclarationIR = 
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:844:24-844:40:
syntax controlBodyIR = blockStatementIR

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:847:1-851:23:
syntax controlLocalDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR) hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR)
   | annotationList table typeIR nameIR { tablePropertyListIR } (from tableDeclarationIR) hint(print %0 TABLE %2 `{%3})

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:854:3-854:29:
syntax controlLocalDeclarationListIR = controlLocalDeclarationIR*

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:857:3-860:60:
syntax controlDeclarationIR = 
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:867:3-869:30:
syntax packageTypeDeclarationIR = 
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:876:1-880:29:
syntax typeDeclarationIR = 
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedValueListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)
   | annotationList typedef typedefIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:887:1-896:22:
syntax declarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR constructorTargetIR ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR) hint(prose_fields "annotations" "type" "constructor target" "arguments" "name" "object initializer")
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR)
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR)
   | error { nameListIR } (from errorDeclarationIR)
   | match_kind { nameListIR } (from matchKindDeclarationIR)
   | annotationList extern functionPrototypeIR ; (from externFunctionDeclarationIR)
   | annotationList extern nameIR < typeParameterListIR , > { externConstructorPrototypeListIR externMethodPrototypeListIR } (from externObjectDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserDeclarationIR)
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlDeclarationIR)
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedValueListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)
   | annotationList typedef typedefIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.0-ir-syntax.spectec:902:22-902:40:
syntax p4programIR = 
   | declarationIR* ; (from p4programIR)

;; ../../../../../spectec/specs/p4/4-p4-ir/4.1-ir-call-helper.spectec:8:1-9:47:
def $partition_parameterListIR(parameterIR*, nameIR*, nameIR*) : (parameterIR*, parameterIR*, parameterIR*) =

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.1-ir-call-helper.spectec:11:1-11:60:
   clause 0([], _nameIR*{}, _nameIR'*{}) = ([], [], [])

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.1-ir-call-helper.spectec:13:1-24:36:
   clause 1(parameterIR_h :: parameterIR_t*{}, nameIR_default*{}, nameIR_optional*{}) = (parameterIR_given*{}, parameterIR_h :: parameterIR_default*{}, parameterIR_optional*{})
      -- if ((parameterIR_given*{}, parameterIR_default*{}, parameterIR_optional*{}) = $partition_parameterListIR(parameterIR_t*{}, nameIR_default*{}, nameIR_optional*{}))
      -- if (_annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h)
      -- if nameIR_h <- nameIR_default*{}

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.1-ir-call-helper.spectec:26:1-37:37:
   clause 2(parameterIR_h :: parameterIR_t*{}, nameIR_default*{}, nameIR_optional*{}) = (parameterIR_given*{}, parameterIR_default*{}, parameterIR_h :: parameterIR_optional*{})
      -- if ((parameterIR_given*{}, parameterIR_default*{}, parameterIR_optional*{}) = $partition_parameterListIR(parameterIR_t*{}, nameIR_default*{}, nameIR_optional*{}))
      -- if (_annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h)
      -- if nameIR_h <- nameIR_optional*{}

   ;; ../../../../../spectec/specs/p4/4-p4-ir/4.1-ir-call-helper.spectec:39:1-51:40:
   clause 3(parameterIR_h :: parameterIR_t*{}, nameIR_default*{}, nameIR_optional*{}) = (parameterIR_h :: parameterIR_given*{}, parameterIR_default*{}, parameterIR_optional*{})
      -- if ((parameterIR_given*{}, parameterIR_default*{}, parameterIR_optional*{}) = $partition_parameterListIR(parameterIR_t*{}, nameIR_default*{}, nameIR_optional*{}))
      -- if (_annotationList _direction _typeIR nameIR_h _parameterInitializerOptIR = parameterIR_h)
      -- if ~nameIR_h <- nameIR_default*{}
      -- if ~nameIR_h <- nameIR_optional*{}

