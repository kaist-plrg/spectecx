      -- otherwise

;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:29:1-31:59:
def $compat_table_key(nameIR, typeIR) : bool =

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:33:1-35:49:
   clause 0(nameIR, typeIR) = true
      -- if (((nameIR = "exact") \/ (nameIR = "optional")) \/ (nameIR = "selector"))
      -- if $compat_table_exact_optional_key(typeIR)

   ;; ../../../../../spectec/specs/p4/5-typing/5.14.1-typing-control-table.spectec:36:1-38:52:
