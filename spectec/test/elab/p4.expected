   clause 1(externMethodDefEnv, { callableId_h : callableDef_h :: callableId_t : callableDef_t*{} }) = $merge_externMethodDefEnvs(externMethodDefEnv_post, { callableId_t : callableDef_t*{} })
      -- if (function nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR as callableDef = callableDef_h)
      -- if (externMethodDef_h = extern_method nameIR < typeParameterListIR > ( parameterListIR ) ?(blockStatementIR))
      -- if (externMethodDefEnv_post = $update_map<callableId, externMethodDef>(externMethodDefEnv, callableId_h, externMethodDef_h))

