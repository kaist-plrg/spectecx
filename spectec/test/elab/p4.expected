;; ../../../../../spectec/specs/p4/2-static-runtime/2.3.1-type-callable.spectec:82:1-86:27:
syntax methodTypeIR = 
   | builtin_is_valid (from builtinIsValidMethodTypeIR)
   | builtin_set_valid (from builtinSetValidMethodTypeIR)
   | builtin_set_invalid (from builtinSetInvalidMethodTypeIR)
   | builtin_push_front (from builtinPushFrontMethodTypeIR)
   | builtin_pop_front (from builtinPopFrontMethodTypeIR)
   | builtin_size_of (from builtinSizeMethodTypeIR)
   | extern_method nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR)
   | extern_method abstract nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR)
   | parser_apply ( parameterIR* ) (from parserApplyMethodTypeIR)
   | control_apply ( parameterIR* ) (from controlApplyMethodTypeIR)
   | table_apply : tableMetadataStructTypeIR (from tableApplyMethodTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.3.1-type-callable.spectec:93:1-95:17:
syntax callableTypeIR = 
   | annotationList action nameIR ( parameterIR* ) (from actionTypeIR)
   | function nameIR ( parameterIR* ) : typeIR (from definedFunctionTypeIR)
   | extern_function nameIR ( parameterIR* ) : typeIR (from externFunctionTypeIR)
   | builtin_is_valid (from builtinIsValidMethodTypeIR)
   | builtin_set_valid (from builtinSetValidMethodTypeIR)
   | builtin_set_invalid (from builtinSetInvalidMethodTypeIR)
   | builtin_push_front (from builtinPushFrontMethodTypeIR)
   | builtin_pop_front (from builtinPopFrontMethodTypeIR)
   | builtin_size_of (from builtinSizeMethodTypeIR)
   | extern_method nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR)
   | extern_method abstract nameIR ( parameterIR* ) : typeIR (from externMethodTypeIR)
   | parser_apply ( parameterIR* ) (from parserApplyMethodTypeIR)
   | control_apply ( parameterIR* ) (from controlApplyMethodTypeIR)
   | table_apply : tableMetadataStructTypeIR (from tableApplyMethodTypeIR)

