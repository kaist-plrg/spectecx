   | block (from cursor)
   | local (from cursor)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:13:17-13:21:
syntax nameIR = text

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:15:1-16:34:
def $name(name) : nameIR =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:17:1-17:27:
   clause 0(text as name) = text

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:18:1-18:28:
   clause 1(text as name) = text

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:19:1-19:27:
   clause 2(apply as name) = "apply"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:20:1-20:23:
   clause 3(key as name) = "key"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:21:1-21:31:
   clause 4(actions as name) = "actions"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:22:1-22:27:
   clause 5(state as name) = "state"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:23:1-23:31:
   clause 6(entries as name) = "entries"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:24:1-24:25:
   clause 7(type as name) = "type"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:25:1-25:33:
   clause 8(priority as name) = "priority"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:26:1-26:25:
   clause 9(list) = "list"

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:28:1-29:34:
def $tableCustomName(tableCustomName) : nameIR =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:30:1-30:38:
   clause 0(text as tableCustomName) = text

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:31:1-31:39:
   clause 1(text as tableCustomName) = text

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:32:1-32:38:
   clause 2(apply) = "apply"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:33:1-33:38:
   clause 3(state) = "state"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:34:1-34:36:
   clause 4(type) = "type"

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:35:1-35:44:
   clause 5(priority) = "priority"

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:41:13-41:19:
syntax id = nameIR

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:47:17-47:23:
syntax typeId = nameIR

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:49:1-50:41:
builtin dec $fresh_typeId : typeId

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:52:1-53:43:
def $fresh_typeIds(nat) : typeId* =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:54:1-54:28:
   clause 0(0) = []

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:55:1-57:22:
   clause 1(n) = $fresh_typeId :: $fresh_typeIds(n')
      -- if (n =/= 0)
      -- if (n' = (n - 1))

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:65:23-65:39:
syntax callTargetId = 
   | nameIR ( id* ) (from callTargetId)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:66:21-66:33:
syntax callableId = callTargetId

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:67:24-67:36:
syntax constructorId = callTargetId

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:69:1-70:59:
def $callableId(name, parameterList) : callableId =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:76:1-77:50:
   clause 0(name, parameterList) = $name(name) ( $callableId'(parameterList) )

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:71:1-71:38:
def $callableId'(parameterList) : id* =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:82:1-82:31:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:83:1-83:45:
   clause 1(_annotationList _direction _type name _initializerOpt as parameterList) = [$name(name)]

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:84:1-85:59:
   clause 2(nonEmptyParameterList , _annotationList _direction _type name _initializerOpt as parameterList) = $callableId'(nonEmptyParameterList as parameterList) ++ [$name(name)]

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:73:1-74:56:
def $constructorId(name, constructorParameterListOpt) : constructorId =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:79:1-79:57:
   clause 0(name, ) = $name(name) ( [] )

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:80:1-80:81:
   clause 1(name, ( parameterList )) = $callableId(name, parameterList)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:91:19-91:26:
syntax objectId = nameIR*

;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:93:1-95:69:
def $objectId_ends_with(objectId, nameIR) : bool =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:97:1-98:42:
   clause 0(objectId, nameIR) = true
      -- if (nameIR :: _nameIR*{} = $rev_<id>(objectId))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.0-domain.spectec:99:1-100:15:
   clause 1(objectId, nameIR) = false
      -- otherwise

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:9:20-9:27:
syntax boolValue = 
   | bool (from boolValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:10:21-10:37:
syntax errorValue = 
   | error . nameIR (from errorValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:11:25-11:46:
syntax matchKindValue = 
   | match_kind . nameIR (from matchKindValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:12:22-12:35:
syntax stringValue = stringLiteral

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:15:1-16:22:
syntax integerValue = 
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | nat . nat v int (from integerValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:19:1-23:17:
syntax baseValue = 
   | bool (from boolValue)
   | error . nameIR (from errorValue)
   | match_kind . nameIR (from matchKindValue)
   | " text " (from stringLiteral) hint(print "#%#")
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | nat . nat v int (from integerValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:31:20-31:37:
syntax listValue = 
   | list [ value* ] (from listValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:32:21-32:39:
syntax tupleValue = 
   | tuple ( value* ) (from tupleValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:33:21-33:39:
syntax arrayValue = 
   | array [ value* ] (from arrayValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:34:27-34:62:
syntax headerStackValue = 
   | header_stack [ value* ( nat ) ] (from headerStackValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:36:21-36:37:
syntax fieldValue = 
   | value nameIR ; (from fieldValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:38:22-38:53:
syntax structValue = 
   | struct typeId { fieldValue* } (from structValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:39:22-39:62:
syntax headerValue = 
   | header typeId { bool ; fieldValue* } (from headerValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:40:27-40:64:
syntax headerUnionValue = 
   | header_union typeId { fieldValue* } (from headerUnionValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:43:1-44:32:
syntax enumValue = 
   | typeId . nameIR (from enumValue)
   | typeId . nameIR . value (from enumValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:47:1-54:14:
syntax dataValue = 
   | list [ value* ] (from listValue)
   | tuple ( value* ) (from tupleValue)
   | array [ value* ] (from arrayValue)
   | header_stack [ value* ( nat ) ] (from headerStackValue)
   | struct typeId { fieldValue* } (from structValue)
   | header typeId { bool ; fieldValue* } (from headerValue)
   | header_union typeId { fieldValue* } (from headerUnionValue)
   | typeId . nameIR (from enumValue)
   | typeId . nameIR . value (from enumValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:60:31-60:43:
syntax objectReferenceValue = 
   | ref objectId (from objectReferenceValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:66:23-66:30:
syntax defaultValue = 
   | default (from defaultValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:68:29-68:34:
syntax invalidHeaderValue = 
   | {#} (from invalidHeaderValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:71:1-72:31:
syntax sequenceValue = 
   | seq ( value* ) (from sequenceValue)
   | seq ( value* , ... ) (from sequenceValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:75:1-76:39:
syntax recordValue = 
   | record { fieldValue* } (from recordValue)
   | record { fieldValue* , ... } (from recordValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:79:1-83:20:
syntax setValue = 
   | set { value } (from setValue)
   | set { value* ( nat ) } (from setValue)
   | set { value &&& value } (from setValue)
   | set { value .. value } (from setValue)
   | set { ... } (from setValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:85:33-85:61:
syntax tableMetadataEnumValue = 
   | table_enum typeId . nameIR (from tableMetadataEnumValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:88:3-90:66:
syntax tableMetadataStructValue = 
   | table_struct typeId { hit boolValue ; miss boolValue ; action_run tableMetadataEnumValue ; } (from tableMetadataStructValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:93:1-94:29:
syntax tableMetadataValue = 
   | table_enum typeId . nameIR (from tableMetadataEnumValue)
   | table_struct typeId { hit boolValue ; miss boolValue ; action_run tableMetadataEnumValue ; } (from tableMetadataStructValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:97:1-102:23:
syntax synthesizedValue = 
   | default (from defaultValue)
   | {#} (from invalidHeaderValue)
   | seq ( value* ) (from sequenceValue)
   | seq ( value* , ... ) (from sequenceValue)
   | record { fieldValue* } (from recordValue)
   | record { fieldValue* , ... } (from recordValue)
   | set { value } (from setValue)
   | set { value* ( nat ) } (from setValue)
   | set { value &&& value } (from setValue)
   | set { value .. value } (from setValue)
   | set { ... } (from setValue)
   | table_enum typeId . nameIR (from tableMetadataEnumValue)
   | table_struct typeId { hit boolValue ; miss boolValue ; action_run tableMetadataEnumValue ; } (from tableMetadataStructValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.1-value.spectec:109:1-112:21:
syntax value = 
   | bool (from boolValue)
   | error . nameIR (from errorValue)
   | match_kind . nameIR (from matchKindValue)
   | " text " (from stringLiteral) hint(print "#%#")
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | nat . nat v int (from integerValue)
   | list [ value* ] (from listValue)
   | tuple ( value* ) (from tupleValue)
   | array [ value* ] (from arrayValue)
   | header_stack [ value* ( nat ) ] (from headerStackValue)
   | struct typeId { fieldValue* } (from structValue)
   | header typeId { bool ; fieldValue* } (from headerValue)
   | header_union typeId { fieldValue* } (from headerUnionValue)
   | typeId . nameIR (from enumValue)
   | typeId . nameIR . value (from enumValue)
   | ref objectId (from objectReferenceValue)
   | default (from defaultValue)
   | {#} (from invalidHeaderValue)
   | seq ( value* ) (from sequenceValue)
   | seq ( value* , ... ) (from sequenceValue)
   | record { fieldValue* } (from recordValue)
   | record { fieldValue* , ... } (from recordValue)
   | set { value } (from setValue)
   | set { value* ( nat ) } (from setValue)
   | set { value &&& value } (from setValue)
   | set { value .. value } (from setValue)
   | set { ... } (from setValue)
   | table_enum typeId . nameIR (from tableMetadataEnumValue)
   | table_struct typeId { hit boolValue ; miss boolValue ; action_run tableMetadataEnumValue ; } (from tableMetadataStructValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:5:1-6:85:
builtin dec $bitstr_to_int(int, int) : int

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:13:1-14:75:
builtin dec $int_to_bitstr(int, int) : int

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:20:14-20:18:
syntax bit = bool

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:21:15-21:19:
syntax bits = bit*

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:23:1-23:46:
builtin dec $bits_to_int_unsigned(bits) : int

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:24:1-24:44:
builtin dec $bits_to_int_signed(bits) : int

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:26:1-26:51:
builtin dec $int_to_bits_unsigned(nat, int) : bits

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:27:1-27:49:
builtin dec $int_to_bits_signed(nat, int) : bits

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:33:1-34:53:
def $int_of_integerValue(integerValue) : int =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:36:1-36:34:
   clause 0(d i as integerValue) = i

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:37:1-37:55:
   clause 1(w s i as integerValue) = $bitstr_to_int(w as int, i)

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:38:1-38:36:
   clause 2(w w i as integerValue) = i

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:39:1-39:42:
   clause 3(_nat . _nat' v i) = i

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:41:1-42:60:
def $nat_of_integerValue(integerValue) : nat? =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:44:1-45:47:
   clause 0(integerValue) = ?(n)
      -- if (n as int = $int_of_integerValue(integerValue))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:46:1-47:15:
   clause 1(integerValue) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:53:1-53:65:
def $update_fieldValue(fieldValue*, nameIR, value) : fieldValue* =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:55:1-55:49:
   clause 0([], nameIR, value) = []

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:57:1-61:32:
   clause 1(value_field_h nameIR_field_h ; :: fieldValue_t*{}, nameIR, value) = value nameIR ; :: fieldValue_t*{}
      -- if (nameIR_field_h = nameIR)

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:63:1-68:34:
   clause 2(value_field_h nameIR_field_h ; :: fieldValue_t*{}, nameIR, value) = value_field_h nameIR_field_h ; :: $update_fieldValue(fieldValue_t*{}, nameIR, value)
      -- if (nameIR_field_h =/= nameIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:74:1-74:59:
def $update_headerUnion(fieldValue*, nameIR) : fieldValue* =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:76:1-76:43:
   clause 0([], nameIR) = []

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:77:1-81:32:
   clause 1(value_field_h nameIR_field_h ; :: fieldValue_t*{}, nameIR) = value_field_h nameIR_field_h ; :: $update_headerUnion(fieldValue_t*{}, nameIR)
      -- if (nameIR_field_h = nameIR)

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:82:1-88:73:
   clause 2(value_field_h nameIR_field_h ; :: fieldValue_t*{}, nameIR) = value_field_h_update nameIR_field_h ; :: $update_headerUnion(fieldValue_t*{}, nameIR)
      -- if (nameIR_field_h =/= nameIR)
      -- if (header typeId { _bool ; fieldValue*{} } as value = value_field_h)
      -- if (value_field_h_update = header typeId { false ; fieldValue*{} } as value)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:98:1-98:34:
def $isValid_header(value) : bool =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:99:1-100:51:
   clause 0(headerValue as value) = b_valid
      -- if (header _typeId { b_valid ; _fieldValue*{} } = headerValue)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:106:1-106:37:
def $invalidate_value(value) : value =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:116:1-117:36:
   clause 0(headerValue as value) = $invalidate_header(headerValue) as value

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:118:1-119:46:
   clause 1(headerUnionValue as value) = $invalidate_headerUnion(headerUnionValue) as value

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:107:1-107:50:
def $invalidate_header(headerValue) : headerValue =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:110:1-111:46:
   clause 0(header typeId { _bool ; fieldValue*{} }) = header typeId { false ; fieldValue*{} }

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:108:1-108:65:
def $invalidate_headerUnion(headerUnionValue) : headerUnionValue =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:112:1-114:68:
   clause 0(header_union typeId { value_field nameIR_field ;*{} }) = header_union typeId { value_field_invalidated nameIR_field ;*{} }
      -- (if (value_field_invalidated = $invalidate_value(value_field)))*

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:125:1-125:54:
def $write_value_from_bits(value, nat, bool*) : value =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:131:1-133:50:
   clause 0(value, n_var, b*{}) = value_updated
      -- if ((value_updated, []) = $write_value_from_bits'(value, n_var, b*{}))

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:126:1-126:64:
def $write_value_from_bits'(value, nat, bool*) : (value, bool*) =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:135:1-135:71:
   clause 0(_bool as value, n_var, b_h :: b_t*{}) = (b_h as value, b_t*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:136:1-141:59:
   clause 1(w w _int as value, n_var, b*{}) = (w w i as value, b_t*{})
      -- if (|b*{}| >= w)
      -- if (b_h*{} = b*{}[0 : w])
      -- if (n_t = (|b*{}| - w))
      -- if (b_t*{} = b*{}[w : n_t])
      -- if (i = $int_to_bitstr(w as int, $bits_to_int_unsigned(b_h*{})))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:142:1-147:57:
   clause 2(w s _int as value, n_var, b*{}) = (w s i as value, b_t*{})
      -- if (|b*{}| >= w)
      -- if (b_h*{} = b*{}[0 : w])
      -- if (n_t = (|b*{}| - w))
      -- if (b_t*{} = b*{}[w : n_t])
      -- if (i = $int_to_bitstr(w as int, $bits_to_int_signed(b_h*{})))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:148:1-148:76:
   clause 3(n_max . _nat v i as value, 0, b*{}) = (n_max . 0 v i as value, b*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:149:1-155:61:
   clause 4(n_max . _nat v _int as value, n_var, b*{}) = (n_max . n_var v i as value, b_t*{})
      -- if (n_var =/= 0)
      -- if (|b*{}| >= n_var)
      -- if (b_h*{} = b*{}[0 : n_var])
      -- if (n_t = (|b*{}| - n_var))
      -- if (b_t*{} = b*{}[n_var : n_t])
      -- if (i = $int_to_bitstr(n_var as int, $bits_to_int_signed(b_h*{})))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:181:1-185:63:
   clause 5(struct typeId { fieldValue*{} } as value, n_var, b*{}) = (struct typeId { fieldValue_updated*{} } as value, b_rest*{})
      -- if ((fieldValue_updated*{}, b_rest*{}) = $write_value_fields_from_bits'(fieldValue*{}, n_var, b*{}))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:186:1-190:63:
   clause 6(header typeId { _bool ; fieldValue*{} } as value, n_var, b*{}) = (header typeId { true ; fieldValue_updated*{} } as value, b_rest*{})
      -- if ((fieldValue_updated*{}, b_rest*{}) = $write_value_fields_from_bits'(fieldValue*{}, n_var, b*{}))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:192:1-195:77:
   clause 7(typeId . nameIR . value as value, n_var, b*{}) = (typeId . "__UNSPECIFIED" . value_updated as value, b_rest*{})
      -- if ((value_updated, b_rest*{}) = $write_value_from_bits'(value, n_var, b*{}))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:197:1-200:80:
   clause 8(array [ value*{} ] as value, n_var, b*{}) = (array [ value_updated*{} ] as value, b_rest*{})
      -- if ((value_updated*{}, b_rest*{}) = $write_values_from_bits'(value*{}, n_var, b*{}))

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:202:1-205:80:
   clause 9(header_stack [ value*{} ( n_idx ) ] as value, n_var, b*{}) = (header_stack [ value_updated*{} ( n_idx ) ] as value, b_rest*{})
      -- if ((value_updated*{}, b_rest*{}) = $write_values_from_bits'(value*{}, n_var, b*{}))

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:127:1-127:67:
def $write_values_from_bits'(value*, nat, bool*) : (value*, bool*) =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:157:1-157:57:
   clause 0([], n_var, b*{}) = ([], b*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:158:1-164:56:
   clause 1(value_h :: value_t*{}, n_var, b*{}) = (value_h_updated :: value_t_updated*{}, b_rest*{})
      -- if ((value_h_updated, b_t*{}) = $write_value_from_bits'(value_h, n_var, b*{}))
      -- if ((value_t_updated*{}, b_rest*{}) = $write_values_from_bits'(value_t*{}, n_var, b_t*{}))

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:128:1-128:83:
def $write_value_fields_from_bits'(fieldValue*, nat, bool*) : (fieldValue*, bool*) =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:166:1-166:63:
   clause 0([], n_var, b*{}) = ([], b*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:167:1-173:67:
   clause 1(fieldValue_h :: fieldValue_t*{}, n_var, b*{}) = (fieldValue_h_updated :: fieldValue_t_updated*{}, b_rest*{})
      -- if ((fieldValue_h_updated, b_t*{}) = $write_value_field_from_bits'(fieldValue_h, n_var, b*{}))
      -- if ((fieldValue_t_updated*{}, b_rest*{}) = $write_value_fields_from_bits'(fieldValue_t*{}, n_var, b_t*{}))

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:129:1-129:80:
def $write_value_field_from_bits'(fieldValue, nat, bool*) : (fieldValue, bool*) =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:175:1-179:50:
   clause 0(value id ;, n_var, b*{}) = (value_updated id ;, b_rest*{})
      -- if ((value_updated, b_rest*{}) = $write_value_from_bits'(value, n_var, b*{}))

;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:211:1-211:42:
def $write_bits_from_value(value) : bool* =

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:213:1-213:41:
   clause 0(b as value) = [b]

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:214:1-215:30:
   clause 1(w s i as value) = $int_to_bits_signed(w, i)

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:216:1-217:32:
   clause 2(w w i as value) = $int_to_bits_unsigned(w, i)

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:218:1-219:32:
   clause 3(_nat . w v i as value) = $int_to_bits_unsigned(w, i)

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:221:1-223:59:
   clause 4(array [ value_element*{} ] as value) = $concat_<bool>($write_bits_from_value(value_element)*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:225:1-227:59:
   clause 5(header_stack [ value_element*{} ( _nat ) ] as value) = $concat_<bool>($write_bits_from_value(value_element)*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:229:1-231:57:
   clause 6(struct _typeId { value_field id_field ;*{} } as value) = $concat_<bool>($write_bits_from_value(value_field)*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:232:1-234:57:
   clause 7(header _typeId { true ; value_field id_field ;*{} } as value) = $concat_<bool>($write_bits_from_value(value_field)*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:235:1-235:61:
   clause 8(header _typeId { false ; _fieldValue*{} } as value) = []

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:236:1-238:51:
   clause 9(header_union _typeId { value id ;*{} } as value) = $concat_<bool>($write_bits_from_value(value)*{})

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.1.2-value-aux.spectec:240:1-241:34:
   clause 10(typeId . id . value as value) = $write_bits_from_value(value)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:12:21-12:25:
syntax voidTypeIR = 
   | void (from voidTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:13:21-13:25:
syntax boolTypeIR = 
   | bool (from boolTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:14:22-14:27:
syntax errorTypeIR = 
   | error (from errorTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:15:26-15:36:
syntax matchKindTypeIR = 
   | match_kind (from matchKindTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:16:23-16:29:
syntax stringTypeIR = 
   | string (from stringTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:18:20-18:23:
syntax intTypeIR = 
   | int (from intTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:19:25-19:38:
syntax fixedIntTypeIR = 
   | int < nat > (from fixedIntTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:20:25-20:38:
syntax fixedBitTypeIR = 
   | bit < nat > (from fixedBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:21:23-21:39:
syntax varBitTypeIR = 
   | varbit < nat > (from varBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:24:1-27:17:
syntax integerTypeIR = 
   | int (from intTypeIR)
   | int < nat > (from fixedIntTypeIR)
   | bit < nat > (from fixedBitTypeIR)
   | varbit < nat > (from varBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:30:1-35:18:
syntax baseTypeIR = 
   | void (from voidTypeIR)
   | bool (from boolTypeIR)
   | error (from errorTypeIR)
   | match_kind (from matchKindTypeIR)
   | string (from stringTypeIR)
   | int (from intTypeIR)
   | int < nat > (from fixedIntTypeIR)
   | bit < nat > (from fixedBitTypeIR)
   | varbit < nat > (from varBitTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:41:21-41:48:
syntax nameTypeIR = 
   | typeId (from nameTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:48:3-49:17:
syntax typedefTypeIR = 
   | typedef typeId typeIR (from typedefTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:52:3-53:17:
syntax newTypeIR = 
   | type typeId typeIR (from newTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:56:1-57:14:
syntax aliasTypeIR = 
   | typedef typeId typeIR (from typedefTypeIR) hint(print %0)
   | type typeId typeIR (from newTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:63:21-63:38:
syntax listTypeIR = 
   | list < typeIR > (from listTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:64:22-64:41:
syntax tupleTypeIR = 
   | tuple < typeIR* > (from tupleTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:65:22-65:44:
syntax arrayTypeIR = 
   | array typeIR [ nat ] (from arrayTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:66:28-66:57:
syntax headerStackTypeIR = 
   | header_stack typeIR [ nat ] (from headerStackTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:68:22-68:54:
syntax fieldTypeIR = 
   | annotationList typeIR nameIR ; (from fieldTypeIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:71:3-72:28:
syntax structTypeIR = 
   | struct typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:74:3-75:28:
syntax headerTypeIR = 
   | header typeId < typeArgumentIR* > { fieldTypeIR* } (from headerTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:77:3-78:28:
syntax headerUnionTypeIR = 
   | header_union typeId < typeArgumentIR* > { fieldTypeIR* } (from headerUnionTypeIR) hint(print %0#"<"#%1#">")

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:80:23-80:43:
syntax valueFieldIR = 
   | nameIR = value ; (from valueFieldIR)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:83:3-83:43:
syntax simpleEnumTypeIR = 
   | enum typeId { nameIR* } (from simpleEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:86:3-86:62:
syntax serializableEnumTypeIR = 
   | enum typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:89:1-90:27:
syntax enumTypeIR = 
   | enum typeId { nameIR* } (from simpleEnumTypeIR) hint(print %0)
   | enum typeId < typeIR > { valueFieldIR* } (from serializableEnumTypeIR) hint(print %0)

;; ../../../../../spectec/specs/p4/2-static-runtime/2.2.1-type.spectec:93:1-100:15:
syntax dataTypeIR = 
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | array typeIR [ nat ] (from arrayTypeIR)
   | header_stack typeIR [ nat ] (from headerStackTypeIR)
   | struct typeId < typeArgumentIR* > { fieldTypeIR* } (from structTypeIR) hint(print %0#"<"#%1#">")
