   | simpleKeysetExpressionList , simpleKeysetExpression (from simpleKeysetExpressionList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:591:1-593:32:
def $flatten_simpleKeysetExpressionList(simpleKeysetExpressionList) : simpleKeysetExpression* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:594:1-595:27:
   clause 0(simpleKeysetExpression as simpleKeysetExpressionList) = [simpleKeysetExpression]

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:596:1-599:34:
   clause 1(simpleKeysetExpressionList , simpleKeysetExpression) = $flatten_simpleKeysetExpressionList(simpleKeysetExpressionList) ++ [simpleKeysetExpression]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:602:1-606:64:
syntax tupleKeysetExpression = 
   | ( expression &&& expression ) (from tupleKeysetExpression)
