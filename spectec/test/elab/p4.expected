;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:11:1-15:56:
relation ParameterType_alpha: parameterIR ~~ parameterIR

   ;; ../../../../../spectec/specs/p4/2-static-runtime/2.6-type-alpha.spectec:169:1-171:38:
   rule : _annotationList direction typeIR_a _id _parameterInitializerOptIR ~~ _annotationList' direction typeIR_b _id' _parameterInitializerOptIR'
