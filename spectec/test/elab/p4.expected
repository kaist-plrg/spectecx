;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:57:1-58:43:
def $concat_text(text*) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:59:1-59:27:
   clause 0([]) = ""

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:60:1-60:58:
   clause 1(t_h :: t_t*{}) = t_h ++ $concat_text(t_t*{})

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:62:1-63:64:
def $join_text(text*, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:64:1-64:32:
   clause 0([], t_sep) = ""

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:65:1-65:37:
   clause 1([t_h], t_sep) = t_h

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:66:1-67:53:
   clause 2(t_h1 :: t_h2 :: t_t*{}, t_sep) = t_h1 ++ t_sep ++ $join_text(t_h2 :: t_t*{}, t_sep)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:69:1-70:77:
def $replace_text(text, text, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:72:1-73:44:
   clause 0(t, t_old, t_new) = $replace_text'(0, |t|, t, t_old, t_new)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:71:1-71:54:
def $replace_text'(nat, nat, text, text, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:74:1-74:54:
   clause 0(n_len, n_len, t, t_old, t_new) = t

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:75:1-78:67:
   clause 1(n, n_len, t, t_old, t_new) = $replace_text'((n + 1), n_len, t_replaced, t_old, t_new)
      -- if (n < n_len)
      -- if (t_replaced = $ite<text>((t[n] = t_old), t[[n] = t_new], t))

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:80:1-81:81:
def $replace_text_except(text, text, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:83:1-84:51:
   clause 0(t, t_old, t_new) = $replace_text_except'(0, |t|, t, t_old, t_new)

;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:82:1-82:61:
def $replace_text_except'(nat, nat, text, text, text) : text =

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:85:1-85:61:
   clause 0(n_len, n_len, t, t_old, t_new) = t

   ;; ../../../../../spectec/specs/p4/0-aux/0.0-stdlib.spectec:86:1-89:67:
   clause 1(n, n_len, t, t_old, t_new) = $replace_text_except'((n + 1), n_len, t_replaced, t_old, t_new)
      -- if (n < n_len)
      -- if (t_replaced = $ite<text>((t[n] = t_old), t, t[[n] = t_new]))

