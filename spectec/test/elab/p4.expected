   ;; ../../../../../spectec/specs/p4/8-dynamic/8.03.2-eval-keyset-expression.spectec:183:1-192:67:
   rule cons-head-cont-tail-cont: EC_0 ARCH_0 |- simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*{} : EC_2 ARCH_2 keysetExpressionResult
