   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:181:1-182:53:
   clause 0(block, EC, nameIR) = $find_map<typeId, typeIR>(EC.block.type, nameIR)

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:183:1-184:66:
   clause 1(local, EC, nameIR) = ?(typeIR)
      -- if (?(typeIR) = $find_map<typeId, typeIR>(EC.local.type, nameIR))

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:185:1-187:63:
   clause 2(local, EC, nameIR) = $find_type_e(block, EC, nameIR)
      -- if (?() = $find_map<typeId, typeIR>(EC.local.type, nameIR))

;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:191:1-193:95:
def $find_callableDef_overloaded_e(cursor, evalContext, prefixedNameIR, argumentIR*) : callResolution<(cursor, callableDef)>? =

   ;; ../../../../../spectec/specs/p4/8-dynamic/8.01.1-eval-context.spectec:195:1-202:47:
   clause 0(global, EC, nameIR, argumentIR*{}) = ?(callableId : (global, callableDef) # id_default*{} # id_optional*{})
