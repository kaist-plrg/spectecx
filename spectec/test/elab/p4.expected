;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.0-domain.spectec:5:1-6:59:
def $callableId_IR(nameIR, parameterListIR) : callableId =

   ;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.0-domain.spectec:8:1-10:36:
   clause 0(nameIR, parameterIR*{}) = nameIR ( id*{} )
      -- (if (_annotationList _direction _typeIR id _parameterInitializerOptIR = parameterIR))*

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.1-storage-reference.spectec:6:1-9:47:
syntax storageReference = 
   | nameIR (from prefixedNameIR) hint(print %0)
   | . nameIR (from prefixedNameIR)
   | storageReference . nameIR (from storageReference)
   | storageReference [ value ] (from storageReference)
   | storageReference [ value sliceop value ] (from storageReference)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:12:3-12:70:
syntax actionDef = 
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:19:3-20:43:
syntax definedFunctionDef = 
   | function nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:23:3-24:52:
syntax externFunctionDef = 
   | extern_function nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:27:1-28:22:
syntax functionDef = 
   | function nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:35:1-38:54:
syntax externMethodDef = 
   | extern_method nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef)
   | extern_method abstract nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:41:3-42:52:
syntax parserApplyMethodDef = 
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:45:3-46:75:
syntax controlApplyMethodDef = 
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:49:3-49:40:
syntax tableApplyMethodDef = 
   | table_apply { tablePropertyListIR } (from tableApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:52:1-55:24:
syntax methodDef = 
   | extern_method nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef)
   | extern_method abstract nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef)
   | table_apply { tablePropertyListIR } (from tableApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.1-callable-def.spectec:57:22-57:57:
syntax callableDef = 
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDef)
   | function nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR (from definedFunctionDef)
   | extern_function nameIR < typeParameterListIR > ( parameterListIR ) (from externFunctionDef)
   | extern_method nameIR < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from externMethodDef)
   | extern_method abstract nameIR < typeParameterListIR > ( parameterListIR ) (from externMethodDef)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; stateEnv } (from parserApplyMethodDef)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; actionDefEnv ; controlBodyIR } (from controlApplyMethodDef)
   | table_apply { tablePropertyListIR } (from tableApplyMethodDef)

;; ../../../../../spectec/specs/p4/6-dynamic-runtime/6.2.2-callable-def-aux.spectec:5:1-6:17:
def $parameterListIR_of_callableDef(callableDef) : parameterIR* =

