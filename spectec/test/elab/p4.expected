   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)
   | ... (from defaultExpression)
   | unop expression (from unaryExpression)
   | expression binop expression (from binaryExpression)
   | expression ? expression : expression (from ternaryExpression)
   | ( type ) expression (from castExpression)
   | {#} (from invalidHeaderExpression)
   | { sequenceOrRecordElementExpression trailingCommaOpt } (from sequenceOrRecordExpression)
   | error . member (from errorAccessExpression)
   | memberAccessBase . member (from memberAccessExpression)
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression sliceop expression ] (from sliceAccessExpression)
   | callTarget ( argumentList ) (from callExpression)
   | callableTarget < realTypeArgumentList > ( argumentList ) (from callExpression)
   | ( expression ) (from parenthesizedExpression)
   | name = expression (from argument)
   | name = _ (from argument)
   | _ (from argument)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:658:1-659:38:
syntax argumentListNonEmpty = 
   | true (from booleanLiteral)
   | false (from booleanLiteral)
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)
   | ... (from defaultExpression)
   | unop expression (from unaryExpression)
   | expression binop expression (from binaryExpression)
   | expression ? expression : expression (from ternaryExpression)
   | ( type ) expression (from castExpression)
   | {#} (from invalidHeaderExpression)
   | { sequenceOrRecordElementExpression trailingCommaOpt } (from sequenceOrRecordExpression)
   | error . member (from errorAccessExpression)
   | memberAccessBase . member (from memberAccessExpression)
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression sliceop expression ] (from sliceAccessExpression)
   | callTarget ( argumentList ) (from callExpression)
   | callableTarget < realTypeArgumentList > ( argumentList ) (from callExpression)
   | ( expression ) (from parenthesizedExpression)
   | name = expression (from argument)
   | name = _ (from argument)
   | _ (from argument)
   | argumentListNonEmpty , argument (from argumentListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:662:1-663:25:
syntax argumentList = 
   |  (from argumentList)
   | true (from booleanLiteral)
   | false (from booleanLiteral)
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)
   | ... (from defaultExpression)
   | unop expression (from unaryExpression)
   | expression binop expression (from binaryExpression)
   | expression ? expression : expression (from ternaryExpression)
   | ( type ) expression (from castExpression)
   | {#} (from invalidHeaderExpression)
   | { sequenceOrRecordElementExpression trailingCommaOpt } (from sequenceOrRecordExpression)
   | error . member (from errorAccessExpression)
   | memberAccessBase . member (from memberAccessExpression)
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression sliceop expression ] (from sliceAccessExpression)
   | callTarget ( argumentList ) (from callExpression)
   | callableTarget < realTypeArgumentList > ( argumentList ) (from callExpression)
   | ( expression ) (from parenthesizedExpression)
   | name = expression (from argument)
   | name = _ (from argument)
   | _ (from argument)
   | argumentListNonEmpty , argument (from argumentListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:665:1-666:32:
def $flatten_argumentList(argumentList) : argument* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:667:1-667:40:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:668:1-668:47:
   clause 1(argument as argumentList) = [argument]

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:669:1-670:64:
   clause 2(argumentListNonEmpty , argument as argumentList) = $flatten_argumentList(argumentListNonEmpty as argumentList) ++ [argument]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:677:1-681:17:
syntax lvalue = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)
   | lvalue . member (from lvalue)
   | lvalue [ expression ] (from lvalue)
   | lvalue [ expression sliceop expression ] (from lvalue)
   | ( lvalue ) (from lvalue)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:683:1-684:54:
def $lvalue_as_expression(lvalue) : expression =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:685:1-685:69:
   clause 0(referenceExpression as lvalue) = referenceExpression as expression

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:686:1-688:61:
   clause 1(lvalue_base . member) = expression_base as memberAccessBase . member as expression
      -- if (expression_base = $lvalue_as_expression(lvalue_base))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:689:1-691:61:
   clause 2(lvalue_base [ expression_index ]) = expression_base [ expression_index ] as expression
      -- if (expression_base = $lvalue_as_expression(lvalue_base))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:692:1-694:61:
   clause 3(lvalue_base [ expression_hi : expression_lo ]) = expression_base [ expression_hi : expression_lo ] as expression
      -- if (expression_base = $lvalue_as_expression(lvalue_base))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:695:1-697:61:
   clause 4(lvalue_base [ expression_hi +: expression_lo ]) = expression_base [ expression_hi +: expression_lo ] as expression
      -- if (expression_base = $lvalue_as_expression(lvalue_base))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:698:1-699:51:
   clause 5(( lvalue )) = ( expression ) as expression
      -- if (expression = $lvalue_as_expression(lvalue))

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:701:1-702:51:
def $expression_as_lvalue(expression) : lvalue? =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:703:1-703:69:
   clause 0(referenceExpression as expression) = ?(referenceExpression as lvalue)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:704:1-705:51:
   clause 1(expression as memberAccessBase . member as expression) = ?(lvalue . member)
      -- if (?(lvalue) = $expression_as_lvalue(expression))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:706:1-708:61:
   clause 2(expression_base [ expression_index ] as expression) = ?(lvalue_base [ expression_index ])
      -- if (?(lvalue_base) = $expression_as_lvalue(expression_base))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:709:1-711:61:
   clause 3(expression_base [ expression_hi : expression_lo ] as expression) = ?(lvalue_base [ expression_hi : expression_lo ])
      -- if (?(lvalue_base) = $expression_as_lvalue(expression_base))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:712:1-714:61:
   clause 4(expression_base [ expression_hi +: expression_lo ] as expression) = ?(lvalue_base [ expression_hi +: expression_lo ])
      -- if (?(lvalue_base) = $expression_as_lvalue(expression_base))

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:715:1-716:51:
   clause 5(( expression ) as expression) = ?(( lvalue ))
      -- if (?(lvalue) = $expression_as_lvalue(expression))

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:726:25-726:28:
syntax emptyStatement = 
   | ; (from emptyStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:733:1-735:39:
syntax assignop = 
   | = (from assignop)
   | += (from assignop)
   | -= (from assignop)
   | |+|= (from assignop)
   | |-|= (from assignop)
   | *= (from assignop)
   | /= (from assignop)
   | %= (from assignop)
   | <<= (from assignop)
   | >>= (from assignop)
   | &= (from assignop)
   | ^= (from assignop)
   | |= (from assignop)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:737:30-737:60:
syntax assignmentStatement = 
   | lvalue assignop expression ; (from assignmentStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:739:1-740:59:
def $assignop_as_binop(assignop) : binop? =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:741:1-741:35:
   clause 0(+=) = ?(+)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:742:1-742:35:
   clause 1(-=) = ?(-)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:743:1-743:39:
   clause 2(|+|=) = ?(|+|)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:744:1-744:39:
   clause 3(|-|=) = ?(|-|)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:745:1-745:35:
   clause 4(*=) = ?(*)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:746:1-746:35:
   clause 5(/=) = ?(/)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:747:1-747:35:
   clause 6(%=) = ?(%)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:748:1-748:37:
   clause 7(<<=) = ?(<<)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:749:1-749:37:
   clause 8(>>=) = ?(>>)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:750:1-750:35:
   clause 9(&=) = ?(&)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:751:1-751:35:
   clause 10(^=) = ?(^)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:752:1-752:35:
   clause 11(|=) = ?(|)

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:753:1-754:15:
   clause 12(assignop) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:761:1-762:57:
syntax callStatement = 
   | lvalue ( argumentList ) ; (from callStatement)
   | lvalue < typeArgumentList > ( argumentList ) ; (from callStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:768:37-768:79:
syntax directApplicationStatement = 
   | namedType . apply ( argumentList ) ; (from directApplicationStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:775:1-776:26:
syntax returnStatement = 
   | return ; (from returnStatement)
   | return expression ; (from returnStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:782:24-782:32:
syntax exitStatement = 
   | exit ; (from exitStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:790:25-790:71:
syntax blockStatement = 
   | annotationList { blockElementStatementList } (from blockStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:799:1-800:49:
syntax conditionalStatement = 
   | if ( expression ) statement (from conditionalStatement)
   | if ( expression ) statement else statement (from conditionalStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:809:1-811:31:
syntax forUpdateStatement = 
   | lvalue ( argumentList ) (from forUpdateStatement)
   | lvalue < typeArgumentList > ( argumentList ) (from forUpdateStatement)
   | lvalue assignop expression (from forUpdateStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:814:1-815:58:
syntax forUpdateStatementListNonEmpty = 
   | lvalue ( argumentList ) (from forUpdateStatement)
   | lvalue < typeArgumentList > ( argumentList ) (from forUpdateStatement)
   | lvalue assignop expression (from forUpdateStatement)
   | forUpdateStatementListNonEmpty , forUpdateStatement (from forUpdateStatementListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:818:1-819:35:
syntax forUpdateStatementList = 
   |  (from forUpdateStatementList)
   | lvalue ( argumentList ) (from forUpdateStatement)
   | lvalue < typeArgumentList > ( argumentList ) (from forUpdateStatement)
   | lvalue assignop expression (from forUpdateStatement)
   | forUpdateStatementListNonEmpty , forUpdateStatement (from forUpdateStatementListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:821:1-822:24:
def $flatten_forUpdateStatementList(forUpdateStatementList) : forUpdateStatement* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:823:1-823:50:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:824:1-825:23:
   clause 1(forUpdateStatement as forUpdateStatementList) = [forUpdateStatement]

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:826:1-829:30:
   clause 2(forUpdateStatementListNonEmpty , forUpdateStatement as forUpdateStatementList) = $flatten_forUpdateStatementList(forUpdateStatementListNonEmpty as forUpdateStatementList) ++ [forUpdateStatement]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:832:1-833:23:
syntax forInitStatement = 
   | annotationList type name initializerOpt (from forInitStatement)
   | lvalue ( argumentList ) (from forUpdateStatement)
   | lvalue < typeArgumentList > ( argumentList ) (from forUpdateStatement)
   | lvalue assignop expression (from forUpdateStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:836:1-837:54:
syntax forInitStatementListNonEmpty = 
   | annotationList type name initializerOpt (from forInitStatement)
   | lvalue ( argumentList ) (from forUpdateStatement)
   | lvalue < typeArgumentList > ( argumentList ) (from forUpdateStatement)
   | lvalue assignop expression (from forUpdateStatement)
   | forInitStatementListNonEmpty , forInitStatement (from forInitStatementListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:840:1-841:33:
syntax forInitStatementList = 
   |  (from forInitStatementList)
   | annotationList type name initializerOpt (from forInitStatement)
   | lvalue ( argumentList ) (from forUpdateStatement)
   | lvalue < typeArgumentList > ( argumentList ) (from forUpdateStatement)
   | lvalue assignop expression (from forUpdateStatement)
   | forInitStatementListNonEmpty , forInitStatement (from forInitStatementListNonEmpty)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:843:1-843:76:
def $flatten_forInitStatementList(forInitStatementList) : forInitStatement* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:844:1-844:48:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:845:1-845:71:
   clause 1(forInitStatement as forInitStatementList) = [forInitStatement]

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:846:1-849:28:
   clause 2(forInitStatementListNonEmpty , forInitStatement as forInitStatementList) = $flatten_forInitStatementList(forInitStatementListNonEmpty as forInitStatementList) ++ [forInitStatement]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:852:1-853:31:
syntax forCollectionExpression = 
   | true (from booleanLiteral)
   | false (from booleanLiteral)
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)
   | ... (from defaultExpression)
   | unop expression (from unaryExpression)
   | expression binop expression (from binaryExpression)
   | expression ? expression : expression (from ternaryExpression)
   | ( type ) expression (from castExpression)
   | {#} (from invalidHeaderExpression)
   | { sequenceOrRecordElementExpression trailingCommaOpt } (from sequenceOrRecordExpression)
   | error . member (from errorAccessExpression)
   | memberAccessBase . member (from memberAccessExpression)
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression sliceop expression ] (from sliceAccessExpression)
   | callTarget ( argumentList ) (from callExpression)
   | callableTarget < realTypeArgumentList > ( argumentList ) (from callExpression)
   | ( expression ) (from parenthesizedExpression)
   | expression .. expression (from forCollectionExpression)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:856:1-861:82:
syntax forStatement = 
   | annotationList for ( forInitStatementList ; expression ; forUpdateStatementList ) statement (from forStatement)
   | annotationList for ( type name in forCollectionExpression ) statement (from forStatement)
   | annotationList for ( annotationListNonEmpty type name in forCollectionExpression ) statement (from forStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:868:1-869:23:
syntax switchLabel = 
   | default (from switchLabel)
   | true (from booleanLiteral)
   | false (from booleanLiteral)
   | d int (from integerLiteral) hint(print %)
   | nat w int (from integerLiteral) hint(print %#W#%)
   | nat s int (from integerLiteral) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)
   | unop expression (from unaryExpression)
   | expressionNonBrace binop expression (from binaryExpressionNonBrace)
   | expressionNonBrace ? expression : expression (from ternaryExpressionNonBrace)
   | ( type ) expression (from castExpression)
   | error . member (from errorAccessExpression)
   | memberAccessBaseNonBrace . member (from memberAccessExpressionNonBrace)
   | expressionNonBrace [ expression ] (from indexAccessExpressionNonBrace)
   | expressionNonBrace [ expression sliceop expression ] (from sliceAccessExpressionNonBrace)
   | callTargetNonBrace ( argumentList ) (from callExpressionNonBrace)
   | callableTargetNonBrace < realTypeArgumentList > ( argumentList ) (from callExpressionNonBrace)
   | ( expression ) (from parenthesizedExpression)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:872:1-873:20:
syntax switchCase = 
   | switchLabel : blockStatement (from switchCase)
   | switchLabel : (from switchCase)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:876:1-877:30:
syntax switchCaseList = 
   |  (from switchCaseList)
   | switchCaseList switchCase (from switchCaseList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:879:1-880:32:
def $flatten_switchCaseList(switchCaseList) : switchCase* =

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:881:1-881:42:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:882:1-883:62:
   clause 1(switchCaseList switchCase) = $flatten_switchCaseList(switchCaseList) ++ [switchCase]

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:885:26-885:70:
syntax switchStatement = 
   | switch ( expression ) { switchCaseList } (from switchStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:891:25-891:34:
syntax breakStatement = 
   | break ; (from breakStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:893:28-893:40:
syntax continueStatement = 
   | continue ; (from continueStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:900:1-911:20:
syntax statement = 
   | ; (from emptyStatement)
   | lvalue assignop expression ; (from assignmentStatement)
   | lvalue ( argumentList ) ; (from callStatement)
   | lvalue < typeArgumentList > ( argumentList ) ; (from callStatement)
   | namedType . apply ( argumentList ) ; (from directApplicationStatement)
   | return ; (from returnStatement)
   | return expression ; (from returnStatement)
   | exit ; (from exitStatement)
   | annotationList { blockElementStatementList } (from blockStatement)
   | if ( expression ) statement (from conditionalStatement)
   | if ( expression ) statement else statement (from conditionalStatement)
   | annotationList for ( forInitStatementList ; expression ; forUpdateStatementList ) statement (from forStatement)
   | annotationList for ( type name in forCollectionExpression ) statement (from forStatement)
   | annotationList for ( annotationListNonEmpty type name in forCollectionExpression ) statement (from forStatement)
   | break ; (from breakStatement)
   | continue ; (from continueStatement)
   | switch ( expression ) { switchCaseList } (from switchStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:921:22-921:36:
syntax initializer = 
   | = expression (from initializer)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:924:3-924:49:
syntax constantDeclaration = 
   | annotationList const type name initializer ; (from constantDeclaration)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:927:1-928:16:
syntax initializerOpt = 
   |  (from initializerOpt)
   | = expression (from initializer)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:931:3-931:46:
syntax variableDeclaration = 
   | annotationList type name initializerOpt ; (from variableDeclaration)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:934:1-936:14:
syntax blockElementStatement = 
   | annotationList const type name initializer ; (from constantDeclaration)
   | annotationList type name initializerOpt ; (from variableDeclaration)
   | ; (from emptyStatement)
   | lvalue assignop expression ; (from assignmentStatement)
   | lvalue ( argumentList ) ; (from callStatement)
   | lvalue < typeArgumentList > ( argumentList ) ; (from callStatement)
   | namedType . apply ( argumentList ) ; (from directApplicationStatement)
   | return ; (from returnStatement)
   | return expression ; (from returnStatement)
   | exit ; (from exitStatement)
   | annotationList { blockElementStatementList } (from blockStatement)
   | if ( expression ) statement (from conditionalStatement)
   | if ( expression ) statement else statement (from conditionalStatement)
   | annotationList for ( forInitStatementList ; expression ; forUpdateStatementList ) statement (from forStatement)
   | annotationList for ( type name in forCollectionExpression ) statement (from forStatement)
   | annotationList for ( annotationListNonEmpty type name in forCollectionExpression ) statement (from forStatement)
   | break ; (from breakStatement)
   | continue ; (from continueStatement)
   | switch ( expression ) { switchCaseList } (from switchStatement)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:939:1-940:52:
syntax blockElementStatementList = 
   |  (from blockElementStatementList)
   | blockElementStatementList blockElementStatement (from blockElementStatementList)

;; ../../../../../spectec/specs/p4/1-p4-surface/1-syntax.spectec:942:1-944:32:
