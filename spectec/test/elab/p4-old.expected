;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:9:1-9:37:
def $free_typeDef(typeDefIR) : bound =

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:121:1-121:47:
   clause 0(typeIR as typeDefIR) = $free_type(typeIR)

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:123:1-126:50:
   clause 1(typeIR_base < tid*{} , tid_hidden*{} > as typeDefIR) = $diff_set<tid>(bound_base, bound_tparams)
      -- if (bound_base = $free_typeDef(typeIR_base as typeDefIR))
      -- if (bound_tparams = { tid*{} ++ tid_hidden*{} })

;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:10:1-10:49:
def $free_parameterType(parameterTypeIR) : bound =

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:132:1-132:59:
   clause 0(_direction typeIR _id _value?{}) = $free_type(typeIR)

;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:11:1-11:45:
def $free_routineType(routineTypeIR) : bound =

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:138:1-144:43:
   clause 0(builtin_function ( parameterTypeIR*{} ) -> typeIR_ret as routineTypeIR) = $union_set<tid>(bound_params, bound_ret)
      -- if (bound_params = $unions_set<tid>($free_parameterType(parameterTypeIR)*{}))
      -- if (bound_ret = $free_type(typeIR_ret))

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:146:1-152:43:
   clause 1(function ( parameterTypeIR*{} ) -> typeIR_ret as routineTypeIR) = $union_set<tid>(bound_params, bound_ret)
      -- if (bound_params = $unions_set<tid>($free_parameterType(parameterTypeIR)*{}))
      -- if (bound_ret = $free_type(typeIR_ret))

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:154:1-160:43:
   clause 2(extern_function ( parameterTypeIR*{} ) -> typeIR_ret as routineTypeIR) = $union_set<tid>(bound_params, bound_ret)
