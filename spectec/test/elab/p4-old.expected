      -- if Type_alpha: typeIR_a ~~ typeIR_b holds

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:107:1-119:73:
   rule externtype: extern tid { rid_a : routineTypeDefIR_a*{} } as typeIR ~~ extern tid { rid_b : routineTypeDefIR_b*{} } as typeIR
      -- if $eq_set<rid>({ rid_a*{} }, { rid_b*{} })
      -- (if (?(routineTypeDefIR_a') = $find_map<rid, routineTypeDefIR>({ rid_a : routineTypeDefIR_a*{} }, rid_a)))*
      -- (if (?(routineTypeDefIR_b') = $find_map<rid, routineTypeDefIR>({ rid_b : routineTypeDefIR_b*{} }, rid_a)))*
      -- (if RoutineTypeDef_alpha: routineTypeDefIR_a' ~~ routineTypeDefIR_b' holds)*

