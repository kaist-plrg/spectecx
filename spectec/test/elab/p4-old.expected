;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:9:1-11:20:
relation ParameterType_alpha: parameterTypeIR ~~ parameterTypeIR

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:178:1-180:38:
   rule : _direction typeIR_a _id _value?{} ~~ _direction' typeIR_b _id' _value'?{}
