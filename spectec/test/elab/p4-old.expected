   rule spectype-nominal: polyTypeDefIR_a < typeIR_a*{} > as typeIR ~~ polyTypeDefIR_b < typeIR_b*{} > as typeIR
      -- if (typeIR_a_spec = $specialize_typeDef(polyTypeDefIR_a as typeDefIR, typeIR_a*{}))
      -- if (typeIR_b_spec = $specialize_typeDef(polyTypeDefIR_b as typeDefIR, typeIR_b*{}))
      -- if Type_alpha: typeIR_a_spec ~~ typeIR_b_spec holds
      -- if ($is_nominal_typeIR(typeIR_a_spec) /\ $is_nominal_typeIR(typeIR_b_spec))
      -- (if Type_alpha: typeIR_a ~~ typeIR_b holds)*

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:45:1-52:46:
   rule spectype-structural: polyTypeDefIR_a < typeIR_a*{} > as typeIR ~~ polyTypeDefIR_b < typeIR_b*{} > as typeIR
      -- if (typeIR_a_spec = $specialize_typeDef(polyTypeDefIR_a as typeDefIR, typeIR_a*{}))
      -- if (typeIR_b_spec = $specialize_typeDef(polyTypeDefIR_b as typeDefIR, typeIR_b*{}))
      -- if Type_alpha: typeIR_a_spec ~~ typeIR_b_spec holds
      -- if (~$is_nominal_typeIR(typeIR_a_spec) /\ ~$is_nominal_typeIR(typeIR_b_spec))

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:56:1-58:38:
