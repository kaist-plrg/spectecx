;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:5:14-5:30:
syntax ctk = 
   | lctk (from ctk)
   | ctk (from ctk)
   | dyn (from ctk)

;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:7:1-7:30:
def $join_ctk(ctk, ctk) : ctk =

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:9:1-9:33:
   clause 0(lctk, lctk) = lctk

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:10:1-10:31:
   clause 1(lctk, ctk) = ctk

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:11:1-11:31:
   clause 2(ctk, lctk) = ctk

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:12:1-12:30:
   clause 3(ctk, ctk) = ctk

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:13:1-14:15:
   clause 4(ctk_a, ctk_b) = dyn
      -- otherwise

;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:16:1-16:27:
def $joins_ctk(ctk*) : ctk =

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:18:1-18:26:
   clause 0([]) = dyn

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:19:1-19:26:
   clause 1([ctk]) = ctk

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:20:1-20:57:
   clause 2(ctk_a :: [ctk_b]) = $join_ctk(ctk_a, ctk_b)

   ;; ../../../../../spectec/specs/p4-old/2.3-compile-time-known.spectec:21:1-22:40:
   clause 3(ctk_a :: ctk_b :: ctk_c*{}) = $joins_ctk(ctk_d :: ctk_c*{})
      -- if (ctk_d = $join_ctk(ctk_a, ctk_b))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:5:1-5:29:
builtin dec $pow2(nat) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:7:1-7:33:
builtin dec $shl(int, int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:8:1-8:33:
builtin dec $shr(int, int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:9:1-9:44:
builtin dec $shr_arith(int, int, int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:11:1-11:29:
builtin dec $bneg(int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:12:1-12:34:
builtin dec $band(int, int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:13:1-13:34:
builtin dec $bxor(int, int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:14:1-14:33:
builtin dec $bor(int, int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:16:1-16:41:
builtin dec $bitacc(int, int, int) : int

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:24:1-24:28:
def $un_bnot(value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:26:1-27:22:
   clause 0(w w i as value) = w w i' as value
      -- if (i' = $bneg(i))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:31:1-31:28:
def $un_lnot(value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:33:1-33:27:
   clause 0(b b as value) = b ~b as value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:37:1-37:28:
def $un_plus(value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:39:1-39:24:
   clause 0(d i as value) = d i as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:40:1-40:28:
   clause 1(w w i as value) = w w i as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:41:1-41:28:
   clause 2(w s i as value) = w s i as value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:45:1-45:29:
def $un_minus(value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:47:1-47:29:
   clause 0(d i as value) = d -i as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:48:1-49:29:
   clause 1(w w i as value) = w w i' as value
      -- if (i' = ($pow2(w) - i))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:50:1-51:46:
   clause 2(w s i as value) = w s i' as value
      -- if (i' = $to_bitstr(w as int, $to_int(w as int, -i)))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:59:1-59:36:
def $bin_plus(value, value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:61:1-61:45:
   clause 0(d i_l as value, d i_r as value) = d (i_l + i_r) as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:62:1-65:43:
   clause 1(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))
      -- if (i' = $to_bitstr(w as int, (i_l' + i_r')))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:66:1-69:43:
   clause 2(w s i_l as value, w s i_r as value) = w s i' as value
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))
      -- if (i' = $to_bitstr(w as int, (i_l' + i_r')))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:84:1-87:43:
   clause 3(w s i_l as value, w s i_r as value) = w s i' as value
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))
      -- if (i' = $to_bitstr(w as int, (i_l' - i_r')))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:102:1-105:43:
   clause 4(w s i_l as value, w s i_r as value) = w s i' as value
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))
      -- if (i' = $to_bitstr(w as int, (i_l' * i_r')))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:73:1-73:47:
builtin dec $bin_satplus(value, value) : value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:77:1-77:37:
def $bin_minus(value, value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:79:1-79:46:
   clause 0(d i_l as value, d i_r as value) = d (i_l - i_r) as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:80:1-83:43:
   clause 1(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))
      -- if (i' = $to_bitstr(w as int, (i_l' - i_r')))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:98:1-101:43:
   clause 2(w w i_l as value, w w i_r as value) = w w i' as value
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))
      -- if (i' = $to_bitstr(w as int, (i_l' * i_r')))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:91:1-91:48:
builtin dec $bin_satminus(value, value) : value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:95:1-95:35:
def $bin_mul(value, value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:97:1-97:44:
   clause 0(d i_l as value, d i_r as value) = d (i_l * i_r) as value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:109:1-109:35:
def $bin_div(value, value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:111:1-111:44:
   clause 0(d i_l as value, d i_r as value) = d (i_l / i_r) as value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:115:1-115:35:
def $bin_mod(value, value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:117:1-117:44:
   clause 0(d i_l as value, d i_r as value) = d (i_l \ i_r) as value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:121:1-121:35:
def $bin_shl(value, value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:123:1-123:46:
   clause 0(d i_l as value, d i_r as value) = d $shl(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:124:1-124:50:
   clause 1(d i_l as value, w_r w i_r as value) = d $shl(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:125:1-126:33:
   clause 2(d i_l as value, w_r s i_r as value) = d $shl(i_l, i_r') as value
      -- if (i_r' = $to_int(w_r as int, i_r))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:128:1-129:49:
   clause 3(w_l w i_l as value, d i_r as value) = $bin_shl(w_l w i_l as value, w_l w $to_int(w_l as int, i_r) as value)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:130:1-131:45:
   clause 4(w_l w i_l as value, w_r w i_r as value) = w_l w i' as value
      -- if (i' = $to_bitstr(w_l as int, $shl(i_l, i_r)))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:132:1-134:46:
   clause 5(w_l w i_l as value, w_r s i_r as value) = w_l w i' as value
      -- if (i_r' = $to_int(w_r as int, i_r))
      -- if (i' = $to_bitstr(w_l as int, $shl(i_l, i_r')))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:136:1-137:49:
   clause 6(w_l s i_l as value, d i_r as value) = $bin_shl(w_l s i_l as value, w_l s $to_int(w_l as int, i_r) as value)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:138:1-140:46:
   clause 7(w_l s i_l as value, w_r w i_r as value) = w_l s i' as value
      -- if (i_l' = $to_int(w_l as int, i_l))
      -- if (i' = $to_bitstr(w_l as int, $shl(i_l', i_r)))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:141:1-144:47:
   clause 8(w_l s i_l as value, w_r s i_r as value) = w_l s i' as value
      -- if (i_l' = $to_int(w_l as int, i_l))
      -- if (i_r' = $to_int(w_r as int, i_r))
      -- if (i' = $to_bitstr(w_l as int, $shl(i_l', i_r')))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:148:1-148:35:
def $bin_shr(value, value) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:150:1-150:46:
   clause 0(d i_l as value, d i_r as value) = d $shr(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:151:1-151:50:
   clause 1(d i_l as value, w_r w i_r as value) = d $shr(i_l, i_r) as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:152:1-153:33:
   clause 2(d i_l as value, w_r s i_r as value) = d $shr(i_l, i_r') as value
      -- if (i_r' = $to_int(w_r as int, i_r))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:155:1-156:49:
   clause 3(w_l w i_l as value, d i_r as value) = $bin_shr(w_l w i_l as value, w_l w $to_int(w_l as int, i_r) as value)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:157:1-158:45:
   clause 4(w_l w i_l as value, w_r w i_r as value) = w_l w i' as value
      -- if (i' = $to_bitstr(w_l as int, $shr(i_l, i_r)))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:159:1-161:46:
   clause 5(w_l w i_l as value, w_r s i_r as value) = w_l w i' as value
      -- if (i_r' = $to_int(w_r as int, i_r))
      -- if (i' = $to_bitstr(w_l as int, $shr(i_l, i_r')))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:163:1-167:34:
   clause 6(w_l s i_l as value, d i_r as value) = w_l s i'' as value
      -- if (i_l' = $to_int(w_l as int, i_l))
      -- if (i_l' < 0 as int)
      -- if (i' = $shr_arith(i_l, i_r, ($pow2(w_l) - 1 as int)))
      -- if (i'' = $to_bitstr(w_l as int, i'))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:168:1-172:34:
   clause 7(w_l s i_l as value, d i_r as value) = w_l s i'' as value
      -- if (i_l' = $to_int(w_l as int, i_l))
      -- if (i_l' >= 0 as int)
      -- if (i' = $shr(i_l, i_r))
      -- if (i'' = $to_bitstr(w_l as int, i'))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:173:1-177:34:
   clause 8(w_l s i_l as value, w_r w i_r as value) = w_l s i'' as value
      -- if (i_l' = $to_int(w_l as int, i_l))
      -- if (i_l' < 0 as int)
      -- if (i' = $shr_arith(i_l, i_r, ($pow2(w_l) - 1 as int)))
      -- if (i'' = $to_bitstr(w_l as int, i'))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:178:1-182:34:
   clause 9(w_l s i_l as value, w_r w i_r as value) = w_l s i'' as value
      -- if (i_l' = $to_int(w_l as int, i_l))
