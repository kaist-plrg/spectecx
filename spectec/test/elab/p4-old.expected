      -- if (i' = $shr(i_l, i_r))
      -- if (i'' = $to_bitstr(w_l as int, i'))

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:183:1-188:34:
   clause 10(w_l s i_l as value, w_r s i_r as value) = w_l s i'' as value
      -- if (i_l' = $to_int(w_l as int, i_l))
      -- if (i_r' = $to_int(w_r as int, i_r))
      -- if (i_l' < 0 as int)
