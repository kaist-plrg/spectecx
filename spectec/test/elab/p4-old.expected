   ;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:54:1-57:53:
   clause 0(constraint, parameterTypeIR, typedExpressionIR as argumentIR) = $gen_constraint_type(constraint, typeIR_param, typeIR_arg)
