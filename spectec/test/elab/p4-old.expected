;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:198:1-198:33:
def $bin_le(value, value) : bool =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:200:1-200:42:
   clause 0(d i_l as value, d i_r as value) = (i_l <= i_r)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:201:1-201:46:
   clause 1(w w i_l as value, w w i_r as value) = (i_l <= i_r)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:202:1-204:31:
   clause 2(w s i_l as value, w s i_r as value) = (i_l' <= i_r')
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:208:1-208:33:
def $bin_ge(value, value) : bool =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:210:1-210:42:
   clause 0(d i_l as value, d i_r as value) = (i_l >= i_r)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:211:1-211:46:
   clause 1(w w i_l as value, w w i_r as value) = (i_l >= i_r)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:212:1-214:31:
   clause 2(w s i_l as value, w s i_r as value) = (i_l' >= i_r')
      -- if (i_l' = $to_int(w as int, i_l))
      -- if (i_r' = $to_int(w as int, i_r))

