      -- rel TableProperties_inst: Ci_frame sto_1 |- tablePropertyListIR ==> Ci_table sto_2 tablePropertyListIR_inst
      -- if ($init_table(tablePropertyListIR_inst) = tablePropertyListIR_dynamic)
      -- if (Ci_table.local.venvs = venv :: _venv*{})
      -- if (table { nameIR venv tablePropertyListIR_dynamic } = objDyn)

;; ../../../../../spectec/specs/p4-old/6.03-instantiation-relation.spectec:16:1-18:35:
relation Bind_args: cursor contextInst ; cursor contextInst sto |- id* argumentIR* ==> contextInst sto

   ;; ../../../../../spectec/specs/p4-old/6.04-instantiation-constructor.spectec:76:1-77:75:
   rule nil: p_caller Ci_caller ; p_callee Ci_callee sto |- [] [] ==> Ci_callee sto

   ;; ../../../../../spectec/specs/p4-old/6.04-instantiation-constructor.spectec:79:1-83:109:
   rule cons: p_caller Ci_caller ; p_callee Ci_callee_0 sto_0 |- id_h :: id_t*{} argumentIR_h :: argumentIR_t*{} ==> Ci_callee_2 sto_2
      -- rel Bind_arg: p_caller Ci_caller ; p_callee Ci_callee_0 sto_0 |- id_h argumentIR_h ==> Ci_callee_1 sto_1
      -- rel Bind_args: p_caller Ci_caller ; p_callee Ci_callee_1 sto_1 |- id_t*{} argumentIR_t*{} ==> Ci_callee_2 sto_2

;; ../../../../../spectec/specs/p4-old/6.03-instantiation-relation.spectec:20:1-22:35:
