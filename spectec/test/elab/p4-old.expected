   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:598:1-599:24:
   clause 2(string as typeIR) = " text_empty " as value
      -- if (text_empty = "")

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:601:1-601:25:
   clause 3(int as typeIR) = d 0 as int as value

