   clause 3(constraint_pre, constraint_post, tid_h :: tid_t*{}, constraint) = $merge_constraint'(constraint_pre, constraint_post, tid_t*{}, constraint_updated)
      -- if (?(known as typeIR_pre) = $find_map<tid, infer>(constraint_pre, tid_h))
      -- if (?(unknown) = $find_map<tid, infer>(constraint_post, tid_h))
      -- if (constraint_updated = $update_map<tid, infer>(constraint, tid_h, known as typeIR_pre))

   ;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:316:1-326:73:
   clause 4(constraint_pre, constraint_post, tid_h :: tid_t*{}, constraint) = $merge_constraint'(constraint_pre, constraint_post, tid_t*{}, constraint_updated)
      -- if (?(known as typeIR_pre) = $find_map<tid, infer>(constraint_pre, tid_h))
      -- if (?(known as typeIR_post) = $find_map<tid, infer>(constraint_post, tid_h))
      -- if Cast_impl: typeIR_pre -> typeIR_post holds
      -- if (constraint_updated = $update_map<tid, infer>(constraint, tid_h, known as typeIR_post))

   ;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:328:1-339:72:
   clause 5(constraint_pre, constraint_post, tid_h :: tid_t*{}, constraint) = $merge_constraint'(constraint_pre, constraint_post, tid_t*{}, constraint_updated)
      -- if (?(known as typeIR_pre) = $find_map<tid, infer>(constraint_pre, tid_h))
      -- if (?(known as typeIR_post) = $find_map<tid, infer>(constraint_post, tid_h))
      -- if Cast_impl: typeIR_pre -> typeIR_post does not hold
      -- if Cast_impl: typeIR_post -> typeIR_pre holds
      -- if (constraint_updated = $update_map<tid, infer>(constraint, tid_h, known as typeIR_pre))

;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:36:1-36:61:
def $merge_constraints(constraint, constraint*) : constraint =

   ;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:341:1-341:61:
   clause 0(constraint_pre, []) = constraint_pre

   ;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:343:1-351:65:
   clause 1(constraint_pre_0, constraint_post_h :: constraint_post_t*{}) = constraint_pre_2
      -- if (constraint_pre_1 = $merge_constraint(constraint_pre_0, constraint_post_h))
      -- if (constraint_pre_2 = $merge_constraints(constraint_pre_1, constraint_post_t*{}))

;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:38:1-38:48:
def $resolve_constraint(constraint) : inference =

   ;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:357:1-359:35:
   clause 0({ tid : infer*{} }) = { tid : typeIR*{} }
      -- (if (known as typeIR = infer))*

;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:21:1-21:65:
def $instantiable_extern(cursor, typingContext, instctxt) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:23:1-23:54:
   clause 0(global, TC, instctxt) = true

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:24:1-24:53:
   clause 1(block, TC, instctxt) = true

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:25:1-25:53:
   clause 2(local, TC, instctxt) = true

;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:27:1-27:65:
def $instantiable_parser(cursor, typingContext, instctxt) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:29:1-30:20:
   clause 0(global, TC, instctxt) = (instctxt = anon)

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:31:1-32:40:
   clause 1(block, TC, instctxt) = $is_parser_blockKind(TC.block.kind)

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:33:1-34:46:
   clause 2(local, TC, instctxt) = $is_parser_state_localKind(TC.local.kind)

;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:36:1-36:66:
def $instantiable_control(cursor, typingContext, instctxt) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:38:1-39:20:
   clause 0(global, TC, instctxt) = (instctxt = anon)

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:40:1-41:41:
   clause 1(block, TC, instctxt) = $is_control_blockKind(TC.block.kind)

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:42:1-43:54:
   clause 2(local, TC, instctxt) = $is_control_apply_method_localKind(TC.local.kind)

;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:45:1-45:66:
def $instantiable_package(cursor, typingContext, instctxt) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:47:1-47:55:
   clause 0(global, TC, instctxt) = true

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:48:1-49:41:
   clause 1(block, TC, instctxt) = $is_package_blockKind(TC.block.kind)

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:50:1-50:55:
   clause 2(local, TC, instctxt) = false

;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:52:1-52:64:
def $instantiable_table(cursor, typingContext, instctxt) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:54:1-54:54:
   clause 0(global, TC, instctxt) = false

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:55:1-56:41:
   clause 1(block, TC, instctxt) = $is_control_blockKind(TC.block.kind)

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:57:1-57:53:
   clause 2(local, TC, instctxt) = false

;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:59:1-59:66:
def $instantiable(cursor, typingContext, instctxt, typeIR) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:61:1-63:49:
   clause 0(p, TC, instctxt, typeIR) = $instantiable_extern(p, TC, instctxt)
      -- if $is_extern_object_typeIR($canon(typeIR))

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:64:1-66:49:
   clause 1(p, TC, instctxt, typeIR) = $instantiable_parser(p, TC, instctxt)
      -- if $is_parser_object_typeIR($canon(typeIR))

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:67:1-69:50:
   clause 2(p, TC, instctxt, typeIR) = $instantiable_control(p, TC, instctxt)
      -- if $is_control_object_typeIR($canon(typeIR))

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:70:1-72:50:
   clause 3(p, TC, instctxt, typeIR) = $instantiable_package(p, TC, instctxt)
      -- if $is_package_object_typeIR($canon(typeIR))

   ;; ../../../../../spectec/specs/p4-old/5.15.3-typing-constructor-call.spectec:73:1-75:48:
   clause 4(p, TC, instctxt, typeIR) = $instantiable_table(p, TC, instctxt)
      -- if $is_table_object_typeIR($canon(typeIR))

;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:55:1-55:33:
def $lvalue(lvalue) : expression =

   ;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:56:1-56:55:
   clause 0(referenceExpression as lvalue) = referenceExpression as expression

   ;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:57:1-59:47:
   clause 1(lvalue_base . member) = expression_base as memberAccessBase . member as expression
      -- if (expression_base = $lvalue(lvalue_base))

   ;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:60:1-62:47:
   clause 2(lvalue_base [ expression_index ]) = expression_base [ expression_index ] as expression
      -- if (expression_base = $lvalue(lvalue_base))

   ;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:63:1-65:47:
   clause 3(lvalue_base [ expression_hi : expression_lo ]) = expression_base [ expression_hi : expression_lo ] as expression
      -- if (expression_base = $lvalue(lvalue_base))

   ;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:66:1-67:37:
   clause 4(( lvalue )) = ( expression ) as expression
      -- if (expression = $lvalue(lvalue))

