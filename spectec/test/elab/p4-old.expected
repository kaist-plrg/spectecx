      -- (if ParameterType_alpha: parameterTypeIR_a ~~ parameterTypeIR_b holds)*
      -- if Type_alpha: typeIR_ret_a ~~ typeIR_ret_b holds

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:192:1-196:46:
   rule function: function ( parameterTypeIR_a*{} ) -> typeIR_ret_a as routineTypeIR ~~ function ( parameterTypeIR_b*{} ) -> typeIR_ret_b as routineTypeIR
      -- (if ParameterType_alpha: parameterTypeIR_a ~~ parameterTypeIR_b holds)*
      -- if Type_alpha: typeIR_ret_a ~~ typeIR_ret_b holds

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:198:1-200:68:
   rule action: action ( parameterTypeIR_a*{} ) as routineTypeIR ~~ action ( parameterTypeIR_b*{} ) as routineTypeIR
      -- (if ParameterType_alpha: parameterTypeIR_a ~~ parameterTypeIR_b holds)*

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:202:1-206:46:
