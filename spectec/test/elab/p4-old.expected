;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:419:1-419:44:
def $cast_fixbit'(typeIR, nat, int) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:423:1-423:42:
   clause 0(bool as typeIR, w, i) = b (i = 1 as int) as value

