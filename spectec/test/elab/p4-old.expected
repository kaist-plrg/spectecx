;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:8:1-8:31:
def $free_type(typeIR) : bound =

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:33:1-33:39:
   clause 0(baseTypeIR as typeIR) = { [] }

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:37:1-37:36:
   clause 1(tid tid as typeIR) = { [tid] }

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:39:1-42:59:
   clause 2(polyTypeDefIR < typeIR*{} > as typeIR) = $union_set<tid>(bound_base, bound_args)
      -- if (bound_base = $free_typeDef(polyTypeDefIR as typeDefIR))
      -- if (bound_args = $unions_set<tid>($free_type(typeIR)*{}))

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:46:1-46:54:
   clause 3(typedef _tid typeIR as typeIR) = $free_type(typeIR)

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:48:1-48:51:
   clause 4(type _tid typeIR as typeIR) = $free_type(typeIR)

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:52:1-52:55:
   clause 5(list < typeIR > as typeIR) = $free_type(typeIR)

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:54:1-55:42:
   clause 6(tuple < typeIR*{} > as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:57:1-57:52:
   clause 7(typeIR [ _nat ] as typeIR) = $free_type(typeIR)

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:59:1-60:42:
   clause 8(header _tid { typeIR _id ;*{} } as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:62:1-63:42:
   clause 9(header_union _tid { typeIR _id ;*{} } as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:65:1-66:42:
   clause 10(struct _tid { typeIR _id ;*{} } as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:68:1-68:43:
   clause 11(enum _tid { _id*{} } as typeIR) = { [] }

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:70:1-70:63:
   clause 12(enum _tid # typeIR { _valueFieldIR*{} } as typeIR) = $free_type(typeIR)

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:74:1-75:62:
   clause 13(extern _tid { _rid : routineTypeDefIR*{} } as typeIR) = $unions_set<tid>($free_routineTypeDef(routineTypeDefIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:77:1-80:64:
   clause 14(parser ( parameterTypeIR*{} ) as typeIR) = bound_params
      -- if (bound_params = $unions_set<tid>($free_parameterType(parameterTypeIR)*{}))

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:82:1-85:64:
   clause 15(control ( parameterTypeIR*{} ) as typeIR) = bound_params
      -- if (bound_params = $unions_set<tid>($free_parameterType(parameterTypeIR)*{}))

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:87:1-88:42:
   clause 16(package < typeIR*{} > as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:90:1-90:56:
   clause 17(table _tid # typeIR as typeIR) = $free_type(typeIR)

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:94:1-94:36:
   clause 18(default as typeIR) = { [] }

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:96:1-96:43:
   clause 19(header_invalid as typeIR) = { [] }

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:98:1-99:42:
   clause 20(seq < typeIR*{} > as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:101:1-102:42:
   clause 21(seq < typeIR*{} , ... > as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:104:1-105:42:
   clause 22(record { typeIR _id ;*{} } as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:107:1-108:42:
   clause 23(record { typeIR _id ;*{} , ... } as typeIR) = $unions_set<tid>($free_type(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/2.2.3-type-subst.spectec:110:1-111:42:
