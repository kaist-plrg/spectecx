   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:603:1-603:35:
   clause 5(int < w > as typeIR) = w s 0 as int as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:604:1-604:44:
   clause 6(varbit < w > as typeIR) = w v 0 as int # 0 as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:606:1-606:61:
   clause 7(tuple < typeIR*{} > as typeIR) = [ $default(typeIR)*{} ] as value

