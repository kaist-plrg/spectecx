relation Type_alpha: typeIR ~~ typeIR

   ;; ../../../../../spectec/specs/p4-old/2.2.5-type-alpha.spectec:27:1-28:27:
   rule basetype: baseTypeIR as typeIR ~~ baseTypeIR as typeIR

