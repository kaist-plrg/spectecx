   ;; ../../../../../spectec/specs/p4-old/5.15.2-typing-call-inference.spectec:59:1-62:53:
   clause 1(constraint, parameterTypeIR, nameIR = typedExpressionIR) = $gen_constraint_type(constraint, typeIR_param, typeIR_arg)
