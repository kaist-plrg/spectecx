;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:653:1-653:41:
def $sizeof_minSizeInBits'(typeIR) : nat =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:667:1-667:77:
   clause 0(typeIR) = $sizeof_minSizeInBits''($canon(typeIR))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:654:1-654:42:
def $sizeof_minSizeInBits''(typeIR) : nat =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:669:1-669:38:
   clause 0(bool as typeIR) = 1

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:670:1-670:45:
   clause 1(int < w > as typeIR) = w

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:671:1-671:45:
   clause 2(bit < w > as typeIR) = w

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:672:1-672:48:
   clause 3(varbit < _nat > as typeIR) = 0

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:673:1-673:76:
   clause 4(type _tid typeIR as typeIR) = $sizeof_minSizeInBits'(typeIR)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:674:1-674:88:
   clause 5(enum _tid # typeIR { _valueFieldIR*{} } as typeIR) = $sizeof_minSizeInBits'(typeIR)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:675:1-675:89:
   clause 6(tuple < typeIR*{} > as typeIR) = $sum($sizeof_minSizeInBits'(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:676:1-676:94:
   clause 7(typeIR [ n_size ] as typeIR) = ($sizeof_minSizeInBits'(typeIR) * n_size)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:677:1-677:100:
   clause 8(struct _tid { typeIR _id ;*{} } as typeIR) = $sum($sizeof_minSizeInBits'(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:678:1-678:100:
   clause 9(header _tid { typeIR _id ;*{} } as typeIR) = $sum($sizeof_minSizeInBits'(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:679:1-679:106:
   clause 10(header_union _tid { typeIR _id ;*{} } as typeIR) = $min($sizeof_minSizeInBits'(typeIR)*{})

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:656:1-656:43:
def $sizeof_minSizeInBytes(typeIR) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:685:1-686:48:
   clause 0(typeIR) = d (n_size / 8) as int as value
      -- if (n_size = $sizeof_minSizeInBits'(typeIR))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:658:1-658:42:
def $sizeof_maxSizeInBits(typeIR) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:692:1-692:69:
   clause 0(typeIR) = d $sizeof_maxSizeInBits'(typeIR) as int as value

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:659:1-659:41:
def $sizeof_maxSizeInBits'(typeIR) : nat =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:693:1-693:77:
   clause 0(typeIR) = $sizeof_maxSizeInBits''($canon(typeIR))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:660:1-660:42:
def $sizeof_maxSizeInBits''(typeIR) : nat =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:695:1-695:38:
   clause 0(bool as typeIR) = 1

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:696:1-696:45:
   clause 1(int < w > as typeIR) = w

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:697:1-697:45:
   clause 2(bit < w > as typeIR) = w

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:698:1-698:48:
   clause 3(varbit < w > as typeIR) = w

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:699:1-699:76:
   clause 4(type _tid typeIR as typeIR) = $sizeof_maxSizeInBits'(typeIR)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:700:1-700:88:
   clause 5(enum _tid # typeIR { _valueFieldIR*{} } as typeIR) = $sizeof_maxSizeInBits'(typeIR)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:701:1-701:89:
   clause 6(tuple < typeIR*{} > as typeIR) = $sum($sizeof_maxSizeInBits'(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:702:1-702:94:
   clause 7(typeIR [ n_size ] as typeIR) = ($sizeof_maxSizeInBits'(typeIR) * n_size)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:703:1-703:100:
   clause 8(struct _tid { typeIR _id ;*{} } as typeIR) = $sum($sizeof_maxSizeInBits'(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:704:1-704:100:
   clause 9(header _tid { typeIR _id ;*{} } as typeIR) = $sum($sizeof_maxSizeInBits'(typeIR)*{})

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:705:1-705:106:
   clause 10(header_union _tid { typeIR _id ;*{} } as typeIR) = $max($sizeof_maxSizeInBits'(typeIR)*{})

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:662:1-662:43:
def $sizeof_maxSizeInBytes(typeIR) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:711:1-712:48:
   clause 0(typeIR) = d (n_size / 8) as int as value
      -- if (n_size = $sizeof_maxSizeInBits'(typeIR))

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:6:1-7:15:
syntax prefixedNameIR = 
   | nameIR (from prefixedNameIR)
   | . nameIR (from prefixedNameIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:9:1-9:63:
def $prefixedNonTypeName(prefixedNonTypeName) : prefixedNameIR =

   ;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:10:1-10:65:
   clause 0(nonTypeName as prefixedNonTypeName) = $name(nonTypeName as name)

   ;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:11:1-11:71:
   clause 1(. nonTypeName) = . $name(nonTypeName as name)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:13:1-13:57:
def $prefixedTypeName(prefixedTypeName) : prefixedNameIR =

   ;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:14:1-14:56:
   clause 0(typeName as prefixedTypeName) = $name(typeName as name)

   ;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:15:1-15:63:
   clause 1(. typeName) = . $name(typeName as name)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:17:1-17:53:
def $flatten_prefixedNameIR(prefixedNameIR) : nameIR =

   ;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:18:1-18:51:
   clause 0(nameIR) = nameIR

   ;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:19:1-19:56:
   clause 1(. nameIR) = "." ++ nameIR

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:21:21-21:28:
syntax nameListIR = nameIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:27:26-27:29:
syntax typeParameterIR = tid

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:29:30-29:46:
syntax typeParameterListIR = typeParameterIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:38:3-38:66:
syntax parameterIR = 
   | annotationList direction typeIR nameIR constantInitializerOptIR (from parameterIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:40:26-40:38:
syntax parameterListIR = parameterIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:46:33-46:44:
syntax constructorParameterIR = parameterIR

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:48:37-48:49:
syntax constructorParameterListIR = parameterIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:56:28-56:56:
syntax namedExpressionIR = 
   | nameIR = typedExpressionIR (from namedExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:58:32-58:50:
syntax namedExpressionListIR = namedExpressionIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:68:30-68:47:
syntax literalExpressionIR = literalExpression

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:74:32-74:46:
syntax referenceExpressionIR = prefixedNameIR

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:80:30-80:47:
syntax defaultExpressionIR = defaultExpression

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:86:28-86:50:
syntax unaryExpressionIR = 
   | unop typedExpressionIR (from unaryExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:89:3-89:44:
syntax binaryExpressionIR = 
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:92:3-92:64:
syntax ternaryExpressionIR = 
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR (from ternaryExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:98:27-98:57:
syntax castExpressionIR = 
   | ( typeIR ) typedExpressionIR (from castExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:107:1-111:49:
syntax dataExpressionIR = 
   | {#} (from dataExpressionIR)
   | seq { typedExpressionListIR } (from dataExpressionIR)
   | seq { typedExpressionListIR , ... } (from dataExpressionIR)
   | record { namedExpressionListIR } (from dataExpressionIR)
   | record { namedExpressionListIR , ... } (from dataExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:120:3-120:19:
syntax errorAccessExpressionIR = 
   | error . nameIR (from errorAccessExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:123:3-123:32:
syntax memberAccessExpressionIR = 
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:126:1-127:68:
syntax indexAccessExpressionIR = 
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ] (from indexAccessExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:130:1-132:28:
syntax accessExpressionIR = 
   | error . nameIR (from errorAccessExpressionIR)
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ] (from indexAccessExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:143:1-146:26:
syntax routineTargetIR = 
   | nameIR (from prefixedNameIR)
   | . nameIR (from prefixedNameIR)
   | typedExpressionIR . nameIR (from routineTargetIR)
   | type prefixedNameIR . nameIR (from routineTargetIR)
   | ( routineTargetIR ) (from routineTargetIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:148:30-148:69:
syntax constructorTargetIR = 
   | prefixedNameIR < typeArgumentListIR > (from constructorTargetIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:151:1-152:66:
syntax callExpressionIR = 
   | constructorTargetIR ( argumentListIR ) (from callExpressionIR)
   | routineTargetIR < typeArgumentListIR > ( argumentListIR ) (from callExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:158:36-158:59:
syntax parenthesizedExpressionIR = 
   | ( typedExpressionIR ) (from parenthesizedExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:165:1-175:30:
syntax expressionIR = 
   | true (from literalExpression)
   | false (from literalExpression)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | nameIR (from prefixedNameIR)
   | . nameIR (from prefixedNameIR)
   | ... (from defaultExpression)
   | unop typedExpressionIR (from unaryExpressionIR)
   | typedExpressionIR binop typedExpressionIR (from binaryExpressionIR)
   | typedExpressionIR ? typedExpressionIR : typedExpressionIR (from ternaryExpressionIR)
   | ( typeIR ) typedExpressionIR (from castExpressionIR)
   | {#} (from dataExpressionIR)
   | seq { typedExpressionListIR } (from dataExpressionIR)
   | seq { typedExpressionListIR , ... } (from dataExpressionIR)
   | record { namedExpressionListIR } (from dataExpressionIR)
   | record { namedExpressionListIR , ... } (from dataExpressionIR)
   | error . nameIR (from errorAccessExpressionIR)
   | memberAccessBaseIR . nameIR (from memberAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR ] (from indexAccessExpressionIR)
   | typedExpressionIR [ typedExpressionIR : typedExpressionIR ] (from indexAccessExpressionIR)
   | constructorTargetIR ( argumentListIR ) (from callExpressionIR)
   | routineTargetIR < typeArgumentListIR > ( argumentListIR ) (from callExpressionIR)
   | ( typedExpressionIR ) (from parenthesizedExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:177:27-177:43:
syntax expressionNoteIR = 
   | ( typeIR ctk ) (from expressionNoteIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:180:3-180:36:
syntax typedExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:182:32-182:50:
syntax typedExpressionListIR = typedExpressionIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:185:1-186:22:
syntax memberAccessBaseIR = 
   | type prefixedNameIR (from memberAccessBaseIR)
   | expressionIR # expressionNoteIR (from typedExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:193:1-197:8:
syntax simpleKeysetExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR)
   | typedExpressionIR &&& typedExpressionIR (from simpleKeysetExpressionIR)
   | typedExpressionIR .. typedExpressionIR (from simpleKeysetExpressionIR)
   | default (from simpleKeysetExpressionIR)
   | _ (from simpleKeysetExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:199:39-199:64:
syntax simpleKeysetExpressionListIR = simpleKeysetExpressionIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:201:34-201:68:
syntax tupleKeysetExpressionIR = 
   | ( simpleKeysetExpressionListIR ) (from tupleKeysetExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:204:1-205:28:
syntax keysetExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR)
   | typedExpressionIR &&& typedExpressionIR (from simpleKeysetExpressionIR)
   | typedExpressionIR .. typedExpressionIR (from simpleKeysetExpressionIR)
   | default (from simpleKeysetExpressionIR)
   | _ (from simpleKeysetExpressionIR)
   | ( simpleKeysetExpressionListIR ) (from tupleKeysetExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:211:25-211:31:
syntax typeArgumentIR = typeIR

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:213:29-213:44:
syntax typeArgumentListIR = typeArgumentIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:220:1-223:8:
syntax argumentIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR)
   | nameIR = typedExpressionIR (from argumentIR)
   | nameIR = _ (from argumentIR)
   | _ (from argumentIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:225:25-225:36:
syntax argumentListIR = argumentIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:232:1-236:24:
syntax lvalueIR = 
   | nameIR (from prefixedNameIR)
   | . nameIR (from prefixedNameIR)
   | typedLvalueIR . nameIR (from lvalueIR)
   | typedLvalueIR [ typedExpressionIR ] (from lvalueIR)
   | typedLvalueIR [ typedExpressionIR : typedExpressionIR ] (from lvalueIR)
   | ( typedLvalueIR ) (from lvalueIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:238:24-238:49:
syntax typedLvalueIR = 
   | lvalueIR # ( typeIR ) (from typedLvalueIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:248:27-248:41:
syntax emptyStatementIR = emptyStatement

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:255:3-255:47:
syntax assignmentStatementIR = 
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:262:3-262:68:
syntax callStatementIR = 
   | routineTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:269:3-269:52:
syntax directApplicationStatementIR = 
   | prefixedNameIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:276:1-277:33:
syntax returnStatementIR = 
   | return ; (from returnStatementIR)
   | return typedExpressionIR ; (from returnStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:283:26-283:39:
syntax exitStatementIR = exitStatement

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:292:3-292:51:
syntax blockStatementIR = 
   | annotationList { blockElementStatementListIR } (from blockStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:301:1-302:60:
syntax conditionalStatementIR = 
   | if ( typedExpressionIR ) statementIR (from conditionalStatementIR)
   | if ( typedExpressionIR ) statementIR else statementIR (from conditionalStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:311:1-314:35:
syntax forInitStatementIR = 
   | annotationList typeIR nameIR initializerOptIR (from forInitStatementIR)
   | lvalueIR ( argumentListIR ) (from forInitStatementIR)
   | lvalueIR < typeArgumentListIR > ( argumentListIR ) (from forInitStatementIR)
   | lvalueIR assignop expressionIR (from forInitStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:316:33-316:52:
syntax forInitStatementListIR = forInitStatementIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:318:31-318:49:
syntax forUpdateStatementIR = forInitStatementIR

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:320:35-320:56:
syntax forUpdateStatementListIR = forUpdateStatementIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:323:1-324:45:
syntax forCollectionExpressionIR = 
   | expressionIR # expressionNoteIR (from typedExpressionIR)
   | typedExpressionIR .. typedExpressionIR (from forCollectionExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:327:1-335:18:
syntax forStatementIR = 
   | annotationList for ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR (from forStatementIR)
   | annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | annotationList for ( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:342:1-343:22:
syntax switchLabelIR = 
   | default (from switchLabelIR)
   | expressionIR # expressionNoteIR (from typedExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:346:1-347:22:
syntax switchCaseIR = 
   | switchLabelIR : blockStatementIR (from switchCaseIR)
   | switchLabelIR : (from switchCaseIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:349:27-349:40:
syntax switchCaseListIR = switchCaseIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:352:3-352:56:
syntax switchStatementIR = 
   | switch ( typedExpressionIR ) { switchCaseListIR } (from switchStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:358:27-358:41:
syntax breakStatementIR = breakStatement

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:360:30-360:47:
syntax continueStatementIR = continueStatement

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:367:1-378:22:
syntax statementIR = 
   | ; (from emptyStatement)
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)
   | routineTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)
   | prefixedNameIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)
   | return ; (from returnStatementIR)
   | return typedExpressionIR ; (from returnStatementIR)
   | exit ; (from exitStatement)
   | annotationList { blockElementStatementListIR } (from blockStatementIR)
   | if ( typedExpressionIR ) statementIR (from conditionalStatementIR)
   | if ( typedExpressionIR ) statementIR else statementIR (from conditionalStatementIR)
   | annotationList for ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR (from forStatementIR)
   | annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | annotationList for ( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | break ; (from breakStatement)
   | continue ; (from continueStatement)
   | switch ( typedExpressionIR ) { switchCaseListIR } (from switchStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:388:32-388:41:
syntax constantInitializerIR = 
   | = value (from constantInitializerIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:390:35-390:57:
syntax constantInitializerOptIR = constantInitializerIR?

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:393:3-393:63:
syntax constantDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:395:24-395:45:
syntax initializerIR = 
   | = typedExpressionIR (from initializerIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:397:27-397:41:
syntax initializerOptIR = initializerIR?

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:400:3-400:52:
syntax variableDeclarationIR = 
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:403:1-405:16:
syntax blockElementStatementIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | ; (from emptyStatement)
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)
   | routineTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)
   | prefixedNameIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)
   | return ; (from returnStatementIR)
   | return typedExpressionIR ; (from returnStatementIR)
   | exit ; (from exitStatement)
   | annotationList { blockElementStatementListIR } (from blockStatementIR)
   | if ( typedExpressionIR ) statementIR (from conditionalStatementIR)
   | if ( typedExpressionIR ) statementIR else statementIR (from conditionalStatementIR)
   | annotationList for ( forInitStatementListIR ; typedExpressionIR ; forUpdateStatementListIR ) statementIR (from forStatementIR)
   | annotationList for ( typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | annotationList for ( annotationList typeIR nameIR in forCollectionExpressionIR ) statementIR (from forStatementIR)
   | break ; (from breakStatement)
   | continue ; (from continueStatement)
   | switch ( typedExpressionIR ) { switchCaseListIR } (from switchStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:407:38-407:62:
syntax blockElementStatementListIR = blockElementStatementIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:414:3-415:76:
syntax functionPrototypeIR = 
   | typeIR nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) (from functionPrototypeIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:418:3-418:54:
syntax functionDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:425:3-425:70:
syntax actionDeclarationIR = 
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:433:30-433:63:
syntax objectInitializerIR = 
   | = { objectDeclarationListIR } (from objectInitializerIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:435:33-435:53:
syntax objectInitializerOptIR = objectInitializerIR?

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:438:3-440:31:
syntax instantiationIR = 
   | annotationList typeIR prefixedNameIR < typeArgumentListIR > ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:443:1-444:20:
syntax objectDeclarationIR = 
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR)
   | annotationList typeIR prefixedNameIR < typeArgumentListIR > ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:446:34-446:54:
syntax objectDeclarationListIR = objectDeclarationIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:452:29-452:51:
syntax errorDeclarationIR = 
   | error { nameListIR } (from errorDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:458:33-458:60:
syntax matchKindDeclarationIR = 
   | match_kind { nameListIR } (from matchKindDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:469:1-470:66:
syntax enumTypeDeclarationIR = 
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedExpressionListIR } (from enumTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:476:22-476:54:
syntax typeFieldIR = 
   | annotationList typeIR nameIR ; (from typeFieldIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:478:26-478:38:
syntax typeFieldListIR = typeFieldIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:481:3-482:76:
syntax structTypeDeclarationIR = 
   | annotationList struct nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:485:3-486:76:
syntax headerTypeDeclarationIR = 
   | annotationList header nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:489:3-490:76:
syntax headerUnionTypeDeclarationIR = 
   | annotationList header_union nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:493:1-496:33:
syntax derivedTypeDeclarationIR = 
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedExpressionListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:503:1-504:29:
syntax typedefTypeIR = 
   | void (from primitiveTypeIR)
   | bool (from primitiveTypeIR)
   | error (from primitiveTypeIR)
   | match_kind (from primitiveTypeIR)
   | string (from primitiveTypeIR)
   | int (from numberTypeIR)
   | int < nat > (from numberTypeIR)
   | bit < nat > (from numberTypeIR)
   | varbit < nat > (from numberTypeIR)
   | tid tid (from namedTypeIR)
   | polyTypeDefIR < typeIR* > (from namedTypeIR)
   | typedef tid typeIR (from aliasTypeIR)
   | type tid typeIR (from aliasTypeIR)
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | typeIR [ nat ] (from headerStackTypeIR)
   | struct tid { fieldTypeIR* } (from structTypeIR)
   | header tid { fieldTypeIR* } (from headerTypeIR)
   | header_union tid { fieldTypeIR* } (from headerUnionTypeIR)
   | enum tid { id* } (from enumTypeIR)
   | enum tid # typeIR { valueFieldIR* } (from enumTypeIR)
   | extern tid map<rid, routineTypeDefIR> (from externObjectTypeIR)
   | parser ( parameterTypeIR* ) (from parserObjectTypeIR)
   | control ( parameterTypeIR* ) (from controlObjectTypeIR)
   | package < typeIR* > (from packageObjectTypeIR)
   | table tid # typeIR (from tableObjectTypeIR)
   | default (from defaultTypeIR)
   | header_invalid (from invalidHeaderTypeIR)
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)
   | set < typeIR* > (from setTypeIR)
   | table_enum tid { id* } (from tableTypeIR)
   | table_struct tid { fieldTypeIR* } (from tableTypeIR)
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedExpressionListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:507:1-508:42:
syntax typedefDeclarationIR = 
   | annotationList typedef typedefTypeIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:515:3-515:48:
syntax externFunctionDeclarationIR = 
   | annotationList extern functionPrototypeIR ; (from externFunctionDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:518:1-520:52:
syntax methodPrototypeIR = 
   | annotationList nameIR < , typeParameterListIR > ( parameterListIR ) ; (from methodPrototypeIR)
   | annotationList functionPrototypeIR ; (from methodPrototypeIR)
   | annotationList abstract functionPrototypeIR ; (from methodPrototypeIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:522:32-522:50:
syntax methodPrototypeListIR = methodPrototypeIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:525:3-527:32:
syntax externObjectDeclarationIR = 
   | annotationList extern nameIR < typeParameterListIR , typeParameterListIR > { methodPrototypeListIR } (from externObjectDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:530:1-531:30:
syntax externDeclarationIR = 
   | annotationList extern functionPrototypeIR ; (from externFunctionDeclarationIR)
   | annotationList extern nameIR < typeParameterListIR , typeParameterListIR > { methodPrototypeListIR } (from externObjectDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:541:23-541:56:
syntax selectCaseIR = 
   | keysetExpressionIR : nameIR ; (from selectCaseIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:543:27-543:40:
syntax selectCaseListIR = selectCaseIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:546:3-546:60:
syntax selectExpressionIR = 
   | select ( typedExpressionListIR ) { selectCaseListIR } (from selectExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:553:1-554:23:
syntax stateExpressionIR = 
   | nameIR ; (from stateExpressionIR)
   | select ( typedExpressionListIR ) { selectCaseListIR } (from selectExpressionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:556:32-556:60:
syntax transitionStatementIR = 
   | transition stateExpressionIR (from transitionStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:563:3-563:75:
syntax valueSetDeclarationIR = 
   | annotationList value_set < typeIR > ( typedExpressionIR ) nameIR ; (from valueSetDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:570:3-571:80:
syntax parserTypeDeclarationIR = 
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:580:3-580:45:
syntax parserBlockStatementIR = 
   | annotationList { parserStatementListIR } (from parserBlockStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:583:1-590:27:
syntax parserStatementIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | ; (from emptyStatement)
   | typedLvalueIR assignop typedExpressionIR ; (from assignmentStatementIR)
   | routineTargetIR < typeArgumentListIR > ( argumentListIR ) ; (from callStatementIR)
   | prefixedNameIR . apply ( argumentListIR ) ; (from directApplicationStatementIR)
   | annotationList { parserStatementListIR } (from parserBlockStatementIR)
   | if ( typedExpressionIR ) statementIR (from conditionalStatementIR)
   | if ( typedExpressionIR ) statementIR else statementIR (from conditionalStatementIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:592:32-592:50:
syntax parserStatementListIR = parserStatementIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:595:3-596:54:
syntax parserStateIR = 
   | annotationList state nameIR { parserStatementListIR transitionStatementIR } (from parserStateIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:598:28-598:42:
syntax parserStateListIR = parserStateIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:601:1-604:26:
syntax parserLocalDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR prefixedNameIR < typeArgumentListIR > ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR)
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | annotationList value_set < typeIR > ( typedExpressionIR ) nameIR ; (from valueSetDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:607:3-607:28:
syntax parserLocalDeclarationListIR = parserLocalDeclarationIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:610:3-613:57:
syntax parserDeclarationIR = 
   | annotationList parser nameIR < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:623:18-623:23:
syntax constIR = const

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:625:21-625:29:
syntax constOptIR = constIR?

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:631:21-631:68:
syntax tableKeyIR = 
   | typedExpressionIR : nameIR annotationList ; (from tableKeyIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:633:25-633:36:
syntax tableKeyListIR = tableKeyIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:639:33-639:68:
syntax tableActionReferenceIR = 
   | prefixedNameIR ( argumentListIR ) (from tableActionReferenceIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:641:24-641:65:
syntax tableActionIR = 
   | annotationList tableActionReferenceIR ; (from tableActionIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:643:28-643:42:
syntax tableActionListIR = tableActionIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:650:1-651:45:
syntax tableEntryPriorityIR = 
   | priority = number : (from tableEntryPriorityIR)
   | priority = ( typedExpressionIR ) : (from tableEntryPriorityIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:653:34-653:55:
syntax tableEntryPriorityOptIR = tableEntryPriorityIR?

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:656:3-657:69:
syntax tableEntryIR = 
   | constOptIR tableEntryPriorityOptIR keysetExpressionIR : tableActionReferenceIR annotationList ; (from tableEntryIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:659:27-659:40:
syntax tableEntryListIR = tableEntryIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:666:1-672:76:
syntax tablePropertyIR = 
   | key = { tableKeyListIR } (from tablePropertyIR)
   | actions = { tableActionListIR } (from tablePropertyIR)
   | annotationList constOptIR entries = { tableEntryListIR } (from tablePropertyIR)
   | annotationList constOptIR default_action = tableActionReferenceIR ; (from tablePropertyIR)
   | annotationList constOptIR custom nameIR initializerIR ; (from tablePropertyIR)
   | annotationList constOptIR custom_const nameIR constantInitializerIR ; (from tablePropertyIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:674:30-674:46:
syntax tablePropertyListIR = tablePropertyIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:677:3-677:63:
syntax tableDeclarationIR = 
   | annotationList table typeIR nameIR { tablePropertyListIR } (from tableDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:684:3-686:30:
syntax controlTypeDeclarationIR = 
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:692:24-692:40:
syntax controlBodyIR = blockStatementIR

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:695:1-699:23:
syntax controlLocalDeclarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR prefixedNameIR < typeArgumentListIR > ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR)
   | annotationList typeIR nameIR initializerOptIR ; (from variableDeclarationIR)
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR)
   | annotationList table typeIR nameIR { tablePropertyListIR } (from tableDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:702:3-702:29:
syntax controlLocalDeclarationListIR = controlLocalDeclarationIR*

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:705:3-708:60:
syntax controlDeclarationIR = 
   | annotationList control nameIR < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:715:3-717:30:
syntax packageTypeDeclarationIR = 
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:724:1-728:29:
syntax typeDeclarationIR = 
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedExpressionListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)
   | annotationList typedef typedefTypeIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:735:1-744:22:
syntax declarationIR = 
   | annotationList const typeIR nameIR constantInitializerIR ; (from constantDeclarationIR)
   | annotationList typeIR prefixedNameIR < typeArgumentListIR > ( argumentListIR ) nameIR objectInitializerOptIR ; (from instantiationIR)
   | annotationList functionPrototypeIR blockStatementIR (from functionDeclarationIR)
   | annotationList action nameIR ( parameterListIR ) blockStatementIR (from actionDeclarationIR)
   | error { nameListIR } (from errorDeclarationIR)
   | match_kind { nameListIR } (from matchKindDeclarationIR)
   | annotationList extern functionPrototypeIR ; (from externFunctionDeclarationIR)
   | annotationList extern nameIR < typeParameterListIR , typeParameterListIR > { methodPrototypeListIR } (from externObjectDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from parserDeclarationIR)
   | annotationList control nameIR < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from controlDeclarationIR)
   | annotationList enum nameIR { nameListIR } (from enumTypeDeclarationIR)
   | annotationList enum typeIR nameIR { namedExpressionListIR } (from enumTypeDeclarationIR)
   | annotationList struct nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from structTypeDeclarationIR)
   | annotationList header nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerTypeDeclarationIR)
   | annotationList header_union nameIR < typeParameterListIR , typeParameterListIR > { typeFieldListIR } (from headerUnionTypeDeclarationIR)
   | annotationList typedef typedefTypeIR nameIR ; (from typedefDeclarationIR)
   | annotationList type typeIR nameIR ; (from typedefDeclarationIR)
   | annotationList parser nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from parserTypeDeclarationIR)
   | annotationList control nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from controlTypeDeclarationIR)
   | annotationList package nameIR < typeParameterListIR , typeParameterListIR > ( parameterListIR ) ; (from packageTypeDeclarationIR)

;; ../../../../../spectec/specs/p4-old/4-ir-syntax.spectec:750:22-750:40:
syntax p4programIR = 
   | declarationIR* ; (from p4programIR)

;; ../../../../../spectec/specs/p4-old/5.0-flow.spectec:5:15-5:25:
syntax flow = 
   | cont (from flow)
   | ret (from flow)

;; ../../../../../spectec/specs/p4-old/5.0-flow.spectec:9:1-9:34:
def $join_flow(flow, flow) : flow =

   ;; ../../../../../spectec/specs/p4-old/5.0-flow.spectec:10:1-10:31:
   clause 0(ret, ret) = ret

   ;; ../../../../../spectec/specs/p4-old/5.0-flow.spectec:11:1-12:15:
   clause 1(f_a, f_b) = cont
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:5:20-5:47:
syntax varTypeIR = 
   | direction typeIR ctk value? (from varTypeIR)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:12:16-12:34:
syntax frame = map<id, varTypeIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:14:1-14:27:
def $empty_frame : frame =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:15:1-15:47:
   clause 0 = $empty_map<id, varTypeIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:18:16-18:35:
syntax tdenv = map<tid, typeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:20:1-20:27:
def $empty_tdenv : tdenv =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:21:1-21:48:
   clause 0 = $empty_map<tid, typeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:24:16-24:42:
syntax rdenv = map<rid, routineTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:26:1-26:27:
def $empty_rdenv : rdenv =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:27:1-27:55:
   clause 0 = $empty_map<rid, routineTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:30:16-30:46:
syntax cdenv = map<cid, constructorTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:32:1-32:27:
def $empty_cdenv : cdenv =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:33:1-33:59:
   clause 0 = $empty_map<cid, constructorTypeDefIR>

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:39:1-39:39:
def $check_routine_name(id, id) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:40:1-40:50:
   clause 0(id_l, id_r) = (id_l = id_r)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:42:1-42:37:
def $check_arity(id?*, id*) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:43:1-43:72:
   clause 0(id_arg?{}*{}, id_param*{}) = (|id_arg?{}*{}| = |id_param*{}|)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:45:1-45:42:
def $check_arity_more(id?*, id*) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:46:1-46:77:
   clause 0(id_arg?{}*{}, id_param*{}) = (|id_arg?{}*{}| > |id_param*{}|)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:48:1-48:42:
def $check_arity_less(id?*, id*) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:49:1-49:77:
   clause 0(id_arg?{}*{}, id_param*{}) = (|id_arg?{}*{}| < |id_param*{}|)

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:51:1-51:44:
def $get_missing_parameters(id*, id*) : id* =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:53:1-53:48:
   clause 0([], id_arg*{}) = []

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:54:1-59:48:
   clause 1(id_param_h :: id_param_t*{}, id_arg*{}) = id_param_h :: $get_missing_parameters(id_param_t*{}, id_arg*{})
      -- if ~$in_set<id>(id_param_h, { id_arg*{} })

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:60:1-65:15:
   clause 2(id_param_h :: id_param_t*{}, id_arg*{}) = $get_missing_parameters(id_param_t*{}, id_arg*{})
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:68:1-68:61:
def $find_match_named<V>(rid, V, id*, pid*) : (rid, V, id*)? =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:70:1-72:52:
   clause 0(rid, V, id_arg*{}, id_param # bool_param*{}) = ?((rid, V, []))
      -- if $eq_set<id>({ id_arg*{} }, { id_param*{} })

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:73:1-74:15:
   clause 1(rid, V, id_arg*{}, pid*{}) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:77:1-77:69:
def $find_match_named_default<V>(rid, V, id*, pid*) : (rid, V, id*)? =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:79:1-86:18:
   clause 0(rid, V, id_arg*{}, id_param # bool_param*{}) = ?((rid, V, id_default*{}))
      -- if (id_default*{} = $get_missing_parameters(id_param*{}, id_arg*{}))
      -- if ($find_match_named<V>(rid, V, id_arg*{} ++ id_default*{}, id_param # bool_param*{}) =/= ?())

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:87:1-88:15:
   clause 1(rid, V, id_arg*{}, pid*{}) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:91:1-91:74:
def $find_match_unnamed_default<V>(rid, V, id?*, pid*) : (rid, V, id*)? =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:93:1-95:75:
   clause 0(rid, V, id_arg?{}*{}, pid*{}) = ?((rid, V, id_default*{}))
      -- if ((_pid*{}, id_default # true*{}) = $partition_<pid>(pid*{}, |id_arg?{}*{}|))

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:96:1-97:15:
   clause 1(rid, V, id_arg?{}*{}, pid*{}) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:100:1-100:64:
def $find_matching<V>(id, id?*, id*, rid, V) : (rid, V, id*)? =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:103:1-105:42:
   clause 0(id_r, id_arg?{}*{}, id_arg'*{}, id_r' ( pid_r'*{} ), V) = ?()
      -- if ~$check_routine_name(id_r, id_r')

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:107:1-113:50:
   clause 1(id_r, id_arg?{}*{}, id_arg'*{}, id_r' ( id_param' # bool_param'*{} ), V) = ?()
      -- if $check_routine_name(id_r, id_r')
      -- if $check_arity_more(id_arg?{}*{}, id_param'*{})

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:115:1-125:45:
   clause 2(id_r, id_arg?{}*{}, id_arg'*{}, id_r' ( id_param' # bool_param'*{} ), V) = $find_match_named<V>(id_r' ( id_param' # bool_param'*{} ), V, id_arg'*{}, id_param' # bool_param'*{})
      -- if (|id_arg'*{}| > 0)
      -- if $check_routine_name(id_r, id_r')
      -- if $check_arity(id_arg?{}*{}, id_param'*{})

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:127:1-133:45:
   clause 3(id_r, id_arg?{}*{}, [], id_r' ( id_param' # bool_param'*{} ), V) = ?((id_r' ( id_param' # bool_param'*{} ), V, []))
      -- if $check_routine_name(id_r, id_r')
      -- if $check_arity(id_arg?{}*{}, id_param'*{})

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:135:1-145:50:
   clause 4(id_r, id_arg?{}*{}, id_arg'*{}, id_r' ( id_param' # bool_param'*{} ), V) = $find_match_named_default<V>(id_r' ( id_param' # bool_param'*{} ), V, id_arg'*{}, id_param' # bool_param'*{})
      -- if (|id_arg'*{}| > 0)
      -- if $check_routine_name(id_r, id_r')
      -- if $check_arity_less(id_arg?{}*{}, id_param'*{})

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:147:1-156:50:
   clause 5(id_r, id_arg?{}*{}, [], id_r' ( id_param' # bool_param'*{} ), V) = $find_match_unnamed_default<V>(id_r' ( id_param' # bool_param'*{} ), V, id_arg?{}*{}, id_param' # bool_param'*{})
      -- if $check_routine_name(id_r, id_r')
      -- if $check_arity_less(id_arg?{}*{}, id_param'*{})

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:159:1-159:67:
def $find_matchings<V>(id, id?*, id*, rid*, V*) : (rid, V, id*)* =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:161:1-165:8:
   clause 0(id_r, id_arg?{}*{}, id_arg'*{}, [], []) = []

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:166:1-171:72:
   clause 1(id_r, id_arg?{}*{}, id_arg'*{}, rid_h :: rid_t*{}, V_h :: V_t*{}) = $find_matchings<V>(id_r, id_arg?{}*{}, id_arg'*{}, rid_t*{}, V_t*{})
      -- if ($find_matching<V>(id_r, id_arg?{}*{}, id_arg'*{}, rid_h, V_h) = ?())

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:172:1-178:66:
   clause 2(id_r, id_arg?{}*{}, id_arg'*{}, rid_h :: rid_t*{}, V_h :: V_t*{}) = (rid, V, id_default*{}) :: $find_matchings<V>(id_r, id_arg?{}*{}, id_arg'*{}, rid_t*{}, V_t*{})
      -- if (?((rid, V, id_default*{})) = $find_matching<V>(id_r, id_arg?{}*{}, id_arg'*{}, rid_h, V_h))

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:181:1-181:66:
def $find_overloaded<V>(map<rid, V>, id, id?*) : (rid, V, id*)? =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:184:1-190:71:
   clause 0({ rid : V*{} }, id_r, id_arg?{}*{}) = ?()
      -- if (|id_arg?{}*{}| > 0)
      -- (if (id_arg?{} = ?(id_arg')))*
      -- if ($find_matchings<V>(id_r, id_arg?{}*{}, id_arg'*{}, rid*{}, V*{}) = [])

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:191:1-198:65:
   clause 1({ rid : V*{} }, id_r, id_arg?{}*{}) = ?((rid', V', id_default*{}))
      -- if (|id_arg?{}*{}| > 0)
      -- (if (id_arg?{} = ?(id_arg')))*
      -- if ([(rid', V', id_default*{})] = $find_matchings<V>(id_r, id_arg?{}*{}, id_arg'*{}, rid*{}, V*{}))

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:200:1-205:66:
   clause 2({ rid : V*{} }, id_r, id_arg?{}*{}) = ?()
      -- (if (id_arg?{} = ?()))*
      -- if ($find_matchings<V>(id_r, id_arg?{}*{}, [], rid*{}, V*{}) = [])

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:206:1-212:60:
   clause 3({ rid : V*{} }, id_r, id_arg?{}*{}) = ?((rid', V', id_default*{}))
      -- (if (id_arg?{} = ?()))*
      -- if ([(rid', V', id_default*{})] = $find_matchings<V>(id_r, id_arg?{}*{}, [], rid*{}, V*{}))

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:218:1-218:50:
def $find_non_overloaded<V>(map<rid, V>, id) : V? =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:221:1-222:62:
   clause 0({ rid : V*{} }, id) = ?(V')
      -- if ([V'] = $find_non_overloaded'<V>({ rid : V*{} }, id))

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:223:1-224:15:
   clause 1({ rid : V*{} }, id) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:219:1-219:51:
def $find_non_overloaded'<V>(map<rid, V>, id) : V* =

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:226:1-226:50:
   clause 0({ [] }, id) = []

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:227:1-233:61:
   clause 1({ rid_h : V_h :: rid_t : V_t*{} }, id) = V_h :: V_t_found*{}
      -- if (id ( _pid*{} ) = rid_h)
      -- if (V_t_found*{} = $find_non_overloaded'<V>({ rid_t : V_t*{} }, id))

   ;; ../../../../../spectec/specs/p4-old/5.01-env.spectec:234:1-241:61:
   clause 2({ rid_h : V_h :: rid_t : V_t*{} }, id) = V_t_found*{}
      -- if (id_h ( _pid*{} ) = rid_h)
      -- if (id =/= id_h)
      -- if (V_t_found*{} = $find_non_overloaded'<V>({ rid_t : V_t*{} }, id))

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:5:17-5:39:
syntax cursor = 
   | global (from cursor)
   | block (from cursor)
   | local (from cursor)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:16:3-19:18:
syntax globalTypingLayer = {cdenv cdenv, tdenv tdenv, rdenv rdenv, frame frame}

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:24:1-28:12:
syntax blockKind = 
   |  (from blockKind)
   | extern (from blockKind)
   | parser (from blockKind)
   | control (from blockKind)
   | package (from blockKind)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:30:1-30:43:
def $is_extern_blockKind(blockKind) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:31:1-31:57:
   clause 0(blockKind) = (blockKind = extern)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:33:1-33:43:
def $is_parser_blockKind(blockKind) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:34:1-34:57:
   clause 0(blockKind) = (blockKind = parser)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:36:1-36:44:
def $is_control_blockKind(blockKind) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:37:1-37:59:
   clause 0(blockKind) = (blockKind = control)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:39:1-39:44:
def $is_package_blockKind(blockKind) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:40:1-40:59:
   clause 0(blockKind) = (blockKind = package)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:43:3-47:18:
syntax blockTypingLayer = {id id, kind blockKind, tdenv tdenv, rdenv rdenv, frame frame}

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:52:1-60:23:
syntax localKind = 
   |  (from localKind)
   | function -> typeIR (from localKind)
   | extern_function -> typeIR (from localKind)
   | action (from localKind)
   | extern_method -> typeIR (from localKind)
   | extern_method abstract -> typeIR (from localKind)
   | parser_state (from localKind)
   | control_apply_method (from localKind)
   | table_apply_method (from localKind)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:62:1-62:45:
def $is_function_localKind(localKind) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:63:1-63:51:
   clause 0(function -> _typeIR) = true

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:64:1-65:15:
   clause 1(_localKind) = false
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:67:1-67:52:
def $is_extern_function_localKind(localKind) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:68:1-70:11:
   clause 0(extern_function -> _typeIR) = true

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:71:1-72:15:
   clause 1(_localKind) = false
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:74:1-74:43:
def $is_action_localKind(localKind) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:75:1-75:40:
   clause 0(action) = true

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:76:1-77:15:
   clause 1(_localKind) = false
