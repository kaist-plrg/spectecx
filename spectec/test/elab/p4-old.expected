;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:900:1-900:44:
def $count_table_keys(tableProperty*) : nat =

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:902:1-902:31:
   clause 0([]) = 0

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:903:1-906:47:
   clause 1(key = { _tableKeyList } :: tableProperty_t*{}) = (1 + $count_table_keys(tableProperty_t*{}))

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:907:1-911:15:
   clause 2(tableProperty_h :: tableProperty_t*{}) = $count_table_keys(tableProperty_t*{})
      -- otherwise

