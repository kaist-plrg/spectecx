;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:7:1-7:25:
def $name(name) : nameIR =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:9:1-9:21:
   clause 0(t as name) = t

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:10:1-10:22:
   clause 1(t as name) = t

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:11:1-11:27:
   clause 2(apply as name) = "apply"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:12:1-12:23:
   clause 3(key as name) = "key"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:13:1-13:31:
   clause 4(actions as name) = "actions"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:14:1-14:27:
   clause 5(state as name) = "state"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:15:1-15:31:
   clause 6(entries as name) = "entries"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:16:1-16:25:
   clause 7(type as name) = "type"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:17:1-17:33:
   clause 8(priority as name) = "priority"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:18:1-18:25:
   clause 9(list) = "list"

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:20:1-20:47:
def $tableCustomName(tableCustomName) : nameIR =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:22:1-22:32:
   clause 0(t as tableCustomName) = t

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:23:1-23:33:
   clause 1(t as tableCustomName) = t

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:24:1-24:38:
   clause 2(apply) = "apply"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:25:1-25:38:
   clause 3(state) = "state"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:26:1-26:36:
   clause 4(type) = "type"

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:27:1-27:44:
   clause 5(priority) = "priority"

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:33:13-33:17:
syntax id = text

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:39:14-39:16:
syntax tid = id

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:41:1-41:31:
builtin dec $fresh_tid : tid

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:42:1-42:28:
def $fresh_tids(nat) : tid* =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:44:1-44:25:
   clause 0(0) = []

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:45:1-46:15:
   clause 1(n) = $fresh_tid :: $fresh_tids((n - 1))
      -- otherwise

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:56:14-56:25:
syntax pid = 
   | id # bool (from pid)

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:57:14-57:27:
syntax rid = 
   | id ( pid* ) (from rid)

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:59:1-59:36:
def $rid(name, parameterList) : rid =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:63:1-64:43:
   clause 0(name, parameterList) = $name(name) ( $pids(parameterList) )

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:60:1-60:32:
def $pids(parameterList) : pid* =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:66:1-66:24:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:67:1-67:39:
   clause 1(parameter as parameterList) = [$pid(parameter)]

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:68:1-69:56:
   clause 2(nonEmptyParameterList , parameter as parameterList) = $pids(nonEmptyParameterList as parameterList) ++ [$pid(parameter)]

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:61:1-61:26:
def $pid(parameter) : pid =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:71:1-71:52:
   clause 0(_annotationList _direction _type name) = $name(name) # false

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:72:1-72:56:
   clause 1(_annotationList _direction _type name initializer as initializerOpt) = $name(name) # true

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:78:14-78:17:
syntax cid = rid

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:80:1-80:50:
def $cid(name, constructorParameterListOpt) : cid =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:82:1-82:47:
   clause 0(name, ) = $name(name) ( [] )

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:83:1-84:43:
   clause 1(name, ( parameterList )) = $name(name) ( $pids(parameterList) )

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:88:1-88:48:
def $expression_as_lvalue(expression) : lvalue? =

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:90:1-90:69:
   clause 0(referenceExpression as expression) = ?(referenceExpression as lvalue)

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:91:1-92:51:
   clause 1(expression as memberAccessBase . member as expression) = ?(lvalue . member)
      -- if (?(lvalue) = $expression_as_lvalue(expression))

   ;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:93:1-94:51:
   clause 2(( expression ) as expression) = ?(( lvalue ))
      -- if (?(lvalue) = $expression_as_lvalue(expression))

;; ../../../../../spectec/specs/p4-old/2.0-domain.spectec:99:14-99:17:
syntax oid = id*

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:14:1-17:17:
syntax primitiveValue = 
   | b bool (from primitiveValue)
   | error . id (from primitiveValue)
   | match_kind . id (from primitiveValue)
   | " text " (from primitiveValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:24:1-25:22:
syntax numberValue = 
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | nat v int # nat (from numberValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:27:20-27:50:
syntax baseValue = 
   | b bool (from primitiveValue)
   | error . id (from primitiveValue)
   | match_kind . id (from primitiveValue)
   | " text " (from primitiveValue)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | nat v int # nat (from numberValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:35:20-35:32:
syntax listValue = 
   | [ value* ] (from listValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:36:21-36:33:
syntax tupleValue = 
   | ( value* ) (from tupleValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:37:27-37:58:
syntax headerStackValue = 
   | [ value* # ( nat ; nat ) ] (from headerStackValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:39:21-39:33:
syntax fieldValue = 
   | value id ; (from fieldValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:41:22-41:50:
syntax structValue = 
   | struct tid { fieldValue* } (from structValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:42:22-42:50:
syntax headerValue = 
   | header tid { fieldValue* } (from headerValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:43:27-43:61:
syntax headerUnionValue = 
   | header_union tid { fieldValue* } (from headerUnionValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:46:1-47:25:
syntax enumValue = 
   | tid . id (from enumValue)
   | tid . id # value (from enumValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:50:1-56:14:
syntax dataValue = 
   | [ value* ] (from listValue)
   | ( value* ) (from tupleValue)
   | [ value* # ( nat ; nat ) ] (from headerStackValue)
   | struct tid { fieldValue* } (from structValue)
   | header tid { fieldValue* } (from headerValue)
   | header_union tid { fieldValue* } (from headerUnionValue)
   | tid . id (from enumValue)
   | tid . id # value (from enumValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:62:23-62:30:
syntax defaultValue = 
   | default (from defaultValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:64:29-64:34:
syntax invalidHeaderValue = 
   | {#} (from invalidHeaderValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:67:1-68:31:
syntax sequenceValue = 
   | seq ( value* ) (from sequenceValue)
   | seq ( value* , ... ) (from sequenceValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:71:1-72:39:
syntax recordValue = 
   | record { fieldValue* } (from recordValue)
   | record { fieldValue* , ... } (from recordValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:75:1-77:31:
syntax setValue = 
   | set { value } (from setValue)
   | set { value &&& value } (from setValue)
   | set { value .. value } (from setValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:80:1-81:39:
syntax tableValue = 
   | table_enum tid . id (from tableValue)
   | table_struct tid { fieldValue* } (from tableValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:84:1-89:15:
syntax synthesizedValue = 
   | default (from defaultValue)
   | {#} (from invalidHeaderValue)
   | seq ( value* ) (from sequenceValue)
   | seq ( value* , ... ) (from sequenceValue)
   | record { fieldValue* } (from recordValue)
   | record { fieldValue* , ... } (from recordValue)
   | set { value } (from setValue)
   | set { value &&& value } (from setValue)
   | set { value .. value } (from setValue)
   | table_enum tid . id (from tableValue)
   | table_struct tid { fieldValue* } (from tableValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:95:31-95:38:
syntax objectReferenceValue = 
   | ! oid (from objectReferenceValue)

;; ../../../../../spectec/specs/p4-old/2.1.1-value.spectec:102:1-105:25:
syntax value = 
   | b bool (from primitiveValue)
   | error . id (from primitiveValue)
   | match_kind . id (from primitiveValue)
   | " text " (from primitiveValue)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | nat v int # nat (from numberValue)
   | [ value* ] (from listValue)
   | ( value* ) (from tupleValue)
   | [ value* # ( nat ; nat ) ] (from headerStackValue)
   | struct tid { fieldValue* } (from structValue)
   | header tid { fieldValue* } (from headerValue)
   | header_union tid { fieldValue* } (from headerUnionValue)
   | tid . id (from enumValue)
   | tid . id # value (from enumValue)
   | default (from defaultValue)
   | {#} (from invalidHeaderValue)
   | seq ( value* ) (from sequenceValue)
   | seq ( value* , ... ) (from sequenceValue)
   | record { fieldValue* } (from recordValue)
   | record { fieldValue* , ... } (from recordValue)
   | set { value } (from setValue)
   | set { value &&& value } (from setValue)
   | set { value .. value } (from setValue)
   | table_enum tid . id (from tableValue)
   | table_struct tid { fieldValue* } (from tableValue)
   | ! oid (from objectReferenceValue)

;; ../../../../../spectec/specs/p4-old/2.1.2-value-aux.spectec:5:1-5:36:
builtin dec $to_int(int, int) : int

;; ../../../../../spectec/specs/p4-old/2.1.2-value-aux.spectec:12:1-12:39:
builtin dec $to_bitstr(int, int) : int

;; ../../../../../spectec/specs/p4-old/2.1.2-value-aux.spectec:18:1-18:28:
def $to_number(value) : int =

   ;; ../../../../../spectec/specs/p4-old/2.1.2-value-aux.spectec:20:1-20:24:
   clause 0(d i as value) = i

   ;; ../../../../../spectec/specs/p4-old/2.1.2-value-aux.spectec:21:1-21:38:
   clause 1(w s i as value) = $to_int(w as int, i)

   ;; ../../../../../spectec/specs/p4-old/2.1.2-value-aux.spectec:22:1-22:26:
   clause 2(w w i as value) = i

   ;; ../../../../../spectec/specs/p4-old/2.1.2-value-aux.spectec:23:1-23:32:
   clause 3(w v i # _nat as value) = i

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:14:1-18:11:
syntax primitiveTypeIR = 
   | void (from primitiveTypeIR)
   | bool (from primitiveTypeIR)
   | error (from primitiveTypeIR)
   | match_kind (from primitiveTypeIR)
   | string (from primitiveTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:25:1-28:21:
syntax numberTypeIR = 
   | int (from numberTypeIR)
   | int < nat > (from numberTypeIR)
   | bit < nat > (from numberTypeIR)
   | varbit < nat > (from numberTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:30:21-30:51:
syntax baseTypeIR = 
   | void (from primitiveTypeIR)
   | bool (from primitiveTypeIR)
   | error (from primitiveTypeIR)
   | match_kind (from primitiveTypeIR)
   | string (from primitiveTypeIR)
   | int (from numberTypeIR)
   | int < nat > (from numberTypeIR)
   | bit < nat > (from numberTypeIR)
   | varbit < nat > (from numberTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:40:1-41:32:
syntax namedTypeIR = 
   | tid tid (from namedTypeIR)
   | polyTypeDefIR < typeIR* > (from namedTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:52:1-53:20:
syntax aliasTypeIR = 
   | typedef tid typeIR (from aliasTypeIR)
   | type tid typeIR (from aliasTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:59:21-59:38:
syntax listTypeIR = 
   | list < typeIR > (from listTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:60:22-60:41:
syntax tupleTypeIR = 
   | tuple < typeIR* > (from tupleTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:61:28-61:44:
syntax headerStackTypeIR = 
   | typeIR [ nat ] (from headerStackTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:63:22-63:35:
syntax fieldTypeIR = 
   | typeIR id ; (from fieldTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:65:23-65:52:
syntax structTypeIR = 
   | struct tid { fieldTypeIR* } (from structTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:66:23-66:52:
syntax headerTypeIR = 
   | header tid { fieldTypeIR* } (from headerTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:67:28-67:63:
syntax headerUnionTypeIR = 
   | header_union tid { fieldTypeIR* } (from headerUnionTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:69:23-69:39:
syntax valueFieldIR = 
   | id = value ; (from valueFieldIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:72:1-73:44:
syntax enumTypeIR = 
   | enum tid { id* } (from enumTypeIR)
   | enum tid # typeIR { valueFieldIR* } (from enumTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:76:1-82:15:
syntax dataTypeIR = 
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | typeIR [ nat ] (from headerStackTypeIR)
   | struct tid { fieldTypeIR* } (from structTypeIR)
   | header tid { fieldTypeIR* } (from headerTypeIR)
   | header_union tid { fieldTypeIR* } (from headerUnionTypeIR)
   | enum tid { id* } (from enumTypeIR)
   | enum tid # typeIR { valueFieldIR* } (from enumTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:92:3-92:40:
syntax externObjectTypeIR = 
   | extern tid map<rid, routineTypeDefIR> (from externObjectTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:93:29-93:58:
syntax parserObjectTypeIR = 
   | parser ( parameterTypeIR* ) (from parserObjectTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:94:30-94:60:
syntax controlObjectTypeIR = 
   | control ( parameterTypeIR* ) (from controlObjectTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:95:30-95:51:
syntax packageObjectTypeIR = 
   | package < typeIR* > (from packageObjectTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:96:28-96:48:
syntax tableObjectTypeIR = 
   | table tid # typeIR (from tableObjectTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:99:1-103:22:
syntax objectTypeIR = 
   | extern tid map<rid, routineTypeDefIR> (from externObjectTypeIR)
   | parser ( parameterTypeIR* ) (from parserObjectTypeIR)
   | control ( parameterTypeIR* ) (from controlObjectTypeIR)
   | package < typeIR* > (from packageObjectTypeIR)
   | table tid # typeIR (from tableObjectTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:106:1-108:17:
syntax definedTypeIR = 
   | typedef tid typeIR (from aliasTypeIR)
   | type tid typeIR (from aliasTypeIR)
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | typeIR [ nat ] (from headerStackTypeIR)
   | struct tid { fieldTypeIR* } (from structTypeIR)
   | header tid { fieldTypeIR* } (from headerTypeIR)
   | header_union tid { fieldTypeIR* } (from headerUnionTypeIR)
   | enum tid { id* } (from enumTypeIR)
   | enum tid # typeIR { valueFieldIR* } (from enumTypeIR)
   | extern tid map<rid, routineTypeDefIR> (from externObjectTypeIR)
   | parser ( parameterTypeIR* ) (from parserObjectTypeIR)
   | control ( parameterTypeIR* ) (from controlObjectTypeIR)
   | package < typeIR* > (from packageObjectTypeIR)
   | table tid # typeIR (from tableObjectTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:114:24-114:31:
syntax defaultTypeIR = 
   | default (from defaultTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:116:30-116:44:
syntax invalidHeaderTypeIR = 
   | header_invalid (from invalidHeaderTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:119:1-120:32:
syntax sequenceTypeIR = 
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:123:1-124:40:
syntax recordTypeIR = 
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:126:20-126:37:
syntax setTypeIR = 
   | set < typeIR* > (from setTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:129:1-130:40:
syntax tableTypeIR = 
   | table_enum tid { id* } (from tableTypeIR)
   | table_struct tid { fieldTypeIR* } (from tableTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:133:1-138:16:
syntax synthesizedTypeIR = 
   | default (from defaultTypeIR)
   | header_invalid (from invalidHeaderTypeIR)
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)
   | set < typeIR* > (from setTypeIR)
   | table_enum tid { id* } (from tableTypeIR)
   | table_struct tid { fieldTypeIR* } (from tableTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:145:1-148:22:
syntax typeIR = 
   | void (from primitiveTypeIR)
   | bool (from primitiveTypeIR)
   | error (from primitiveTypeIR)
   | match_kind (from primitiveTypeIR)
   | string (from primitiveTypeIR)
   | int (from numberTypeIR)
   | int < nat > (from numberTypeIR)
   | bit < nat > (from numberTypeIR)
   | varbit < nat > (from numberTypeIR)
   | tid tid (from namedTypeIR)
   | polyTypeDefIR < typeIR* > (from namedTypeIR)
   | typedef tid typeIR (from aliasTypeIR)
   | type tid typeIR (from aliasTypeIR)
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | typeIR [ nat ] (from headerStackTypeIR)
   | struct tid { fieldTypeIR* } (from structTypeIR)
   | header tid { fieldTypeIR* } (from headerTypeIR)
   | header_union tid { fieldTypeIR* } (from headerUnionTypeIR)
   | enum tid { id* } (from enumTypeIR)
   | enum tid # typeIR { valueFieldIR* } (from enumTypeIR)
   | extern tid map<rid, routineTypeDefIR> (from externObjectTypeIR)
   | parser ( parameterTypeIR* ) (from parserObjectTypeIR)
   | control ( parameterTypeIR* ) (from controlObjectTypeIR)
   | package < typeIR* > (from packageObjectTypeIR)
   | table tid # typeIR (from tableObjectTypeIR)
   | default (from defaultTypeIR)
   | header_invalid (from invalidHeaderTypeIR)
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)
   | set < typeIR* > (from setTypeIR)
   | table_enum tid { id* } (from tableTypeIR)
   | table_struct tid { fieldTypeIR* } (from tableTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:154:24-154:30:
syntax monoTypeDefIR = typeIR

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:156:24-156:50:
syntax polyTypeDefIR = 
   | typeIR < tid* , tid* > (from polyTypeDefIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:158:20-158:49:
syntax typeDefIR = 
   | void (from primitiveTypeIR)
   | bool (from primitiveTypeIR)
   | error (from primitiveTypeIR)
   | match_kind (from primitiveTypeIR)
   | string (from primitiveTypeIR)
   | int (from numberTypeIR)
   | int < nat > (from numberTypeIR)
   | bit < nat > (from numberTypeIR)
   | varbit < nat > (from numberTypeIR)
   | tid tid (from namedTypeIR)
   | polyTypeDefIR < typeIR* > (from namedTypeIR)
   | typedef tid typeIR (from aliasTypeIR)
   | type tid typeIR (from aliasTypeIR)
   | list < typeIR > (from listTypeIR)
   | tuple < typeIR* > (from tupleTypeIR)
   | typeIR [ nat ] (from headerStackTypeIR)
   | struct tid { fieldTypeIR* } (from structTypeIR)
   | header tid { fieldTypeIR* } (from headerTypeIR)
   | header_union tid { fieldTypeIR* } (from headerUnionTypeIR)
   | enum tid { id* } (from enumTypeIR)
   | enum tid # typeIR { valueFieldIR* } (from enumTypeIR)
   | extern tid map<rid, routineTypeDefIR> (from externObjectTypeIR)
   | parser ( parameterTypeIR* ) (from parserObjectTypeIR)
   | control ( parameterTypeIR* ) (from controlObjectTypeIR)
   | package < typeIR* > (from packageObjectTypeIR)
   | table tid # typeIR (from tableObjectTypeIR)
   | default (from defaultTypeIR)
   | header_invalid (from invalidHeaderTypeIR)
   | seq < typeIR* > (from sequenceTypeIR)
   | seq < typeIR* , ... > (from sequenceTypeIR)
   | record { fieldTypeIR* } (from recordTypeIR)
   | record { fieldTypeIR* , ... } (from recordTypeIR)
   | set < typeIR* > (from setTypeIR)
   | table_enum tid { id* } (from tableTypeIR)
   | table_struct tid { fieldTypeIR* } (from tableTypeIR)
   | typeIR < tid* , tid* > (from polyTypeDefIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:164:26-164:52:
syntax parameterTypeIR = 
   | direction typeIR id value? (from parameterTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:171:1-174:34:
syntax functionTypeIR = 
   | builtin_function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | extern_function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | action ( parameterTypeIR* ) (from functionTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:177:1-182:28:
syntax methodTypeIR = 
   | builtin_method ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | extern_method ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | extern_method abstract ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | parser_apply ( parameterTypeIR* ) (from methodTypeIR)
   | control_apply ( parameterTypeIR* ) (from methodTypeIR)
   | table_apply -> typeIR (from methodTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:185:1-186:17:
syntax routineTypeIR = 
   | builtin_function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | extern_function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | action ( parameterTypeIR* ) (from functionTypeIR)
   | builtin_method ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | extern_method ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | extern_method abstract ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | parser_apply ( parameterTypeIR* ) (from methodTypeIR)
   | control_apply ( parameterTypeIR* ) (from methodTypeIR)
   | table_apply -> typeIR (from methodTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:192:31-192:44:
syntax monoRoutineTypeDefIR = routineTypeIR

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:194:31-194:64:
syntax polyRoutineTypeDefIR = 
   | routineTypeIR < tid* , tid* > (from polyRoutineTypeDefIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:197:1-198:25:
syntax routineTypeDefIR = 
   | builtin_function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | extern_function ( parameterTypeIR* ) -> typeIR (from functionTypeIR)
   | action ( parameterTypeIR* ) (from functionTypeIR)
   | builtin_method ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | extern_method ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | extern_method abstract ( parameterTypeIR* ) -> typeIR (from methodTypeIR)
   | parser_apply ( parameterTypeIR* ) (from methodTypeIR)
   | control_apply ( parameterTypeIR* ) (from methodTypeIR)
   | table_apply -> typeIR (from methodTypeIR)
   | routineTypeIR < tid* , tid* > (from polyRoutineTypeDefIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:204:37-204:52:
syntax constructorParameterTypeIR = parameterTypeIR

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:211:3-211:60:
syntax constructorTypeIR = 
   | constructor ( constructorParameterTypeIR* ) -> typeIR (from constructorTypeIR)

;; ../../../../../spectec/specs/p4-old/2.2.1-type.spectec:217:31-217:68:
syntax constructorTypeDefIR = 
   | constructorTypeIR < tid* , tid* > (from constructorTypeDefIR)

