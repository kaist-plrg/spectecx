   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:915:1-915:34:
   clause 0([]) = 0

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:916:1-919:50:
   clause 1(actions = { _tableActionList } :: tableProperty_t*{}) = (1 + $count_table_actions(tableProperty_t*{}))

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:920:1-924:15:
