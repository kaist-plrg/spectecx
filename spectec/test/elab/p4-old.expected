;; ../../../../../spectec/specs/p4-old/5.04-typing-relation.spectec:103:1-103:48:
def $parameterIR(parameterIR) : parameterTypeIR =

   ;; ../../../../../spectec/specs/p4-old/5.04-typing-relation.spectec:104:1-105:32:
   clause 0(_annotationList direction typeIR nameIR ?()) = direction typeIR nameIR ?()

   ;; ../../../../../spectec/specs/p4-old/5.04-typing-relation.spectec:106:1-107:34:
   clause 1(_annotationList direction typeIR nameIR ?(= value)) = direction typeIR nameIR ?(value)

