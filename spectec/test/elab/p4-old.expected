   clause 1(error as typeIR) = true

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:14:1-14:59:
   clause 2(numberTypeIR as typeIR) = true

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:15:1-16:45:
   clause 3(type _tid typeIR as typeIR) = $compat_table_exact_optional_key(typeIR)

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:17:1-17:61:
   clause 4(enum _tid { _id*{} } as typeIR) = true

   ;; ../../../../../spectec/specs/p4-old/5.14.1-typing-control-table.spectec:18:1-19:45:
   clause 5(enum _tid # typeIR { _valueFieldIR*{} } as typeIR) = $compat_table_exact_optional_key(typeIR)

