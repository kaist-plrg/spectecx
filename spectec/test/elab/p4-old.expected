   clause 4(local, TC, id, argumentIR*{}) = $find_routine_overloaded(block, TC, id, argumentIR*{})

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:435:1-436:22:
def $find_routine_non_overloaded(cursor, typingContext, prefixedNameIR) : routineTypeDefIR? =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:438:1-439:64:
   clause 0(p, TC, . id) = $find_non_overloaded<routineTypeDefIR>(TC.global.rdenv, id)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:440:1-441:64:
   clause 1(global, TC, id) = $find_non_overloaded<routineTypeDefIR>(TC.global.rdenv, id)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:442:1-444:67:
   clause 2(block, TC, id) = ?(routineTypeDefIR)
      -- if (?(routineTypeDefIR) = $find_non_overloaded<routineTypeDefIR>(TC.block.rdenv, id))

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:445:1-448:67:
   clause 3(block, TC, id) = $find_routine_non_overloaded(global, TC, id)
      -- if (?() = $find_non_overloaded<routineTypeDefIR>(TC.block.rdenv, id))

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:449:1-450:54:
   clause 4(local, TC, id) = $find_routine_non_overloaded(block, TC, id)

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:454:1-455:38:
def $find_constructor_overloaded(typingContext, prefixedNameIR, argumentIR*) : (rid, constructorTypeDefIR, id*)? =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:457:1-460:49:
   clause 0(TC, . id, argumentIR*{}) = $find_overloaded<constructorTypeDefIR>(cdenv, id, id_arg?{}*{})
      -- if (cdenv = TC.global.cdenv)
      -- if (id_arg?{}*{} = $ids_arguments(argumentIR*{}))

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:461:1-464:49:
   clause 1(TC, id, argumentIR*{}) = $find_overloaded<constructorTypeDefIR>(cdenv, id, id_arg?{}*{})
      -- if (cdenv = TC.global.cdenv)
      -- if (id_arg?{}*{} = $ids_arguments(argumentIR*{}))

;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:468:1-468:47:
def $find_return_type(typingContext) : typeIR? =

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:470:1-471:49:
   clause 0(TC) = ?(typeIR_ret)
      -- if (function -> typeIR_ret = TC.local.kind)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:472:1-473:56:
   clause 1(TC) = ?(typeIR_ret)
      -- if (extern_function -> typeIR_ret = TC.local.kind)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:474:1-475:31:
   clause 2(TC) = ?(void as typeIR)
      -- if (action = TC.local.kind)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:476:1-477:54:
   clause 3(TC) = ?(typeIR_ret)
      -- if (extern_method -> typeIR_ret = TC.local.kind)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:478:1-480:22:
   clause 4(TC) = ?(typeIR_ret)
      -- if (extern_method abstract -> typeIR_ret = TC.local.kind)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:481:1-482:45:
   clause 5(TC) = ?(void as typeIR)
      -- if (control_apply_method = TC.local.kind)

   ;; ../../../../../spectec/specs/p4-old/5.02-context.spectec:483:1-484:15:
   clause 6(TC) = ?()
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:5:19-5:31:
syntax matchKey = (typeIR, id)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:7:22-7:72:
syntax matchAction = (prefixedNameIR, parameterTypeIR*, argumentListIR)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:10:3-13:24:
syntax matchPriority = {values nat*, init bool, delta nat, largest_wins bool}

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:16:3-17:17:
syntax matchEntry = {size nat, const bool}

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:21:1-27:11:
syntax matchMode = 
   | nopri (from matchMode)
   | noprilpm nat (from matchMode)
   | pri (from matchMode)
   | prilpm (from matchMode)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:30:3-34:21:
syntax tableContext = {keys matchKey*, actions matchAction*, priorities matchPriority, entries matchEntry, mode matchMode}

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:44:1-46:10:
syntax tableEntryState = 
   | lpm nat (from tableEntryState)
   | nolpm (from tableEntryState)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:54:1-54:38:
def $empty_tableContext : tableContext =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:55:1-68:25:
   clause 0 = {keys [], actions [], priorities matchPriority, entries matchEntry, mode nopri}
      -- if (matchPriority = {values [], init false, delta 1, largest_wins true})
      -- if (matchEntry = {size 0, const true})

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:76:1-76:54:
def $add_key(tableContext, id, typeIR) : tableContext =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:78:1-80:32:
   clause 0(TBLC, id, typeIR) = TBLC[keys = TBLC.keys ++ [matchKey]]
      -- if (matchKey = (typeIR, id))

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:84:1-84:95:
def $add_action(tableContext, prefixedNameIR, parameterTypeIR*, argumentListIR) : tableContext =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:86:1-88:73:
   clause 0(TBLC, prefixedNameIR, parameterTypeIR*{}, argumentListIR) = TBLC[actions = TBLC.actions ++ [matchAction]]
      -- if (matchAction = (prefixedNameIR, parameterTypeIR*{}, argumentListIR))

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:92:1-92:58:
def $add_table_priority(tableContext, nat) : tableContext =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:94:1-95:65:
   clause 0(TBLC, n) = TBLC[priorities.values = TBLC.priorities.values ++ [n]]

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:103:1-103:58:
def $update_mode(tableContext, id, typeIR) : tableContext =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:106:1-106:77:
   clause 0(TBLC, id, typeIR) = $update_mode'(TBLC, id, $canon(typeIR))

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:104:1-104:59:
def $update_mode'(tableContext, id, typeIR) : tableContext =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:107:1-108:26:
   clause 0(TBLC, "lpm", int < n > as typeIR) = TBLC[mode = noprilpm n]
      -- if (TBLC.mode = nopri)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:109:1-110:26:
   clause 1(TBLC, "lpm", bit < n > as typeIR) = TBLC[mode = noprilpm n]
      -- if (TBLC.mode = nopri)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:111:1-112:26:
   clause 2(TBLC, "lpm", varbit < n > as typeIR) = TBLC[mode = noprilpm n]
      -- if (TBLC.mode = nopri)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:113:1-114:38:
   clause 3(TBLC, "lpm", type _tid typeIR as typeIR) = $update_mode(TBLC, "lpm", typeIR)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:115:1-116:24:
   clause 4(TBLC, "lpm", _typeIR) = TBLC[mode = prilpm]
      -- if (TBLC.mode = pri)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:117:1-118:26:
   clause 5(TBLC, "range", _typeIR) = TBLC[mode = pri]
      -- if (TBLC.mode = nopri)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:119:1-120:26:
   clause 6(TBLC, "ternary", _typeIR) = TBLC[mode = pri]
      -- if (TBLC.mode = nopri)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:121:1-122:26:
   clause 7(TBLC, "optional", _typeIR) = TBLC[mode = pri]
      -- if (TBLC.mode = nopri)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:123:1-124:31:
   clause 8(TBLC, "range", _typeIR) = TBLC[mode = prilpm]
      -- if (TBLC.mode = noprilpm _nat)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:125:1-126:31:
   clause 9(TBLC, "ternary", _typeIR) = TBLC[mode = prilpm]
      -- if (TBLC.mode = noprilpm _nat)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:127:1-128:31:
   clause 10(TBLC, "optional", _typeIR) = TBLC[mode = prilpm]
      -- if (TBLC.mode = noprilpm _nat)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:129:1-130:15:
   clause 11(TBLC, _id, _typeIR) = TBLC
      -- otherwise

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:138:1-138:85:
def $find_action(tableContext, prefixedNameIR) : (parameterTypeIR*, argumentListIR)? =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:141:1-141:85:
   clause 0(TBLC, prefixedNameIR) = $find_action'(TBLC.actions, prefixedNameIR)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:139:1-139:86:
def $find_action'(matchAction*, prefixedNameIR) : (parameterTypeIR*, argumentListIR)? =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:143:1-143:45:
   clause 0([], prefixedNameIR) = ?()

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:145:1-147:75:
   clause 1(matchAction_h :: matchAction_t*{}, prefixedNameIR) = ?((parameterTypeIR*{}, argumentListIR))
      -- if ((prefixedNameIR, parameterTypeIR*{}, argumentListIR) = matchAction_h)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:149:1-152:44:
   clause 2(matchAction_h :: matchAction_t*{}, prefixedNameIR) = $find_action'(matchAction_t*{}, prefixedNameIR)
      -- if ((prefixedNameIR_h, _parameterTypeIR*{}, _argumentListIR) = matchAction_h)
      -- if (prefixedNameIR_h =/= prefixedNameIR)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:156:1-156:50:
def $find_table_priority_last(tableContext) : nat =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:158:1-159:36:
   clause 0(TBLC) = n*{}[(|n*{}| - 1)]
      -- if (n*{} = TBLC.priorities.values)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:165:1-165:78:
def $join_tableEntryState(tableEntryState, tableEntryState) : tableEntryState =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:167:1-167:48:
   clause 0(nolpm, lpm n) = lpm n

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:168:1-168:48:
   clause 1(lpm n, nolpm) = lpm n

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:169:1-169:48:
   clause 2(nolpm, nolpm) = nolpm

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:171:1-171:40:
def $tableEntry_lpm_prefix(value) : nat =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:174:1-174:70:
   clause 0(value) = $tableEntry_lpm_prefix'(value, 0)

;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:172:1-172:46:
def $tableEntry_lpm_prefix'(value, nat) : nat =

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:175:1-175:56:
   clause 0(0 w _int as value, n_prefix) = n_prefix

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:176:1-180:43:
   clause 1(w w n as int as value, n_prefix) = $tableEntry_lpm_prefix'(value', (n_prefix + 1))
      -- if (w > 0)
      -- if ((n \ 2) =/= 0)
      -- if (value' = (w - 1) w ((n - 1) / 2) as int as value)

   ;; ../../../../../spectec/specs/p4-old/5.03-table-context.spectec:181:1-185:37:
   clause 2(w w n as int as value, 0) = $tableEntry_lpm_prefix'(value', 0)
      -- if (w > 0)
      -- if ((n \ 2) = 0)
      -- if (value' = (w - 1) w (n / 2) as int as value)

;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:5:1-7:20:
relation Type_wf: bound |- typeIR

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:82:1-83:22:
   rule basetype: bound |- baseTypeIR as typeIR

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:87:1-89:33:
   rule tid: bound |- tid tid as typeIR
      -- if $in_set<tid>(tid, bound)

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:91:1-94:30:
   rule spectype: bound |- polyTypeDefIR < typeIR_arg*{} > as typeIR
      -- if (typeIR = $specialize_typeDef(polyTypeDefIR as typeDefIR, typeIR_arg*{}))
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:112:1-115:30:
   rule typedeftype: bound |- typedef _tid typeIR as typeIR
      -- if $nestable_typedef(typeIR)
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:129:1-132:30:
   rule newtype: bound |- type _tid typeIR as typeIR
      -- if $nestable_new(typeIR)
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:151:1-154:30:
   rule listttype: bound |- list < typeIR > as typeIR
      -- if $nestable_list(typeIR)
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:177:1-180:33:
   rule tupletype: bound |- tuple < typeIR*{} > as typeIR
      -- (if $nestable_tuple(typeIR))*
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:192:1-195:30:
   rule stacktype: bound |- typeIR [ _nat ] as typeIR
      -- if $nestable_stack(typeIR)
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:218:1-222:33:
   rule structtype: bound |- struct _tid { typeIR id ;*{} } as typeIR
      -- if $distinct_<id>(id*{})
      -- (if $nestable_struct(typeIR))*
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:255:1-259:33:
   rule headertype: bound |- header _tid { typeIR id ;*{} } as typeIR
      -- if $distinct_<id>(id*{})
      -- (if $nestable_header(typeIR))*
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:272:1-276:33:
   rule headeruniontype: bound |- header_union _tid { typeIR id ;*{} } as typeIR
      -- if $distinct_<id>(id*{})
      -- (if $nestable_headerunion(typeIR))*
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:278:1-280:28:
   rule enumtype: bound |- enum _tid { id*{} } as typeIR
      -- if $distinct_<id>(id*{})

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:306:1-310:30:
   rule serenumtype: bound |- enum _tid # typeIR { id = _value ;*{} } as typeIR
      -- if $distinct_<id>(id*{})
      -- if $nestable_serenum(typeIR)
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:314:1-316:53:
   rule externtype: bound |- extern _tid { _rid : routineTypeDefIR*{} } as typeIR
      -- (if RoutineTypeDef_wf: bound |- routineTypeDefIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:318:1-320:50:
   rule parsertype: bound |- parser ( parameterTypeIR*{} ) as typeIR
      -- if ParameterTypes_wf: bound |- parameterTypeIR*{} holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:322:1-324:50:
   rule controltype: bound |- control ( parameterTypeIR*{} ) as typeIR
      -- if ParameterTypes_wf: bound |- parameterTypeIR*{} holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:326:1-328:33:
   rule packagetype: bound |- package < typeIR*{} > as typeIR
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:330:1-333:30:
   rule tabletype: bound |- table _tid # typeIR as typeIR
      -- if (table_struct _tid' { _fieldTypeIR*{} } as typeIR = $canon(typeIR))
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:337:1-338:19:
   rule defaulttype: bound |- default as typeIR

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:340:1-342:33:
   rule sequencetype: bound |- seq < typeIR*{} > as typeIR
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:344:1-346:33:
   rule sequencedefaulttype: bound |- seq < typeIR*{} , ... > as typeIR
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:348:1-351:33:
   rule recordtype: bound |- record { typeIR id ;*{} } as typeIR
      -- if $distinct_<id>(id*{})
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:353:1-356:33:
   rule recorddefaulttype: bound |- record { typeIR id ;*{} , ... } as typeIR
      -- if $distinct_<id>(id*{})
      -- (if Type_wf: bound |- typeIR holds)*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:358:1-359:26:
   rule invalidtype: bound |- header_invalid as typeIR

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:414:1-417:30:
   rule settype: bound |- set < [typeIR] > as typeIR
      -- if $nestable_set(typeIR)
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:419:1-421:28:
   rule tableenumtype: bound |- table_enum _tid { id*{} } as typeIR
      -- if $distinct_<id>(id*{})

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:423:1-424:34:
   rule tablestructtype: bound |- table_struct _tid { _fieldTypeIR*{} } as typeIR

;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:9:1-11:20:
relation TypeDef_wf: bound |- typeDefIR

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:440:1-443:30:
   rule mono: bound |- typeIR as typeDefIR
      -- if $definable_type_mono(typeIR)
      -- if Type_wf: bound |- typeIR holds

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:459:1-465:36:
   rule poly: bound |- typeIR < tid_expl*{} , tid_impl*{} > as typeDefIR
      -- if $definable_type_poly(typeIR)
      -- if $distinct_<tid>(tid_expl*{} ++ tid_impl*{})
      -- if (bound_inner = $union_set<tid>(bound, { tid_expl*{} ++ tid_impl*{} }))
      -- if Type_wf: bound_inner |- typeIR holds

;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:13:1-15:20:
relation ParameterType_wf: bound |- parameterTypeIR

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:49:1-52:49:
   rule default-empty-extern: bound |- typeIR _id ?()
      -- if Type_wf: bound |- typeIR holds
      -- if $is_extern_object_typeIR($canon(typeIR))

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:54:1-57:50:
   rule default-none-not-extern: bound |- direction typeIR _id ?()
      -- if Type_wf: bound |- typeIR holds
      -- if ~$is_extern_object_typeIR($canon(typeIR))

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:59:1-62:49:
   rule default-some-extern: bound |- typeIR _id ?(value)
      -- if Type_wf: bound |- typeIR holds
      -- if $is_extern_object_typeIR($canon(typeIR))

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:64:1-68:45:
   rule default-some-not-extern: bound |- direction typeIR _id ?(value)
      -- if Type_wf: bound |- typeIR holds
      -- if ~$is_extern_object_typeIR($canon(typeIR))
      -- if ((direction = in) \/ (direction = ))

;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:17:1-19:20:
relation ParameterTypes_wf: bound |- parameterTypeIR*

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:70:1-74:51:
   rule : bound |- parameterTypeIR*{}
      -- (if (_direction _typeIR id _value?{} = parameterTypeIR))*
      -- if $distinct_<id>(id*{})
      -- (if ParameterType_wf: bound |- parameterTypeIR holds)*

;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:21:1-23:20:
relation RoutineType_wf: bound |- routineTypeIR

   ;; ../../../../../spectec/specs/p4-old/5.03-wellformed.spectec:473:1-476:34:
