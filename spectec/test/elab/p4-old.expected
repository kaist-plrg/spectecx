def $default'(typeIR) : value =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:596:1-596:30:
   clause 0(bool as typeIR) = b false as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:597:1-597:43:
