;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:239:1-239:36:
def $bin_eqs(value*, value*) : bool =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:280:1-280:30:
   clause 0([], []) = true

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:281:1-281:34:
   clause 1([], _value :: _value'*{}) = false

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:282:1-282:34:
   clause 2(_value :: _value'*{}, []) = false

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:283:1-284:70:
   clause 3(value_a_h :: value_a_t*{}, value_b_h :: value_b_t*{}) = ($bin_eq(value_a_h, value_b_h) /\ $bin_eqs(value_a_t*{}, value_b_t*{}))

;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:240:1-240:55:
def $bin_eqs_fields((value, id)*, (value, id)*) : bool =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:286:1-286:37:
   clause 0([], []) = true

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:287:1-287:41:
   clause 1([], _(value, id) :: _(value, id)'*{}) = false

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:288:1-288:41:
   clause 2(_(value, id) :: _(value, id)'*{}, []) = false

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:289:1-293:67:
   clause 3((value_a_h, id_a_h) :: (value_a_t, id_a_t)*{}, (value_b_h, id_b_h) :: (value_b_t, id_b_t)*{}) = (((id_a_h = id_b_h) /\ $bin_eq(value_a_h, value_b_h)) /\ $bin_eqs_fields((value_a_t, id_a_t)*{}, (value_b_t, id_b_t)*{}))

