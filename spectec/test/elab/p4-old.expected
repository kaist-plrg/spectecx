def $empty_theta : theta =

   ;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:6:1-6:47:
   clause 0 = $empty_map<tid, typeIR>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:9:15-9:29:
syntax venv = map<id, value>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:11:1-11:25:
def $empty_venv : venv =

   ;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:12:1-12:42:
   clause 0 = $empty_map<id, value>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:15:19-15:41:
syntax stateDyn = parserBlockStatementIR

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:18:15-18:36:
syntax senv = map<nameIR, stateDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:20:1-20:25:
def $empty_senv : senv =

   ;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:21:1-21:49:
   clause 0 = $empty_map<nameIR, stateDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:28:1-31:36:
syntax lvalueDyn = 
   | nameIR (from prefixedNameIR)
   | . nameIR (from prefixedNameIR)
   | lvalueDyn . nameIR (from lvalueDyn)
   | lvalueDyn [ value ] (from lvalueDyn)
   | lvalueDyn [ value : value ] (from lvalueDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:40:1-43:99:
syntax funcDyn = 
   | builtin_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementListIR } (from funcDyn)
   | function < typeParameterListIR > ( parameterListIR ) blockStatementIR (from funcDyn)
   | action ( parameterListIR ) { blockStatementIR } (from funcDyn)
   | extern_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementIR? } (from funcDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:46:1-51:42:
syntax methodDyn = 
   | builtin_method ( parameterListIR ) # lvalueDyn (from methodDyn)
   | extern_method < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from methodDyn)
   | extern_method abstract < typeParameterListIR > ( parameterListIR ) (from methodDyn)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; senv } (from methodDyn)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; renv ; blockElementStatementListIR } (from methodDyn)
   | table_apply { tablePropertyListIR } (from methodDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:54:1-55:14:
syntax routineDyn = 
   | builtin_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementListIR } (from funcDyn)
   | function < typeParameterListIR > ( parameterListIR ) blockStatementIR (from funcDyn)
   | action ( parameterListIR ) { blockStatementIR } (from funcDyn)
   | extern_function < typeParameterListIR > ( parameterListIR ) { blockElementStatementIR? } (from funcDyn)
   | builtin_method ( parameterListIR ) # lvalueDyn (from methodDyn)
   | extern_method < typeParameterListIR > ( parameterListIR ) blockStatementIR? (from methodDyn)
   | extern_method abstract < typeParameterListIR > ( parameterListIR ) (from methodDyn)
   | parser_apply ( parameterListIR ) { parserLocalDeclarationListIR ; senv } (from methodDyn)
   | control_apply ( parameterListIR ) { controlLocalDeclarationListIR ; renv ; blockElementStatementListIR } (from methodDyn)
   | table_apply { tablePropertyListIR } (from methodDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:58:15-58:35:
syntax renv = map<rid, routineDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:60:1-60:25:
def $empty_renv : renv =

   ;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:61:1-61:48:
   clause 0 = $empty_map<rid, routineDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:68:1-72:43:
syntax consDyn = 
   | extern nameIR < typeParameterListIR > ( constructorParameterListIR ) { methodPrototypeListIR } (from consDyn)
   | parser < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { parserLocalDeclarationListIR parserStateListIR } (from consDyn)
   | control < typeParameterListIR > ( parameterListIR ) ( constructorParameterListIR ) { controlLocalDeclarationListIR apply controlBodyIR } (from consDyn)
   | package < typeParameterListIR > ( constructorParameterListIR ) (from consDyn)
   | table nameIR { tablePropertyListIR } (from consDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:75:15-75:32:
syntax cenv = map<cid, consDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:77:1-77:25:
def $empty_cenv : cenv =

   ;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:78:1-78:45:
   clause 0 = $empty_map<cid, consDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:85:1-89:45:
syntax objDyn = 
   | extern { tid theta venv renv } (from objDyn)
   | parser { venv parameterListIR parserLocalDeclarationListIR senv } (from objDyn)
   | control { venv parameterListIR controlLocalDeclarationListIR renv controlBodyIR } (from objDyn)
   | package { theta venv } (from objDyn)
   | table { tid venv tablePropertyListIR } (from objDyn)

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:92:14-92:30:
syntax sto = map<oid, objDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:94:1-94:23:
def $empty_sto : sto =

   ;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:96:1-96:43:
   clause 0 = $empty_map<oid, objDyn>

;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:98:1-98:37:
def $add_sto(sto, oid, objDyn) : sto =

   ;; ../../../../../spectec/specs/p4-old/6.01-env-dynamic.spectec:100:1-101:44:
   clause 0(sto, oid, objDyn) = $add_map<oid, objDyn>(sto, oid, objDyn)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:8:3-11:16:
syntax globalInstantiationLayer = {cenv cenv, tdenv tdenv, renv renv, venv venv}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:16:3-19:16:
syntax blockInstantiationLayer = {theta theta, renv renv, senv senv, venv venv}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:24:3-25:18:
syntax localInstantiationLayer = {theta theta, venvs venv*}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:32:3-35:36:
syntax contextInst = {path oid, global globalInstantiationLayer, block blockInstantiationLayer, local localInstantiationLayer}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:43:1-43:45:
def $empty_block : blockInstantiationLayer =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:45:1-49:23:
   clause 0 = {theta $empty_theta, renv $empty_renv, senv $empty_senv, venv $empty_venv}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:51:1-51:45:
def $empty_local : localInstantiationLayer =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:53:1-55:17:
   clause 0 = {theta $empty_theta, venvs []}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:57:1-57:40:
def $empty_context_inst : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:59:1-71:11:
   clause 0 = Ci
      -- if ({cenv $empty_cenv, tdenv $empty_tdenv, renv $empty_renv, venv $empty_venv} = globalInstantiationLayer)
      -- if ($empty_block = blockInstantiationLayer)
      -- if ($empty_local = localInstantiationLayer)
      -- if ({path [], global globalInstantiationLayer, block blockInstantiationLayer, local localInstantiationLayer} = Ci)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:78:1-78:43:
def $enter_inst(contextInst) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:80:1-80:73:
   clause 0(Ci) = Ci[local.venvs = $empty_venv :: Ci.local.venvs]

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:82:1-82:42:
def $exit_inst(contextInst) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:84:1-85:43:
   clause 0(Ci) = Ci[local.venvs = venv_t*{}]
      -- if (Ci.local.venvs = venv_h :: venv_t*{})

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:91:1-91:47:
def $enter_path(contextInst, id) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:93:1-93:54:
   clause 0(Ci, id) = Ci[path = Ci.path ++ [id]]

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:99:1-99:58:
def $copy_context_inst(cursor, contextInst) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:101:1-101:90:
   clause 0(global, Ci) = Ci[block = $empty_block][local = $empty_local]

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:102:1-102:64:
   clause 1(block, Ci) = Ci[local = $empty_local]

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:103:1-103:39:
   clause 2(local, Ci) = Ci

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:111:1-111:65:
def $add_value_inst(cursor, contextInst, id, value) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:114:1-116:62:
   clause 0(global, Ci, id, value) = Ci[global.venv = venv]
      -- if ~$in_set<id>(id, $dom_map<id, value>(Ci.global.venv))
      -- if ($add_map<id, value>(Ci.global.venv, id, value) = venv)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:117:1-119:61:
   clause 1(block, Ci, id, value) = Ci[block.venv = venv]
      -- if ~$in_set<id>(id, $dom_map<id, value>(Ci.block.venv))
      -- if ($add_map<id, value>(Ci.block.venv, id, value) = venv)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:120:1-123:57:
   clause 2(local, Ci, id, value) = Ci[local.venvs = venv_h' :: venv_t*{}]
      -- if (Ci.local.venvs = venv_h :: venv_t*{})
      -- if ~$in_set<id>(id, $dom_map<id, value>(venv_h))
      -- if ($add_map<id, value>(venv_h, id, value) = venv_h')

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:112:1-112:68:
def $add_values_inst(cursor, contextInst, id*, value*) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:125:1-125:43:
   clause 0(p, Ci, [], []) = Ci

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:126:1-128:57:
   clause 1(p, Ci, id_h :: id_t*{}, value_h :: value_t*{}) = Ci''
      -- if ($add_value_inst(p, Ci, id_h, value_h) = Ci')
      -- if ($add_values_inst(p, Ci', id_t*{}, value_t*{}) = Ci'')

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:132:1-132:73:
def $add_typedef_inst(cursor, contextInst, tid, typeDefIR) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:134:1-135:74:
   clause 0(global, Ci, tid, typeDefIR) = Ci[global.tdenv = tdenv]
      -- if ($add_map<tid, typeDefIR>(Ci.global.tdenv, tid, typeDefIR) = tdenv)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:139:1-139:73:
def $add_state_inst(cursor, contextInst, nameIR, stateDyn) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:141:1-143:75:
   clause 0(block, Ci, nameIR, stateDyn) = Ci[block.senv = senv]
      -- if ~$in_set<nameIR>(nameIR, $dom_map<nameIR, stateDyn>(Ci.block.senv))
      -- if ($add_map<nameIR, stateDyn>(Ci.block.senv, nameIR, stateDyn) = senv)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:147:1-147:70:
def $add_types_inst(cursor, contextInst, tid*, typeIR*) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:150:1-150:42:
   clause 0(p, Ci, [], []) = Ci

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:151:1-153:53:
   clause 1(p, Ci, tid_h :: tid_t*{}, typeIR_h :: typeIR_t*{}) = $add_types_inst(p, Ci', tid_t*{}, typeIR_t*{})
      -- if ($add_type_inst(p, Ci, tid_h, typeIR_h) = Ci')

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:148:1-148:67:
def $add_type_inst(cursor, contextInst, tid, typeIR) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:155:1-156:67:
   clause 0(block, Ci, tid, typeIR) = Ci[block.theta = theta]
      -- if ($add_map<tid, typeIR>(Ci.block.theta, tid, typeIR) = theta)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:157:1-158:67:
   clause 1(local, Ci, tid, typeIR) = Ci[local.theta = theta]
      -- if ($add_map<tid, typeIR>(Ci.local.theta, tid, typeIR) = theta)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:162:1-162:83:
def $add_routine_overload_inst(cursor, contextInst, rid, routineDyn) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:164:1-166:74:
   clause 0(global, Ci, rid, routineDyn) = Ci[global.renv = renv]
      -- if ~$in_set<rid>(rid, $dom_map<rid, routineDyn>(Ci.global.renv))
      -- if ($add_map<rid, routineDyn>(Ci.global.renv, rid, routineDyn) = renv)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:167:1-169:73:
   clause 1(block, Ci, rid, routineDyn) = Ci[block.renv = renv]
      -- if ~$in_set<rid>(rid, $dom_map<rid, routineDyn>(Ci.block.renv))
      -- if ($add_map<rid, routineDyn>(Ci.block.renv, rid, routineDyn) = renv)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:171:1-171:87:
def $add_routine_non_overload_inst(cursor, contextInst, rid, routineDyn) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:173:1-177:74:
   clause 0(global, Ci, rid, routineDyn) = Ci[global.renv = renv]
      -- if (rid = id ( _pid*{} ))
      -- if ($dom_map<rid, routineDyn>(Ci.global.renv) = { id_k ( _pid'*{} )*{} })
      -- if ~$in_set<id>(id, { id_k*{} })
      -- if ($add_map<rid, routineDyn>(Ci.global.renv, rid, routineDyn) = renv)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:178:1-182:73:
   clause 1(block, Ci, rid, routineDyn) = Ci[block.renv = renv]
      -- if (rid = id ( _pid*{} ))
      -- if ($dom_map<rid, routineDyn>(Ci.block.renv) = { id_k ( _pid'*{} )*{} })
      -- if ~$in_set<id>(id, { id_k*{} })
      -- if ($add_map<rid, routineDyn>(Ci.block.renv, rid, routineDyn) = renv)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:186:1-186:75:
def $add_constructor_inst(cursor, contextInst, cid, consDyn) : contextInst =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:188:1-189:68:
   clause 0(global, Ci, cid, consDyn) = Ci[global.cenv = cenv]
      -- if ($add_map<cid, consDyn>(Ci.global.cenv, cid, consDyn) = cenv)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:197:1-197:66:
def $find_value_inst(cursor, contextInst, prefixedNameIR) : value =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:199:1-200:57:
   clause 0(p, Ci, . id) = value
      -- if ($find_map<id, value>(Ci.global.venv, id) = ?(value))

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:201:1-202:57:
   clause 1(global, Ci, id) = value
      -- if ($find_map<id, value>(Ci.global.venv, id) = ?(value))

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:203:1-204:56:
   clause 2(block, Ci, id) = value
      -- if ($find_map<id, value>(Ci.block.venv, id) = ?(value))

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:205:1-208:54:
   clause 3(block, Ci, id) = $find_value_inst(global, Ci, id)
      -- if ($find_map<id, value>(Ci.block.venv, id) = ?())

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:209:1-211:49:
   clause 4(local, Ci, id) = value
      -- if (Ci.local.venvs = venv*{})
      -- if ($find_maps<id, value>(venv*{}, id) = ?(value))

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:212:1-215:56:
   clause 5(local, Ci, id) = $find_value_inst(block, Ci, id)
      -- if ($find_maps<id, value>(Ci.local.venvs, id) = ?())

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:219:1-219:73:
def $find_typedef_inst(cursor, contextInst, prefixedNameIR) : typeDefIR? =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:221:1-222:55:
   clause 0(_cursor, Ci, nameIR) = $find_map<tid, typeDefIR>(Ci.global.tdenv, nameIR)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:223:1-224:55:
   clause 1(_cursor, Ci, . nameIR) = $find_map<tid, typeDefIR>(Ci.global.tdenv, nameIR)

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:228:1-228:44:
def $ids_arguments_IR(argumentIR*) : id?* =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:231:1-231:68:
   clause 0(argumentIR*{}) = $id_argument_IR(argumentIR)*{}

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:229:1-229:38:
def $id_argument_IR(argumentIR) : id? =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:232:1-232:45:
   clause 0(typedExpressionIR as argumentIR) = ?()

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:233:1-233:43:
   clause 1(nameIR = _typedExpressionIR) = ?(nameIR)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:234:1-234:45:
   clause 2(nameIR = _) = ?(nameIR)

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:235:1-235:31:
   clause 3(_) = ?()

;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:237:1-237:103:
def $find_constructor_overloaded_inst(contextInst, prefixedNameIR, argumentIR*) : (cid, consDyn, id*)? =

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:239:1-241:52:
   clause 0(Ci, id, argumentIR*{}) = $find_overloaded<consDyn>(Ci.global.cenv, id, id_arg?{}*{})
      -- if ($ids_arguments_IR(argumentIR*{}) = id_arg?{}*{})

   ;; ../../../../../spectec/specs/p4-old/6.02-context-instantiation.spectec:242:1-244:52:
   clause 1(Ci, . id, argumentIR*{}) = $find_overloaded<consDyn>(Ci.global.cenv, id, id_arg?{}*{})
      -- if ($ids_arguments_IR(argumentIR*{}) = id_arg?{}*{})

;; ../../../../../spectec/specs/p4-old/6.03-instantiation-relation.spectec:6:1-8:35:
relation Constructor_inst: cursor contextInst sto |- consDyn < typeArgumentListIR > ( argumentListIR # id* ) ==> sto objDyn

   ;; ../../../../../spectec/specs/p4-old/6.04-instantiation-constructor.spectec:89:1-110:15:
   rule extern: p Ci sto_0 |- extern nameIR < typeParameterIR*{} > ( constructorParameterIR*{} ) { methodPrototypeIR*{} } < typeArgumentIR*{} > ( argumentIR*{} # id_default*{} ) ==> sto_1 objDyn
      -- if (block = p_callee)
      -- if ($copy_context_inst(global, Ci) = Ci_callee_0)
      -- if ($add_types_inst(p_callee, Ci_callee_0, typeParameterIR*{}, typeArgumentIR*{}) = Ci_callee_1)
      -- if ($align_cparams_with_args(constructorParameterIR*{}, argumentIR*{}, id_default*{}) = (constructorParameterIR_aligned*{}, argumentIR_aligned*{}, constructorParameterIR_default*{}, value_default*{}))
      -- (if (constructorParameterIR_aligned = _annotationList _direction _typeIR id_aligned _constantInitializerOptIR))*
      -- rel Bind_args: p Ci ; p_callee Ci_callee_1 sto_0 |- id_aligned*{} argumentIR_aligned*{} ==> Ci_callee_2 sto_1
      -- (if (constructorParameterIR_default = _annotationList' _direction' _typeIR' id_cparam_default _constantInitializerOptIR'))*
      -- if ($add_values_inst(p_callee, Ci_callee_2, id_cparam_default*{}, value_default*{}) = Ci_callee_3)
      -- rel ExternMethods_inst: Ci_callee_3 |- methodPrototypeIR*{} ==> Ci_callee_4
      -- if (extern { nameIR Ci_callee_4.block.theta Ci_callee_4.block.venv Ci_callee_4.block.renv } = objDyn)

   ;; ../../../../../spectec/specs/p4-old/6.04-instantiation-constructor.spectec:114:1-141:15:
   rule parser: p Ci sto_0 |- parser < typeParameterIR*{} > ( parameterIR*{} ) ( constructorParameterIR*{} ) { parserLocalDeclarationIR*{} parserStateIR*{} } < typeArgumentIR*{} > ( argumentIR*{} # id_default*{} ) ==> sto_3 objDyn
      -- if (block = p_callee)
      -- if ($copy_context_inst(global, Ci) = Ci_callee_0)
      -- if ($add_types_inst(p_callee, Ci_callee_0, typeParameterIR*{}, typeArgumentIR*{}) = Ci_callee_1)
      -- if ($align_cparams_with_args(constructorParameterIR*{}, argumentIR*{}, id_default*{}) = (constructorParameterIR_aligned*{}, argumentIR_aligned*{}, constructorParameterIR_default*{}, value_default*{}))
      -- (if (constructorParameterIR_aligned = _annotationList _direction _typeIR id_aligned _constantInitializerOptIR))*
      -- rel Bind_args: p Ci ; p_callee Ci_callee_1 sto_0 |- id_aligned*{} argumentIR_aligned*{} ==> Ci_callee_2 sto_1
      -- (if (constructorParameterIR_default = _annotationList' _direction' _typeIR' id_cparam_default _constantInitializerOptIR'))*
      -- if ($add_values_inst(p_callee, Ci_callee_2, id_cparam_default*{}, value_default*{}) = Ci_callee_3)
      -- rel ParserLocalDecls_inst: Ci_callee_3 sto_1 |- parserLocalDeclarationIR*{} ==> Ci_local sto_2 parserLocalDeclarationIR_inst*{}
      -- if (stateDyn_empty = { [] })
      -- if ($add_state_inst(block, Ci_local, "accept", stateDyn_empty) = Ci_local_1)
      -- if ($add_state_inst(block, Ci_local_1, "reject", stateDyn_empty) = Ci_local_2)
      -- rel ParserStates_inst: Ci_local_2 sto_2 |- parserStateIR*{} ==> Ci_state sto_3
      -- if (parser { Ci_callee_3.block.venv parameterIR*{} parserLocalDeclarationIR_inst*{} Ci_state.block.senv } = objDyn)

   ;; ../../../../../spectec/specs/p4-old/6.04-instantiation-constructor.spectec:145:1-170:15:
   rule control: p Ci sto_0 |- control < typeParameterIR*{} > ( parameterIR*{} ) ( constructorParameterIR*{} ) { controlLocalDeclarationIR*{} apply controlBodyIR } < typeArgumentIR*{} > ( argumentIR*{} # id_default*{} ) ==> sto_3 objDyn
      -- if (block = p_callee)
      -- if ($copy_context_inst(global, Ci) = Ci_callee_0)
      -- if ($add_types_inst(p_callee, Ci_callee_0, typeParameterIR*{}, typeArgumentIR*{}) = Ci_callee_1)
      -- if ($align_cparams_with_args(constructorParameterIR*{}, argumentIR*{}, id_default*{}) = (constructorParameterIR_aligned*{}, argumentIR_aligned*{}, constructorParameterIR_default*{}, value_default*{}))
      -- (if (constructorParameterIR_aligned = _annotationList _direction _typeIR id_aligned _constantInitializerOptIR))*
      -- rel Bind_args: p Ci ; p_callee Ci_callee_1 sto_0 |- id_aligned*{} argumentIR_aligned*{} ==> Ci_callee_2 sto_1
      -- (if (constructorParameterIR_default = _annotationList' _direction' _typeIR' id_cparam_default _constantInitializerOptIR'))*
      -- if ($add_values_inst(p_callee, Ci_callee_2, id_cparam_default*{}, value_default*{}) = Ci_callee_3)
      -- rel ControlLocalDecls_inst: Ci_callee_3 sto_1 |- controlLocalDeclarationIR*{} ==> Ci_local sto_2 controlLocalDeclarationIR'*{}
      -- rel Block_inst: local Ci_local sto_2 |- controlBodyIR ==> _contextInst sto_3 controlBodyIR'
      -- if (control { Ci_callee_3.block.venv parameterIR*{} controlLocalDeclarationIR'*{} Ci_local.block.renv controlBodyIR' } = objDyn)

   ;; ../../../../../spectec/specs/p4-old/6.04-instantiation-constructor.spectec:174:1-193:15:
   rule package: p Ci sto_0 |- package < typeParameterIR*{} > ( constructorParameterIR*{} ) < typeArgumentIR*{} > ( argumentIR*{} # id_default*{} ) ==> sto_1 objDyn
      -- if (block = p_callee)
      -- if ($copy_context_inst(global, Ci) = Ci_callee_0)
      -- if ($add_types_inst(p_callee, Ci_callee_0, typeParameterIR*{}, typeArgumentIR*{}) = Ci_callee_1)
      -- if ($align_cparams_with_args(constructorParameterIR*{}, argumentIR*{}, id_default*{}) = (constructorParameterIR_aligned*{}, argumentIR_aligned*{}, constructorParameterIR_default*{}, value_default*{}))
      -- (if (constructorParameterIR_aligned = _annotationList _direction _typeIR id_aligned _constantInitializerOptIR))*
      -- rel Bind_args: p Ci ; p_callee Ci_callee_1 sto_0 |- id_aligned*{} argumentIR_aligned*{} ==> Ci_callee_2 sto_1
      -- (if (constructorParameterIR_default = _annotationList' _direction' _typeIR' id_cparam_default _constantInitializerOptIR'))*
      -- if ($add_values_inst(p_callee, Ci_callee_2, id_cparam_default*{}, value_default*{}) = Ci_callee_3)
      -- if (package { Ci_callee_3.block.theta Ci_callee_3.block.venv } = objDyn)

   ;; ../../../../../spectec/specs/p4-old/6.04-instantiation-constructor.spectec:202:1-227:15:
   rule table: p Ci sto |- table nameIR { tablePropertyListIR } < typeArgumentIR*{} > ( argumentIR*{} # id_default*{} ) ==> sto_2 objDyn
      -- if (local = p_callee)
      -- if ($copy_context_inst(block, Ci) = Ci_callee_0)
      -- if ($add_types_inst(p_callee, Ci_callee_0, [], typeArgumentIR*{}) = Ci_callee_1)
      -- if ($align_cparams_with_args([], argumentIR*{}, id_default*{}) = (constructorParameterIR_aligned*{}, argumentIR_aligned*{}, constructorParameterIR_default*{}, value_default*{}))
      -- (if (constructorParameterIR_aligned = _annotationList _direction _typeIR id_aligned _constantInitializerOptIR))*
      -- rel Bind_args: p Ci ; p_callee Ci_callee_1 sto |- id_aligned*{} argumentIR_aligned*{} ==> Ci_callee_2 sto_1
      -- (if (constructorParameterIR_default = _annotationList' _direction' _typeIR' id_cparam_default _constantInitializerOptIR'))*
      -- if ($add_values_inst(p_callee, Ci_callee_2, id_cparam_default*{}, value_default*{}) = Ci_callee_3)
