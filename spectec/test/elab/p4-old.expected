   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:617:1-618:58:
   clause 11(header_union tid { typeIR_f id_f ;*{} } as typeIR) = header_union tid { $default(typeIR_f) id_f ;*{} } as value

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:620:1-620:59:
