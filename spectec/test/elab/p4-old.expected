;; ../../../../../spectec/specs/p4-old/0-aux.spectec:18:1-18:29:
builtin dec $sum(nat*) : nat

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:20:1-20:29:
builtin dec $max(nat*) : nat

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:22:1-22:29:
builtin dec $min(nat*) : nat

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:28:1-28:37:
builtin dec $int_to_text(int) : text

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:30:1-30:31:
def $concat_text(text*) : text =

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:31:1-31:27:
   clause 0([]) = ""

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:32:1-32:58:
   clause 1(t_h :: t_t*{}) = t_h ++ $concat_text(t_t*{})

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:34:1-34:45:
builtin dec $strip_prefix(text, text) : text

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:35:1-35:45:
builtin dec $strip_suffix(text, text) : text

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:41:1-41:23:
def $init_(nat) : nat* =

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:42:1-42:20:
   clause 0(0) = []

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:43:1-44:15:
   clause 1(n) = (n - 1) :: $init_((n - 1))
      -- otherwise

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:46:1-46:29:
def $repeat_<X>(X, nat) : X* =

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:47:1-47:28:
   clause 0(X, 0) = []

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:48:1-49:15:
   clause 1(X, n) = [X] ++ $repeat_<X>(X, (n - 1))
      -- otherwise

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:51:1-51:30:
builtin dec $rev_<X>(X*) : X*

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:53:1-53:36:
builtin dec $concat_<X>(X**) : X*

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:55:1-55:47:
builtin dec $partition_<X>(X*, nat) : (X*, X*)

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:57:1-57:43:
builtin dec $assoc_<X, Y>(X, (X, Y)*) : Y?

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:59:1-59:37:
builtin dec $distinct_<K>(K*) : bool

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:65:17-65:25:
syntax set<K> = 
   | { K* } (from set<K>)

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:67:1-67:27:
def $empty_set<K> : set<K> =

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:68:1-68:30:
   clause 0 = { [] }

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:70:1-70:33:
def $in_set<K>(K, set<K>) : bool =

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:71:1-71:42:
   clause 0(K, { K_e*{} }) = K <- K_e*{}

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:73:1-73:55:
builtin dec $intersect_set<K>(set<K>, set<K>) : set<K>

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:75:1-75:51:
builtin dec $union_set<K>(set<K>, set<K>) : set<K>

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:77:1-77:45:
builtin dec $unions_set<K>(set<K>*) : set<K>

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:79:1-79:50:
builtin dec $diff_set<K>(set<K>, set<K>) : set<K>

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:81:1-81:47:
builtin dec $sub_set<K>(set<K>, set<K>) : bool

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:83:1-83:46:
builtin dec $eq_set<K>(set<K>, set<K>) : bool

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:89:21-89:28:
syntax pair<K, V> = 
   | K : V (from pair<K, V>)

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:91:20-91:35:
syntax map<K, V> = set<pair<K, V>>

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:93:1-93:33:
def $empty_map<K, V> : map<K, V> =

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:94:1-94:33:
   clause 0 = { [] }

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:96:1-96:39:
def $dom_map<K, V>(map<K, V>) : set<K> =

   ;; ../../../../../spectec/specs/p4-old/0-aux.spectec:97:1-97:48:
   clause 0({ K : V*{} }) = { K*{} }

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:99:1-99:47:
builtin dec $find_map<K, V>(map<K, V>, K) : V?

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:101:1-101:49:
builtin dec $find_maps<K, V>(map<K, V>*, K) : V?

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:103:1-103:56:
builtin dec $add_map<K, V>(map<K, V>, K, V) : map<K, V>

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:105:1-105:59:
builtin dec $adds_map<K, V>(map<K, V>, K*, V*) : map<K, V>

;; ../../../../../spectec/specs/p4-old/0-aux.spectec:107:1-107:59:
builtin dec $update_map<K, V>(map<K, V>, K, V) : map<K, V>

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:6:1-7:8:
syntax trailingCommaOpt = 
   |  (from trailingCommaOpt)
   | , (from trailingCommaOpt)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:14:1-16:35:
syntax number = 
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:22:24-22:61:
syntax stringLiteral = 
   | " text " (from stringLiteral) hint(print "#%#")

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:35:21-35:29:
syntax identifier = 
   | text (from identifier)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:36:25-36:34:
syntax typeIdentifier = 
   | text (from typeIdentifier)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:43:1-45:30:
syntax nonTypeName = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:48:1-49:24:
syntax prefixedNonTypeName = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:55:19-55:33:
syntax typeName = typeIdentifier

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:58:1-59:22:
syntax prefixedTypeName = 
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:66:1-68:36:
syntax tableCustomName = 
   | text (from identifier)
   | text (from typeIdentifier)
   | apply (from tableCustomName)
   | state (from tableCustomName)
   | type (from tableCustomName)
   | priority (from tableCustomName)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:75:1-77:9:
syntax name = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:80:1-81:22:
syntax nameList = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)
   | nameList , name (from nameList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:83:1-83:40:
def $flatten_nameList(nameList) : name* =

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:84:1-84:35:
   clause 0(name as nameList) = [name]

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:85:1-86:42:
   clause 1(nameList , name) = $flatten_nameList(nameList) ++ [name]

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:88:17-88:21:
syntax member = name

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:94:20-94:45:
syntax direction = 
   |  (from direction)
   | in (from direction)
   | out (from direction)
   | inout (from direction)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:107:1-118:34:
syntax baseType = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:126:26-126:65:
syntax specializedType = 
   | prefixedTypeName < typeArgumentList > (from specializedType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:129:1-130:20:
syntax namedType = 
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:136:26-136:52:
syntax headerStackType = 
   | namedType [ expression ] (from headerStackType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:144:19-144:42:
syntax listType = 
   | list < typeArgument > (from listType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:150:20-150:48:
syntax tupleType = 
   | tuple < typeArgumentList > (from tupleType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:157:1-161:14:
syntax type = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)
   | namedType [ expression ] (from headerStackType)
   | list < typeArgument > (from listType)
   | tuple < typeArgumentList > (from tupleType)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:164:1-166:15:
syntax typeOrVoid = 
   | bool (from baseType)
   | error (from baseType)
   | match_kind (from baseType)
   | string (from baseType)
   | int (from baseType)
   | int < int > (from baseType)
   | int < ( expression ) > (from baseType)
   | bit (from baseType)
   | bit < int > (from baseType)
   | bit < ( expression ) > (from baseType)
   | varbit < int > (from baseType)
   | varbit < ( expression ) > (from baseType)
   | text (from typeIdentifier)
   | . typeName (from prefixedTypeName)
   | prefixedTypeName < typeArgumentList > (from specializedType)
   | namedType [ expression ] (from headerStackType)
   | list < typeArgument > (from listType)
   | tuple < typeArgumentList > (from tupleType)
   | void (from typeOrVoid)
   | text (from identifier)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:172:24-172:28:
syntax typeParameter = name

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:175:1-176:40:
syntax typeParameterList = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | text (from typeIdentifier)
   | list (from name)
   | typeParameterList , typeParameter (from typeParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:178:1-178:67:
def $flatten_typeParameterList(typeParameterList) : typeParameter* =

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:179:1-179:62:
   clause 0(typeParameter as typeParameterList) = [typeParameter]

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:180:1-181:69:
   clause 1(typeParameterList , typeParameter) = $flatten_typeParameterList(typeParameterList) ++ [typeParameter]

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:184:1-185:28:
syntax typeParameterListOpt = 
   |  (from typeParameterListOpt)
   | < typeParameterList > (from typeParameterListOpt)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:187:1-187:73:
def $flatten_typeParameterListOpt(typeParameterListOpt) : typeParameter* =

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:188:1-188:48:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:189:1-190:50:
   clause 1(< typeParameterList >) = $flatten_typeParameterList(typeParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:199:3-199:52:
syntax parameter = 
   | annotationList direction type name initializerOpt (from parameter)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:202:1-203:40:
syntax nonEmptyParameterList = 
   | annotationList direction type name initializerOpt (from parameter)
   | nonEmptyParameterList , parameter (from nonEmptyParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:206:1-207:26:
syntax parameterList = 
   |  (from parameterList)
   | annotationList direction type name initializerOpt (from parameter)
   | nonEmptyParameterList , parameter (from nonEmptyParameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:209:1-209:55:
def $flatten_parameterList(parameterList) : parameter* =

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:210:1-210:41:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:211:1-211:50:
   clause 1(parameter as parameterList) = [parameter]

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:212:1-213:67:
   clause 2(nonEmptyParameterList , parameter as parameterList) = $flatten_parameterList(nonEmptyParameterList as parameterList) ++ [parameter]

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:219:31-219:40:
syntax constructorParameter = parameter

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:221:35-221:48:
syntax constructorParameterList = parameterList

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:224:1-225:24:
syntax constructorParameterListOpt = 
   |  (from constructorParameterListOpt)
   | ( parameterList ) (from constructorParameterListOpt)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:227:1-228:26:
def $flatten_constructorParameterListOpt(constructorParameterListOpt) : constructorParameter* =

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:230:1-230:55:
   clause 0() = []

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:231:1-232:42:
   clause 1(( parameterList )) = $flatten_parameterList(parameterList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:238:26-238:45:
syntax namedExpression = 
   | name = expression (from namedExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:241:1-242:44:
syntax namedExpressionList = 
   | name = expression (from namedExpression)
   | namedExpressionList , namedExpression (from namedExpressionList)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:244:1-244:73:
def $flatten_namedExpressionList(namedExpressionList) : namedExpression* =

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:245:1-245:68:
   clause 0(namedExpression as namedExpressionList) = [namedExpression]

   ;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:246:1-247:75:
   clause 1(namedExpressionList , namedExpression) = $flatten_namedExpressionList(namedExpressionList) ++ [namedExpression]

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:258:1-260:18:
syntax literalExpression = 
   | true (from literalExpression)
   | false (from literalExpression)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:267:1-268:9:
syntax referenceExpression = 
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
   | entries (from nonTypeName)
   | type (from nonTypeName)
   | priority (from nonTypeName)
   | . nonTypeName (from prefixedNonTypeName)
   | this (from referenceExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:274:28-274:33:
syntax defaultExpression = 
   | ... (from defaultExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:282:15-282:36:
syntax unop = 
   | ! (from unop)
   | ~ (from unop)
   | - (from unop)
   | + (from unop)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:284:26-284:41:
syntax unaryExpression = 
   | unop expression (from unaryExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:287:1-289:41:
syntax binop = 
   | * (from binop)
   | / (from binop)
   | % (from binop)
   | + (from binop)
   | - (from binop)
   | |+| (from binop)
   | |-| (from binop)
   | << (from binop)
   | >> (from binop)
   | <= (from binop)
   | >= (from binop)
   | < (from binop)
   | > (from binop)
   | != (from binop)
   | == (from binop)
   | & (from binop)
   | ^ (from binop)
   | | (from binop)
   | ++ (from binop)
   | && (from binop)
   | || (from binop)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:291:27-291:54:
syntax binaryExpression = 
   | expression binop expression (from binaryExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:294:3-294:38:
syntax binaryExpressionNonBrace = 
   | expressionNonBrace binop expression (from binaryExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:297:3-297:43:
syntax ternaryExpression = 
   | expression ? expression : expression (from ternaryExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:300:3-300:51:
syntax ternaryExpressionNonBrace = 
   | expressionNonBrace ? expression : expression (from ternaryExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:306:25-306:46:
syntax castExpression = 
   | ( type ) expression (from castExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:315:1-316:49:
syntax dataExpression = 
   | {#} (from dataExpression)
   | { dataElementExpression trailingCommaOpt } (from dataExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:325:3-325:19:
syntax errorAccessExpression = 
   | error . member (from errorAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:328:3-328:30:
syntax memberAccessExpression = 
   | memberAccessBase . member (from memberAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:331:1-332:47:
syntax indexAccessExpression = 
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression : expression ] (from indexAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:335:1-337:26:
syntax accessExpression = 
   | error . member (from errorAccessExpression)
   | memberAccessBase . member (from memberAccessExpression)
   | expression [ expression ] (from indexAccessExpression)
   | expression [ expression : expression ] (from indexAccessExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:340:3-340:38:
syntax memberAccessExpressionNonBrace = 
   | memberAccessBaseNonBrace . member (from memberAccessExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:343:1-344:55:
syntax indexAccessExpressionNonBrace = 
   | expressionNonBrace [ expression ] (from indexAccessExpressionNonBrace)
   | expressionNonBrace [ expression : expression ] (from indexAccessExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:347:1-349:34:
syntax accessExpressionNonBrace = 
   | error . member (from errorAccessExpression)
   | memberAccessBaseNonBrace . member (from memberAccessExpressionNonBrace)
   | expressionNonBrace [ expression ] (from indexAccessExpressionNonBrace)
   | expressionNonBrace [ expression : expression ] (from indexAccessExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:363:1-364:64:
syntax callExpression = 
   | callTarget ( argumentList ) (from callExpression)
   | routineTarget < realTypeArgumentList > ( argumentList ) (from callExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:367:1-368:72:
syntax callExpressionNonBrace = 
   | callTargetNonBrace ( argumentList ) (from callExpressionNonBrace)
   | routineTargetNonBrace < realTypeArgumentList > ( argumentList ) (from callExpressionNonBrace)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:374:34-374:50:
syntax parenthesizedExpression = 
   | ( expression ) (from parenthesizedExpression)

;; ../../../../../spectec/specs/p4-old/1-syntax.spectec:381:1-391:28:
syntax expression = 
   | true (from literalExpression)
   | false (from literalExpression)
   | d int (from number) hint(print %)
   | nat w int (from number) hint(print %#W#%)
   | nat s int (from number) hint(print %#S#%)
   | " text " (from stringLiteral) hint(print "#%#")
   | text (from identifier)
   | apply (from nonTypeName)
   | key (from nonTypeName)
   | actions (from nonTypeName)
   | state (from nonTypeName)
