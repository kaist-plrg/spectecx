def $bin_eq(value, value) : bool =

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:242:1-243:42:
   clause 0(primitiveValue_a as value, primitiveValue_b as value) = (primitiveValue_a = primitiveValue_b)

   ;; ../../../../../spectec/specs/p4-old/3-numerics.spectec:245:1-245:40:
