   ;; ../../../../../spectec/specs/p4-old/5.06.2-typing-expression.spectec:1134:1-1134:81:
   clause 0(extern_method abstract ( _parameterTypeIR*{} ) -> _typeIR as routineTypeIR) = false

   ;; ../../../../../spectec/specs/p4-old/5.06.2-typing-expression.spectec:1135:1-1136:15:
   clause 1(_routineTypeIR) = true
      -- otherwise

