def $callable_function(cursor, typingContext) : bool =

   ;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:268:1-268:43:
   clause 0(global, TC) = false

   ;; ../../../../../spectec/specs/p4-old/5.15.4-typing-routine-call.spectec:269:1-271:44:
