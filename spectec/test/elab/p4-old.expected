   ;; ../../../../../spectec/specs/p4-old/5.06.2-typing-expression.spectec:1122:1-1123:42:
   clause 0(typeIR) = true
      -- if ~$is_extern_object_typeIR(typeIR)

   ;; ../../../../../spectec/specs/p4-old/5.06.2-typing-expression.spectec:1124:1-1125:58:
   clause 1(extern _tid { _rid : routineTypeDefIR*{} } as typeIR) = true
      -- (if $is_concrete_extern_object''(routineTypeDefIR))*

   ;; ../../../../../spectec/specs/p4-old/5.06.2-typing-expression.spectec:1126:1-1127:15:
