syntax id = _ID text
syntax literal = _NUM int

syntax type = NUM | type '->' type | _TVAR nat

syntax expr =
  | literal
  | expr '+' expr
  | expr '-' expr
  | id
  | LAMBDA id '.' expr
  | expr expr

syntax value, binding, env

syntax value =
  | literal
  | `< LAMBDA id '.' expr ',' env `>

syntax binding = id -> value
syntax env = binding*

var x : id
var e : expr
var n : int
var v : value

syntax typebinding = id ':' type
syntax tenv = typebinding*
syntax constraint = type '=' type
syntax constraints = constraint*
syntax substbinding = nat -> type
syntax subst = substbinding*

var t : type
var k : nat

;; Lookup is defined only for identifiers in $domain(env).
dec $lookup(env, id) : value
dec $domain(env) : id*
dec $update(env, id, value) : env

dec $lookup_type(tenv, id) : type
dec $domain_type(tenv) : id*
dec $update_type(tenv, id, type) : tenv

dec $lookup_subst(subst, nat) : type?

dec $resolve(subst, type) : type

dec $occurs(nat, type) : bool

dec $is_type_var(type) : bool

relation Infer_expr:
  tenv ; nat |- expr : type -| constraints ; nat
  hint(input %0 %1 %2)

rule Infer_expr/num:
  tenv ; k |- (_NUM n) : NUM -| eps ; k

rule Infer_expr/id:
  tenv ; k |- x : $lookup_type(tenv, x) -| eps ; k
  -- if x <- $domain_type(tenv)

rule Infer_expr/fun:
  tenv ; k |- (LAMBDA x '.' e) : (_TVAR k) '->' t -| constraints ; k_2
  -- Infer_expr: $update_type(tenv, x, _TVAR k) ; $(k + 1) |- e : t -| constraints ; k_2

rule Infer_expr/app:
  tenv ; k |- (e_1 e_2) : (_TVAR k_2) -| constraints ; $(k_2 + 1)
  -- Infer_expr: tenv ; k |- e_1 : t_1 -| constraints_1 ; k_1
  -- Infer_expr: tenv ; k_1 |- e_2 : t_2 -| constraints_2 ; k_2
  -- if constraints = constraints_1 ++ constraints_2 ++ [(t_1 '=' (t_2 '->' (_TVAR k_2)))]

rule Infer_expr/add:
  tenv ; k |- e_1 '+' e_2 : NUM -| constraints ; k_2
  -- Infer_expr: tenv ; k |- e_1 : t_1 -| constraints_1 ; k_1
  -- Infer_expr: tenv ; k_1 |- e_2 : t_2 -| constraints_2 ; k_2
  -- if constraints = constraints_1 ++ constraints_2 ++ [(t_1 '=' NUM)] ++ [(t_2 '=' NUM)]

rule Infer_expr/sub:
  tenv ; k |- e_1 '-' e_2 : NUM -| constraints ; k_2
  -- Infer_expr: tenv ; k |- e_1 : t_1 -| constraints_1 ; k_1
  -- Infer_expr: tenv ; k_1 |- e_2 : t_2 -| constraints_2 ; k_2
  -- if constraints = constraints_1 ++ constraints_2 ++ [(t_1 '=' NUM)] ++ [(t_2 '=' NUM)]

relation Unify:
  subst ; type '=' type ==> subst
  hint(input %0 %1 %2)

relation Unify_types:
  subst ; type '=' type ==> subst
  hint(input %0 %1 %2)

rule Unify:
  subst ; t_1 '=' t_2 ==> subst_1
  -- Unify_types: subst ; $resolve(subst, t_1) '=' $resolve(subst, t_2) ==> subst_1

rule Unify_types/same:
  subst ; t '=' t ==> subst

rule Unify_types/left:
  subst ; (_TVAR k) '=' t ==> (k -> t)::subst
  -- if (_TVAR k) =/= t
  -- if ~$occurs(k, t)

rule Unify_types/right:
  subst ; t '=' (_TVAR k) ==> (k -> t)::subst
  -- if ~$is_type_var(t)
  -- if ~$occurs(k, t)

rule Unify_types/arrow:
  subst ; (t_1 '->' t_2) '=' (t_3 '->' t_4) ==> subst_2
  -- Unify: subst ; t_1 '=' t_3 ==> subst_1
  -- Unify: subst_1 ; t_2 '=' t_4 ==> subst_2

relation Solve:
  subst ; constraints ==> subst
  hint(input %0 %1)

rule Solve/empty:
  subst ; eps ==> subst

rule Solve/constraint:
  subst ; ((t_1 '=' t_2)::constraints) ==> subst_2
  -- Unify: subst ; t_1 '=' t_2 ==> subst_1
  -- Solve: subst_1 ; constraints ==> subst_2

relation Check_prog:
  expr : type
  hint(input %0)

rule Check_prog:
  e : $resolve(subst, t)
  -- Infer_expr: eps ; 0 |- e : t -| constraints ; k
  -- Solve: eps ; constraints ==> subst

relation Eval_expr:
  env |- expr ==> value
  hint(input %0 %1)

rule Eval_expr/num:
  env |- (_NUM n) ==> (_NUM n)

rule Eval_expr/add:
  env |- e_1 '+' e_2 ==> (_NUM $(n_1 + n_2))
  -- Eval_expr: env |- e_1 ==> (_NUM n_1)
  -- Eval_expr: env |- e_2 ==> (_NUM n_2)

rule Eval_expr/sub:
  env |- e_1 '-' e_2 ==> (_NUM $(n_1 - n_2))
  -- Eval_expr: env |- e_1 ==> (_NUM n_1)
  -- Eval_expr: env |- e_2 ==> (_NUM n_2)

rule Eval_expr/id:
  env |- x ==> $lookup(env, x)
  -- if x <- $domain(env)

rule Eval_expr/fun:
  env |- (LAMBDA x '.' e) ==> (`< LAMBDA x '.' e ',' env `>)

rule Eval_expr/app:
  env |- (e_1 e_2) ==> v
  -- Eval_expr: env |- e_1 ==> (`< LAMBDA x '.' e_body ',' env_clo `>)
  -- Eval_expr: env |- e_2 ==> v_arg
  -- Eval_expr: $update(env_clo, x, v_arg) |- e_body ==> v

relation Eval_prog:
  expr ==> value
  hint(input %0)

rule Eval_prog:
  e ==> v
  -- Eval_expr: eps |- e ==> v

relation Run_prog:
  expr ==> value
  hint(input %0)

rule Run_prog:
  e ==> v
  -- Check_prog: e : t
  -- Eval_prog: e ==> v

def $lookup((x_1 -> v)::env, x) = v
  -- if x = x_1
def $lookup((x_1 -> v)::env, x) = $lookup(env, x)
  -- otherwise

def $domain(eps) = eps
def $domain((x -> v)::env) = x::$domain(env)

def $update(eps, x, v) = (x -> v)::eps
def $update((x_1 -> v_1)::env, x, v) = (x -> v)::env
  -- if x = x_1
def $update((x_1 -> v_1)::env, x, v) = (x_1 -> v_1)::$update(env, x, v)
  -- otherwise

def $lookup_type((x_1 ':' t)::tenv, x) = t
  -- if x = x_1
def $lookup_type((x_1 ':' t)::tenv, x) = $lookup_type(tenv, x)
  -- otherwise

def $domain_type(eps) = eps
def $domain_type((x ':' t)::tenv) = x::$domain_type(tenv)

def $update_type(eps, x, t) = (x ':' t)::eps
def $update_type((x_1 ':' t_1)::tenv, x, t) = (x ':' t)::tenv
  -- if x = x_1
def $update_type((x_1 ':' t_1)::tenv, x, t) = (x_1 ':' t_1)::$update_type(tenv, x, t)
  -- otherwise

def $lookup_subst(eps, k) = eps
def $lookup_subst((k_1 -> t)::subst, k) = t
  -- if k = k_1
def $lookup_subst((k_1 -> t)::subst, k) = $lookup_subst(subst, k)
  -- otherwise

def $resolve(subst, NUM) = NUM
def $resolve(subst, t_1 '->' t_2) = $resolve(subst, t_1) '->' $resolve(subst, t_2)
def $resolve(subst, _TVAR k) = $resolve(subst, t)
  -- if $lookup_subst(subst, k) = t
def $resolve(subst, _TVAR k) = _TVAR k
  -- otherwise

def $occurs(k, NUM) = false
def $occurs(k, _TVAR k_1) = (k = k_1)
def $occurs(k, t_1 '->' t_2) = $occurs(k, t_1) \/ $occurs(k, t_2)

def $is_type_var(_TVAR k) = true
def $is_type_var(t) = false
  -- otherwise
