syntax id = _ID text
syntax literal = _NUM int
syntax tid = _TID text

syntax type = NUM | type '->' type | tid

syntax expr =
  | literal
  | expr '+' expr
  | expr '-' expr
  | VAL id '=' expr IN expr
  | id
  | LAMBDA id ':' type '.' expr
  | expr expr
  | TYPE tid '=' id '@' type '+' id '@' type IN expr
  | expr MATCH id `( id `) '->' expr ',' id `( id `) '->' expr

syntax value, binding, env

syntax value =
  | literal
  | `< LAMBDA id '.' expr ',' env `>
  | `< id `>
  | id `( value `)

syntax binding = id -> value
syntax env = binding*

var x : id
var c : id
var a : tid
var e : expr
var n : int
var v : value

syntax variants = id '@' type '+' id '@' type
syntax typebinding = id ':' type | TYPE tid '=' variants
syntax tenv = typebinding*

var t : type

dec $variant_type(variants, id) : type?

;; Lookup is defined only for identifiers in $domain(env).
dec $lookup(env, id) : value
dec $domain(env) : id*
dec $update(env, id, value) : env

dec $lookup_type(tenv, id) : type
dec $domain_type(tenv) : id*
dec $update_type(tenv, id, type) : tenv

dec $lookup_def(tenv, tid) : variants
dec $domain_def(tenv) : tid*
dec $update_def(tenv, tid, variants) : tenv

relation Wf_type:
  tenv |- type
  hint(input %0 %1)

rule Wf_type/num:
  tenv |- NUM

rule Wf_type/arrow:
  tenv |- t_1 '->' t_2
  -- Wf_type: tenv |- t_1
  -- Wf_type: tenv |- t_2

rule Wf_type/id:
  tenv |- a
  -- if a <- $domain_def(tenv)

relation Check_expr:
  tenv |- expr : type
  hint(input %0 %1)

rule Check_expr/num:
  tenv |- (_NUM n) : NUM

rule Check_expr/add:
  tenv |- e_1 '+' e_2 : NUM
  -- Check_expr: tenv |- e_1 : NUM
  -- Check_expr: tenv |- e_2 : NUM

rule Check_expr/sub:
  tenv |- e_1 '-' e_2 : NUM
  -- Check_expr: tenv |- e_1 : NUM
  -- Check_expr: tenv |- e_2 : NUM

rule Check_expr/val:
  tenv |- (VAL x '=' e_1 IN e_2) : t_2
  -- Check_expr: tenv |- e_1 : t_1
  -- Check_expr: $update_type(tenv, x, t_1) |- e_2 : t_2

rule Check_expr/id:
  tenv |- x : $lookup_type(tenv, x)
  -- if x <- $domain_type(tenv)

rule Check_expr/fun:
  tenv |- (LAMBDA x ':' t_1 '.' e) : t_1 '->' t_2
  -- Wf_type: tenv |- t_1
  -- Check_expr: $update_type(tenv, x, t_1) |- e : t_2

rule Check_expr/app:
  tenv |- (e_1 e_2) : t_2
  -- Check_expr: tenv |- e_1 : t_1 '->' t_2
  -- Check_expr: tenv |- e_2 : t_1

rule Check_expr/type:
  tenv |- (TYPE a '=' c_1 '@' t_1 '+' c_2 '@' t_2 IN e) : t
  -- if tenv_1 = $update_type($update_type($update_def(tenv, a, c_1 '@' t_1 '+' c_2 '@' t_2), c_1, t_1 '->' a), c_2, t_2 '->' a)
  -- Wf_type: tenv_1 |- t_1
  -- Wf_type: tenv_1 |- t_2
  -- Check_expr: tenv_1 |- e : t

rule Check_expr/match:
  tenv |- (e MATCH c_1 `( x_1 `) '->' e_1 ',' c_2 `( x_2 `) '->' e_2) : t
  -- Check_expr: tenv |- e : a
  -- if a <- $domain_def(tenv)
  -- if $lookup_def(tenv, a) = variants
  -- if $variant_type(variants, c_1) = t_1
  -- if $variant_type(variants, c_2) = t_2
  -- Check_expr: $update_type(tenv, x_1, t_1) |- e_1 : t
  -- Check_expr: $update_type(tenv, x_2, t_2) |- e_2 : t

relation Check_prog:
  expr : type
  hint(input %0)

rule Check_prog:
  e : t
  -- Check_expr: eps |- e : t

relation Eval_expr:
  env |- expr ==> value
  hint(input %0 %1)

rule Eval_expr/num:
  env |- (_NUM n) ==> (_NUM n)

rule Eval_expr/add:
  env |- e_1 '+' e_2 ==> (_NUM $(n_1 + n_2))
  -- Eval_expr: env |- e_1 ==> (_NUM n_1)
  -- Eval_expr: env |- e_2 ==> (_NUM n_2)

rule Eval_expr/sub:
  env |- e_1 '-' e_2 ==> (_NUM $(n_1 - n_2))
  -- Eval_expr: env |- e_1 ==> (_NUM n_1)
  -- Eval_expr: env |- e_2 ==> (_NUM n_2)

rule Eval_expr/val:
  env |- (VAL x '=' e_1 IN e_2) ==> v_2
  -- Eval_expr: env |- e_1 ==> v_1
  -- Eval_expr: $update(env, x, v_1) |- e_2 ==> v_2

rule Eval_expr/id:
  env |- x ==> $lookup(env, x)
  -- if x <- $domain(env)

rule Eval_expr/fun:
  env |- (LAMBDA x ':' t '.' e) ==> (`< LAMBDA x '.' e ',' env `>)

rule Eval_expr/app:
  env |- (e_1 e_2) ==> v
  -- Eval_expr: env |- e_1 ==> (`< LAMBDA x '.' e_body ',' env_clo `>)
  -- Eval_expr: env |- e_2 ==> v_arg
  -- Eval_expr: $update(env_clo, x, v_arg) |- e_body ==> v

rule Eval_expr/type:
  env |- (TYPE a '=' c_1 '@' t_1 '+' c_2 '@' t_2 IN e) ==> v
  -- Eval_expr: $update($update(env, c_1, `< c_1 `>), c_2, `< c_2 `>) |- e ==> v

rule Eval_expr/app-cnstr:
  env |- (e_1 e_2) ==> (c `( v `))
  -- Eval_expr: env |- e_1 ==> (`< c `>)
  -- Eval_expr: env |- e_2 ==> v

rule Eval_expr/match-l:
  env |- (e MATCH c_1 `( x_1 `) '->' e_1 ',' c_2 `( x_2 `) '->' e_2) ==> v
  -- Eval_expr: env |- e ==> (c_1 `( v_0 `))
  -- Eval_expr: $update(env, x_1, v_0) |- e_1 ==> v

rule Eval_expr/match-r:
  env |- (e MATCH c_1 `( x_1 `) '->' e_1 ',' c_2 `( x_2 `) '->' e_2) ==> v
  -- if c_1 =/= c_2
  -- Eval_expr: env |- e ==> (c_2 `( v_0 `))
  -- Eval_expr: $update(env, x_2, v_0) |- e_2 ==> v

relation Eval_prog:
  expr ==> value
  hint(input %0)

rule Eval_prog:
  e ==> v
  -- Eval_expr: eps |- e ==> v

relation Run_prog:
  expr ==> value
  hint(input %0)

rule Run_prog:
  e ==> v
  -- Check_prog: e : t
  -- Eval_prog: e ==> v

def $lookup((x_1 -> v)::env, x) = v
  -- if x = x_1
def $lookup((x_1 -> v)::env, x) = $lookup(env, x)
  -- otherwise

def $domain(eps) = eps
def $domain((x -> v)::env) = x::$domain(env)

def $update(eps, x, v) = (x -> v)::eps
def $update((x_1 -> v_1)::env, x, v) = (x -> v)::env
  -- if x = x_1
def $update((x_1 -> v_1)::env, x, v) = (x_1 -> v_1)::$update(env, x, v)
  -- otherwise

def $lookup_type((x_1 ':' t)::tenv, x) = t
  -- if x = x_1
def $lookup_type((x_1 ':' t)::tenv, x) = $lookup_type(tenv, x)
  -- otherwise

def $domain_type(eps) = eps
def $domain_type((x ':' t)::tenv) = x::$domain_type(tenv)

def $update_type(eps, x, t) = (x ':' t)::eps
def $update_type((x_1 ':' t_1)::tenv, x, t) = (x ':' t)::tenv
  -- if x = x_1
def $update_type((x_1 ':' t_1)::tenv, x, t) = (x_1 ':' t_1)::$update_type(tenv, x, t)
  -- otherwise

def $lookup_type((TYPE a '=' variants)::tenv, x) = $lookup_type(tenv, x)
def $domain_type((TYPE a '=' variants)::tenv) = $domain_type(tenv)
def $update_type((TYPE a '=' variants)::tenv, x, t) = (TYPE a '=' variants)::$update_type(tenv, x, t)

def $lookup_def((x ':' t)::tenv, a) = $lookup_def(tenv, a)
def $lookup_def((TYPE a_1 '=' variants)::tenv, a) = variants
  -- if a = a_1
def $lookup_def((TYPE a_1 '=' variants)::tenv, a) = $lookup_def(tenv, a)
  -- otherwise

def $domain_def(eps) = eps
def $domain_def((x ':' t)::tenv) = $domain_def(tenv)
def $domain_def((TYPE a '=' variants)::tenv) = a::$domain_def(tenv)

def $update_def(eps, a, variants) = (TYPE a '=' variants)::eps
def $update_def((x ':' t)::tenv, a, variants) = (x ':' t)::$update_def(tenv, a, variants)
def $update_def((TYPE a_1 '=' variants_1)::tenv, a, variants) = (TYPE a '=' variants)::tenv
  -- if a = a_1
def $update_def((TYPE a_1 '=' variants_1)::tenv, a, variants) = (TYPE a_1 '=' variants_1)::$update_def(tenv, a, variants)
  -- otherwise

def $variant_type(c_1 '@' t_1 '+' c_2 '@' t_2, c) = t_1
  -- if c = c_1
  -- if c =/= c_2
def $variant_type(c_1 '@' t_1 '+' c_2 '@' t_2, c) = t_2
  -- if c = c_2
def $variant_type(c_1 '@' t_1 '+' c_2 '@' t_2, c) = eps
  -- otherwise
