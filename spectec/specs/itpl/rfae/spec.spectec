syntax id = _ID text
syntax literal = _NUM int

syntax expr =
  | literal
  | expr '+' expr
  | expr '-' expr
  | id
  | LAMBDA id '.' expr
  | expr expr
  | IF0 expr expr expr
  | DEF id `( id `) '=' expr IN expr

syntax value, recdef, binding, env

syntax value =
  | literal
  | `< LAMBDA id '.' expr ',' env `>

syntax recdef = `< LAMBDA id '.' expr ',' env `>

syntax binding =
  | id -> value
  | id -> RECDEF recdef
syntax env = binding*

var x : id
var f : id
var e : expr
var n : int
var v : value
var b : binding
var d : recdef

;; Lookup is defined only for identifiers in $domain(env).
dec $lookup(env, id) : value
dec $domain(env) : id*
dec $update(env, id, value) : env
;; Recursive bindings capture env before installing themselves so values remain finite.
dec $bind_recursive(env, id, id, expr) : env
dec $update_binding(env, binding) : env
dec $binding_name(binding) : id

relation Eval_expr:
  env |- expr ==> value
  hint(input %0 %1)

rule Eval_expr/num:
  env |- (_NUM n) ==> (_NUM n)

rule Eval_expr/add:
  env |- e_1 '+' e_2 ==> (_NUM $(n_1 + n_2))
  -- Eval_expr: env |- e_1 ==> (_NUM n_1)
  -- Eval_expr: env |- e_2 ==> (_NUM n_2)

rule Eval_expr/sub:
  env |- e_1 '-' e_2 ==> (_NUM $(n_1 - n_2))
  -- Eval_expr: env |- e_1 ==> (_NUM n_1)
  -- Eval_expr: env |- e_2 ==> (_NUM n_2)

rule Eval_expr/id:
  env |- x ==> $lookup(env, x)
  -- if x <- $domain(env)

rule Eval_expr/fun:
  env |- (LAMBDA x '.' e) ==> (`< LAMBDA x '.' e ',' env `>)

rule Eval_expr/app:
  env |- (e_1 e_2) ==> v
  -- Eval_expr: env |- e_1 ==> (`< LAMBDA x '.' e_body ',' env_clo `>)
  -- Eval_expr: env |- e_2 ==> v_arg
  -- Eval_expr: $update(env_clo, x, v_arg) |- e_body ==> v

rule Eval_expr/if0-z:
  env |- (IF0 e_1 e_2 e_3) ==> v
  -- Eval_expr: env |- e_1 ==> (_NUM 0)
  -- Eval_expr: env |- e_2 ==> v

rule Eval_expr/if0-nz:
  env |- (IF0 e_1 e_2 e_3) ==> v
  -- Eval_expr: env |- e_1 ==> v_cond
  -- if v_cond =/= (_NUM 0)
  -- Eval_expr: env |- e_3 ==> v

rule Eval_expr/rec:
  env |- (DEF f `( x `) '=' e_1 IN e_2) ==> v
  -- if env_rec = $bind_recursive(env, f, x, e_1)
  -- Eval_expr: env_rec |- e_2 ==> v

relation Eval_prog:
  expr ==> value
  hint(input %0)

rule Eval_prog:
  e ==> v
  -- Eval_expr: eps |- e ==> v

def $lookup((x_1 -> v)::env, x) = v
  -- if x = x_1
def $lookup((x_1 -> v)::env, x) = $lookup(env, x)
  -- if x =/= x_1
def $lookup((f -> RECDEF `< LAMBDA x '.' e ',' env_def `>)::env, f_1) =
  (`< LAMBDA x '.' e ',' $bind_recursive(env_def, f, x, e) `>)
  -- if f_1 = f
def $lookup((f -> RECDEF `< LAMBDA x '.' e ',' env_def `>)::env, f_1) = $lookup(env, f_1)
  -- if f_1 =/= f

def $domain(eps) = eps
def $domain(b::env) = $binding_name(b)::$domain(env)

def $update(env, x, v) = $update_binding(env, x -> v)

def $bind_recursive(env, f, x, e) =
  $update_binding(env, f -> RECDEF `< LAMBDA x '.' e ',' env `>)

def $update_binding(eps, b) = b::eps
def $update_binding(b_1::env, b) = b::env
  -- if $binding_name(b) = $binding_name(b_1)
def $update_binding(b_1::env, b) = b_1::$update_binding(env, b)
  -- otherwise

def $binding_name(x -> v) = x
def $binding_name(f -> RECDEF d) = f
