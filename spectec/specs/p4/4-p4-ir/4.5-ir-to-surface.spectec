;;;; Parenthesized expressions
;;

;;; parenthesizedExpressionIR

dec $lift_parenthesizedExpressionIR(parenthesizedExpressionIR)
  : parenthesizedExpression?
  hint(testgen_ignore)

def $lift_parenthesizedExpressionIR(`( typedExpressionIR `))
  = `( expression `)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

;;
;;;; Expressions
;;

;;; expressionIR

dec $lift_expressionIR(expressionIR) : expression?
  hint(testgen_ignore)

def $lift_expressionIR(literalExpressionIR)
  = $lift_literalExpressionIR(literalExpressionIR)
def $lift_expressionIR(referenceExpressionIR)
  = $lift_referenceExpressionIR(referenceExpressionIR)
def $lift_expressionIR(defaultExpressionIR)
  = $lift_defaultExpressionIR(defaultExpressionIR)
def $lift_expressionIR(unaryExpressionIR)
  = $lift_unaryExpressionIR(unaryExpressionIR)
def $lift_expressionIR(binaryExpressionIR)
  = $lift_binaryExpressionIR(binaryExpressionIR)
def $lift_expressionIR(ternaryExpressionIR)
  = $lift_ternaryExpressionIR(ternaryExpressionIR)
def $lift_expressionIR(castExpressionIR)
  = $lift_castExpressionIR(castExpressionIR)
def $lift_expressionIR(dataExpressionIR)
  = $lift_dataExpressionIR(dataExpressionIR)
def $lift_expressionIR(accessExpressionIR)
  = $lift_accessExpressionIR(accessExpressionIR)
def $lift_expressionIR(callExpressionIR)
  = $lift_callExpressionIR(callExpressionIR)
def $lift_expressionIR(parenthesizedExpressionIR)
  = $lift_parenthesizedExpressionIR(parenthesizedExpressionIR)

;;; typedExpressionIR

def $lift_typedExpressionIR(expressionIR '#' _)
  = $lift_expressionIR(expressionIR)

;;; typedExpressionListIR

dec $unflatten_expressionList(expression*) : expressionList
  hint(testgen_ignore)
dec $unflatten_expressionList'(expressionList, expression*) : expressionList
  hint(testgen_ignore)

def $unflatten_expressionList(eps) = _EMPTY
def $unflatten_expressionList(expression_h :: expression_t*)
  = $unflatten_expressionList'(expression_h, expression_t*)
def $unflatten_expressionList'(expressionList, eps) = expressionList
def $unflatten_expressionList'(expressionList, expression_h :: expression_t*)
  = $unflatten_expressionList'(
      expressionList ',' expression_h, expression_t*)

def $lift_typedExpressionListIR(typedExpressionIR*)
  = expressionList
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))*
  -- if expressionList
      = $unflatten_expressionList(expression*)

;;
;; Keyset expressions
;;

;;; simpleKeysetExpressionIR

dec $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR)
  : simpleKeysetExpression?
  hint(testgen_ignore)

def $lift_simpleKeysetExpressionIR(typedExpressionIR)
  = expression
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_simpleKeysetExpressionIR(
    typedExpressionIR_base '&&&' typedExpressionIR_mask)
  = expression_base '&&&' expression_mask
  -- if expression_base = $lift_typedExpressionIR(typedExpressionIR_base)
  -- if expression_mask = $lift_typedExpressionIR(typedExpressionIR_mask)

def $lift_simpleKeysetExpressionIR(
    typedExpressionIR_lb '..' typedExpressionIR_ub)
  = expression_lb '..' expression_ub
  -- if expression_lb = $lift_typedExpressionIR(typedExpressionIR_lb)
  -- if expression_ub = $lift_typedExpressionIR(typedExpressionIR_ub)

def $lift_simpleKeysetExpressionIR(DEFAULT) = DEFAULT

def $lift_simpleKeysetExpressionIR('_') = '_'

;;; simpleKeysetExpressionListIR

dec $lift_simpleKeysetExpressionListIR(simpleKeysetExpressionIR*)
  : simpleKeysetExpressionList?
  hint(testgen_ignore)

dec $unflatten_simpleKeysetExpressionList(simpleKeysetExpression*)
  : simpleKeysetExpressionList
  hint(testgen_ignore)
dec $unflatten_simpleKeysetExpressionList'(
    simpleKeysetExpressionList, simpleKeysetExpression*)
  : simpleKeysetExpressionList
  hint(testgen_ignore)

def $unflatten_simpleKeysetExpressionList(simpleKeysetExpression*)
  = $unflatten_simpleKeysetExpressionList'(
      simpleKeysetExpression_h, simpleKeysetExpression_t*)
  -- if simpleKeysetExpression_h :: simpleKeysetExpression_t*
      = simpleKeysetExpression*
def $unflatten_simpleKeysetExpressionList'(simpleKeysetExpressionList, eps)
  = simpleKeysetExpressionList
def $unflatten_simpleKeysetExpressionList'(
    simpleKeysetExpressionList, simpleKeysetExpression_h :: simpleKeysetExpression_t*)
  = $unflatten_simpleKeysetExpressionList'(
      simpleKeysetExpressionList ',' simpleKeysetExpression_h,
      simpleKeysetExpression_t*)

def $lift_simpleKeysetExpressionListIR(simpleKeysetExpressionIR*)
  = simpleKeysetExpressionList
  -- if (simpleKeysetExpression
      = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR))*
  -- if simpleKeysetExpressionList
      = $unflatten_simpleKeysetExpressionList(simpleKeysetExpression*)

;;; tupleKeysetExpressionIR

dec $lift_tupleKeysetExpressionIR(tupleKeysetExpressionIR)
  : tupleKeysetExpression?
  hint(testgen_ignore)

def $lift_tupleKeysetExpressionIR(
    `( (typedExpressionIR_base '&&&' typedExpressionIR_mask) `))
  = `( expression_base '&&&' expression_mask `)
  -- if expression_base = $lift_typedExpressionIR(typedExpressionIR_base)
  -- if expression_mask = $lift_typedExpressionIR(typedExpressionIR_mask)

def $lift_tupleKeysetExpressionIR(
    `( (typedExpressionIR_lb '..' typedExpressionIR_ub) `))
  = `( expression_lb '..' expression_ub `)
  -- if expression_lb = $lift_typedExpressionIR(typedExpressionIR_lb)
  -- if expression_ub = $lift_typedExpressionIR(typedExpressionIR_ub)

def $lift_tupleKeysetExpressionIR(`( DEFAULT `))
  = `( DEFAULT `)

def $lift_tupleKeysetExpressionIR(`( '_' `))
  = `( '_' `)

def $lift_tupleKeysetExpressionIR(`( simpleKeysetExpressionIR* `))
  = `( simpleKeysetExpression_h ',' simpleKeysetExpressionList_t `)
  -- if $(|simpleKeysetExpressionIR*| > 1)
  -- if simpleKeysetExpressionIR_h :: simpleKeysetExpressionIR_t*
      = simpleKeysetExpressionIR*
  -- if simpleKeysetExpression_h
      = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR_h)
  -- if simpleKeysetExpressionList_t
      = $lift_simpleKeysetExpressionListIR(simpleKeysetExpressionIR_t*)

;;; keysetExpressionIR

dec $lift_keysetExpressionIR(keysetExpressionIR) : keysetExpression?
  hint(testgen_ignore)

def $lift_keysetExpressionIR(simpleKeysetExpressionIR)
  = $lift_simpleKeysetExpressionIR(simpleKeysetExpressionIR)
def $lift_keysetExpressionIR(tupleKeysetExpressionIR)
  = $lift_tupleKeysetExpressionIR(tupleKeysetExpressionIR)

