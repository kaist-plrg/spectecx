dec $lift_constantDeclarationIR(constantDeclarationIR)
  : constantDeclaration?
  hint(testgen_ignore)
dec $lift_variableDeclarationIR(variableDeclarationIR)
  : variableDeclaration?
  hint(testgen_ignore)

dec $lift_blockElementStatementIR(blockElementStatementIR)
