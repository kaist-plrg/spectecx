;;;; Switch statements
;;

;;; switchLabelIR

dec $lift_switchLabelIR(switchLabelIR) : switchLabel?
  hint(testgen_ignore)

def $lift_switchLabelIR(DEFAULT) = DEFAULT

def $lift_switchLabelIR(typedExpressionIR)
  = expressionNonBrace
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)
  -- if expressionNonBrace
      = $expression_as_expressionNonBrace(expression)

;;; switchCaseIR

dec $lift_switchCaseIR(switchCaseIR) : switchCase?
  hint(testgen_ignore)

def $lift_switchCaseIR(switchLabelIR ':' blockStatementIR)
  = switchLabel ':' blockStatement
  -- if switchLabel = $lift_switchLabelIR(switchLabelIR)
  -- if blockStatement = $lift_blockStatementIR(blockStatementIR)

def $lift_switchCaseIR(switchLabelIR ':')
  = switchLabel ':'
  -- if switchLabel = $lift_switchLabelIR(switchLabelIR)

;;; switchCaseListIR

dec $lift_switchCaseListIR(switchCaseIR*) : switchCaseList?
  hint(testgen_ignore)

dec $unflatten_switchCaseList(switchCase*) : switchCaseList
  hint(testgen_ignore)
dec $unflatten_switchCaseList'(switchCaseList, switchCase*)
  : switchCaseList
  hint(testgen_ignore)

def $unflatten_switchCaseList(switchCase*)
  = $unflatten_switchCaseList'(_EMPTY, switchCase*)
def $unflatten_switchCaseList'(switchCaseList, eps)
  = switchCaseList
def $unflatten_switchCaseList'(
    switchCaseList, switchCase_h :: switchCase_t*)
  = $unflatten_switchCaseList'(
      switchCaseList switchCase_h, switchCase_t*)

def $lift_switchCaseListIR(switchCaseIR*)
  = switchCaseList
  -- if (switchCase = $lift_switchCaseIR(switchCaseIR))*
  -- if switchCaseList
      = $unflatten_switchCaseList(switchCase*)

;;; switchStatementIR

dec $lift_switchStatementIR(switchStatementIR) : switchStatement?
  hint(testgen_ignore)

def $lift_switchStatementIR(
    SWITCH `( typedExpressionIR `) `{ switchCaseIR* `})
  = SWITCH `( expression `) `{ switchCaseList `}
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)
  -- if switchCaseList
      = $lift_switchCaseListIR(switchCaseIR*)

;;
;;;; Break and continue statements
;;

;;; breakStatementIR
;;; continueStatementIR

dec $lift_breakStatementIR(breakStatementIR) : breakStatement?
  hint(testgen_ignore)
dec $lift_continueStatementIR(continueStatementIR) : continueStatement?
  hint(testgen_ignore)

def $lift_breakStatementIR(BREAK ';') = BREAK ';'
def $lift_continueStatementIR(CONTINUE ';') = CONTINUE ';'

;;
;;;; Statements
;;

def $lift_statementIR(emptyStatementIR)
  = $lift_emptyStatementIR(emptyStatementIR)
def $lift_statementIR(assignmentStatementIR)
  = $lift_assignmentStatementIR(assignmentStatementIR)
def $lift_statementIR(callStatementIR)
  = $lift_callStatementIR(callStatementIR)
def $lift_statementIR(directApplicationStatementIR)
  = $lift_directApplicationStatementIR(directApplicationStatementIR)
def $lift_statementIR(returnStatementIR)
  = $lift_returnStatementIR(returnStatementIR)
def $lift_statementIR(exitStatementIR)
  = $lift_exitStatementIR(exitStatementIR)
def $lift_statementIR(blockStatementIR)
  = $lift_blockStatementIR(blockStatementIR)
def $lift_statementIR(conditionalStatementIR)
  = $lift_conditionalStatementIR(conditionalStatementIR)
def $lift_statementIR(switchStatementIR)
  = $lift_switchStatementIR(switchStatementIR)
def $lift_statementIR(statementIR) = eps
  -- debug statementIR
  -- otherwise

;;
;; L-values
;;

def $lift_typedLvalueIR((_BARE "this") '#' _) = THIS
def $lift_typedLvalueIR((_BARE nameIR) '#' _) = nonTypeName
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
def $lift_typedLvalueIR(('.' nameIR) '#' _) = _ID '.' nonTypeName
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_typedLvalueIR((typedLvalueIR '.' nameIR) '#' _)
  = lvalue '.' member
  -- if lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- if member = $lift_nameIR_as_member(nameIR)

def $lift_typedLvalueIR(
    (typedLvalueIR `[ typedExpressionIR `]) '#' _)
  = lvalue `[ expression `]
  -- if lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_typedLvalueIR(
    (typedLvalueIR `[ typedExpressionIR_hi ':' typedExpressionIR_lo `]) '#' _)
  = lvalue `[ expression_hi ':' expression_lo `]
  -- if lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- if expression_hi = $lift_typedExpressionIR(typedExpressionIR_hi)
  -- if expression_lo = $lift_typedExpressionIR(typedExpressionIR_lo)

def $lift_typedLvalueIR((`( typedLvalueIR `)) '#' _)
  = `( lvalue `)
  -- if lvalue = $lift_typedLvalueIR(typedLvalueIR)

;;
;;;; Callable targets
;;

;;; callableTargetIR

def $lift_callableTargetIR_as_expression(_BARE "this") = THIS
def $lift_callableTargetIR_as_expression(_BARE nameIR) = nonTypeName
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
def $lift_callableTargetIR_as_expression('.' nameIR) = _ID '.' nonTypeName
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_callableTargetIR_as_expression(typedExpressionIR '.' nameIR)
  = expression '.' member
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)
  -- if member = $lift_nameIR_as_member(nameIR)

def $lift_callableTargetIR_as_expression(TYPE (_BARE "this") '.' nameIR)
  = THIS '.' member
  -- if member = $lift_nameIR_as_member(nameIR)
def $lift_callableTargetIR_as_expression(TYPE (_BARE nameIR) '.' nameIR_field)
  = nonTypeName '.' member
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if member = $lift_nameIR_as_member(nameIR_field)
def $lift_callableTargetIR_as_expression(TYPE ('.' nameIR) '.' nameIR_field)
  = (_ID '.' nonTypeName) '.' member
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if member = $lift_nameIR_as_member(nameIR_field)

def $lift_callableTargetIR_as_expression(`( callableTargetIR `))
  = `( expression `)
  -- if expression = $lift_callableTargetIR_as_expression(callableTargetIR)

;;; callableTargetIR

def $lift_callableTargetIR_as_lvalue(_BARE "this") = THIS
def $lift_callableTargetIR_as_lvalue(_BARE nameIR) = nonTypeName
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
def $lift_callableTargetIR_as_lvalue('.' nameIR) = _ID '.' nonTypeName
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_callableTargetIR_as_lvalue(typedExpressionIR '.' nameIR)
  = lvalue '.' member
  -- if typedLvalueIR
      = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR)
  -- if lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- if member = $lift_nameIR_as_member(nameIR)

def $lift_callableTargetIR_as_lvalue(TYPE (_BARE "this") '.' nameIR)
  = THIS '.' member
  -- if member = $lift_nameIR_as_member(nameIR)
def $lift_callableTargetIR_as_lvalue(TYPE (_BARE nameIR) '.' nameIR_field)
  = nonTypeName '.' member
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if member = $lift_nameIR_as_member(nameIR_field)
def $lift_callableTargetIR_as_lvalue(TYPE ('.' nameIR) '.' nameIR_field)
  = (_ID '.' nonTypeName) '.' member
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if member = $lift_nameIR_as_member(nameIR_field)

def $lift_callableTargetIR_as_lvalue(`( callableTargetIR `))
  = `( lvalue `)
  -- if lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR)

;;
;; Declaration
;;

;;
;;;; Constant and variable declarations
;;

;;; constantDeclarationIR

def $lift_constantDeclarationIR(constantDeclarationIR)
  = annotationList CONST type nonTypeName initializer ';'
  -- if annotationList CONST typeIR nameIR constantInitializerIR ';'
      = constantDeclarationIR
  -- if type = $lift_typeIR(typeIR)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if initializer
      = $lift_constantInitializerIR_as_initializer(constantInitializerIR)

;;; variableDeclarationIR

def $lift_variableDeclarationIR(
    annotationList typeIR nameIR initializerIR? ';')
  = annotationList type nonTypeName initializerOpt ';'
  -- if type = $lift_typeIR(typeIR)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if initializerOpt = $lift_initializerOptIR(initializerIR?)

;;
;;;; Function declarations
;;

;;; functionPrototypeIR

dec $lift_functionPrototypeIR(functionPrototypeIR) : functionPrototype?
  hint(testgen_ignore)

def $lift_functionPrototypeIR(
    typeIR nameIR
      `< typeParameterIR_expl* ',' typeParameterIR_impl* `>
      `( parameterIR* `))
  = typeOrVoid nonTypeName typeParameterListOpt `( parameterList `)
  -- if typeOrVoid = $lift_typeIR_as_typeOrVoid(typeIR)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if parameterList = $lift_parameterListIR(parameterIR*)

;;; functionDeclarationIR

dec $lift_functionDeclarationIR(functionDeclarationIR) : functionDeclaration?
  hint(testgen_ignore)

def $lift_functionDeclarationIR(
    annotationList functionPrototypeIR blockStatementIR)
  = annotationList functionPrototype blockStatement
  -- if functionPrototype
      = $lift_functionPrototypeIR(functionPrototypeIR)
  -- if blockStatement
      = $lift_blockStatementIR(blockStatementIR)

;;
;;;; Action declarations
;;

dec $lift_actionDeclarationIR(actionDeclarationIR) : actionDeclaration?
  hint(testgen_ignore)

def $lift_actionDeclarationIR(
    annotationList ACTION nameIR `( parameterIR* `) blockStatementIR)
  = annotationList ACTION nonTypeName `( parameterList `) blockStatement
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if parameterList = $lift_parameterListIR(parameterIR*)
  -- if blockStatement = $lift_blockStatementIR(blockStatementIR)

;;
;;;; Instantiations
;;

dec $lift_objectDeclarationIR(objectDeclarationIR) : objectDeclaration?
  hint(testgen_ignore)
dec $lift_objectDeclarationListIR(objectDeclarationIR*) : objectDeclarationList?
  hint(testgen_ignore)
dec $lift_instantiationIR(instantiationIR) : instantiation?
  hint(testgen_ignore)

;;; objectDeclarationIR

def $lift_objectDeclarationIR(functionDeclarationIR)
  = $lift_functionDeclarationIR(functionDeclarationIR)
def $lift_objectDeclarationIR(instantiationIR)
  = $lift_instantiationIR(instantiationIR)

;;; objectDeclarationListIR

dec $unflatten_objectDeclarationList(objectDeclaration*) : objectDeclarationList
  hint(testgen_ignore)
dec $unflatten_objectDeclarationList'(objectDeclarationList, objectDeclaration*)
  : objectDeclarationList
  hint(testgen_ignore)

def $unflatten_objectDeclarationList(objectDeclaration*)
  = $unflatten_objectDeclarationList'(
      _EMPTY, objectDeclaration*)
def $unflatten_objectDeclarationList'(objectDeclarationList, eps)
  = objectDeclarationList
def $unflatten_objectDeclarationList'(
    objectDeclarationList,
    objectDeclaration_h :: objectDeclaration_t*)
  = $unflatten_objectDeclarationList'(
      objectDeclarationList objectDeclaration_h, objectDeclaration_t*)

def $lift_objectDeclarationListIR(objectDeclarationIR*)
  = objectDeclarationList
  -- if (objectDeclaration
      = $lift_objectDeclarationIR(objectDeclarationIR))*
  -- if objectDeclarationList
      = $unflatten_objectDeclarationList(objectDeclaration*)

;;; instantiationIR

def $lift_instantiationIR(
    annotationList typeIR constructorTargetIR
      `( argumentIR* `) nameIR eps ';')
  = annotationList type `( argumentList `) nonTypeName ';'
  -- if prefixedNameIR `< eps `> = constructorTargetIR
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if type = prefixedTypeName
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_instantiationIR(
    annotationList typeIR constructorTargetIR
      `( argumentIR* `) nameIR eps ';')
  = annotationList type `( argumentList `) nonTypeName ';'
  -- if prefixedNameIR `< typeArgumentIR* `> = constructorTargetIR
  -- if $(|typeArgumentIR*| > 0)
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*)
  -- if type = prefixedTypeName `< typeArgumentList `>
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_instantiationIR(
    annotationList typeIR constructorTargetIR
      `( argumentIR* `)
      nameIR ('=' `{ objectDeclarationIR* `}) ';')
  = annotationList type `( argumentList `)
      nonTypeName ('=' `{ objectDeclarationList `}) ';'
  -- if prefixedNameIR `< eps `> = constructorTargetIR
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if type = prefixedTypeName
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if objectDeclarationList
      = $lift_objectDeclarationListIR(objectDeclarationIR*)

def $lift_instantiationIR(
    annotationList typeIR constructorTargetIR
      `( argumentIR* `)
      nameIR ('=' `{ objectDeclarationIR* `}) ';')
  = annotationList type `( argumentList `)
      nonTypeName ('=' `{ objectDeclarationList `}) ';'
  -- if prefixedNameIR `< typeArgumentIR* `> = constructorTargetIR
  -- if $(|typeArgumentIR*| > 0)
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if typeArgumentIR* =/= eps
  -- if typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*)
  -- if type = prefixedTypeName `< typeArgumentList `>
  -- if argumentList = $lift_argumentListIR(argumentIR*)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if objectDeclarationList
      = $lift_objectDeclarationListIR(objectDeclarationIR*)

;;
;;;; Error declarations
;;

dec $lift_errorDeclarationIR(errorDeclarationIR) : errorDeclaration?
  hint(testgen_ignore)

def $lift_errorDeclarationIR(ERROR `{ nameIR* `})
  = ERROR `{ nameList `}
  -- if nameList
      = $lift_nameListIR_as_nonTypeNameList(nameIR*)

;;
;;;; Match kind declarations
;;

dec $lift_matchKindDeclarationIR(matchKindDeclarationIR)
  : matchKindDeclaration?
  hint(testgen_ignore)

def $lift_matchKindDeclarationIR(MATCH_KIND `{ nameIR* `})
  = MATCH_KIND `{ nameList _EMPTY `}
  -- if nameList
      = $lift_nameListIR_as_nonTypeNameList(nameIR*)

;;
;;;; Derived type declarations
;;

;;
;;;;;; Enum type declarations
;;

dec $lift_enumTypeDeclarationIR(enumTypeDeclarationIR)
  : enumTypeDeclaration?
  hint(testgen_ignore)

def $lift_enumTypeDeclarationIR(
    annotationList ENUM nameIR `{ nameIR_field* `})
  = annotationList ENUM typeName `{ nameList_field _EMPTY `}
  -- if typeName = $lift_nameIR_as_typeName(nameIR)
  -- if nameList_field
      = $lift_nameListIR_as_nonTypeNameList(nameIR_field*)

def $lift_enumTypeDeclarationIR(
    annotationList ENUM typeIR nameIR `{ namedValueListIR `})
  = annotationList ENUM type typeName `{ namedExpressionList _EMPTY `}
  -- if type = $lift_typeIR(typeIR)
  -- if typeName = $lift_nameIR_as_typeName(nameIR)
  -- if namedExpressionList
      = $lift_namedValueListIR(namedValueListIR)

;;
;;;;;; Struct, header, and union type declarations
;;

;;; typeFieldIR

dec $lift_typeFieldIR(typeFieldIR) : typeField?
  hint(testgen_ignore)

def $lift_typeFieldIR(annotationList typeIR nameIR ';')
  = annotationList type nonTypeName ';'
  -- if type = $lift_typeIR(typeIR)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

;;; typeFieldListIR

dec $lift_typeFieldListIR(typeFieldIR*) : typeFieldList?
  hint(testgen_ignore)

dec $unflatten_typeFieldList(typeField*) : typeFieldList
  hint(testgen_ignore)
dec $unflatten_typeFieldList'(typeFieldList, typeField*) : typeFieldList
  hint(testgen_ignore)

def $unflatten_typeFieldList(typeField*)
  = $unflatten_typeFieldList'(_EMPTY, typeField*)
def $unflatten_typeFieldList'(typeFieldList, eps) = typeFieldList
def $unflatten_typeFieldList'(typeFieldList, typeField_h :: typeField_t*)
  = $unflatten_typeFieldList'(typeFieldList typeField_h, typeField_t*)

def $lift_typeFieldListIR(typeFieldIR*)
  = typeFieldList
  -- if (typeField = $lift_typeFieldIR(typeFieldIR))*
  -- if typeFieldList = $unflatten_typeFieldList(typeField*)

;;; structTypeDeclarationIR

dec $lift_structTypeDeclarationIR(structTypeDeclarationIR)
  : structTypeDeclaration?
  hint(testgen_ignore)

def $lift_structTypeDeclarationIR(
    annotationList STRUCT nameIR
      `< typeParameterIR* `> `{ typeFieldIR* `})
  = annotationList STRUCT typeName typeParameterListOpt `{ typeFieldList `}
  -- if typeName = $lift_nameIR_as_typeName(nameIR)
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if typeFieldList = $lift_typeFieldListIR(typeFieldIR*)

;;; headerTypeDeclarationIR

dec $lift_headerTypeDeclarationIR(headerTypeDeclarationIR)
  : headerTypeDeclaration?
  hint(testgen_ignore)

def $lift_headerTypeDeclarationIR(
    annotationList HEADER nameIR
      `< typeParameterIR* `> `{ typeFieldIR* `})
  = annotationList HEADER typeName typeParameterListOpt `{ typeFieldList `}
  -- if typeName = $lift_nameIR_as_typeName(nameIR)
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if typeFieldList = $lift_typeFieldListIR(typeFieldIR*)

;;; headerUnionTypeDeclarationIR

dec $lift_headerUnionTypeDeclarationIR(headerUnionTypeDeclarationIR)
  : headerUnionTypeDeclaration?
  hint(testgen_ignore)

def $lift_headerUnionTypeDeclarationIR(
    annotationList HEADER_UNION nameIR
      `< typeParameterIR* `> `{ typeFieldIR* `})
  = annotationList HEADER_UNION typeName typeParameterListOpt `{ typeFieldList `}
  -- if typeName = $lift_nameIR_as_typeName(nameIR)
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if typeFieldList = $lift_typeFieldListIR(typeFieldIR*)

;;; derivedTypeDeclarationIR

dec $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR)
  : derivedTypeDeclaration?
  hint(testgen_ignore)

def $lift_derivedTypeDeclarationIR(enumTypeDeclarationIR)
  = $lift_enumTypeDeclarationIR(enumTypeDeclarationIR)
def $lift_derivedTypeDeclarationIR(structTypeDeclarationIR)
  = $lift_structTypeDeclarationIR(structTypeDeclarationIR)
def $lift_derivedTypeDeclarationIR(headerTypeDeclarationIR)
  = $lift_headerTypeDeclarationIR(headerTypeDeclarationIR)
def $lift_derivedTypeDeclarationIR(headerUnionTypeDeclarationIR)
  = $lift_headerUnionTypeDeclarationIR(headerUnionTypeDeclarationIR)

;;
;;;; Typedef and newtype declarations
;;

;;; typedefIR

dec $lift_typedefIR(typedefIR) : typedef?
  hint(testgen_ignore)

def $lift_typedefIR(typeIR) = $lift_typeIR(typeIR)
def $lift_typedefIR(derivedTypeDeclarationIR)
  = $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR)

;;; typedefDeclarationIR

dec $lift_typedefDeclarationIR(typedefDeclarationIR)
  : typedefDeclaration?
  hint(testgen_ignore)

def $lift_typedefDeclarationIR(
    annotationList TYPEDEF typeIR nameIR ';')
  = annotationList TYPEDEF type typeName ';'
  -- if type = $lift_typeIR(typeIR)
  -- if typeName = $lift_nameIR_as_typeName(nameIR)

def $lift_typedefDeclarationIR(
    annotationList TYPEDEF derivedTypeDeclarationIR nameIR ';')
  = annotationList TYPEDEF derivedTypeDeclaration typeName ';'
  -- if derivedTypeDeclaration
      = $lift_derivedTypeDeclarationIR(derivedTypeDeclarationIR)
  -- if typeName = $lift_nameIR_as_typeName(nameIR)

def $lift_typedefDeclarationIR(
    annotationList TYPE typeIR nameIR ';')
  = annotationList TYPE type typeName ';'
  -- if type = $lift_typeIR(typeIR)
  -- if typeName = $lift_nameIR_as_typeName(nameIR)

;;
;;;; Extern declarations
;;

;;; externFunctionDeclarationIR

dec $lift_externFunctionDeclarationIR(externFunctionDeclarationIR)
  : externFunctionDeclaration?
  hint(testgen_ignore)

def $lift_externFunctionDeclarationIR(
    annotationList EXTERN functionPrototypeIR ';')
  = annotationList EXTERN functionPrototype ';'
  -- if functionPrototype = $lift_functionPrototypeIR(functionPrototypeIR)

;;; externConstructorPrototypeIR

dec $lift_externConstructorPrototypeIR(externConstructorPrototypeIR)
  : externConstructorPrototype?
  hint(testgen_ignore)

;; (TODO) Handle implicit type parameter
def $lift_externConstructorPrototypeIR(
    annotationList nameIR `< ',' typeParameterIR_impl* `> `( parameterIR* `) ';')
  = annotationList typeIdentifier `( parameterList `) ';'
  -- if typeIdentifier = $lift_nameIR_as_typeIdentifier(nameIR)
  -- if parameterList = $lift_parameterListIR(parameterIR*)

;;; externMethodPrototypeIR

dec $lift_externMethodPrototypeIR(externMethodPrototypeIR)
  : externMethodPrototype?
  hint(testgen_ignore)

def $lift_externMethodPrototypeIR(
    annotationList functionPrototypeIR ';')
  = annotationList functionPrototype ';'
  -- if functionPrototype = $lift_functionPrototypeIR(functionPrototypeIR)

def $lift_externMethodPrototypeIR(
    annotationList ABSTRACT functionPrototypeIR ';')
  = annotationList ABSTRACT functionPrototype ';'
  -- if functionPrototype = $lift_functionPrototypeIR(functionPrototypeIR)

;;; externMethodPrototypeListIR

dec $unflatten_externConstructorOrMethodPrototypeList(
    externConstructorOrMethodPrototype*)
  : externConstructorOrMethodPrototypeList
  hint(testgen_ignore)
dec $unflatten_externConstructorOrMethodPrototypeList'(
    externConstructorOrMethodPrototypeList, externConstructorOrMethodPrototype*)
  : externConstructorOrMethodPrototypeList
  hint(testgen_ignore)

def $unflatten_externConstructorOrMethodPrototypeList(
    externConstructorOrMethodPrototype*)
  = $unflatten_externConstructorOrMethodPrototypeList'(
      _EMPTY, externConstructorOrMethodPrototype*)
def $unflatten_externConstructorOrMethodPrototypeList'(
    externConstructorOrMethodPrototypeList, eps)
  = externConstructorOrMethodPrototypeList
def $unflatten_externConstructorOrMethodPrototypeList'(
    externConstructorOrMethodPrototypeList,
    externConstructorOrMethodPrototype_h :: externConstructorOrMethodPrototype_t*)
  = $unflatten_externConstructorOrMethodPrototypeList'(
      externConstructorOrMethodPrototypeList externConstructorOrMethodPrototype_h,
      externConstructorOrMethodPrototype_t*)

;;; externObjectDeclarationIR

dec $lift_externObjectDeclarationIR(externObjectDeclarationIR)
  : externObjectDeclaration?
  hint(testgen_ignore)

def $lift_externObjectDeclarationIR(
    annotationList EXTERN nameIR `< typeParameterIR* ',' `>
      `{ externConstructorPrototypeIR*
         externMethodPrototypeIR* `})
  = annotationList EXTERN nonTypeName
      typeParameterListOpt `{ externConstructorOrMethodPrototypeList `}
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if (externConstructorPrototype
      = $lift_externConstructorPrototypeIR(externConstructorPrototypeIR))*
  -- if (externMethodPrototype
      = $lift_externMethodPrototypeIR(externMethodPrototypeIR))*
  -- if externConstructorOrMethodPrototype*
      = externConstructorPrototype* ++ externMethodPrototype*
  -- if externConstructorOrMethodPrototypeList
      = $unflatten_externConstructorOrMethodPrototypeList(
          externConstructorOrMethodPrototype*)

;;; externDeclarationIR

dec $lift_externDeclarationIR(externDeclarationIR) : externDeclaration?
  hint(testgen_ignore)

def $lift_externDeclarationIR(externFunctionDeclarationIR)
  = $lift_externFunctionDeclarationIR(externFunctionDeclarationIR)
def $lift_externDeclarationIR(externObjectDeclarationIR)
  = $lift_externObjectDeclarationIR(externObjectDeclarationIR)

;;
;;;; Parser statements and declarations
;;

;;
;;;;;; Select expressions
;;

;;; selectCase

dec $lift_selectCaseIR(selectCaseIR) : selectCase?
  hint(testgen_ignore)

def $lift_selectCaseIR(keysetExpressionIR ':' nameIR ';')
  = keysetExpression ':' nonTypeName ';'
  -- if keysetExpression
      = $lift_keysetExpressionIR(keysetExpressionIR)
  -- if nonTypeName
      = $lift_nameIR_as_nonTypeName(nameIR)

;;; selectCaseListIR

dec $lift_selectCaseListIR(selectCaseIR*) : selectCaseList?
  hint(testgen_ignore)

dec $unflatten_selectCaseList(selectCase*) : selectCaseList
  hint(testgen_ignore)
dec $unflatten_selectCaseList'(selectCaseList, selectCase*)
  : selectCaseList
  hint(testgen_ignore)

def $unflatten_selectCaseList(selectCase*)
  = $unflatten_selectCaseList'(_EMPTY, selectCase*)
def $unflatten_selectCaseList'(selectCaseList, eps)
  = selectCaseList
def $unflatten_selectCaseList'(
    selectCaseList, selectCase_h :: selectCase_t*)
  = $unflatten_selectCaseList'(
      selectCaseList selectCase_h, selectCase_t*)

def $lift_selectCaseListIR(selectCaseIR*)
  = selectCaseList
  -- if (selectCase = $lift_selectCaseIR(selectCaseIR))*
  -- if selectCaseList = $unflatten_selectCaseList(selectCase*)

;;; selectExpressionIR

dec $lift_selectExpressionIR(selectExpressionIR) : selectExpression?
  hint(testgen_ignore)

def $lift_selectExpressionIR(
    SELECT `( typedExpressionListIR `) `{ selectCaseIR* `})
  = SELECT `( expressionList `) `{ selectCaseList `}
  -- if expressionList
      = $lift_typedExpressionListIR(typedExpressionListIR)
  -- if selectCaseList
      = $lift_selectCaseListIR(selectCaseIR*)

;;
;;;;;; Transition statements
;;

;;; stateExpressionIR

dec $lift_stateExpressionIR(stateExpressionIR) : stateExpression?
  hint(testgen_ignore)

def $lift_stateExpressionIR(nameIR ';') = nonTypeName ';'
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
def $lift_stateExpressionIR(selectExpressionIR)
  = $lift_selectExpressionIR(selectExpressionIR)

;;; transitionStatementIR

dec $lift_transitionStatementIR(transitionStatementIR) : transitionStatement?
  hint(testgen_ignore)

def $lift_transitionStatementIR(TRANSITION stateExpressionIR)
  = TRANSITION stateExpression
  -- if stateExpression
      = $lift_stateExpressionIR(stateExpressionIR)

;;
;;;;;; Value set declarations
;;

;;; valueSetTypeIR (is instead modelled as typeIR)

dec $lift_typeIR_as_valueSetType(typeIR) : valueSetType?
  hint(testgen_ignore)

def $lift_typeIR_as_valueSetType(typeIR) = baseType
  -- if baseType = $lift_typeIR(typeIR)
def $lift_typeIR_as_valueSetType(typeIR) = tupleType
  -- if tupleType = $lift_typeIR(typeIR)
def $lift_typeIR_as_valueSetType(typeIR) = prefixedTypeName
  -- if prefixedTypeName = $lift_typeIR(typeIR)

;;; valueSetDeclarationIR

dec $lift_valueSetDeclarationIR(valueSetDeclarationIR)
  : valueSetDeclaration?
  hint(testgen_ignore)

def $lift_valueSetDeclarationIR(
    annotationList VALUE_SET `< typeIR `> `( typedExpressionIR `) nameIR ';')
  = annotationList VALUE_SET `< valueSetType `> `( expression `) nonTypeName ';'
  -- if valueSetType = $lift_typeIR_as_valueSetType(typeIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

;;
;;;;;; Parser type declarations
;;

dec $lift_parserTypeDeclarationIR(parserTypeDeclarationIR)
  : parserTypeDeclaration?
  hint(testgen_ignore)

def $lift_parserTypeDeclarationIR(
    annotationList PARSER nameIR
      `< typeParameterIR_expl* ',' typeParameterIR_impl* `>
      `( parameterIR* `) ';')
  = annotationList PARSER nonTypeName typeParameterListOpt `( parameterList `) ';'
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if typeParameterIR* = typeParameterIR_expl* ++ typeParameterIR_impl*
  -- if typeParameterListOpt
      = $lift_typeParameterListIR(typeParameterIR*)
  -- if parameterList = $lift_parameterListIR(parameterIR*)

;;
;;;;;; Parser declarations
;;

dec $lift_parserStatementIR(parserStatementIR) : parserStatement?
  hint(testgen_ignore)

;;; paresrBlockStatementIR

dec $lift_parserBlockElementStatementIR(parserBlockElementStatementIR)
  : parserBlockElementStatement?
  hint(testgen_ignore)

def $lift_parserBlockElementStatementIR(constantDeclarationIR)
  = $lift_constantDeclarationIR(constantDeclarationIR)
def $lift_parserBlockElementStatementIR(variableDeclarationIR)
  = $lift_variableDeclarationIR(variableDeclarationIR)
def $lift_parserBlockElementStatementIR(parserStatementIR)
  = $lift_parserStatementIR(parserStatementIR)

dec $lift_parserBlockElementStatementListIR(parserBlockElementStatementIR*)
  : parserBlockElementStatementList?
  hint(testgen_ignore)

dec $unflatten_parserBlockElementStatementList(parserBlockElementStatement*)
  : parserBlockElementStatementList
  hint(testgen_ignore)
dec $unflatten_parserBlockElementStatementList'(
    parserBlockElementStatementList, parserBlockElementStatement*
  )
  : parserBlockElementStatementList
  hint(testgen_ignore)

def $unflatten_parserBlockElementStatementList(parserBlockElementStatement*)
  = $unflatten_parserBlockElementStatementList'(
      _EMPTY, parserBlockElementStatement*)
def $unflatten_parserBlockElementStatementList'(
    parserBlockElementStatementList, eps)
  = parserBlockElementStatementList
def $unflatten_parserBlockElementStatementList'(
    parserBlockElementStatementList,
    parserBlockElementStatement_h :: parserBlockElementStatement_t*)
  = $unflatten_parserBlockElementStatementList'(
      parserBlockElementStatementList parserBlockElementStatement_h,
      parserBlockElementStatement_t*)

def $lift_parserBlockElementStatementListIR(parserBlockElementStatementIR*)
  = parserBlockElementStatementList
  -- if (parserBlockElementStatement
      = $lift_parserBlockElementStatementIR(
          parserBlockElementStatementIR))*
  -- if parserBlockElementStatementList
      = $unflatten_parserBlockElementStatementList(
          parserBlockElementStatement*)

dec $lift_parserBlockStatementIR(parserBlockStatementIR)
  : parserBlockStatement?
  hint(testgen_ignore)

def $lift_parserBlockStatementIR(
    annotationList `{ parserBlockElementStatementIR* `})
  = annotationList `{ parserBlockElementStatementList `}
  -- if parserBlockElementStatementList
      = $lift_parserBlockElementStatementListIR(parserBlockElementStatementIR*)

;;; parserConditionalStatementIR

dec $lift_parserConditionalStatementIR(parserConditionalStatementIR)
  : parserConditionalStatement?
  hint(testgen_ignore)

def $lift_parserConditionalStatementIR(
    IF `( typedExpressionIR_cond `) parserStatementIR_then)
  = IF `( expression_cond `) parserStatement_then
  -- if expression_cond = $lift_typedExpressionIR(typedExpressionIR_cond)
  -- if parserStatement_then = $lift_parserStatementIR(parserStatementIR_then)

def $lift_parserConditionalStatementIR(
    IF `( typedExpressionIR_cond `) parserStatementIR_then
    ELSE parserStatementIR_else)
  = IF `( expression_cond `) parserStatement_then ELSE parserStatement_else
  -- if expression_cond = $lift_typedExpressionIR(typedExpressionIR_cond)
  -- if parserStatement_then = $lift_parserStatementIR(parserStatementIR_then)
  -- if parserStatement_else = $lift_parserStatementIR(parserStatementIR_else)

;;; parserStatementIR

def $lift_parserStatementIR(emptyStatementIR)
  = $lift_emptyStatementIR(emptyStatementIR)
def $lift_parserStatementIR(assignmentStatementIR)
  = $lift_assignmentStatementIR(assignmentStatementIR)
def $lift_parserStatementIR(callStatementIR)
