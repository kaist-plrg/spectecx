dec $lift_callableTargetIR_as_lvalue(callableTargetIR) : lvalue?
  hint(testgen_ignore)

dec $lift_callStatementIR(callStatementIR) : callStatement?
  hint(testgen_ignore)

def $lift_callStatementIR(
    callableTargetIR `< eps `> `( argumentIR* `) ';')
  = lvalue `( argumentList `) ';'
  -- if lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR)
  -- if argumentList = $lift_argumentListIR(argumentIR*)

def $lift_callStatementIR(
    callableTargetIR `< typeArgumentIR* `> `( argumentIR* `) ';')
  = lvalue `< typeArgumentList `> `( argumentList `) ';'
  -- if lvalue = $lift_callableTargetIR_as_lvalue(callableTargetIR)
  -- if typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*)
  -- if argumentList = $lift_argumentListIR(argumentIR*)

