;;
;; Names
;;

;;; identifier

dec $lift_nameIR_as_identifier(nameIR) : identifier?
  hint(testgen_ignore)

def $lift_nameIR_as_identifier(nameIR) = _ID nameIR

;;; typeIdentifier

dec $lift_nameIR_as_typeIdentifier(nameIR) : typeIdentifier?
  hint(testgen_ignore)

def $lift_nameIR_as_typeIdentifier(nameIR) = _TID nameIR

;;
;;;; Non-type names
;;

;;; nonTypeName

dec $lift_nameIR_as_nonTypeName(nameIR) : nonTypeName?
  hint(testgen_ignore)

def $lift_nameIR_as_nonTypeName("apply") = APPLY
def $lift_nameIR_as_nonTypeName("key") = KEY
def $lift_nameIR_as_nonTypeName("actions") = ACTIONS
def $lift_nameIR_as_nonTypeName("state") = STATE
def $lift_nameIR_as_nonTypeName("entries") = ENTRIES
def $lift_nameIR_as_nonTypeName("type") = TYPE
def $lift_nameIR_as_nonTypeName("priority") = PRIORITY
def $lift_nameIR_as_nonTypeName(nameIR) = _ID nameIR
  -- otherwise

;;; prefixedNonTypeName

dec $lift_prefixedNameIR_as_prefixedNonTypeName(prefixedNameIR)
  : prefixedNonTypeName?
  hint(testgen_ignore)

def $lift_prefixedNameIR_as_prefixedNonTypeName(_BARE nameIR)
  = $lift_nameIR_as_nonTypeName(nameIR)
def $lift_prefixedNameIR_as_prefixedNonTypeName('.' nameIR)
  = _ID '.' nonTypeName
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

;;
;;;; Type names
;;

;;; typeName

dec $lift_nameIR_as_typeName(nameIR) : typeName?
  hint(testgen_ignore)

def $lift_nameIR_as_typeName(nameIR)
  = $lift_nameIR_as_typeIdentifier(nameIR)

;;; prefixedTypeName

dec $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  : prefixedTypeName?
  hint(testgen_ignore)

def $lift_prefixedNameIR_as_prefixedTypeName(_BARE nameIR)
  = $lift_nameIR_as_typeName(nameIR)
def $lift_prefixedNameIR_as_prefixedTypeName('.' nameIR)
  = _TID '.' typeName
  -- if typeName = $lift_nameIR_as_typeName(nameIR)

;;
;;;; Table custom property names
;;;; (NOTE) nameIR to identifier/typeIdentifier is lossy
;;

;;; tableCustomName

dec $lift_nameIR_as_tableCustomName(nameIR) : tableCustomName?

def $lift_nameIR_as_tableCustomName("apply") = APPLY
def $lift_nameIR_as_tableCustomName("state") = STATE
def $lift_nameIR_as_tableCustomName("type") = TYPE
def $lift_nameIR_as_tableCustomName("priority") = PRIORITY
def $lift_nameIR_as_tableCustomName(nameIR) = _ID nameIR
  -- otherwise

;;
;;;; Names
;;

;;; nameListIR

dec $lift_nameListIR_as_nonTypeNameList(nameIR*)
  : nameList?
  hint(testgen_ignore)

dec $unflatten_nameList(name*) : nameList
  hint(testgen_ignore)
dec $unflatten_nameList'(nameList, name*) : nameList
  hint(testgen_ignore)

def $unflatten_nameList(name_h :: name_t*)
  = $unflatten_nameList'(name_h, name_t*)
def $unflatten_nameList'(nameList, eps) = nameList
def $unflatten_nameList'(nameList, name_h :: name_t*)
  = $unflatten_nameList'(nameList ',' name_h, name_t*)

def $lift_nameListIR_as_nonTypeNameList(nameIR*)
  = nameList
  -- if (nonTypeName = $lift_nameIR_as_nonTypeName(nameIR))*
  -- if nameList
      = $unflatten_nameList(nonTypeName*)

;;;;; syntax member = name

dec $lift_nameIR_as_member(nameIR) : member?
  hint(testgen_ignore)

def $lift_nameIR_as_member(nameIR)
  = $lift_nameIR_as_nonTypeName(nameIR)

;;
;; Values
;;

dec $lift_value(value) : expression?
  hint(testgen_ignore)

def $lift_value(value) = eps
  -- debug value

;;
;; Types
;;

dec $lift_typeIR(typeIR) : type?
  hint(testgen_ignore)

;;
;;;; Base types
;;

;;; baseTypeIR

dec $lift_baseTypeIR(baseTypeIR) : baseType?
  hint(testgen_ignore)

def $lift_baseTypeIR(BOOL) = BOOL
def $lift_baseTypeIR(ERROR) = ERROR
def $lift_baseTypeIR(ERROR) = ERROR
def $lift_baseTypeIR(MATCH_KIND) = MATCH_KIND
def $lift_baseTypeIR(STRING) = STRING
def $lift_baseTypeIR(INT) = INT
def $lift_baseTypeIR(INT `< w `>) = INT `< w `>
def $lift_baseTypeIR(BIT `< w `>) = BIT `< w `>
def $lift_baseTypeIR(VARBIT `< w `>) = VARBIT `< w `>

;;
;;;; Named types
;;

;;; nameTypeIR

dec $lift_typeDefIR_as_typeName(typeDefIR) : typeName?
  hint(testgen_ignore)

dec $lift_typeArgumentListIR(typeArgumentIR*) : typeArgumentList?
  hint(testgen_ignore)

dec $lift_nameTypeIR(nameTypeIR) : namedType?
  hint(testgen_ignore)

def $lift_nameTypeIR(_NAME typeId) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)

;;
;;;; Alias types
;;

;;; aliasTypeIR

dec $lift_aliasTypeIR(aliasTypeIR) : type?
  hint(testgen_ignore)

def $lift_aliasTypeIR(TYPEDEF typeId _) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_aliasTypeIR(TYPE typeId _) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)

;;
;;;; Data types
;;

;;; dataTypeIR

dec $lift_typeArgumentIR(typeArgumentIR) : typeArgument?
  hint(testgen_ignore)

dec $lift_dataTypeIR(dataTypeIR) : type?
  hint(testgen_ignore)

def $lift_dataTypeIR(LIST `< typeIR `>)
  = LIST `< typeArgument `>
  -- if typeArgument = $lift_typeArgumentIR(typeIR)
def $lift_dataTypeIR(TUPLE `< typeIR* `>)
  = TUPLE `< typeArgumentList `>
  -- if typeArgumentList = $lift_typeArgumentListIR(typeIR*)
def $lift_dataTypeIR(ARRAY typeIR `[ n `])
  = type `[ (D n) `]
  -- if type = $lift_typeIR(typeIR)
def $lift_dataTypeIR(HEADER_STACK typeIR `[ n `])
  = type `[ (D n) `]
  -- if type = $lift_typeIR(typeIR)
def $lift_dataTypeIR(ENUM typeId `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_dataTypeIR(ENUM typeId `< typeIR `> `{ _ `})
  = typeName `< typeArgument `>
  -- if typeName = $lift_nameIR_as_typeName(typeId)
  -- if typeArgument = $lift_typeArgumentIR(typeIR)

;;
;;;; Types
;;;; (NOTE) identifier in typeOrVoid is lossy
;;

;;; typeIR

dec $lift_typeIR_as_typeOrVoid(typeIR) : typeOrVoid?
  hint(testgen_ignore)

def $lift_typeIR(baseTypeIR)
  = $lift_baseTypeIR(baseTypeIR)
def $lift_typeIR(nameTypeIR)
  = $lift_nameTypeIR(nameTypeIR)
def $lift_typeIR(aliasTypeIR)
  = $lift_aliasTypeIR(aliasTypeIR)
def $lift_typeIR(dataTypeIR)
  = $lift_dataTypeIR(dataTypeIR)
def $lift_typeIR(typeIR) = eps
  -- debug typeIR
  -- otherwise

def $lift_typeIR_as_typeOrVoid(VOID) = VOID
def $lift_typeIR_as_typeOrVoid(typeIR)
  = $lift_typeIR(typeIR)
  -- if typeIR =/= VOID

;;
;; Type definitions
;;

;;
;;;; Named type definitions
;;

def $lift_typeDefIR_as_typeName(_NAME typeId) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)

;;
;;;; Alias type definitions
;;

def $lift_typeDefIR_as_typeName(TYPEDEF typeId _) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(TYPE typeId _) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)

;;
;;;; Data type definitions
;;

def $lift_typeDefIR_as_typeName(STRUCT typeId `< _ `> `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(HEADER typeId `< _ `> `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(HEADER_UNION typeId `< _ `> `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(ENUM typeId `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(ENUM typeId `< _ `> `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)

;;
;;;; Object type definitions
;;

def $lift_typeDefIR_as_typeName(EXTERN typeId `< _ ',' _ `> _) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(PARSER typeId `< _ ',' _ `> `( _ `)) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(CONTROL typeId `< _ ',' _ `> `( _ `)) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(PACKAGE typeId `< _ ',' _ `> `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)
def $lift_typeDefIR_as_typeName(TABLE typeId `{ _ `}) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)

def $lift_typeDefIR_as_typeName(typeDefIR) = eps
  -- debug typeDefIR
  -- otherwise

;;
;; Type parameters
;;

;;; typeParameterIR

dec $lift_typeParameterIR(typeParameterIR) : typeParameter?
  hint(testgen_ignore)

def $lift_typeParameterIR(typeId) = typeName
  -- if typeName = $lift_nameIR_as_typeName(typeId)

;;; typeParameterListIR

dec $lift_typeParameterListIR(typeParameterIR*) : typeParameterListOpt?
  hint(testgen_ignore)

dec $unflatten_typeParameterListOpt(typeParameter*) : typeParameterListOpt
  hint(testgen_ignore)
dec $unflatten_typeParameterList(typeParameter*) : typeParameterList
  hint(testgen_ignore)
dec $unflatten_typeParameterList'(typeParameterList, typeParameter*)
  : typeParameterList
  hint(testgen_ignore)

def $unflatten_typeParameterListOpt(eps) = _EMPTY
def $unflatten_typeParameterListOpt(typeParameter_h :: typeParameter_t*)
  = `< $unflatten_typeParameterList(typeParameter_h :: typeParameter_t*) `>

def $unflatten_typeParameterList(typeParameter*)
  = $unflatten_typeParameterList'(typeParameter_h, typeParameter_t*)
  -- if typeParameter_h :: typeParameter_t* = typeParameter*
def $unflatten_typeParameterList'(typeParameterList, eps)
  = typeParameterList
def $unflatten_typeParameterList'(
    typeParameterList, typeParameter_h :: typeParameter_t*)
  = $unflatten_typeParameterList'(
      typeParameterList ',' typeParameter_h, typeParameter_t*)

def $lift_typeParameterListIR(typeParameterIR*)
  = typeParameterListOpt
  -- if (typeParameter = $lift_typeParameterIR(typeParameterIR))*
  -- if typeParameterListOpt
      = $unflatten_typeParameterListOpt(typeParameter*)

;;
;; Parameters
;;

;;; parameterIR

dec $lift_constantInitializerOptIR_as_initializerOpt(constantInitializerIR?)
  : initializerOpt?
  hint(testgen_ignore)

dec $lift_parameterIR(parameterIR) : parameter?
  hint(testgen_ignore)

def $lift_parameterIR(
    annotationList direction typeIR nameIR constantInitializerIR?
  )
  = annotationList direction type nonTypeName initializerOpt
  -- if type = $lift_typeIR(typeIR)
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if initializerOpt
      = $lift_constantInitializerOptIR_as_initializerOpt(constantInitializerIR?)

;;; parameterListIR

dec $lift_parameterListIR(parameterIR*) : parameterList?
  hint(testgen_ignore)

dec $unflatten_parameterList(parameter*) : parameterList
  hint(testgen_ignore)
dec $unflatten_nonEmptyParameterList(parameter*) : nonEmptyParameterList
  hint(testgen_ignore)
dec $unflatten_nonEmptyParameterList'(nonEmptyParameterList, parameter*)
  : nonEmptyParameterList
  hint(testgen_ignore)

def $unflatten_parameterList(eps) = _EMPTY
def $unflatten_parameterList(parameter_h :: parameter_t*)
  = $unflatten_nonEmptyParameterList(parameter_h :: parameter_t*)

def $unflatten_nonEmptyParameterList(parameter*)
  = $unflatten_nonEmptyParameterList'(parameter_h, parameter_t*)
  -- if parameter_h :: parameter_t* = parameter*
def $unflatten_nonEmptyParameterList'(nonEmptyParameterList, eps)
  = nonEmptyParameterList
def $unflatten_nonEmptyParameterList'(
    nonEmptyParameterList, parameter_h :: parameter_t*)
  = $unflatten_nonEmptyParameterList'(
      nonEmptyParameterList ',' parameter_h, parameter_t*)

def $lift_parameterListIR(parameterIR*) = parameterList
  -- if (parameter = $lift_parameterIR(parameterIR))*
  -- if parameterList = $unflatten_parameterList(parameter*)

;;
;; Constructor parameters
;;

;;; constructorParameterIR

dec $lift_constructorParameterIR(constructorParameterIR)
  : constructorParameter?
  hint(testgen_ignore)

def $lift_constructorParameterIR(constructorParameterIR)
  = $lift_parameterIR(constructorParameterIR)

;;; constructorParameterListOptIR

dec $lift_constructorParameterListIR(constructorParameterIR*)
  : constructorParameterListOpt?
  hint(testgen_ignore)

dec $unflatten_constructorParameterList(constructorParameter*)
  : constructorParameterListOpt
  hint(testgen_ignore)

def $unflatten_constructorParameterList(eps) = _EMPTY
def $unflatten_constructorParameterList(constructorParameter*)
  = `( $unflatten_parameterList(constructorParameter*) `)
  -- if constructorParameter* =/= eps

def $lift_constructorParameterListIR(constructorParameterIR*)
  = constructorParameterListOpt
  -- if (constructorParameter
      = $lift_constructorParameterIR(constructorParameterIR))*
  -- if constructorParameterListOpt
      = $unflatten_constructorParameterList(constructorParameter*)

;;
;; Initializers
;;

;;; initializerIR

dec $lift_typedExpressionIR(typedExpressionIR) : expression?
  hint(testgen_ignore)

dec $lift_initializerIR(initializerIR) : initializer?
  hint(testgen_ignore)

def $lift_initializerIR('=' typedExpressionIR)
  = '=' expression
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

;;; initializerOptIR

dec $lift_initializerOptIR(initializerIR?) : initializerOpt?
  hint(testgen_ignore)

def $lift_initializerOptIR(eps) = _EMPTY
def $lift_initializerOptIR(initializerIR)
  = $lift_initializerIR(initializerIR)

;;; constantInitializerIR

dec $lift_constantInitializerIR_as_initializer(constantInitializerIR)
  : initializer?
  hint(testgen_ignore)

def $lift_constantInitializerIR_as_initializer('=' _VALUE value)
  = '=' expression
  -- if expression = $lift_value(value)

;;; constantInitializerOptIR

def $lift_constantInitializerOptIR_as_initializerOpt(eps) = _EMPTY
def $lift_constantInitializerOptIR_as_initializerOpt(constantInitializerIR)
  = $lift_constantInitializerIR_as_initializer(constantInitializerIR)

;;
;; Expression key-value pairs
;;

;;; namedExpressionIR

dec $lift_namedExpressionIR(namedExpressionIR) : namedExpression?
  hint(testgen_ignore)

def $lift_namedExpressionIR(
    nameIR '=' typedExpressionIR)
  = nonTypeName '=' expression
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

;;; namedExpressionListIR

dec $lift_namedExpressionListIR(namedExpressionIR*) : namedExpressionList?
  hint(testgen_ignore)

dec $unflatten_namedExpressionList(namedExpression*) : namedExpressionList
  hint(testgen_ignore)
dec $unflatten_namedExpressionList'(namedExpressionList, namedExpression*)
  : namedExpressionList
  hint(testgen_ignore)

def $unflatten_namedExpressionList(namedExpression*)
  = $unflatten_namedExpressionList'(
      namedExpression_h, namedExpression_t*)
  -- if namedExpression_h :: namedExpression_t* = namedExpression*
def $unflatten_namedExpressionList'(
    namedExpressionList, eps) = namedExpressionList
def $unflatten_namedExpressionList'(
    namedExpressionList, namedExpression_h :: namedExpression_t*)
  = $unflatten_namedExpressionList'(
      namedExpressionList ',' namedExpression_h, namedExpression_t*)

def $lift_namedExpressionListIR(namedExpressionIR*)
  = namedExpressionList
  -- if (namedExpression
      = $lift_namedExpressionIR(namedExpressionIR))*
  -- if namedExpressionList
      = $unflatten_namedExpressionList(namedExpression*)

;;; namedValueIR

dec $lift_namedValueIR(namedValueIR) : namedExpression?
  hint(testgen_ignore)

def $lift_namedValueIR(
    nameIR '=' value)
  = nonTypeName '=' expression
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if expression = $lift_value(value)

;;; namedValueListIR

dec $lift_namedValueListIR(namedValueIR*) : namedExpressionList?
  hint(testgen_ignore)

def $lift_namedValueListIR(namedValueIR*)
  = namedExpressionList
  -- if (namedExpression = $lift_namedValueIR(namedValueIR))*
  -- if namedExpressionList
      = $unflatten_namedExpressionList(namedExpression*)

;;
;; Expressions
;;

dec $lift_typedExpressionListIR(typedExpressionIR*) : expressionList?
  hint(testgen_ignore)

;;
;;;; Literal expressions
;;

;;; literalExpressionIR

dec $lift_literalExpressionIR(literalExpressionIR) : literalExpression?
  hint(testgen_ignore)

def $lift_literalExpressionIR(literalExpression) = literalExpression

;;
;;;; Reference expressions
;;

;;; referenceExpressionIR

dec $lift_referenceExpressionIR(referenceExpressionIR) : referenceExpression?
  hint(testgen_ignore)

def $lift_referenceExpressionIR(_BARE nameIR) = THIS
  -- if nameIR = "this"
def $lift_referenceExpressionIR(_BARE nameIR) = nonTypeName
  -- if nameIR =/= "this"
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
def $lift_referenceExpressionIR('.' nameIR) = _ID '.' nonTypeName
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

;;
;;;; Default expressions
;;

;;; defaultExpressionIR

dec $lift_defaultExpressionIR(defaultExpressionIR) : defaultExpression?
  hint(testgen_ignore)

def $lift_defaultExpressionIR('...') = '...'

;;
;;;; Unary, binary, and ternary expressions
;;

;;; unaryExpressionIR

dec $lift_unaryExpressionIR(unaryExpressionIR) : unaryExpression?
  hint(testgen_ignore)

def $lift_unaryExpressionIR(unop typedExpressionIR)
  = unop expression
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

;;; binaryExpressionIR

dec $lift_binaryExpressionIR(binaryExpressionIR) : binaryExpression?
  hint(testgen_ignore)

def $lift_binaryExpressionIR(
    typedExpressionIR_l binop typedExpressionIR_r)
  = expression_l binop expression_r
  -- if expression_l = $lift_typedExpressionIR(typedExpressionIR_l)
  -- if expression_r = $lift_typedExpressionIR(typedExpressionIR_r)

;;; ternaryExpressionIR

dec $lift_ternaryExpressionIR(ternaryExpressionIR) : ternaryExpression?
  hint(testgen_ignore)

def $lift_ternaryExpressionIR(
    typedExpressionIR_cond '?' typedExpressionIR_then ':' typedExpressionIR_else)
  = expression_cond '?' expression_then ':' expression_else
  -- if expression_cond = $lift_typedExpressionIR(typedExpressionIR_cond)
  -- if expression_then = $lift_typedExpressionIR(typedExpressionIR_then)
  -- if expression_else = $lift_typedExpressionIR(typedExpressionIR_else)

;;
;;;; Cast expressions
;;;; (NOTE) Cast to set type is unsupported in the surface syntax, thus is ignored
;;

;;; castExpressionIR

dec $lift_castExpressionIR(castExpressionIR) : expression?
  hint(testgen_ignore)

def $lift_castExpressionIR(`( typeIR `) typedExpressionIR)
  = expression
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if (typeIR_unroll <: setTypeIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_castExpressionIR(`( typeIR `) typedExpressionIR)
  = `( type `) expression
  -- if typeIR_unroll = $unroll_typeIR(typeIR)
  -- if ~(typeIR_unroll <: setTypeIR)
  -- if type = $lift_typeIR(typeIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

;;
;;;; Data (aggregate) expressions
;;

;;; recordElementExpressionIR (namedExpressionIR*)

dec $unflatten_recordElementExpression(namedExpression*)
  : recordElementExpression
  hint(testgen_ignore)

def $unflatten_recordElementExpression(namedExpression_h)
  = name_h '=' expression_h
  -- if name_h '=' expression_h = namedExpression_h
def $unflatten_recordElementExpression(
    namedExpression_h :: namedExpression_t*)
  = name_h '=' expression_h ',' namedExpressionList
  -- if namedExpression_t* =/= eps
  -- if name_h '=' expression_h = namedExpression_h
  -- if namedExpressionList
      = $unflatten_namedExpressionList(namedExpression_t*)

dec $unflatten_recordElementExpression_with_default(namedExpression*)
  : recordElementExpression
  hint(testgen_ignore)

def $unflatten_recordElementExpression_with_default(namedExpression_h)
  = name_h '=' expression_h ',' '...'
  -- if name_h '=' expression_h = namedExpression_h
def $unflatten_recordElementExpression_with_default(
    namedExpression_h :: namedExpression_t*)
  = name_h '=' expression_h ',' namedExpressionList ',' '...'
  -- if namedExpression_t* =/= eps
  -- if name_h '=' expression_h = namedExpression_h
  -- if namedExpressionList
      = $unflatten_namedExpressionList(namedExpression_t*)

;;; dataExpressionIR

dec $lift_dataExpressionIR(dataExpressionIR) : dataExpression?
  hint(testgen_ignore)

def $lift_dataExpressionIR('{#}') = '{#}'

def $lift_dataExpressionIR(SEQ `{ typedExpressionIR* `})
  = `{ expressionList _EMPTY `}
  -- if expressionList
      = $lift_typedExpressionListIR(typedExpressionIR*)

def $lift_dataExpressionIR(SEQ `{ typedExpressionIR* ',' '...' `})
  = `{ expressionList _EMPTY `}
  -- if (expression = $lift_typedExpressionIR(typedExpressionIR))*
  -- if expression_with_default*
      = expression* ++ [ '...' ]
  -- if expressionList
      = $lift_typedExpressionListIR(typedExpressionIR*)

def $lift_dataExpressionIR(RECORD `{ namedExpressionIR* `})
  = `{ recordElementExpression _EMPTY `}
  -- if (namedExpression = $lift_namedExpressionIR(namedExpressionIR))*
  -- if recordElementExpression
      = $unflatten_recordElementExpression(namedExpression*)

def $lift_dataExpressionIR(RECORD `{ namedExpressionIR* ',' '...' `})
  = `{ recordElementExpression _EMPTY `}
  -- if (namedExpression = $lift_namedExpressionIR(namedExpressionIR))*
  -- if recordElementExpression
      = $unflatten_recordElementExpression_with_default(namedExpression*)

;;
;; Member and index access expressions
;;

;;; errorAccessExpressionIR

dec $lift_errorAccessExpressionIR(errorAccessExpressionIR)
  : errorAccessExpression?
  hint(testgen_ignore)

def $lift_errorAccessExpressionIR(ERROR '.' nameIR)
  = ERROR '.' member
  -- if member = $lift_nameIR_as_member(nameIR)

;;; memberAccessBaseIR

dec $lift_memberAccessBaseIR(memberAccessBaseIR) : memberAccessBase?
  hint(testgen_ignore)

def $lift_memberAccessBaseIR(TYPE prefixedNameIR)
  = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)

def $lift_memberAccessBaseIR(typedExpressionIR)
  = $lift_typedExpressionIR(typedExpressionIR)

;;; memberAccessExpressionIR

dec $lift_memberAccessExpressionIR(memberAccessExpressionIR)
  : memberAccessExpression?
  hint(testgen_ignore)

def $lift_memberAccessExpressionIR(memberAccessBaseIR '.' nameIR)
  = memberAccessBase '.' member
  -- if memberAccessBase
      = $lift_memberAccessBaseIR(memberAccessBaseIR)
  -- if member = $lift_nameIR_as_member(nameIR)

;;; indexAccessExpressionIR

dec $lift_indexAccessExpressionIR(indexAccessExpressionIR)
  : indexAccessExpression?
  hint(testgen_ignore)

def $lift_indexAccessExpressionIR(
    typedExpressionIR_base `[ typedExpressionIR_index `])
  = expression_base `[ expression_index `]
  -- if expression_base = $lift_typedExpressionIR(typedExpressionIR_base)
  -- if expression_index = $lift_typedExpressionIR(typedExpressionIR_index)

;;; sliceAccessExpressionIR

dec $lift_sliceAccessExpressionIR(sliceAccessExpressionIR)
  : sliceAccessExpression?
  hint(testgen_ignore)

def $lift_sliceAccessExpressionIR(
    typedExpressionIR_base `[ typedExpressionIR_hi
                            ':' typedExpressionIR_lo `])
  = expression_base `[ expression_hi ':' expression_lo `]
  -- if expression_base = $lift_typedExpressionIR(typedExpressionIR_base)
  -- if expression_hi = $lift_typedExpressionIR(typedExpressionIR_hi)
  -- if expression_lo = $lift_typedExpressionIR(typedExpressionIR_lo)

;;; accessExpressionIR

dec $lift_accessExpressionIR(accessExpressionIR) : accessExpression?
  hint(testgen_ignore)

def $lift_accessExpressionIR(errorAccessExpressionIR)
  = $lift_errorAccessExpressionIR(errorAccessExpressionIR)
def $lift_accessExpressionIR(memberAccessExpressionIR)
  = $lift_memberAccessExpressionIR(memberAccessExpressionIR)
def $lift_accessExpressionIR(indexAccessExpressionIR)
  = $lift_indexAccessExpressionIR(indexAccessExpressionIR)
def $lift_accessExpressionIR(sliceAccessExpressionIR)
  = $lift_sliceAccessExpressionIR(sliceAccessExpressionIR)

;;
;;;; Call expressions
;;

dec $lift_argumentListIR(argumentIR*) : argumentList?
  hint(testgen_ignore)
dec $lift_callableTargetIR_as_expression(callableTargetIR) : expression?
  hint(testgen_ignore)
dec $lift_typeArgumentListIR_as_realTypeArgumentList(typeArgumentIR*)
  : realTypeArgumentList?
  hint(testgen_ignore)

dec $lift_callExpressionIR(callExpressionIR) : callExpression?
  hint(testgen_ignore)

def $lift_callExpressionIR(
    constructorTargetIR `( argumentIR* `))
  = namedType `( argumentList `)
  -- if prefixedNameIR `< eps `> = constructorTargetIR
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if namedType = prefixedTypeName
  -- if argumentList = $lift_argumentListIR(argumentIR*)

def $lift_callExpressionIR(
    constructorTargetIR `( argumentIR* `))
  = namedType `( argumentList `)
  -- if prefixedNameIR `< typeArgumentIR* `> = constructorTargetIR
  -- if typeArgumentIR* =/= eps
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*)
  -- if namedType = prefixedTypeName `< typeArgumentList `>
  -- if argumentList = $lift_argumentListIR(argumentIR*)

def $lift_callExpressionIR(
    callableTargetIR `< eps `> `( argumentIR* `))
  = expression `( argumentList `)
  -- if expression = $lift_callableTargetIR_as_expression(callableTargetIR)
  -- if argumentList = $lift_argumentListIR(argumentIR*)

def $lift_callExpressionIR(
    callableTargetIR `< typeArgumentIR* `> `( argumentIR* `))
  = expression `< realTypeArgumentList `> `( argumentList `)
  -- if expression = $lift_callableTargetIR_as_expression(callableTargetIR)
  -- if typeArgumentIR* =/= eps
  -- if realTypeArgumentList
      = $lift_typeArgumentListIR_as_realTypeArgumentList(typeArgumentIR*)
  -- if argumentList = $lift_argumentListIR(argumentIR*)

