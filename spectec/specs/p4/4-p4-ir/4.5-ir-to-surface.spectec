dec $lift_directApplicationStatementIR(
    directApplicationStatementIR)
  : directApplicationStatement?
  hint(testgen_ignore)

def $lift_directApplicationStatementIR(
    constructorTargetIR '.' APPLY `( argumentIR* `) ';')
  = prefixedTypeName '.' APPLY `( argumentList `) ';'
  -- if prefixedNameIR `< eps `> = constructorTargetIR
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if argumentList = $lift_argumentListIR(argumentIR*)

def $lift_directApplicationStatementIR(
    constructorTargetIR '.' APPLY `( argumentIR* `) ';')
  = namedType '.' APPLY `( argumentList `) ';'
  -- if prefixedNameIR `< typeArgumentIR* `> = constructorTargetIR
  -- if $(|typeArgumentIR*| > 0)
  -- if prefixedTypeName
      = $lift_prefixedNameIR_as_prefixedTypeName(prefixedNameIR)
  -- if typeArgumentList = $lift_typeArgumentListIR(typeArgumentIR*)
  -- if namedType = prefixedTypeName `< typeArgumentList `>
  -- if argumentList = $lift_argumentListIR(argumentIR*)

