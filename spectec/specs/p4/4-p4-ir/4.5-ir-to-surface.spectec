;;; argumentIR

dec $lift_argumentIR(argumentIR) : argument?
  hint(testgen_ignore)

def $lift_argumentIR(typedExpressionIR)
  = expression
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_argumentIR(nameIR '=' typedExpressionIR)
  = nonTypeName '=' expression
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

def $lift_argumentIR(nameIR '=' '_')
  = nonTypeName '=' '_'
  -- if nonTypeName = $lift_nameIR_as_nonTypeName(nameIR)

def $lift_argumentIR('_') = '_'

;;; argumentListIR

dec $unflatten_argumentList(argument*) : argumentList
  hint(testgen_ignore)
dec $unflatten_argumentListNonEmpty(argument*) : argumentListNonEmpty
  hint(testgen_ignore)
dec $unflatten_argumentListNonEmpty'(argumentListNonEmpty, argument*)
  : argumentListNonEmpty
  hint(testgen_ignore)

def $unflatten_argumentList(eps) = _EMPTY
def $unflatten_argumentList(argument_h :: argument_t*)
  = $unflatten_argumentListNonEmpty(argument_h :: argument_t*)

def $unflatten_argumentListNonEmpty(argument*)
  = $unflatten_argumentListNonEmpty'(argument_h, argument_t*)
  -- if argument_h :: argument_t* = argument*
def $unflatten_argumentListNonEmpty'(argumentListNonEmpty, eps)
  = argumentListNonEmpty
def $unflatten_argumentListNonEmpty'(
    argumentListNonEmpty, argument_h :: argument_t*)
  = $unflatten_argumentListNonEmpty'(
      argumentListNonEmpty ',' argument_h, argument_t*)

def $lift_argumentListIR(argumentIR*) = argumentList
  -- if (argument = $lift_argumentIR(argumentIR))*
  -- if argumentList = $unflatten_argumentList(argument*)

