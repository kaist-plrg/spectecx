dec $lift_returnStatementIR(returnStatementIR) : returnStatement?
  hint(testgen_ignore)

def $lift_returnStatementIR(RETURN ';') = RETURN ';'
def $lift_returnStatementIR(RETURN typedExpressionIR ';')
  = RETURN expression ';'
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

