def $unflatten_typeArgumentList'(typeArgumentList, eps) = typeArgumentList
def $unflatten_typeArgumentList'(typeArgumentList, typeArgument_h :: typeArgument_t*)
  = $unflatten_typeArgumentList'(typeArgumentList ',' typeArgument_h, typeArgument_t*)

def $lift_typeArgumentListIR(typeArgumentIR*)
  = typeArgumentList
  -- if (typeArgument = $lift_typeArgumentIR(typeArgumentIR))*
  -- if typeArgumentList = $unflatten_typeArgumentList(typeArgument*)

def $unflatten_realTypeArgumentList(
    realTypeArgument_h :: realTypeArgument_t*)
  = $unflatten_realTypeArgumentList'(
      realTypeArgument_h, realTypeArgument_t*)
def $unflatten_realTypeArgumentList'(realTypeArgumentList, eps)
  = realTypeArgumentList
def $unflatten_realTypeArgumentList'(
    realTypeArgumentList, realTypeArgument_h :: realTypeArgument_t*)
  = $unflatten_realTypeArgumentList'(
      realTypeArgumentList ',' realTypeArgument_h, realTypeArgument_t*)

def $lift_typeArgumentListIR_as_realTypeArgumentList(typeArgumentIR*)
  = realTypeArgumentList
  -- if (realTypeArgument
      = $lift_typeArgumentIR_as_realTypeArgument(typeArgumentIR))*
  -- if realTypeArgumentList
      = $unflatten_realTypeArgumentList(realTypeArgument*)

;;
;; Arguments
