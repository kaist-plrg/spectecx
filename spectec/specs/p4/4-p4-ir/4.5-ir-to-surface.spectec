dec $lift_typedLvalueIR(typedLvalueIR) : lvalue?
  hint(testgen_ignore)

dec $lift_assignmentStatementIR(assignmentStatementIR)
  : assignmentStatement?
  hint(testgen_ignore)

def $lift_assignmentStatementIR(
    typedLvalueIR assignop typedExpressionIR ';')
  = lvalue assignop expression ';'
  -- if lvalue = $lift_typedLvalueIR(typedLvalueIR)
  -- if expression = $lift_typedExpressionIR(typedExpressionIR)

