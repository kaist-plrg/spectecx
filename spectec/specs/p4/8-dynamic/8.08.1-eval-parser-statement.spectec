;;
;; Parser transition statement evaluation
;;
;; syntax transitionStatementIR = TRANSITION stateExpressionIR
;;

syntax selectCaseMatchResult =
  | continueResult<nameIR?>
  | rejectTransitionResult

relation SelectCase_match:
  evalContext arch value* |- selectCaseIR
                           : evalContext arch selectCaseMatchResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "matching" %2 "against" %3 "under context" %0 "and state" %1)
  hint(prose_out "the updated context" %4#", state" %5#", and" %6)


rule SelectCase_match/reject:
  EC_0 ARCH_0 value_key* |- keysetExpressionIR ':' nameIR ';'
                          : EC_1 ARCH_1 rejectTransitionResult
  ---- ;; evaluate keyset expression
  -- Eval_keyset:
      EC_0 ARCH_0 |- keysetExpressionIR
                   : EC_1 ARCH_1 rejectTransitionResult

rule SelectCase_match/no-match:
  EC_0 ARCH_0 value_key* |- keysetExpressionIR ':' nameIR ';'
                          : EC_1 ARCH_1 (_CONT eps)
  ---- ;; evaluate keyset expression
  -- Eval_keyset:
      EC_0 ARCH_0 |- keysetExpressionIR
                   : EC_1 ARCH_1 (_CONT setValue*)
  ---- ;; perform match
  -- if ~$match_keysets(setValue*, value_key*)

rule SelectCase_match/match:
  EC_0 ARCH_0 value_key* |- keysetExpressionIR ':' nameIR ';'
                          : EC_1 ARCH_1 (_CONT nameIR)
  ---- ;; evaluate keyset expression
  -- Eval_keyset:
      EC_0 ARCH_0 |- keysetExpressionIR
                   : EC_1 ARCH_1 (_CONT setValue*)
  ---- ;; perform match
  -- if $match_keysets(setValue*, value_key*)


relation SelectCases_match:
  evalContext arch value* |- selectCaseListIR
                           : evalContext arch selectCaseMatchResult
  hint(input %0 %1 %2 %3)
  hint(prose_in "matching" %2 "against" %3 "under context" %0 "and state" %1)
  hint(prose_out "the updated context" %4#", state" %5#", and" %6)


rule SelectCases_match/nil:
  EC ARCH value_key* |- eps : EC ARCH (_CONT eps)

rule SelectCases_match/cons-head-match:
  EC_0 ARCH_0 value_key* |- selectCaseIR_h :: selectCaseIR_t*
                          : EC_1 ARCH_1 rejectTransitionResult
  -- SelectCase_match:
      EC_0 ARCH_0 value_key* |- selectCaseIR_h
                              : EC_1 ARCH_1 rejectTransitionResult

rule SelectCases_match/cons-head-match:
  EC_0 ARCH_0 value_key* |- selectCaseIR_h :: selectCaseIR_t*
                          : EC_1 ARCH_1 (_CONT nameIR_state)
  -- SelectCase_match:
      EC_0 ARCH_0 value_key* |- selectCaseIR_h
                              : EC_1 ARCH_1 (_CONT nameIR_state)

rule SelectCases_match/cons-head-no-match:
  EC_0 ARCH_0 value_key* |- selectCaseIR_h :: selectCaseIR_t*
                          : EC_2 ARCH_2 selectCaseMatchResult
  -- SelectCase_match:
      EC_0 ARCH_0 value_key* |- selectCaseIR_h
                              : EC_1 ARCH_1 (_CONT eps)
  -- SelectCases_match:
      EC_1 ARCH_1 value_key* |- selectCaseIR_t*
                              : EC_2 ARCH_2 selectCaseMatchResult


;;; syntax selectExpressionIR


rule ParserSelect_eval/reject:
  EC_0 ARCH_0 |- selectExpressionIR
               : EC_1 ARCH_1 rejectTransitionResult
  ---- ;; unpack the select expression
  -- if SELECT `( typedExpressionIR_key* `) `{ selectCaseListIR `}
      = selectExpressionIR
  ---- ;; evaluate the key expressions
  -- Exprs_eval:
      LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*
                         : EC_1 ARCH_1 rejectTransitionResult

rule ParserSelect_eval/cont-selectCaseListIR-reject:
  EC_0 ARCH_0 |- selectExpressionIR
               : EC_2 ARCH_2 rejectTransitionResult
  ---- ;; unpack the select expression
  -- if SELECT `( typedExpressionIR_key* `) `{ selectCaseListIR `}
      = selectExpressionIR
  ---- ;; evaluate the key expressions
  -- Exprs_eval:
      LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*
                         : EC_1 ARCH_1 (_CONT value_key*)
  ---- ;; find a matching select case
  -- SelectCases_match:
      EC_1 ARCH_1 value_key* |- selectCaseListIR
                              : EC_2 ARCH_2 rejectTransitionResult

rule ParserSelect_eval/no-match:
  EC_0 ARCH_0 |- selectExpressionIR
               : EC_2 ARCH_2 rejectTransitionResult
  ---- ;; unpack the select expression
  -- if SELECT `( typedExpressionIR_key* `) `{ selectCaseListIR `}
      = selectExpressionIR
  ---- ;; evaluate the key expressions
  -- Exprs_eval:
      LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*
                         : EC_1 ARCH_1 (_CONT value_key*)
  ---- ;; find a matching select case
  -- SelectCases_match:
      EC_1 ARCH_1 value_key* |- selectCaseListIR
                              : EC_2 ARCH_2 (_CONT nameIR_state?)
  -- if eps = nameIR_state?
  -- if rejectTransitionResult = REJECT (ERROR '.' "NoMatch")

rule ParserSelect_eval/match:
  EC_0 ARCH_0 |- selectExpressionIR
               : EC_3 ARCH_3 transitionResult
  ---- ;; unpack the select expression
  -- if SELECT `( typedExpressionIR_key* `) `{ selectCaseListIR `}
      = selectExpressionIR
  ---- ;; evaluate the key expressions
  -- Exprs_eval:
      LOCAL EC_0 ARCH_0 |- typedExpressionIR_key*
                         : EC_1 ARCH_1 (_CONT value_key*)
  ---- ;; find a matching select case
  -- SelectCases_match:
      EC_1 ARCH_1 value_key* |- selectCaseListIR
                              : EC_2 ARCH_2 (_CONT nameIR_state)
  ---- ;; do the transition
  -- ParserTransition_eval:
      EC_2 ARCH_2 |- TRANSITION (nameIR_state ';')
                   : EC_3 ARCH_3 transitionResult


;;; syntax stateExpressionIR

;;;; nameIR ';'
;;;; selectExpressionIR


rule ParserTransition_eval/nameIR-accept:
  EC ARCH |- TRANSITION (nameIR ';')
           : EC ARCH ACCEPT
  -- if nameIR = "accept"

rule ParserTransition_eval/nameIR-reject:
  EC ARCH |- TRANSITION (nameIR ';')
           : EC ARCH (REJECT errorValue)
  -- if nameIR = "reject"
  -- if errorValue = ERROR '.' "NoError"

rule ParserTransition_eval/nameIR-state:
  EC ARCH |- TRANSITION (nameIR ';')
           : EC ARCH (STATE nameIR)
  -- if nameIR =/= "accept" /\ nameIR =/= "reject"

rule ParserTransition_eval/selectExpressionIR:
  EC_0 ARCH_0 |- TRANSITION selectExpressionIR
               : EC_1 ARCH_1 transitionResult
  -- ParserSelect_eval:
      EC_0 ARCH_0 |- selectExpressionIR
                   : EC_1 ARCH_1 transitionResult

;;
;; Parser statement evaluation
;;
;; syntax parserStatementIR
;;

;;; emptyStatementIR

rule ParserStmt_eval/emptyStatementIR:
  EC_0 ARCH_0 |- emptyStatementIR
               : EC_1 ARCH_1 _EMPTY
  -- Stmt_eval:
      LOCAL EC_0 ARCH_0 |- emptyStatementIR
                         : EC_1 ARCH_1 _EMPTY

;;; assignmentStatementIR


rule ParserStmt_eval/reject:
  EC_0 ARCH_0 |- assignmentStatementIR
               : EC_1 ARCH_1 rejectTransitionResult
  -- Stmt_eval:
      LOCAL EC_0 ARCH_0 |- assignmentStatementIR
                         : EC_1 ARCH_1 rejectTransitionResult

rule ParserStmt_eval/cont:
  EC_0 ARCH_0 |- assignmentStatementIR
               : EC_1 ARCH_1 _EMPTY
  -- Stmt_eval:
      LOCAL EC_0 ARCH_0 |- assignmentStatementIR
                         : EC_1 ARCH_1 _EMPTY


;;; callStatementIR


rule ParserStmt_eval/reject:
  EC_0 ARCH_0 |- callStatementIR
               : EC_1 ARCH_1 rejectTransitionResult
  -- Stmt_eval:
      LOCAL EC_0 ARCH_0 |- callStatementIR
                         : EC_1 ARCH_1 rejectTransitionResult

rule ParserStmt_eval/cont:
  EC_0 ARCH_0 |- callStatementIR
               : EC_1 ARCH_1 _EMPTY
  -- Stmt_eval:
      LOCAL EC_0 ARCH_0 |- callStatementIR
                         : EC_1 ARCH_1 _EMPTY


;;; directApplicationStatementIR
;;; syntax directApplicationStatementIR =
;;;   prefixedNameIR '.' APPLY `( argumentListIR ) ';'

;;; parserBlockStatementIR

rule ParserStmt_eval/parserBlockStatementIR:
  EC_0 ARCH_0 |- parserBlockStatementIR
               : EC_3 ARCH_1 parserStatementResult
  -- if EC_1 = $enter_e(EC_0)
  -- ParserBlock_eval:
      EC_1 ARCH_0 |- parserBlockStatementIR
                   : EC_2 ARCH_1 parserStatementResult
  -- if EC_3 = $exit_e(EC_2)

;;; parserConditionalStatementIR
;;; syntax parserConditionalStatementIR

;;;; IF `( typedExpressionIR ) parserStatementIR
;;;; IF `( typedExpressionIR ) parserStatementIR ELSE parserStatementIR


rule ParserStmt_eval/non-else-reject:
  EC ARCH |- IF `( typedExpressionIR_cond `) parserStatementIR_then
           : EC_cond ARCH_cond rejectTransitionResult
  -- Expr_eval:
      LOCAL EC ARCH |- typedExpressionIR_cond
                     : EC_cond ARCH_cond rejectTransitionResult

rule ParserStmt_eval/non-else-cont-true:
  EC ARCH |- IF `( typedExpressionIR_cond `) parserStatementIR_then
           : EC_then ARCH_then parserStatementResult
  -- Expr_eval:
      LOCAL EC ARCH |- typedExpressionIR_cond
                     : EC_cond ARCH_cond (_CONT (_B true))
  -- ParserStmt_eval:
      EC_cond ARCH_cond |- parserStatementIR_then
                         : EC_then ARCH_then parserStatementResult

rule ParserStmt_eval/non-else-cont-false:
  EC ARCH |- IF `( typedExpressionIR_cond `) parserStatementIR_then
           : EC_cond ARCH_cond _EMPTY
  -- Expr_eval:
      LOCAL EC ARCH |- typedExpressionIR_cond
                     : EC_cond ARCH_cond (_CONT (_B false))

rule ParserStmt_eval/else-reject:
  EC ARCH |- IF `( typedExpressionIR_cond `) parserStatementIR_then
              ELSE parserStatementIR_else
           : EC_cond ARCH_cond rejectTransitionResult
  -- Expr_eval:
      LOCAL EC ARCH |- typedExpressionIR_cond
                     : EC_cond ARCH_cond rejectTransitionResult

rule ParserStmt_eval/else-cont-true:
  EC ARCH |- IF `( typedExpressionIR_cond `) parserStatementIR_then
              ELSE parserStatementIR_else
           : EC_then ARCH_then parserStatementResult
  -- Expr_eval:
      LOCAL EC ARCH |- typedExpressionIR_cond
                     : EC_cond ARCH_cond (_CONT (_B true))
  -- ParserStmt_eval:
      EC_cond ARCH_cond |- parserStatementIR_then
                         : EC_then ARCH_then parserStatementResult

rule ParserStmt_eval/else-cont-false:
  EC ARCH |- IF `( typedExpressionIR_cond `) parserStatementIR_then
            ELSE parserStatementIR_else
           : EC_else ARCH_else parserStatementResult
  -- Expr_eval:
      LOCAL EC ARCH |- typedExpressionIR_cond
                     : EC_cond ARCH_cond (_CONT (_B false))
  -- ParserStmt_eval:
      EC_cond ARCH_cond |- parserStatementIR_else
                         : EC_else ARCH_else parserStatementResult



;;
;; Parser block statement instantiation
;;

;;
;; syntax parserBlockElementStatementIR
;;

;;; constantDeclarationIR
;;; variableDeclarationIR
;;; parserStatementIR


rule ParserBlockElementStmt_eval/constantDeclarationIR:
  EC_0 ARCH |- constantDeclarationIR
             : EC_1 ARCH _EMPTY
  -- ConstDecl_eval:
      LOCAL EC_0 |- constantDeclarationIR : EC_1

rule ParserBlockElementStmt_eval/variableDeclarationIR-reject:
  EC_0 ARCH_0 |- variableDeclarationIR
               : EC_1 ARCH_1 rejectTransitionResult
  -- VarDecl_eval:
      LOCAL EC_0 ARCH_0 |- variableDeclarationIR
                         : EC_1 ARCH_1 rejectTransitionResult

rule ParserBlockElementStmt_eval/variableDeclarationIR-empty:
  EC_0 ARCH_0 |- variableDeclarationIR
               : EC_1 ARCH_1 _EMPTY
  -- VarDecl_eval:
      LOCAL EC_0 ARCH_0 |- variableDeclarationIR
                         : EC_1 ARCH_1 _EMPTY

rule ParserBlockElementStmt_eval/statementIR:
  EC_0 ARCH_0 |- parserStatementIR
               : EC_1 ARCH_1 parserStatementResult
  -- ParserStmt_eval:
      EC_0 ARCH_0 |- parserStatementIR
                   : EC_1 ARCH_1 parserStatementResult


;;
;; syntax blockElementStatementListIR
;;


rule ParserBlockElementStmtList_eval/nil:
  EC ARCH |- eps : EC ARCH _EMPTY

rule ParserBlockElementStmtList_eval/cons-head-non-cont:
  EC_0 ARCH_0 |- parserBlockElementStatementIR_h :: parserBlockElementStatementIR_t*
               : EC_1 ARCH_1 parserStatementResult
  -- ParserBlockElementStmt_eval:
      EC_0 ARCH_0 |- parserBlockElementStatementIR_h
                   : EC_1 ARCH_1 parserStatementResult
  -- if parserStatementResult =/= _EMPTY

rule ParserBlockElementStmtList_eval/cons-head-cont:
  EC_0 ARCH_0 |- parserBlockElementStatementIR_h :: parserBlockElementStatementIR_t*
               : EC_2 ARCH_2 parserStatementResult
  -- ParserBlockElementStmt_eval:
      EC_0 ARCH_0 |- parserBlockElementStatementIR_h
                   : EC_1 ARCH_1 _EMPTY
  -- ParserBlockElementStmtList_eval:
      EC_1 ARCH_1 |- parserBlockElementStatementIR_t*
                   : EC_2 ARCH_2 parserStatementResult


;;
;; syntax parserBlockStatmentIR
;;      = annotationList `{ parserBlockElementStatementListIR }
;;

rule ParserBlock_eval:
  EC_0 ARCH_0 |- annotationList `{ parserBlockElementStatementListIR `}
               : EC_1 ARCH_1 parserStatementResult
  -- ParserBlockElementStmtList_eval:
      EC_0 ARCH_0 |- parserBlockElementStatementListIR
                   : EC_1 ARCH_1 parserStatementResult
