;;
;; Callable types
;;

;;
;;;; Parameter types
;;

syntax typedExpressionIR

syntax initializerIR = '=' typedExpressionIR
syntax constantInitializerIR = '=' _VALUE value

syntax parameterInitializerIR =
  | initializerIR
  | constantInitializerIR
syntax parameterInitializerOptIR = parameterInitializerIR?

syntax parameterIR =
  annotationList direction typeIR id parameterInitializerOptIR
  hint(prose_fields "annotations" "direction" "type" "name" "default initializer")

;;
;;;; Action types
;;

syntax actionTypeIR = annotationList ACTION nameIR `( parameterIR* `)

;;
;;;; Function types
;;

syntax definedFunctionTypeIR = FUNCTION nameIR `( parameterIR* `) ':' typeIR

syntax externFunctionTypeIR = EXTERN_FUNCTION nameIR `( parameterIR* `) ':' typeIR

syntax functionTypeIR =
  | definedFunctionTypeIR
  | externFunctionTypeIR

;;
;;;; Method types
;;

syntax builtinIsValidMethodTypeIR    = BUILTIN_IS_VALID
syntax builtinSetValidMethodTypeIR   = BUILTIN_SET_VALID
syntax builtinSetInvalidMethodTypeIR = BUILTIN_SET_INVALID
syntax builtinPushFrontMethodTypeIR  = BUILTIN_PUSH_FRONT
syntax builtinPopFrontMethodTypeIR   = BUILTIN_POP_FRONT
syntax builtinSizeMethodTypeIR       = BUILTIN_SIZE_OF

syntax builtinMethodTypeIR =
  | builtinIsValidMethodTypeIR
  | builtinSetValidMethodTypeIR
  | builtinSetInvalidMethodTypeIR
  | builtinPushFrontMethodTypeIR
  | builtinPopFrontMethodTypeIR
  | builtinSizeMethodTypeIR

;; the parameter list and return type of each builtin method
dec $signature_of_builtinMethodTypeIR(builtinMethodTypeIR) : (parameterIR*, typeIR)
def $signature_of_builtinMethodTypeIR(BUILTIN_IS_VALID) = (eps, BOOL)
def $signature_of_builtinMethodTypeIR(BUILTIN_SET_VALID) = (eps, VOID)
def $signature_of_builtinMethodTypeIR(BUILTIN_SET_INVALID) = (eps, VOID)
def $signature_of_builtinMethodTypeIR(BUILTIN_PUSH_FRONT)
  = ([ _EMPTY _EMPTY INT "count" eps ], VOID)
def $signature_of_builtinMethodTypeIR(BUILTIN_POP_FRONT)
  = ([ _EMPTY _EMPTY INT "count" eps ], VOID)
def $signature_of_builtinMethodTypeIR(BUILTIN_SIZE_OF) = (eps, INT)

syntax externMethodTypeIR =
  | EXTERN_METHOD nameIR `( parameterIR* `) ':' typeIR
  | EXTERN_METHOD ABSTRACT nameIR `( parameterIR* `) ':' typeIR

syntax parserApplyMethodTypeIR = PARSER_APPLY `( parameterIR* `)

syntax controlApplyMethodTypeIR = CONTROL_APPLY `( parameterIR* `)

syntax tableApplyMethodTypeIR = TABLE_APPLY ':' tableMetadataStructTypeIR

syntax methodTypeIR =
  | builtinMethodTypeIR
  | externMethodTypeIR
  | parserApplyMethodTypeIR
  | controlApplyMethodTypeIR
  | tableApplyMethodTypeIR

;;
;;;; Callable types
;;

syntax callableTypeIR =
  | actionTypeIR
  | functionTypeIR
  | methodTypeIR
