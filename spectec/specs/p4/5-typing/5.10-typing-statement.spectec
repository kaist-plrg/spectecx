dec $compat_switch(typeIR) : bool
  hint(prose_true %0 "is a valid switch key type")
  hint(prose_false %0 "is an invalid switch key type")
def $compat_switch(ERROR) = true
def $compat_switch(INT `< _ `>) = true
def $compat_switch(BIT `< _ `>) = true
def $compat_switch(TYPEDEF _ typeIR) = $compat_switch(typeIR)
def $compat_switch(enumTypeIR) = true
def $compat_switch(_) = false
  -- otherwise

relation Switch_general_ok:
  typingContext |- SWITCH `( typedExpressionIR `) `{ switchCaseList `}
                 : typingContext switchCaseIR*
  hint(input %0 %1 %2)
  hint(prose_in "typing" SWITCH `( %1 `) `{ %2 `} "under context" %0)
  hint(prose_out "context" %3 "and" %4)

rule Switch_general_ok:
  TC_0 |- SWITCH `( typedExpressionIR_switch `) `{ switchCaseList `}
        : TC_1 switchCaseIR*
  ----
  -- if typeIR_switch = $type_of_typedExpressionIR(typedExpressionIR_switch)
  ---- ;; if the expression is error, numeric or enumerated type
  -- if $compat_switch(typeIR_switch)
  ---- ;; check switch cases
  -- SwitchCaseList_general_ok:
      TC_0 typeIR_switch |- switchCaseList : TC_1 switchCaseIR*


rule Stmt_ok/table:
  LOCAL TC_0 |- SWITCH `( expression_switch `) `{ switchCaseList `}
              : TC_1 switchStatementIR
  ---- ;; switch statements can only be used in a control apply block
  -- if TC_0.LOCAL.KIND = CONTROL_APPLY_METHOD
  ---- ;; check expression
  -- Expr_ok: LOCAL TC_0 |- expression_switch : typedExpressionIR_switch
  -- if typeIR_switch = $type_of_typedExpressionIR(typedExpressionIR_switch)
  ---- ;; if the expression is the result of table apply method
  -- if TABLE_ENUM typeId_table_enum `{ _ `}
      = $unroll_typeIR(typeIR_switch)
  -- Switch_table_ok:
      TC_0 |- SWITCH `( typeId_table_enum `) `{ switchCaseList `}
            : TC_1 switchCaseIR*
  -- if (switchLabelIR = $switchLabelIR_of_switchCaseIR(switchCaseIR))*
  ---- ;; if default case is present, it must be the last
  -- if $check_switchLabelIR_default(switchLabelIR*)
  ---- ;; switch labels must be unique
  -- if $distinct_<switchLabelIR>(switchLabelIR*)
  ---- ;; create typed statement
  -- if switchStatementIR
      = SWITCH `( typedExpressionIR_switch `) `{ switchCaseIR* `}

rule Stmt_ok/general:
  LOCAL TC_0 |- SWITCH `( expression_switch `) `{ switchCaseList `}
              : TC_1 switchStatementIR
  ---- ;; switch statements can only be used in a control apply block
  -- if TC_0.LOCAL.KIND = CONTROL_APPLY_METHOD
  ---- ;; check expression
  -- Expr_ok: LOCAL TC_0 |- expression_switch : typedExpressionIR_switch
  -- if typeIR_switch = $type_of_typedExpressionIR(typedExpressionIR_switch)
  ---- ;; if the expression is not the result of table apply method
  -- if ~($unroll_typeIR(typeIR_switch) <: tableMetadataEnumTypeIR)
  -- Switch_general_ok:
      TC_0 |- SWITCH `( typedExpressionIR_switch `) `{ switchCaseList `}
            : TC_1 switchCaseIR*
  -- if (switchLabelIR = $switchLabelIR_of_switchCaseIR(switchCaseIR))*
  ---- ;; if default case is present, it must be the last
  -- if $check_switchLabelIR_default(switchLabelIR*)
  ---- ;; switch labels must be unique
  -- if $distinct_<switchLabelIR>(switchLabelIR*)
  ---- ;; create typed statement
  -- if switchStatementIR
      = SWITCH `( typedExpressionIR_switch `) `{ switchCaseIR* `}


