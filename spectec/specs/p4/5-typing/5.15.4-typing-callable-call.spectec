  p TC |- controlApplyMethodTypeIR
            `< eps '#' eps `> `( argumentIR* '#' id_default* '#' id_optional* `)
        : VOID `< eps `> `( argumentIR_cast* `)
  -- if CONTROL_APPLY `( parameterIR* `)
      = controlApplyMethodTypeIR
  ---- ;; align parameters with arguments
  -- if GIVEN parameterIR_aligned* DEFAULT _ OPTIONAL _
      = $align_parameterListIR(parameterIR*, argumentIR*, id_default*, id_optional*)
  ---- ;; check call site
  -- if $callable_controlApplyMethod(p, TC)
  ---- ;; check call convention
