;;
;; Calling convention (single argument)
;;

;; syntax direction

;;; IN

rule Call_convention_expr_ok/in:
  p TC actctxt |- (_ IN typeIR_param _ _) '@' typedExpressionIR_arg
                : typedExpressionIR_arg_cast
  ---- ;; may insert implicit casts for direction in
  -- if typedExpressionIR_arg_cast
      = $cast_unary(typedExpressionIR_arg, typeIR_param)

;;; OUT | INOUT

rule Call_convention_expr_ok/out-inout:
  p TC actctxt |- (_ direction typeIR_param _ _) '@' typedExpressionIR_arg
                : typedExpressionIR_arg
  -- if direction = OUT \/ direction = INOUT
  ---- ;; may not insert implicit casts for direction out or inout
  -- if typeIR_arg = $type_of_typedExpressionIR(typedExpressionIR_arg)
  -- Type_alpha: typeIR_param ~~ typeIR_arg
  ---- ;; for copy-out, the expression must be a l-value
  -- if typedLvalueIR_arg = $typedExpressionIR_as_typedLvalueIR(typedExpressionIR_arg)
  -- if lvalue_arg = $lift_typedLvalueIR(typedLvalueIR_arg)
  -- Lvalue_ok: p TC |- lvalue_arg : _

;;; _EMPTY


rule Call_convention_expr_ok/action:
  p TC ACTION |- (_ _EMPTY typeIR_param _ _) '@' typedExpressionIR_arg
               : typedExpressionIR_arg_cast
  ---- ;; may insert implicit casts for directionless action argument
  -- if typedExpressionIR_arg_cast
      = $cast_unary(typedExpressionIR_arg, typeIR_param)

rule Call_convention_expr_ok/non-action:
  p TC NOACTION |- (_ _EMPTY typeIR_param _ _) '@' typedExpressionIR_arg
                 : typedExpressionIR_arg_cast
  ---- ;; may insert implicit casts for directionless non-action argument
  -- if typedExpressionIR_arg_cast
      = $cast_unary(typedExpressionIR_arg, typeIR_param)
  ---- ;; the argument must be compile-time known
  -- if DYN =/= $ctk_of_typedExpressionIR(typedExpressionIR_arg)


;; syntax argumentIR

;;; typedExpressionIR
;;; nameIR '=' typedExpressionIR
;;; nameIR '=' '_'
;;; '_'


rule Call_convention_arg_ok/typedExpression:
  p TC actctxt |- parameterIR '@' typedExpressionIR
                : typedExpressionIR_cast
  -- Call_convention_expr_ok:
      p TC actctxt |- parameterIR '@' typedExpressionIR
                    : typedExpressionIR_cast

rule Call_convention_arg_ok/nameIR-typedExpression:
  p TC actctxt |- parameterIR '@' (nameIR '=' typedExpressionIR)
                : (nameIR '=' typedExpressionIR_cast)
  -- Call_convention_expr_ok:
      p TC actctxt |- parameterIR '@' typedExpressionIR
                    : typedExpressionIR_cast

rule Call_convention_arg_ok/nameIR-dontcare:
  p TC actctxt |- parameterIR '@' (nameIR '=' '_')
                : (nameIR '=' '_')
  -- if _ OUT _ _ _ = parameterIR

rule Call_convention_arg_ok/dontcare:
  p TC actctxt |- parameterIR '@' '_' : '_'
  -- if _ OUT _ _ _ = parameterIR


;;
;; Calling convention (multiple arguments)
;;


rule Call_convention_ok/nil:
  p TC actctxt |- eps '@' eps : eps

rule Call_convention_ok/cons:
  p TC actctxt |- (parameterIR_h :: parameterIR_t*)
                    '@' (argumentIR_h :: argumentIR_t*)
                : (argumentIR_h_cast :: argumentIR_t_cast*)
  -- Call_convention_arg_ok:
      p TC actctxt |- parameterIR_h '@' argumentIR_h
                    : argumentIR_h_cast
  -- Call_convention_ok:
      p TC actctxt |- parameterIR_t* '@' argumentIR_t*
                    : argumentIR_t_cast*

