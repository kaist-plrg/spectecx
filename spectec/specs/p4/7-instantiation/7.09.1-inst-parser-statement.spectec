;;
;; Parser statement instantiation
;;
;; syntax parserStatementIR
;;

;;; emptyStatementIR

rule ParserStmt_inst/emptyStatementIR:
  IC_0 STO_0 |- emptyStatementIR
              : IC_1 STO_1 emptyStatementIR_inst
  -- Stmt_inst:
      LOCAL IC_0 STO_0 |- emptyStatementIR
                        : IC_1 STO_1 emptyStatementIR_inst

;;; assignmentStatementIR

rule ParserStmt_inst/assignmentStatementIR:
  IC_0 STO_0 |- assignmentStatementIR
              : IC_1 STO_1 assignmentStatementIR_inst
  -- Stmt_inst:
      LOCAL IC_0 STO_0 |- assignmentStatementIR
                        : IC_1 STO_1 assignmentStatementIR_inst

;;; callStatementIR

rule ParserStmt_inst/callStatementIR:
  IC_0 STO_0 |- callStatementIR
              : IC_1 STO_1 callStatementIR_inst
  -- Stmt_inst:
      LOCAL IC_0 STO_0 |- callStatementIR
                        : IC_1 STO_1 callStatementIR_inst

;;; directApplicationStatementIR
;;; syntax directApplicationStatementIR =
;;;   prefixedNameIR '.' APPLY `( argumentListIR ) ';'

rule ParserStmt_inst/directApplicationStatementIR:
  IC STO_0 |- directApplicationStatementIR
            : IC STO_1 parserBlockStatementIR
  -- DirectApplicationStmt_inst:
      LOCAL IC STO_0 |- directApplicationStatementIR
                      : STO_1 constantDeclarationIR callStatementIR
  -- if parserBlockStatementIR
      = _EMPTY `{ [ constantDeclarationIR, callStatementIR ] `}

;;; parserBlockStatementIR

rule ParserStmt_inst/parserBlockStatementIR:
  IC_0 STO_0 |- parserBlockStatementIR
              : IC_3 STO_1 parserBlockStatementIR_inst
  -- if IC_1 = $enter_i(IC_0)
  -- ParserBlock_inst:
      IC_1 STO_0 |- parserBlockStatementIR
                  : IC_2 STO_1 parserBlockStatementIR_inst
  -- if IC_3 = $exit_i(IC_2)

;;; parserConditionalStatementIR
;;; syntax parserConditionalStatementIR

;;;; IF `( typedExpressionIR ) parserStatementIR
;;;; IF `( typedExpressionIR ) parserStatementIR ELSE parserStatementIR


rule ParserStmt_inst/non-else:
  IC STO_0 |- IF `( typedExpressionIR_cond `) parserStatementIR_then
            : IC STO_1 (IF `( typedExpressionIR_cond `) parserStatementIR_then_inst)
  -- ParserStmt_inst:
      IC STO_0 |- parserStatementIR_then
                : IC_then STO_1 parserStatementIR_then_inst

rule ParserStmt_inst/else:
  IC STO_0 |- IF `( typedExpressionIR_cond `) parserStatementIR_then
              ELSE parserStatementIR_else
            : IC STO_2
                (IF `( typedExpressionIR_cond `) parserStatementIR_then_inst
                 ELSE parserStatementIR_else_inst)
  -- ParserStmt_inst:
      IC STO_0 |- parserStatementIR_then
                : IC_then STO_1 parserStatementIR_then_inst
  -- ParserStmt_inst:
      IC STO_1 |- parserStatementIR_else
                : IC_else STO_2 parserStatementIR_else_inst


;;
;; Parser block statement instantiation
;;

;;
;; syntax parserBlockElementStatementIR
;;

;;; constantDeclarationIR
;;; variableDeclarationIR
;;; parserStatementIR


rule ParserBlockElementStmt_inst/constantDeclarationIR:
  IC_0 STO_0 |- constantDeclarationIR
              : IC_1 STO_0 constantDeclarationIR
  -- ConstDecl_inst:
      LOCAL IC_0 |- constantDeclarationIR : IC_1

rule ParserBlockElementStmt_inst/variableDeclarationIR:
  IC STO |- variableDeclarationIR
          : IC STO variableDeclarationIR

rule ParserBlockElementStmt_inst/parserStatementIR:
  IC_0 STO_0 |- parserStatementIR
              : IC_1 STO_1 parserStatementIR_inst
  -- ParserStmt_inst: IC_0 STO_0 |- parserStatementIR
                                  : IC_1 STO_1 parserStatementIR_inst


;;
;; syntax parserBlockElementStatementListIR
;;


rule ParserBlockElementStmtList_inst/nil:
  IC STO |- eps : IC STO eps

rule ParserBlockElementStmtList_inst/cons:
  IC_0 STO_0 |- parserBlockElementStatementIR_h :: parserBlockElementStatementIR_t*
              : IC_2 STO_2 (parserBlockElementStatementIR_h_inst
                            :: parserBlockElementStatementIR_t_inst*)
  -- ParserBlockElementStmt_inst:
      IC_0 STO_0 |- parserBlockElementStatementIR_h
                  : IC_1 STO_1 parserBlockElementStatementIR_h_inst
  -- ParserBlockElementStmtList_inst:
      IC_1 STO_1 |- parserBlockElementStatementIR_t*
                  : IC_2 STO_2 parserBlockElementStatementIR_t_inst*


;;
;; syntax parserBlockStatmentIR
;;

;;; syntax parserBlockStatmentIR
;;;      = annotationList `{ parserBlockElementStatementListIR }

rule ParserBlock_inst:
  IC_0 STO_0 |- annotationList `{ parserBlockElementStatementListIR `}
              : IC_1 STO_1 (annotationList `{ parserBlockElementStatementListIR_inst `})
  -- ParserBlockElementStmtList_inst:
      IC_0 STO_0 |- parserBlockElementStatementListIR
                  : IC_1 STO_1 parserBlockElementStatementListIR_inst
