;;
;; Parser state instantiation
;;
;; syntax parserStateIR =
;;   annotationList STATE nameIR
;;     `{ parserStatementListIR transitionStatementIR }
;;

rule ParserState_inst:
  IC_0 STO_0 |- parserStateIR : IC_4 STO_1
  -- if annotationList STATE nameIR
          `{ parserBlockElementStatementListIR transitionStatementIR `}
      = parserStateIR
  ---- ;; enter the state's local scope
  -- if IC_1 = $enter_i(IC_0)
  ---- ;; instantiate parser statements
  -- ParserBlockElementStmtList_inst:
      IC_1 STO_0 |- parserBlockElementStatementListIR
                  : IC_2 STO_1 parserBlockElementStatementListIR_inst
  ---- ;; discard the state's local bindings
  -- if IC_3 = $exit_i(IC_2)
  ---- ;; bind parser state to state environment
  -- if parserStateIR_inst
      = annotationList STATE nameIR
          `{ parserBlockElementStatementListIR_inst transitionStatementIR `}
  -- if IC_4 = $add_parserState_i(IC_3, nameIR, parserStateIR_inst)

;;
;; Parser state list instantiation
;;
;; syntax parserStateListIR
;;


rule ParserStates_inst/nil:
  IC STO |- eps : IC STO

rule ParserStates_inst/cons:
  IC_0 STO_0 |- parserStateIR_h :: parserStateIR_t*
              : IC_2 STO_2
  -- ParserState_inst: IC_0 STO_0 |- parserStateIR_h
                                   : IC_1 STO_1
  -- ParserStates_inst: IC_1 STO_1 |- parserStateIR_t*
                                    : IC_2 STO_2

