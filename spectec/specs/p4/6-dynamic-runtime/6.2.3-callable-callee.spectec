;;
;; Callees
;;

;;
;;;; Action callees
;;

syntax actionCallee =
  ACTION cursor '.' nameIR
    `( parameterListIR '#' id* `) blockStatementIR

;;
;;;; Function callees
;;

syntax definedFunctionCallee =
  FUNCTION nameIR `< typeParameterListIR `>
    `( parameterListIR '#' id* `) blockStatementIR

syntax externFunctionCallee =
  EXTERN_FUNCTION nameIR
    `< typeParameterListIR `> `( parameterListIR '#' id* '#' id* `)

syntax functionCallee =
  | definedFunctionCallee
  | externFunctionCallee

;;
;;;; Method callees
;;

syntax builtinIsValidMethodCallee    = BUILTIN_IS_VALID storageReference
syntax builtinSetValidMethodCallee   = BUILTIN_SET_VALID storageReference
syntax builtinSetInvalidMethodCallee = BUILTIN_SET_INVALID storageReference
syntax builtinPushFrontMethodCallee  = BUILTIN_PUSH_FRONT storageReference
syntax builtinPopFrontMethodCallee   = BUILTIN_POP_FRONT storageReference
syntax builtinSizeMethodCallee       = BUILTIN_SIZE_OF nameIR typeIR

syntax builtinMethodCallee =
  | builtinIsValidMethodCallee
  | builtinSetValidMethodCallee
  | builtinSetInvalidMethodCallee
  | builtinPushFrontMethodCallee
  | builtinPopFrontMethodCallee
  | builtinSizeMethodCallee

syntax externMethodCallee =
  EXTERN_METHOD objectId '.' nameIR `< typeParameterListIR `>
    `( parameterListIR '#' id* '#' id* `)
    `{ theta ';' frame ';' blockStatementIR? `}

syntax parserApplyMethodCallee =
  PARSER objectId '.' APPLY `( parameterListIR '#' id* `)
    `{ theta ';' frame ';' parserLocalDeclarationListIR ';' stateEnv `}

syntax controlApplyMethodCallee =
  CONTROL objectId '.' APPLY `( parameterListIR '#' id* `)
    `{ theta ';' frame ';' controlLocalDeclarationListIR ';' actionDefEnv ';' controlBodyIR `}

syntax tableApplyMethodCallee =
  TABLE objectId '.' APPLY `{ frame ';' tableObjectProperty `}

syntax methodCallee =
  | builtinMethodCallee
  | externMethodCallee
  | parserApplyMethodCallee
  | controlApplyMethodCallee
  | tableApplyMethodCallee

syntax callee = actionCallee | functionCallee | methodCallee
